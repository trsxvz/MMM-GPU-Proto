@DSL Default;
@Behaviour LogarithmicStrainElasticity;
@Date 14/10/2026;
@Description {
  "Isotropic linear elasticity in the logarithmic (Hencky) strain "
  "framework, used to test the finite strain behaviours given the "
  "displacement gradient"
}

@StrainMeasure Hencky;
@ModellingHypotheses {Tridimensional, PlaneStrain, Axisymmetrical};
@ProvidesSymmetricTangentOperator;

@Parameter stress young = 70.e9;
young.setGlossaryName("YoungModulus");
@Parameter real nu = 0.34;
nu.setGlossaryName("PoissonRatio");

@LocalVariable stress lambda;
@LocalVariable stress mu;

@StateVariable real eeq;
eeq.setGlossaryName("EquivalentStrain");

@InitLocalVariables {
  lambda = computeLambda(young, nu);
  mu = computeMu(young, nu);
}

@PredictionOperator {
  static_cast<void>(smt);
  Dt = lambda * Stensor4::IxI() + 2 * mu * Stensor4::Id();
}

@Integrator {
  const auto e = eval(eto + deto);
  sig = lambda * trace(e) * StrainStensor::Id() + 2 * mu * e;
  deeq = (e | e) - eeq;
  if (computeTangentOperator_) {
    Dt = lambda * Stensor4::IxI() + 2 * mu * Stensor4::Id();
  }
}
