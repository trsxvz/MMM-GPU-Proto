/*!
 * \file   include/MFEMMGIS/Behaviour.hxx
 * \brief  This file declares the `Behaviour` alias and the `load` function
 * \author Thomas Helfer
 * \date   26/08/2020
 */

#ifndef LIB_MFEM_MGIS_BEHAVIOUR_HXX
#define LIB_MFEM_MGIS_BEHAVIOUR_HXX

#include <memory>
#include "MGIS/Behaviour/Hypothesis.hxx"
#include "MGIS/Behaviour/Behaviour.hxx"
#include "MFEMMGIS/Config.hxx"
#include "MFEMMGIS/MGISForward.hxx"

namespace mfem_mgis {

  //! \brief a simple alias
  using Behaviour = mgis::behaviour::Behaviour;

  /*!
   * \brief name of the parameter of the behaviour integrators stating that
   * a finite strain behaviour is given the displacement gradient
   * \f$H = F - I\f$ instead of the deformation gradient \f$F\f$ (see
   * `BehaviourLoadingOptions::displacement_gradient`)
   */
  inline constexpr const char* displacement_gradient_parameter =
      "DisplacementGradient";

  //! \brief options of the `load` function
  struct BehaviourLoadingOptions {
    /*!
     * \brief give the displacement gradient \f$H = F - I\f$ instead of the
     * deformation gradient \f$F\f$ to a finite strain behaviour.
     *
     * The deformation gradient being close to the identity, its components
     * are only known within about 6e-8 in single precision. The displacement
     * gradient keeps the relative precision of small strains: the behaviour
     * computes its strain measure (Green-Lagrange or Hencky strain) from it
     * without cancellation. This requires a behaviour generated by a version
     * of `MFront` which accepts it (see the `gradient` option of
     * `mgis::behaviour::FiniteStrainBehaviourOptions`).
     */
    bool displacement_gradient = false;
  };

  /*!
   * \brief load a behaviour.
   *
   * Compared to the `mgis::behaviour::load` function, this function
   * handles specifically the case of finite strain behaviours.
   *
   * \param[in, out] ctx: execution context
   * \param[in] l: library name
   * \param[in] b: behaviour name
   * \param[in] h: modelling hypothesis
   * \param[in] o: options
   * \return the loaded behaviour, a null pointer on failure
   */
  MFEM_MGIS_EXPORT [[nodiscard]] std::unique_ptr<Behaviour> load(
      Context& ctx,
      const std::string& l,
      const std::string& b,
      const Hypothesis h,
      const BehaviourLoadingOptions& o = {}) noexcept;

}  // end of namespace mfem_mgis

#endif /* LIB_MFEM_MGIS_BEHAVIOUR_HXX */
