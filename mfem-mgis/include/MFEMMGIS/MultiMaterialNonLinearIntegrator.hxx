#ifndef LIB_MFEM_MGIS_MULTIMATERIALNONLINEARINTEGRATOR_HXX
#define LIB_MFEM_MGIS_MULTIMATERIALNONLINEARINTEGRATOR_HXX

#include <array>
#include <memory>
#include <vector>
#include <cstdint>
#include "mfem/fem/nonlininteg.hpp"
#include "MFEMMGIS/Config.hxx"
#include "MFEMMGIS/Material.hxx"
#include "MFEMMGIS/Parameters.hxx"
#include "MFEMMGIS/Batch/Gradients.hxx"
#include "MFEMMGIS/Batch/InnerForces.hxx"
#include "MFEMMGIS/Batch/StiffnessMatrices.hxx"
#include "MFEMMGIS/AbstractNonLinearEvolutionProblem.hxx"

namespace mfem_mgis {

  // forward declaration
  enum struct IntegrationType;
  // forward declaration
  struct FiniteElementDiscretization;
  // forward declaration
  struct AbstractBehaviourIntegrator;

  /*!
   * \brief non linear integrator based on MGIS behaviours.
   *
   * This class manages a mapping between the material identifiers and the
   * behaviour integrators.
   */
  struct MFEM_MGIS_EXPORT [[nodiscard]] MultiMaterialNonLinearIntegrator final
      : public NonlinearFormIntegrator {
    //! \brief a simple alias
    using Behaviour = mgis::behaviour::Behaviour;
    /*!
     * \brief constructor
     * \param[in] fed: finite element discretisation
     * \param[in] h: modelling hypothesis
     */
    MultiMaterialNonLinearIntegrator(
        std::shared_ptr<const FiniteElementDiscretization> fed,
        const Hypothesis h);
    // MFEM API
    /*!
     * \brief compute the contribution of the given element to the residual
     * \param[in] e: finite element
     * \param[in, out] tr: finite element transformation
     * \param[in] U: current estimate of the unknowns
     * \param[out] F: element contribution to the residual
     */
    void AssembleElementVector(const mfem::FiniteElement& e,
                               mfem::ElementTransformation& tr,
                               const mfem::Vector& U,
                               mfem::Vector& F) override;

    /*!
     * \brief compute the contribution of the given element to the jacobian
     * \param[in] e: finite element
     * \param[in, out] tr: finite element transformation
     * \param[in] U: current estimate of the unknowns
     * \param[out] K: element stiffness matrix
     */
    void AssembleElementGrad(const mfem::FiniteElement& e,
                             mfem::ElementTransformation& tr,
                             const mfem::Vector& U,
                             mfem::DenseMatrix& K) override;
    /*!
     * \brief integrate the behaviour for the current estimate of the unknowns
     * at the end of the time step.
     * \param[in] e: finite element
     * \param[in, out] tr: finite element transformation
     * \param[in] U: current estimate of the unknowns
     * \param[in] it: integration type
     * \return true on success
     */
    [[nodiscard]] bool integrate(const mfem::FiniteElement& e,
                                 mfem::ElementTransformation& tr,
                                 const mfem::Vector& U,
                                 const IntegrationType it);
    /*!
     * \return true if all the behaviour integrators support the integration
     * of the behaviours by batches; otherwise, an error message naming the
     * first behaviour integrator which does not is registered
     * \param[in, out] ctx: execution context
     */
    [[nodiscard]] bool checkBatchIntegrationSupport(Context& ctx) const
        noexcept;
    /*!
     * \return true if all the behaviours can be integrated point by point;
     * otherwise (behaviour generated by the `generic-parallel` interface,
     * which only provides functions processing batches), an error message
     * is registered
     * \param[in, out] ctx: execution context
     */
    [[nodiscard]] bool checkPointByPointIntegrationSupport(Context& ctx) const
        noexcept;
    /*!
     * \brief compute the gradients at the integration points of an element,
     * for all the behaviour integrators associated with its material (first
     * step of the integration by batches, see
     * `AbstractBehaviourIntegrator::computeGradients`)
     * \param[in] e: finite element
     * \param[in, out] tr: finite element transformation
     * \param[in] U: current estimate of the unknowns
     * \return true on success
     */
    [[nodiscard]] bool computeGradients(const mfem::FiniteElement& e,
                                        mfem::ElementTransformation& tr,
                                        const mfem::Vector& U);
    /*!
     * \brief integrate the behaviours at all the integration points, by
     * batches (one call per behaviour integrator, see
     * `AbstractBehaviourIntegrator::integrateBatch`). After the integration
     * of a behaviour on the device, the arrays of its material are
     * synchronized on the host for reading, unless the inner forces and the
     * stiffness matrices are computed by kernels: the element loops of MFEM
     * read them on the host.
     * \param[in] it: integration type
     * \return true on success
     */
    [[nodiscard]] bool integrateBatch(const IntegrationType it);
    /*!
     * \return true if all the behaviours are integrated by batches on the
     * device (see `AbstractBehaviourIntegrator::integratesBatchesOnDevice`):
     * the arrays of the materials do not need to be synchronized on the host
     * before `integrateBatch`, if the gradients are computed by kernels
     */
    [[nodiscard]] bool integratesBatchesOnDevice() const noexcept;
    /*!
     * \return true if the gradients of all the behaviour integrators can be
     * computed by kernels (see
     * `AbstractBehaviourIntegrator::supportsKernels`); otherwise,
     * an error message naming the first behaviour integrator which does not
     * support them is registered
     * \param[in, out] ctx: execution context
     */
    [[nodiscard]] bool checkKernelsSupport(Context& ctx) const noexcept;
    /*!
     * \return true if the stiffness matrices of all the behaviour
     * integrators can be computed by kernels with the given computation of
     * the gradients: the stiffness matrices of a behaviour integrator
     * depending on the current estimate of the solution (FBar formulation,
     * see
     * `AbstractBehaviourIntegrator::requiresCurrentSolutionForJacobianAssembly`)
     * are computed from data computed with the gradients by kernels;
     * otherwise, an error message naming the first behaviour integrator
     * concerned is registered
     * \param[in, out] ctx: execution context
     * \param[in] gradients_kernels: if true, the gradients are computed by
     * kernels
     */
    [[nodiscard]] bool checkStiffnessMatricesKernelsSupport(
        Context& ctx, const bool gradients_kernels) const noexcept;
    /*!
     * \return true if the inner forces of all the behaviour integrators can
     * be computed by kernels with the given computation of the gradients:
     * the inner forces of a behaviour integrator depending on the current
     * estimate of the solution (regularization of Faltus et al., see
     * `AbstractBehaviourIntegrator::requiresCurrentSolutionForResidualAssembly`)
     * are computed from data computed with the gradients by kernels;
     * otherwise, an error message naming the first behaviour integrator
     * concerned is registered
     * \param[in, out] ctx: execution context
     * \param[in] gradients_kernels: if true, the gradients are computed by
     * kernels
     */
    [[nodiscard]] bool checkInnerForcesKernelsSupport(
        Context& ctx, const bool gradients_kernels) const noexcept;
    /*!
     * \brief compute the gradients of all the behaviour integrators by
     * kernels (first step of the integration by batches, replacing the calls
     * to `computeGradients` element by element): the derivatives of the
     * unknowns are computed once for each integration rule of the
     * materials, then each behaviour integrator computes its gradients
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     * \param[in] u: unknowns (local vector of the finite element space)
     */
    [[nodiscard]] bool computeGradientsByKernels(
        Context& ctx,
        const mfem::FiniteElementSpace& fes,
        const mfem::Vector& u) noexcept;
    /*!
     * \brief add the inner forces of all the behaviour integrators, computed
     * by kernels from the thermodynamic forces at the end of the time step
     * (see `AbstractBehaviourIntegrator::addInnerForcesByKernels`), to a
     * local vector of the finite element space (transposed element
     * restriction)
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     * \param[in, out] f: local vector of the finite element space
     */
    [[nodiscard]] bool addInnerForcesByKernels(
        Context& ctx,
        const mfem::FiniteElementSpace& fes,
        mfem::Vector& f) noexcept;
    /*!
     * \brief if true, `AssembleElementVector` gives null vectors: the inner
     * forces are computed by kernels by the non linear evolution problem
     * (see `addInnerForcesByKernels`)
     * \param[in] b: boolean
     */
    void setInnerForcesComputedByKernels(const bool) noexcept;
    /*!
     * \brief compute the stiffness matrices of all the elements by kernels,
     * from the tangent operator blocks (see
     * `AbstractBehaviourIntegrator::addStiffnessMatricesByKernels`). They are
     * given to MFEM by `AssembleElementGrad` if
     * `setStiffnessMatricesComputedByKernels` was called.
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     */
    [[nodiscard]] bool computeStiffnessMatricesByKernels(
        Context& ctx, const mfem::FiniteElementSpace& fes) noexcept;
    /*!
     * \brief if true, `AssembleElementGrad` gives the stiffness matrices
     * computed by `computeStiffnessMatricesByKernels`
     * \param[in] b: boolean
     */
    void setStiffnessMatricesComputedByKernels(const bool) noexcept;
    /*!
     * \brief if true, `assembleStiffnessMatrixByKernels` stores the
     * stiffness matrices of all the elements (see
     * `computeStiffnessMatricesByKernels`), then adds them to the sparse
     * matrix row by row, in a fixed order (see
     * `batch::addStiffnessMatricesByRows`): the values of the matrix are the
     * same at each assembly, on a GPU too, at the cost of the storage of the
     * stiffness matrices of the elements (`n * n * ne` values, which must
     * fit in an `int`). Otherwise (default), they are added without being
     * stored, by atomic additions whose order depends on the scheduling of
     * the threads on a GPU.
     * \param[in] b: boolean
     */
    void setOrderedStiffnessMatricesAssembly(const bool) noexcept;
    /*!
     * \return the number of assemblies made by
     * `assembleStiffnessMatrixByKernels` in a fixed order (see
     * `setOrderedStiffnessMatricesAssembly`)
     */
    [[nodiscard]] size_type getNumberOfOrderedStiffnessMatricesAssemblies()
        const noexcept;
    /*!
     * \brief add the action of the tangent operator, assembled from the
     * stiffness matrices of the elements computed by kernels from the
     * tangent operator blocks, on increments of the unknowns, without
     * assembling it: `y += Σ Bᵀ K B x w det J` (see
     * `AbstractBehaviourIntegrator::addTangentOperatorActionByKernels`)
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     * \param[in] x: increments of the unknowns (local vector of the finite
     * element space)
     * \param[in, out] y: action (local vector of the finite element space)
     */
    [[nodiscard]] bool addTangentOperatorActionByKernels(
        Context&,
        const mfem::FiniteElementSpace&,
        const mfem::Vector&,
        mfem::Vector&) noexcept;
    /*!
     * \brief add the diagonal of the tangent operator assembled from the
     * stiffness matrices of the elements computed by kernels (see
     * `AbstractBehaviourIntegrator::addTangentOperatorDiagonalByKernels`)
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     * \param[in, out] d: diagonal (local vector of the finite element
     * space)
     */
    [[nodiscard]] bool addTangentOperatorDiagonalByKernels(
        Context&, const mfem::FiniteElementSpace&, mfem::Vector&) noexcept;
    /*!
     * \brief create the sparse matrix in which
     * `assembleStiffnessMatrixByKernels` assembles the stiffness matrices of
     * all the elements (see `batch::makeAssembledStiffnessMatrix`)
     * \return the matrix, or a null pointer on error
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     */
    [[nodiscard]] std::unique_ptr<mfem::SparseMatrix>
    makeAssembledStiffnessMatrix(Context&,
                                 const mfem::FiniteElementSpace&) noexcept;
    /*!
     * \brief assemble the stiffness matrices of all the elements, computed
     * by kernels, in a sparse matrix on the local vector of the finite
     * element space, without storing them (see
     * `AbstractBehaviourIntegrator::addStiffnessMatricesByKernels`), unless
     * the ordered assembly is selected (see
     * `setOrderedStiffnessMatricesAssembly`). The values of the matrix are
     * set to zero first. Unless a GPU or the debug
     * device of MFEM is used, the positions of the entries in the rows of
     * the matrix are computed at the first call and reused (see
     * `batch::computeStiffnessMatricesPositions`), separately for the
     * matrices whose columns are sorted (for example by a direct solver) and
     * for the others (diagonal first, see `makeAssembledStiffnessMatrix`):
     * they stay valid for all the matrices created by
     * `makeAssembledStiffnessMatrix` (same pattern). After an assembly in
     * which some entries were searched (another matrix, rows reordered),
     * they are computed again, at most three times for each layout of the
     * rows, then abandoned (the entries are searched). If their computation
     * fails, they are abandoned. They take about as much memory as the
     * matrix for linear elements. With a GPU, the entries are always
     * searched (the positions gave no gain). See also
     * `setOrderedStiffnessMatricesAssembly`.
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     * \param[in, out] m: matrix created by `makeAssembledStiffnessMatrix`,
     * or a matrix, finalized, whose pattern contains all the entries of the
     * stiffness matrices of the elements
     */
    [[nodiscard]] bool assembleStiffnessMatrixByKernels(
        Context& ctx,
        const mfem::FiniteElementSpace& fes,
        mfem::SparseMatrix& m) noexcept;
    /*!
     * \return the number of computations of the positions of the entries of
     * the stiffness matrices in the rows of the assembled matrices (see
     * `assembleStiffnessMatrixByKernels`)
     * \param[in] sorted: if true, for the matrices whose columns are sorted,
     * otherwise for the others
     */
    [[nodiscard]] int getNumberOfStiffnessMatricesPositionsComputations(
        const bool) const noexcept;
    /*!
     * \return true if positions of the entries of the stiffness matrices
     * are kept (see `assembleStiffnessMatrixByKernels`)
     * \param[in] sorted: if true, for the matrices whose columns are sorted,
     * otherwise for the others
     */
    [[nodiscard]] bool hasStiffnessMatricesPositions(const bool) const noexcept;
    //! \return the current time increment
    [[nodiscard]] real getTimeIncrement() const noexcept;
    /*!
     * \brief set the value of the time increment
     * \param[in] dt: time increment
     */
    void setTimeIncrement(const real dt);
    /*!
     * \brief method called before each resolution
     *
     * \param[in, out] ctx: execution context
     *
     * \param[in] t: time at the beginning of the time step
     * \param[in] dt: time increment
     * \return true on success
     */
    [[nodiscard]] bool setup(Context& ctx,
                             const real t,
                             const real dt) noexcept;
    /*!
     * \brief add a new behaviour integrator
     * \return the behaviour integrator identifier
     * \param[in, out] ctx: execution context
     * \param[in] n: name of the behaviour integrator
     * \param[in] m: material id
     * \param[in] l: library name
     * \param[in] b: behaviour name
     * \param[in] params: additional parameters
     */
    [[nodiscard]] std::optional<size_type> addBehaviourIntegrator(
        Context& ctx,
        const std::string& n,
        const size_type m,
        const std::string& l,
        const std::string& b,
        const Parameters& params = {}) noexcept;
    /*!
     * \brief return the material with the given id
     * \param[in, out] ctx: execution context
     * \param[in] m: material id
     * \param[in] b: behaviour integrator id
     * \return the material
     */
    [[nodiscard]] OptionalReference<const Material> getMaterial(
        Context& ctx, const size_type m, const size_type b) const noexcept;
    /*!
     * \brief return the material with the given id
     * \param[in, out] ctx: execution context
     * \param[in] m: material id
     * \param[in] b: behaviour integrator id
     * \return the material
     */
    [[nodiscard]] OptionalReference<Material> getMaterial(
        Context& ctx, const size_type m, const size_type b) noexcept;
    /*!
     * \brief return the number of behaviour integrators associated with the
     * given material id
     *
     * \param[in, out] ctx: execution context
     * \param[in] m: material id
     * \return the number of behaviour integrators
     */
    [[nodiscard]] std::optional<size_type> getNumberOfBehaviourIntegrators(
        Context& ctx, const size_type m) const noexcept;
    /*!
     * \brief return the behaviour integrator with the given material id
     * \param[in, out] ctx: execution context
     * \param[in] m: material id
     * \param[in] b: behaviour integrator id
     * \return the behaviour integrator
     */
    [[nodiscard]] OptionalReference<const AbstractBehaviourIntegrator>
    getBehaviourIntegrator(Context& ctx,
                           const size_type m,
                           const size_type b) const noexcept;
    /*!
     * \brief return the behaviour integrator with the given material id
     * \param[in, out] ctx: execution context
     * \param[in] m: material id
     * \param[in] b: behaviour integrator id
     * \return the behaviour integrator
     */
    [[nodiscard]] OptionalReference<AbstractBehaviourIntegrator>
    getBehaviourIntegrator(Context& ctx,
                           const size_type m,
                           const size_type b) noexcept;
    /*!
     * \brief revert the internal state variables.
     *
     * The values of the internal state variables at the beginning of the time
     * step are copied on the values of the internal state variables at
     * end of the time step.
     */
    void revert();
    /*!
     * \brief update the internal state variables.
     *
     * The values of the internal state variables at the end of the time step
     * are copied on the values of the internal state variables at beginning of
     * the time step.
     */
    void update();
    /*!
     * \brief makes the copies of the arrays of the materials on the host
     * valid before an access on the host (see `Material::synchronizeOnHost`)
     */
    void synchronizeOnHost();
    /*!
     * \brief makes the copies of the arrays of the materials on the host
     * valid before a read-only access on the host (see
     * `Material::synchronizeOnHostForReading`)
     */
    void synchronizeOnHostForReading() const;
    /*!
     * \brief set the macroscopic gradients
     * \param[in] g: macroscopic gradients
     */
    void setMacroscopicGradients(std::span<const real> g);
    /*!
     * \return the list of material identifiers for which a behaviour
     * integrator has been defined.
     */
    std::vector<size_type> getAssignedMaterialsIdentifiers() const;
    /*!
     * \brief return the linearized operators
     * \return linearized operators
     * \param[in] u: current estimate of the unknowns
     * \note those linearized operators use the consistent tangent operators
     * and thermodynamic forces computed by the integration. The user is
     * responsible for calling the behaviour integration before using those
     * operators
     */
    [[nodiscard]] LinearizedOperators getLinearizedOperators(
        const mfem::Vector& u);
    //! \brief destructor
    ~MultiMaterialNonLinearIntegrator() override;

   protected:
    //! \brief underlying finite element discretization
    const std::shared_ptr<const FiniteElementDiscretization> fe_discretization;
    //! \brief modelling hypothesis
    const Hypothesis hypothesis;
    /*!
     * \brief mapping between the material identifiers and the behaviour
     * integrators.
     */
    std::vector<std::vector<std::unique_ptr<AbstractBehaviourIntegrator>>>
        behaviour_integrators;
    /*!
     * \brief derivatives of the unknowns, by integration rule (workspace of
     * `computeGradientsByKernels`, kept to avoid reallocations)
     */
    batch::UnknownsDerivativesSet unknowns_derivatives;
    /*!
     * \brief geometric data of the integration rules of the behaviour
     * integrators, computed once (see `computeElementsGeometry`)
     */
    batch::ElementsGeometrySet elements_geometry;
    //! \brief inner forces element by element (workspace)
    mfem::Vector inner_forces_element_values;
    //! \brief see `setInnerForcesComputedByKernels`
    bool inner_forces_computed_by_kernels = false;
    /*!
     * \brief stiffness matrices element by element, computed by
     * `computeStiffnessMatricesByKernels` (also used by the ordered assembly,
     * see `setOrderedStiffnessMatricesAssembly`)
     */
    mfem::Vector stiffness_matrices;
    //! \brief see `setStiffnessMatricesComputedByKernels`
    bool stiffness_matrices_computed_by_kernels = false;
    //! \brief see `setOrderedStiffnessMatricesAssembly`
    bool ordered_stiffness_matrices_assembly = false;
    //! \brief see `getNumberOfOrderedStiffnessMatricesAssemblies`
    size_type ordered_stiffness_matrices_assemblies = 0;
    /*!
     * \brief rows of the stiffness matrices of the elements contributing to
     * each row of the assembled matrices, computed by
     * `assembleStiffnessMatrixByKernels` in the ordered assembly (see
     * `setOrderedStiffnessMatricesAssembly`)
     */
    batch::ElementsRows elements_rows;
    /*!
     * \brief degrees of freedom of all the elements (see
     * `batch::computeElementsDegreesOfFreedom`), computed once by
     * `computeElementsDegreesOfFreedom`
     */
    mfem::Array<int> element_dofs;
    /*!
     * \brief positions of the entries of the stiffness matrices of all the
     * elements in the rows of the assembled matrices (see
     * `batch::computeStiffnessMatricesPositions`), computed by
     * `assembleStiffnessMatrixByKernels`, for the matrices whose columns are
     * not sorted (first array) or sorted (second array)
     */
    std::array<mfem::Array<std::uint16_t>, 2> stiffness_matrices_positions;
    //! \brief numbers of computations of `stiffness_matrices_positions`
    std::array<int, 2> stiffness_matrices_positions_computations = {0, 0};
    /*!
     * \brief increments of the unknowns element by element (see
     * `addTangentOperatorActionByKernels`)
     */
    mfem::Vector tangent_operator_element_arguments;
    /*!
     * \brief values element by element of the action or of the diagonal of
     * the tangent operator
     */
    mfem::Vector tangent_operator_element_values;
    /*!
     * \return the integration rules of the behaviour integrators (rules
     * shared by all the elements of a material), and the additional rules
     * used by their kernels (see
     * `AbstractBehaviourIntegrator::getAdditionalIntegrationRulesForKernels`)
     */
    [[nodiscard]] std::vector<const mfem::IntegrationRule*>
    getIntegrationRules() const;
    /*!
     * \brief computes the degrees of freedom of all the elements if they are
     * not computed yet
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     */
    [[nodiscard]] bool computeElementsDegreesOfFreedom(
        Context&, const mfem::FiniteElementSpace&) noexcept;
    /*!
     * \brief computes the geometric data of the integration rules of the
     * behaviour integrators which are not computed yet (see
     * `elements_geometry`)
     * \return true on success
     * \param[in, out] ctx: execution context
     * \param[in] fes: finite element space
     */
    [[nodiscard]] bool computeElementsGeometry(
        Context&, const mfem::FiniteElementSpace&) noexcept;
  };  // end of MultiMaterialNonLinearIntegrator

}  // end of namespace mfem_mgis

#endif /* LIB_MFEM_MGIS_MULTIMATERIALNONLINEARINTEGRATOR_HXX */
