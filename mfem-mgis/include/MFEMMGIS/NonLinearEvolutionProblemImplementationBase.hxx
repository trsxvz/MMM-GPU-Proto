 */

#ifndef LIB_MFEM_MGIS_NONLINEAREVOLUTIONPROBLEMIMPLEMENTATIONBASE_HXX
#define LIB_MFEM_MGIS_NONLINEAREVOLUTIONPROBLEMIMPLEMENTATIONBASE_HXX

#include <memory>
#include <functional>
#include <vector>
#include "mfem/general/array.hpp"
#include "mfem/linalg/vector.hpp"
#include "mfem/linalg/sparsemat.hpp"
#ifdef MFEM_MGIS_HAVE_PETSC
#include "mfem/linalg/petsc.hpp"
#endif /* MFEM_MGIS_HAVE_PETSC */

#include "MFEMMGIS/Config.hxx"
#include "MFEMMGIS/FiniteElementDiscretization.hxx"
#include "MFEMMGIS/AbstractNonLinearEvolutionProblem.hxx"

namespace mfem {
  // forward declaration
  class ConstrainedOperator;
}  // end of namespace mfem

namespace mfem_mgis {

  // forward declarations
  struct Parameters;
  struct DirichletBoundaryCondition;
  struct FiniteElementDiscretization;
  struct Material;
  struct AbstractBehaviourIntegrator;
  struct MultiMaterialNonLinearIntegrator;
  struct MatrixFreeTangentOperator;
  struct ConstrainedMatrixFreeTangentOperator;
  struct NewtonSolver;
  enum struct IntegrationType;
  struct LinearSolverHandler;
  struct AbstractNonLinearSolver;

  /*!
   * \brief class for solving non linear evolution problems.
   *
   * By default, we use the `MultiMaterialNonLinearIntegrator` class to
   * compute the inner forces contributions to the residual.
   */
  struct MFEM_MGIS_EXPORT NonLinearEvolutionProblemImplementationBase
      : AbstractNonLinearEvolutionProblem {
    //! \brief a simple alias
    using Hypothesis = mgis::behaviour::Hypothesis;
    //! \brief name of the parameter used to select a nonlinear solver
    static const char* const NonLinearSolver;
    /*!
     * \brief name of the parameter used to activate or deactivate
     * the use of the `MultiMaterialNonLinearIntegrator` class
     */
    static const char* const UseMultiMaterialNonLinearIntegrator;
    /*!
     * \brief name of the parameter used to select the integration of the
     * behaviours: `PointByPoint` (default: the behaviour integrators
     * integrate the behaviours element by element, point by point) or
     * `Batch` (the gradients are computed element by element, then each
     * behaviour integrator integrates its behaviour at all the points with
     * a single call to MGIS: point by point in MGIS, up to the first
     * failure, for a behaviour generated by the `generic` interface, as a
     * batch of all the points, even if some of them fail, for a behaviour
     * generated by the `generic-parallel` interface, which can only be
     * integrated in this mode). `Batch` is not supported with PETSc.
     * Without this parameter, the value is given by the environment variable
     * `MFEM_MGIS_BEHAVIOUR_INTEGRATION`, if defined and if the option
     * `--execution` is not given, or else by the execution settings (see
     * `ExecutionSettings`): `Batch` when the execution mode is given and
     * PETSc is not used, this default being replaced by `PointByPoint` at
     * the first setup if the behaviour integrators do not support it,
     * `PointByPoint` otherwise.
     */
    static const char* const BehaviourIntegration;
    /*!
     * \brief name of the parameter selecting the computation of the
     * gradients in the integration by batches: `ElementByElement` (default:
     * the behaviour integrators compute the gradients element by element)
     * or `Kernels` (the derivatives and, if required, the values of the
     * unknowns are computed for all the elements by a kernel, then each
     * behaviour integrator computes its gradients by a kernel, on the device
     * if a device is enabled). `Kernels` requires `BehaviourIntegration` set
     * to `Batch`, and is supported, in 3D, plane strain and plane stress,
     * for the standard mechanical behaviours (small and finite strain, with
     * the FBar formulation and the regularisation of Faltus et al. in 3D and
     * in plane strain, without the other regularisations), the stationary
     * non linear heat transfer behaviours, the transient term of the heat
     * equation and the micromorphic damage behaviours, on meshes with one
     * geometry, whose space dimension is the dimension of the mesh (NURBS
     * meshes excepted), with a finite element space of uniform order mapped
     * by value (H1) and a behaviour integrator on each material of the mesh.
     * Without this parameter, the value is given by the environment variable
     * `MFEM_MGIS_GRADIENTS_COMPUTATION`, if defined and if the option
     * `--execution` is not given, or else by the execution settings (see
     * `ExecutionSettings`): `Kernels` if the finite elements are computed on
     * the GPU or with `--execution cpu`, unless PETSc is used (with
     * `--execution cpu`, this default is replaced by `ElementByElement` at
     * the first setup if the behaviour integrators do not support it),
     * `ElementByElement` otherwise.
     */
    static const char* const GradientsComputation;
    /*!
     * \brief name of the parameter selecting the computation of the inner
     * forces of the behaviour integrators of mfem-mgis in the residual:
     * `ElementByElement` (default) or `Kernels` (computed for all the
     * elements by kernels from the thermodynamic forces, on the device if a
     * device is enabled, then summed by the transposed element restriction
     * of MFEM). `Kernels` is supported for the same behaviour integrators
     * and meshes as for `GradientsComputation`, not with PETSc. Without this
     * parameter, the value is given by the environment variable
     * `MFEM_MGIS_INNER_FORCES_COMPUTATION`, if defined and if the option
     * `--execution` is not given, or else by the execution settings, as for
     * `GradientsComputation`.
     */
    static const char* const InnerForcesComputation;
    /*!
     * \brief name of the parameter selecting the computation of the
     * stiffness matrices of the elements of the behaviour integrators of
     * mfem-mgis in the tangent operator: `ElementByElement` (default) or
     * `Kernels` (computed for all the elements by kernels from the tangent
     * operator blocks, on the device if a device is enabled, and assembled
     * by kernels in the sparse matrix of the tangent operator, the
     * contributions of the other integrators of the non linear form being
     * added on the host, except with interior face integrators or an
     * extension of MFEM, which require the assembly of MFEM), or
     * `MatrixFree` (the tangent operator is applied without assembly by
     * kernels, see `MatrixFreeTangentOperator`, the essential degrees of
     * freedom being constrained by `mfem::ConstrainedOperator`: the linear
     * solver must not require a matrix, for instance `CGSolver` with the
     * `OperatorJacobiSmoother` preconditioner, or with the
     * `AssembledOperator` preconditioner, built on the assembled tangent
     * operator; the non linear form must only contain the integrator of
     * mfem-mgis). With the inner forces computed by kernels, the boundary
     * conditions independent of the unknowns (imposed pressure, heat source,
     * see `AbstractBoundaryCondition::isIndependentOfTheUnknowns`) add their
     * contributions to the residual without integrator in the non linear
     * form. `Kernels` and `MatrixFree` are supported for the same
     * behaviour integrators and meshes as for `GradientsComputation`, not
     * with PETSc; with the FBar formulation, whose stiffness matrices depend
     * on the current estimate of the solution, they require the gradients
     * computed by kernels. Without this parameter, the value is given by the
     * environment variable `MFEM_MGIS_TANGENT_OPERATOR_COMPUTATION`, if
     * defined and if the option `--execution` is not given, or else by the
     * execution settings, as for `GradientsComputation`.
     */
    static const char* const TangentOperatorComputation;
    /*!
     * \brief name of the parameter selecting the assembly of the stiffness
     * matrices computed by kernels in the sparse matrices of the tangent
     * operator and of the elastic operator (see `TangentOperatorComputation`):
     * `Atomic` (default: with a device, they are added without being stored,
     * by atomic additions whose order depends on the scheduling of the
     * threads, so that the values may differ, in the last digits, from one
     * assembly to the next) or `Ordered` (they are added in a fixed order:
     * the values are the same at each assembly, at the cost of the storage
     * of the stiffness matrices of all the elements with a device, see
     * `MultiMaterialNonLinearIntegrator::setOrderedStiffnessMatricesAssembly`).
     * Without device, both values give the same assembly, one element after
     * the other on the host. The parameter has no effect when the stiffness
     * matrices are computed element by element. The default value is given
     * by the environment variable `MFEM_MGIS_TANGENT_OPERATOR_ASSEMBLY`, if
     * defined.
     */
    static const char* const TangentOperatorAssembly;
    //! \brief computations of the tangent operator
    enum struct TangentOperatorComputationMode {
      //! \brief stiffness matrices computed element by element, assembled
      ELEMENT_BY_ELEMENT,
      //! \brief stiffness matrices computed by kernels, assembled
      KERNELS,
      //! \brief tangent operator applied without assembly by kernels
      MATRIX_FREE
    };
    //! \return the list of valid parameters
    static std::vector<std::string> getParametersList();
    /*!
     * \brief constructor
     * \param[in, out] ctx: execution context
     * \param[in] fed: finite element discretization
     * \param[in] h: modelling hypothesis
     * \param[in] p: parameters
     */
    NonLinearEvolutionProblemImplementationBase(
        Context& ctx,
        const FiniteElementDiscretization& fed,
        const Hypothesis h,
        const Parameters& p);
    /*!
     * \brief set the macroscopic gradients
     * \param[in] g: macroscopic gradients
     */
    virtual void setMacroscopicGradients(const std::vector<real>& g);
    /*!
     * \brief set the linear solver
     * \param[in, out] ctx: execution context
     * \param[in] s: linear solver
     * \return true on success
     */
    [[nodiscard]] virtual bool updateLinearSolver(
        Context& ctx, std::unique_ptr<LinearSolver> s) noexcept;
    /*!
     * \brief set the linear solver
     * \param[in, out] ctx: execution context
     * \param[in] s: linear solver
     * \param[in] p: linear solver preconditioner
     * \return true on success
     */
    [[nodiscard]] virtual bool updateLinearSolver(
        Context& ctx,
        std::unique_ptr<LinearSolver> s,
        std::unique_ptr<LinearSolverPreconditioner> p) noexcept;
    /*!
     * \brief set the linear solver
     * \param[in, out] ctx: execution context
     * \param[in] s: linear solver handler
     * \return true on success
     */
    [[nodiscard]] virtual bool updateLinearSolver(
        Context& ctx, LinearSolverHandler s) noexcept;
    /*!
     * \brief method called before each resolution
     *
     * This method must be called before `solve`: this is not done automatically
     * as this is the case for `NonLinearEvolutionProblem::solve`. This is
     * mostly motivated by unit testing, see `PredictionTest` for an example.
     *
     * \param[in, out] ctx: execution context
     * \param[in] t: time at the beginning of the time step
     * \param[in] dt: time increment
     * \return true on success
     */
    [[nodiscard]] virtual bool setup(Context& ctx,
                                     const real t,
                                     const real dt) noexcept;
    //
    [[nodiscard]] FiniteElementDiscretization getFiniteElementDiscretization()
        const noexcept override;
    [[nodiscard]] bool setMaterialsNames(
        Context& ctx,
        const std::map<size_type, std::string>& ids) noexcept override;
    [[nodiscard]] bool setBoundariesNames(
        Context& ctx,
        const std::map<size_type, std::string>& ids) noexcept override;
    [[nodiscard]] mfem::Vector& getUnknowns(
        const TimeStepStage ts) noexcept override;
    [[nodiscard]] const mfem::Vector& getUnknowns(
        const TimeStepStage ts) const noexcept override;
    /*!
     * \return the list of material identifiers for which a behaviour
     * integrator has been defined, empty if the multi material support is
     * disabled.
     */
    [[nodiscard]] std::vector<size_type> getAssignedMaterialsIdentifiers()
        const noexcept override;
    [[nodiscard]] std::optional<size_type> getMaterialIdentifier(
        Context& ctx, const Parameter& m) const noexcept override;
    [[nodiscard]] std::optional<size_type> getBoundaryIdentifier(
        Context& ctx, const Parameter& m) const noexcept override;
    [[nodiscard]] std::optional<std::vector<size_type>> getMaterialsIdentifiers(
        Context& ctx, const Parameter& m) const noexcept override;
    [[nodiscard]] std::optional<std::vector<size_type>>
    getBoundariesIdentifiers(Context& ctx,
                             const Parameter& m) const noexcept override;
    OptionalReference<const Material> getMaterial(
        Context& ctx,
        const Parameter& m,
        const size_type b) const noexcept override;
    OptionalReference<Material> getMaterial(
        Context& ctx, const Parameter& m, const size_type b) noexcept override;
    [[nodiscard]] std::optional<size_type> getNumberOfBehaviourIntegrators(
        Context& ctx, const Parameter& m) const noexcept override;
    OptionalReference<const AbstractBehaviourIntegrator> getBehaviourIntegrator(
        Context& ctx,
        const Parameter& m,
        const size_type b) const noexcept override;
    OptionalReference<AbstractBehaviourIntegrator> getBehaviourIntegrator(
        Context& ctx, const Parameter& m, const size_type b) noexcept override;
    std::optional<std::map<size_type, size_type>> addBehaviourIntegrator(
        Context& ctx,
        const std::string& n,
        const Parameter& m,
        const std::string& l,
        const std::string& b) noexcept override;
    std::optional<std::map<size_type, size_type>> addBehaviourIntegrator(
        Context& ctx,
        const std::string& n,
        const Parameter& m,
        const std::string& l,
        const std::string& b,
        const Parameters& params) noexcept override;
    [[nodiscard]] std::vector<size_type> getEssentialDegreesOfFreedom()
        const override;
    [[nodiscard]] bool areStiffnessOperatorsFromLastIterationAvailable()
        const noexcept override;
    [[nodiscard]] std::optional<LinearizedOperators> getLinearizedOperators(
        Context& ctx, const mfem::Vector& U) noexcept override;
    [[nodiscard]] const std::vector<
        std::unique_ptr<AbstractDirichletBoundaryCondition>>&
    getDirichletBoundaryConditions() const noexcept override;
    [[nodiscard]] const std::vector<std::unique_ptr<AbstractBoundaryCondition>>&
    getBoundaryConditions() const noexcept override;
    void setPredictionPolicy(const PredictionPolicy& p) noexcept override;
    [[nodiscard]] bool setSolverParameters(
        Context& ctx, const Parameters& params) noexcept override;
    [[nodiscard]] PredictionPolicy getPredictionPolicy()
        const noexcept override;
    /*!
     * \brief solve the non linear problem over the given time step
     * \param[in, out] ctx: execution context
     * \param[in] t: time at the beginning of the time step
     * \param[in] dt: time increment
     * \return the output of the non linear resolution
     * \note `setup` must be called before
     */
    [[nodiscard]] NonLinearResolutionOutput solve(
        Context& ctx, const real t, const real dt) noexcept override;
    [[nodiscard]] bool revert(Context& ctx) noexcept override;
    [[nodiscard]] bool update(Context& ctx) noexcept override;
    /*!
     * \return the number of assemblies of the tangent operator by kernels
     * in the local matrix of the finite element space (the stiffness matrices
     * of the elements being assembled by kernels, then the contributions of
     * the other integrators of the non linear form, if any, being added)
     */
    [[nodiscard]] size_type getNumberOfTangentOperatorAssembliesByKernels()
        const noexcept;
    /*!
     * \return the number of assemblies of the stiffness matrices computed by
     * kernels made in a fixed order (see `TangentOperatorAssembly`), for the
     * tangent operator and the other operators assembled by kernels (elastic
     * operator of the fixed point solver, for instance)
     */
    [[nodiscard]] size_type getNumberOfOrderedStiffnessMatricesAssemblies()
        const noexcept;
    /*!
     * \return the number of evaluations of the residual in which the
     * contributions of the integrators of the non linear form other than the
     * one of mfem-mgis were added to the inner forces computed by kernels
     */
    [[nodiscard]] size_type getNumberOfOtherIntegratorsResidualEvaluations()
        const noexcept;
    //! \brief destructor
    ~NonLinearEvolutionProblemImplementationBase() override;

   protected:
    /*!
     * \brief declare the degrees of freedom handled by Dirichlet boundary
     * conditions.
     * \param[in] dofs: list of degrees of freedom
     *
     * \note copy is required to create a mutable mfem::Array
     */
    virtual void markDegreesOfFreedomHandledByDirichletBoundaryConditions(
        std::vector<size_type> dofs) = 0;
    /*!
     * \brief set the time increment
     * \param[in] dt: time increment
     */
    virtual void setTimeIncrement(const real dt);
    /*!
     * \brief compute a prediction of the unknowns at the end of the time step
     * \param[in, out] ctx: execution context
     * \param[in] t: time at the beginning of the time step
     * \param[in] dt: time increment
     * \return the norm of the initial residual
     */
    [[nodiscard]] virtual std::optional<real> computePrediction(
        Context& ctx, const real t, const real dt) noexcept = 0;
    //! \brief underlying finite element discretization
    FiniteElementDiscretization fe_discretization;
    //! \brief list of Dirichlet boundary conditions
    std::vector<std::unique_ptr<AbstractDirichletBoundaryCondition>>
        dirichlet_boundary_conditions;
    /*!
     * \brief a boolean value to specify if the initialization phase is still
     * open.
     *
     * This initialization phase ends at the first call to the `setup` method,
     * i.e. at the first call of the `NonLinearEvolutionProblem::solve` method.
     */
    bool initialization_phase = true;
    //! \brief if the stiffness operators of the last iteration are available
    bool hasStiffnessOperatorsBeenComputed = false;
    //! \brief unknowns at the beginning of the time step
    mfem::Vector u0;
    //! \brief unknowns at the end of the time step
    mfem::Vector u1;
    //! \brief nonlinear solver
    std::unique_ptr<AbstractNonLinearSolver> solver;
#ifdef MFEM_MGIS_HAVE_PETSC
    //! \brief newton solver
    std::unique_ptr<mfem::PetscNonlinearSolver> petsc_solver;
#endif /* MFEM_MGIS_HAVE_PETSC */
    //! \brief linear solver
    std::unique_ptr<LinearSolver> linear_solver;
    //! \brief linear solver preconditioner
    std::unique_ptr<LinearSolverPreconditioner> linear_solver_preconditioner;
    /*!
     * \brief pointer to the underlying domain integrator
     * The memory associated with this pointer must be released in derived class
     */
    MultiMaterialNonLinearIntegrator* const mgis_integrator = nullptr;
    //! \brief registered boundary conditions
    std::vector<std::unique_ptr<AbstractBoundaryCondition>> boundary_conditions;
    /*!
     * \brief boundary conditions independent of the unknowns whose
     * contributions to the residual are added to the inner forces computed
     * by kernels, without integrator in the non linear form (see
     * `AbstractBoundaryCondition::isIndependentOfTheUnknowns`). They are
     * owned by `boundary_conditions`.
     */
    std::vector<AbstractBoundaryCondition*> residual_boundary_conditions;
    //! \brief prediction policy
    PredictionPolicy prediction_policy;
    //! \brief modelling hypothesis
    const Hypothesis hypothesis;
    /*!
     * \brief replaces the integration by batches by the integration point
     * by point, and the computations of the finite elements by kernels by
     * the computations element by element, if they are optional defaults of
     * the execution settings (see `optional_batch_integration` and
     * `optional_finite_elements_kernels`) not supported by the behaviour
     * integrators. Collective.
     */
    void selectOptionalComputations() noexcept;
    //! \brief if true, the behaviours are integrated by batches
    bool batch_integration;
    /*!
     * \brief if true, the integration by batches is a default of the
     * execution settings, replaced by the integration point by point at the
     * first setup if the behaviour integrators do not support it
     */
    bool optional_batch_integration;
    /*!
     * \brief if true, the gradients of the integration by batches are
     * computed by kernels
     */
    bool gradients_kernels;
    //! \brief if true, the inner forces are computed by kernels
    bool inner_forces_kernels;
    //! \brief computation of the tangent operator
    TangentOperatorComputationMode tangent_operator_computation;
    /*!
     * \brief if true, the computations of the finite elements by kernels
     * are a default of the execution settings (`--execution cpu`), replaced
     * by the computations element by element at the first setup if the
     * behaviour integrators do not support them
     */
    bool optional_finite_elements_kernels;
    /*!
     * \brief if true, the stiffness matrices computed by kernels are added
     * to the sparse matrices in a fixed order (see `TangentOperatorAssembly`)
     */
    const bool ordered_tangent_operator_assembly;
    /*!
     * \return if the stiffness matrices of the elements are computed by
     * kernels: computation by kernels, or tangent operator applied without
     * assembly, whose assembled version is computed by kernels (see
     * `TangentOperatorComputation`)
     */
    [[nodiscard]] bool computesStiffnessMatricesByKernels() const noexcept;
    /*!
     * \return if the tangent operator is applied without assembly (see
     * `TangentOperatorComputation`)
     */
    [[nodiscard]] bool appliesTangentOperatorWithoutAssembly() const noexcept;
    /*!
     * \return the tangent operator applied without assembly, the essential
     * degrees of freedom being constrained (created at the first call, or
     * if the essential degrees of freedom changed), which can give
     * its assembled version (see `AssembledOperatorProvider`)
     * \param[in] essential_dofs: essential true degrees of freedom
     * \param[in] f: function assembling the tangent operator, the essential
     * degrees of freedom being eliminated
     */
    [[nodiscard]] mfem::Operator& getMatrixFreeTangentOperator(
        const mfem::Array<int>& essential_dofs,
        std::function<mfem::Operator&()> f) const;
    /*!
     * \brief inner forces computed by kernels (local vector of the finite
     * element space), kept between the evaluations of the residual
     */
    mutable mfem::Vector inner_forces_by_kernels;
    /*!
     * \brief number of assemblies of the tangent operator by kernels
     * (`assembleTangentOperatorByKernels`), shared with the operators which
     * give an assembled version of themselves (see
     * `AssembledOperatorProvider::getAssembledOperatorRevision`)
     */
    const std::shared_ptr<size_type> assembled_tangent_operator_revision =
        std::make_shared<size_type>(0);
    /*!
     * \brief number of evaluations of the residual in which the
     * contributions of the other integrators of the non linear form were
     * added to the inner forces computed by kernels
     */
    mutable size_type other_integrators_residual_evaluations = 0;
    /*!
     * \brief local matrix of the operator of the prediction, assembled by
     * kernels (see `TangentOperatorComputation`), created at the first
     * prediction
     */
    std::unique_ptr<mfem::SparseMatrix> prediction_matrix;

   private:
    //! \brief tangent operator applied without assembly
    mutable std::unique_ptr<MatrixFreeTangentOperator> tangent_operator;
    //! \brief tangent operator with constrained essential degrees of freedom
    mutable std::unique_ptr<ConstrainedMatrixFreeTangentOperator>
        constrained_tangent_operator;
    /*!
     * \brief essential degrees of freedom of this operator, copied because
     * `mfem::ConstrainedOperator` keeps a reference to its list
     */
    mutable mfem::Array<int> constrained_tangent_operator_essential_dofs;
  };  // end of struct NonLinearEvolutionProblemImplementationBase

}  // end of namespace mfem_mgis

#endif /* LIB_MFEM_MGIS_NONLINEAREVOLUTIONPROBLEMIMPLEMENTATIONBASE_HXX */
