/*!
 * \file   include/MFEMMGIS/Batch/Gradients.hxx
 * \brief  This file declares the computation of the gradients of the
 * behaviours by kernels of MFEM, for all the integration points of a
 * material at once
 * \date   09/10/2026
 */

#ifndef LIB_MFEM_MGIS_BATCH_GRADIENTS_HXX
#define LIB_MFEM_MGIS_BATCH_GRADIENTS_HXX

#include <map>
#include <optional>
#include "mfem/linalg/vector.hpp"
#include "MFEMMGIS/Config.hxx"
#include "MFEMMGIS/Behaviour.hxx"
#include "MFEMMGIS/Batch/ElementsGeometry.hxx"

namespace mfem {
  // forward declarations
  class FiniteElementSpace;
  class IntegrationRule;
}  // end of namespace mfem

namespace mfem_mgis {
  // forward declarations
  struct Material;
  struct PartialQuadratureSpace;
}  // end of namespace mfem_mgis

namespace mfem_mgis::batch {

  /*!
   * \brief derivatives of the unknowns at the integration points of all the
   * elements of the mesh, for one integration rule (see
   * `computeUnknownsDerivatives`)
   */
  struct MFEM_MGIS_EXPORT UnknownsDerivatives {
    //! \brief integration rule
    const mfem::IntegrationRule* rule = nullptr;
    /*!
     * \brief derivatives with respect to the coordinates of the reference
     * element, in the layout `byVDIM` of MFEM: the derivative of the `i`-th
     * component of the unknowns with respect to the `j`-th reference
     * coordinate at the `q`-th point of the `e`-th element is the value
     * `i + vdim * (j + dim * (q + nq * e))`. In the memory of MFEM, valid
     * on the device if a device is enabled. They are converted to physical
     * derivatives by the kernels with the inverses of the jacobians of the
     * element transformations (see `ElementsGeometry`).
     */
    mfem::Vector values;
    //! \brief values of the unknowns element by element (workspace)
    mfem::Vector element_values;
    /*!
     * \brief values of the unknowns at the integration points, if computed
     * (see `computeUnknownsDerivatives`): the value of the `i`-th component
     * at the `q`-th point of the `e`-th element is `i + vdim * (q + nq * e)`.
     * They give the gradients which depend on the values of the unknowns
     * (see `gradientsRequireUnknownsValues`) and the external state
     * variables computed from the unknowns (see
     * `areUnknownsValuesExternalStateVariables`).
     */
    mfem::Vector point_values;
    //! \brief if true, the values at the integration points are computed
    bool has_point_values = false;
    //! \brief number of components of the unknowns
    int vdim = 0;
    //! \brief dimension of the space
    int dim = 0;
    //! \brief number of integration points per element
    int nq = 0;
    //! \brief number of elements
    int ne = 0;
  };

  /*!
   * \brief derivatives of the unknowns for the integration rules of several
   * materials, computed once for each integration rule
   */
  using UnknownsDerivativesSet =
      std::map<const mfem::IntegrationRule*, UnknownsDerivatives>;

  /*!
   * \brief gradients of the behaviours computed by the kernels, from the
   * values or the derivatives of the unknowns (displacement, temperature or
   * micromorphic damage), in the order of the gradients of the behaviours
   * (as the behaviour integrators generated by mfem-mgis)
   */
  enum struct GradientsKind {
    /*!
     * \brief linearised strain in 3D: `(e11, e22, e33, √2 e12, √2 e13,
     * √2 e23)`
     */
    SMALL_STRAIN_3D,
    /*!
     * \brief linearised strain in 2D (plane strain and plane stress):
     * `(e11, e22, 0, √2 e12)`
     */
    SMALL_STRAIN_2D,
    /*!
     * \brief deformation gradient in 3D: `(F11, F22, F33, F12, F21, F13,
     * F31, F23, F32)`, the identity being given by the macroscopic
     * gradients
     */
    DEFORMATION_GRADIENT_3D,
    /*!
     * \brief deformation gradient in 2D (plane strain and plane stress):
     * `(F11, F22, F33, F12, F21)`, `F33` and the identity being given by the
     * macroscopic gradients
     */
    DEFORMATION_GRADIENT_2D,
    /*!
     * \brief temperature gradient in 3D (stationary non linear heat
     * transfer): `(dT/dx, dT/dy, dT/dz)`. The temperature at the integration
     * points is an external state variable of the behaviour, and the tangent
     * operator blocks are the derivatives of the heat flux with respect to
     * the temperature gradient and to the temperature.
     */
    TEMPERATURE_GRADIENT_3D,
    /*!
     * \brief temperature gradient in 2D (plane strain and plane stress):
     * `(dT/dx, dT/dy)` (see `TEMPERATURE_GRADIENT_3D`)
     */
    TEMPERATURE_GRADIENT_2D,
    /*!
     * \brief temperature in 3D (transient term of the heat equation): the
     * gradient of the behaviour is the value of the unknowns (temperature)
     * at the integration point, computed from the values of the shape
     * functions, and the tangent operator block is the derivative of the
     * thermodynamic force (opposite of the rate of the enthalpy) with
     * respect to the temperature
     */
    TEMPERATURE_3D,
    /*!
     * \brief temperature in 2D (plane strain and plane stress), see
     * `TEMPERATURE_3D`
     */
    TEMPERATURE_2D,
    /*!
     * \brief micromorphic damage and its gradient in 3D: `(dχ, ddχ/dx,
     * ddχ/dy, ddχ/dz)`, computed from the values and from the derivatives of
     * the unknowns (micromorphic damage). The tangent operator blocks are
     * the derivative of the first dual force with respect to the
     * micromorphic damage and the derivatives of the second dual force with
     * respect to the gradient (block diagonal tangent operator, `1 + 3 x 3`
     * components).
     */
    MICROMORPHIC_DAMAGE_3D,
    /*!
     * \brief micromorphic damage and its gradient in 2D (plane strain and
     * plane stress): `(dχ, ddχ/dx, ddχ/dy)`, see `MICROMORPHIC_DAMAGE_3D`
     */
    MICROMORPHIC_DAMAGE_2D
  };

  /*!
   * \return the kind of the gradients of a behaviour computed by the
   * kernels, if supported: small strain and finite strain (deformation
   * gradient) mechanical behaviours, stationary non linear heat transfer
   * behaviours (temperature gradient, heat flux), behaviours of the
   * transient term of the heat equation (temperature, opposite of the rate
   * of the enthalpy) and micromorphic damage behaviours, in 3D, plane strain
   * and plane stress
   * \param[in] b: behaviour
   */
  MFEM_MGIS_EXPORT [[nodiscard]] std::optional<GradientsKind> getGradientsKind(
      const Behaviour& b) noexcept;
  /*!
   * \return the number of components of the gradients of the given kind,
   * which is also the number of components of the associated thermodynamic
   * forces
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] size_type getGradientsSize(
      const GradientsKind k) noexcept;
  /*!
   * \return the number of components of the tangent operator blocks of the
   * given kind of gradients: the derivatives of the thermodynamic forces
   * with respect to the gradients (diagonal blocks only for the
   * micromorphic damage behaviours, `1 + dim x dim` components), and, for
   * the stationary heat transfer behaviours, the derivatives of the heat
   * flux with respect to the temperature
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] size_type getTangentOperatorBlocksSize(
      const GradientsKind k) noexcept;
  /*!
   * \return the dimension of the space for the given kind of gradients
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] int getSpaceDimension(
      const GradientsKind k) noexcept;
  /*!
   * \return the number of components of the unknowns for the given kind of
   * gradients: the dimension of the space for the mechanical behaviours, one
   * for the heat transfer and micromorphic damage behaviours
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] int getUnknownsSize(
      const GradientsKind k) noexcept;
  /*!
   * \return true if the gradients of the given kind depend on the values of
   * the unknowns at the integration points, computed from the values of the
   * shape functions (temperature of the transient term of the heat
   * equation, micromorphic damage)
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] bool gradientsRequireUnknownsValues(
      const GradientsKind k) noexcept;
  /*!
   * \return true if the gradients of the given kind depend on the
   * derivatives of the unknowns, computed from the derivatives of the shape
   * functions (all the kinds but the temperature of the transient term of
   * the heat equation)
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] bool gradientsRequireUnknownsDerivatives(
      const GradientsKind k) noexcept;
  /*!
   * \return true if the values of the unknowns at the integration points
   * are an external state variable of the behaviours of the given kind of
   * gradients (temperature of the stationary heat transfer behaviours),
   * whose derivative with respect to the unknowns follows the derivatives of
   * the thermodynamic forces with respect to the gradients in the tangent
   * operator blocks
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] bool areUnknownsValuesExternalStateVariables(
      const GradientsKind k) noexcept;
  /*!
   * \return true if the values of the unknowns at the integration points
   * are required by the given kind of gradients: by the gradients (see
   * `gradientsRequireUnknownsValues`) or by an external state variable of
   * the behaviour (see `areUnknownsValuesExternalStateVariables`)
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] bool requiresUnknownsValues(
      const GradientsKind k) noexcept;
  /*!
   * \brief computes the derivatives of the unknowns at the points of an
   * integration rule, for all the elements of the mesh: element
   * restriction, then derivatives with respect to the reference coordinates
   * by a kernel, from the gradients of the shape functions on the reference
   * element (`mfem::DofToQuad`), on the device if a device is enabled. The
   * values of the unknowns at the points are also computed if requested,
   * from the values of the shape functions.
   * \return true on success
   * \param[in, out] ctx: execution context
   * \param[out] d: derivatives
   * \param[in] fes: finite element space. Its elements must have the same
   * geometry.
   * \param[in] u: unknowns (local vector of the finite element space,
   * after the prolongation for a parallel space)
   * \param[in] ir: integration rule
   * \param[in] values: if true, the values of the unknowns at the points are
   * computed
   */
  MFEM_MGIS_EXPORT [[nodiscard]] bool computeUnknownsDerivatives(
      Context& ctx,
      UnknownsDerivatives& d,
      const mfem::FiniteElementSpace& fes,
      const mfem::Vector& u,
      const mfem::IntegrationRule& ir,
      const bool values = false) noexcept;
  /*!
   * \brief gathers the values of the unknowns at the integration points of
   * a material, in the order of the points of the material, by a kernel, on
   * the device if a device is enabled: the value of the `i`-th component at
   * the point `o` is `v[i + vdim * o]`
   * \return true on success
   * \param[in, out] ctx: execution context
   * \param[out] v: values
   * \param[in] qs: quadrature space of the material. All its elements must
   * use the integration rule of the derivatives.
   * \param[in] d: derivatives of the unknowns, with the values at the points
   */
  MFEM_MGIS_EXPORT [[nodiscard]] bool getUnknownsValues(
      Context& ctx,
      mfem::Vector& v,
      const PartialQuadratureSpace& qs,
      const UnknownsDerivatives& d) noexcept;
  /*!
   * \brief computes the gradients at the end of the time step of a material
   * at all its integration points, by a kernel: macroscopic gradients plus
   * the contributions of the unknowns, written in the array of the
   * gradients of the material (in its layout), on the device if a device is
   * enabled
   * \return true on success
   * \param[in, out] ctx: execution context
   * \param[in, out] m: material. All the elements of its quadrature space
   * must use the integration rule of the derivatives.
   * \param[in] d: derivatives of the unknowns
   * \param[in] g: geometric data of the integration rule of the derivatives
   * \param[in] k: kind of the gradients
   */
  MFEM_MGIS_EXPORT [[nodiscard]] bool computeGradients(
      Context& ctx,
      Material& m,
      const UnknownsDerivatives& d,
      const ElementsGeometry& g,
      const GradientsKind k) noexcept;

}  // end of namespace mfem_mgis::batch

#endif /* LIB_MFEM_MGIS_BATCH_GRADIENTS_HXX */
