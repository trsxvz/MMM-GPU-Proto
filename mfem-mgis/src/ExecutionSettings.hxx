/*!
 * \file   src/ExecutionSettings.hxx
 * \brief  This file declares the reading of the execution settings and the
 * checks and default values derived from them (internal header)
 * \date   13/10/2026
 */

#ifndef LIB_MFEM_MGIS_SRC_EXECUTIONSETTINGS_HXX
#define LIB_MFEM_MGIS_SRC_EXECUTIONSETTINGS_HXX

#include <utility>
#include <optional>
#include <string_view>
#include "MFEMMGIS/Config.hxx"
#include "MFEMMGIS/Behaviour.hxx"
#include "MFEMMGIS/Parameters.hxx"
#include "MFEMMGIS/ExecutionSettings.hxx"
#include "MFEMMGIS/LinearSolverDescription.hxx"

namespace mfem_mgis::internals {

  //! \brief long name of the option giving the execution mode
  inline constexpr const char* execution_option = "--execution";
  //! \brief short name of the option `execution_option`
  inline constexpr const char* execution_short_option = "-x";
  //! \brief long name of the option placing the finite elements
  inline constexpr const char* finite_elements_option = "--finite-elements";
  //! \brief short name of the option `finite_elements_option`
  inline constexpr const char* finite_elements_short_option = "-fe";
  //! \brief long name of the option placing the behaviours
  inline constexpr const char* behaviours_option = "--behaviours";
  //! \brief short name of the option `behaviours_option`
  inline constexpr const char* behaviours_short_option = "-bh";
  //! \brief long name of the option placing the linear solvers
  inline constexpr const char* linear_solver_device_option =
      "--linear-solver-device";
  //! \brief short name of the option `linear_solver_device_option`
  inline constexpr const char* linear_solver_device_short_option = "-lsd";
  //! \brief long name of the option placing the post-processings
  inline constexpr const char* post_processings_option = "--post-processings";
  //! \brief short name of the option `post_processings_option`
  inline constexpr const char* post_processings_short_option = "-ppd";

  /*!
   * \brief reads the execution settings given by the options of the command
   * line (see `ExecutionSettings`), returned afterwards by
   * `getExecutionSettings`
   * \param[in] argc: number of arguments
   * \param[in] argv: arguments
   * \throws std::runtime_error on an invalid or contradictory option, or if
   * the `gpu` and `mixed` modes are requested while MFEM is built without
   * CUDA nor HIP
   */
  void readExecutionSettings(const int argc, const MainFunctionArguments argv);
  /*!
   * \return the value of an environment variable placing the computations
   * (`MFEM_MGIS_DEVICE`, `MFEM_MGIS_HYPRE_ON_HOST`,
   * `MFEM_MGIS_BEHAVIOUR_INTEGRATION`, `MFEM_MGIS_*_COMPUTATION`), or a
   * null pointer if it is not defined or if the execution mode is given
   * (the option `--execution` takes precedence over these variables, which
   * are then ignored, with a warning printed once by the main process)
   * \param[in] n: name of the variable
   */
  [[nodiscard]] const char* getPlacementEnvironmentVariable(
      const char* const n) noexcept;
  /*!
   * \return the default value of the `BehaviourIntegration` parameter of
   * the non linear evolution problems: `Batch` if the execution mode is
   * given (the behaviours generated by the generic-parallel interface, on
   * the host or on the GPU, can only be integrated by batches), unless
   * PETSc is used, `PointByPoint` otherwise
   */
  [[nodiscard]] std::string_view getDefaultBehaviourIntegration() noexcept;
  /*!
   * \return the default value of the parameters choosing the computations
   * of the finite elements (`GradientsComputation`,
   * `InnerForcesComputation`, `TangentOperatorComputation`): `Kernels` if
   * the finite elements are computed on the GPU, or on the host with
   * `--execution cpu` (see `areFiniteElementsKernelsOptional`),
   * `ElementByElement` otherwise, if PETSc is used or if the execution mode
   * is not given
   */
  [[nodiscard]] std::string_view getDefaultFiniteElementsComputation() noexcept;
  /*!
   * \return true if the computations of the finite elements by kernels
   * given by default by the execution settings are optional: with
   * `--execution cpu`, unless PETSc is used, the kernels compute on the
   * host, faster than the computations element by element, which replace
   * them if the behaviour integrators do not support them
   */
  [[nodiscard]] bool areFiniteElementsKernelsOptional() noexcept;
  //! \return true if the execution mode is given (option `--execution`)
  [[nodiscard]] bool isExecutionModeSpecified() noexcept;
  /*!
   * \return the default choice of the computation of the post-processings:
   * `Kernels` if they are computed on the GPU, `ElementByElement` otherwise
   * or if the execution mode is not given
   */
  [[nodiscard]] std::string_view
  getDefaultPostProcessingsComputation() noexcept;
  /*!
   * \brief checks that a behaviour is integrated where the execution
   * settings place the behaviours, or where the given location places it:
   * on the GPU, a library generated by the `generic-parallel` interface of
   * MFront for a GPU; on the CPU, a library computing on the host
   * \return true on success
   * \param[in, out] ctx: execution context
   * \param[in] b: behaviour
   * \param[in] l: location of the behaviour of this material, if given
   * (parameter `BehaviourExecutionLocation`), taking precedence over the
   * execution settings
   */
  [[nodiscard]] bool checkBehaviourExecutionLocation(
      Context& ctx,
      const Behaviour& b,
      const std::optional<ExecutionLocation> l = {}) noexcept;
  //! \brief name of the parameter placing the behaviour of a material
  inline constexpr const char* behaviour_execution_location_parameter =
      "BehaviourExecutionLocation";
  /*!
   * \return the location of the behaviour of a material given by the
   * parameter `BehaviourExecutionLocation` (`cpu` or `gpu`) of
   * `addBehaviourIntegrator`, if any, and the parameters without it, or an
   * empty value on error
   * \param[in, out] ctx: execution context
   * \param[in] p: parameters of the behaviour integrator
   */
  [[nodiscard]] std::optional<
      std::pair<std::optional<ExecutionLocation>, Parameters>>
  extractBehaviourExecutionLocation(Context& ctx, const Parameters& p) noexcept;
  /*!
   * \brief checks that a linear solver or a preconditioner computes where
   * the execution settings place the linear solvers
   * \return true on success
   * \param[in, out] ctx: execution context
   * \param[in] n: name of the linear solver or of the preconditioner
   * \param[in] p: where it computes (see `LinearSolverDescription`)
   */
  [[nodiscard]] bool checkLinearSolverExecutionLocation(
      Context& ctx, std::string_view n, LinearSolverPlacement p) noexcept;

}  // end of namespace mfem_mgis::internals

#endif /* LIB_MFEM_MGIS_SRC_EXECUTIONSETTINGS_HXX */
