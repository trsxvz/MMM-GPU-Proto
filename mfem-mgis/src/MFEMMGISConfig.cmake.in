@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if (NOT TARGET MFEM::mfem)
  # using our own FindMFEM.cmake file is a bit of a pain
  # as we can't use the HINTS option of find_package.
  # However definining explicitely MFEM_DIR seem to work as expected
  if(MFEM_DIR)
  elseif(DEFINED ENV{${MFEM_DIR}})
  else()
    set(MFEM_DIR "@MFEM_MGIS_MFEM_DIR@")
  endif(MFEM_DIR)
  find_package(MFEM REQUIRED)

  if (@MFEM_USE_MPI@)
    find_package(MPI REQUIRED)
    # The following include directories are automatically filled within FindMFEM.cmake
    include_directories(SYSTEM @HYPRE_INCLUDE_DIRS@)
    include_directories(SYSTEM @METIS_INCLUDE_DIRS@)
  endif(@MFEM_USE_MPI@)

  # Support for OpenMP
  if(@MFEM_USE_OPENMP@)
    find_package(OpenMP REQUIRED)
  elseif(@MFEM_USE_LEGACY_OPENMP@)
    find_package(OpenMP REQUIRED)
  endif(@MFEM_USE_OPENMP@)

endif(NOT TARGET MFEM::mfem)

# the library uses the runtime of CUDA when MFEM is compiled with CUDA: the
# toolkit used to build mfem-mgis is searched first
if(("@MFEM_USE_CUDA@" STREQUAL "YES") AND (NOT TARGET CUDA::cudart))
  if(NOT DEFINED CUDAToolkit_ROOT)
    set(CUDAToolkit_ROOT "@MFEM_MGIS_CUDA_TOOLKIT_ROOT@")
  endif()
  cmake_policy(PUSH)
  cmake_policy(SET CMP0074 NEW)
  find_package(CUDAToolkit)
  cmake_policy(POP)
  if(NOT TARGET CUDA::cudart)
    set(MFEMMGIS_FOUND FALSE)
    set(MFEMMGIS_NOT_FOUND_MESSAGE
        "the CUDA toolkit used to build mfem-mgis is not found")
    return()
  endif()
endif()

# the library uses the runtime of HIP when MFEM is compiled with HIP: the
# ROCm used to build mfem-mgis is searched first
if(("@MFEM_USE_HIP@" STREQUAL "YES") AND (NOT TARGET hip::host))
  if(NOT DEFINED hip_DIR)
    set(hip_DIR "@MFEM_MGIS_HIP_DIR@")
  endif()
  # AMD platform (the one of the libraries of ROCm used by MFEM), whatever
  # the environment variable HIP_PLATFORM, for this search only
  if(NOT DEFINED HIP_PLATFORM)
    set(HIP_PLATFORM amd)
    find_package(hip CONFIG)
    unset(HIP_PLATFORM)
  else()
    find_package(hip CONFIG)
  endif()
  if(NOT TARGET hip::host)
    set(MFEMMGIS_FOUND FALSE)
    set(MFEMMGIS_NOT_FOUND_MESSAGE
        "the ROCm used to build mfem-mgis is not found")
    return()
  endif()
endif()

# optional libraries of MFEM used by mfem-mgis (options enable-<name>)
set(MFEMMGIS_HAVE_PETSC @MFEM_MGIS_HAVE_PETSC@)
set(MFEMMGIS_HAVE_GINKGO @MFEM_MGIS_HAVE_GINKGO@)
set(MFEMMGIS_HAVE_MUMPS @MFEM_MGIS_HAVE_MUMPS@)
set(MFEMMGIS_HAVE_SUPERLU @MFEM_MGIS_HAVE_SUPERLU@)
set(MFEMMGIS_HAVE_STRUMPACK @MFEM_MGIS_HAVE_STRUMPACK@)
set(MFEMMGIS_HAVE_SUITESPARSE @MFEM_MGIS_HAVE_SUITESPARSE@)
set(MFEMMGIS_HAVE_SUNDIALS @MFEM_MGIS_HAVE_SUNDIALS@)
set(MFEMMGIS_HAVE_MKL_PARDISO @MFEM_MGIS_HAVE_MKL_PARDISO@)
set(MFEMMGIS_HAVE_MKL_CPARDISO @MFEM_MGIS_HAVE_MKL_CPARDISO@)
set(MFEMMGIS_HAVE_CUDSS @MFEM_MGIS_HAVE_CUDSS@)
set(MFEMMGIS_HAVE_MAGMA @MFEM_MGIS_HAVE_MAGMA@)
# sparse solvers of MAGMA, if mfem-mgis uses them (linked privately to the
# library of mfem-mgis)
set(MFEMMGIS_HAVE_MAGMA_SPARSE @MFEM_MGIS_HAVE_MAGMA_SPARSE@)

# AmgX, if mfem-mgis uses it (see `FindAMGX.cmake`), the installation used
# to build mfem-mgis being searched first
set(MFEMMGIS_HAVE_AMGX @MFEM_MGIS_HAVE_AMGX@)
if(MFEMMGIS_HAVE_AMGX AND (NOT TARGET AMGX::amgxsh))
  if(NOT AMGX_DIR)
    set(AMGX_DIR "@MFEM_MGIS_AMGX_DIR@")
  endif()
  find_package(AMGX)
  if(NOT TARGET AMGX::amgxsh)
    set(MFEMMGIS_FOUND FALSE)
    set(MFEMMGIS_NOT_FOUND_MESSAGE
        "the AmgX library used to build mfem-mgis is not found")
    return()
  endif()
endif()

# numerical type of mfem-mgis (double or float), the one of MFEM, of MGIS
# and of the behaviours (given to mfront by mfem_mgis_add_behaviours_library)
set(MFEMMGIS_REAL_TYPE @MFEM_MGIS_REAL_TYPE@)
set_property(GLOBAL PROPERTY MFEM_MGIS_REAL_TYPE @MFEM_MGIS_REAL_TYPE@)

# true if mfem-mgis initializes Kokkos on demand (option enable-kokkos):
# Kokkos is used through the shared library MFEMMGISKokkos, which finds it
set(MFEMMGIS_HAVE_KOKKOS @MFEM_MGIS_HAVE_KOKKOS@)

# true if mfem-mgis has the solvers of Trilinos (option enable-trilinos):
# Trilinos is used through the shared library MFEMMGISTrilinos, which finds
# it
set(MFEMMGIS_HAVE_TRILINOS @MFEM_MGIS_HAVE_TRILINOS@)
# true if mfem-mgis has the block preconditioners of Teko (option
# enable-teko)
set(MFEMMGIS_HAVE_TEKO @MFEM_MGIS_HAVE_TEKO@)

# Compilation of the sources containing kernels of MFEM: if MFEM was found
# before mfem-mgis without the module FindMFEM.cmake of mfem-mgis (target
# MFEM::mfem defined by the project), the description of MFEM is the one
# used to build mfem-mgis; otherwise, it is given by FindMFEM.cmake
include("${CMAKE_CURRENT_LIST_DIR}/MFEMMGISDeviceCode.cmake")
# Behaviour libraries for the CPU and the GPU (mfem_mgis_add_behaviours_library)
include("${CMAKE_CURRENT_LIST_DIR}/MFEMMGISBehaviours.cmake")
get_property(_mfem_mgis_mfem_described GLOBAL
             PROPERTY MFEM_MGIS_MFEM_USE_CUDA SET)
if(NOT _mfem_mgis_mfem_described)
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_USE_CUDA
               "@MFEM_MGIS_MFEM_USE_CUDA@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_USE_HIP
               "@MFEM_MGIS_MFEM_USE_HIP@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_CUDA_COMPILER
               "@MFEM_MGIS_MFEM_CUDA_COMPILER@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_CUDA_HOST_COMPILER
               "@MFEM_MGIS_MFEM_CUDA_HOST_COMPILER@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_CUDA_ARCHITECTURES
               "@MFEM_MGIS_MFEM_CUDA_ARCHITECTURES@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_HIP_COMPILER
               "@MFEM_MGIS_MFEM_HIP_COMPILER@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_HIP_ARCHITECTURES
               "@MFEM_MGIS_MFEM_HIP_ARCHITECTURES@")
endif()

# Require MGIS
if (NOT TARGET mgis::MFrontGenericInterface)
  set(_MGIS_MODULE_PATH "@MFrontGenericInterface_DIR@")
  if(MFrontGenericInterface_DIR)
    set(_MGIS_MODULE_PATH "${MFrontGenericInterface_DIR}")
   elseif(DEFINED ENV{${MFrontGenericInterface_DIR}})
     set(_MGIS_MODULE_PATH "$ENV{MFrontGenericInterface_DIR}")
  endif(MFrontGenericInterface_DIR)
  find_package(MFrontGenericInterface REQUIRED
               HINTS "${CMAKE_CURRENT_LIST_DIR}" "${_MGIS_MODULE_PATH}")
endif(NOT TARGET mgis::MFrontGenericInterface)

include("${CMAKE_CURRENT_LIST_DIR}/MFEMMGISTargets.cmake")