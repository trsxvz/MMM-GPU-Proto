@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if (NOT TARGET MFEM::mfem)
  # using our own FindMFEM.cmake file is a bit of a pain
  # as we can't use the HINTS option of find_package.
  # However definining explicitely MFEM_DIR seem to work as expected
  if(MFEM_DIR)
  elseif(DEFINED ENV{${MFEM_DIR}})
  else()
    set(MFEM_DIR "@MFEM_MGIS_MFEM_DIR@")
  endif(MFEM_DIR)
  find_package(MFEM REQUIRED)

  if (@MFEM_USE_MPI@)
    find_package(MPI REQUIRED)
    # The following include directories are automatically filled within FindMFEM.cmake
    include_directories(SYSTEM @HYPRE_INCLUDE_DIRS@)
    include_directories(SYSTEM @METIS_INCLUDE_DIRS@)
  endif(@MFEM_USE_MPI@)

  # Support for OpenMP
  if(@MFEM_USE_OPENMP@)
    find_package(OpenMP REQUIRED)
  elseif(@MFEM_USE_LEGACY_OPENMP@)
    find_package(OpenMP REQUIRED)
  endif(@MFEM_USE_OPENMP@)

endif(NOT TARGET MFEM::mfem)

# the library uses the runtime of CUDA when MFEM is compiled with CUDA: the
# toolkit used to build mfem-mgis is searched first
if(("@MFEM_USE_CUDA@" STREQUAL "YES") AND (NOT TARGET CUDA::cudart))
  if(NOT DEFINED CUDAToolkit_ROOT)
    set(CUDAToolkit_ROOT "@MFEM_MGIS_CUDA_TOOLKIT_ROOT@")
  endif()
  cmake_policy(PUSH)
  cmake_policy(SET CMP0074 NEW)
  find_package(CUDAToolkit)
  cmake_policy(POP)
  if(NOT TARGET CUDA::cudart)
    set(MFEMMGIS_FOUND FALSE)
    set(MFEMMGIS_NOT_FOUND_MESSAGE
        "the CUDA toolkit used to build mfem-mgis is not found")
    return()
  endif()
endif()

# Compilation of the sources containing kernels of MFEM: if MFEM was found
# before mfem-mgis, the description of MFEM is the one used to build
# mfem-mgis
include("${CMAKE_CURRENT_LIST_DIR}/MFEMMGISDeviceCode.cmake")
get_property(_mfem_mgis_mfem_described GLOBAL
             PROPERTY MFEM_MGIS_MFEM_USE_CUDA SET)
if(NOT _mfem_mgis_mfem_described)
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_USE_CUDA
               "@MFEM_MGIS_MFEM_USE_CUDA@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_USE_HIP
               "@MFEM_MGIS_MFEM_USE_HIP@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_CUDA_COMPILER
               "@MFEM_MGIS_MFEM_CUDA_COMPILER@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_CUDA_HOST_COMPILER
               "@MFEM_MGIS_MFEM_CUDA_HOST_COMPILER@")
  set_property(GLOBAL PROPERTY MFEM_MGIS_MFEM_CUDA_ARCHITECTURES
               "@MFEM_MGIS_MFEM_CUDA_ARCHITECTURES@")
endif()

# Require MGIS
if (NOT TARGET mgis::MFrontGenericInterface)
  set(_MGIS_MODULE_PATH "@MFrontGenericInterface_DIR@")
  if(MFrontGenericInterface_DIR)
    set(_MGIS_MODULE_PATH "${MFrontGenericInterface_DIR}")
   elseif(DEFINED ENV{${MFrontGenericInterface_DIR}})
     set(_MGIS_MODULE_PATH "$ENV{MFrontGenericInterface_DIR}")
  endif(MFrontGenericInterface_DIR)
  find_package(MFrontGenericInterface REQUIRED
               HINTS "${CMAKE_CURRENT_LIST_DIR}" "${_MGIS_MODULE_PATH}")
endif(NOT TARGET mgis::MFrontGenericInterface)

include("${CMAKE_CURRENT_LIST_DIR}/MFEMMGISTargets.cmake")