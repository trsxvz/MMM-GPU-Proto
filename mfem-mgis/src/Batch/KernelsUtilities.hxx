#ifndef LIB_MFEM_MGIS_SRC_BATCH_KERNELSUTILITIES_HXX
#define LIB_MFEM_MGIS_SRC_BATCH_KERNELSUTILITIES_HXX

#include <array>
#include <cstddef>
#include "mfem/general/forall.hpp"
#include "MFEMMGIS/Config.hxx"
#include "MFEMMGIS/Batch/Gradients.hxx"

namespace mfem_mgis::batch::internals {

  //! \brief 1/√2, as in the behaviour integrators generated by mfem-mgis
  MFEM_HOST_DEVICE constexpr real getInverseOfSquareRootOfTwo() {
    return real{0.70710678118654752440};
  }  // end of getInverseOfSquareRootOfTwo

  /*!
   * \return true for the gradients of the stationary heat transfer
   * behaviours (temperature gradient)
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr bool isTemperatureGradient() {
    return (K == GradientsKind::TEMPERATURE_GRADIENT_3D) ||
           (K == GradientsKind::TEMPERATURE_GRADIENT_2D);
  }  // end of isTemperatureGradient

  /*!
   * \return true for the gradients of the transient term of the heat
   * equation: the temperature at the integration point
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr bool isTemperature() {
    return (K == GradientsKind::TEMPERATURE_3D) ||
           (K == GradientsKind::TEMPERATURE_2D);
  }  // end of isTemperature

  //! \return true for the gradients of the micromorphic damage behaviours
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr bool isMicromorphicDamage() {
    return (K == GradientsKind::MICROMORPHIC_DAMAGE_3D) ||
           (K == GradientsKind::MICROMORPHIC_DAMAGE_2D);
  }  // end of isMicromorphicDamage

  /*!
   * \return true if the operator `B` of the given kind of gradients depends
   * on the values of the shape functions
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr bool usesShapeFunctionsValues() {
    return isTemperature<K>() || isMicromorphicDamage<K>();
  }  // end of usesShapeFunctionsValues

  //! \return the dimension of the space for the given kind of gradients
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr int getDimension() {
    return ((K == GradientsKind::SMALL_STRAIN_3D) ||
            (K == GradientsKind::DEFORMATION_GRADIENT_3D) ||
            (K == GradientsKind::TEMPERATURE_GRADIENT_3D) ||
            (K == GradientsKind::TEMPERATURE_3D) ||
            (K == GradientsKind::MICROMORPHIC_DAMAGE_3D))
               ? 3
               : 2;
  }  // end of getDimension

  /*!
   * \return the number of components of the unknowns for the given kind of
   * gradients: the dimension of the space (displacement) or one
   * (temperature, micromorphic damage)
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr int getUnknownsSize() {
    return (isTemperatureGradient<K>() || isTemperature<K>() ||
            isMicromorphicDamage<K>())
               ? 1
               : getDimension<K>();
  }  // end of getUnknownsSize

  //! \return the number of components of the gradients of the given kind
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr int getGradientsSize() {
    if constexpr (K == GradientsKind::SMALL_STRAIN_3D) {
      return 6;
    } else if constexpr (K == GradientsKind::SMALL_STRAIN_2D) {
      return 4;
    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
      return 9;
    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_2D) {
      return 5;
    } else if constexpr (isTemperatureGradient<K>()) {
      return getDimension<K>();
    } else if constexpr (isMicromorphicDamage<K>()) {
      return 1 + getDimension<K>();
    } else {
      static_assert(isTemperature<K>());
      return 1;
    }
  }  // end of getGradientsSize

  /*!
   * \return true if the tangent operator blocks contain, after the
   * derivatives of the thermodynamic forces with respect to the gradients,
   * their derivatives with respect to the unknowns (the derivative of the
   * heat flux with respect to the temperature), which multiply the values
   * of the shape functions
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr bool hasUnknownsBlock() {
    return isTemperatureGradient<K>();
  }  // end of hasUnknownsBlock

  /*!
   * \return the derivative of the `r1`-th component of the thermodynamic
   * forces with respect to the `r2`-th component of the gradients at a point
   * \tparam K: kind of the gradients
   * \param[in] t: tangent operator blocks of the point
   * \param[in] r1: component of the thermodynamic forces
   * \param[in] r2: component of the gradients
   * \param[in] cs: stride between two components of the blocks
   *
   * The tangent operator blocks are a `gs x gs` matrix stored by rows, `gs`
   * being the number of components of the gradients, except for the
   * micromorphic damage behaviours, whose tangent operator is block
   * diagonal: the derivative of the first dual force with respect to the
   * micromorphic damage, then the derivatives of the second dual force with
   * respect to the gradient of the micromorphic damage, stored by rows.
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE inline real getTangentOperatorComponent(const real* const t,
                                                           const std::size_t r1,
                                                           const std::size_t r2,
                                                           const long long cs) {
    if constexpr (isMicromorphicDamage<K>()) {
      constexpr auto N = static_cast<std::size_t>(getDimension<K>());
      if ((r1 == 0) || (r2 == 0)) {
        return ((r1 == 0) && (r2 == 0)) ? t[0] : real{0};
      }
      return t[static_cast<long long>(1 + (r1 - 1) * N + (r2 - 1)) * cs];
    } else {
      constexpr auto gs = static_cast<std::size_t>(getGradientsSize<K>());
      return t[static_cast<long long>(r1 * gs + r2) * cs];
    }
  }  // end of getTangentOperatorComponent

  /*!
   * \brief computes the inverse of a jacobian
   * \tparam N: dimension
   * \param[out] iJ: inverse, `iJ[i + N * j]` being the component `(i, j)`
   * \param[in] J: jacobian, `J[nq * (i + N * j)]` being the component
   * `(i, j)`
   * \param[in] nq: stride between two components (1 for a local array)
   * \param[in] detJ: determinant of the jacobian
   */
  template <int N>
  MFEM_HOST_DEVICE inline void invertJacobian(real* const iJ,
                                              const real* const J,
                                              const std::size_t nq,
                                              const real detJ) {
    auto j = [J, nq](const std::size_t r, const std::size_t c) {
      return J[nq * (r + N * c)];
    };
    if constexpr (N == 2) {
      iJ[0] = j(1, 1) / detJ;
      iJ[1] = -j(1, 0) / detJ;
      iJ[2] = -j(0, 1) / detJ;
      iJ[3] = j(0, 0) / detJ;
    } else {
      static_assert(N == 3);
      iJ[0] = (j(1, 1) * j(2, 2) - j(1, 2) * j(2, 1)) / detJ;
      iJ[1] = (j(1, 2) * j(2, 0) - j(1, 0) * j(2, 2)) / detJ;
      iJ[2] = (j(1, 0) * j(2, 1) - j(1, 1) * j(2, 0)) / detJ;
      iJ[3] = (j(0, 2) * j(2, 1) - j(0, 1) * j(2, 2)) / detJ;
      iJ[4] = (j(0, 0) * j(2, 2) - j(0, 2) * j(2, 0)) / detJ;
      iJ[5] = (j(0, 1) * j(2, 0) - j(0, 0) * j(2, 1)) / detJ;
      iJ[6] = (j(0, 1) * j(1, 2) - j(0, 2) * j(1, 1)) / detJ;
      iJ[7] = (j(0, 2) * j(1, 0) - j(0, 0) * j(1, 2)) / detJ;
      iJ[8] = (j(0, 0) * j(1, 1) - j(0, 1) * j(1, 0)) / detJ;
    }
  }  // end of invertJacobian

  /*!
   * \brief reads the inverse of the jacobian at a point, computed once by the
   * kernel of the geometric data (see `ElementsJacobians::invJ`)
   * \tparam N: dimension
   * \param[out] iJ: inverse, `iJ[i + N * j]` being the component `(i, j)`
   * (as computed by `invertJacobian`)
   * \param[in] invJ: inverse at the point of the element (`nq` points per
   * element): `invJ[nq * (i + N * j)]` is the component `(i, j)`
   * \param[in] nq: number of points per element
   */
  template <int N>
  MFEM_HOST_DEVICE inline void loadInverseJacobian(real* const iJ,
                                                   const real* const invJ,
                                                   const std::size_t nq) {
    for (std::size_t k = 0; k != N * N; ++k) {
      iJ[k] = invJ[nq * k];
    }
  }  // end of loadInverseJacobian

  /*!
   * \brief computes the derivatives of a shape function in the physical
   * frame: `dN/dx_c = sum_r dN/dxi_r (J^-1)_{rc}`
   * \tparam N: dimension
   * \param[out] dN: derivatives
   * \param[in] G: gradients of the shape functions on the reference element
   * (`nq x N x nd`, layout of `mfem::DofToQuad` in the `FULL` mode)
   * \param[in] q: integration point
   * \param[in] nq: number of integration points
   * \param[in] node: node
   * \param[in] iJ: inverse of the jacobian (see `loadInverseJacobian`)
   */
  template <int N>
  MFEM_HOST_DEVICE inline void computePhysicalDerivatives(
      real* const dN,
      const real* const G,
      const std::size_t q,
      const std::size_t nq,
      const std::size_t node,
      const real* const iJ) {
    for (std::size_t c = 0; c != N; ++c) {
      dN[c] = 0;
      for (std::size_t r = 0; r != N; ++r) {
        dN[c] += G[q + nq * (r + N * node)] * iJ[r + N * c];
      }
    }
  }  // end of computePhysicalDerivatives

  /*!
   * \brief computes the block of a node of the operator `B` giving the
   * gradients of a behaviour from the unknowns (as the behaviour integrators
   * generated by mfem-mgis): `B[k][c]` is the derivative of the `k`-th
   * component of the gradients with respect to the `c`-th component of the
   * unknowns at the node
   * \tparam K: kind of the gradients
   * \param[out] B: block of the operator (9 x 3 values at most). For the
   * stationary heat transfer behaviours, `B[c][0]` is the derivative of the
   * shape function with respect to the `c`-th coordinate. For the transient
   * term of the heat equation, `B[0][0]` is the value of the shape function.
   * For the micromorphic damage behaviours, `B[0][0]` is the value of the
   * shape function and `B[1 + c][0]` its derivative with respect to the
   * `c`-th coordinate.
   * \param[in] dN: derivatives of the shape function of the node in the
   * physical frame
   * \param[in] Nv: value of the shape function of the node (only used if
   * the gradients depend on the values of the unknowns)
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr void computeB(real (&B)[9][3],
                                           const real* const dN,
                                           const real Nv) {
    constexpr auto icste = getInverseOfSquareRootOfTwo();
    for (auto& row : B) {
      for (auto& v : row) {
        v = 0;
      }
    }
    if constexpr (K == GradientsKind::SMALL_STRAIN_3D) {
      B[0][0] = dN[0];
      B[1][1] = dN[1];
      B[2][2] = dN[2];
      B[3][0] = dN[1] * icste;
      B[3][1] = dN[0] * icste;
      B[4][0] = dN[2] * icste;
      B[4][2] = dN[0] * icste;
      B[5][1] = dN[2] * icste;
      B[5][2] = dN[1] * icste;
    } else if constexpr (K == GradientsKind::SMALL_STRAIN_2D) {
      B[0][0] = dN[0];
      B[1][1] = dN[1];
      B[3][0] = dN[1] * icste;
      B[3][1] = dN[0] * icste;
    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
      B[0][0] = dN[0];
      B[1][1] = dN[1];
      B[2][2] = dN[2];
      B[3][0] = dN[1];
      B[4][1] = dN[0];
      B[5][0] = dN[2];
      B[6][2] = dN[0];
      B[7][1] = dN[2];
      B[8][2] = dN[1];
    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_2D) {
      B[0][0] = dN[0];
      B[1][1] = dN[1];
      B[3][0] = dN[1];
      B[4][1] = dN[0];
    } else if constexpr (isTemperatureGradient<K>()) {
      for (int c = 0; c != getDimension<K>(); ++c) {
        B[c][0] = dN[c];
      }
    } else if constexpr (isMicromorphicDamage<K>()) {
      B[0][0] = Nv;
      for (int c = 0; c != getDimension<K>(); ++c) {
        B[1 + c][0] = dN[c];
      }
    } else {
      static_assert(isTemperature<K>());
      B[0][0] = Nv;
    }
  }  // end of computeB

  /*!
   * \brief non-zero entry of the block of a node of the operator `B` (see
   * `computeB`): `B[row][column] = factor * x[source]`, `x` being the
   * derivatives of the shape function of the node in the physical frame
   * followed by its value, which is zero for the kinds of gradients which
   * do not use it (see `getBOperatorEntries` and `usesShapeFunctionsValues`)
   */
  struct BOperatorEntry {
    //! \brief component of the gradients
    int row;
    //! \brief component of the unknowns
    int column;
    //! \brief index of the derivative of the shape function, or the
    //! dimension for its value
    int source;
    //! \brief factor
    real factor;
  };

  /*!
   * \return the non-zero entries of the block of a node of the operator `B`
   * (see `computeB`), sorted by rows, then by columns: the products by `B`
   * written with them skip its zero entries, and add the other terms in the
   * same order as loops on all the rows and all the columns. The results
   * are the same as with `B` for finite values, except, with contracted
   * multiplications and additions, the sign of zero results of underflowing
   * products. The values multiplied by zero entries of `B` (for example
   * components of the tangent operator) are not read: non-finite values
   * there are not propagated.
   * \tparam K: kind of the gradients
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE constexpr auto getBOperatorEntries() {
    constexpr auto N = getDimension<K>();
    constexpr auto icste = getInverseOfSquareRootOfTwo();
    if constexpr (K == GradientsKind::SMALL_STRAIN_3D) {
      return std::array<BOperatorEntry, 9>{{{0, 0, 0, 1},
                                            {1, 1, 1, 1},
                                            {2, 2, 2, 1},
                                            {3, 0, 1, icste},
                                            {3, 1, 0, icste},
                                            {4, 0, 2, icste},
                                            {4, 2, 0, icste},
                                            {5, 1, 2, icste},
                                            {5, 2, 1, icste}}};
    } else if constexpr (K == GradientsKind::SMALL_STRAIN_2D) {
      return std::array<BOperatorEntry, 4>{
          {{0, 0, 0, 1}, {1, 1, 1, 1}, {3, 0, 1, icste}, {3, 1, 0, icste}}};
    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
      return std::array<BOperatorEntry, 9>{{{0, 0, 0, 1},
                                            {1, 1, 1, 1},
                                            {2, 2, 2, 1},
                                            {3, 0, 1, 1},
                                            {4, 1, 0, 1},
                                            {5, 0, 2, 1},
                                            {6, 2, 0, 1},
                                            {7, 1, 2, 1},
                                            {8, 2, 1, 1}}};
    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_2D) {
      return std::array<BOperatorEntry, 4>{
          {{0, 0, 0, 1}, {1, 1, 1, 1}, {3, 0, 1, 1}, {4, 1, 0, 1}}};
    } else if constexpr (isTemperatureGradient<K>()) {
      auto entries = std::array<BOperatorEntry, N>{};
      for (int c = 0; c != N; ++c) {
        entries[c] = {c, 0, c, 1};
      }
      return entries;
    } else if constexpr (isMicromorphicDamage<K>()) {
      auto entries = std::array<BOperatorEntry, N + 1>{};
      entries[0] = {0, 0, N, 1};
      for (int c = 0; c != N; ++c) {
        entries[c + 1] = {c + 1, 0, c, 1};
      }
      return entries;
    } else {
      static_assert(isTemperature<K>());
      return std::array<BOperatorEntry, 1>{{{0, 0, N, 1}}};
    }
  }  // end of getBOperatorEntries

  /*!
   * \return true if the entries given by `getBOperatorEntries` are sorted by
   * rows, then by columns, and give the block of the operator `B` computed
   * by `computeB` (checked at compile time): both being linear in the
   * derivatives and the value of the shape function, they are compared for
   * each of them set to one, the others being zero, which compares each
   * factor exactly
   * \tparam K: kind of the gradients
   */
  template <GradientsKind K>
  constexpr bool checkBOperatorEntries() {
    constexpr auto N = getDimension<K>();
    auto previous_row = 0;
    auto previous_column = -1;
    for (const auto& e : getBOperatorEntries<K>()) {
      if ((e.row < previous_row) ||
          ((e.row == previous_row) && (e.column <= previous_column)) ||
          (e.row >= getGradientsSize<K>()) ||
          (e.column >= getUnknownsSize<K>()) || (e.source > N)) {
        return false;
      }
      previous_row = e.row;
      previous_column = e.column;
    }
    for (int j = 0; j != N + 1; ++j) {
      real x[4] = {};
      x[j] = 1;
      real B[9][3] = {};
      computeB<K>(B, x, x[N]);
      real Be[9][3] = {};
      for (const auto& e : getBOperatorEntries<K>()) {
        Be[e.row][e.column] = e.factor * x[e.source];
      }
      for (int r = 0; r != 9; ++r) {
        for (int c = 0; c != 3; ++c) {
          if ((B[r][c] < Be[r][c]) || (Be[r][c] < B[r][c])) {
            return false;
          }
        }
      }
    }
    return true;
  }  // end of checkBOperatorEntries

  static_assert(checkBOperatorEntries<GradientsKind::SMALL_STRAIN_3D>());
  static_assert(checkBOperatorEntries<GradientsKind::SMALL_STRAIN_2D>());
  static_assert(
      checkBOperatorEntries<GradientsKind::DEFORMATION_GRADIENT_3D>());
  static_assert(
      checkBOperatorEntries<GradientsKind::DEFORMATION_GRADIENT_2D>());
  static_assert(
      checkBOperatorEntries<GradientsKind::TEMPERATURE_GRADIENT_3D>());
  static_assert(
      checkBOperatorEntries<GradientsKind::TEMPERATURE_GRADIENT_2D>());
  static_assert(checkBOperatorEntries<GradientsKind::TEMPERATURE_3D>());
  static_assert(checkBOperatorEntries<GradientsKind::TEMPERATURE_2D>());
  static_assert(
      checkBOperatorEntries<GradientsKind::MICROMORPHIC_DAMAGE_3D>());
  static_assert(
      checkBOperatorEntries<GradientsKind::MICROMORPHIC_DAMAGE_2D>());

  /*!
   * \brief computes the deformation gradient at the center of an element,
   * in the order of the gradients of the behaviours (`F11, F22, F33, F12,
   * F21, F13, F31, F23, F32` in 3D, `F11, F22, F33, F12, F21` in 2D, the
   * third component being the macroscopic one in 2D)
   * \tparam K: kind of the gradients (deformation gradient in 3D or in 2D)
   * \param[out] F0: deformation gradient
   * \param[in] macroscopic_gradients: macroscopic gradients
   * \param[in] dr: derivatives of the unknowns with respect to the reference
   * coordinates at the center of the element (`dr[i + V * r]`, see
   * `UnknownsDerivatives`), null for null unknowns
   * \param[in] iJ: inverse of the jacobian at the center (see
   * `loadInverseJacobian`)
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE inline void computeDeformationGradientAtCenter(
      real* const F0,
      const real* const macroscopic_gradients,
      const real* const dr,
      const real* const iJ) {
    static_assert((K == GradientsKind::DEFORMATION_GRADIENT_3D) ||
                  (K == GradientsKind::DEFORMATION_GRADIENT_2D));
    constexpr auto N = getDimension<K>();
    constexpr auto V = getUnknownsSize<K>();
    for (int c = 0; c != getGradientsSize<K>(); ++c) {
      F0[c] = macroscopic_gradients[c];
    }
    if (dr == nullptr) {
      return;
    }
    real du[V * N];
    for (int i = 0; i != V; ++i) {
      for (int j = 0; j != N; ++j) {
        du[i + V * j] = 0;
        for (int r = 0; r != N; ++r) {
          du[i + V * j] += dr[i + V * r] * iJ[r + N * j];
        }
      }
    }
    auto d = [&du](const int i, const int j) { return du[i + V * j]; };
    if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
      F0[0] += d(0, 0);
      F0[1] += d(1, 1);
      F0[2] += d(2, 2);
      F0[3] += d(0, 1);
      F0[4] += d(1, 0);
      F0[5] += d(0, 2);
      F0[6] += d(2, 0);
      F0[7] += d(1, 2);
      F0[8] += d(2, 1);
    } else {
      F0[0] += d(0, 0);
      F0[1] += d(1, 1);
      F0[3] += d(0, 1);
      F0[4] += d(1, 0);
    }
  }  // end of computeDeformationGradientAtCenter

  /*!
   * \return the value of the shape function of a node at a point if the
   * operator `B` of the given kind of gradients depends on it (transient
   * term of the heat equation, micromorphic damage), zero otherwise
   * \tparam K: kind of the gradients
   * \param[in] N: values of the shape functions on the reference element
   * (`nq x nd`, layout of `mfem::DofToQuad` in the `FULL` mode)
   * \param[in] q: point
   * \param[in] nq: number of points
   * \param[in] node: node
   */
  template <GradientsKind K>
  MFEM_HOST_DEVICE inline real getShapeFunctionValue(const real* const N,
                                                     const std::size_t q,
                                                     const std::size_t nq,
                                                     const std::size_t node) {
    if constexpr (usesShapeFunctionsValues<K>()) {
      return N[q + nq * node];
    } else {
      return real{0};
    }
  }  // end of getShapeFunctionValue

  /*!
   * \return the position of a column in a row of a sparse matrix, or `end`
   * if the column is not in the row. The first column is tested first, then
   * the other columns are searched by bisection, which is exact for sorted
   * rows and for rows whose first column is the diagonal one, the others
   * being sorted (see `makeAssembledStiffnessMatrix`). Otherwise, the row is
   * searched linearly.
   * \param[in] J: columns of the matrix
   * \param[in] begin: position of the first column of the row
   * \param[in] end: position after the last column of the row
   * \param[in] c: column
   */
  MFEM_HOST_DEVICE inline int findColumn(const int* const J,
                                         const int begin,
                                         const int end,
                                         const int c) {
    if (begin == end) {
      return end;
    }
    if (J[begin] == c) {
      return begin;
    }
    auto lo = begin + 1;
    auto hi = end;
    while (lo != hi) {
      const auto mid = lo + (hi - lo) / 2;
      if (J[mid] < c) {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
    if ((lo != end) && (J[lo] == c)) {
      return lo;
    }
    for (auto p = begin + 1; p != end; ++p) {
      if (J[p] == c) {
        return p;
      }
    }
    return end;
  }  // end of findColumn

