+// The device code of this file did not contain the kernel of
+// thrust::sequence on the device vectors of integers, launched by the inline
+// functions of the matrices instantiated here (Matrix::colorMatrix): with
+// CUDA 13, the host code of these functions launched a null kernel, and the
+// copy of cub::DeviceFor::Bulk of this file, kept by the linker, failed with
+// "invalid device function" in the setup of the classical multigrid. Using
+// thrust::sequence in this function makes the device code of this file
+// contain the kernel.
+void instantiate_device_integer_sequence(Vector<TemplateConfig<AMGX_device, AMGX_vecInt, AMGX_matDouble, AMGX_indInt> > &v)
+{
+    thrust_wrapper::sequence<AMGX_device>(v.begin(), v.end());
+}
