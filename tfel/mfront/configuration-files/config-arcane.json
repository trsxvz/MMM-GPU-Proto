dsl_options: {
  disable_runtime_checks: false
},
interfaces_options: {
  generic-parallel: {
    backend: "arcane"
  }
},
compilation_options : {
  cxx : {
    compiler: "@TFEL_CLANGXX_COMPILER@",
    compilation_flags: "-O2 -std=c++@TFEL_CXX_STANDARD@"
  },
  cuda : {
    compiler: "@TFEL_CLANGXX_COMPILER@",
    compilation_flags: "-O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_ARCANE_CXX_FLAGS@"
  }
},
linking_options : {
  linker_flags: "@TFEL_ARCANE_LINKER_FLAGS@"
}
