dsl_options: {
  disable_runtime_checks: false
},
interfaces_options: {
  generic-parallel: {
    backend: {openmp: {
        offload: true
      }
    }
  }
},
compilation_options : {
  cxx : {
    compiler: "@TFEL_NVHPC_COMPILER@",
    compilation_flags: "-O1 -mp=gpu -gpu=mem:managed -std=c++@TFEL_CXX_STANDARD@ -march=native"
  }
},
linking_options : {
  linker_flags: "-mp=gpu -gpu=mem:managed"
}
