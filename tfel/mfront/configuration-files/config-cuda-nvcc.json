dsl_options: {
  disable_runtime_checks: false
},
interfaces_options: {
  generic-parallel: {
    backend: {cuda : {
        number_of_threads_per_block: 64
      }
    }
  }
},
compilation_options : {
  cuda : {
    compiler: "@TFEL_NVCC_COMPILER@",
    compilation_flags: "-O2 -std=c++@TFEL_CXX_STANDARD@ -arch=native -diag-suppress 20012,20208,2810,3189 -diag-error 20011,20014 -Xcompiler -fPIC --expt-relaxed-constexpr"
  }
}