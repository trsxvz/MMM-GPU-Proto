dsl_options: {
  disable_runtime_checks: false
},
interfaces_options: {
  generic-parallel: {
    backend: {raja: {
        execution_policy: "mfront::generic_parallel::raja::DefaultExecutionPolicy"
      }
    }
  }
},
compilation_options : {
  cxx : {
    compiler: "@TFEL_RAJA_CXX_COMPILER@",
    compilation_flags: "-O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_RAJA_CXX_FLAGS@"
  }
},
linking_options : {
  linker_flags: "@TFEL_RAJA_LINKER_FLAGS@"
}
