namespace mfront::gpb {

  //! \brief a simple alias
  using real = mfront::gb::real;
  //! \brief a simple alias
  using size_type = mfront_gb_size_type;

  /*!
   * \brief sizes of the data of an integration point, as seen by the
   * `generic` interface.
   *
   * The templates of this file take the description of the data of a point
   * through a type `PointTraits`, generated by `MFront`, whose static member
   * `value` gives the maximal sizes of the data of a point, whose static
   * members `material_properties_sizes` and `external_state_variables_sizes`
   * give the number of components of each material property and of each
   * external state variable, and whose member type `Integrator` gives the
   * integration strategy (see `StandardIntegrator`). CUDA compilers don't
   * support class types as non-type template parameters of kernels. For finite
   * strain behaviours, the sizes of the thermodynamic forces and of the tangent
   * operator depend on the stress measure and on the tangent operator requested
   * by the computation options.
   */
  struct PointDataSizes {
    size_type gradients = 0;
    size_type thermodynamic_forces = 0;
    size_type material_properties = 0;
    size_type internal_state_variables = 0;
    size_type external_state_variables = 0;
    size_type tangent_operator = 0;
  };

  //! \brief parameters of a behaviour without parameters
  struct NoParameters {};

  //! \brief result of the integration at one point
  struct PointResult {
    //! \brief status, as returned by the `generic` interface
    int status;
    //! \brief time step scaling factor
    real rdt;
  };

  //! \brief a simple alias
  using ComputationOptions = mfront::gb::ComputationOptions;

  //! \return the computation options of a batch
  TFEL_HOST_DEVICE constexpr ComputationOptions getComputationOptions(
      const BatchData& d) noexcept {
    return ComputationOptions{d.options[0], d.options[1], d.options[2]};
  }  // end of getComputationOptions

  /*!
   * \brief local copy of the values of a group of variables at one point
   * \tparam N: number of values
   */
  template <size_type N>
  struct LocalValues {
    TFEL_HOST_DEVICE constexpr real* data() noexcept { return this->values; }
    //! \brief values, the array has at least one element
    real values[N == 0 ? 1 : N];
  };

  namespace internals {

    //! \return the values of a field at the given point
    template <typename FieldType>
    TFEL_HOST_DEVICE constexpr auto pointer(const FieldType& f,
                                            const size_type i) noexcept {
      return f.values == nullptr ? f.values : f.values + i * f.point_stride;
    }  // end of pointer

    /*!
     * \brief copy the values of a field at the given point in an array
     * \param[out] dest: array
     * \param[in] f: field
     * \param[in] i: index of the point
     * \param[in] n: number of values
     */
    template <typename FieldType>
    TFEL_HOST_DEVICE constexpr void gatherValues(real* const dest,
                                                 const FieldType& f,
                                                 const size_type i,
                                                 const size_type n) noexcept {
      if (f.values == nullptr) {
        return;
      }
      const auto* const p = f.values + i * f.point_stride;
      for (size_type j = 0; j != n; ++j) {
        dest[j] = p[j * f.component_stride];
      }
    }  // end of gatherValues

    /*!
     * \brief copy the values of an array in a field at the given point
     * \param[out] f: field
     * \param[in] i: index of the point
     * \param[in] src: array
     * \param[in] n: number of values
     */
    TFEL_HOST_DEVICE constexpr void scatterValues(const Field& f,
                                                  const size_type i,
                                                  const real* const src,
                                                  const size_type n) noexcept {
      if (f.values == nullptr) {
        return;
      }
      auto* const p = f.values + i * f.point_stride;
      for (size_type j = 0; j != n; ++j) {
        p[j * f.component_stride] = src[j];
      }
    }  // end of scatterValues

    /*!
     * \brief copy the values of a field at the given point
     * \param[out] dest: local copy
     * \param[in] f: field
     * \param[in] i: index of the point
     * \param[in] n: number of values, lower than the capacity of `dest`
     */
    template <size_type N, typename FieldType>
    TFEL_HOST_DEVICE constexpr void gather(LocalValues<N>& dest,
                                           const FieldType& f,
                                           const size_type i,
                                           const size_type n) noexcept {
      if constexpr (N != 0) {
        gatherValues(dest.values, f, i, n);
      }
    }  // end of gather

    /*!
     * \brief copy the given values in a field at the given point
     * \param[in] f: field
     * \param[in] i: index of the point
     * \param[in] src: local values
     * \param[in] n: number of values, lower than the capacity of `src`
     */
    template <size_type N>
    TFEL_HOST_DEVICE constexpr void scatter(const Field& f,
                                            const size_type i,
                                            const LocalValues<N>& src,
                                            const size_type n) noexcept {
      if constexpr (N != 0) {
        scatterValues(f, i, src.values, n);
      }
    }  // end of scatter

    //! \brief copy a scalar value in a field at the given point
    TFEL_HOST_DEVICE constexpr void scatter(const Field& f,
                                            const size_type i,
                                            const real v) noexcept {
      if (f.values != nullptr) {
        f.values[i * f.point_stride] = v;
      }
    }  // end of scatter

    //! \return the value of a scalar field at the given point, or a default
    TFEL_HOST_DEVICE constexpr real value(const ConstField& f,
                                          const size_type i,
                                          const real v) noexcept {
      return f.values == nullptr ? v : f.values[i * f.point_stride];
    }  // end of value

  }  // end of namespace internals

  /*!
   * \brief fields of the variables of a group, one field per variable, and
   * number of components of each variable.
   *
   * The material properties and the external state variables of a batch may
   * be given as a group or variable by variable. Both forms are converted on
   * the host in this structure, which is passed by value to the kernels: the
   * code executed at each point is the same for both forms.
   *
   * \tparam N: number of variables
   */
  template <std::size_t N>
  struct VariableFields {
    //! \brief field of each variable
    ConstField fields[N == 0 ? 1 : N];
    //! \brief number of components of each variable
    size_type sizes[N == 0 ? 1 : N];
  };

  /*!
   * \brief fields of the material properties and of the external state
   * variables at the beginning and at the end of the time step
   * \tparam PointTraits: description of the data of an integration point
   */
  template <typename PointTraits>
  struct InputFields {
    //! \brief number of material properties
    static constexpr auto number_of_material_properties =
        PointTraits::material_properties_sizes.size();
    //! \brief number of external state variables
    static constexpr auto number_of_external_state_variables =
        PointTraits::external_state_variables_sizes.size();
    VariableFields<number_of_material_properties> mp0;
    VariableFields<number_of_material_properties> mp1;
    VariableFields<number_of_external_state_variables> esv0;
    VariableFields<number_of_external_state_variables> esv1;
  };

  namespace internals {

    /*!
     * \return the fields of the variables of a group
     * \param[in] group: values of the group
     * \param[in] by_variable: values of each variable, if not null
     * \param[in] sizes: number of components of each variable
     */
    template <std::size_t N>
    VariableFields<N> makeVariableFields(
        const ConstField& group,
        const ConstField* const by_variable,
        const std::array<size_type, N>& sizes) noexcept {
      auto r = VariableFields<N>{};
      auto offset = size_type{};
      for (std::size_t v = 0; v != N; ++v) {
        r.sizes[v] = sizes[v];
        if (by_variable != nullptr) {
          r.fields[v] = by_variable[v];
        } else if (group.values != nullptr) {
          r.fields[v] =
              ConstField{group.values + offset * group.component_stride,
                         group.point_stride, group.component_stride};
        }
        offset += sizes[v];
      }
      return r;
    }  // end of makeVariableFields

    /*!
     * \brief copy the values of the variables of a group at the given point
     * \param[out] dest: local copy
     * \param[in] f: fields of the variables
     * \param[in] i: index of the point
     */
    template <size_type M, std::size_t N>
    TFEL_HOST_DEVICE constexpr void gather(LocalValues<M>& dest,
                                           const VariableFields<N>& f,
                                           const size_type i) noexcept {
      if constexpr ((M != 0) && (N != 0)) {
        auto* p = dest.values;
        for (std::size_t v = 0; v != N; ++v) {
          const auto& fv = f.fields[v];
          const auto nc = f.sizes[v];
          if (fv.values != nullptr) {
            const auto* const src = fv.values + i * fv.point_stride;
            for (size_type c = 0; c != nc; ++c) {
              p[c] = src[c * fv.component_stride];
            }
          }
          p += nc;
        }
      }
    }  // end of gather

  }  // end of namespace internals

  /*!
   * \return the fields of the material properties and of the external
   * state variables of a batch
   * \tparam PointTraits: description of the data of an integration point
   * \param[in] d: batch data
   */
  template <typename PointTraits>
  InputFields<PointTraits> makeInputFields(const BatchData& d) noexcept {
    using internals::makeVariableFields;
    constexpr const auto& mps = PointTraits::material_properties_sizes;
    constexpr const auto& esvs = PointTraits::external_state_variables_sizes;
    return {
        .mp0 = makeVariableFields(d.s0.material_properties,
                                  d.s0.material_properties_by_variable, mps),
        .mp1 = makeVariableFields(d.s1.material_properties,
                                  d.s1.material_properties_by_variable, mps),
        .esv0 =
            makeVariableFields(d.s0.external_state_variables,
                               d.s0.external_state_variables_by_variable, esvs),
        .esv1 = makeVariableFields(d.s1.external_state_variables,
                                   d.s1.external_state_variables_by_variable,
                                   esvs)};
  }  // end of makeInputFields

  /*!
   * \brief integration strategy of the behaviours which are not finite
   * strain behaviours: the behaviour is directly integrated by
   * `mfront::gb::integrate`.
   *
   * An integration strategy provides:
   *
   * - the sizes of the data of a point for the given computation options;
   * - the integration of the behaviour at one point, whose behaviour data
   *   use the conventions of the `generic` interface.
   */
  struct StandardIntegrator {
    /*!
     * \return the sizes of the data of a point
     * \tparam PointTraits: description of the data of a point
     */
    template <typename PointTraits>
    TFEL_HOST_DEVICE static constexpr PointDataSizes getPointDataSizes(
        const ComputationOptions&) noexcept {
      return PointTraits::value;
    }  // end of getPointDataSizes
    /*!
     * \brief integrate the behaviour at one point
     * \tparam Behaviour: class implementing the behaviour
     * \tparam ParametersType: type of the structure holding the parameters
     * \param[in,out] d: behaviour data
     * \param[in] o: computation options
     * \param[in] p: out of bounds policy
     * \param[in] parameters: values of the parameters
     */
    template <typename Behaviour, typename ParametersType>
    TFEL_HOST_DEVICE static int integrate(
        mfront::gb::BehaviourData& d,
        const ComputationOptions& o,
        const tfel::material::OutOfBoundsPolicy p,
        const ParametersType& parameters) {
      return mfront::gb::integrate<Behaviour>(
          d, o, Behaviour::STANDARDTANGENTOPERATOR, p, parameters);
    }  // end of integrate
    /*!
     * \brief execute an initialize function at one point
     * \tparam Behaviour: class implementing the behaviour
     * \tparam InitializeFunction: function object calling the method
     * implementing the initialize function
     * \tparam ParametersType: type of the structure holding the parameters
     * \param[in,out] d: behaviour data
     * \param[in] values: values of the inputs of the initialize function
     * \param[in] p: out of bounds policy
     * \param[in] parameters: values of the parameters
     */
    template <typename Behaviour,
              typename InitializeFunction,
              typename ParametersType>
    TFEL_HOST_DEVICE static int executeInitializeFunction(
        mfront::gb::BehaviourData& d,
        const real* const values,
        const ComputationOptions&,
        const tfel::material::OutOfBoundsPolicy p,
        const ParametersType& parameters) {
      return mfront::gb::executeInitializeFunction<Behaviour>(
          InitializeFunction{}, d, values, p, parameters);
    }  // end of executeInitializeFunction
    /*!
     * \brief execute a post-processing at one point
     * \tparam Behaviour: class implementing the behaviour
     * \tparam PostProcessing: function object calling the method
     * implementing the post-processing
     * \tparam use_initial_state: boolean stating if the post-processing uses
     * the initial state of the material
     * \tparam ParametersType: type of the structure holding the parameters
     * \param[out] outputs: values of the outputs of the post-processing
     * \param[in,out] d: behaviour data
     * \param[in] p: out of bounds policy
     * \param[in] parameters: values of the parameters
     */
    template <typename Behaviour,
              typename PostProcessing,
              bool use_initial_state,
              typename ParametersType>
    TFEL_HOST_DEVICE static int executePostProcessing(
        real* const outputs,
        mfront::gb::BehaviourData& d,
        const ComputationOptions&,
        const tfel::material::OutOfBoundsPolicy p,
        const ParametersType& parameters) {
      return mfront::gb::executePostProcessing<Behaviour, use_initial_state>(
          PostProcessing{}, outputs, d, p, parameters);
    }  // end of executePostProcessing
  };

  namespace internals {

    /*!
     * \brief local copies of the values of a point
     * \tparam PointTraits: description of the data of an integration point
     */
    template <typename PointTraits>
    struct LocalCopies {
      //! \brief maximal sizes of the data of a point
      static constexpr auto capacities = PointDataSizes{PointTraits::value};
      LocalValues<capacities.material_properties> mp0;
      LocalValues<capacities.material_properties> mp1;
      LocalValues<capacities.external_state_variables> esvs0;
      LocalValues<capacities.external_state_variables> esvs1;
      LocalValues<capacities.tangent_operator> K;
      LocalValues<capacities.gradients> g0;
      LocalValues<capacities.gradients> g1;
      LocalValues<capacities.thermodynamic_forces> th0;
      LocalValues<capacities.thermodynamic_forces> th1;
      LocalValues<capacities.internal_state_variables> isvs0;
      LocalValues<capacities.internal_state_variables> isvs1;
    };

  }  // end of namespace internals

  /*!
   * \brief view of the data of the `i`-th point of a batch, as seen by the
   * `generic` interface.
   *
   * The values of the point are copied in local arrays, and the outputs must
   * be copied back by the `scatter` methods. Reading and writing the fields
   * directly when they are stored point by point gives no measurable gain
   * and doubles the number of kernels.
   *
   * The behaviour data point to the members of this object, which can't be
   * copied.
   *
   * The outputs of the behaviour are read through the pointers of the
   * behaviour data, i.e. through the same access path as the behaviour, and
   * all the inputs are copied by the constructor.
   *
   * \note with `nvcc` 13.0, copying the state at the end of the time step
   * after the construction of the view led to wrong results of the
   * initialize functions of finite strain behaviours (the optimizer of the
   * device code dropped the results of the function, which `clang` and
   * `nvcc -G` do not).
   *
   * \tparam PointTraits: description of the data of an integration point
   */
  template <typename PointTraits>
  struct PointView {
    /*!
     * \brief constructor
     * \param[in] d: batch data
     * \param[in] inputs: fields of the material properties and of the
     * external state variables
     * \param[in] i: index of the integration point
     * \param[in] s: sizes of the data of the point
     * \param[in] rdt0: initial value of the time step scaling factor
     * \param[in] gather_end_of_step_state: if true, the thermodynamic forces
     * and the internal state variables at the end of the time step are
     * copied, which is required by the functions reading this state or
     * updating only a part of it (post-processings, initialize functions)
     */
    TFEL_HOST_DEVICE PointView(
        const BatchData& d,
        const InputFields<PointTraits>& inputs,
        const size_type i,
        const PointDataSizes& s,
        const real rdt0,
        const bool gather_end_of_step_state = false) noexcept
        : batch(d),
          index(i),
          sizes(s),
          rdt(rdt0),
          energies0{{internals::value(d.s0.stored_energy, i, 0),
                     internals::value(d.s0.dissipated_energy, i, 0)}},
          energies1{{0, 0}} {
      using namespace internals;
      auto& bd = this->data;
      bd.error_message = nullptr;
      bd.dt = d.dt;
      bd.rdt = &(this->rdt);
      bd.speed_of_sound = &(this->speed_of_sound);
      bd.s0.mass_density = pointer(d.s0.mass_density, i);
      bd.s1.mass_density = pointer(d.s1.mass_density, i);
      bd.s0.stored_energy = this->energies0.data();
      bd.s0.dissipated_energy = this->energies0.data() + 1;
      // the energies are always computed if the behaviour computes them, and
      // only exported if requested
      bd.s1.stored_energy = this->energies1.data();
      bd.s1.dissipated_energy = this->energies1.data() + 1;
      auto& c = this->copies;
      gather(c.mp0, inputs.mp0, i);
      gather(c.mp1, inputs.mp1, i);
      gather(c.esvs0, inputs.esv0, i);
      gather(c.esvs1, inputs.esv1, i);
      gather(c.g0, d.s0.gradients, i, s.gradients);
      gather(c.g1, d.s1.gradients, i, s.gradients);
      gather(c.th0, d.s0.thermodynamic_forces, i, s.thermodynamic_forces);
      gather(c.isvs0, d.s0.internal_state_variables, i,
             s.internal_state_variables);
      if (gather_end_of_step_state) {
        gather(c.th1, d.s1.thermodynamic_forces, i, s.thermodynamic_forces);
        gather(c.isvs1, d.s1.internal_state_variables, i,
               s.internal_state_variables);
      }
      bd.s0.material_properties = c.mp0.data();
      bd.s1.material_properties = c.mp1.data();
      bd.s0.external_state_variables = c.esvs0.data();
      bd.s1.external_state_variables = c.esvs1.data();
      bd.K = c.K.data();
      bd.s0.gradients = c.g0.data();
      bd.s1.gradients = c.g1.data();
      bd.s0.thermodynamic_forces = c.th0.data();
      bd.s1.thermodynamic_forces = c.th1.data();
      bd.s0.internal_state_variables = c.isvs0.data();
      bd.s1.internal_state_variables = c.isvs1.data();
    }  // end of PointView
    //! \brief copy constructor (deleted)
    PointView(const PointView&) = delete;
    //! \brief move constructor (deleted)
    PointView(PointView&&) = delete;
    //! \brief copy assignement (deleted)
    PointView& operator=(const PointView&) = delete;
    //! \brief move assignement (deleted)
    PointView& operator=(PointView&&) = delete;
    /*!
     * \brief copy back the thermodynamic forces and the internal state
     * variables at the end of the time step
     */
    TFEL_HOST_DEVICE void scatterState() const noexcept {
      const auto& d = this->batch;
      const auto i = this->index;
      internals::scatterValues(d.s1.thermodynamic_forces, i,
                               this->data.s1.thermodynamic_forces,
                               this->sizes.thermodynamic_forces);
      internals::scatterValues(d.s1.internal_state_variables, i,
                               this->data.s1.internal_state_variables,
                               this->sizes.internal_state_variables);
    }  // end of scatterState
    //! \brief copy back the tangent operator
    TFEL_HOST_DEVICE void scatterTangentOperator() const noexcept {
      internals::scatterValues(this->batch.tangent_operators, this->index,
                               this->data.K, this->sizes.tangent_operator);
    }  // end of scatterTangentOperator
    //! \brief copy the energies at the end of the time step, if requested
    TFEL_HOST_DEVICE void scatterEnergies() const noexcept {
      const auto& d = this->batch;
      internals::scatter(d.s1.stored_energy, this->index,
                         *(this->data.s1.stored_energy));
      internals::scatter(d.s1.dissipated_energy, this->index,
                         *(this->data.s1.dissipated_energy));
    }  // end of scatterEnergies
    //! \brief copy the speed of sound, if requested
    TFEL_HOST_DEVICE void scatterSpeedOfSound() const noexcept {
      internals::scatter(this->batch.speed_of_sound, this->index,
                         *(this->data.speed_of_sound));
    }  // end of scatterSpeedOfSound
    //! \return the time step scaling factor
    TFEL_HOST_DEVICE real getTimeStepScalingFactor() const noexcept {
      return *(this->data.rdt);
    }  // end of getTimeStepScalingFactor
    //! \brief behaviour data, as seen by the `generic` interface
    mfront::gb::BehaviourData data;

   private:
    //! \brief batch data
    const BatchData& batch;
    //! \brief index of the point
    const size_type index;
    //! \brief sizes of the data of the point
    const PointDataSizes sizes;
    //! \brief time step scaling factor
    real rdt;
    //! \brief speed of sound
    real speed_of_sound = 0;
    //! \brief energies at the beginning of the time step
    LocalValues<2> energies0;
    /*!
     * \brief energies at the end of the time step
     *
     * \note this member is initialized by the constructor: `nvc++` 25.11
     * generates invalid device code for a default member initializer
     * value-initializing an array.
     */
    LocalValues<2> energies1;
    //! \brief local copies of the values of the point
    internals::LocalCopies<PointTraits> copies;
  };

  /*!
   * \brief record the status of a point, if requested
   * \param[in] d: batch data
   * \param[in] i: index of the integration point
   * \param[in] r: result
   */
  TFEL_HOST_DEVICE inline void recordStatus(const BatchData& d,
                                            const size_type i,
                                            const PointResult& r) noexcept {
    if (d.statuses != nullptr) {
      d.statuses[i] = r.status;
    }
  }  // end of recordStatus

  /*!
   * \brief record the status and the time step scaling factor of a point,
   * if requested. The time step scaling factor is only meaningful for the
   * integration: the initialize functions and the post-processings only
   * record the status, so that they can be called with the batch data of
   * the integration without overwriting the factors proposed by the
   * behaviour.
   * \param[in] d: batch data
   * \param[in] i: index of the integration point
   * \param[in] r: result
   */
  TFEL_HOST_DEVICE inline void record(const BatchData& d,
                                      const size_type i,
                                      const PointResult& r) noexcept {
    internals::scatter(d.rdts, i, r.rdt);
    recordStatus(d, i, r);
  }  // end of record

  /*!
   * \brief integrate the behaviour at the `i`-th point of a batch.
   *
   * \tparam Behaviour: class implementing the behaviour
   * \tparam PointTraits: description of the data of an integration point
   * \tparam ParametersType: type of the structure holding the parameters
   * \param[in] d: batch data
   * \param[in] inputs: fields of the material properties and of the
   * external state variables
   * \param[in] i: index of the integration point
   * \param[in] parameters: values of the parameters
   * \param[in] p: out of bounds policy
   */
  template <typename Behaviour, typename PointTraits, typename ParametersType>
  TFEL_HOST_DEVICE PointResult
  integrate(const BatchData& d,
            const InputFields<PointTraits>& inputs,
            const size_type i,
            const ParametersType& parameters,
            const tfel::material::OutOfBoundsPolicy p) {
    using Integrator = typename PointTraits::Integrator;
    const auto o = getComputationOptions(d);
    auto r = PointResult{.status = -1, .rdt = d.rdt};
    {
      auto v = PointView<PointTraits>(
          d, inputs, i, Integrator::template getPointDataSizes<PointTraits>(o),
          d.rdt);
      r.status =
          Integrator::template integrate<Behaviour>(v.data, o, p, parameters);
      r.rdt = v.getTimeStepScalingFactor();
      if (r.status != -1) {
        if (o.isPredictionRequested() || o.isTangentOperatorRequested()) {
          v.scatterTangentOperator();
        }
        if (!o.isPredictionRequested()) {
          v.scatterState();
          v.scatterEnergies();
        }
        if (o.speed_of_sound) {
          v.scatterSpeedOfSound();
        }
      }
    }
    record(d, i, r);
    return r;
  }  // end of integrate

  //! \brief index of the first failure when no point failed
  inline constexpr auto no_failure_index = ~size_type{};

  /*!
   * \brief statistics on the integration of a batch, combined by
   * parallel reductions
   */
  struct BatchStatistics {
    /*!
     * \return the statistics associated with the result at one point
     * \param[in] i: index of the point
     * \param[in] r: result at this point
     */
    TFEL_HOST_DEVICE static constexpr BatchStatistics from(
        const size_type i, const PointResult& r) noexcept {
      return {.number_of_failures = r.status == -1 ? 1u : 0u,
              .first_failure_index = r.status == -1 ? i : no_failure_index,
              .number_of_unreliable_results = r.status == 0 ? 1u : 0u,
              .rdt = r.rdt};
    }
    //! \brief combine two statistics
    TFEL_HOST_DEVICE friend constexpr BatchStatistics combine(
        const BatchStatistics& a, const BatchStatistics& b) noexcept {
      return {
          .number_of_failures = a.number_of_failures + b.number_of_failures,
          .first_failure_index = a.first_failure_index < b.first_failure_index
                                     ? a.first_failure_index
                                     : b.first_failure_index,
          .number_of_unreliable_results =
              a.number_of_unreliable_results + b.number_of_unreliable_results,
          .rdt = a.rdt < b.rdt ? a.rdt : b.rdt};
    }
    size_type number_of_failures = 0;
    size_type first_failure_index = no_failure_index;
    size_type number_of_unreliable_results = 0;
    real rdt = 1;
  };

  /*!
   * \return an unsigned integer whose ordering is the same as the ordering
   * of the given floating point values. This allows to compute the minimum
   * of floating point values with an integer atomic operation. This is the
   * encoding of the time step scaling factor in `mfront_gpb_BatchStatistics`
   * (see `mfront_gpb_initializeBatchStatistics`), available in device code.
   */
  TFEL_HOST_DEVICE constexpr unsigned long long toOrderedKey(
      const double v) noexcept {
    const auto b = std::bit_cast<unsigned long long>(v);
    constexpr auto sign = 0x8000000000000000ull;
    return (b & sign) ? ~b : (b | sign);
  }  // end of toOrderedKey

  //! \return the statistics updated by atomic operations
  inline BatchStatistics getBatchStatistics(
      const AtomicBatchStatistics& s) noexcept {
    return {
        .number_of_failures = static_cast<size_type>(s.number_of_failures),
        .first_failure_index = static_cast<size_type>(s.first_failure_index),
        .number_of_unreliable_results =
            static_cast<size_type>(s.number_of_unreliable_results),
        .rdt = mfront_gpb_getTimeStepScalingFactor(&s)};
  }  // end of getBatchStatistics

  /*!
   * \brief accumulate the statistics of a batch
   * \param[in,out] s: accumulated statistics
   * \param[in] r: statistics of a batch
   */
  constexpr void accumulate(AtomicBatchStatistics& s,
                            const BatchStatistics& r) noexcept {
    const auto rdt = toOrderedKey(r.rdt);
    const auto first_failure_index =
        static_cast<unsigned long long>(r.first_failure_index);
    s.number_of_failures += r.number_of_failures;
    s.first_failure_index = first_failure_index < s.first_failure_index
                                ? first_failure_index
                                : s.first_failure_index;
    s.number_of_unreliable_results += r.number_of_unreliable_results;
    s.rdt = rdt < s.rdt ? rdt : s.rdt;
  }  // end of accumulate

  //! \brief function object combining two statistics
  struct CombineStatistics {
    TFEL_HOST_DEVICE constexpr BatchStatistics operator()(
        const BatchStatistics& a, const BatchStatistics& b) const noexcept {
      return combine(a, b);
    }
  };

  /*!
   * \brief set the status and the error message of an output status
   * \param[out] s: output status
   * \param[in] status: status
   * \param[in] msg: error message
   * \return the status
   */
  inline int report(OutputStatus& s,
                    const int status,
                    const std::string_view msg) noexcept {
    constexpr auto msize = sizeof(s.msg) - 1;
    const auto n = msg.size() < msize ? msg.size() : msize;
    s.status = status;
    std::memcpy(s.msg, msg.data(), n);
    s.msg[n] = '\0';
    return status;
  }  // end of report

  /*!
   * \brief fill an output status from the statistics of a batch
   * \return the status
   */
  inline int report(OutputStatus& s, const BatchStatistics& r) noexcept {
    s.number_of_failures = r.number_of_failures;
    s.first_failure_index = r.first_failure_index;
    s.number_of_unreliable_results = r.number_of_unreliable_results;
    s.rdt = r.rdt;
    if (r.number_of_failures != 0) {
      s.status = -1;
      std::snprintf(s.msg, sizeof(s.msg),
                    "computations failed at %zu integration points, the "
                    "first one being the point %zu",
                    static_cast<std::size_t>(r.number_of_failures),
                    static_cast<std::size_t>(r.first_failure_index));
      return s.status;
    }
    s.status = r.number_of_unreliable_results != 0 ? 0 : 1;
    return s.status;
  }  // end of report

  /*!
   * \brief report the statistics of a batch computed by a backend which
   * waits for the completion of the computations: the statistics are
   * reported in the output status or, if the execution options give
   * statistics, accumulated in those statistics (see
   * `mfront_gpb_ExecutionOptions`).
   * \return the status
   * \param[in,out] s: output status
   * \param[in] o: execution options
   * \param[in] r: statistics of the batch
   */
  inline int report(OutputStatus& s,
                    const ExecutionOptions& o,
                    const BatchStatistics& r) noexcept {
    if (o.statistics == nullptr) {
      return report(s, r);
    }
    accumulate(*(o.statistics), r);
    return s.status;
  }  // end of report

  /*!
   * \brief initialize an output status: success, no failure
   * \param[out] s: output status
   * \param[in] rdt: time step scaling factor
   */
  inline void initialize(OutputStatus& s, const real rdt) noexcept {
    s.status = 1;
    s.number_of_failures = 0;
    s.first_failure_index = no_failure_index;
    s.number_of_unreliable_results = 0;
    s.rdt = rdt;
    s.msg[0] = '\0';
  }  // end of initialize

  /*!
   * \brief check the consistency of the batch data. The output status is
   * initialized.
   * \tparam PointTraits: description of the data of an integration point
   * \param[out] s: output status
   * \param[in] d: batch data
   * \return true if the batch data are valid
   */
  template <typename PointTraits>
  bool check(OutputStatus& s, const BatchData& d) noexcept {
    constexpr auto sizes = PointDataSizes{PointTraits::value};
    initialize(s, d.rdt);
    const auto n = d.number_of_points;
    if (n == 0) {
      // nothing is read or written: the fields of an empty batch may be
      // null (for example, the data of an empty `std::vector`)
      return true;
    }
    auto check_input = [&s](const ConstField& f, const size_type size,
                            const std::string_view name) {
      if ((size != 0) && (f.values == nullptr)) {
        report(s, -2, name);
        return false;
      }
      return true;
    };
    // material properties and external state variables, given as a group
    // or variable by variable
    auto check_inputs = [&s, &check_input](const ConstField& f,
                                           const ConstField* const by_variable,
                                           const auto& variables_sizes,
                                           const size_type size,
                                           const std::string_view name) {
      if (by_variable == nullptr) {
        return check_input(f, size, name);
      }
      for (std::size_t v = 0; v != variables_sizes.size(); ++v) {
        if ((variables_sizes[v] != 0) && (by_variable[v].values == nullptr)) {
          report(s, -2, name);
          return false;
        }
      }
      return true;
    };
    constexpr const auto& mps = PointTraits::material_properties_sizes;
    constexpr const auto& esvs = PointTraits::external_state_variables_sizes;
    auto check_output = [&s, n](const auto& f, const size_type size,
                                const bool required,
                                const std::string_view name) {
      if (size == 0) {
        return true;
      }
      if ((required) && (f.values == nullptr)) {
        report(s, -2, name);
        return false;
      }
      if ((f.values != nullptr) && (f.point_stride == 0) && (n > 1)) {
        report(s, -2, name);
        return false;
      }
      return true;
    };
    const auto o = getComputationOptions(d);
    const auto tangent_operator_required =
        o.isPredictionRequested() || o.isTangentOperatorRequested();
    return check_input(d.s0.gradients, sizes.gradients,
                       "missing gradients at the beginning of the time "
                       "step") &&
           check_input(d.s1.gradients, sizes.gradients,
                       "missing gradients at the end of the time step") &&
           check_input(d.s0.thermodynamic_forces, sizes.thermodynamic_forces,
                       "missing thermodynamic forces at the beginning of the "
                       "time step") &&
           check_inputs(d.s0.material_properties,
                        d.s0.material_properties_by_variable, mps,
                        sizes.material_properties,
                        "missing material properties at the beginning of the "
                        "time step") &&
           check_inputs(d.s1.material_properties,
                        d.s1.material_properties_by_variable, mps,
                        sizes.material_properties,
                        "missing material properties at the end of the time "
                        "step") &&
           check_input(d.s0.internal_state_variables,
                       sizes.internal_state_variables,
                       "missing internal state variables at the beginning "
                       "of the time step") &&
           check_inputs(d.s0.external_state_variables,
                        d.s0.external_state_variables_by_variable, esvs,
                        sizes.external_state_variables,
                        "missing external state variables at the beginning "
                        "of the time step") &&
           check_inputs(d.s1.external_state_variables,
                        d.s1.external_state_variables_by_variable, esvs,
                        sizes.external_state_variables,
                        "missing external state variables at the end of the "
                        "time step") &&
           check_input(d.s0.mass_density, o.speed_of_sound ? 1 : 0,
                       "missing mass density at the beginning of the time "
                       "step") &&
           check_input(d.s1.mass_density, o.speed_of_sound ? 1 : 0,
                       "missing mass density at the end of the time step") &&
           check_output(d.s1.thermodynamic_forces, sizes.thermodynamic_forces,
                        true, "invalid thermodynamic forces") &&
           check_output(d.s1.internal_state_variables,
                        sizes.internal_state_variables, true,
                        "invalid internal state variables") &&
           check_output(d.tangent_operators, sizes.tangent_operator,
                        tangent_operator_required,
                        "invalid tangent operators") &&
           check_output(d.s1.stored_energy, 1, false,
                        "invalid stored energies") &&
           check_output(d.s1.dissipated_energy, 1, false,
                        "invalid dissipated energies") &&
           check_output(d.rdts, 1, false,
                        "invalid time step scaling factors") &&
           check_output(d.speed_of_sound, 1, o.speed_of_sound,
                        "invalid speeds of sound");
  }  // end of check

  /*!
   * \brief check the computation options of the integration of a batch,
   * for the behaviours whose integrator validates them (finite strain
   * behaviours). Invalid options are an error of the calling code, reported
   * for the whole batch, and not an integration failure at every point.
   * \tparam PointTraits: description of the data of an integration point
   * \param[out] s: output status
   * \param[in] d: batch data
   * \return true if the computation options are valid
   */
  template <typename PointTraits>
  bool checkComputationOptions(OutputStatus& s, const BatchData& d) noexcept {
    using Integrator = typename PointTraits::Integrator;
    if constexpr (requires(const ComputationOptions& o) {
                    Integrator::checkComputationOptions(o);
                  }) {
      if (!Integrator::checkComputationOptions(getComputationOptions(d))) {
        report(s, -2, "invalid computation options");
        return false;
      }
    }
    return true;
  }  // end of checkComputationOptions

  /*!
   * \return the field pointed by the given pointer, or an empty field if
   * this pointer is null
   * \param[in] f: pointer to the field
   */
  template <typename FieldType>
  constexpr FieldType getField(const FieldType* const f) noexcept {
    return f == nullptr ? FieldType{} : *f;
  }  // end of getField

  /*!
   * \brief check that a field holding the inputs or the outputs of an
   * initialize function or a post-processing is valid
   * \return true if the field is valid
   * \param[out] s: output status
   * \param[in] f: field
   * \param[in] n: number of values of the field at one point
   * \param[in] name: description of the field
   */
  template <typename FieldType>
  bool checkValues(OutputStatus& s,
                   const FieldType& f,
                   const size_type n,
                   const std::string_view name) noexcept {
    if ((n != 0) && (f.values == nullptr)) {
      report(s, -2, name);
      return false;
    }
    return true;
  }  // end of checkValues

  /*!
   * \brief data shared by the function objects applied at the points of a
   * batch (see `PointIntegrator`, `InitializeFunctionExecutor`,
   * `PostProcessingExecutor`).
   *
   * \tparam PointTraits: description of the data of an integration point
   * \tparam ParametersType: type of the structure holding the parameters
   */
  template <typename PointTraits, typename ParametersType>
  struct PointFunctionData {
    //! \brief batch data
    BatchData data;
    //! \brief fields of the material properties and of the external state
    //! variables
    InputFields<PointTraits> input_fields;
    //! \brief values of the parameters
    ParametersType parameters;
    //! \brief out of bounds policy
    tfel::material::OutOfBoundsPolicy policy;
  };

  /*!
   * \brief function object integrating the behaviour at one point of a batch
   * and returning the associated statistics.
   *
   * \tparam Behaviour: class implementing the behaviour
   * \tparam PointTraits: description of the data of an integration point
   * \tparam ParametersType: type of the structure holding the parameters
   */
  template <typename Behaviour, typename PointTraits, typename ParametersType>
  struct PointIntegrator : PointFunctionData<PointTraits, ParametersType> {
    //! \return the statistics of the integration at the `i`-th point
    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
      return BatchStatistics::from(i, integrate<Behaviour, PointTraits>(
                                          this->data, this->input_fields, i,
                                          this->parameters, this->policy));
    }
  };

  /*!
   * \return the data shared by the function objects applied at the points of
   * a batch
   * \param[in] d: batch data
   * \param[in] parameters: values of the parameters
   * \param[in] p: out of bounds policy
   */
  template <typename PointTraits, typename ParametersType>
  PointFunctionData<PointTraits, ParametersType> makePointFunctionData(
      const BatchData& d,
      const ParametersType& parameters,
      const tfel::material::OutOfBoundsPolicy p) {
    return {d, makeInputFields<PointTraits>(d), parameters, p};
  }  // end of makePointFunctionData

  /*!
   * \brief function object executing an initialize function at one point of
   * a batch and returning the associated statistics. The internal state
   * variables (and the thermodynamic forces) at the end of the time step
   * are the outputs.
   *
   * \tparam Behaviour: class implementing the behaviour
   * \tparam PointTraits: description of the data of an integration point
   * \tparam InitializeFunction: function object calling the method
   * implementing the initialize function
   * \tparam number_of_inputs: number of values of the inputs of the
   * initialize function
   * \tparam ParametersType: type of the structure holding the parameters
   */
  template <typename Behaviour,
            typename PointTraits,
            typename InitializeFunction,
            size_type number_of_inputs,
            typename ParametersType>
  struct InitializeFunctionExecutor
      : PointFunctionData<PointTraits, ParametersType> {
    //! \return the statistics of the execution at the `i`-th point
    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
      using Integrator = typename PointTraits::Integrator;
      const auto& d = this->data;
      const auto o = getComputationOptions(d);
      auto r = PointResult{.status = -1, .rdt = d.rdt};
      {
        // the initialize function may only update a part of the state
        auto v = PointView<PointTraits>(
            d, this->input_fields, i,
            Integrator::template getPointDataSizes<PointTraits>(o), d.rdt,
            true);
        auto values = LocalValues<number_of_inputs>{};
        internals::gather(values, this->inputs, i, number_of_inputs);
        const auto status =
            Integrator::template executeInitializeFunction<Behaviour,
                                                           InitializeFunction>(
                v.data, values.data(), o, this->policy, this->parameters);
        if (status != -1) {
          v.scatterState();
          r.status = 1;
        }
      }
      recordStatus(d, i, r);
      return BatchStatistics::from(i, r);
    }
    //! \brief values of the inputs of the initialize function
    ConstField inputs;
  };

  /*!
   * \brief function object executing a post-processing at one point of a
   * batch and returning the associated statistics.
   *
   * \tparam Behaviour: class implementing the behaviour
   * \tparam PointTraits: description of the data of an integration point
   * \tparam PostProcessing: function object calling the method
   * implementing the post-processing
   * \tparam use_initial_state: boolean stating if the post-processing uses
   * the initial state of the material
   * \tparam number_of_outputs: number of values of the outputs of the
   * post-processing
   * \tparam ParametersType: type of the structure holding the parameters
   */
  template <typename Behaviour,
            typename PointTraits,
            typename PostProcessing,
            bool use_initial_state,
            size_type number_of_outputs,
            typename ParametersType>
  struct PostProcessingExecutor
      : PointFunctionData<PointTraits, ParametersType> {
    //! \return the statistics of the execution at the `i`-th point
    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
      using Integrator = typename PointTraits::Integrator;
      const auto& d = this->data;
      const auto o = getComputationOptions(d);
      auto r = PointResult{.status = -1, .rdt = d.rdt};
      {
        // the post-processing uses the state at the end of the time step
        auto v = PointView<PointTraits>(
            d, this->input_fields, i,
            Integrator::template getPointDataSizes<PointTraits>(o), d.rdt,
            true);
        auto values = LocalValues<number_of_outputs>{};
        // the outputs are written and read through the same pointer
        auto* const outputs = values.data();
        const auto status = Integrator::template executePostProcessing<
            Behaviour, PostProcessing, use_initial_state>(
            outputs, v.data, o, this->policy, this->parameters);
        if (status != -1) {
          internals::scatterValues(this->outputs, i, outputs,
                                   number_of_outputs);
          r.status = 1;
        }
      }
      recordStatus(d, i, r);
      return BatchStatistics::from(i, r);
    }
    //! \brief values of the outputs of the post-processing
    Field outputs;
  };

  /*!
   * \brief function object rotating the values of the `i`-th point of a
   * batch and returning the associated statistics.
   *
   * \tparam PointRotation: function object rotating the values of a point,
   * called as `f(dest, src, rv)` with the arguments of the rotation functions
   * of the `generic` interface, and whose static member `size` is the number
   * of values of a point.
   */
  template <typename PointRotation>
  struct RotationExecutor {
    //! \return the statistics of the rotation at the `i`-th point
    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
      constexpr auto n = static_cast<size_type>(PointRotation::size);
      auto src = LocalValues<n>{};
      auto dest = LocalValues<n>{};
      auto rv = LocalValues<9>{};
      internals::gather(src, this->data.source, i, n);
      internals::gather(rv, this->data.rotation_matrices, i, 9);
      PointRotation{}(dest.data(), src.data(), rv.data());
      internals::scatter(this->data.destination, i, dest, n);
      return BatchStatistics::from(i, PointResult{.status = 1, .rdt = 1});
    }
    //! \brief rotation data
    RotationData data;
  };

  /*!
   * \brief initialize the output status and check the data of a rotation
   * \return true if the data are valid
   * \param[out] s: output status
   * \param[in] d: rotation data
   */
  inline bool checkRotationData(OutputStatus& s,
                                const RotationData& d) noexcept {
    initialize(s, 1);
    if ((d.number_of_points != 0) &&
        ((d.destination.values == nullptr) || (d.source.values == nullptr) ||
         (d.rotation_matrices.values == nullptr))) {
      report(s, -2, "invalid rotation data");
      return false;
    }
    return true;
  }  // end of checkRotationData

  /*!
   * \brief integrate the behaviour at the points of a batch with the
   * primitive of a backend.
   *
   * The functions of this kind (`executeInitializeFunctionOnBatch`,
   * `executePostProcessingOnBatch`, `rotateBatch`) check the data, choose
   * the function object applied at each point and call the primitive of the
   * backend, which is the only part specific to a backend.
   *
   * \tparam Behaviour: class implementing the behaviour
   * \tparam PointTraits: description of the data of an integration point
   * \tparam ParametersType: type of the structure holding the parameters
   * \tparam Apply: callable object such that `apply(n, o, rdt0, f)` applies
   * the function object `f` at the `n` points of a batch with the execution
   * options `o`, the initial value of the time step scaling factor being
   * `rdt0`, and returns the status, reported in the output status
   * \param[out] s: output status
   * \param[in] d: batch data
   * \param[in] parameters: values of the parameters
   * \param[in] p: out of bounds policy
   * \param[in] apply: primitive of the backend
   * \return the status
   */
  template <typename Behaviour,
            typename PointTraits,
            typename ParametersType,
            typename Apply>
  int integrateBatch(OutputStatus& s,
                     const BatchData& d,
                     const ParametersType& parameters,
                     const tfel::material::OutOfBoundsPolicy p,
                     const Apply& apply) {
    if ((!check<PointTraits>(s, d)) ||
        (!checkComputationOptions<PointTraits>(s, d))) {
      return s.status;
    }
    using Integrator = PointIntegrator<Behaviour, PointTraits, ParametersType>;
    const auto data = makePointFunctionData<PointTraits>(d, parameters, p);
    return apply(d.number_of_points, d.execution, d.rdt, Integrator{data});
  }  // end of integrateBatch

  /*!
   * \brief execute an initialize function at the points of a batch with the
   * primitive of a backend (see `integrateBatch`).
   *
   * \tparam Behaviour: class implementing the behaviour
   * \tparam PointTraits: description of the data of an integration point
   * \tparam InitializeFunction: function object calling the method
   * implementing the initialize function
   * \tparam number_of_inputs: number of values of the inputs
   * \param[out] s: output status
   * \param[in] d: batch data
   * \param[in] inputs: values of the inputs of the initialize function
   * \param[in] parameters: values of the parameters
   * \param[in] p: out of bounds policy
   * \param[in] apply: primitive of the backend
   * \return the status
   */
  template <typename Behaviour,
            typename PointTraits,
            typename InitializeFunction,
            size_type number_of_inputs,
            typename ParametersType,
            typename Apply>
  int executeInitializeFunctionOnBatch(
      OutputStatus& s,
      const BatchData& d,
      const ConstField& inputs,
      const ParametersType& parameters,
      const tfel::material::OutOfBoundsPolicy p,
      const Apply& apply) {
    const auto nv = d.number_of_points == 0 ? 0 : number_of_inputs;
    if ((!check<PointTraits>(s, d)) ||
        (!checkValues(s, inputs, nv, "invalid inputs"))) {
      return s.status;
    }
    using Executor =
        InitializeFunctionExecutor<Behaviour, PointTraits, InitializeFunction,
                                   number_of_inputs, ParametersType>;
    const auto data = makePointFunctionData<PointTraits>(d, parameters, p);
    return apply(d.number_of_points, d.execution, d.rdt,
                 Executor{data, inputs});
  }  // end of executeInitializeFunctionOnBatch

  /*!
   * \brief execute a post-processing at the points of a batch with the
   * primitive of a backend (see `integrateBatch`).
   *
   * \tparam Behaviour: class implementing the behaviour
   * \tparam PointTraits: description of the data of an integration point
   * \tparam PostProcessing: function object calling the method
   * implementing the post-processing
   * \tparam use_initial_state: boolean stating if the post-processing uses
   * the initial state of the material
   * \tparam number_of_outputs: number of values of the outputs
   * \param[out] s: output status
   * \param[out] outputs: values of the outputs of the post-processing
   * \param[in] d: batch data
   * \param[in] parameters: values of the parameters
   * \param[in] p: out of bounds policy
   * \param[in] apply: primitive of the backend
   * \return the status
   */
  template <typename Behaviour,
            typename PointTraits,
            typename PostProcessing,
            bool use_initial_state,
            size_type number_of_outputs,
            typename ParametersType,
            typename Apply>
  int executePostProcessingOnBatch(OutputStatus& s,
                                   const Field& outputs,
                                   const BatchData& d,
                                   const ParametersType& parameters,
                                   const tfel::material::OutOfBoundsPolicy p,
                                   const Apply& apply) {
    const auto nv = d.number_of_points == 0 ? 0 : number_of_outputs;
    if ((!check<PointTraits>(s, d)) ||
        (!checkValues(s, outputs, nv, "invalid outputs"))) {
      return s.status;
    }
    using Executor = PostProcessingExecutor<Behaviour, PointTraits,
                                            PostProcessing, use_initial_state,
                                            number_of_outputs, ParametersType>;
    const auto data = makePointFunctionData<PointTraits>(d, parameters, p);
    return apply(d.number_of_points, d.execution, d.rdt,
                 Executor{data, outputs});
  }  // end of executePostProcessingOnBatch

  /*!
   * \brief rotate the values of the points of a batch of an orthotropic
   * behaviour with the primitive of a backend (see `integrateBatch`).
   *
   * \tparam PointRotation: function object rotating the values of a point
   * (see `RotationExecutor`)
   * \param[out] s: output status
   * \param[in] d: rotation data
   * \param[in] apply: primitive of the backend
   * \return the status
   */
  template <typename PointRotation, typename Apply>
  int rotateBatch(OutputStatus& s, const RotationData& d, const Apply& apply) {
    if (!checkRotationData(s, d)) {
      return s.status;
    }
    return apply(d.number_of_points, d.execution, real{1},
                 RotationExecutor<PointRotation>{d});
  }  // end of rotateBatch

  /*!
   * \brief copies of a data shared by all the integration points (see the
   * `@SharedData` keyword) in the memories of the devices used by a
   * process, one per device. The copies are never freed.
   * \tparam T: type of the data
   * \tparam Device: type identifying a device, comparable with `==`
   */
  template <typename T, typename Device>
  struct SharedDataCopies {
    /*!
     * \return the copy on the given device
     * \param[in] d: device
     * \param[in] copy: function making a copy on this device, called at the
     * first request for this device
     */
    template <typename CopyFunction>
    const T* get(const Device& d, const CopyFunction& copy) {
      const auto lock = std::lock_guard{this->mutex};
      for (const auto& [device, p] : this->copies) {
        if (device == d) {
          return p;
        }
      }
      return this->copies.emplace_back(d, copy()).second;
    }

   private:
    //! \brief mutex protecting the copies
    std::mutex mutex;
    //! \brief copies, by device
    std::vector<std::pair<Device, const T*>> copies;
  };

  /*!
   * \return a copy of a data shared by all the integration points (see the
   * `@SharedData` keyword), allocated on the heap at the first call. The
   * heap must be accessible by the device if the computations are offloaded
   * (unified or managed memory, as with the `stlpar` backend of `nvc++`).
   * The copy is never freed.
   * \tparam get_shared_data: function returning the data
   */
  template <auto get_shared_data>
  const auto* getSharedDataCopy() {
    using T = std::remove_cvref_t<decltype(get_shared_data())>;
    static const auto* const p = new T(get_shared_data());
    return p;
  }  // end of getSharedDataCopy

  /*!
   * \brief call the given function and convert exceptions to an error
   * status. This is meant for the host part of the generated functions.
   * \param[out] s: output status
   * \param[in] f: function
   */
  template <typename Function>
  int handleExceptions(OutputStatus* const s, Function&& f) noexcept {
    if (s == nullptr) {
      return -2;
    }
    // the output status is complete even if an exception is thrown before
    // the batch data are checked
    initialize(*s, 1);
    try {
      return f();
    } catch (std::exception& e) {
      return report(*s, -3, e.what());
    } catch (...) {
      return report(*s, -3, "unknown exception");
    }
  }  // end of handleExceptions

}  // end of namespace mfront::gpb

