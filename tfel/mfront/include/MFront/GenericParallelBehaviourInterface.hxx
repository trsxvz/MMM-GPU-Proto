#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX
#define LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX

#include <memory>
#include <string_view>
#include "MFront/GenericBehaviourInterface.hxx"
#include "MFront/GenericBehaviourSymbolsGenerator.hxx"

namespace mfront {

  namespace generic_parallel::behaviour {
    // forward declaration
    struct AbstractBackend;
  }  // end of namespace generic_parallel::behaviour

  /*!
   * \brief an interface integrating a behaviour over a batch of integration
   * points with a parallel programming model selected by the `backend`
   * option (`arcane`, `cuda`, `hip`, `kokkos`, `openacc`, `openmp`, `raja`,
   * `stlpar` or `sycl`), on the host or on a device.
   *
   * Integrating a batch is equivalent to calling the function generated by
   * the `generic` interface at each integration point. This interface reuses
   * the members added by the `generic` interface to the behaviour class and
   * adds a constructor taking the values of the parameters as an argument,
   * since the parameters initializers can't be accessed from device code.
   */
  struct MFRONT_VISIBILITY_EXPORT GenericParallelBehaviourInterface
      : public GenericBehaviourInterface {
    //! \return the interface name
    [[nodiscard]] static std::string getName();
    /*!
     * \brief write the beginning of a function of the generated library
     * working on a batch. The exceptions are converted to an error status,
     * the batch data (`mfront_batch_data`) must be given, and the output
     * status is initialized. The output status and the batch data are then
     * available as `mfront_status` and `mfront_data`. An empty batch is
     * accepted without any check: the generated function returns before
     * the body, with the status of success. This function is shared with the
     * `generic-parallel` interface for models.
     * \param[out] os: output stream
     * \param[in] f: name of the function
     * \param[in] arguments: arguments of the function after the output
     * status
     * \param[in] captures: captures of those arguments
     */
    static void writeBatchFunctionBeginning(std::ostream&,
                                            std::string_view,
                                            std::string_view,
                                            std::string_view);
    /*!
     * \return the name of a function of batches of points: the name of the
     * function of the `generic` interface followed by `_generic_parallel`.
     * This function is shared with the `generic-parallel` interface for
     * models.
     * \param[in] f: name of the function of the `generic` interface
     */
    static std::string getBatchFunctionName(std::string_view);
    /*!
     * \brief write the declaration of the `<base>_generic_parallel_report`
     * function, which analyses the statistics of a batch once the
     * computations are completed. This function is shared with the
     * `generic-parallel` interface for models.
     * \param[out] os: output stream
     * \param[in] base: basis of the names of the functions
     */
    static void writeReportFunctionDeclaration(std::ostream&, std::string_view);
    /*!
     * \brief write the implementation of the
     * `<base>_generic_parallel_report` function (see
     * `writeReportFunctionDeclaration`)
     * \param[out] os: output stream
     * \param[in] base: basis of the names of the functions
     */
    static void writeReportFunction(std::ostream&, std::string_view);
    /*!
     * \return the generator of the symbols of a library. A library also
     * containing the functions of the `generic` interface
     * (`generic_functions` option) exports `Generic` as interface, so that
     * its functions of a point are detected as in a library of the `generic`
     * interface. This function is shared with the `generic-parallel`
     * interface for models.
     * \param[in] generic_functions: true if the library also contains the
     * functions of the `generic` interface
     */
    [[nodiscard]] static std::unique_ptr<GenericBehaviourSymbolsGenerator>
    makeSymbolsGenerator(const bool);
    /*!
     * \brief throw an exception if the given name contains
     * `_generic_parallel`, which ends the names of the functions of batches
     * of points and of their metadata. This function is shared with the
     * `generic-parallel` interface for models.
     * \param[in] m: calling method
     * \param[in] n: name of the behaviour or of the model
     */
    static void checkName(std::string_view, std::string_view);
    /*!
     * \brief write the end of a function started by
     * `writeBatchFunctionBeginning`
     * \param[out] os: output stream
     * \param[in] f: name of the function
     */
    static void writeBatchFunctionEnd(std::ostream&, std::string_view);
    /*!
     * \brief describe a generated library. This function is shared with the
     * `generic-parallel` interface for models.
     * \param[out] d: targets description
     * \param[in] library: name of the library
     * \param[in] source: generated source file
     * \param[in] header: generated header file, relative to the `include`
     * directory
     * \param[in] entry_points: entry points of the library
     */
    static void describeLibrary(TargetsDescription&,
                                const std::string&,
                                const std::string&,
                                const std::string&,
                                const std::vector<std::string>&);
    //! \brief default constructor
    GenericParallelBehaviourInterface();
    //
    [[nodiscard]] std::string getInterfaceName() const override;
    void setOptions(const DataMap&) override;
    [[nodiscard]] std::pair<bool, tokens_iterator> treatKeyword(
        BehaviourDescription&,
        const std::string&,
        const std::vector<std::string>&,
        tokens_iterator,
        const tokens_iterator) override;
    [[nodiscard]] std::string getParametersSourceInBehaviourConstructor(
        const BehaviourDescription&, const Hypothesis) const override;
    [[nodiscard]] bool requiresDeviceCompatibleBehaviourClass() const override;
    void endTreatment(const BehaviourDescription&,
                      const FileDescription&) const override;
    void getTargetsDescription(TargetsDescription&,
                               const BehaviourDescription&) override;
    [[nodiscard]] std::string getLibraryName(
        const BehaviourDescription&) const override;
    [[nodiscard]] std::map<std::string,
                           std::shared_ptr<AbstractBehaviourInterface>>
    getInterfacesOfAdditionalBehaviourConstructors(
        const BehaviourDescription&) const override;
    //! \brief destructor
    ~GenericParallelBehaviourInterface() override;

   protected:
    [[nodiscard]] std::string getBehaviourConstructorTemplateDeclaration()
        const override;
    [[nodiscard]] std::string getBehaviourConstructorArguments() const override;
    void writeBehaviourConstructorHeader(std::ostream&,
                                         const BehaviourDescription&,
                                         const Hypothesis,
                                         const std::string&) const override;
    /*!
     * \return the name of the generated header file
     * \param[in] name: name of the behaviour, including the library
     */
    [[nodiscard]] virtual std::string getHeaderFileName(
        const std::string&) const;
    /*!
     * \return the name of the generated source file
     * \param[in] name: name of the behaviour, including the library
     */
    [[nodiscard]] virtual std::string getSourceFileName(
        const std::string&) const;
    /*!
     * \brief write the header file
     * \param[in] bd: behaviour description
     * \param[in] fd: file description
     */
    virtual void writeHeaderFile(const BehaviourDescription&,
                                 const FileDescription&) const;
    /*!
     * \brief write the source file
     * \param[in] bd: behaviour description
     * \param[in] fd: file description
     */
    virtual void writeSourceFile(const BehaviourDescription&,
                                 const FileDescription&) const;
    /*!
     * \brief write the functions rotating the values of a batch of
     * integration points of an orthotropic behaviour
     * \param[out] os: output stream
     * \param[in] bd: behaviour description
     * \param[in] name: name of the behaviour
     * \param[in] h: modelling hypothesis
     */
    virtual void writeRotationFunctions(std::ostream&,
                                        const BehaviourDescription&,
                                        const std::string&,
                                        const Hypothesis) const;
    /*!
     * \return the name of the source file of the functions of the `generic`
     * interface (`generic_functions` option)
     * \param[in] name: name of the behaviour, including the library
     */
    [[nodiscard]] virtual std::string getPointwiseSourceFileName(
        const std::string&) const;
    /*!
     * \return the name of the header declaring the functions of the
     * `generic` interface (`generic_functions` option), in the
     * `MFront/GenericBehaviour` directory
     * \param[in] name: name of the behaviour, including the library
     */
    [[nodiscard]] virtual std::string getPointwiseHeaderFileName(
        const std::string&) const;
    //! \brief backend
    std::unique_ptr<generic_parallel::behaviour::AbstractBackend> backend;
    /*!
     * \brief if true, the library also contains the functions of the
     * `generic` interface (`generic_functions` option, false by default):
     * integration, initialize functions, post-processings and rotations of
     * a point. The library then exports `Generic` as interface.
     */
    bool generic_functions = false;
  };  // end of struct GenericParallelBehaviourInterface

}  // end of namespace mfront

#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX */
