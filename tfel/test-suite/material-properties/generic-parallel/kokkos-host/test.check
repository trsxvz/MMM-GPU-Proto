@Requires {"mfront::material_property::generic-parallel_interface::supported_configuration::kokkos"};

@Environment {"LD_LIBRARY_PATH": "src"};
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos-host.json ../PoissonRatioTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos-host.json ../Inconel600_YoungModulus.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos-host.json ../Inconel600_YoungModulus-qt.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos-host.json ../UO2_YoungModulus_Martin1989.mfront";
@Command "@mfront@ --obuild --configuration-file=config-kokkos-host.json";
@Command "@TFEL_KOKKOS_CXX_COMPILER@ -O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_KOKKOS_CXX_FLAGS@ -DMFRONT_GPMP_TEST_BACKEND=kokkos -DMFRONT_GPMP_TEST_USE_KOKKOS -I@TFEL_INCLUDE_DIR@ -Iinclude ../test-cxx.cxx -o test-kokkos -L@TFEL_LIBRARY_DIR@ -lTFELTests -Lsrc -lGenericParallelUO2-kokkos -lGenericParallelInconel600-kokkos -lGenericParallelMaterialLaw-kokkos @TFEL_KOKKOS_LINKER_FLAGS@";
@Command "./test-kokkos test-kokkos-kokkos-host";

@CleanFiles {"test-kokkos"};
@CleanDirectories {"include", "src"};
