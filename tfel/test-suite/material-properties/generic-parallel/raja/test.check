@Requires {"mfront::material_property::generic-parallel_interface::supported_configuration::raja"};

@Environment {"LD_LIBRARY_PATH": "src"};
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-raja.json ../PoissonRatioTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-raja.json ../BoundsOrderTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-raja.json ../Inconel600_YoungModulus.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-raja.json ../Inconel600_YoungModulus-qt.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-raja.json ../UO2_YoungModulus_Martin1989.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-raja.json ../LinearDataInterpolationTest.mfront";
@Command "@mfront@ --search-path=.. --interface=generic-parallel --configuration-file=config-raja.json ../MaterialLawCallTest.mfront";
@Command "@mfront@ --obuild --configuration-file=config-raja.json";
@Command "@TFEL_RAJA_CXX_COMPILER@ -O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_RAJA_CXX_FLAGS@ -DMFRONT_GPMP_TEST_BACKEND=raja -DMFRONT_GPMP_TEST_USE_RAJA -I@TFEL_INCLUDE_DIR@ -Iinclude ../test-cxx.cxx -o test-raja -L@TFEL_LIBRARY_DIR@ -lTFELTests -Lsrc -lGenericParallelUO2-raja -lGenericParallelInconel600-raja -lGenericParallelMaterialLaw-raja @TFEL_RAJA_LINKER_FLAGS@";
@Command "./test-raja test-raja-raja";

// comparison with the `generic` interface (see compare.cxx)
@Command "sh ../build-libraries.sh @mfront@ config-raja.json";
@Command "@TFEL_RAJA_CXX_COMPILER@ -O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_RAJA_CXX_FLAGS@ -I@TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl @TFEL_RAJA_LINKER_FLAGS@";
@Command "sh ../compare-all.sh ./compare raja --tolerance=1e-13";

@CleanFiles {"test-raja", "compare"};
@CleanDirectories {"include", "src"};
