@Requires {"mfront::material_property::generic-parallel_interface::supported_configuration::kokkos"};

@Environment {"LD_LIBRARY_PATH": "src"};
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos.json ../PoissonRatioTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos.json ../BoundsOrderTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos.json ../Inconel600_YoungModulus.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos.json ../Inconel600_YoungModulus-qt.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos.json ../UO2_YoungModulus_Martin1989.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-kokkos.json ../LinearDataInterpolationTest.mfront";
@Command "@mfront@ --search-path=.. --interface=generic-parallel --configuration-file=config-kokkos.json ../MaterialLawCallTest.mfront";
@Command "@mfront@ --obuild --configuration-file=config-kokkos.json";
@Command "@TFEL_KOKKOS_CXX_COMPILER@ -O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_KOKKOS_CXX_FLAGS@ -DMFRONT_GPMP_TEST_BACKEND=kokkos -DMFRONT_GPMP_TEST_USE_KOKKOS -I@TFEL_INCLUDE_DIR@ -Iinclude ../test-cxx.cxx -o test-kokkos -L@TFEL_LIBRARY_DIR@ -lTFELTests -Lsrc -lGenericParallelUO2-kokkos -lGenericParallelInconel600-kokkos -lGenericParallelMaterialLaw-kokkos @TFEL_KOKKOS_LINKER_FLAGS@";
@Command "./test-kokkos test-kokkos-kokkos";

// comparison with the `generic` interface (see compare.cxx)
@Command "sh ../build-libraries.sh @mfront@ config-kokkos.json";
@Command "@TFEL_KOKKOS_CXX_COMPILER@ -O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_KOKKOS_CXX_FLAGS@ -DMFRONT_GPB_COMPARE_USE_KOKKOS -I@TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl @TFEL_KOKKOS_LINKER_FLAGS@";
@Command "sh ../compare-all.sh ./compare kokkos --tolerance=1e-13";
// library also containing the functions of the `generic` interface
@Command "sh ../check-generic-functions.sh @mfront@ config-kokkos.json ./compare kokkos --tolerance=1e-13";

@CleanFiles {"test-kokkos", "compare"};
@CleanDirectories {"include", "src", "generic-functions"};
