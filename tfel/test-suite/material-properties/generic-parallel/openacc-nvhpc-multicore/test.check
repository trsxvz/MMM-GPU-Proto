@Requires {"mfront::material_property::generic-parallel_interface::supported_configuration::openacc-nvhpc-multicore"};

@Environment {"LD_LIBRARY_PATH": "src"};
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-openacc-nvhpc-multicore.json ../PoissonRatioTest.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-openacc-nvhpc-multicore.json ../Inconel600_YoungModulus.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-openacc-nvhpc-multicore.json ../Inconel600_YoungModulus-qt.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-openacc-nvhpc-multicore.json ../UO2_YoungModulus_Martin1989.mfront";
@Command "@mfront@ --interface=generic-parallel --configuration-file=config-openacc-nvhpc-multicore.json ../LinearDataInterpolationTest.mfront";
@Command "@mfront@ --search-path=.. --interface=generic-parallel --configuration-file=config-openacc-nvhpc-multicore.json ../MaterialLawCallTest.mfront";
@Command "@mfront@ --obuild --configuration-file=config-openacc-nvhpc-multicore.json";
@Command "@TFEL_NVHPC_COMPILER@ -I @TFEL_INCLUDE_DIR@ -I include -O2 -march=native -acc=multicore --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPMP_TEST_BACKEND=openacc ../test-cxx.cxx -o test-openacc -L @TFEL_LIBRARY_DIR@ -lTFELTests -L src -lGenericParallelUO2-openacc -lGenericParallelInconel600-openacc -lGenericParallelMaterialLaw-openacc";
@Command "./test-openacc test-openacc-openacc-nvhpc-multicore";
// compilation and execution with the runtime checks disabled
@Command "@mfront@ --interface=generic-parallel --dsl-option=disable_runtime_checks:true --configuration-file=config-openacc-nvhpc-multicore.json ../Inconel600_YoungModulus.mfront";
@Command "@mfront@ --obuild --configuration-file=config-openacc-nvhpc-multicore.json";
@Command "@TFEL_NVHPC_COMPILER@ -I @TFEL_INCLUDE_DIR@ -I include -O2 -march=native -acc=multicore --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPMP_TEST_BACKEND=openacc ../test-no-runtime-checks.cxx -o test-no-runtime-checks -L @TFEL_LIBRARY_DIR@ -lTFELTests -L src -lGenericParallelInconel600-openacc";
@Command "./test-no-runtime-checks test-no-runtime-checks-openacc-nvhpc-multicore";

@CleanFiles {"test-openacc", "test-no-runtime-checks"};
@CleanDirectories {"include", "src"};
