@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::hip-clang-nvidia-platform"};

@Environment {"LD_LIBRARY_PATH": "src:reference/src"};
// libraries of the reference (`generic` interface, host compiler) and of the
// tested configuration (see build-libraries.sh)
@Command "sh ../build-libraries.sh @mfront@ config-hip-clang-nvidia-platform.json";
@Command "@TFEL_CLANGXX_COMPILER@ -O2 -std=c++@TFEL_CXX_STANDARD@ -x cuda --cuda-gpu-arch=native --cuda-path=@TFEL_CLANG_CUDA_PATH@ -Wno-unknown-cuda-version -I@TFEL_HIP_INCLUDE_DIR@ -D__HIP_PLATFORM_NVIDIA__ -DMFRONT_GPB_COMPARE_USE_HIP -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -L@TFEL_CLANG_CUDA_LIBRARY_DIR@ -lcudart -ldl";
// comparisons with the `generic` interface, which gives the reference
// results (see compare-all.sh)
@Command "sh ../compare-all.sh ./compare src/libGenericParallelBehaviour-hip.so";
// library also containing the functions of the `generic` interface
@Command "sh ../check-generic-functions.sh @mfront@ config-hip-clang-nvidia-platform.json ./compare hip";

// the name of a behaviour or of a model must not contain `_generic_parallel`
@Command "sh ../check-refused-name.sh @mfront@ config-hip-clang-nvidia-platform.json";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src", "reference", "refused-name", "generic-functions"};
