@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::sycl-default-acpp",
            "mfront::linear_system_solver::tdls"};

@Environment {"LD_LIBRARY_PATH": "src"};
// behaviours using the TDLS linear system solver
@Command "@mfront@ --obuild --search-path=../.. --interface=generic --interface=generic-parallel --configuration-file=config-sycl-default-acpp.json ../../ImplicitNortonTDLS.mfront";
@Command "@TFEL_ACPP_COMPILER@ -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPB_COMPARE_USE_SYCL -I @TFEL_INCLUDE_DIR@ ../../compare.cxx -o compare -ldl";
@Command "sh ../../compare-tdls.sh ./compare src/libGenericParallelBehaviour-sycl.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src"};
