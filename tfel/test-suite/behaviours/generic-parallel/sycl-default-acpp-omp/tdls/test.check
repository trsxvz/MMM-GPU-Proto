@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::sycl-default-acpp",
            "mfront::linear_system_solver::tdls"};

@Environment {"LD_LIBRARY_PATH": "src:reference/src"};
@Environment {"ACPP_VISIBILITY_MASK": "omp"};
// behaviours using the TDLS linear system solver
@Command "sh ../../build-libraries.sh @mfront@ config-sycl-default-acpp.json ImplicitNortonTDLS";
@Command "@TFEL_ACPP_COMPILER@ -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPB_COMPARE_USE_SYCL -I @TFEL_INCLUDE_DIR@ ../../compare.cxx -o compare -L@TFEL_LIBRARY_DIR@ -lMFrontGenericParallelRuntime -ldl";
@Command "sh ../../compare-tdls.sh ./compare src/libGenericParallelBehaviour-sycl.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src", "reference"};
