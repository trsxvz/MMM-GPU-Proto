@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::hip-hipcc",
            "mfront::linear_system_solver::tdls"};

@Environment {"LD_LIBRARY_PATH": "src:reference/src"};
// behaviours using the TDLS linear system solver
@Command "sh ../../build-libraries.sh @mfront@ config-hip-hipcc.json ImplicitNortonTDLS";
@Command "@TFEL_HIPCC_COMPILER@ @TFEL_HIPCC_FLAGS@ -O2 --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPB_COMPARE_USE_HIP -I @TFEL_INCLUDE_DIR@ ../../compare.cxx -o compare -L@TFEL_LIBRARY_DIR@ -lMFrontGenericParallelRuntime -ldl";
@Command "sh ../../compare-tdls.sh ./compare src/libGenericParallelBehaviour-hip.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src", "reference"};
