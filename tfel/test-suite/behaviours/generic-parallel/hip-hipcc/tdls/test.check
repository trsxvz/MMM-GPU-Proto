@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::hip-hipcc",
            "mfront::linear_system_solver::tdls"};

@Environment {"LD_LIBRARY_PATH": "src"};
// behaviours using the TDLS linear system solver
@Command "@mfront@ --obuild --search-path=../.. --interface=generic --interface=generic-parallel --configuration-file=config-hip-hipcc.json ../../ImplicitNortonTDLS.mfront";
@Command "@TFEL_HIPCC_COMPILER@ @TFEL_HIPCC_FLAGS@ -O2 --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPB_COMPARE_USE_HIP -I @TFEL_INCLUDE_DIR@ ../../compare.cxx -o compare -ldl";
@Command "sh ../../compare-tdls.sh ./compare src/libGenericParallelBehaviour-hip.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src"};
