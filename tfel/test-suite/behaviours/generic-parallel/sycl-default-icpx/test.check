@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::sycl-default-icpx"};

@Environment {"LD_LIBRARY_PATH": "src:reference/src"};
// libraries of the reference (`generic` interface, host compiler) and of the
// tested configuration (see build-libraries.sh)
@Command "sh ../build-libraries.sh @mfront@ config-sycl-default-icpx.json";
@Command "@TFEL_ICPX_COMPILER@ -fsycl -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPB_COMPARE_USE_SYCL -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl";
// comparisons with the `generic` interface, which gives the reference
// results (see compare-all.sh)
@Command "sh ../compare-all.sh ./compare src/libGenericParallelBehaviour-sycl.so";
// library also containing the functions of the `generic` interface
@Command "sh ../check-generic-functions.sh @mfront@ config-sycl-default-icpx.json ./compare sycl";

// automatic transfers of the fields allocated in host memory
@Command "@TFEL_ICPX_COMPILER@ -fsycl -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPB_COMPARE_USE_SYCL -DMFRONT_GPB_COMPARE_USE_HOST_MEMORY -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare-host -ldl";
@Command "./compare-host reference/src/libBehaviour.so src/libGenericParallelBehaviour-sycl.so IsotropicLinearHardeningPlasticity_Tridimensional --amplitude=3e-3";
@Command "./compare-host reference/src/libBehaviour.so src/libGenericParallelBehaviour-sycl.so ImplicitNorton_PlaneStress --material-properties=150e9,0.3";
@Command "./compare-host reference/src/libBehaviour.so src/libGenericParallelBehaviour-sycl.so InitializeFunctionTest_Tridimensional_InitializeFunction_StressFromInitialPressure";
@Command "./compare-host reference/src/libBehaviour.so src/libGenericParallelBehaviour-sycl.so ImplicitNorton_PlaneStress_PostProcessing_EquivalentStressAndStrain --material-properties=150e9,0.3";

// the name of a behaviour or of a model must not contain `_generic_parallel`
@Command "sh ../check-refused-name.sh @mfront@ config-sycl-default-icpx.json";

@CleanFiles {"compare", "compare-host"};
@CleanDirectories {"include", "src", "reference", "refused-name", "generic-functions"};
