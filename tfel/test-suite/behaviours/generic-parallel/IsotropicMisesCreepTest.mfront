@DSL IsotropicMisesCreep;
@Behaviour IsotropicMisesCreepTest;
@Description {
  "Norton creep written with the IsotropicMisesCreep DSL."
}

@ElasticMaterialProperties {150e9, 0.3};

//! Norton coefficient
@MaterialProperty real A;
A.setEntryName("NortonCoefficient");
//! Norton exponent
@MaterialProperty real E;
E.setEntryName("NortonExponent");

@FlowRule {
  const auto tmp = A * pow(seq, E - 1);
  f = tmp * seq;
  df_dseq = E * tmp;
}
