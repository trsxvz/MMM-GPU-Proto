@DSL IsotropicPlasticMisesFlow;
@Behaviour BehaviourVariableTestPlasticity;
@Description {
  "Behaviour used by the BehaviourVariableTest behaviour. Its parameters "
  "are not treated as static variables: they are read on the host, and "
  "given to the device by the behaviour using this behaviour variable."
}

@UseQt true;
@Epsilon 1e-14;

@MaterialProperty stress H;
@MaterialProperty stress s0;

//! \brief factor applied to the hardening modulus (changed by the tests)
@Parameter real hardening_factor = 1;

@FlowRule {
  f = seq - hardening_factor * H * p - s0;
  df_dseq = 1;
  df_dp = -hardening_factor * H;
}
