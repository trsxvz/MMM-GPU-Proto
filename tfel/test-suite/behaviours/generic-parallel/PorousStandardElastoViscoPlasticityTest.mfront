@DSL Implicit;
@Behaviour PorousStandardElastoViscoPlasticityTest;
@Description {
  "A behaviour testing the porous flows of the StandardElastoViscoPlasticity "
  "brick: Gurson-Tvergaard-Needleman criterion, porosity growth and "
  "nucleation (Chu-Needleman), staggered scheme for the porosity."
}
@ModellingHypotheses {".+"};
@Epsilon 1.e-14;
@Theta 1;

@Brick StandardElastoViscoPlasticity{
  stress_potential : "Hooke" {young_modulus : 200e3, poisson_ratio : 0.3},
  inelastic_flow : "Plastic" {
    criterion : "GursonTvergaardNeedleman1982" {
      f_c : 0.01,
      f_r : 0.10,
      q_1 : 2,
      q_2 : 1,
      q_3 : 4
    },
    isotropic_hardening : "Linear" {R0 : 200., H : 1000.}
  },
  porosity_evolution : {
    nucleation_model : "Chu-Needleman 1980 (strain)" {
      fn : 0.01,
      en : 1e-2,
      sn : 1e-3
    }
  }
};
