@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::stlpar-parunseq-nvhpc-gpu"};

@Environment {"LD_LIBRARY_PATH": "src:reference/src"};
// libraries of the reference (`generic` interface, host compiler) and of the
// tested configuration (see build-libraries.sh)
@Command "sh ../build-libraries.sh @mfront@ config-stlpar-parunseq-nvhpc-gpu.json";
@Command "@TFEL_NVHPC_COMPILER@ -O2 -march=native -stdpar=gpu -gpu=mem:managed --std=c++@TFEL_CXX_STANDARD@ -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl";
// comparisons with the `generic` interface, which gives the reference
// results (see compare-all.sh)
@Command "sh ../compare-all.sh ./compare src/libGenericParallelBehaviour-stlpar.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src", "reference"};
