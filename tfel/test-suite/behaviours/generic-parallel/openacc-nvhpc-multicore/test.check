@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::openacc-nvhpc-multicore"};

@Environment {"LD_LIBRARY_PATH": "src:reference/src"};
// libraries of the reference (`generic` interface, host compiler) and of the
// tested configuration (see build-libraries.sh)
@Command "sh ../build-libraries.sh @mfront@ config-openacc-nvhpc-multicore.json";
@Command "@TFEL_NVHPC_COMPILER@ -O2 -march=native -acc=multicore --std=c++@TFEL_CXX_STANDARD@ -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -L@TFEL_LIBRARY_DIR@ -lMFrontGenericParallelRuntime -ldl";
// comparisons with the `generic` interface, which gives the reference
// results (see compare-all.sh)
@Command "sh ../compare-all.sh ./compare src/libGenericParallelBehaviour-openacc.so";
// library also containing the functions of the `generic` interface
@Command "sh ../check-generic-functions.sh @mfront@ config-openacc-nvhpc-multicore.json ./compare openacc";

// the name of a behaviour or of a model must not contain `_generic_parallel`
@Command "sh ../check-refused-name.sh @mfront@ config-openacc-nvhpc-multicore.json";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src", "reference", "refused-name", "generic-functions"};
