@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::openacc-nvhpc-multicore",
            "mfront::linear_system_solver::tdls"};

@Environment {"LD_LIBRARY_PATH": "src:reference/src"};
// behaviours using the TDLS linear system solver
@Command "sh ../../build-libraries.sh @mfront@ config-openacc-nvhpc-multicore.json ImplicitNortonTDLS";
@Command "@TFEL_NVHPC_COMPILER@ -O2 -march=native -acc=multicore --std=c++@TFEL_CXX_STANDARD@ -I @TFEL_INCLUDE_DIR@ ../../compare.cxx -o compare -L@TFEL_LIBRARY_DIR@ -lMFrontGenericParallelRuntime -ldl";
@Command "sh ../../compare-tdls.sh ./compare src/libGenericParallelBehaviour-openacc.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src", "reference"};
