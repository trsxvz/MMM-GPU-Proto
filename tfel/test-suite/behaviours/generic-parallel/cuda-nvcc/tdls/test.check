@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::cuda-nvcc",
            "mfront::linear_system_solver::tdls"};

@Environment {"LD_LIBRARY_PATH": "src"};
// behaviours using the TDLS linear system solver
@Command "@mfront@ --obuild --search-path=../.. --interface=generic --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../../ImplicitNortonTDLS.mfront";
@Command "@TFEL_NVCC_COMPILER@ -O2 --std=c++@TFEL_CXX_STANDARD@ -arch=native -x cu -I @TFEL_INCLUDE_DIR@ ../../compare.cxx -o compare -ldl";
@Command "sh ../../compare-tdls.sh ./compare src/libGenericParallelBehaviour-cuda.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src"};
