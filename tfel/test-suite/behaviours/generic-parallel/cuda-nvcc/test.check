@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::cuda-nvcc"};

@Environment {"LD_LIBRARY_PATH": "src"};
// the generic interface gives the reference results. Using both interfaces
// in the same call also checks that they can be used together.
@Command "@mfront@ --obuild --search-path=.. --interface=generic --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../IsotropicLinearHardeningPlasticity.mfront ../ImplicitNorton.mfront ../HosfordPerfectPlasticity.mfront ../StrainHardeningCreep3.mfront ../HenckyImplicitNorton.mfront ../GreenLagrangeImplicitNorton.mfront ../SaintVenantKirchhoffElasticity.mfront ../InitializeFunctionTest.mfront ../PostProcessingTest.mfront ../OrthotropicElastic.mfront ../OrthotropicSaintVenantKirchhoffElasticity.mfront ../OrthotropicStationaryHeatTransfer.mfront ../SingleCrystal_DD_FCC.mfront ../FiniteStrainSingleCrystal.mfront ../ImplicitNortonWithEnergies.mfront ../Norton_rk42.mfront ../Tvergaard.mfront ../BehaviourVariableTest.mfront ../ExternalModelCallerTest.mfront ../StandardElastoViscoPlasticityTest.mfront ../OrthotropicStandardElastoViscoPlasticityTest.mfront ../PorousStandardElastoViscoPlasticityTest.mfront ../GenericParallelModelTest.mfront ../GenericParallelModelWithQuantitiesTest.mfront";
@Command "@TFEL_NVCC_COMPILER@ -O2 --std=c++@TFEL_CXX_STANDARD@ -arch=native -x cu -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl";
// comparisons with the `generic` interface, which gives the reference
// results (see compare-all.sh)
@Command "sh ../compare-all.sh ./compare src/libGenericParallelBehaviour-cuda.so";

@CleanFiles {"compare"};
@CleanDirectories {"include", "src"};
