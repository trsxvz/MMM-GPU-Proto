            icste * (Ks(4, 2) * x22 + Ks(4, 4) * x24 + Ks(4, 5) * x25);
        const auto r25 =
            icste * (Ks(5, 2) * x22 + Ks(5, 4) * x24 + Ks(5, 5) * x25);
        {
          // derivative with respect to the component (0, 0) of the deformation
          // gradient increment
          const auto a0 = r00 * F0[0] + r10 * F0[3] + r20 * F0[5];
          const auto a1 = r01 * F0[0] + r11 * F0[3] + r21 * F0[5];
