#ifndef LIB_TFEL_MATERIAL_FINITESTRAINBEHAVIOURTANGENTOPERATORCONVERTERS_IXX
#define LIB_TFEL_MATERIAL_FINITESTRAINBEHAVIOURTANGENTOPERATORCONVERTERS_IXX

#include "TFEL/Math/General/MathConstants.hxx"
#include "TFEL/Math/tensor.hxx"
#include "TFEL/Math/stensor.hxx"
#include "TFEL/Math/t2tot2.hxx"
#include "TFEL/Math/t2tost2.hxx"
#include "TFEL/Math/st2tost2.hxx"

namespace tfel::material::internals {

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Cauchy stress with respect to
   * the deformation gradient (DSIG_DF) to the derivative of the Cauchy stress
   * with respect to the deformation gradient increment (DSIG_DDF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient increment \f$\Delta\,F=F\,F_{0}^{-1}\f$. Let
   * \f$\delta\,F\f$ be the variation of the deformation gradient associated
   * with this component, \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of
   * \f$l\f$ and \f$\delta\,\tau\f$ the variation of the Kirchhoff stress.
   * DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and DSIG_DDF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DSIG_DF_to_DSIG_DDF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DSIG_DF_to_DSIG_DDF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0) noexcept {
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F0[0];
      Kr(0, 1) = Ks(0, 1) * F0[1];
      Kr(0, 2) = Ks(0, 2) * F0[2];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F0[0];
      Kr(1, 1) = Ks(1, 1) * F0[1];
      Kr(1, 2) = Ks(1, 2) * F0[2];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F0[0];
      Kr(2, 1) = Ks(2, 1) * F0[1];
      Kr(2, 2) = Ks(2, 2) * F0[2];
    }
  };  // end of struct DSIG_DF_to_DSIG_DDF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DSIG_DF_to_DSIG_DDF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0) noexcept {
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F0[0] + Ks(0, 3) * F0[3];
      Kr(0, 1) = Ks(0, 1) * F0[1] + Ks(0, 4) * F0[4];
      Kr(0, 2) = Ks(0, 2) * F0[2];
      Kr(0, 3) = Ks(0, 0) * F0[4] + Ks(0, 3) * F0[1];
      Kr(0, 4) = Ks(0, 1) * F0[3] + Ks(0, 4) * F0[0];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F0[0] + Ks(1, 3) * F0[3];
      Kr(1, 1) = Ks(1, 1) * F0[1] + Ks(1, 4) * F0[4];
      Kr(1, 2) = Ks(1, 2) * F0[2];
      Kr(1, 3) = Ks(1, 0) * F0[4] + Ks(1, 3) * F0[1];
      Kr(1, 4) = Ks(1, 1) * F0[3] + Ks(1, 4) * F0[0];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F0[0] + Ks(2, 3) * F0[3];
      Kr(2, 1) = Ks(2, 1) * F0[1] + Ks(2, 4) * F0[4];
      Kr(2, 2) = Ks(2, 2) * F0[2];
      Kr(2, 3) = Ks(2, 0) * F0[4] + Ks(2, 3) * F0[1];
      Kr(2, 4) = Ks(2, 1) * F0[3] + Ks(2, 4) * F0[0];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * F0[0] + Ks(3, 3) * F0[3];
      Kr(3, 1) = Ks(3, 1) * F0[1] + Ks(3, 4) * F0[4];
      Kr(3, 2) = Ks(3, 2) * F0[2];
      Kr(3, 3) = Ks(3, 0) * F0[4] + Ks(3, 3) * F0[1];
      Kr(3, 4) = Ks(3, 1) * F0[3] + Ks(3, 4) * F0[0];
    }
  };  // end of struct DSIG_DF_to_DSIG_DDF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DSIG_DF_to_DSIG_DDF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0) noexcept {
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F0[0] + Ks(0, 3) * F0[3] + Ks(0, 5) * F0[5];
      Kr(0, 1) = Ks(0, 1) * F0[1] + Ks(0, 4) * F0[4] + Ks(0, 7) * F0[7];
      Kr(0, 2) = Ks(0, 2) * F0[2] + Ks(0, 6) * F0[6] + Ks(0, 8) * F0[8];
      Kr(0, 3) = Ks(0, 0) * F0[4] + Ks(0, 3) * F0[1] + Ks(0, 5) * F0[7];
      Kr(0, 4) = Ks(0, 1) * F0[3] + Ks(0, 4) * F0[0] + Ks(0, 7) * F0[5];
      Kr(0, 5) = Ks(0, 0) * F0[6] + Ks(0, 3) * F0[8] + Ks(0, 5) * F0[2];
      Kr(0, 6) = Ks(0, 2) * F0[5] + Ks(0, 6) * F0[0] + Ks(0, 8) * F0[3];
      Kr(0, 7) = Ks(0, 1) * F0[8] + Ks(0, 4) * F0[6] + Ks(0, 7) * F0[2];
      Kr(0, 8) = Ks(0, 2) * F0[7] + Ks(0, 6) * F0[4] + Ks(0, 8) * F0[1];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F0[0] + Ks(1, 3) * F0[3] + Ks(1, 5) * F0[5];
      Kr(1, 1) = Ks(1, 1) * F0[1] + Ks(1, 4) * F0[4] + Ks(1, 7) * F0[7];
      Kr(1, 2) = Ks(1, 2) * F0[2] + Ks(1, 6) * F0[6] + Ks(1, 8) * F0[8];
      Kr(1, 3) = Ks(1, 0) * F0[4] + Ks(1, 3) * F0[1] + Ks(1, 5) * F0[7];
      Kr(1, 4) = Ks(1, 1) * F0[3] + Ks(1, 4) * F0[0] + Ks(1, 7) * F0[5];
      Kr(1, 5) = Ks(1, 0) * F0[6] + Ks(1, 3) * F0[8] + Ks(1, 5) * F0[2];
      Kr(1, 6) = Ks(1, 2) * F0[5] + Ks(1, 6) * F0[0] + Ks(1, 8) * F0[3];
      Kr(1, 7) = Ks(1, 1) * F0[8] + Ks(1, 4) * F0[6] + Ks(1, 7) * F0[2];
      Kr(1, 8) = Ks(1, 2) * F0[7] + Ks(1, 6) * F0[4] + Ks(1, 8) * F0[1];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F0[0] + Ks(2, 3) * F0[3] + Ks(2, 5) * F0[5];
      Kr(2, 1) = Ks(2, 1) * F0[1] + Ks(2, 4) * F0[4] + Ks(2, 7) * F0[7];
      Kr(2, 2) = Ks(2, 2) * F0[2] + Ks(2, 6) * F0[6] + Ks(2, 8) * F0[8];
      Kr(2, 3) = Ks(2, 0) * F0[4] + Ks(2, 3) * F0[1] + Ks(2, 5) * F0[7];
      Kr(2, 4) = Ks(2, 1) * F0[3] + Ks(2, 4) * F0[0] + Ks(2, 7) * F0[5];
      Kr(2, 5) = Ks(2, 0) * F0[6] + Ks(2, 3) * F0[8] + Ks(2, 5) * F0[2];
      Kr(2, 6) = Ks(2, 2) * F0[5] + Ks(2, 6) * F0[0] + Ks(2, 8) * F0[3];
      Kr(2, 7) = Ks(2, 1) * F0[8] + Ks(2, 4) * F0[6] + Ks(2, 7) * F0[2];
      Kr(2, 8) = Ks(2, 2) * F0[7] + Ks(2, 6) * F0[4] + Ks(2, 8) * F0[1];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * F0[0] + Ks(3, 3) * F0[3] + Ks(3, 5) * F0[5];
      Kr(3, 1) = Ks(3, 1) * F0[1] + Ks(3, 4) * F0[4] + Ks(3, 7) * F0[7];
      Kr(3, 2) = Ks(3, 2) * F0[2] + Ks(3, 6) * F0[6] + Ks(3, 8) * F0[8];
      Kr(3, 3) = Ks(3, 0) * F0[4] + Ks(3, 3) * F0[1] + Ks(3, 5) * F0[7];
      Kr(3, 4) = Ks(3, 1) * F0[3] + Ks(3, 4) * F0[0] + Ks(3, 7) * F0[5];
      Kr(3, 5) = Ks(3, 0) * F0[6] + Ks(3, 3) * F0[8] + Ks(3, 5) * F0[2];
      Kr(3, 6) = Ks(3, 2) * F0[5] + Ks(3, 6) * F0[0] + Ks(3, 8) * F0[3];
      Kr(3, 7) = Ks(3, 1) * F0[8] + Ks(3, 4) * F0[6] + Ks(3, 7) * F0[2];
      Kr(3, 8) = Ks(3, 2) * F0[7] + Ks(3, 6) * F0[4] + Ks(3, 8) * F0[1];
      // derivatives of the component (0, 2) of the stress
      Kr(4, 0) = Ks(4, 0) * F0[0] + Ks(4, 3) * F0[3] + Ks(4, 5) * F0[5];
      Kr(4, 1) = Ks(4, 1) * F0[1] + Ks(4, 4) * F0[4] + Ks(4, 7) * F0[7];
      Kr(4, 2) = Ks(4, 2) * F0[2] + Ks(4, 6) * F0[6] + Ks(4, 8) * F0[8];
      Kr(4, 3) = Ks(4, 0) * F0[4] + Ks(4, 3) * F0[1] + Ks(4, 5) * F0[7];
      Kr(4, 4) = Ks(4, 1) * F0[3] + Ks(4, 4) * F0[0] + Ks(4, 7) * F0[5];
      Kr(4, 5) = Ks(4, 0) * F0[6] + Ks(4, 3) * F0[8] + Ks(4, 5) * F0[2];
      Kr(4, 6) = Ks(4, 2) * F0[5] + Ks(4, 6) * F0[0] + Ks(4, 8) * F0[3];
      Kr(4, 7) = Ks(4, 1) * F0[8] + Ks(4, 4) * F0[6] + Ks(4, 7) * F0[2];
      Kr(4, 8) = Ks(4, 2) * F0[7] + Ks(4, 6) * F0[4] + Ks(4, 8) * F0[1];
      // derivatives of the component (1, 2) of the stress
      Kr(5, 0) = Ks(5, 0) * F0[0] + Ks(5, 3) * F0[3] + Ks(5, 5) * F0[5];
      Kr(5, 1) = Ks(5, 1) * F0[1] + Ks(5, 4) * F0[4] + Ks(5, 7) * F0[7];
      Kr(5, 2) = Ks(5, 2) * F0[2] + Ks(5, 6) * F0[6] + Ks(5, 8) * F0[8];
      Kr(5, 3) = Ks(5, 0) * F0[4] + Ks(5, 3) * F0[1] + Ks(5, 5) * F0[7];
      Kr(5, 4) = Ks(5, 1) * F0[3] + Ks(5, 4) * F0[0] + Ks(5, 7) * F0[5];
      Kr(5, 5) = Ks(5, 0) * F0[6] + Ks(5, 3) * F0[8] + Ks(5, 5) * F0[2];
      Kr(5, 6) = Ks(5, 2) * F0[5] + Ks(5, 6) * F0[0] + Ks(5, 8) * F0[3];
      Kr(5, 7) = Ks(5, 1) * F0[8] + Ks(5, 4) * F0[6] + Ks(5, 7) * F0[2];
      Kr(5, 8) = Ks(5, 2) * F0[7] + Ks(5, 6) * F0[4] + Ks(5, 8) * F0[1];
    }
  };  // end of struct DSIG_DF_to_DSIG_DDF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Cauchy stress with respect to
   * the deformation gradient (DSIG_DF) to the derivative of the Kirchhoff
   * stress with respect to the deformation gradient increment (DTAU_DDF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient increment \f$\Delta\,F=F\,F_{0}^{-1}\f$. Let
   * \f$\delta\,F\f$ be the variation of the deformation gradient associated
   * with this component, \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of
   * \f$l\f$ and \f$\delta\,\tau\f$ the variation of the Kirchhoff stress.
   * DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DSIG_DF_to_DTAU_DDF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DSIG_DF_to_DTAU_DDF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const tfel::math::tensor<1u, real> dJF0 = dJ * tfel::math::transpose(F0);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient increment
      Kr(0, 0) = J * Ks(0, 0) * F0[0] + dJF0[0] * s[0];
      Kr(1, 0) = J * Ks(1, 0) * F0[0] + dJF0[0] * s[1];
      Kr(2, 0) = J * Ks(2, 0) * F0[0] + dJF0[0] * s[2];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient increment
      Kr(0, 1) = J * Ks(0, 1) * F0[1] + dJF0[1] * s[0];
      Kr(1, 1) = J * Ks(1, 1) * F0[1] + dJF0[1] * s[1];
      Kr(2, 1) = J * Ks(2, 1) * F0[1] + dJF0[1] * s[2];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient increment
      Kr(0, 2) = J * Ks(0, 2) * F0[2] + dJF0[2] * s[0];
      Kr(1, 2) = J * Ks(1, 2) * F0[2] + dJF0[2] * s[1];
      Kr(2, 2) = J * Ks(2, 2) * F0[2] + dJF0[2] * s[2];
    }
  };  // end of struct DSIG_DF_to_DTAU_DDF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DSIG_DF_to_DTAU_DDF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const tfel::math::tensor<2u, real> dJF0 = dJ * tfel::math::transpose(F0);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient increment
      Kr(0, 0) = J * (Ks(0, 0) * F0[0] + Ks(0, 3) * F0[3]) + dJF0[0] * s[0];
      Kr(1, 0) = J * (Ks(1, 0) * F0[0] + Ks(1, 3) * F0[3]) + dJF0[0] * s[1];
      Kr(2, 0) = J * (Ks(2, 0) * F0[0] + Ks(2, 3) * F0[3]) + dJF0[0] * s[2];
      Kr(3, 0) = J * (Ks(3, 0) * F0[0] + Ks(3, 3) * F0[3]) + dJF0[0] * s[3];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient increment
      Kr(0, 1) = J * (Ks(0, 1) * F0[1] + Ks(0, 4) * F0[4]) + dJF0[1] * s[0];
      Kr(1, 1) = J * (Ks(1, 1) * F0[1] + Ks(1, 4) * F0[4]) + dJF0[1] * s[1];
      Kr(2, 1) = J * (Ks(2, 1) * F0[1] + Ks(2, 4) * F0[4]) + dJF0[1] * s[2];
      Kr(3, 1) = J * (Ks(3, 1) * F0[1] + Ks(3, 4) * F0[4]) + dJF0[1] * s[3];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient increment
      Kr(0, 2) = J * Ks(0, 2) * F0[2] + dJF0[2] * s[0];
      Kr(1, 2) = J * Ks(1, 2) * F0[2] + dJF0[2] * s[1];
      Kr(2, 2) = J * Ks(2, 2) * F0[2] + dJF0[2] * s[2];
      Kr(3, 2) = J * Ks(3, 2) * F0[2] + dJF0[2] * s[3];
      // derivative with respect to the component (0, 1) of the deformation
      // gradient increment
      Kr(0, 3) = J * (Ks(0, 0) * F0[4] + Ks(0, 3) * F0[1]) + dJF0[3] * s[0];
      Kr(1, 3) = J * (Ks(1, 0) * F0[4] + Ks(1, 3) * F0[1]) + dJF0[3] * s[1];
      Kr(2, 3) = J * (Ks(2, 0) * F0[4] + Ks(2, 3) * F0[1]) + dJF0[3] * s[2];
      Kr(3, 3) = J * (Ks(3, 0) * F0[4] + Ks(3, 3) * F0[1]) + dJF0[3] * s[3];
      // derivative with respect to the component (1, 0) of the deformation
      // gradient increment
      Kr(0, 4) = J * (Ks(0, 1) * F0[3] + Ks(0, 4) * F0[0]) + dJF0[4] * s[0];
      Kr(1, 4) = J * (Ks(1, 1) * F0[3] + Ks(1, 4) * F0[0]) + dJF0[4] * s[1];
      Kr(2, 4) = J * (Ks(2, 1) * F0[3] + Ks(2, 4) * F0[0]) + dJF0[4] * s[2];
      Kr(3, 4) = J * (Ks(3, 1) * F0[3] + Ks(3, 4) * F0[0]) + dJF0[4] * s[3];
    }
  };  // end of struct DSIG_DF_to_DTAU_DDF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DSIG_DF_to_DTAU_DDF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const tfel::math::tensor<3u, real> dJF0 = dJ * tfel::math::transpose(F0);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient increment
      Kr(0, 0) = J * (Ks(0, 0) * F0[0] + Ks(0, 3) * F0[3] + Ks(0, 5) * F0[5]) +
                 dJF0[0] * s[0];
      Kr(1, 0) = J * (Ks(1, 0) * F0[0] + Ks(1, 3) * F0[3] + Ks(1, 5) * F0[5]) +
                 dJF0[0] * s[1];
      Kr(2, 0) = J * (Ks(2, 0) * F0[0] + Ks(2, 3) * F0[3] + Ks(2, 5) * F0[5]) +
                 dJF0[0] * s[2];
      Kr(3, 0) = J * (Ks(3, 0) * F0[0] + Ks(3, 3) * F0[3] + Ks(3, 5) * F0[5]) +
                 dJF0[0] * s[3];
      Kr(4, 0) = J * (Ks(4, 0) * F0[0] + Ks(4, 3) * F0[3] + Ks(4, 5) * F0[5]) +
                 dJF0[0] * s[4];
      Kr(5, 0) = J * (Ks(5, 0) * F0[0] + Ks(5, 3) * F0[3] + Ks(5, 5) * F0[5]) +
                 dJF0[0] * s[5];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient increment
      Kr(0, 1) = J * (Ks(0, 1) * F0[1] + Ks(0, 4) * F0[4] + Ks(0, 7) * F0[7]) +
                 dJF0[1] * s[0];
      Kr(1, 1) = J * (Ks(1, 1) * F0[1] + Ks(1, 4) * F0[4] + Ks(1, 7) * F0[7]) +
                 dJF0[1] * s[1];
      Kr(2, 1) = J * (Ks(2, 1) * F0[1] + Ks(2, 4) * F0[4] + Ks(2, 7) * F0[7]) +
                 dJF0[1] * s[2];
      Kr(3, 1) = J * (Ks(3, 1) * F0[1] + Ks(3, 4) * F0[4] + Ks(3, 7) * F0[7]) +
                 dJF0[1] * s[3];
      Kr(4, 1) = J * (Ks(4, 1) * F0[1] + Ks(4, 4) * F0[4] + Ks(4, 7) * F0[7]) +
                 dJF0[1] * s[4];
      Kr(5, 1) = J * (Ks(5, 1) * F0[1] + Ks(5, 4) * F0[4] + Ks(5, 7) * F0[7]) +
                 dJF0[1] * s[5];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient increment
      Kr(0, 2) = J * (Ks(0, 2) * F0[2] + Ks(0, 6) * F0[6] + Ks(0, 8) * F0[8]) +
                 dJF0[2] * s[0];
      Kr(1, 2) = J * (Ks(1, 2) * F0[2] + Ks(1, 6) * F0[6] + Ks(1, 8) * F0[8]) +
                 dJF0[2] * s[1];
      Kr(2, 2) = J * (Ks(2, 2) * F0[2] + Ks(2, 6) * F0[6] + Ks(2, 8) * F0[8]) +
                 dJF0[2] * s[2];
      Kr(3, 2) = J * (Ks(3, 2) * F0[2] + Ks(3, 6) * F0[6] + Ks(3, 8) * F0[8]) +
                 dJF0[2] * s[3];
      Kr(4, 2) = J * (Ks(4, 2) * F0[2] + Ks(4, 6) * F0[6] + Ks(4, 8) * F0[8]) +
                 dJF0[2] * s[4];
      Kr(5, 2) = J * (Ks(5, 2) * F0[2] + Ks(5, 6) * F0[6] + Ks(5, 8) * F0[8]) +
                 dJF0[2] * s[5];
      // derivative with respect to the component (0, 1) of the deformation
      // gradient increment
      Kr(0, 3) = J * (Ks(0, 0) * F0[4] + Ks(0, 3) * F0[1] + Ks(0, 5) * F0[7]) +
                 dJF0[3] * s[0];
      Kr(1, 3) = J * (Ks(1, 0) * F0[4] + Ks(1, 3) * F0[1] + Ks(1, 5) * F0[7]) +
                 dJF0[3] * s[1];
      Kr(2, 3) = J * (Ks(2, 0) * F0[4] + Ks(2, 3) * F0[1] + Ks(2, 5) * F0[7]) +
                 dJF0[3] * s[2];
      Kr(3, 3) = J * (Ks(3, 0) * F0[4] + Ks(3, 3) * F0[1] + Ks(3, 5) * F0[7]) +
                 dJF0[3] * s[3];
      Kr(4, 3) = J * (Ks(4, 0) * F0[4] + Ks(4, 3) * F0[1] + Ks(4, 5) * F0[7]) +
                 dJF0[3] * s[4];
      Kr(5, 3) = J * (Ks(5, 0) * F0[4] + Ks(5, 3) * F0[1] + Ks(5, 5) * F0[7]) +
                 dJF0[3] * s[5];
      // derivative with respect to the component (1, 0) of the deformation
      // gradient increment
      Kr(0, 4) = J * (Ks(0, 1) * F0[3] + Ks(0, 4) * F0[0] + Ks(0, 7) * F0[5]) +
                 dJF0[4] * s[0];
      Kr(1, 4) = J * (Ks(1, 1) * F0[3] + Ks(1, 4) * F0[0] + Ks(1, 7) * F0[5]) +
                 dJF0[4] * s[1];
      Kr(2, 4) = J * (Ks(2, 1) * F0[3] + Ks(2, 4) * F0[0] + Ks(2, 7) * F0[5]) +
                 dJF0[4] * s[2];
      Kr(3, 4) = J * (Ks(3, 1) * F0[3] + Ks(3, 4) * F0[0] + Ks(3, 7) * F0[5]) +
                 dJF0[4] * s[3];
      Kr(4, 4) = J * (Ks(4, 1) * F0[3] + Ks(4, 4) * F0[0] + Ks(4, 7) * F0[5]) +
                 dJF0[4] * s[4];
      Kr(5, 4) = J * (Ks(5, 1) * F0[3] + Ks(5, 4) * F0[0] + Ks(5, 7) * F0[5]) +
                 dJF0[4] * s[5];
      // derivative with respect to the component (0, 2) of the deformation
      // gradient increment
      Kr(0, 5) = J * (Ks(0, 0) * F0[6] + Ks(0, 3) * F0[8] + Ks(0, 5) * F0[2]) +
                 dJF0[5] * s[0];
      Kr(1, 5) = J * (Ks(1, 0) * F0[6] + Ks(1, 3) * F0[8] + Ks(1, 5) * F0[2]) +
                 dJF0[5] * s[1];
      Kr(2, 5) = J * (Ks(2, 0) * F0[6] + Ks(2, 3) * F0[8] + Ks(2, 5) * F0[2]) +
                 dJF0[5] * s[2];
      Kr(3, 5) = J * (Ks(3, 0) * F0[6] + Ks(3, 3) * F0[8] + Ks(3, 5) * F0[2]) +
                 dJF0[5] * s[3];
      Kr(4, 5) = J * (Ks(4, 0) * F0[6] + Ks(4, 3) * F0[8] + Ks(4, 5) * F0[2]) +
                 dJF0[5] * s[4];
      Kr(5, 5) = J * (Ks(5, 0) * F0[6] + Ks(5, 3) * F0[8] + Ks(5, 5) * F0[2]) +
                 dJF0[5] * s[5];
      // derivative with respect to the component (2, 0) of the deformation
      // gradient increment
      Kr(0, 6) = J * (Ks(0, 2) * F0[5] + Ks(0, 6) * F0[0] + Ks(0, 8) * F0[3]) +
                 dJF0[6] * s[0];
      Kr(1, 6) = J * (Ks(1, 2) * F0[5] + Ks(1, 6) * F0[0] + Ks(1, 8) * F0[3]) +
                 dJF0[6] * s[1];
      Kr(2, 6) = J * (Ks(2, 2) * F0[5] + Ks(2, 6) * F0[0] + Ks(2, 8) * F0[3]) +
                 dJF0[6] * s[2];
      Kr(3, 6) = J * (Ks(3, 2) * F0[5] + Ks(3, 6) * F0[0] + Ks(3, 8) * F0[3]) +
                 dJF0[6] * s[3];
      Kr(4, 6) = J * (Ks(4, 2) * F0[5] + Ks(4, 6) * F0[0] + Ks(4, 8) * F0[3]) +
                 dJF0[6] * s[4];
      Kr(5, 6) = J * (Ks(5, 2) * F0[5] + Ks(5, 6) * F0[0] + Ks(5, 8) * F0[3]) +
                 dJF0[6] * s[5];
      // derivative with respect to the component (1, 2) of the deformation
      // gradient increment
      Kr(0, 7) = J * (Ks(0, 1) * F0[8] + Ks(0, 4) * F0[6] + Ks(0, 7) * F0[2]) +
                 dJF0[7] * s[0];
      Kr(1, 7) = J * (Ks(1, 1) * F0[8] + Ks(1, 4) * F0[6] + Ks(1, 7) * F0[2]) +
                 dJF0[7] * s[1];
      Kr(2, 7) = J * (Ks(2, 1) * F0[8] + Ks(2, 4) * F0[6] + Ks(2, 7) * F0[2]) +
                 dJF0[7] * s[2];
      Kr(3, 7) = J * (Ks(3, 1) * F0[8] + Ks(3, 4) * F0[6] + Ks(3, 7) * F0[2]) +
                 dJF0[7] * s[3];
      Kr(4, 7) = J * (Ks(4, 1) * F0[8] + Ks(4, 4) * F0[6] + Ks(4, 7) * F0[2]) +
                 dJF0[7] * s[4];
      Kr(5, 7) = J * (Ks(5, 1) * F0[8] + Ks(5, 4) * F0[6] + Ks(5, 7) * F0[2]) +
                 dJF0[7] * s[5];
      // derivative with respect to the component (2, 1) of the deformation
      // gradient increment
      Kr(0, 8) = J * (Ks(0, 2) * F0[7] + Ks(0, 6) * F0[4] + Ks(0, 8) * F0[1]) +
                 dJF0[8] * s[0];
      Kr(1, 8) = J * (Ks(1, 2) * F0[7] + Ks(1, 6) * F0[4] + Ks(1, 8) * F0[1]) +
                 dJF0[8] * s[1];
      Kr(2, 8) = J * (Ks(2, 2) * F0[7] + Ks(2, 6) * F0[4] + Ks(2, 8) * F0[1]) +
                 dJF0[8] * s[2];
      Kr(3, 8) = J * (Ks(3, 2) * F0[7] + Ks(3, 6) * F0[4] + Ks(3, 8) * F0[1]) +
                 dJF0[8] * s[3];
      Kr(4, 8) = J * (Ks(4, 2) * F0[7] + Ks(4, 6) * F0[4] + Ks(4, 8) * F0[1]) +
                 dJF0[8] * s[4];
      Kr(5, 8) = J * (Ks(5, 2) * F0[7] + Ks(5, 6) * F0[4] + Ks(5, 8) * F0[1]) +
                 dJF0[8] * s[5];
    }
  };  // end of struct DSIG_DF_to_DTAU_DDF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Cauchy stress with respect to
   * the deformation gradient (DSIG_DF) to the derivative of the first
   * Piola-Kirchhoff stress with respect to the deformation gradient (DPK1_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and DPK1_DF relates
   * \f[
   * \delta\,P=\left(\delta\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DSIG_DF_to_DPK1_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DSIG_DF_to_DPK1_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = Ks(0, 0) * dJ[0];
      Kr(1, 0) = Ks(1, 0) * dJ[1] + F[2] * s[1];
      Kr(2, 0) = Ks(2, 0) * dJ[2] + F[1] * s[2];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = Ks(0, 1) * dJ[0] + F[2] * s[0];
      Kr(1, 1) = Ks(1, 1) * dJ[1];
      Kr(2, 1) = Ks(2, 1) * dJ[2] + F[0] * s[2];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * dJ[0] + F[1] * s[0];
      Kr(1, 2) = Ks(1, 2) * dJ[1] + F[0] * s[1];
      Kr(2, 2) = Ks(2, 2) * dJ[2];
    }
  };  // end of struct DSIG_DF_to_DPK1_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DSIG_DF_to_DPK1_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = Ks(0, 0) * dJ[0] + icste * Ks(3, 0) * dJ[4];
      Kr(1, 0) = Ks(1, 0) * dJ[1] + F[2] * s[1] + icste * Ks(3, 0) * dJ[3];
      Kr(2, 0) = Ks(2, 0) * dJ[2] + F[1] * s[2];
      Kr(3, 0) = Ks(0, 0) * dJ[3] + icste * (Ks(3, 0) * dJ[1] + F[2] * s[3]);
      Kr(4, 0) = Ks(1, 0) * dJ[4] + icste * Ks(3, 0) * dJ[0];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = Ks(0, 1) * dJ[0] + F[2] * s[0] + icste * Ks(3, 1) * dJ[4];
      Kr(1, 1) = Ks(1, 1) * dJ[1] + icste * Ks(3, 1) * dJ[3];
      Kr(2, 1) = Ks(2, 1) * dJ[2] + F[0] * s[2];
      Kr(3, 1) = Ks(0, 1) * dJ[3] + icste * Ks(3, 1) * dJ[1];
      Kr(4, 1) = Ks(1, 1) * dJ[4] + icste * (Ks(3, 1) * dJ[0] + F[2] * s[3]);
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * dJ[0] + F[1] * s[0] +
                 icste * (Ks(3, 2) * dJ[4] - F[3] * s[3]);
      Kr(1, 2) = Ks(1, 2) * dJ[1] + F[0] * s[1] +
                 icste * (Ks(3, 2) * dJ[3] - F[4] * s[3]);
      Kr(2, 2) = Ks(2, 2) * dJ[2];
      Kr(3, 2) = Ks(0, 2) * dJ[3] - F[4] * s[0] +
                 icste * (Ks(3, 2) * dJ[1] + F[0] * s[3]);
      Kr(4, 2) = Ks(1, 2) * dJ[4] - F[3] * s[1] +
                 icste * (Ks(3, 2) * dJ[0] + F[1] * s[3]);
      // derivative with respect to the component (0, 1) of the deformation
      // gradient
      Kr(0, 3) = Ks(0, 3) * dJ[0] + icste * (Ks(3, 3) * dJ[4] - F[2] * s[3]);
      Kr(1, 3) = Ks(1, 3) * dJ[1] + icste * Ks(3, 3) * dJ[3];
      Kr(2, 3) = Ks(2, 3) * dJ[2] - F[4] * s[2];
      Kr(3, 3) = Ks(0, 3) * dJ[3] + icste * Ks(3, 3) * dJ[1];
      Kr(4, 3) = Ks(1, 3) * dJ[4] - F[2] * s[1] + icste * Ks(3, 3) * dJ[0];
      // derivative with respect to the component (1, 0) of the deformation
      // gradient
      Kr(0, 4) = Ks(0, 4) * dJ[0] + icste * Ks(3, 4) * dJ[4];
      Kr(1, 4) = Ks(1, 4) * dJ[1] + icste * (Ks(3, 4) * dJ[3] - F[2] * s[3]);
      Kr(2, 4) = Ks(2, 4) * dJ[2] - F[3] * s[2];
      Kr(3, 4) = Ks(0, 4) * dJ[3] - F[2] * s[0] + icste * Ks(3, 4) * dJ[1];
      Kr(4, 4) = Ks(1, 4) * dJ[4] + icste * Ks(3, 4) * dJ[0];
    }
  };  // end of struct DSIG_DF_to_DPK1_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DSIG_DF_to_DPK1_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) =
          Ks(0, 0) * dJ[0] + icste * (Ks(3, 0) * dJ[4] + Ks(4, 0) * dJ[6]);
      Kr(1, 0) = Ks(1, 0) * dJ[1] + F[2] * s[1] +
                 icste * (Ks(3, 0) * dJ[3] + Ks(5, 0) * dJ[8] - F[7] * s[5]);
      Kr(2, 0) = Ks(2, 0) * dJ[2] + F[1] * s[2] +
                 icste * (Ks(4, 0) * dJ[5] + Ks(5, 0) * dJ[7] - F[8] * s[5]);
      Kr(3, 0) =
          Ks(0, 0) * dJ[3] + icste * (Ks(3, 0) * dJ[1] + Ks(4, 0) * dJ[8] +
                                      F[2] * s[3] - F[7] * s[4]);
      Kr(4, 0) =
          Ks(1, 0) * dJ[4] + icste * (Ks(3, 0) * dJ[0] + Ks(5, 0) * dJ[6]);
      Kr(5, 0) =
          Ks(0, 0) * dJ[5] + icste * (Ks(3, 0) * dJ[7] + Ks(4, 0) * dJ[2] +
                                      F[1] * s[4] - F[8] * s[3]);
      Kr(6, 0) =
          Ks(2, 0) * dJ[6] + icste * (Ks(4, 0) * dJ[0] + Ks(5, 0) * dJ[4]);
      Kr(7, 0) = Ks(1, 0) * dJ[7] - F[8] * s[1] +
                 icste * (Ks(3, 0) * dJ[5] + Ks(5, 0) * dJ[2] + F[1] * s[5]);
      Kr(8, 0) = Ks(2, 0) * dJ[8] - F[7] * s[2] +
                 icste * (Ks(4, 0) * dJ[3] + Ks(5, 0) * dJ[1] + F[2] * s[5]);
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = Ks(0, 1) * dJ[0] + F[2] * s[0] +
                 icste * (Ks(3, 1) * dJ[4] + Ks(4, 1) * dJ[6] - F[5] * s[4]);
      Kr(1, 1) =
          Ks(1, 1) * dJ[1] + icste * (Ks(3, 1) * dJ[3] + Ks(5, 1) * dJ[8]);
      Kr(2, 1) = Ks(2, 1) * dJ[2] + F[0] * s[2] +
                 icste * (Ks(4, 1) * dJ[5] + Ks(5, 1) * dJ[7] - F[6] * s[4]);
      Kr(3, 1) =
          Ks(0, 1) * dJ[3] + icste * (Ks(3, 1) * dJ[1] + Ks(4, 1) * dJ[8]);
      Kr(4, 1) =
          Ks(1, 1) * dJ[4] + icste * (Ks(3, 1) * dJ[0] + Ks(5, 1) * dJ[6] +
                                      F[2] * s[3] - F[5] * s[5]);
      Kr(5, 1) = Ks(0, 1) * dJ[5] - F[6] * s[0] +
                 icste * (Ks(3, 1) * dJ[7] + Ks(4, 1) * dJ[2] + F[0] * s[4]);
      Kr(6, 1) = Ks(2, 1) * dJ[6] - F[5] * s[2] +
                 icste * (Ks(4, 1) * dJ[0] + Ks(5, 1) * dJ[4] + F[2] * s[4]);
      Kr(7, 1) =
          Ks(1, 1) * dJ[7] + icste * (Ks(3, 1) * dJ[5] + Ks(5, 1) * dJ[2] +
                                      F[0] * s[5] - F[6] * s[3]);
      Kr(8, 1) =
          Ks(2, 1) * dJ[8] + icste * (Ks(4, 1) * dJ[3] + Ks(5, 1) * dJ[1]);
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * dJ[0] + F[1] * s[0] +
                 icste * (Ks(3, 2) * dJ[4] + Ks(4, 2) * dJ[6] - F[3] * s[3]);
      Kr(1, 2) = Ks(1, 2) * dJ[1] + F[0] * s[1] +
                 icste * (Ks(3, 2) * dJ[3] + Ks(5, 2) * dJ[8] - F[4] * s[3]);
      Kr(2, 2) =
          Ks(2, 2) * dJ[2] + icste * (Ks(4, 2) * dJ[5] + Ks(5, 2) * dJ[7]);
      Kr(3, 2) = Ks(0, 2) * dJ[3] - F[4] * s[0] +
                 icste * (Ks(3, 2) * dJ[1] + Ks(4, 2) * dJ[8] + F[0] * s[3]);
      Kr(4, 2) = Ks(1, 2) * dJ[4] - F[3] * s[1] +
                 icste * (Ks(3, 2) * dJ[0] + Ks(5, 2) * dJ[6] + F[1] * s[3]);
      Kr(5, 2) =
          Ks(0, 2) * dJ[5] + icste * (Ks(3, 2) * dJ[7] + Ks(4, 2) * dJ[2]);
      Kr(6, 2) =
          Ks(2, 2) * dJ[6] + icste * (Ks(4, 2) * dJ[0] + Ks(5, 2) * dJ[4] +
                                      F[1] * s[4] - F[3] * s[5]);
      Kr(7, 2) =
          Ks(1, 2) * dJ[7] + icste * (Ks(3, 2) * dJ[5] + Ks(5, 2) * dJ[2]);
      Kr(8, 2) =
          Ks(2, 2) * dJ[8] + icste * (Ks(4, 2) * dJ[3] + Ks(5, 2) * dJ[1] +
                                      F[0] * s[5] - F[4] * s[4]);
      // derivative with respect to the component (0, 1) of the deformation
      // gradient
      Kr(0, 3) =
          Ks(0, 3) * dJ[0] + icste * (Ks(3, 3) * dJ[4] + Ks(4, 3) * dJ[6] -
                                      F[2] * s[3] + F[7] * s[4]);
      Kr(1, 3) =
          Ks(1, 3) * dJ[1] + icste * (Ks(3, 3) * dJ[3] + Ks(5, 3) * dJ[8]);
      Kr(2, 3) = Ks(2, 3) * dJ[2] - F[4] * s[2] +
                 icste * (Ks(4, 3) * dJ[5] + Ks(5, 3) * dJ[7] + F[6] * s[5]);
      Kr(3, 3) =
          Ks(0, 3) * dJ[3] + icste * (Ks(3, 3) * dJ[1] + Ks(4, 3) * dJ[8]);
      Kr(4, 3) = Ks(1, 3) * dJ[4] - F[2] * s[1] +
                 icste * (Ks(3, 3) * dJ[0] + Ks(5, 3) * dJ[6] + F[7] * s[5]);
      Kr(5, 3) =
          Ks(0, 3) * dJ[5] + icste * (Ks(3, 3) * dJ[7] + Ks(4, 3) * dJ[2] -
                                      F[4] * s[4] + F[6] * s[3]);
      Kr(6, 3) = Ks(2, 3) * dJ[6] + F[7] * s[2] +
                 icste * (Ks(4, 3) * dJ[0] + Ks(5, 3) * dJ[4] - F[2] * s[5]);
      Kr(7, 3) = Ks(1, 3) * dJ[7] + F[6] * s[1] +
                 icste * (Ks(3, 3) * dJ[5] + Ks(5, 3) * dJ[2] - F[4] * s[5]);
      Kr(8, 3) =
          Ks(2, 3) * dJ[8] + icste * (Ks(4, 3) * dJ[3] + Ks(5, 3) * dJ[1]);
      // derivative with respect to the component (1, 0) of the deformation
      // gradient
      Kr(0, 4) =
          Ks(0, 4) * dJ[0] + icste * (Ks(3, 4) * dJ[4] + Ks(4, 4) * dJ[6]);
      Kr(1, 4) =
          Ks(1, 4) * dJ[1] + icste * (Ks(3, 4) * dJ[3] + Ks(5, 4) * dJ[8] -
                                      F[2] * s[3] + F[5] * s[5]);
      Kr(2, 4) = Ks(2, 4) * dJ[2] - F[3] * s[2] +
                 icste * (Ks(4, 4) * dJ[5] + Ks(5, 4) * dJ[7] + F[8] * s[4]);
      Kr(3, 4) = Ks(0, 4) * dJ[3] - F[2] * s[0] +
                 icste * (Ks(3, 4) * dJ[1] + Ks(4, 4) * dJ[8] + F[5] * s[4]);
      Kr(4, 4) =
          Ks(1, 4) * dJ[4] + icste * (Ks(3, 4) * dJ[0] + Ks(5, 4) * dJ[6]);
      Kr(5, 4) = Ks(0, 4) * dJ[5] + F[8] * s[0] +
                 icste * (Ks(3, 4) * dJ[7] + Ks(4, 4) * dJ[2] - F[3] * s[4]);
      Kr(6, 4) =
          Ks(2, 4) * dJ[6] + icste * (Ks(4, 4) * dJ[0] + Ks(5, 4) * dJ[4]);
      Kr(7, 4) =
          Ks(1, 4) * dJ[7] + icste * (Ks(3, 4) * dJ[5] + Ks(5, 4) * dJ[2] -
                                      F[3] * s[5] + F[8] * s[3]);
      Kr(8, 4) = Ks(2, 4) * dJ[8] + F[5] * s[2] +
                 icste * (Ks(4, 4) * dJ[3] + Ks(5, 4) * dJ[1] - F[2] * s[4]);
      // derivative with respect to the component (0, 2) of the deformation
      // gradient
      Kr(0, 5) =
          Ks(0, 5) * dJ[0] + icste * (Ks(3, 5) * dJ[4] + Ks(4, 5) * dJ[6] -
                                      F[1] * s[4] + F[8] * s[3]);
      Kr(1, 5) = Ks(1, 5) * dJ[1] - F[6] * s[1] +
                 icste * (Ks(3, 5) * dJ[3] + Ks(5, 5) * dJ[8] + F[4] * s[5]);
      Kr(2, 5) =
          Ks(2, 5) * dJ[2] + icste * (Ks(4, 5) * dJ[5] + Ks(5, 5) * dJ[7]);
      Kr(3, 5) =
          Ks(0, 5) * dJ[3] + icste * (Ks(3, 5) * dJ[1] + Ks(4, 5) * dJ[8] +
                                      F[4] * s[4] - F[6] * s[3]);
      Kr(4, 5) = Ks(1, 5) * dJ[4] + F[8] * s[1] +
                 icste * (Ks(3, 5) * dJ[0] + Ks(5, 5) * dJ[6] - F[1] * s[5]);
      Kr(5, 5) =
          Ks(0, 5) * dJ[5] + icste * (Ks(3, 5) * dJ[7] + Ks(4, 5) * dJ[2]);
      Kr(6, 5) = Ks(2, 5) * dJ[6] - F[1] * s[2] +
                 icste * (Ks(4, 5) * dJ[0] + Ks(5, 5) * dJ[4] + F[8] * s[5]);
      Kr(7, 5) =
          Ks(1, 5) * dJ[7] + icste * (Ks(3, 5) * dJ[5] + Ks(5, 5) * dJ[2]);
      Kr(8, 5) = Ks(2, 5) * dJ[8] + F[4] * s[2] +
                 icste * (Ks(4, 5) * dJ[3] + Ks(5, 5) * dJ[1] - F[6] * s[5]);
      // derivative with respect to the component (2, 0) of the deformation
      // gradient
      Kr(0, 6) =
          Ks(0, 6) * dJ[0] + icste * (Ks(3, 6) * dJ[4] + Ks(4, 6) * dJ[6]);
      Kr(1, 6) = Ks(1, 6) * dJ[1] - F[5] * s[1] +
                 icste * (Ks(3, 6) * dJ[3] + Ks(5, 6) * dJ[8] + F[7] * s[3]);
      Kr(2, 6) =
          Ks(2, 6) * dJ[2] + icste * (Ks(4, 6) * dJ[5] + Ks(5, 6) * dJ[7] -
                                      F[1] * s[4] + F[3] * s[5]);
      Kr(3, 6) = Ks(0, 6) * dJ[3] + F[7] * s[0] +
                 icste * (Ks(3, 6) * dJ[1] + Ks(4, 6) * dJ[8] - F[5] * s[3]);
      Kr(4, 6) =
          Ks(1, 6) * dJ[4] + icste * (Ks(3, 6) * dJ[0] + Ks(5, 6) * dJ[6]);
      Kr(5, 6) = Ks(0, 6) * dJ[5] - F[1] * s[0] +
                 icste * (Ks(3, 6) * dJ[7] + Ks(4, 6) * dJ[2] + F[3] * s[3]);
      Kr(6, 6) =
          Ks(2, 6) * dJ[6] + icste * (Ks(4, 6) * dJ[0] + Ks(5, 6) * dJ[4]);
      Kr(7, 6) = Ks(1, 6) * dJ[7] + F[3] * s[1] +
                 icste * (Ks(3, 6) * dJ[5] + Ks(5, 6) * dJ[2] - F[1] * s[3]);
      Kr(8, 6) =
          Ks(2, 6) * dJ[8] + icste * (Ks(4, 6) * dJ[3] + Ks(5, 6) * dJ[1] -
                                      F[5] * s[5] + F[7] * s[4]);
      // derivative with respect to the component (1, 2) of the deformation
      // gradient
      Kr(0, 7) = Ks(0, 7) * dJ[0] - F[8] * s[0] +
                 icste * (Ks(3, 7) * dJ[4] + Ks(4, 7) * dJ[6] + F[3] * s[4]);
      Kr(1, 7) =
          Ks(1, 7) * dJ[1] + icste * (Ks(3, 7) * dJ[3] + Ks(5, 7) * dJ[8] -
                                      F[0] * s[5] + F[6] * s[3]);
      Kr(2, 7) =
          Ks(2, 7) * dJ[2] + icste * (Ks(4, 7) * dJ[5] + Ks(5, 7) * dJ[7]);
      Kr(3, 7) = Ks(0, 7) * dJ[3] + F[6] * s[0] +
                 icste * (Ks(3, 7) * dJ[1] + Ks(4, 7) * dJ[8] - F[0] * s[4]);
      Kr(4, 7) =
          Ks(1, 7) * dJ[4] + icste * (Ks(3, 7) * dJ[0] + Ks(5, 7) * dJ[6] +
                                      F[3] * s[5] - F[8] * s[3]);
      Kr(5, 7) =
          Ks(0, 7) * dJ[5] + icste * (Ks(3, 7) * dJ[7] + Ks(4, 7) * dJ[2]);
      Kr(6, 7) = Ks(2, 7) * dJ[6] + F[3] * s[2] +
                 icste * (Ks(4, 7) * dJ[0] + Ks(5, 7) * dJ[4] - F[8] * s[4]);
      Kr(7, 7) =
          Ks(1, 7) * dJ[7] + icste * (Ks(3, 7) * dJ[5] + Ks(5, 7) * dJ[2]);
      Kr(8, 7) = Ks(2, 7) * dJ[8] - F[0] * s[2] +
                 icste * (Ks(4, 7) * dJ[3] + Ks(5, 7) * dJ[1] + F[6] * s[4]);
      // derivative with respect to the component (2, 1) of the deformation
      // gradient
      Kr(0, 8) = Ks(0, 8) * dJ[0] - F[7] * s[0] +
                 icste * (Ks(3, 8) * dJ[4] + Ks(4, 8) * dJ[6] + F[5] * s[3]);
      Kr(1, 8) =
          Ks(1, 8) * dJ[1] + icste * (Ks(3, 8) * dJ[3] + Ks(5, 8) * dJ[8]);
      Kr(2, 8) =
          Ks(2, 8) * dJ[2] + icste * (Ks(4, 8) * dJ[5] + Ks(5, 8) * dJ[7] -
                                      F[0] * s[5] + F[4] * s[4]);
      Kr(3, 8) =
          Ks(0, 8) * dJ[3] + icste * (Ks(3, 8) * dJ[1] + Ks(4, 8) * dJ[8]);
      Kr(4, 8) = Ks(1, 8) * dJ[4] + F[5] * s[1] +
                 icste * (Ks(3, 8) * dJ[0] + Ks(5, 8) * dJ[6] - F[7] * s[3]);
      Kr(5, 8) = Ks(0, 8) * dJ[5] + F[4] * s[0] +
                 icste * (Ks(3, 8) * dJ[7] + Ks(4, 8) * dJ[2] - F[0] * s[3]);
      Kr(6, 8) =
          Ks(2, 8) * dJ[6] + icste * (Ks(4, 8) * dJ[0] + Ks(5, 8) * dJ[4] +
                                      F[5] * s[5] - F[7] * s[4]);
      Kr(7, 8) = Ks(1, 8) * dJ[7] - F[0] * s[1] +
                 icste * (Ks(3, 8) * dJ[5] + Ks(5, 8) * dJ[2] + F[4] * s[3]);
      Kr(8, 8) =
          Ks(2, 8) * dJ[8] + icste * (Ks(4, 8) * dJ[3] + Ks(5, 8) * dJ[1]);
    }
  };  // end of struct DSIG_DF_to_DPK1_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Cauchy stress with respect to
   * the deformation gradient (DSIG_DF) to the derivative of the second
   * Piola-Kirchhoff stress with respect to the Green-Lagrange strain (DS_DEGL).
   * The result is computed column by column, i.e. component by component of the
   * Green-Lagrange strain. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DSIG_DF_to_DS_DEGL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DSIG_DF_to_DS_DEGL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 0) * iF[0];
        const auto a1 = Ks(1, 0) * iF[0];
        const auto a2 = Ks(2, 0) * iF[0];
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 0) = J * u0 * iF[0] - S[0] * iC[0];
        Kr(1, 0) = J * u1 * iF[1] + S[1] * iC[0];
        Kr(2, 0) = J * u2 * iF[2] + S[2] * iC[0];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 1) * iF[1];
        const auto a1 = Ks(1, 1) * iF[1];
        const auto a2 = Ks(2, 1) * iF[1];
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 1) = J * u0 * iF[0] + S[0] * iC[1];
        Kr(1, 1) = J * u1 * iF[1] - S[1] * iC[1];
        Kr(2, 1) = J * u2 * iF[2] + S[2] * iC[1];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 2) * iF[2];
        const auto a1 = Ks(1, 2) * iF[2];
        const auto a2 = Ks(2, 2) * iF[2];
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 2) = J * u0 * iF[0] + S[0] * iC[2];
        Kr(1, 2) = J * u1 * iF[1] + S[1] * iC[2];
        Kr(2, 2) = J * u2 * iF[2] - S[2] * iC[2];
      }
    }
  };  // end of struct DSIG_DF_to_DS_DEGL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DSIG_DF_to_DS_DEGL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 0) * iF[0] + Ks(0, 4) * iF[3];
        const auto a1 = Ks(1, 0) * iF[0] + Ks(1, 4) * iF[3];
        const auto a2 = Ks(2, 0) * iF[0] + Ks(2, 4) * iF[3];
        const auto a3 = icste * (Ks(3, 0) * iF[0] + Ks(3, 4) * iF[3]);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 0) = J * (u0 * iF[0] + u3 * iF[3]) - S[0] * iC[0];
        Kr(1, 0) = J * (u1 * iF[1] + u4 * iF[4]) + S[1] * iC[0] - S[3] * iC[3];
        Kr(2, 0) = J * u2 * iF[2] + S[2] * iC[0];
        Kr(3, 0) = J * cste * (u0 * iF[4] + u3 * iF[1]) - S[0] * iC[3];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 1) * iF[1] + Ks(0, 3) * iF[4];
        const auto a1 = Ks(1, 1) * iF[1] + Ks(1, 3) * iF[4];
        const auto a2 = Ks(2, 1) * iF[1] + Ks(2, 3) * iF[4];
        const auto a3 = icste * (Ks(3, 1) * iF[1] + Ks(3, 3) * iF[4]);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 1) = J * (u0 * iF[0] + u3 * iF[3]) + S[0] * iC[1] - S[3] * iC[3];
        Kr(1, 1) = J * (u1 * iF[1] + u4 * iF[4]) - S[1] * iC[1];
        Kr(2, 1) = J * u2 * iF[2] + S[2] * iC[1];
        Kr(3, 1) = J * cste * (u0 * iF[4] + u3 * iF[1]) - S[1] * iC[3];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 2) * iF[2];
        const auto a1 = Ks(1, 2) * iF[2];
        const auto a2 = Ks(2, 2) * iF[2];
        const auto a3 = icste * Ks(3, 2) * iF[2];
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 2) = J * (u0 * iF[0] + u3 * iF[3]) + S[0] * iC[2];
        Kr(1, 2) = J * (u1 * iF[1] + u4 * iF[4]) + S[1] * iC[2];
        Kr(2, 2) = J * u2 * iF[2] - S[2] * iC[2];
        Kr(3, 2) = J * cste * (u0 * iF[4] + u3 * iF[1]) + S[3] * iC[2];
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto a0 = icste * (Ks(0, 0) * iF[4] + Ks(0, 1) * iF[3] +
                                 Ks(0, 3) * iF[0] + Ks(0, 4) * iF[1]);
        const auto a1 = icste * (Ks(1, 0) * iF[4] + Ks(1, 1) * iF[3] +
                                 Ks(1, 3) * iF[0] + Ks(1, 4) * iF[1]);
        const auto a2 = icste * (Ks(2, 0) * iF[4] + Ks(2, 1) * iF[3] +
                                 Ks(2, 3) * iF[0] + Ks(2, 4) * iF[1]);
        const auto a3 = (Ks(3, 0) * iF[4] + Ks(3, 1) * iF[3] +
                         Ks(3, 3) * iF[0] + Ks(3, 4) * iF[1]) /
                        2;
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 3) = J * (u0 * iF[0] + u3 * iF[3]) - S[3] * iC[0];
        Kr(1, 3) = J * (u1 * iF[1] + u4 * iF[4]) - S[3] * iC[1];
        Kr(2, 3) = J * u2 * iF[2] + S[2] * iC[3];
        Kr(3, 3) =
            J * cste * (u0 * iF[4] + u3 * iF[1]) - S[0] * iC[1] - S[1] * iC[0];
      }
    }
  };  // end of struct DSIG_DF_to_DS_DEGL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DSIG_DF_to_DS_DEGL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 0) * iF[0] + Ks(0, 4) * iF[3] + Ks(0, 6) * iF[5];
        const auto a1 = Ks(1, 0) * iF[0] + Ks(1, 4) * iF[3] + Ks(1, 6) * iF[5];
        const auto a2 = Ks(2, 0) * iF[0] + Ks(2, 4) * iF[3] + Ks(2, 6) * iF[5];
        const auto a3 =
            icste * (Ks(3, 0) * iF[0] + Ks(3, 4) * iF[3] + Ks(3, 6) * iF[5]);
        const auto a4 =
            icste * (Ks(4, 0) * iF[0] + Ks(4, 4) * iF[3] + Ks(4, 6) * iF[5]);
        const auto a5 =
            icste * (Ks(5, 0) * iF[0] + Ks(5, 4) * iF[3] + Ks(5, 6) * iF[5]);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 0) = J * (u0 * iF[0] + u3 * iF[3] + u5 * iF[5]) - S[0] * iC[0];
        Kr(1, 0) = J * (u1 * iF[1] + u4 * iF[4] + u7 * iF[7]) + S[1] * iC[0] -
                   S[3] * iC[3];
        Kr(2, 0) = J * (u2 * iF[2] + u6 * iF[6] + u8 * iF[8]) + S[2] * iC[0] -
                   S[4] * iC[4];
        Kr(3, 0) =
            J * cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) - S[0] * iC[3];
        Kr(4, 0) =
            J * cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) - S[0] * iC[4];
        Kr(5, 0) = J * cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[3] * iC[4] + S[4] * iC[3]) + S[5] * iC[0];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 1) * iF[1] + Ks(0, 3) * iF[4] + Ks(0, 8) * iF[7];
        const auto a1 = Ks(1, 1) * iF[1] + Ks(1, 3) * iF[4] + Ks(1, 8) * iF[7];
        const auto a2 = Ks(2, 1) * iF[1] + Ks(2, 3) * iF[4] + Ks(2, 8) * iF[7];
        const auto a3 =
            icste * (Ks(3, 1) * iF[1] + Ks(3, 3) * iF[4] + Ks(3, 8) * iF[7]);
        const auto a4 =
            icste * (Ks(4, 1) * iF[1] + Ks(4, 3) * iF[4] + Ks(4, 8) * iF[7]);
        const auto a5 =
            icste * (Ks(5, 1) * iF[1] + Ks(5, 3) * iF[4] + Ks(5, 8) * iF[7]);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 1) = J * (u0 * iF[0] + u3 * iF[3] + u5 * iF[5]) + S[0] * iC[1] -
                   S[3] * iC[3];
        Kr(1, 1) = J * (u1 * iF[1] + u4 * iF[4] + u7 * iF[7]) - S[1] * iC[1];
        Kr(2, 1) = J * (u2 * iF[2] + u6 * iF[6] + u8 * iF[8]) + S[2] * iC[1] -
                   S[5] * iC[5];
        Kr(3, 1) =
            J * cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) - S[1] * iC[3];
        Kr(4, 1) = J * cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[3] * iC[5] + S[5] * iC[3]) + S[4] * iC[1];
        Kr(5, 1) =
            J * cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) - S[1] * iC[5];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 2) * iF[2] + Ks(0, 5) * iF[6] + Ks(0, 7) * iF[8];
        const auto a1 = Ks(1, 2) * iF[2] + Ks(1, 5) * iF[6] + Ks(1, 7) * iF[8];
        const auto a2 = Ks(2, 2) * iF[2] + Ks(2, 5) * iF[6] + Ks(2, 7) * iF[8];
        const auto a3 =
            icste * (Ks(3, 2) * iF[2] + Ks(3, 5) * iF[6] + Ks(3, 7) * iF[8]);
        const auto a4 =
            icste * (Ks(4, 2) * iF[2] + Ks(4, 5) * iF[6] + Ks(4, 7) * iF[8]);
        const auto a5 =
            icste * (Ks(5, 2) * iF[2] + Ks(5, 5) * iF[6] + Ks(5, 7) * iF[8]);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 2) = J * (u0 * iF[0] + u3 * iF[3] + u5 * iF[5]) + S[0] * iC[2] -
                   S[4] * iC[4];
        Kr(1, 2) = J * (u1 * iF[1] + u4 * iF[4] + u7 * iF[7]) + S[1] * iC[2] -
                   S[5] * iC[5];
        Kr(2, 2) = J * (u2 * iF[2] + u6 * iF[6] + u8 * iF[8]) - S[2] * iC[2];
        Kr(3, 2) = J * cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) +
                   S[3] * iC[2] - icste * (S[4] * iC[5] + S[5] * iC[4]);
        Kr(4, 2) =
            J * cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) - S[2] * iC[4];
        Kr(5, 2) =
            J * cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) - S[2] * iC[5];
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto a0 =
            icste * (Ks(0, 0) * iF[4] + Ks(0, 1) * iF[3] + Ks(0, 3) * iF[0] +
                     Ks(0, 4) * iF[1] + Ks(0, 6) * iF[7] + Ks(0, 8) * iF[5]);
        const auto a1 =
            icste * (Ks(1, 0) * iF[4] + Ks(1, 1) * iF[3] + Ks(1, 3) * iF[0] +
                     Ks(1, 4) * iF[1] + Ks(1, 6) * iF[7] + Ks(1, 8) * iF[5]);
        const auto a2 =
            icste * (Ks(2, 0) * iF[4] + Ks(2, 1) * iF[3] + Ks(2, 3) * iF[0] +
                     Ks(2, 4) * iF[1] + Ks(2, 6) * iF[7] + Ks(2, 8) * iF[5]);
        const auto a3 =
            (Ks(3, 0) * iF[4] + Ks(3, 1) * iF[3] + Ks(3, 3) * iF[0] +
             Ks(3, 4) * iF[1] + Ks(3, 6) * iF[7] + Ks(3, 8) * iF[5]) /
            2;
        const auto a4 =
            (Ks(4, 0) * iF[4] + Ks(4, 1) * iF[3] + Ks(4, 3) * iF[0] +
             Ks(4, 4) * iF[1] + Ks(4, 6) * iF[7] + Ks(4, 8) * iF[5]) /
            2;
        const auto a5 =
            (Ks(5, 0) * iF[4] + Ks(5, 1) * iF[3] + Ks(5, 3) * iF[0] +
             Ks(5, 4) * iF[1] + Ks(5, 6) * iF[7] + Ks(5, 8) * iF[5]) /
            2;
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 3) = J * (u0 * iF[0] + u3 * iF[3] + u5 * iF[5]) - S[3] * iC[0];
        Kr(1, 3) = J * (u1 * iF[1] + u4 * iF[4] + u7 * iF[7]) - S[3] * iC[1];
        Kr(2, 3) = J * (u2 * iF[2] + u6 * iF[6] + u8 * iF[8]) + S[2] * iC[3] -
                   icste * (S[4] * iC[5] + S[5] * iC[4]);
        Kr(3, 3) = J * cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   S[0] * iC[1] - S[1] * iC[0];
        Kr(4, 3) = J * cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[0] * iC[5] + S[5] * iC[0]) -
                   (S[3] * iC[4] - S[4] * iC[3]) / 2;
        Kr(5, 3) = J * cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[1] * iC[4] + S[4] * iC[1]) -
                   (S[3] * iC[5] - S[5] * iC[3]) / 2;
      }
      {
        // column associated with the component (0, 2) of the Green-Lagrange
        // strain
        const auto a0 =
            icste * (Ks(0, 0) * iF[6] + Ks(0, 2) * iF[5] + Ks(0, 4) * iF[8] +
                     Ks(0, 5) * iF[0] + Ks(0, 6) * iF[2] + Ks(0, 7) * iF[3]);
        const auto a1 =
            icste * (Ks(1, 0) * iF[6] + Ks(1, 2) * iF[5] + Ks(1, 4) * iF[8] +
                     Ks(1, 5) * iF[0] + Ks(1, 6) * iF[2] + Ks(1, 7) * iF[3]);
        const auto a2 =
            icste * (Ks(2, 0) * iF[6] + Ks(2, 2) * iF[5] + Ks(2, 4) * iF[8] +
                     Ks(2, 5) * iF[0] + Ks(2, 6) * iF[2] + Ks(2, 7) * iF[3]);
        const auto a3 =
            (Ks(3, 0) * iF[6] + Ks(3, 2) * iF[5] + Ks(3, 4) * iF[8] +
             Ks(3, 5) * iF[0] + Ks(3, 6) * iF[2] + Ks(3, 7) * iF[3]) /
            2;
        const auto a4 =
            (Ks(4, 0) * iF[6] + Ks(4, 2) * iF[5] + Ks(4, 4) * iF[8] +
             Ks(4, 5) * iF[0] + Ks(4, 6) * iF[2] + Ks(4, 7) * iF[3]) /
            2;
        const auto a5 =
            (Ks(5, 0) * iF[6] + Ks(5, 2) * iF[5] + Ks(5, 4) * iF[8] +
             Ks(5, 5) * iF[0] + Ks(5, 6) * iF[2] + Ks(5, 7) * iF[3]) /
            2;
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 4) = J * (u0 * iF[0] + u3 * iF[3] + u5 * iF[5]) - S[4] * iC[0];
        Kr(1, 4) = J * (u1 * iF[1] + u4 * iF[4] + u7 * iF[7]) + S[1] * iC[4] -
                   icste * (S[3] * iC[5] + S[5] * iC[3]);
        Kr(2, 4) = J * (u2 * iF[2] + u6 * iF[6] + u8 * iF[8]) - S[4] * iC[2];
        Kr(3, 4) = J * cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[0] * iC[5] + S[5] * iC[0]) +
                   (S[3] * iC[4] - S[4] * iC[3]) / 2;
        Kr(4, 4) = J * cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   S[0] * iC[2] - S[2] * iC[0];
        Kr(5, 4) = J * cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[2] * iC[3] + S[3] * iC[2]) -
                   (S[4] * iC[5] - S[5] * iC[4]) / 2;
      }
      {
        // column associated with the component (1, 2) of the Green-Lagrange
        // strain
        const auto a0 =
            icste * (Ks(0, 1) * iF[8] + Ks(0, 2) * iF[7] + Ks(0, 3) * iF[6] +
                     Ks(0, 5) * iF[4] + Ks(0, 7) * iF[1] + Ks(0, 8) * iF[2]);
        const auto a1 =
            icste * (Ks(1, 1) * iF[8] + Ks(1, 2) * iF[7] + Ks(1, 3) * iF[6] +
                     Ks(1, 5) * iF[4] + Ks(1, 7) * iF[1] + Ks(1, 8) * iF[2]);
        const auto a2 =
            icste * (Ks(2, 1) * iF[8] + Ks(2, 2) * iF[7] + Ks(2, 3) * iF[6] +
                     Ks(2, 5) * iF[4] + Ks(2, 7) * iF[1] + Ks(2, 8) * iF[2]);
        const auto a3 =
            (Ks(3, 1) * iF[8] + Ks(3, 2) * iF[7] + Ks(3, 3) * iF[6] +
             Ks(3, 5) * iF[4] + Ks(3, 7) * iF[1] + Ks(3, 8) * iF[2]) /
            2;
        const auto a4 =
            (Ks(4, 1) * iF[8] + Ks(4, 2) * iF[7] + Ks(4, 3) * iF[6] +
             Ks(4, 5) * iF[4] + Ks(4, 7) * iF[1] + Ks(4, 8) * iF[2]) /
            2;
        const auto a5 =
            (Ks(5, 1) * iF[8] + Ks(5, 2) * iF[7] + Ks(5, 3) * iF[6] +
             Ks(5, 5) * iF[4] + Ks(5, 7) * iF[1] + Ks(5, 8) * iF[2]) /
            2;
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 5) = J * (u0 * iF[0] + u3 * iF[3] + u5 * iF[5]) + S[0] * iC[5] -
                   icste * (S[3] * iC[4] + S[4] * iC[3]);
        Kr(1, 5) = J * (u1 * iF[1] + u4 * iF[4] + u7 * iF[7]) - S[5] * iC[1];
        Kr(2, 5) = J * (u2 * iF[2] + u6 * iF[6] + u8 * iF[8]) - S[5] * iC[2];
        Kr(3, 5) = J * cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[1] * iC[4] + S[4] * iC[1]) +
                   (S[3] * iC[5] - S[5] * iC[3]) / 2;
        Kr(4, 5) = J * cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[2] * iC[3] + S[3] * iC[2]) +
                   (S[4] * iC[5] - S[5] * iC[4]) / 2;
        Kr(5, 5) = J * cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   S[1] * iC[2] - S[2] * iC[1];
      }
    }
  };  // end of struct DSIG_DF_to_DS_DEGL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Cauchy stress with respect to
   * the deformation gradient (DSIG_DF) to the moduli associated with the
   * Jaumann rate of the Kirchhoff stress divided by the change of volume
   * (ABAQUS).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and ABAQUS relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-w\,\tau+\tau\,w\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DSIG_DF_to_ABAQUS_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DSIG_DF_to_ABAQUS_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] + s[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + s[1];
      Kr(2, 0) = Ks(2, 0) * F[0] + s[2];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + s[0];
      Kr(1, 1) = Ks(1, 1) * F[1] + s[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + s[2];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2] + s[0];
      Kr(1, 2) = Ks(1, 2) * F[2] + s[1];
      Kr(2, 2) = Ks(2, 2) * F[2] + s[2];
    }
  };  // end of struct DSIG_DF_to_ABAQUS_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DSIG_DF_to_ABAQUS_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] + Ks(0, 3) * F[3] + s[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * F[3] + s[1];
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * F[3] + s[2];
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * F[3] + s[3];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 4) * F[4] + s[0];
      Kr(1, 1) = Ks(1, 1) * F[1] + Ks(1, 4) * F[4] + s[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 4) * F[4] + s[2];
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 4) * F[4] + s[3];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2] + s[0];
      Kr(1, 2) = Ks(1, 2) * F[2] + s[1];
      Kr(2, 2) = Ks(2, 2) * F[2] + s[2];
      Kr(3, 2) = Ks(3, 2) * F[2] + s[3];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = icste * (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                          Ks(0, 4) * F[0]);
      Kr(1, 3) = icste * (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                          Ks(1, 4) * F[0]);
      Kr(2, 3) = icste * (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                          Ks(2, 4) * F[0]);
      Kr(3, 3) = icste * (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                          Ks(3, 4) * F[0]);
    }
  };  // end of struct DSIG_DF_to_ABAQUS_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DSIG_DF_to_ABAQUS_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] + Ks(0, 3) * F[3] + Ks(0, 5) * F[5] + s[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * F[3] + Ks(1, 5) * F[5] + s[1];
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * F[3] + Ks(2, 5) * F[5] + s[2];
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * F[3] + Ks(3, 5) * F[5] + s[3];
      Kr(4, 0) = Ks(4, 0) * F[0] + Ks(4, 3) * F[3] + Ks(4, 5) * F[5] + s[4];
      Kr(5, 0) = Ks(5, 0) * F[0] + Ks(5, 3) * F[3] + Ks(5, 5) * F[5] + s[5];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 4) * F[4] + Ks(0, 7) * F[7] + s[0];
      Kr(1, 1) = Ks(1, 1) * F[1] + Ks(1, 4) * F[4] + Ks(1, 7) * F[7] + s[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 4) * F[4] + Ks(2, 7) * F[7] + s[2];
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 4) * F[4] + Ks(3, 7) * F[7] + s[3];
      Kr(4, 1) = Ks(4, 1) * F[1] + Ks(4, 4) * F[4] + Ks(4, 7) * F[7] + s[4];
      Kr(5, 1) = Ks(5, 1) * F[1] + Ks(5, 4) * F[4] + Ks(5, 7) * F[7] + s[5];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2] + Ks(0, 6) * F[6] + Ks(0, 8) * F[8] + s[0];
      Kr(1, 2) = Ks(1, 2) * F[2] + Ks(1, 6) * F[6] + Ks(1, 8) * F[8] + s[1];
      Kr(2, 2) = Ks(2, 2) * F[2] + Ks(2, 6) * F[6] + Ks(2, 8) * F[8] + s[2];
      Kr(3, 2) = Ks(3, 2) * F[2] + Ks(3, 6) * F[6] + Ks(3, 8) * F[8] + s[3];
      Kr(4, 2) = Ks(4, 2) * F[2] + Ks(4, 6) * F[6] + Ks(4, 8) * F[8] + s[4];
      Kr(5, 2) = Ks(5, 2) * F[2] + Ks(5, 6) * F[6] + Ks(5, 8) * F[8] + s[5];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = icste * (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                          Ks(0, 4) * F[0] + Ks(0, 5) * F[7] + Ks(0, 7) * F[5]);
      Kr(1, 3) = icste * (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                          Ks(1, 4) * F[0] + Ks(1, 5) * F[7] + Ks(1, 7) * F[5]);
      Kr(2, 3) = icste * (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                          Ks(2, 4) * F[0] + Ks(2, 5) * F[7] + Ks(2, 7) * F[5]);
      Kr(3, 3) = icste * (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                          Ks(3, 4) * F[0] + Ks(3, 5) * F[7] + Ks(3, 7) * F[5]);
      Kr(4, 3) = icste * (Ks(4, 0) * F[4] + Ks(4, 1) * F[3] + Ks(4, 3) * F[1] +
                          Ks(4, 4) * F[0] + Ks(4, 5) * F[7] + Ks(4, 7) * F[5]);
      Kr(5, 3) = icste * (Ks(5, 0) * F[4] + Ks(5, 1) * F[3] + Ks(5, 3) * F[1] +
                          Ks(5, 4) * F[0] + Ks(5, 5) * F[7] + Ks(5, 7) * F[5]);
      // column associated with the component (0, 2) of the rate of deformation
      Kr(0, 4) = icste * (Ks(0, 0) * F[6] + Ks(0, 2) * F[5] + Ks(0, 3) * F[8] +
                          Ks(0, 5) * F[2] + Ks(0, 6) * F[0] + Ks(0, 8) * F[3]);
      Kr(1, 4) = icste * (Ks(1, 0) * F[6] + Ks(1, 2) * F[5] + Ks(1, 3) * F[8] +
                          Ks(1, 5) * F[2] + Ks(1, 6) * F[0] + Ks(1, 8) * F[3]);
      Kr(2, 4) = icste * (Ks(2, 0) * F[6] + Ks(2, 2) * F[5] + Ks(2, 3) * F[8] +
                          Ks(2, 5) * F[2] + Ks(2, 6) * F[0] + Ks(2, 8) * F[3]);
      Kr(3, 4) = icste * (Ks(3, 0) * F[6] + Ks(3, 2) * F[5] + Ks(3, 3) * F[8] +
                          Ks(3, 5) * F[2] + Ks(3, 6) * F[0] + Ks(3, 8) * F[3]);
      Kr(4, 4) = icste * (Ks(4, 0) * F[6] + Ks(4, 2) * F[5] + Ks(4, 3) * F[8] +
                          Ks(4, 5) * F[2] + Ks(4, 6) * F[0] + Ks(4, 8) * F[3]);
      Kr(5, 4) = icste * (Ks(5, 0) * F[6] + Ks(5, 2) * F[5] + Ks(5, 3) * F[8] +
                          Ks(5, 5) * F[2] + Ks(5, 6) * F[0] + Ks(5, 8) * F[3]);
      // column associated with the component (1, 2) of the rate of deformation
      Kr(0, 5) = icste * (Ks(0, 1) * F[8] + Ks(0, 2) * F[7] + Ks(0, 4) * F[6] +
                          Ks(0, 6) * F[4] + Ks(0, 7) * F[2] + Ks(0, 8) * F[1]);
      Kr(1, 5) = icste * (Ks(1, 1) * F[8] + Ks(1, 2) * F[7] + Ks(1, 4) * F[6] +
                          Ks(1, 6) * F[4] + Ks(1, 7) * F[2] + Ks(1, 8) * F[1]);
      Kr(2, 5) = icste * (Ks(2, 1) * F[8] + Ks(2, 2) * F[7] + Ks(2, 4) * F[6] +
                          Ks(2, 6) * F[4] + Ks(2, 7) * F[2] + Ks(2, 8) * F[1]);
      Kr(3, 5) = icste * (Ks(3, 1) * F[8] + Ks(3, 2) * F[7] + Ks(3, 4) * F[6] +
                          Ks(3, 6) * F[4] + Ks(3, 7) * F[2] + Ks(3, 8) * F[1]);
      Kr(4, 5) = icste * (Ks(4, 1) * F[8] + Ks(4, 2) * F[7] + Ks(4, 4) * F[6] +
                          Ks(4, 6) * F[4] + Ks(4, 7) * F[2] + Ks(4, 8) * F[1]);
      Kr(5, 5) = icste * (Ks(5, 1) * F[8] + Ks(5, 2) * F[7] + Ks(5, 4) * F[6] +
                          Ks(5, 6) * F[4] + Ks(5, 7) * F[2] + Ks(5, 8) * F[1]);
    }
  };  // end of struct DSIG_DF_to_ABAQUS_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Cauchy stress with respect to
   * the deformation gradient (DSIG_DF) to the moduli associated with the
   * Truesdell rate of the Cauchy stress (C_TRUESDELL).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and C_TRUESDELL relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DSIG_DF_to_C_TRUESDELL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DSIG_DF_to_C_TRUESDELL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] - s[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + s[1];
      Kr(2, 0) = Ks(2, 0) * F[0] + s[2];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + s[0];
      Kr(1, 1) = Ks(1, 1) * F[1] - s[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + s[2];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2] + s[0];
      Kr(1, 2) = Ks(1, 2) * F[2] + s[1];
      Kr(2, 2) = Ks(2, 2) * F[2] - s[2];
    }
  };  // end of struct DSIG_DF_to_C_TRUESDELL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DSIG_DF_to_C_TRUESDELL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] + Ks(0, 3) * F[3] - s[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * F[3] + s[1];
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * F[3] + s[2];
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * F[3];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 4) * F[4] + s[0];
      Kr(1, 1) = Ks(1, 1) * F[1] + Ks(1, 4) * F[4] - s[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 4) * F[4] + s[2];
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 4) * F[4];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2] + s[0];
      Kr(1, 2) = Ks(1, 2) * F[2] + s[1];
      Kr(2, 2) = Ks(2, 2) * F[2] - s[2];
      Kr(3, 2) = Ks(3, 2) * F[2] + s[3];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = icste * (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                          Ks(0, 4) * F[0]) -
                 s[3];
      Kr(1, 3) = icste * (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                          Ks(1, 4) * F[0]) -
                 s[3];
      Kr(2, 3) = icste * (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                          Ks(2, 4) * F[0]);
      Kr(3, 3) = icste * (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                          Ks(3, 4) * F[0]) -
                 s[0] - s[1];
    }
  };  // end of struct DSIG_DF_to_C_TRUESDELL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DSIG_DF_to_C_TRUESDELL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] + Ks(0, 3) * F[3] + Ks(0, 5) * F[5] - s[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * F[3] + Ks(1, 5) * F[5] + s[1];
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * F[3] + Ks(2, 5) * F[5] + s[2];
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * F[3] + Ks(3, 5) * F[5];
      Kr(4, 0) = Ks(4, 0) * F[0] + Ks(4, 3) * F[3] + Ks(4, 5) * F[5];
      Kr(5, 0) = Ks(5, 0) * F[0] + Ks(5, 3) * F[3] + Ks(5, 5) * F[5] + s[5];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 4) * F[4] + Ks(0, 7) * F[7] + s[0];
      Kr(1, 1) = Ks(1, 1) * F[1] + Ks(1, 4) * F[4] + Ks(1, 7) * F[7] - s[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 4) * F[4] + Ks(2, 7) * F[7] + s[2];
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 4) * F[4] + Ks(3, 7) * F[7];
      Kr(4, 1) = Ks(4, 1) * F[1] + Ks(4, 4) * F[4] + Ks(4, 7) * F[7] + s[4];
      Kr(5, 1) = Ks(5, 1) * F[1] + Ks(5, 4) * F[4] + Ks(5, 7) * F[7];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2] + Ks(0, 6) * F[6] + Ks(0, 8) * F[8] + s[0];
      Kr(1, 2) = Ks(1, 2) * F[2] + Ks(1, 6) * F[6] + Ks(1, 8) * F[8] + s[1];
      Kr(2, 2) = Ks(2, 2) * F[2] + Ks(2, 6) * F[6] + Ks(2, 8) * F[8] - s[2];
      Kr(3, 2) = Ks(3, 2) * F[2] + Ks(3, 6) * F[6] + Ks(3, 8) * F[8] + s[3];
      Kr(4, 2) = Ks(4, 2) * F[2] + Ks(4, 6) * F[6] + Ks(4, 8) * F[8];
      Kr(5, 2) = Ks(5, 2) * F[2] + Ks(5, 6) * F[6] + Ks(5, 8) * F[8];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = icste * (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                          Ks(0, 4) * F[0] + Ks(0, 5) * F[7] + Ks(0, 7) * F[5]) -
                 s[3];
      Kr(1, 3) = icste * (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                          Ks(1, 4) * F[0] + Ks(1, 5) * F[7] + Ks(1, 7) * F[5]) -
                 s[3];
      Kr(2, 3) = icste * (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                          Ks(2, 4) * F[0] + Ks(2, 5) * F[7] + Ks(2, 7) * F[5]);
      Kr(3, 3) = icste * (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                          Ks(3, 4) * F[0] + Ks(3, 5) * F[7] + Ks(3, 7) * F[5]) -
                 s[0] - s[1];
      Kr(4, 3) =
          icste * (Ks(4, 0) * F[4] + Ks(4, 1) * F[3] + Ks(4, 3) * F[1] +
                   Ks(4, 4) * F[0] + Ks(4, 5) * F[7] + Ks(4, 7) * F[5] - s[5]);
      Kr(5, 3) =
          icste * (Ks(5, 0) * F[4] + Ks(5, 1) * F[3] + Ks(5, 3) * F[1] +
                   Ks(5, 4) * F[0] + Ks(5, 5) * F[7] + Ks(5, 7) * F[5] - s[4]);
      // column associated with the component (0, 2) of the rate of deformation
      Kr(0, 4) = icste * (Ks(0, 0) * F[6] + Ks(0, 2) * F[5] + Ks(0, 3) * F[8] +
                          Ks(0, 5) * F[2] + Ks(0, 6) * F[0] + Ks(0, 8) * F[3]) -
                 s[4];
      Kr(1, 4) = icste * (Ks(1, 0) * F[6] + Ks(1, 2) * F[5] + Ks(1, 3) * F[8] +
                          Ks(1, 5) * F[2] + Ks(1, 6) * F[0] + Ks(1, 8) * F[3]);
      Kr(2, 4) = icste * (Ks(2, 0) * F[6] + Ks(2, 2) * F[5] + Ks(2, 3) * F[8] +
                          Ks(2, 5) * F[2] + Ks(2, 6) * F[0] + Ks(2, 8) * F[3]) -
                 s[4];
      Kr(3, 4) =
          icste * (Ks(3, 0) * F[6] + Ks(3, 2) * F[5] + Ks(3, 3) * F[8] +
                   Ks(3, 5) * F[2] + Ks(3, 6) * F[0] + Ks(3, 8) * F[3] - s[5]);
      Kr(4, 4) = icste * (Ks(4, 0) * F[6] + Ks(4, 2) * F[5] + Ks(4, 3) * F[8] +
                          Ks(4, 5) * F[2] + Ks(4, 6) * F[0] + Ks(4, 8) * F[3]) -
                 s[0] - s[2];
      Kr(5, 4) =
          icste * (Ks(5, 0) * F[6] + Ks(5, 2) * F[5] + Ks(5, 3) * F[8] +
                   Ks(5, 5) * F[2] + Ks(5, 6) * F[0] + Ks(5, 8) * F[3] - s[3]);
      // column associated with the component (1, 2) of the rate of deformation
      Kr(0, 5) = icste * (Ks(0, 1) * F[8] + Ks(0, 2) * F[7] + Ks(0, 4) * F[6] +
                          Ks(0, 6) * F[4] + Ks(0, 7) * F[2] + Ks(0, 8) * F[1]);
      Kr(1, 5) = icste * (Ks(1, 1) * F[8] + Ks(1, 2) * F[7] + Ks(1, 4) * F[6] +
                          Ks(1, 6) * F[4] + Ks(1, 7) * F[2] + Ks(1, 8) * F[1]) -
                 s[5];
      Kr(2, 5) = icste * (Ks(2, 1) * F[8] + Ks(2, 2) * F[7] + Ks(2, 4) * F[6] +
                          Ks(2, 6) * F[4] + Ks(2, 7) * F[2] + Ks(2, 8) * F[1]) -
                 s[5];
      Kr(3, 5) =
          icste * (Ks(3, 1) * F[8] + Ks(3, 2) * F[7] + Ks(3, 4) * F[6] +
                   Ks(3, 6) * F[4] + Ks(3, 7) * F[2] + Ks(3, 8) * F[1] - s[4]);
      Kr(4, 5) =
          icste * (Ks(4, 1) * F[8] + Ks(4, 2) * F[7] + Ks(4, 4) * F[6] +
                   Ks(4, 6) * F[4] + Ks(4, 7) * F[2] + Ks(4, 8) * F[1] - s[3]);
      Kr(5, 5) = icste * (Ks(5, 1) * F[8] + Ks(5, 2) * F[7] + Ks(5, 4) * F[6] +
                          Ks(5, 6) * F[4] + Ks(5, 7) * F[2] + Ks(5, 8) * F[1]) -
                 s[1] - s[2];
    }
  };  // end of struct DSIG_DF_to_C_TRUESDELL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Cauchy stress with respect to
   * the deformation gradient increment (DSIG_DDF) to the derivative of the
   * Cauchy stress with respect to the deformation gradient (DSIG_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DSIG_DDF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * and DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DSIG_DDF_to_DSIG_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DSIG_DDF_to_DSIG_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * iF0[0];
      Kr(0, 1) = Ks(0, 1) * iF0[1];
      Kr(0, 2) = Ks(0, 2) * iF0[2];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * iF0[0];
      Kr(1, 1) = Ks(1, 1) * iF0[1];
      Kr(1, 2) = Ks(1, 2) * iF0[2];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * iF0[0];
      Kr(2, 1) = Ks(2, 1) * iF0[1];
      Kr(2, 2) = Ks(2, 2) * iF0[2];
    }
  };  // end of struct DSIG_DDF_to_DSIG_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DSIG_DDF_to_DSIG_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * iF0[0] + Ks(0, 3) * iF0[3];
      Kr(0, 1) = Ks(0, 1) * iF0[1] + Ks(0, 4) * iF0[4];
      Kr(0, 2) = Ks(0, 2) * iF0[2];
      Kr(0, 3) = Ks(0, 0) * iF0[4] + Ks(0, 3) * iF0[1];
      Kr(0, 4) = Ks(0, 1) * iF0[3] + Ks(0, 4) * iF0[0];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * iF0[0] + Ks(1, 3) * iF0[3];
      Kr(1, 1) = Ks(1, 1) * iF0[1] + Ks(1, 4) * iF0[4];
      Kr(1, 2) = Ks(1, 2) * iF0[2];
      Kr(1, 3) = Ks(1, 0) * iF0[4] + Ks(1, 3) * iF0[1];
      Kr(1, 4) = Ks(1, 1) * iF0[3] + Ks(1, 4) * iF0[0];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * iF0[0] + Ks(2, 3) * iF0[3];
      Kr(2, 1) = Ks(2, 1) * iF0[1] + Ks(2, 4) * iF0[4];
      Kr(2, 2) = Ks(2, 2) * iF0[2];
      Kr(2, 3) = Ks(2, 0) * iF0[4] + Ks(2, 3) * iF0[1];
      Kr(2, 4) = Ks(2, 1) * iF0[3] + Ks(2, 4) * iF0[0];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * iF0[0] + Ks(3, 3) * iF0[3];
      Kr(3, 1) = Ks(3, 1) * iF0[1] + Ks(3, 4) * iF0[4];
      Kr(3, 2) = Ks(3, 2) * iF0[2];
      Kr(3, 3) = Ks(3, 0) * iF0[4] + Ks(3, 3) * iF0[1];
      Kr(3, 4) = Ks(3, 1) * iF0[3] + Ks(3, 4) * iF0[0];
    }
  };  // end of struct DSIG_DDF_to_DSIG_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DSIG_DDF_to_DSIG_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Cauchy stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * iF0[0] + Ks(0, 3) * iF0[3] + Ks(0, 5) * iF0[5];
      Kr(0, 1) = Ks(0, 1) * iF0[1] + Ks(0, 4) * iF0[4] + Ks(0, 7) * iF0[7];
      Kr(0, 2) = Ks(0, 2) * iF0[2] + Ks(0, 6) * iF0[6] + Ks(0, 8) * iF0[8];
      Kr(0, 3) = Ks(0, 0) * iF0[4] + Ks(0, 3) * iF0[1] + Ks(0, 5) * iF0[7];
      Kr(0, 4) = Ks(0, 1) * iF0[3] + Ks(0, 4) * iF0[0] + Ks(0, 7) * iF0[5];
      Kr(0, 5) = Ks(0, 0) * iF0[6] + Ks(0, 3) * iF0[8] + Ks(0, 5) * iF0[2];
      Kr(0, 6) = Ks(0, 2) * iF0[5] + Ks(0, 6) * iF0[0] + Ks(0, 8) * iF0[3];
      Kr(0, 7) = Ks(0, 1) * iF0[8] + Ks(0, 4) * iF0[6] + Ks(0, 7) * iF0[2];
      Kr(0, 8) = Ks(0, 2) * iF0[7] + Ks(0, 6) * iF0[4] + Ks(0, 8) * iF0[1];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * iF0[0] + Ks(1, 3) * iF0[3] + Ks(1, 5) * iF0[5];
      Kr(1, 1) = Ks(1, 1) * iF0[1] + Ks(1, 4) * iF0[4] + Ks(1, 7) * iF0[7];
      Kr(1, 2) = Ks(1, 2) * iF0[2] + Ks(1, 6) * iF0[6] + Ks(1, 8) * iF0[8];
      Kr(1, 3) = Ks(1, 0) * iF0[4] + Ks(1, 3) * iF0[1] + Ks(1, 5) * iF0[7];
      Kr(1, 4) = Ks(1, 1) * iF0[3] + Ks(1, 4) * iF0[0] + Ks(1, 7) * iF0[5];
      Kr(1, 5) = Ks(1, 0) * iF0[6] + Ks(1, 3) * iF0[8] + Ks(1, 5) * iF0[2];
      Kr(1, 6) = Ks(1, 2) * iF0[5] + Ks(1, 6) * iF0[0] + Ks(1, 8) * iF0[3];
      Kr(1, 7) = Ks(1, 1) * iF0[8] + Ks(1, 4) * iF0[6] + Ks(1, 7) * iF0[2];
      Kr(1, 8) = Ks(1, 2) * iF0[7] + Ks(1, 6) * iF0[4] + Ks(1, 8) * iF0[1];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * iF0[0] + Ks(2, 3) * iF0[3] + Ks(2, 5) * iF0[5];
      Kr(2, 1) = Ks(2, 1) * iF0[1] + Ks(2, 4) * iF0[4] + Ks(2, 7) * iF0[7];
      Kr(2, 2) = Ks(2, 2) * iF0[2] + Ks(2, 6) * iF0[6] + Ks(2, 8) * iF0[8];
      Kr(2, 3) = Ks(2, 0) * iF0[4] + Ks(2, 3) * iF0[1] + Ks(2, 5) * iF0[7];
      Kr(2, 4) = Ks(2, 1) * iF0[3] + Ks(2, 4) * iF0[0] + Ks(2, 7) * iF0[5];
      Kr(2, 5) = Ks(2, 0) * iF0[6] + Ks(2, 3) * iF0[8] + Ks(2, 5) * iF0[2];
      Kr(2, 6) = Ks(2, 2) * iF0[5] + Ks(2, 6) * iF0[0] + Ks(2, 8) * iF0[3];
      Kr(2, 7) = Ks(2, 1) * iF0[8] + Ks(2, 4) * iF0[6] + Ks(2, 7) * iF0[2];
      Kr(2, 8) = Ks(2, 2) * iF0[7] + Ks(2, 6) * iF0[4] + Ks(2, 8) * iF0[1];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * iF0[0] + Ks(3, 3) * iF0[3] + Ks(3, 5) * iF0[5];
      Kr(3, 1) = Ks(3, 1) * iF0[1] + Ks(3, 4) * iF0[4] + Ks(3, 7) * iF0[7];
      Kr(3, 2) = Ks(3, 2) * iF0[2] + Ks(3, 6) * iF0[6] + Ks(3, 8) * iF0[8];
      Kr(3, 3) = Ks(3, 0) * iF0[4] + Ks(3, 3) * iF0[1] + Ks(3, 5) * iF0[7];
      Kr(3, 4) = Ks(3, 1) * iF0[3] + Ks(3, 4) * iF0[0] + Ks(3, 7) * iF0[5];
      Kr(3, 5) = Ks(3, 0) * iF0[6] + Ks(3, 3) * iF0[8] + Ks(3, 5) * iF0[2];
      Kr(3, 6) = Ks(3, 2) * iF0[5] + Ks(3, 6) * iF0[0] + Ks(3, 8) * iF0[3];
      Kr(3, 7) = Ks(3, 1) * iF0[8] + Ks(3, 4) * iF0[6] + Ks(3, 7) * iF0[2];
      Kr(3, 8) = Ks(3, 2) * iF0[7] + Ks(3, 6) * iF0[4] + Ks(3, 8) * iF0[1];
      // derivatives of the component (0, 2) of the stress
      Kr(4, 0) = Ks(4, 0) * iF0[0] + Ks(4, 3) * iF0[3] + Ks(4, 5) * iF0[5];
      Kr(4, 1) = Ks(4, 1) * iF0[1] + Ks(4, 4) * iF0[4] + Ks(4, 7) * iF0[7];
      Kr(4, 2) = Ks(4, 2) * iF0[2] + Ks(4, 6) * iF0[6] + Ks(4, 8) * iF0[8];
      Kr(4, 3) = Ks(4, 0) * iF0[4] + Ks(4, 3) * iF0[1] + Ks(4, 5) * iF0[7];
      Kr(4, 4) = Ks(4, 1) * iF0[3] + Ks(4, 4) * iF0[0] + Ks(4, 7) * iF0[5];
      Kr(4, 5) = Ks(4, 0) * iF0[6] + Ks(4, 3) * iF0[8] + Ks(4, 5) * iF0[2];
      Kr(4, 6) = Ks(4, 2) * iF0[5] + Ks(4, 6) * iF0[0] + Ks(4, 8) * iF0[3];
      Kr(4, 7) = Ks(4, 1) * iF0[8] + Ks(4, 4) * iF0[6] + Ks(4, 7) * iF0[2];
      Kr(4, 8) = Ks(4, 2) * iF0[7] + Ks(4, 6) * iF0[4] + Ks(4, 8) * iF0[1];
      // derivatives of the component (1, 2) of the stress
      Kr(5, 0) = Ks(5, 0) * iF0[0] + Ks(5, 3) * iF0[3] + Ks(5, 5) * iF0[5];
      Kr(5, 1) = Ks(5, 1) * iF0[1] + Ks(5, 4) * iF0[4] + Ks(5, 7) * iF0[7];
      Kr(5, 2) = Ks(5, 2) * iF0[2] + Ks(5, 6) * iF0[6] + Ks(5, 8) * iF0[8];
      Kr(5, 3) = Ks(5, 0) * iF0[4] + Ks(5, 3) * iF0[1] + Ks(5, 5) * iF0[7];
      Kr(5, 4) = Ks(5, 1) * iF0[3] + Ks(5, 4) * iF0[0] + Ks(5, 7) * iF0[5];
      Kr(5, 5) = Ks(5, 0) * iF0[6] + Ks(5, 3) * iF0[8] + Ks(5, 5) * iF0[2];
      Kr(5, 6) = Ks(5, 2) * iF0[5] + Ks(5, 6) * iF0[0] + Ks(5, 8) * iF0[3];
      Kr(5, 7) = Ks(5, 1) * iF0[8] + Ks(5, 4) * iF0[6] + Ks(5, 7) * iF0[2];
      Kr(5, 8) = Ks(5, 2) * iF0[7] + Ks(5, 6) * iF0[4] + Ks(5, 8) * iF0[1];
    }
  };  // end of struct DSIG_DDF_to_DSIG_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient (DTAU_DF) to the derivative of the Kirchhoff
   * stress with respect to the deformation gradient increment (DTAU_DDF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient increment \f$\Delta\,F=F\,F_{0}^{-1}\f$. Let
   * \f$\delta\,F\f$ be the variation of the deformation gradient associated
   * with this component, \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of
   * \f$l\f$ and \f$\delta\,\tau\f$ the variation of the Kirchhoff stress.
   * DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DF_to_DTAU_DDF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DF_to_DTAU_DDF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0) noexcept {
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F0[0];
      Kr(0, 1) = Ks(0, 1) * F0[1];
      Kr(0, 2) = Ks(0, 2) * F0[2];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F0[0];
      Kr(1, 1) = Ks(1, 1) * F0[1];
      Kr(1, 2) = Ks(1, 2) * F0[2];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F0[0];
      Kr(2, 1) = Ks(2, 1) * F0[1];
      Kr(2, 2) = Ks(2, 2) * F0[2];
    }
  };  // end of struct DTAU_DF_to_DTAU_DDF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DF_to_DTAU_DDF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0) noexcept {
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F0[0] + Ks(0, 3) * F0[3];
      Kr(0, 1) = Ks(0, 1) * F0[1] + Ks(0, 4) * F0[4];
      Kr(0, 2) = Ks(0, 2) * F0[2];
      Kr(0, 3) = Ks(0, 0) * F0[4] + Ks(0, 3) * F0[1];
      Kr(0, 4) = Ks(0, 1) * F0[3] + Ks(0, 4) * F0[0];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F0[0] + Ks(1, 3) * F0[3];
      Kr(1, 1) = Ks(1, 1) * F0[1] + Ks(1, 4) * F0[4];
      Kr(1, 2) = Ks(1, 2) * F0[2];
      Kr(1, 3) = Ks(1, 0) * F0[4] + Ks(1, 3) * F0[1];
      Kr(1, 4) = Ks(1, 1) * F0[3] + Ks(1, 4) * F0[0];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F0[0] + Ks(2, 3) * F0[3];
      Kr(2, 1) = Ks(2, 1) * F0[1] + Ks(2, 4) * F0[4];
      Kr(2, 2) = Ks(2, 2) * F0[2];
      Kr(2, 3) = Ks(2, 0) * F0[4] + Ks(2, 3) * F0[1];
      Kr(2, 4) = Ks(2, 1) * F0[3] + Ks(2, 4) * F0[0];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * F0[0] + Ks(3, 3) * F0[3];
      Kr(3, 1) = Ks(3, 1) * F0[1] + Ks(3, 4) * F0[4];
      Kr(3, 2) = Ks(3, 2) * F0[2];
      Kr(3, 3) = Ks(3, 0) * F0[4] + Ks(3, 3) * F0[1];
      Kr(3, 4) = Ks(3, 1) * F0[3] + Ks(3, 4) * F0[0];
    }
  };  // end of struct DTAU_DF_to_DTAU_DDF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DF_to_DTAU_DDF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0) noexcept {
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F0[0] + Ks(0, 3) * F0[3] + Ks(0, 5) * F0[5];
      Kr(0, 1) = Ks(0, 1) * F0[1] + Ks(0, 4) * F0[4] + Ks(0, 7) * F0[7];
      Kr(0, 2) = Ks(0, 2) * F0[2] + Ks(0, 6) * F0[6] + Ks(0, 8) * F0[8];
      Kr(0, 3) = Ks(0, 0) * F0[4] + Ks(0, 3) * F0[1] + Ks(0, 5) * F0[7];
      Kr(0, 4) = Ks(0, 1) * F0[3] + Ks(0, 4) * F0[0] + Ks(0, 7) * F0[5];
      Kr(0, 5) = Ks(0, 0) * F0[6] + Ks(0, 3) * F0[8] + Ks(0, 5) * F0[2];
      Kr(0, 6) = Ks(0, 2) * F0[5] + Ks(0, 6) * F0[0] + Ks(0, 8) * F0[3];
      Kr(0, 7) = Ks(0, 1) * F0[8] + Ks(0, 4) * F0[6] + Ks(0, 7) * F0[2];
      Kr(0, 8) = Ks(0, 2) * F0[7] + Ks(0, 6) * F0[4] + Ks(0, 8) * F0[1];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F0[0] + Ks(1, 3) * F0[3] + Ks(1, 5) * F0[5];
      Kr(1, 1) = Ks(1, 1) * F0[1] + Ks(1, 4) * F0[4] + Ks(1, 7) * F0[7];
      Kr(1, 2) = Ks(1, 2) * F0[2] + Ks(1, 6) * F0[6] + Ks(1, 8) * F0[8];
      Kr(1, 3) = Ks(1, 0) * F0[4] + Ks(1, 3) * F0[1] + Ks(1, 5) * F0[7];
      Kr(1, 4) = Ks(1, 1) * F0[3] + Ks(1, 4) * F0[0] + Ks(1, 7) * F0[5];
      Kr(1, 5) = Ks(1, 0) * F0[6] + Ks(1, 3) * F0[8] + Ks(1, 5) * F0[2];
      Kr(1, 6) = Ks(1, 2) * F0[5] + Ks(1, 6) * F0[0] + Ks(1, 8) * F0[3];
      Kr(1, 7) = Ks(1, 1) * F0[8] + Ks(1, 4) * F0[6] + Ks(1, 7) * F0[2];
      Kr(1, 8) = Ks(1, 2) * F0[7] + Ks(1, 6) * F0[4] + Ks(1, 8) * F0[1];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F0[0] + Ks(2, 3) * F0[3] + Ks(2, 5) * F0[5];
      Kr(2, 1) = Ks(2, 1) * F0[1] + Ks(2, 4) * F0[4] + Ks(2, 7) * F0[7];
      Kr(2, 2) = Ks(2, 2) * F0[2] + Ks(2, 6) * F0[6] + Ks(2, 8) * F0[8];
      Kr(2, 3) = Ks(2, 0) * F0[4] + Ks(2, 3) * F0[1] + Ks(2, 5) * F0[7];
      Kr(2, 4) = Ks(2, 1) * F0[3] + Ks(2, 4) * F0[0] + Ks(2, 7) * F0[5];
      Kr(2, 5) = Ks(2, 0) * F0[6] + Ks(2, 3) * F0[8] + Ks(2, 5) * F0[2];
      Kr(2, 6) = Ks(2, 2) * F0[5] + Ks(2, 6) * F0[0] + Ks(2, 8) * F0[3];
      Kr(2, 7) = Ks(2, 1) * F0[8] + Ks(2, 4) * F0[6] + Ks(2, 7) * F0[2];
      Kr(2, 8) = Ks(2, 2) * F0[7] + Ks(2, 6) * F0[4] + Ks(2, 8) * F0[1];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * F0[0] + Ks(3, 3) * F0[3] + Ks(3, 5) * F0[5];
      Kr(3, 1) = Ks(3, 1) * F0[1] + Ks(3, 4) * F0[4] + Ks(3, 7) * F0[7];
      Kr(3, 2) = Ks(3, 2) * F0[2] + Ks(3, 6) * F0[6] + Ks(3, 8) * F0[8];
      Kr(3, 3) = Ks(3, 0) * F0[4] + Ks(3, 3) * F0[1] + Ks(3, 5) * F0[7];
      Kr(3, 4) = Ks(3, 1) * F0[3] + Ks(3, 4) * F0[0] + Ks(3, 7) * F0[5];
      Kr(3, 5) = Ks(3, 0) * F0[6] + Ks(3, 3) * F0[8] + Ks(3, 5) * F0[2];
      Kr(3, 6) = Ks(3, 2) * F0[5] + Ks(3, 6) * F0[0] + Ks(3, 8) * F0[3];
      Kr(3, 7) = Ks(3, 1) * F0[8] + Ks(3, 4) * F0[6] + Ks(3, 7) * F0[2];
      Kr(3, 8) = Ks(3, 2) * F0[7] + Ks(3, 6) * F0[4] + Ks(3, 8) * F0[1];
      // derivatives of the component (0, 2) of the stress
      Kr(4, 0) = Ks(4, 0) * F0[0] + Ks(4, 3) * F0[3] + Ks(4, 5) * F0[5];
      Kr(4, 1) = Ks(4, 1) * F0[1] + Ks(4, 4) * F0[4] + Ks(4, 7) * F0[7];
      Kr(4, 2) = Ks(4, 2) * F0[2] + Ks(4, 6) * F0[6] + Ks(4, 8) * F0[8];
      Kr(4, 3) = Ks(4, 0) * F0[4] + Ks(4, 3) * F0[1] + Ks(4, 5) * F0[7];
      Kr(4, 4) = Ks(4, 1) * F0[3] + Ks(4, 4) * F0[0] + Ks(4, 7) * F0[5];
      Kr(4, 5) = Ks(4, 0) * F0[6] + Ks(4, 3) * F0[8] + Ks(4, 5) * F0[2];
      Kr(4, 6) = Ks(4, 2) * F0[5] + Ks(4, 6) * F0[0] + Ks(4, 8) * F0[3];
      Kr(4, 7) = Ks(4, 1) * F0[8] + Ks(4, 4) * F0[6] + Ks(4, 7) * F0[2];
      Kr(4, 8) = Ks(4, 2) * F0[7] + Ks(4, 6) * F0[4] + Ks(4, 8) * F0[1];
      // derivatives of the component (1, 2) of the stress
      Kr(5, 0) = Ks(5, 0) * F0[0] + Ks(5, 3) * F0[3] + Ks(5, 5) * F0[5];
      Kr(5, 1) = Ks(5, 1) * F0[1] + Ks(5, 4) * F0[4] + Ks(5, 7) * F0[7];
      Kr(5, 2) = Ks(5, 2) * F0[2] + Ks(5, 6) * F0[6] + Ks(5, 8) * F0[8];
      Kr(5, 3) = Ks(5, 0) * F0[4] + Ks(5, 3) * F0[1] + Ks(5, 5) * F0[7];
      Kr(5, 4) = Ks(5, 1) * F0[3] + Ks(5, 4) * F0[0] + Ks(5, 7) * F0[5];
      Kr(5, 5) = Ks(5, 0) * F0[6] + Ks(5, 3) * F0[8] + Ks(5, 5) * F0[2];
      Kr(5, 6) = Ks(5, 2) * F0[5] + Ks(5, 6) * F0[0] + Ks(5, 8) * F0[3];
      Kr(5, 7) = Ks(5, 1) * F0[8] + Ks(5, 4) * F0[6] + Ks(5, 7) * F0[2];
      Kr(5, 8) = Ks(5, 2) * F0[7] + Ks(5, 6) * F0[4] + Ks(5, 8) * F0[1];
    }
  };  // end of struct DTAU_DF_to_DTAU_DDF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient (DTAU_DF) to the derivative of the second
   * Piola-Kirchhoff stress with respect to the Green-Lagrange strain (DS_DEGL).
   * The result is computed column by column, i.e. component by component of the
   * Green-Lagrange strain. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DF_to_DS_DEGL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DF_to_DS_DEGL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 0) * iF[0];
        const auto a1 = Ks(1, 0) * iF[0];
        const auto a2 = Ks(2, 0) * iF[0];
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 0) = u0 * iF[0] - 2 * S[0] * iC[0];
        Kr(1, 0) = u1 * iF[1];
        Kr(2, 0) = u2 * iF[2];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 1) * iF[1];
        const auto a1 = Ks(1, 1) * iF[1];
        const auto a2 = Ks(2, 1) * iF[1];
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 1) = u0 * iF[0];
        Kr(1, 1) = u1 * iF[1] - 2 * S[1] * iC[1];
        Kr(2, 1) = u2 * iF[2];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 2) * iF[2];
        const auto a1 = Ks(1, 2) * iF[2];
        const auto a2 = Ks(2, 2) * iF[2];
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 2) = u0 * iF[0];
        Kr(1, 2) = u1 * iF[1];
        Kr(2, 2) = u2 * iF[2] - 2 * S[2] * iC[2];
      }
    }
  };  // end of struct DTAU_DF_to_DS_DEGL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DF_to_DS_DEGL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 0) * iF[0] + Ks(0, 4) * iF[3];
        const auto a1 = Ks(1, 0) * iF[0] + Ks(1, 4) * iF[3];
        const auto a2 = Ks(2, 0) * iF[0] + Ks(2, 4) * iF[3];
        const auto a3 = icste * (Ks(3, 0) * iF[0] + Ks(3, 4) * iF[3]);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 0) = u0 * iF[0] + u3 * iF[3] - 2 * S[0] * iC[0];
        Kr(1, 0) = u1 * iF[1] + u4 * iF[4] - S[3] * iC[3];
        Kr(2, 0) = u2 * iF[2];
        Kr(3, 0) =
            cste * (u0 * iF[4] + u3 * iF[1]) - S[0] * iC[3] - S[3] * iC[0];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 1) * iF[1] + Ks(0, 3) * iF[4];
        const auto a1 = Ks(1, 1) * iF[1] + Ks(1, 3) * iF[4];
        const auto a2 = Ks(2, 1) * iF[1] + Ks(2, 3) * iF[4];
        const auto a3 = icste * (Ks(3, 1) * iF[1] + Ks(3, 3) * iF[4]);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 1) = u0 * iF[0] + u3 * iF[3] - S[3] * iC[3];
        Kr(1, 1) = u1 * iF[1] + u4 * iF[4] - 2 * S[1] * iC[1];
        Kr(2, 1) = u2 * iF[2];
        Kr(3, 1) =
            cste * (u0 * iF[4] + u3 * iF[1]) - S[1] * iC[3] - S[3] * iC[1];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 2) * iF[2];
        const auto a1 = Ks(1, 2) * iF[2];
        const auto a2 = Ks(2, 2) * iF[2];
        const auto a3 = icste * Ks(3, 2) * iF[2];
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 2) = u0 * iF[0] + u3 * iF[3];
        Kr(1, 2) = u1 * iF[1] + u4 * iF[4];
        Kr(2, 2) = u2 * iF[2] - 2 * S[2] * iC[2];
        Kr(3, 2) = cste * (u0 * iF[4] + u3 * iF[1]);
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto a0 = icste * (Ks(0, 0) * iF[4] + Ks(0, 1) * iF[3] +
                                 Ks(0, 3) * iF[0] + Ks(0, 4) * iF[1]);
        const auto a1 = icste * (Ks(1, 0) * iF[4] + Ks(1, 1) * iF[3] +
                                 Ks(1, 3) * iF[0] + Ks(1, 4) * iF[1]);
        const auto a2 = icste * (Ks(2, 0) * iF[4] + Ks(2, 1) * iF[3] +
                                 Ks(2, 3) * iF[0] + Ks(2, 4) * iF[1]);
        const auto a3 = (Ks(3, 0) * iF[4] + Ks(3, 1) * iF[3] +
                         Ks(3, 3) * iF[0] + Ks(3, 4) * iF[1]) /
                        2;
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 3) = u0 * iF[0] + u3 * iF[3] - S[0] * iC[3] - S[3] * iC[0];
        Kr(1, 3) = u1 * iF[1] + u4 * iF[4] - S[1] * iC[3] - S[3] * iC[1];
        Kr(2, 3) = u2 * iF[2];
        Kr(3, 3) = cste * (u0 * iF[4] + u3 * iF[1]) - S[0] * iC[1] -
                   S[1] * iC[0] - S[3] * iC[3];
      }
    }
  };  // end of struct DTAU_DF_to_DS_DEGL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DF_to_DS_DEGL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 0) * iF[0] + Ks(0, 4) * iF[3] + Ks(0, 6) * iF[5];
        const auto a1 = Ks(1, 0) * iF[0] + Ks(1, 4) * iF[3] + Ks(1, 6) * iF[5];
        const auto a2 = Ks(2, 0) * iF[0] + Ks(2, 4) * iF[3] + Ks(2, 6) * iF[5];
        const auto a3 =
            icste * (Ks(3, 0) * iF[0] + Ks(3, 4) * iF[3] + Ks(3, 6) * iF[5]);
        const auto a4 =
            icste * (Ks(4, 0) * iF[0] + Ks(4, 4) * iF[3] + Ks(4, 6) * iF[5]);
        const auto a5 =
            icste * (Ks(5, 0) * iF[0] + Ks(5, 4) * iF[3] + Ks(5, 6) * iF[5]);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 0) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - 2 * S[0] * iC[0];
        Kr(1, 0) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[3] * iC[3];
        Kr(2, 0) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[4] * iC[4];
        Kr(3, 0) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   S[0] * iC[3] - S[3] * iC[0];
        Kr(4, 0) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   S[0] * iC[4] - S[4] * iC[0];
        Kr(5, 0) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[3] * iC[4] + S[4] * iC[3]);
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 1) * iF[1] + Ks(0, 3) * iF[4] + Ks(0, 8) * iF[7];
        const auto a1 = Ks(1, 1) * iF[1] + Ks(1, 3) * iF[4] + Ks(1, 8) * iF[7];
        const auto a2 = Ks(2, 1) * iF[1] + Ks(2, 3) * iF[4] + Ks(2, 8) * iF[7];
        const auto a3 =
            icste * (Ks(3, 1) * iF[1] + Ks(3, 3) * iF[4] + Ks(3, 8) * iF[7]);
        const auto a4 =
            icste * (Ks(4, 1) * iF[1] + Ks(4, 3) * iF[4] + Ks(4, 8) * iF[7]);
        const auto a5 =
            icste * (Ks(5, 1) * iF[1] + Ks(5, 3) * iF[4] + Ks(5, 8) * iF[7]);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 1) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[3] * iC[3];
        Kr(1, 1) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - 2 * S[1] * iC[1];
        Kr(2, 1) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[5] * iC[5];
        Kr(3, 1) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   S[1] * iC[3] - S[3] * iC[1];
        Kr(4, 1) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[3] * iC[5] + S[5] * iC[3]);
        Kr(5, 1) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   S[1] * iC[5] - S[5] * iC[1];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto a0 = Ks(0, 2) * iF[2] + Ks(0, 5) * iF[6] + Ks(0, 7) * iF[8];
        const auto a1 = Ks(1, 2) * iF[2] + Ks(1, 5) * iF[6] + Ks(1, 7) * iF[8];
        const auto a2 = Ks(2, 2) * iF[2] + Ks(2, 5) * iF[6] + Ks(2, 7) * iF[8];
        const auto a3 =
            icste * (Ks(3, 2) * iF[2] + Ks(3, 5) * iF[6] + Ks(3, 7) * iF[8]);
        const auto a4 =
            icste * (Ks(4, 2) * iF[2] + Ks(4, 5) * iF[6] + Ks(4, 7) * iF[8]);
        const auto a5 =
            icste * (Ks(5, 2) * iF[2] + Ks(5, 5) * iF[6] + Ks(5, 7) * iF[8]);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 2) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[4] * iC[4];
        Kr(1, 2) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[5] * iC[5];
        Kr(2, 2) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - 2 * S[2] * iC[2];
        Kr(3, 2) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[4] * iC[5] + S[5] * iC[4]);
        Kr(4, 2) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   S[2] * iC[4] - S[4] * iC[2];
        Kr(5, 2) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   S[2] * iC[5] - S[5] * iC[2];
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto a0 =
            icste * (Ks(0, 0) * iF[4] + Ks(0, 1) * iF[3] + Ks(0, 3) * iF[0] +
                     Ks(0, 4) * iF[1] + Ks(0, 6) * iF[7] + Ks(0, 8) * iF[5]);
        const auto a1 =
            icste * (Ks(1, 0) * iF[4] + Ks(1, 1) * iF[3] + Ks(1, 3) * iF[0] +
                     Ks(1, 4) * iF[1] + Ks(1, 6) * iF[7] + Ks(1, 8) * iF[5]);
        const auto a2 =
            icste * (Ks(2, 0) * iF[4] + Ks(2, 1) * iF[3] + Ks(2, 3) * iF[0] +
                     Ks(2, 4) * iF[1] + Ks(2, 6) * iF[7] + Ks(2, 8) * iF[5]);
        const auto a3 =
            (Ks(3, 0) * iF[4] + Ks(3, 1) * iF[3] + Ks(3, 3) * iF[0] +
             Ks(3, 4) * iF[1] + Ks(3, 6) * iF[7] + Ks(3, 8) * iF[5]) /
            2;
        const auto a4 =
            (Ks(4, 0) * iF[4] + Ks(4, 1) * iF[3] + Ks(4, 3) * iF[0] +
             Ks(4, 4) * iF[1] + Ks(4, 6) * iF[7] + Ks(4, 8) * iF[5]) /
            2;
        const auto a5 =
            (Ks(5, 0) * iF[4] + Ks(5, 1) * iF[3] + Ks(5, 3) * iF[0] +
             Ks(5, 4) * iF[1] + Ks(5, 6) * iF[7] + Ks(5, 8) * iF[5]) /
            2;
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 3) =
            u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[0] * iC[3] - S[3] * iC[0];
        Kr(1, 3) =
            u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[1] * iC[3] - S[3] * iC[1];
        Kr(2, 3) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] -
                   icste * (S[4] * iC[5] + S[5] * iC[4]);
        Kr(3, 3) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   S[0] * iC[1] - S[1] * iC[0] - S[3] * iC[3];
        Kr(4, 3) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[0] * iC[5] + S[5] * iC[0]) -
                   (S[3] * iC[4] + S[4] * iC[3]) / 2;
        Kr(5, 3) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[1] * iC[4] + S[4] * iC[1]) -
                   (S[3] * iC[5] + S[5] * iC[3]) / 2;
      }
      {
        // column associated with the component (0, 2) of the Green-Lagrange
        // strain
        const auto a0 =
            icste * (Ks(0, 0) * iF[6] + Ks(0, 2) * iF[5] + Ks(0, 4) * iF[8] +
                     Ks(0, 5) * iF[0] + Ks(0, 6) * iF[2] + Ks(0, 7) * iF[3]);
        const auto a1 =
            icste * (Ks(1, 0) * iF[6] + Ks(1, 2) * iF[5] + Ks(1, 4) * iF[8] +
                     Ks(1, 5) * iF[0] + Ks(1, 6) * iF[2] + Ks(1, 7) * iF[3]);
        const auto a2 =
            icste * (Ks(2, 0) * iF[6] + Ks(2, 2) * iF[5] + Ks(2, 4) * iF[8] +
                     Ks(2, 5) * iF[0] + Ks(2, 6) * iF[2] + Ks(2, 7) * iF[3]);
        const auto a3 =
            (Ks(3, 0) * iF[6] + Ks(3, 2) * iF[5] + Ks(3, 4) * iF[8] +
             Ks(3, 5) * iF[0] + Ks(3, 6) * iF[2] + Ks(3, 7) * iF[3]) /
            2;
        const auto a4 =
            (Ks(4, 0) * iF[6] + Ks(4, 2) * iF[5] + Ks(4, 4) * iF[8] +
             Ks(4, 5) * iF[0] + Ks(4, 6) * iF[2] + Ks(4, 7) * iF[3]) /
            2;
        const auto a5 =
            (Ks(5, 0) * iF[6] + Ks(5, 2) * iF[5] + Ks(5, 4) * iF[8] +
             Ks(5, 5) * iF[0] + Ks(5, 6) * iF[2] + Ks(5, 7) * iF[3]) /
            2;
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 4) =
            u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[0] * iC[4] - S[4] * iC[0];
        Kr(1, 4) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] -
                   icste * (S[3] * iC[5] + S[5] * iC[3]);
        Kr(2, 4) =
            u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[2] * iC[4] - S[4] * iC[2];
        Kr(3, 4) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[0] * iC[5] + S[5] * iC[0]) -
                   (S[3] * iC[4] + S[4] * iC[3]) / 2;
        Kr(4, 4) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   S[0] * iC[2] - S[2] * iC[0] - S[4] * iC[4];
        Kr(5, 4) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[2] * iC[3] + S[3] * iC[2]) -
                   (S[4] * iC[5] + S[5] * iC[4]) / 2;
      }
      {
        // column associated with the component (1, 2) of the Green-Lagrange
        // strain
        const auto a0 =
            icste * (Ks(0, 1) * iF[8] + Ks(0, 2) * iF[7] + Ks(0, 3) * iF[6] +
                     Ks(0, 5) * iF[4] + Ks(0, 7) * iF[1] + Ks(0, 8) * iF[2]);
        const auto a1 =
            icste * (Ks(1, 1) * iF[8] + Ks(1, 2) * iF[7] + Ks(1, 3) * iF[6] +
                     Ks(1, 5) * iF[4] + Ks(1, 7) * iF[1] + Ks(1, 8) * iF[2]);
        const auto a2 =
            icste * (Ks(2, 1) * iF[8] + Ks(2, 2) * iF[7] + Ks(2, 3) * iF[6] +
                     Ks(2, 5) * iF[4] + Ks(2, 7) * iF[1] + Ks(2, 8) * iF[2]);
        const auto a3 =
            (Ks(3, 1) * iF[8] + Ks(3, 2) * iF[7] + Ks(3, 3) * iF[6] +
             Ks(3, 5) * iF[4] + Ks(3, 7) * iF[1] + Ks(3, 8) * iF[2]) /
            2;
        const auto a4 =
            (Ks(4, 1) * iF[8] + Ks(4, 2) * iF[7] + Ks(4, 3) * iF[6] +
             Ks(4, 5) * iF[4] + Ks(4, 7) * iF[1] + Ks(4, 8) * iF[2]) /
            2;
        const auto a5 =
            (Ks(5, 1) * iF[8] + Ks(5, 2) * iF[7] + Ks(5, 3) * iF[6] +
             Ks(5, 5) * iF[4] + Ks(5, 7) * iF[1] + Ks(5, 8) * iF[2]) /
            2;
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 5) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] -
                   icste * (S[3] * iC[4] + S[4] * iC[3]);
        Kr(1, 5) =
            u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[1] * iC[5] - S[5] * iC[1];
        Kr(2, 5) =
            u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[2] * iC[5] - S[5] * iC[2];
        Kr(3, 5) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[1] * iC[4] + S[4] * iC[1]) -
                   (S[3] * iC[5] + S[5] * iC[3]) / 2;
        Kr(4, 5) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[2] * iC[3] + S[3] * iC[2]) -
                   (S[4] * iC[5] + S[5] * iC[4]) / 2;
        Kr(5, 5) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   S[1] * iC[2] - S[2] * iC[1] - S[5] * iC[5];
      }
    }
  };  // end of struct DTAU_DF_to_DS_DEGL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient (DTAU_DF) to the spatial moduli
   * (SPATIAL_MODULI).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and SPATIAL_MODULI relates
   * \f[
   * \delta\,\tau-l\,\tau-\tau\,l^{T}
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DF_to_SPATIAL_MODULI_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DF_to_SPATIAL_MODULI_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: spatial moduli
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const tfel::math::stensor<1u, stress> tau = J * s;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] - 2 * tau[0];
      Kr(1, 0) = Ks(1, 0) * F[0];
      Kr(2, 0) = Ks(2, 0) * F[0];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1];
      Kr(1, 1) = Ks(1, 1) * F[1] - 2 * tau[1];
      Kr(2, 1) = Ks(2, 1) * F[1];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2];
      Kr(1, 2) = Ks(1, 2) * F[2];
      Kr(2, 2) = Ks(2, 2) * F[2] - 2 * tau[2];
    }
  };  // end of struct DTAU_DF_to_SPATIAL_MODULI_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DF_to_SPATIAL_MODULI_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: spatial moduli
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const tfel::math::stensor<2u, stress> tau = J * s;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = Ks(0, 0) * F[0] + Ks(0, 3) * F[3] - 2 * tau[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * F[3];
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * F[3];
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * F[3] - tau[3];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 4) * F[4];
      Kr(1, 1) = Ks(1, 1) * F[1] + Ks(1, 4) * F[4] - 2 * tau[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 4) * F[4];
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 4) * F[4] - tau[3];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2];
      Kr(1, 2) = Ks(1, 2) * F[2];
      Kr(2, 2) = Ks(2, 2) * F[2] - 2 * tau[2];
      Kr(3, 2) = Ks(3, 2) * F[2];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = icste * (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                          Ks(0, 4) * F[0]) -
                 tau[3];
      Kr(1, 3) = icste * (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                          Ks(1, 4) * F[0]) -
                 tau[3];
      Kr(2, 3) = icste * (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                          Ks(2, 4) * F[0]);
      Kr(3, 3) = icste * (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                          Ks(3, 4) * F[0]) -
                 tau[0] - tau[1];
    }
  };  // end of struct DTAU_DF_to_SPATIAL_MODULI_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DF_to_SPATIAL_MODULI_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: spatial moduli
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const tfel::math::stensor<3u, stress> tau = J * s;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) =
          Ks(0, 0) * F[0] + Ks(0, 3) * F[3] + Ks(0, 5) * F[5] - 2 * tau[0];
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * F[3] + Ks(1, 5) * F[5];
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * F[3] + Ks(2, 5) * F[5];
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * F[3] + Ks(3, 5) * F[5] - tau[3];
      Kr(4, 0) = Ks(4, 0) * F[0] + Ks(4, 3) * F[3] + Ks(4, 5) * F[5] - tau[4];
      Kr(5, 0) = Ks(5, 0) * F[0] + Ks(5, 3) * F[3] + Ks(5, 5) * F[5];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 4) * F[4] + Ks(0, 7) * F[7];
      Kr(1, 1) =
          Ks(1, 1) * F[1] + Ks(1, 4) * F[4] + Ks(1, 7) * F[7] - 2 * tau[1];
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 4) * F[4] + Ks(2, 7) * F[7];
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 4) * F[4] + Ks(3, 7) * F[7] - tau[3];
      Kr(4, 1) = Ks(4, 1) * F[1] + Ks(4, 4) * F[4] + Ks(4, 7) * F[7];
      Kr(5, 1) = Ks(5, 1) * F[1] + Ks(5, 4) * F[4] + Ks(5, 7) * F[7] - tau[5];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = Ks(0, 2) * F[2] + Ks(0, 6) * F[6] + Ks(0, 8) * F[8];
      Kr(1, 2) = Ks(1, 2) * F[2] + Ks(1, 6) * F[6] + Ks(1, 8) * F[8];
      Kr(2, 2) =
          Ks(2, 2) * F[2] + Ks(2, 6) * F[6] + Ks(2, 8) * F[8] - 2 * tau[2];
      Kr(3, 2) = Ks(3, 2) * F[2] + Ks(3, 6) * F[6] + Ks(3, 8) * F[8];
      Kr(4, 2) = Ks(4, 2) * F[2] + Ks(4, 6) * F[6] + Ks(4, 8) * F[8] - tau[4];
      Kr(5, 2) = Ks(5, 2) * F[2] + Ks(5, 6) * F[6] + Ks(5, 8) * F[8] - tau[5];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = icste * (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                          Ks(0, 4) * F[0] + Ks(0, 5) * F[7] + Ks(0, 7) * F[5]) -
                 tau[3];
      Kr(1, 3) = icste * (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                          Ks(1, 4) * F[0] + Ks(1, 5) * F[7] + Ks(1, 7) * F[5]) -
                 tau[3];
      Kr(2, 3) = icste * (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                          Ks(2, 4) * F[0] + Ks(2, 5) * F[7] + Ks(2, 7) * F[5]);
      Kr(3, 3) = icste * (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                          Ks(3, 4) * F[0] + Ks(3, 5) * F[7] + Ks(3, 7) * F[5]) -
                 tau[0] - tau[1];
      Kr(4, 3) = icste *
                 (Ks(4, 0) * F[4] + Ks(4, 1) * F[3] + Ks(4, 3) * F[1] +
                  Ks(4, 4) * F[0] + Ks(4, 5) * F[7] + Ks(4, 7) * F[5] - tau[5]);
      Kr(5, 3) = icste *
                 (Ks(5, 0) * F[4] + Ks(5, 1) * F[3] + Ks(5, 3) * F[1] +
                  Ks(5, 4) * F[0] + Ks(5, 5) * F[7] + Ks(5, 7) * F[5] - tau[4]);
      // column associated with the component (0, 2) of the rate of deformation
      Kr(0, 4) = icste * (Ks(0, 0) * F[6] + Ks(0, 2) * F[5] + Ks(0, 3) * F[8] +
                          Ks(0, 5) * F[2] + Ks(0, 6) * F[0] + Ks(0, 8) * F[3]) -
                 tau[4];
      Kr(1, 4) = icste * (Ks(1, 0) * F[6] + Ks(1, 2) * F[5] + Ks(1, 3) * F[8] +
                          Ks(1, 5) * F[2] + Ks(1, 6) * F[0] + Ks(1, 8) * F[3]);
      Kr(2, 4) = icste * (Ks(2, 0) * F[6] + Ks(2, 2) * F[5] + Ks(2, 3) * F[8] +
                          Ks(2, 5) * F[2] + Ks(2, 6) * F[0] + Ks(2, 8) * F[3]) -
                 tau[4];
      Kr(3, 4) = icste *
                 (Ks(3, 0) * F[6] + Ks(3, 2) * F[5] + Ks(3, 3) * F[8] +
                  Ks(3, 5) * F[2] + Ks(3, 6) * F[0] + Ks(3, 8) * F[3] - tau[5]);
      Kr(4, 4) = icste * (Ks(4, 0) * F[6] + Ks(4, 2) * F[5] + Ks(4, 3) * F[8] +
                          Ks(4, 5) * F[2] + Ks(4, 6) * F[0] + Ks(4, 8) * F[3]) -
                 tau[0] - tau[2];
      Kr(5, 4) = icste *
                 (Ks(5, 0) * F[6] + Ks(5, 2) * F[5] + Ks(5, 3) * F[8] +
                  Ks(5, 5) * F[2] + Ks(5, 6) * F[0] + Ks(5, 8) * F[3] - tau[3]);
      // column associated with the component (1, 2) of the rate of deformation
      Kr(0, 5) = icste * (Ks(0, 1) * F[8] + Ks(0, 2) * F[7] + Ks(0, 4) * F[6] +
                          Ks(0, 6) * F[4] + Ks(0, 7) * F[2] + Ks(0, 8) * F[1]);
      Kr(1, 5) = icste * (Ks(1, 1) * F[8] + Ks(1, 2) * F[7] + Ks(1, 4) * F[6] +
                          Ks(1, 6) * F[4] + Ks(1, 7) * F[2] + Ks(1, 8) * F[1]) -
                 tau[5];
      Kr(2, 5) = icste * (Ks(2, 1) * F[8] + Ks(2, 2) * F[7] + Ks(2, 4) * F[6] +
                          Ks(2, 6) * F[4] + Ks(2, 7) * F[2] + Ks(2, 8) * F[1]) -
                 tau[5];
      Kr(3, 5) = icste *
                 (Ks(3, 1) * F[8] + Ks(3, 2) * F[7] + Ks(3, 4) * F[6] +
                  Ks(3, 6) * F[4] + Ks(3, 7) * F[2] + Ks(3, 8) * F[1] - tau[4]);
      Kr(4, 5) = icste *
                 (Ks(4, 1) * F[8] + Ks(4, 2) * F[7] + Ks(4, 4) * F[6] +
                  Ks(4, 6) * F[4] + Ks(4, 7) * F[2] + Ks(4, 8) * F[1] - tau[3]);
      Kr(5, 5) = icste * (Ks(5, 1) * F[8] + Ks(5, 2) * F[7] + Ks(5, 4) * F[6] +
                          Ks(5, 6) * F[4] + Ks(5, 7) * F[2] + Ks(5, 8) * F[1]) -
                 tau[1] - tau[2];
    }
  };  // end of struct DTAU_DF_to_SPATIAL_MODULI_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient (DTAU_DF) to the moduli associated with the
   * Truesdell rate of the Cauchy stress (C_TRUESDELL).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and C_TRUESDELL relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DF_to_C_TRUESDELL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DF_to_C_TRUESDELL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * Ks(0, 0) * F[0] - 2 * s[0];
      Kr(1, 0) = iJ * Ks(1, 0) * F[0];
      Kr(2, 0) = iJ * Ks(2, 0) * F[0];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * Ks(0, 1) * F[1];
      Kr(1, 1) = iJ * Ks(1, 1) * F[1] - 2 * s[1];
      Kr(2, 1) = iJ * Ks(2, 1) * F[1];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * F[2];
      Kr(1, 2) = iJ * Ks(1, 2) * F[2];
      Kr(2, 2) = iJ * Ks(2, 2) * F[2] - 2 * s[2];
    }
  };  // end of struct DTAU_DF_to_C_TRUESDELL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DF_to_C_TRUESDELL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * (Ks(0, 0) * F[0] + Ks(0, 3) * F[3]) - 2 * s[0];
      Kr(1, 0) = iJ * (Ks(1, 0) * F[0] + Ks(1, 3) * F[3]);
      Kr(2, 0) = iJ * (Ks(2, 0) * F[0] + Ks(2, 3) * F[3]);
      Kr(3, 0) = iJ * (Ks(3, 0) * F[0] + Ks(3, 3) * F[3]) - s[3];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * F[1] + Ks(0, 4) * F[4]);
      Kr(1, 1) = iJ * (Ks(1, 1) * F[1] + Ks(1, 4) * F[4]) - 2 * s[1];
      Kr(2, 1) = iJ * (Ks(2, 1) * F[1] + Ks(2, 4) * F[4]);
      Kr(3, 1) = iJ * (Ks(3, 1) * F[1] + Ks(3, 4) * F[4]) - s[3];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * F[2];
      Kr(1, 2) = iJ * Ks(1, 2) * F[2];
      Kr(2, 2) = iJ * Ks(2, 2) * F[2] - 2 * s[2];
      Kr(3, 2) = iJ * Ks(3, 2) * F[2];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                     (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                      Ks(0, 4) * F[0]) -
                 s[3];
      Kr(1, 3) = iJ * icste *
                     (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                      Ks(1, 4) * F[0]) -
                 s[3];
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                  Ks(2, 4) * F[0]);
      Kr(3, 3) = iJ * icste *
                     (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                      Ks(3, 4) * F[0]) -
                 s[0] - s[1];
    }
  };  // end of struct DTAU_DF_to_C_TRUESDELL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DF_to_C_TRUESDELL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) =
          iJ * (Ks(0, 0) * F[0] + Ks(0, 3) * F[3] + Ks(0, 5) * F[5]) - 2 * s[0];
      Kr(1, 0) = iJ * (Ks(1, 0) * F[0] + Ks(1, 3) * F[3] + Ks(1, 5) * F[5]);
      Kr(2, 0) = iJ * (Ks(2, 0) * F[0] + Ks(2, 3) * F[3] + Ks(2, 5) * F[5]);
      Kr(3, 0) =
          iJ * (Ks(3, 0) * F[0] + Ks(3, 3) * F[3] + Ks(3, 5) * F[5]) - s[3];
      Kr(4, 0) =
          iJ * (Ks(4, 0) * F[0] + Ks(4, 3) * F[3] + Ks(4, 5) * F[5]) - s[4];
      Kr(5, 0) = iJ * (Ks(5, 0) * F[0] + Ks(5, 3) * F[3] + Ks(5, 5) * F[5]);
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * F[1] + Ks(0, 4) * F[4] + Ks(0, 7) * F[7]);
      Kr(1, 1) =
          iJ * (Ks(1, 1) * F[1] + Ks(1, 4) * F[4] + Ks(1, 7) * F[7]) - 2 * s[1];
      Kr(2, 1) = iJ * (Ks(2, 1) * F[1] + Ks(2, 4) * F[4] + Ks(2, 7) * F[7]);
      Kr(3, 1) =
          iJ * (Ks(3, 1) * F[1] + Ks(3, 4) * F[4] + Ks(3, 7) * F[7]) - s[3];
      Kr(4, 1) = iJ * (Ks(4, 1) * F[1] + Ks(4, 4) * F[4] + Ks(4, 7) * F[7]);
      Kr(5, 1) =
          iJ * (Ks(5, 1) * F[1] + Ks(5, 4) * F[4] + Ks(5, 7) * F[7]) - s[5];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * (Ks(0, 2) * F[2] + Ks(0, 6) * F[6] + Ks(0, 8) * F[8]);
      Kr(1, 2) = iJ * (Ks(1, 2) * F[2] + Ks(1, 6) * F[6] + Ks(1, 8) * F[8]);
      Kr(2, 2) =
          iJ * (Ks(2, 2) * F[2] + Ks(2, 6) * F[6] + Ks(2, 8) * F[8]) - 2 * s[2];
      Kr(3, 2) = iJ * (Ks(3, 2) * F[2] + Ks(3, 6) * F[6] + Ks(3, 8) * F[8]);
      Kr(4, 2) =
          iJ * (Ks(4, 2) * F[2] + Ks(4, 6) * F[6] + Ks(4, 8) * F[8]) - s[4];
      Kr(5, 2) =
          iJ * (Ks(5, 2) * F[2] + Ks(5, 6) * F[6] + Ks(5, 8) * F[8]) - s[5];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                     (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                      Ks(0, 4) * F[0] + Ks(0, 5) * F[7] + Ks(0, 7) * F[5]) -
                 s[3];
      Kr(1, 3) = iJ * icste *
                     (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                      Ks(1, 4) * F[0] + Ks(1, 5) * F[7] + Ks(1, 7) * F[5]) -
                 s[3];
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                  Ks(2, 4) * F[0] + Ks(2, 5) * F[7] + Ks(2, 7) * F[5]);
      Kr(3, 3) = iJ * icste *
                     (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                      Ks(3, 4) * F[0] + Ks(3, 5) * F[7] + Ks(3, 7) * F[5]) -
                 s[0] - s[1];
      Kr(4, 3) = iJ * icste *
                     (Ks(4, 0) * F[4] + Ks(4, 1) * F[3] + Ks(4, 3) * F[1] +
                      Ks(4, 4) * F[0] + Ks(4, 5) * F[7] + Ks(4, 7) * F[5]) -
                 icste * s[5];
      Kr(5, 3) = iJ * icste *
                     (Ks(5, 0) * F[4] + Ks(5, 1) * F[3] + Ks(5, 3) * F[1] +
                      Ks(5, 4) * F[0] + Ks(5, 5) * F[7] + Ks(5, 7) * F[5]) -
                 icste * s[4];
      // column associated with the component (0, 2) of the rate of deformation
      Kr(0, 4) = iJ * icste *
                     (Ks(0, 0) * F[6] + Ks(0, 2) * F[5] + Ks(0, 3) * F[8] +
                      Ks(0, 5) * F[2] + Ks(0, 6) * F[0] + Ks(0, 8) * F[3]) -
                 s[4];
      Kr(1, 4) = iJ * icste *
                 (Ks(1, 0) * F[6] + Ks(1, 2) * F[5] + Ks(1, 3) * F[8] +
                  Ks(1, 5) * F[2] + Ks(1, 6) * F[0] + Ks(1, 8) * F[3]);
      Kr(2, 4) = iJ * icste *
                     (Ks(2, 0) * F[6] + Ks(2, 2) * F[5] + Ks(2, 3) * F[8] +
                      Ks(2, 5) * F[2] + Ks(2, 6) * F[0] + Ks(2, 8) * F[3]) -
                 s[4];
      Kr(3, 4) = iJ * icste *
                     (Ks(3, 0) * F[6] + Ks(3, 2) * F[5] + Ks(3, 3) * F[8] +
                      Ks(3, 5) * F[2] + Ks(3, 6) * F[0] + Ks(3, 8) * F[3]) -
                 icste * s[5];
      Kr(4, 4) = iJ * icste *
                     (Ks(4, 0) * F[6] + Ks(4, 2) * F[5] + Ks(4, 3) * F[8] +
                      Ks(4, 5) * F[2] + Ks(4, 6) * F[0] + Ks(4, 8) * F[3]) -
                 s[0] - s[2];
      Kr(5, 4) = iJ * icste *
                     (Ks(5, 0) * F[6] + Ks(5, 2) * F[5] + Ks(5, 3) * F[8] +
                      Ks(5, 5) * F[2] + Ks(5, 6) * F[0] + Ks(5, 8) * F[3]) -
                 icste * s[3];
      // column associated with the component (1, 2) of the rate of deformation
      Kr(0, 5) = iJ * icste *
                 (Ks(0, 1) * F[8] + Ks(0, 2) * F[7] + Ks(0, 4) * F[6] +
                  Ks(0, 6) * F[4] + Ks(0, 7) * F[2] + Ks(0, 8) * F[1]);
      Kr(1, 5) = iJ * icste *
                     (Ks(1, 1) * F[8] + Ks(1, 2) * F[7] + Ks(1, 4) * F[6] +
                      Ks(1, 6) * F[4] + Ks(1, 7) * F[2] + Ks(1, 8) * F[1]) -
                 s[5];
      Kr(2, 5) = iJ * icste *
                     (Ks(2, 1) * F[8] + Ks(2, 2) * F[7] + Ks(2, 4) * F[6] +
                      Ks(2, 6) * F[4] + Ks(2, 7) * F[2] + Ks(2, 8) * F[1]) -
                 s[5];
      Kr(3, 5) = iJ * icste *
                     (Ks(3, 1) * F[8] + Ks(3, 2) * F[7] + Ks(3, 4) * F[6] +
                      Ks(3, 6) * F[4] + Ks(3, 7) * F[2] + Ks(3, 8) * F[1]) -
                 icste * s[4];
      Kr(4, 5) = iJ * icste *
                     (Ks(4, 1) * F[8] + Ks(4, 2) * F[7] + Ks(4, 4) * F[6] +
                      Ks(4, 6) * F[4] + Ks(4, 7) * F[2] + Ks(4, 8) * F[1]) -
                 icste * s[3];
      Kr(5, 5) = iJ * icste *
                     (Ks(5, 1) * F[8] + Ks(5, 2) * F[7] + Ks(5, 4) * F[6] +
                      Ks(5, 6) * F[4] + Ks(5, 7) * F[2] + Ks(5, 8) * F[1]) -
                 s[1] - s[2];
    }
  };  // end of struct DTAU_DF_to_C_TRUESDELL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient (DTAU_DF) to the moduli associated with the
   * Jaumann rate of the Kirchhoff stress divided by the change of volume
   * (ABAQUS).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * and ABAQUS relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-w\,\tau+\tau\,w\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DF_to_ABAQUS_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DF_to_ABAQUS_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * Ks(0, 0) * F[0];
      Kr(1, 0) = iJ * Ks(1, 0) * F[0];
      Kr(2, 0) = iJ * Ks(2, 0) * F[0];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * Ks(0, 1) * F[1];
      Kr(1, 1) = iJ * Ks(1, 1) * F[1];
      Kr(2, 1) = iJ * Ks(2, 1) * F[1];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * F[2];
      Kr(1, 2) = iJ * Ks(1, 2) * F[2];
      Kr(2, 2) = iJ * Ks(2, 2) * F[2];
    }
  };  // end of struct DTAU_DF_to_ABAQUS_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DF_to_ABAQUS_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * (Ks(0, 0) * F[0] + Ks(0, 3) * F[3]);
      Kr(1, 0) = iJ * (Ks(1, 0) * F[0] + Ks(1, 3) * F[3]);
      Kr(2, 0) = iJ * (Ks(2, 0) * F[0] + Ks(2, 3) * F[3]);
      Kr(3, 0) = iJ * (Ks(3, 0) * F[0] + Ks(3, 3) * F[3]);
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * F[1] + Ks(0, 4) * F[4]);
      Kr(1, 1) = iJ * (Ks(1, 1) * F[1] + Ks(1, 4) * F[4]);
      Kr(2, 1) = iJ * (Ks(2, 1) * F[1] + Ks(2, 4) * F[4]);
      Kr(3, 1) = iJ * (Ks(3, 1) * F[1] + Ks(3, 4) * F[4]);
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * F[2];
      Kr(1, 2) = iJ * Ks(1, 2) * F[2];
      Kr(2, 2) = iJ * Ks(2, 2) * F[2];
      Kr(3, 2) = iJ * Ks(3, 2) * F[2];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                 (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                  Ks(0, 4) * F[0]);
      Kr(1, 3) = iJ * icste *
                 (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                  Ks(1, 4) * F[0]);
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                  Ks(2, 4) * F[0]);
      Kr(3, 3) = iJ * icste *
                 (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                  Ks(3, 4) * F[0]);
    }
  };  // end of struct DTAU_DF_to_ABAQUS_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DF_to_ABAQUS_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * (Ks(0, 0) * F[0] + Ks(0, 3) * F[3] + Ks(0, 5) * F[5]);
      Kr(1, 0) = iJ * (Ks(1, 0) * F[0] + Ks(1, 3) * F[3] + Ks(1, 5) * F[5]);
      Kr(2, 0) = iJ * (Ks(2, 0) * F[0] + Ks(2, 3) * F[3] + Ks(2, 5) * F[5]);
      Kr(3, 0) = iJ * (Ks(3, 0) * F[0] + Ks(3, 3) * F[3] + Ks(3, 5) * F[5]);
      Kr(4, 0) = iJ * (Ks(4, 0) * F[0] + Ks(4, 3) * F[3] + Ks(4, 5) * F[5]);
      Kr(5, 0) = iJ * (Ks(5, 0) * F[0] + Ks(5, 3) * F[3] + Ks(5, 5) * F[5]);
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * F[1] + Ks(0, 4) * F[4] + Ks(0, 7) * F[7]);
      Kr(1, 1) = iJ * (Ks(1, 1) * F[1] + Ks(1, 4) * F[4] + Ks(1, 7) * F[7]);
      Kr(2, 1) = iJ * (Ks(2, 1) * F[1] + Ks(2, 4) * F[4] + Ks(2, 7) * F[7]);
      Kr(3, 1) = iJ * (Ks(3, 1) * F[1] + Ks(3, 4) * F[4] + Ks(3, 7) * F[7]);
      Kr(4, 1) = iJ * (Ks(4, 1) * F[1] + Ks(4, 4) * F[4] + Ks(4, 7) * F[7]);
      Kr(5, 1) = iJ * (Ks(5, 1) * F[1] + Ks(5, 4) * F[4] + Ks(5, 7) * F[7]);
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * (Ks(0, 2) * F[2] + Ks(0, 6) * F[6] + Ks(0, 8) * F[8]);
      Kr(1, 2) = iJ * (Ks(1, 2) * F[2] + Ks(1, 6) * F[6] + Ks(1, 8) * F[8]);
      Kr(2, 2) = iJ * (Ks(2, 2) * F[2] + Ks(2, 6) * F[6] + Ks(2, 8) * F[8]);
      Kr(3, 2) = iJ * (Ks(3, 2) * F[2] + Ks(3, 6) * F[6] + Ks(3, 8) * F[8]);
      Kr(4, 2) = iJ * (Ks(4, 2) * F[2] + Ks(4, 6) * F[6] + Ks(4, 8) * F[8]);
      Kr(5, 2) = iJ * (Ks(5, 2) * F[2] + Ks(5, 6) * F[6] + Ks(5, 8) * F[8]);
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                 (Ks(0, 0) * F[4] + Ks(0, 1) * F[3] + Ks(0, 3) * F[1] +
                  Ks(0, 4) * F[0] + Ks(0, 5) * F[7] + Ks(0, 7) * F[5]);
      Kr(1, 3) = iJ * icste *
                 (Ks(1, 0) * F[4] + Ks(1, 1) * F[3] + Ks(1, 3) * F[1] +
                  Ks(1, 4) * F[0] + Ks(1, 5) * F[7] + Ks(1, 7) * F[5]);
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * F[4] + Ks(2, 1) * F[3] + Ks(2, 3) * F[1] +
                  Ks(2, 4) * F[0] + Ks(2, 5) * F[7] + Ks(2, 7) * F[5]);
      Kr(3, 3) = iJ * icste *
                 (Ks(3, 0) * F[4] + Ks(3, 1) * F[3] + Ks(3, 3) * F[1] +
                  Ks(3, 4) * F[0] + Ks(3, 5) * F[7] + Ks(3, 7) * F[5]);
      Kr(4, 3) = iJ * icste *
                 (Ks(4, 0) * F[4] + Ks(4, 1) * F[3] + Ks(4, 3) * F[1] +
                  Ks(4, 4) * F[0] + Ks(4, 5) * F[7] + Ks(4, 7) * F[5]);
      Kr(5, 3) = iJ * icste *
                 (Ks(5, 0) * F[4] + Ks(5, 1) * F[3] + Ks(5, 3) * F[1] +
                  Ks(5, 4) * F[0] + Ks(5, 5) * F[7] + Ks(5, 7) * F[5]);
      // column associated with the component (0, 2) of the rate of deformation
      Kr(0, 4) = iJ * icste *
                 (Ks(0, 0) * F[6] + Ks(0, 2) * F[5] + Ks(0, 3) * F[8] +
                  Ks(0, 5) * F[2] + Ks(0, 6) * F[0] + Ks(0, 8) * F[3]);
      Kr(1, 4) = iJ * icste *
                 (Ks(1, 0) * F[6] + Ks(1, 2) * F[5] + Ks(1, 3) * F[8] +
                  Ks(1, 5) * F[2] + Ks(1, 6) * F[0] + Ks(1, 8) * F[3]);
      Kr(2, 4) = iJ * icste *
                 (Ks(2, 0) * F[6] + Ks(2, 2) * F[5] + Ks(2, 3) * F[8] +
                  Ks(2, 5) * F[2] + Ks(2, 6) * F[0] + Ks(2, 8) * F[3]);
      Kr(3, 4) = iJ * icste *
                 (Ks(3, 0) * F[6] + Ks(3, 2) * F[5] + Ks(3, 3) * F[8] +
                  Ks(3, 5) * F[2] + Ks(3, 6) * F[0] + Ks(3, 8) * F[3]);
      Kr(4, 4) = iJ * icste *
                 (Ks(4, 0) * F[6] + Ks(4, 2) * F[5] + Ks(4, 3) * F[8] +
                  Ks(4, 5) * F[2] + Ks(4, 6) * F[0] + Ks(4, 8) * F[3]);
      Kr(5, 4) = iJ * icste *
                 (Ks(5, 0) * F[6] + Ks(5, 2) * F[5] + Ks(5, 3) * F[8] +
                  Ks(5, 5) * F[2] + Ks(5, 6) * F[0] + Ks(5, 8) * F[3]);
      // column associated with the component (1, 2) of the rate of deformation
      Kr(0, 5) = iJ * icste *
                 (Ks(0, 1) * F[8] + Ks(0, 2) * F[7] + Ks(0, 4) * F[6] +
                  Ks(0, 6) * F[4] + Ks(0, 7) * F[2] + Ks(0, 8) * F[1]);
      Kr(1, 5) = iJ * icste *
                 (Ks(1, 1) * F[8] + Ks(1, 2) * F[7] + Ks(1, 4) * F[6] +
                  Ks(1, 6) * F[4] + Ks(1, 7) * F[2] + Ks(1, 8) * F[1]);
      Kr(2, 5) = iJ * icste *
                 (Ks(2, 1) * F[8] + Ks(2, 2) * F[7] + Ks(2, 4) * F[6] +
                  Ks(2, 6) * F[4] + Ks(2, 7) * F[2] + Ks(2, 8) * F[1]);
      Kr(3, 5) = iJ * icste *
                 (Ks(3, 1) * F[8] + Ks(3, 2) * F[7] + Ks(3, 4) * F[6] +
                  Ks(3, 6) * F[4] + Ks(3, 7) * F[2] + Ks(3, 8) * F[1]);
      Kr(4, 5) = iJ * icste *
                 (Ks(4, 1) * F[8] + Ks(4, 2) * F[7] + Ks(4, 4) * F[6] +
                  Ks(4, 6) * F[4] + Ks(4, 7) * F[2] + Ks(4, 8) * F[1]);
      Kr(5, 5) = iJ * icste *
                 (Ks(5, 1) * F[8] + Ks(5, 2) * F[7] + Ks(5, 4) * F[6] +
                  Ks(5, 6) * F[4] + Ks(5, 7) * F[2] + Ks(5, 8) * F[1]);
    }
  };  // end of struct DTAU_DF_to_ABAQUS_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient increment (DTAU_DDF) to the derivative of the
   * Kirchhoff stress with respect to the deformation gradient (DTAU_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * and DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DDF_to_DTAU_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DDF_to_DTAU_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * iF0[0];
      Kr(0, 1) = Ks(0, 1) * iF0[1];
      Kr(0, 2) = Ks(0, 2) * iF0[2];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * iF0[0];
      Kr(1, 1) = Ks(1, 1) * iF0[1];
      Kr(1, 2) = Ks(1, 2) * iF0[2];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * iF0[0];
      Kr(2, 1) = Ks(2, 1) * iF0[1];
      Kr(2, 2) = Ks(2, 2) * iF0[2];
    }
  };  // end of struct DTAU_DDF_to_DTAU_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DDF_to_DTAU_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * iF0[0] + Ks(0, 3) * iF0[3];
      Kr(0, 1) = Ks(0, 1) * iF0[1] + Ks(0, 4) * iF0[4];
      Kr(0, 2) = Ks(0, 2) * iF0[2];
      Kr(0, 3) = Ks(0, 0) * iF0[4] + Ks(0, 3) * iF0[1];
      Kr(0, 4) = Ks(0, 1) * iF0[3] + Ks(0, 4) * iF0[0];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * iF0[0] + Ks(1, 3) * iF0[3];
      Kr(1, 1) = Ks(1, 1) * iF0[1] + Ks(1, 4) * iF0[4];
      Kr(1, 2) = Ks(1, 2) * iF0[2];
      Kr(1, 3) = Ks(1, 0) * iF0[4] + Ks(1, 3) * iF0[1];
      Kr(1, 4) = Ks(1, 1) * iF0[3] + Ks(1, 4) * iF0[0];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * iF0[0] + Ks(2, 3) * iF0[3];
      Kr(2, 1) = Ks(2, 1) * iF0[1] + Ks(2, 4) * iF0[4];
      Kr(2, 2) = Ks(2, 2) * iF0[2];
      Kr(2, 3) = Ks(2, 0) * iF0[4] + Ks(2, 3) * iF0[1];
      Kr(2, 4) = Ks(2, 1) * iF0[3] + Ks(2, 4) * iF0[0];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * iF0[0] + Ks(3, 3) * iF0[3];
      Kr(3, 1) = Ks(3, 1) * iF0[1] + Ks(3, 4) * iF0[4];
      Kr(3, 2) = Ks(3, 2) * iF0[2];
      Kr(3, 3) = Ks(3, 0) * iF0[4] + Ks(3, 3) * iF0[1];
      Kr(3, 4) = Ks(3, 1) * iF0[3] + Ks(3, 4) * iF0[0];
    }
  };  // end of struct DTAU_DDF_to_DTAU_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DDF_to_DTAU_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * iF0[0] + Ks(0, 3) * iF0[3] + Ks(0, 5) * iF0[5];
      Kr(0, 1) = Ks(0, 1) * iF0[1] + Ks(0, 4) * iF0[4] + Ks(0, 7) * iF0[7];
      Kr(0, 2) = Ks(0, 2) * iF0[2] + Ks(0, 6) * iF0[6] + Ks(0, 8) * iF0[8];
      Kr(0, 3) = Ks(0, 0) * iF0[4] + Ks(0, 3) * iF0[1] + Ks(0, 5) * iF0[7];
      Kr(0, 4) = Ks(0, 1) * iF0[3] + Ks(0, 4) * iF0[0] + Ks(0, 7) * iF0[5];
      Kr(0, 5) = Ks(0, 0) * iF0[6] + Ks(0, 3) * iF0[8] + Ks(0, 5) * iF0[2];
      Kr(0, 6) = Ks(0, 2) * iF0[5] + Ks(0, 6) * iF0[0] + Ks(0, 8) * iF0[3];
      Kr(0, 7) = Ks(0, 1) * iF0[8] + Ks(0, 4) * iF0[6] + Ks(0, 7) * iF0[2];
      Kr(0, 8) = Ks(0, 2) * iF0[7] + Ks(0, 6) * iF0[4] + Ks(0, 8) * iF0[1];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * iF0[0] + Ks(1, 3) * iF0[3] + Ks(1, 5) * iF0[5];
      Kr(1, 1) = Ks(1, 1) * iF0[1] + Ks(1, 4) * iF0[4] + Ks(1, 7) * iF0[7];
      Kr(1, 2) = Ks(1, 2) * iF0[2] + Ks(1, 6) * iF0[6] + Ks(1, 8) * iF0[8];
      Kr(1, 3) = Ks(1, 0) * iF0[4] + Ks(1, 3) * iF0[1] + Ks(1, 5) * iF0[7];
      Kr(1, 4) = Ks(1, 1) * iF0[3] + Ks(1, 4) * iF0[0] + Ks(1, 7) * iF0[5];
      Kr(1, 5) = Ks(1, 0) * iF0[6] + Ks(1, 3) * iF0[8] + Ks(1, 5) * iF0[2];
      Kr(1, 6) = Ks(1, 2) * iF0[5] + Ks(1, 6) * iF0[0] + Ks(1, 8) * iF0[3];
      Kr(1, 7) = Ks(1, 1) * iF0[8] + Ks(1, 4) * iF0[6] + Ks(1, 7) * iF0[2];
      Kr(1, 8) = Ks(1, 2) * iF0[7] + Ks(1, 6) * iF0[4] + Ks(1, 8) * iF0[1];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * iF0[0] + Ks(2, 3) * iF0[3] + Ks(2, 5) * iF0[5];
      Kr(2, 1) = Ks(2, 1) * iF0[1] + Ks(2, 4) * iF0[4] + Ks(2, 7) * iF0[7];
      Kr(2, 2) = Ks(2, 2) * iF0[2] + Ks(2, 6) * iF0[6] + Ks(2, 8) * iF0[8];
      Kr(2, 3) = Ks(2, 0) * iF0[4] + Ks(2, 3) * iF0[1] + Ks(2, 5) * iF0[7];
      Kr(2, 4) = Ks(2, 1) * iF0[3] + Ks(2, 4) * iF0[0] + Ks(2, 7) * iF0[5];
      Kr(2, 5) = Ks(2, 0) * iF0[6] + Ks(2, 3) * iF0[8] + Ks(2, 5) * iF0[2];
      Kr(2, 6) = Ks(2, 2) * iF0[5] + Ks(2, 6) * iF0[0] + Ks(2, 8) * iF0[3];
      Kr(2, 7) = Ks(2, 1) * iF0[8] + Ks(2, 4) * iF0[6] + Ks(2, 7) * iF0[2];
      Kr(2, 8) = Ks(2, 2) * iF0[7] + Ks(2, 6) * iF0[4] + Ks(2, 8) * iF0[1];
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * iF0[0] + Ks(3, 3) * iF0[3] + Ks(3, 5) * iF0[5];
      Kr(3, 1) = Ks(3, 1) * iF0[1] + Ks(3, 4) * iF0[4] + Ks(3, 7) * iF0[7];
      Kr(3, 2) = Ks(3, 2) * iF0[2] + Ks(3, 6) * iF0[6] + Ks(3, 8) * iF0[8];
      Kr(3, 3) = Ks(3, 0) * iF0[4] + Ks(3, 3) * iF0[1] + Ks(3, 5) * iF0[7];
      Kr(3, 4) = Ks(3, 1) * iF0[3] + Ks(3, 4) * iF0[0] + Ks(3, 7) * iF0[5];
      Kr(3, 5) = Ks(3, 0) * iF0[6] + Ks(3, 3) * iF0[8] + Ks(3, 5) * iF0[2];
      Kr(3, 6) = Ks(3, 2) * iF0[5] + Ks(3, 6) * iF0[0] + Ks(3, 8) * iF0[3];
      Kr(3, 7) = Ks(3, 1) * iF0[8] + Ks(3, 4) * iF0[6] + Ks(3, 7) * iF0[2];
      Kr(3, 8) = Ks(3, 2) * iF0[7] + Ks(3, 6) * iF0[4] + Ks(3, 8) * iF0[1];
      // derivatives of the component (0, 2) of the stress
      Kr(4, 0) = Ks(4, 0) * iF0[0] + Ks(4, 3) * iF0[3] + Ks(4, 5) * iF0[5];
      Kr(4, 1) = Ks(4, 1) * iF0[1] + Ks(4, 4) * iF0[4] + Ks(4, 7) * iF0[7];
      Kr(4, 2) = Ks(4, 2) * iF0[2] + Ks(4, 6) * iF0[6] + Ks(4, 8) * iF0[8];
      Kr(4, 3) = Ks(4, 0) * iF0[4] + Ks(4, 3) * iF0[1] + Ks(4, 5) * iF0[7];
      Kr(4, 4) = Ks(4, 1) * iF0[3] + Ks(4, 4) * iF0[0] + Ks(4, 7) * iF0[5];
      Kr(4, 5) = Ks(4, 0) * iF0[6] + Ks(4, 3) * iF0[8] + Ks(4, 5) * iF0[2];
      Kr(4, 6) = Ks(4, 2) * iF0[5] + Ks(4, 6) * iF0[0] + Ks(4, 8) * iF0[3];
      Kr(4, 7) = Ks(4, 1) * iF0[8] + Ks(4, 4) * iF0[6] + Ks(4, 7) * iF0[2];
      Kr(4, 8) = Ks(4, 2) * iF0[7] + Ks(4, 6) * iF0[4] + Ks(4, 8) * iF0[1];
      // derivatives of the component (1, 2) of the stress
      Kr(5, 0) = Ks(5, 0) * iF0[0] + Ks(5, 3) * iF0[3] + Ks(5, 5) * iF0[5];
      Kr(5, 1) = Ks(5, 1) * iF0[1] + Ks(5, 4) * iF0[4] + Ks(5, 7) * iF0[7];
      Kr(5, 2) = Ks(5, 2) * iF0[2] + Ks(5, 6) * iF0[6] + Ks(5, 8) * iF0[8];
      Kr(5, 3) = Ks(5, 0) * iF0[4] + Ks(5, 3) * iF0[1] + Ks(5, 5) * iF0[7];
      Kr(5, 4) = Ks(5, 1) * iF0[3] + Ks(5, 4) * iF0[0] + Ks(5, 7) * iF0[5];
      Kr(5, 5) = Ks(5, 0) * iF0[6] + Ks(5, 3) * iF0[8] + Ks(5, 5) * iF0[2];
      Kr(5, 6) = Ks(5, 2) * iF0[5] + Ks(5, 6) * iF0[0] + Ks(5, 8) * iF0[3];
      Kr(5, 7) = Ks(5, 1) * iF0[8] + Ks(5, 4) * iF0[6] + Ks(5, 7) * iF0[2];
      Kr(5, 8) = Ks(5, 2) * iF0[7] + Ks(5, 6) * iF0[4] + Ks(5, 8) * iF0[1];
    }
  };  // end of struct DTAU_DDF_to_DTAU_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient increment (DTAU_DDF) to the derivative of the
   * Cauchy stress with respect to the deformation gradient (DSIG_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * and DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DDF_to_DSIG_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DDF_to_DSIG_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = iJ * (Ks(0, 0) * iF0[0] - dJ[0] * s[0]);
      Kr(1, 0) = iJ * (Ks(1, 0) * iF0[0] - dJ[0] * s[1]);
      Kr(2, 0) = iJ * (Ks(2, 0) * iF0[0] - dJ[0] * s[2]);
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = iJ * (Ks(0, 1) * iF0[1] - dJ[1] * s[0]);
      Kr(1, 1) = iJ * (Ks(1, 1) * iF0[1] - dJ[1] * s[1]);
      Kr(2, 1) = iJ * (Ks(2, 1) * iF0[1] - dJ[1] * s[2]);
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = iJ * (Ks(0, 2) * iF0[2] - dJ[2] * s[0]);
      Kr(1, 2) = iJ * (Ks(1, 2) * iF0[2] - dJ[2] * s[1]);
      Kr(2, 2) = iJ * (Ks(2, 2) * iF0[2] - dJ[2] * s[2]);
    }
  };  // end of struct DTAU_DDF_to_DSIG_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DDF_to_DSIG_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = iJ * (Ks(0, 0) * iF0[0] + Ks(0, 3) * iF0[3] - dJ[0] * s[0]);
      Kr(1, 0) = iJ * (Ks(1, 0) * iF0[0] + Ks(1, 3) * iF0[3] - dJ[0] * s[1]);
      Kr(2, 0) = iJ * (Ks(2, 0) * iF0[0] + Ks(2, 3) * iF0[3] - dJ[0] * s[2]);
      Kr(3, 0) = iJ * (Ks(3, 0) * iF0[0] + Ks(3, 3) * iF0[3] - dJ[0] * s[3]);
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = iJ * (Ks(0, 1) * iF0[1] + Ks(0, 4) * iF0[4] - dJ[1] * s[0]);
      Kr(1, 1) = iJ * (Ks(1, 1) * iF0[1] + Ks(1, 4) * iF0[4] - dJ[1] * s[1]);
      Kr(2, 1) = iJ * (Ks(2, 1) * iF0[1] + Ks(2, 4) * iF0[4] - dJ[1] * s[2]);
      Kr(3, 1) = iJ * (Ks(3, 1) * iF0[1] + Ks(3, 4) * iF0[4] - dJ[1] * s[3]);
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = iJ * (Ks(0, 2) * iF0[2] - dJ[2] * s[0]);
      Kr(1, 2) = iJ * (Ks(1, 2) * iF0[2] - dJ[2] * s[1]);
      Kr(2, 2) = iJ * (Ks(2, 2) * iF0[2] - dJ[2] * s[2]);
      Kr(3, 2) = iJ * (Ks(3, 2) * iF0[2] - dJ[2] * s[3]);
      // derivative with respect to the component (0, 1) of the deformation
      // gradient
      Kr(0, 3) = iJ * (Ks(0, 0) * iF0[4] + Ks(0, 3) * iF0[1] - dJ[3] * s[0]);
      Kr(1, 3) = iJ * (Ks(1, 0) * iF0[4] + Ks(1, 3) * iF0[1] - dJ[3] * s[1]);
      Kr(2, 3) = iJ * (Ks(2, 0) * iF0[4] + Ks(2, 3) * iF0[1] - dJ[3] * s[2]);
      Kr(3, 3) = iJ * (Ks(3, 0) * iF0[4] + Ks(3, 3) * iF0[1] - dJ[3] * s[3]);
      // derivative with respect to the component (1, 0) of the deformation
      // gradient
      Kr(0, 4) = iJ * (Ks(0, 1) * iF0[3] + Ks(0, 4) * iF0[0] - dJ[4] * s[0]);
      Kr(1, 4) = iJ * (Ks(1, 1) * iF0[3] + Ks(1, 4) * iF0[0] - dJ[4] * s[1]);
      Kr(2, 4) = iJ * (Ks(2, 1) * iF0[3] + Ks(2, 4) * iF0[0] - dJ[4] * s[2]);
      Kr(3, 4) = iJ * (Ks(3, 1) * iF0[3] + Ks(3, 4) * iF0[0] - dJ[4] * s[3]);
    }
  };  // end of struct DTAU_DDF_to_DSIG_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DDF_to_DSIG_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = iJ * (Ks(0, 0) * iF0[0] + Ks(0, 3) * iF0[3] +
                       Ks(0, 5) * iF0[5] - dJ[0] * s[0]);
      Kr(1, 0) = iJ * (Ks(1, 0) * iF0[0] + Ks(1, 3) * iF0[3] +
                       Ks(1, 5) * iF0[5] - dJ[0] * s[1]);
      Kr(2, 0) = iJ * (Ks(2, 0) * iF0[0] + Ks(2, 3) * iF0[3] +
                       Ks(2, 5) * iF0[5] - dJ[0] * s[2]);
      Kr(3, 0) = iJ * (Ks(3, 0) * iF0[0] + Ks(3, 3) * iF0[3] +
                       Ks(3, 5) * iF0[5] - dJ[0] * s[3]);
      Kr(4, 0) = iJ * (Ks(4, 0) * iF0[0] + Ks(4, 3) * iF0[3] +
                       Ks(4, 5) * iF0[5] - dJ[0] * s[4]);
      Kr(5, 0) = iJ * (Ks(5, 0) * iF0[0] + Ks(5, 3) * iF0[3] +
                       Ks(5, 5) * iF0[5] - dJ[0] * s[5]);
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = iJ * (Ks(0, 1) * iF0[1] + Ks(0, 4) * iF0[4] +
                       Ks(0, 7) * iF0[7] - dJ[1] * s[0]);
      Kr(1, 1) = iJ * (Ks(1, 1) * iF0[1] + Ks(1, 4) * iF0[4] +
                       Ks(1, 7) * iF0[7] - dJ[1] * s[1]);
      Kr(2, 1) = iJ * (Ks(2, 1) * iF0[1] + Ks(2, 4) * iF0[4] +
                       Ks(2, 7) * iF0[7] - dJ[1] * s[2]);
      Kr(3, 1) = iJ * (Ks(3, 1) * iF0[1] + Ks(3, 4) * iF0[4] +
                       Ks(3, 7) * iF0[7] - dJ[1] * s[3]);
      Kr(4, 1) = iJ * (Ks(4, 1) * iF0[1] + Ks(4, 4) * iF0[4] +
                       Ks(4, 7) * iF0[7] - dJ[1] * s[4]);
      Kr(5, 1) = iJ * (Ks(5, 1) * iF0[1] + Ks(5, 4) * iF0[4] +
                       Ks(5, 7) * iF0[7] - dJ[1] * s[5]);
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = iJ * (Ks(0, 2) * iF0[2] + Ks(0, 6) * iF0[6] +
                       Ks(0, 8) * iF0[8] - dJ[2] * s[0]);
      Kr(1, 2) = iJ * (Ks(1, 2) * iF0[2] + Ks(1, 6) * iF0[6] +
                       Ks(1, 8) * iF0[8] - dJ[2] * s[1]);
      Kr(2, 2) = iJ * (Ks(2, 2) * iF0[2] + Ks(2, 6) * iF0[6] +
                       Ks(2, 8) * iF0[8] - dJ[2] * s[2]);
      Kr(3, 2) = iJ * (Ks(3, 2) * iF0[2] + Ks(3, 6) * iF0[6] +
                       Ks(3, 8) * iF0[8] - dJ[2] * s[3]);
      Kr(4, 2) = iJ * (Ks(4, 2) * iF0[2] + Ks(4, 6) * iF0[6] +
                       Ks(4, 8) * iF0[8] - dJ[2] * s[4]);
      Kr(5, 2) = iJ * (Ks(5, 2) * iF0[2] + Ks(5, 6) * iF0[6] +
                       Ks(5, 8) * iF0[8] - dJ[2] * s[5]);
      // derivative with respect to the component (0, 1) of the deformation
      // gradient
      Kr(0, 3) = iJ * (Ks(0, 0) * iF0[4] + Ks(0, 3) * iF0[1] +
                       Ks(0, 5) * iF0[7] - dJ[3] * s[0]);
      Kr(1, 3) = iJ * (Ks(1, 0) * iF0[4] + Ks(1, 3) * iF0[1] +
                       Ks(1, 5) * iF0[7] - dJ[3] * s[1]);
      Kr(2, 3) = iJ * (Ks(2, 0) * iF0[4] + Ks(2, 3) * iF0[1] +
                       Ks(2, 5) * iF0[7] - dJ[3] * s[2]);
      Kr(3, 3) = iJ * (Ks(3, 0) * iF0[4] + Ks(3, 3) * iF0[1] +
                       Ks(3, 5) * iF0[7] - dJ[3] * s[3]);
      Kr(4, 3) = iJ * (Ks(4, 0) * iF0[4] + Ks(4, 3) * iF0[1] +
                       Ks(4, 5) * iF0[7] - dJ[3] * s[4]);
      Kr(5, 3) = iJ * (Ks(5, 0) * iF0[4] + Ks(5, 3) * iF0[1] +
                       Ks(5, 5) * iF0[7] - dJ[3] * s[5]);
      // derivative with respect to the component (1, 0) of the deformation
      // gradient
      Kr(0, 4) = iJ * (Ks(0, 1) * iF0[3] + Ks(0, 4) * iF0[0] +
                       Ks(0, 7) * iF0[5] - dJ[4] * s[0]);
      Kr(1, 4) = iJ * (Ks(1, 1) * iF0[3] + Ks(1, 4) * iF0[0] +
                       Ks(1, 7) * iF0[5] - dJ[4] * s[1]);
      Kr(2, 4) = iJ * (Ks(2, 1) * iF0[3] + Ks(2, 4) * iF0[0] +
                       Ks(2, 7) * iF0[5] - dJ[4] * s[2]);
      Kr(3, 4) = iJ * (Ks(3, 1) * iF0[3] + Ks(3, 4) * iF0[0] +
                       Ks(3, 7) * iF0[5] - dJ[4] * s[3]);
      Kr(4, 4) = iJ * (Ks(4, 1) * iF0[3] + Ks(4, 4) * iF0[0] +
                       Ks(4, 7) * iF0[5] - dJ[4] * s[4]);
      Kr(5, 4) = iJ * (Ks(5, 1) * iF0[3] + Ks(5, 4) * iF0[0] +
                       Ks(5, 7) * iF0[5] - dJ[4] * s[5]);
      // derivative with respect to the component (0, 2) of the deformation
      // gradient
      Kr(0, 5) = iJ * (Ks(0, 0) * iF0[6] + Ks(0, 3) * iF0[8] +
                       Ks(0, 5) * iF0[2] - dJ[5] * s[0]);
      Kr(1, 5) = iJ * (Ks(1, 0) * iF0[6] + Ks(1, 3) * iF0[8] +
                       Ks(1, 5) * iF0[2] - dJ[5] * s[1]);
      Kr(2, 5) = iJ * (Ks(2, 0) * iF0[6] + Ks(2, 3) * iF0[8] +
                       Ks(2, 5) * iF0[2] - dJ[5] * s[2]);
      Kr(3, 5) = iJ * (Ks(3, 0) * iF0[6] + Ks(3, 3) * iF0[8] +
                       Ks(3, 5) * iF0[2] - dJ[5] * s[3]);
      Kr(4, 5) = iJ * (Ks(4, 0) * iF0[6] + Ks(4, 3) * iF0[8] +
                       Ks(4, 5) * iF0[2] - dJ[5] * s[4]);
      Kr(5, 5) = iJ * (Ks(5, 0) * iF0[6] + Ks(5, 3) * iF0[8] +
                       Ks(5, 5) * iF0[2] - dJ[5] * s[5]);
      // derivative with respect to the component (2, 0) of the deformation
      // gradient
      Kr(0, 6) = iJ * (Ks(0, 2) * iF0[5] + Ks(0, 6) * iF0[0] +
                       Ks(0, 8) * iF0[3] - dJ[6] * s[0]);
      Kr(1, 6) = iJ * (Ks(1, 2) * iF0[5] + Ks(1, 6) * iF0[0] +
                       Ks(1, 8) * iF0[3] - dJ[6] * s[1]);
      Kr(2, 6) = iJ * (Ks(2, 2) * iF0[5] + Ks(2, 6) * iF0[0] +
                       Ks(2, 8) * iF0[3] - dJ[6] * s[2]);
      Kr(3, 6) = iJ * (Ks(3, 2) * iF0[5] + Ks(3, 6) * iF0[0] +
                       Ks(3, 8) * iF0[3] - dJ[6] * s[3]);
      Kr(4, 6) = iJ * (Ks(4, 2) * iF0[5] + Ks(4, 6) * iF0[0] +
                       Ks(4, 8) * iF0[3] - dJ[6] * s[4]);
      Kr(5, 6) = iJ * (Ks(5, 2) * iF0[5] + Ks(5, 6) * iF0[0] +
                       Ks(5, 8) * iF0[3] - dJ[6] * s[5]);
      // derivative with respect to the component (1, 2) of the deformation
      // gradient
      Kr(0, 7) = iJ * (Ks(0, 1) * iF0[8] + Ks(0, 4) * iF0[6] +
                       Ks(0, 7) * iF0[2] - dJ[7] * s[0]);
      Kr(1, 7) = iJ * (Ks(1, 1) * iF0[8] + Ks(1, 4) * iF0[6] +
                       Ks(1, 7) * iF0[2] - dJ[7] * s[1]);
      Kr(2, 7) = iJ * (Ks(2, 1) * iF0[8] + Ks(2, 4) * iF0[6] +
                       Ks(2, 7) * iF0[2] - dJ[7] * s[2]);
      Kr(3, 7) = iJ * (Ks(3, 1) * iF0[8] + Ks(3, 4) * iF0[6] +
                       Ks(3, 7) * iF0[2] - dJ[7] * s[3]);
      Kr(4, 7) = iJ * (Ks(4, 1) * iF0[8] + Ks(4, 4) * iF0[6] +
                       Ks(4, 7) * iF0[2] - dJ[7] * s[4]);
      Kr(5, 7) = iJ * (Ks(5, 1) * iF0[8] + Ks(5, 4) * iF0[6] +
                       Ks(5, 7) * iF0[2] - dJ[7] * s[5]);
      // derivative with respect to the component (2, 1) of the deformation
      // gradient
      Kr(0, 8) = iJ * (Ks(0, 2) * iF0[7] + Ks(0, 6) * iF0[4] +
                       Ks(0, 8) * iF0[1] - dJ[8] * s[0]);
      Kr(1, 8) = iJ * (Ks(1, 2) * iF0[7] + Ks(1, 6) * iF0[4] +
                       Ks(1, 8) * iF0[1] - dJ[8] * s[1]);
      Kr(2, 8) = iJ * (Ks(2, 2) * iF0[7] + Ks(2, 6) * iF0[4] +
                       Ks(2, 8) * iF0[1] - dJ[8] * s[2]);
      Kr(3, 8) = iJ * (Ks(3, 2) * iF0[7] + Ks(3, 6) * iF0[4] +
                       Ks(3, 8) * iF0[1] - dJ[8] * s[3]);
      Kr(4, 8) = iJ * (Ks(4, 2) * iF0[7] + Ks(4, 6) * iF0[4] +
                       Ks(4, 8) * iF0[1] - dJ[8] * s[4]);
      Kr(5, 8) = iJ * (Ks(5, 2) * iF0[7] + Ks(5, 6) * iF0[4] +
                       Ks(5, 8) * iF0[1] - dJ[8] * s[5]);
    }
  };  // end of struct DTAU_DDF_to_DSIG_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient increment (DTAU_DDF) to the derivative of the
   * second Piola-Kirchhoff stress with respect to the Green-Lagrange strain
   * (DS_DEGL).
   * The result is computed column by column, i.e. component by component of the
   * Green-Lagrange strain. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * and DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DDF_to_DS_DEGL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DDF_to_DS_DEGL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto iF0 = tfel::math::invert(F0);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto x0 = iF0[0] * iF[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 0) = u0 * iF[0] - 2 * S[0] * iC[0];
        Kr(1, 0) = u1 * iF[1];
        Kr(2, 0) = u2 * iF[2];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto x1 = iF0[1] * iF[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 1) = u0 * iF[0];
        Kr(1, 1) = u1 * iF[1] - 2 * S[1] * iC[1];
        Kr(2, 1) = u2 * iF[2];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto x2 = iF0[2] * iF[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 2) = u0 * iF[0];
        Kr(1, 2) = u1 * iF[1];
        Kr(2, 2) = u2 * iF[2] - 2 * S[2] * iC[2];
      }
    }
  };  // end of struct DTAU_DDF_to_DS_DEGL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DDF_to_DS_DEGL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto iF0 = tfel::math::invert(F0);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto x0 = iF0[0] * iF[0];
        const auto x1 = iF0[3] * iF[3];
        const auto x3 = iF0[3] * iF[0];
        const auto x4 = iF0[0] * iF[3];
        const auto a0 =
            Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 =
            Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 =
            Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3 +
                                 Ks(3, 4) * x4);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 0) = u0 * iF[0] + u3 * iF[3] - 2 * S[0] * iC[0];
        Kr(1, 0) = u1 * iF[1] + u4 * iF[4] - S[3] * iC[3];
        Kr(2, 0) = u2 * iF[2];
        Kr(3, 0) =
            cste * (u0 * iF[4] + u3 * iF[1]) - S[0] * iC[3] - S[3] * iC[0];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto x0 = iF0[4] * iF[4];
        const auto x1 = iF0[1] * iF[1];
        const auto x3 = iF0[1] * iF[4];
        const auto x4 = iF0[4] * iF[1];
        const auto a0 =
            Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 =
            Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 =
            Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3 +
                                 Ks(3, 4) * x4);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 1) = u0 * iF[0] + u3 * iF[3] - S[3] * iC[3];
        Kr(1, 1) = u1 * iF[1] + u4 * iF[4] - 2 * S[1] * iC[1];
        Kr(2, 1) = u2 * iF[2];
        Kr(3, 1) =
            cste * (u0 * iF[4] + u3 * iF[1]) - S[1] * iC[3] - S[3] * iC[1];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto x2 = iF0[2] * iF[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 2) = u0 * iF[0] + u3 * iF[3];
        Kr(1, 2) = u1 * iF[1] + u4 * iF[4];
        Kr(2, 2) = u2 * iF[2] - 2 * S[2] * iC[2];
        Kr(3, 2) = cste * (u0 * iF[4] + u3 * iF[1]);
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto x0 = icste * (iF0[0] * iF[4] + iF0[4] * iF[0]);
        const auto x1 = icste * (iF0[1] * iF[3] + iF0[3] * iF[1]);
        const auto x3 = icste * (iF0[1] * iF[0] + iF0[3] * iF[4]);
        const auto x4 = icste * (iF0[0] * iF[1] + iF0[4] * iF[3]);
        const auto a0 =
            Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 =
            Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 =
            Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3 +
                                 Ks(3, 4) * x4);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 3) = u0 * iF[0] + u3 * iF[3] - S[0] * iC[3] - S[3] * iC[0];
        Kr(1, 3) = u1 * iF[1] + u4 * iF[4] - S[1] * iC[3] - S[3] * iC[1];
        Kr(2, 3) = u2 * iF[2];
        Kr(3, 3) = cste * (u0 * iF[4] + u3 * iF[1]) - S[0] * iC[1] -
                   S[1] * iC[0] - S[3] * iC[3];
      }
    }
  };  // end of struct DTAU_DDF_to_DS_DEGL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DDF_to_DS_DEGL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto iF0 = tfel::math::invert(F0);
      const auto iC = tfel::math::computeLeftCauchyGreenTensor(iF);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto x0 = iF0[0] * iF[0];
        const auto x1 = iF0[3] * iF[3];
        const auto x2 = iF0[5] * iF[5];
        const auto x3 = iF0[3] * iF[0];
        const auto x4 = iF0[0] * iF[3];
        const auto x5 = iF0[5] * iF[0];
        const auto x6 = iF0[0] * iF[5];
        const auto x7 = iF0[5] * iF[3];
        const auto x8 = iF0[3] * iF[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5 +
                        Ks(0, 6) * x6 + Ks(0, 7) * x7 + Ks(0, 8) * x8;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5 +
                        Ks(1, 6) * x6 + Ks(1, 7) * x7 + Ks(1, 8) * x8;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5 +
                        Ks(2, 6) * x6 + Ks(2, 7) * x7 + Ks(2, 8) * x8;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5 +
                                 Ks(3, 6) * x6 + Ks(3, 7) * x7 + Ks(3, 8) * x8);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                                 Ks(4, 6) * x6 + Ks(4, 7) * x7 + Ks(4, 8) * x8);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                                 Ks(5, 6) * x6 + Ks(5, 7) * x7 + Ks(5, 8) * x8);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 0) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - 2 * S[0] * iC[0];
        Kr(1, 0) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[3] * iC[3];
        Kr(2, 0) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[4] * iC[4];
        Kr(3, 0) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   S[0] * iC[3] - S[3] * iC[0];
        Kr(4, 0) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   S[0] * iC[4] - S[4] * iC[0];
        Kr(5, 0) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[3] * iC[4] + S[4] * iC[3]);
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto x0 = iF0[4] * iF[4];
        const auto x1 = iF0[1] * iF[1];
        const auto x2 = iF0[7] * iF[7];
        const auto x3 = iF0[1] * iF[4];
        const auto x4 = iF0[4] * iF[1];
        const auto x5 = iF0[7] * iF[4];
        const auto x6 = iF0[4] * iF[7];
        const auto x7 = iF0[7] * iF[1];
        const auto x8 = iF0[1] * iF[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5 +
                        Ks(0, 6) * x6 + Ks(0, 7) * x7 + Ks(0, 8) * x8;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5 +
                        Ks(1, 6) * x6 + Ks(1, 7) * x7 + Ks(1, 8) * x8;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5 +
                        Ks(2, 6) * x6 + Ks(2, 7) * x7 + Ks(2, 8) * x8;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5 +
                                 Ks(3, 6) * x6 + Ks(3, 7) * x7 + Ks(3, 8) * x8);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                                 Ks(4, 6) * x6 + Ks(4, 7) * x7 + Ks(4, 8) * x8);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                                 Ks(5, 6) * x6 + Ks(5, 7) * x7 + Ks(5, 8) * x8);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 1) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[3] * iC[3];
        Kr(1, 1) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - 2 * S[1] * iC[1];
        Kr(2, 1) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[5] * iC[5];
        Kr(3, 1) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   S[1] * iC[3] - S[3] * iC[1];
        Kr(4, 1) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[3] * iC[5] + S[5] * iC[3]);
        Kr(5, 1) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   S[1] * iC[5] - S[5] * iC[1];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto x0 = iF0[6] * iF[6];
        const auto x1 = iF0[8] * iF[8];
        const auto x2 = iF0[2] * iF[2];
        const auto x3 = iF0[8] * iF[6];
        const auto x4 = iF0[6] * iF[8];
        const auto x5 = iF0[2] * iF[6];
        const auto x6 = iF0[6] * iF[2];
        const auto x7 = iF0[2] * iF[8];
        const auto x8 = iF0[8] * iF[2];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5 +
                        Ks(0, 6) * x6 + Ks(0, 7) * x7 + Ks(0, 8) * x8;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5 +
                        Ks(1, 6) * x6 + Ks(1, 7) * x7 + Ks(1, 8) * x8;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5 +
                        Ks(2, 6) * x6 + Ks(2, 7) * x7 + Ks(2, 8) * x8;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5 +
                                 Ks(3, 6) * x6 + Ks(3, 7) * x7 + Ks(3, 8) * x8);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                                 Ks(4, 6) * x6 + Ks(4, 7) * x7 + Ks(4, 8) * x8);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                                 Ks(5, 6) * x6 + Ks(5, 7) * x7 + Ks(5, 8) * x8);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 2) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[4] * iC[4];
        Kr(1, 2) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[5] * iC[5];
        Kr(2, 2) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - 2 * S[2] * iC[2];
        Kr(3, 2) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[4] * iC[5] + S[5] * iC[4]);
        Kr(4, 2) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   S[2] * iC[4] - S[4] * iC[2];
        Kr(5, 2) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   S[2] * iC[5] - S[5] * iC[2];
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto x0 = icste * (iF0[0] * iF[4] + iF0[4] * iF[0]);
        const auto x1 = icste * (iF0[1] * iF[3] + iF0[3] * iF[1]);
        const auto x2 = icste * (iF0[5] * iF[7] + iF0[7] * iF[5]);
        const auto x3 = icste * (iF0[1] * iF[0] + iF0[3] * iF[4]);
        const auto x4 = icste * (iF0[0] * iF[1] + iF0[4] * iF[3]);
        const auto x5 = icste * (iF0[5] * iF[4] + iF0[7] * iF[0]);
        const auto x6 = icste * (iF0[0] * iF[7] + iF0[4] * iF[5]);
        const auto x7 = icste * (iF0[5] * iF[1] + iF0[7] * iF[3]);
        const auto x8 = icste * (iF0[1] * iF[5] + iF0[3] * iF[7]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5 +
                        Ks(0, 6) * x6 + Ks(0, 7) * x7 + Ks(0, 8) * x8;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5 +
                        Ks(1, 6) * x6 + Ks(1, 7) * x7 + Ks(1, 8) * x8;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5 +
                        Ks(2, 6) * x6 + Ks(2, 7) * x7 + Ks(2, 8) * x8;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5 +
                                 Ks(3, 6) * x6 + Ks(3, 7) * x7 + Ks(3, 8) * x8);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                                 Ks(4, 6) * x6 + Ks(4, 7) * x7 + Ks(4, 8) * x8);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                                 Ks(5, 6) * x6 + Ks(5, 7) * x7 + Ks(5, 8) * x8);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 3) =
            u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[0] * iC[3] - S[3] * iC[0];
        Kr(1, 3) =
            u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[1] * iC[3] - S[3] * iC[1];
        Kr(2, 3) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8] -
                   icste * (S[4] * iC[5] + S[5] * iC[4]);
        Kr(3, 3) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   S[0] * iC[1] - S[1] * iC[0] - S[3] * iC[3];
        Kr(4, 3) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[0] * iC[5] + S[5] * iC[0]) -
                   (S[3] * iC[4] + S[4] * iC[3]) / 2;
        Kr(5, 3) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[1] * iC[4] + S[4] * iC[1]) -
                   (S[3] * iC[5] + S[5] * iC[3]) / 2;
      }
      {
        // column associated with the component (0, 2) of the Green-Lagrange
        // strain
        const auto x0 = icste * (iF0[0] * iF[6] + iF0[6] * iF[0]);
        const auto x1 = icste * (iF0[3] * iF[8] + iF0[8] * iF[3]);
        const auto x2 = icste * (iF0[2] * iF[5] + iF0[5] * iF[2]);
        const auto x3 = icste * (iF0[3] * iF[6] + iF0[8] * iF[0]);
        const auto x4 = icste * (iF0[0] * iF[8] + iF0[6] * iF[3]);
        const auto x5 = icste * (iF0[2] * iF[0] + iF0[5] * iF[6]);
        const auto x6 = icste * (iF0[0] * iF[2] + iF0[6] * iF[5]);
        const auto x7 = icste * (iF0[2] * iF[3] + iF0[5] * iF[8]);
        const auto x8 = icste * (iF0[3] * iF[2] + iF0[8] * iF[5]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5 +
                        Ks(0, 6) * x6 + Ks(0, 7) * x7 + Ks(0, 8) * x8;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5 +
                        Ks(1, 6) * x6 + Ks(1, 7) * x7 + Ks(1, 8) * x8;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5 +
                        Ks(2, 6) * x6 + Ks(2, 7) * x7 + Ks(2, 8) * x8;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5 +
                                 Ks(3, 6) * x6 + Ks(3, 7) * x7 + Ks(3, 8) * x8);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                                 Ks(4, 6) * x6 + Ks(4, 7) * x7 + Ks(4, 8) * x8);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                                 Ks(5, 6) * x6 + Ks(5, 7) * x7 + Ks(5, 8) * x8);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 4) =
            u0 * iF[0] + u3 * iF[3] + u5 * iF[5] - S[0] * iC[4] - S[4] * iC[0];
        Kr(1, 4) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7] -
                   icste * (S[3] * iC[5] + S[5] * iC[3]);
        Kr(2, 4) =
            u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[2] * iC[4] - S[4] * iC[2];
        Kr(3, 4) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[0] * iC[5] + S[5] * iC[0]) -
                   (S[3] * iC[4] + S[4] * iC[3]) / 2;
        Kr(4, 4) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   S[0] * iC[2] - S[2] * iC[0] - S[4] * iC[4];
        Kr(5, 4) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   icste * (S[2] * iC[3] + S[3] * iC[2]) -
                   (S[4] * iC[5] + S[5] * iC[4]) / 2;
      }
      {
        // column associated with the component (1, 2) of the Green-Lagrange
        // strain
        const auto x0 = icste * (iF0[4] * iF[6] + iF0[6] * iF[4]);
        const auto x1 = icste * (iF0[1] * iF[8] + iF0[8] * iF[1]);
        const auto x2 = icste * (iF0[2] * iF[7] + iF0[7] * iF[2]);
        const auto x3 = icste * (iF0[1] * iF[6] + iF0[8] * iF[4]);
        const auto x4 = icste * (iF0[4] * iF[8] + iF0[6] * iF[1]);
        const auto x5 = icste * (iF0[2] * iF[4] + iF0[7] * iF[6]);
        const auto x6 = icste * (iF0[4] * iF[2] + iF0[6] * iF[7]);
        const auto x7 = icste * (iF0[2] * iF[1] + iF0[7] * iF[8]);
        const auto x8 = icste * (iF0[1] * iF[2] + iF0[8] * iF[7]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5 +
                        Ks(0, 6) * x6 + Ks(0, 7) * x7 + Ks(0, 8) * x8;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5 +
                        Ks(1, 6) * x6 + Ks(1, 7) * x7 + Ks(1, 8) * x8;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5 +
                        Ks(2, 6) * x6 + Ks(2, 7) * x7 + Ks(2, 8) * x8;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5 +
                                 Ks(3, 6) * x6 + Ks(3, 7) * x7 + Ks(3, 8) * x8);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                                 Ks(4, 6) * x6 + Ks(4, 7) * x7 + Ks(4, 8) * x8);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                                 Ks(5, 6) * x6 + Ks(5, 7) * x7 + Ks(5, 8) * x8);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 5) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5] -
                   icste * (S[3] * iC[4] + S[4] * iC[3]);
        Kr(1, 5) =
            u1 * iF[1] + u4 * iF[4] + u7 * iF[7] - S[1] * iC[5] - S[5] * iC[1];
        Kr(2, 5) =
            u2 * iF[2] + u6 * iF[6] + u8 * iF[8] - S[2] * iC[5] - S[5] * iC[2];
        Kr(3, 5) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]) -
                   icste * (S[1] * iC[4] + S[4] * iC[1]) -
                   (S[3] * iC[5] + S[5] * iC[3]) / 2;
        Kr(4, 5) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]) -
                   icste * (S[2] * iC[3] + S[3] * iC[2]) -
                   (S[4] * iC[5] + S[5] * iC[4]) / 2;
        Kr(5, 5) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]) -
                   S[1] * iC[2] - S[2] * iC[1] - S[5] * iC[5];
      }
    }
  };  // end of struct DTAU_DDF_to_DS_DEGL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient increment (DTAU_DDF) to the moduli associated
   * with the Jaumann rate of the Kirchhoff stress divided by the change of
   * volume (ABAQUS).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * and ABAQUS relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-w\,\tau+\tau\,w\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DDF_to_ABAQUS_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DDF_to_ABAQUS_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      const tfel::math::tensor<1u, real> dF = F * iF0;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * Ks(0, 0) * dF[0];
      Kr(1, 0) = iJ * Ks(1, 0) * dF[0];
      Kr(2, 0) = iJ * Ks(2, 0) * dF[0];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * Ks(0, 1) * dF[1];
      Kr(1, 1) = iJ * Ks(1, 1) * dF[1];
      Kr(2, 1) = iJ * Ks(2, 1) * dF[1];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * dF[2];
      Kr(1, 2) = iJ * Ks(1, 2) * dF[2];
      Kr(2, 2) = iJ * Ks(2, 2) * dF[2];
    }
  };  // end of struct DTAU_DDF_to_ABAQUS_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DDF_to_ABAQUS_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF0 = tfel::math::invert(F0);
      const tfel::math::tensor<2u, real> dF = F * iF0;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * (Ks(0, 0) * dF[0] + Ks(0, 3) * dF[3]);
      Kr(1, 0) = iJ * (Ks(1, 0) * dF[0] + Ks(1, 3) * dF[3]);
      Kr(2, 0) = iJ * (Ks(2, 0) * dF[0] + Ks(2, 3) * dF[3]);
      Kr(3, 0) = iJ * (Ks(3, 0) * dF[0] + Ks(3, 3) * dF[3]);
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * dF[1] + Ks(0, 4) * dF[4]);
      Kr(1, 1) = iJ * (Ks(1, 1) * dF[1] + Ks(1, 4) * dF[4]);
      Kr(2, 1) = iJ * (Ks(2, 1) * dF[1] + Ks(2, 4) * dF[4]);
      Kr(3, 1) = iJ * (Ks(3, 1) * dF[1] + Ks(3, 4) * dF[4]);
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * dF[2];
      Kr(1, 2) = iJ * Ks(1, 2) * dF[2];
      Kr(2, 2) = iJ * Ks(2, 2) * dF[2];
      Kr(3, 2) = iJ * Ks(3, 2) * dF[2];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                 (Ks(0, 0) * dF[4] + Ks(0, 1) * dF[3] + Ks(0, 3) * dF[1] +
                  Ks(0, 4) * dF[0]);
      Kr(1, 3) = iJ * icste *
                 (Ks(1, 0) * dF[4] + Ks(1, 1) * dF[3] + Ks(1, 3) * dF[1] +
                  Ks(1, 4) * dF[0]);
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * dF[4] + Ks(2, 1) * dF[3] + Ks(2, 3) * dF[1] +
                  Ks(2, 4) * dF[0]);
      Kr(3, 3) = iJ * icste *
                 (Ks(3, 0) * dF[4] + Ks(3, 1) * dF[3] + Ks(3, 3) * dF[1] +
                  Ks(3, 4) * dF[0]);
    }
  };  // end of struct DTAU_DDF_to_ABAQUS_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DDF_to_ABAQUS_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF0 = tfel::math::invert(F0);
      const tfel::math::tensor<3u, real> dF = F * iF0;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * (Ks(0, 0) * dF[0] + Ks(0, 3) * dF[3] + Ks(0, 5) * dF[5]);
      Kr(1, 0) = iJ * (Ks(1, 0) * dF[0] + Ks(1, 3) * dF[3] + Ks(1, 5) * dF[5]);
      Kr(2, 0) = iJ * (Ks(2, 0) * dF[0] + Ks(2, 3) * dF[3] + Ks(2, 5) * dF[5]);
      Kr(3, 0) = iJ * (Ks(3, 0) * dF[0] + Ks(3, 3) * dF[3] + Ks(3, 5) * dF[5]);
      Kr(4, 0) = iJ * (Ks(4, 0) * dF[0] + Ks(4, 3) * dF[3] + Ks(4, 5) * dF[5]);
      Kr(5, 0) = iJ * (Ks(5, 0) * dF[0] + Ks(5, 3) * dF[3] + Ks(5, 5) * dF[5]);
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * dF[1] + Ks(0, 4) * dF[4] + Ks(0, 7) * dF[7]);
      Kr(1, 1) = iJ * (Ks(1, 1) * dF[1] + Ks(1, 4) * dF[4] + Ks(1, 7) * dF[7]);
      Kr(2, 1) = iJ * (Ks(2, 1) * dF[1] + Ks(2, 4) * dF[4] + Ks(2, 7) * dF[7]);
      Kr(3, 1) = iJ * (Ks(3, 1) * dF[1] + Ks(3, 4) * dF[4] + Ks(3, 7) * dF[7]);
      Kr(4, 1) = iJ * (Ks(4, 1) * dF[1] + Ks(4, 4) * dF[4] + Ks(4, 7) * dF[7]);
      Kr(5, 1) = iJ * (Ks(5, 1) * dF[1] + Ks(5, 4) * dF[4] + Ks(5, 7) * dF[7]);
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * (Ks(0, 2) * dF[2] + Ks(0, 6) * dF[6] + Ks(0, 8) * dF[8]);
      Kr(1, 2) = iJ * (Ks(1, 2) * dF[2] + Ks(1, 6) * dF[6] + Ks(1, 8) * dF[8]);
      Kr(2, 2) = iJ * (Ks(2, 2) * dF[2] + Ks(2, 6) * dF[6] + Ks(2, 8) * dF[8]);
      Kr(3, 2) = iJ * (Ks(3, 2) * dF[2] + Ks(3, 6) * dF[6] + Ks(3, 8) * dF[8]);
      Kr(4, 2) = iJ * (Ks(4, 2) * dF[2] + Ks(4, 6) * dF[6] + Ks(4, 8) * dF[8]);
      Kr(5, 2) = iJ * (Ks(5, 2) * dF[2] + Ks(5, 6) * dF[6] + Ks(5, 8) * dF[8]);
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                 (Ks(0, 0) * dF[4] + Ks(0, 1) * dF[3] + Ks(0, 3) * dF[1] +
                  Ks(0, 4) * dF[0] + Ks(0, 5) * dF[7] + Ks(0, 7) * dF[5]);
      Kr(1, 3) = iJ * icste *
                 (Ks(1, 0) * dF[4] + Ks(1, 1) * dF[3] + Ks(1, 3) * dF[1] +
                  Ks(1, 4) * dF[0] + Ks(1, 5) * dF[7] + Ks(1, 7) * dF[5]);
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * dF[4] + Ks(2, 1) * dF[3] + Ks(2, 3) * dF[1] +
                  Ks(2, 4) * dF[0] + Ks(2, 5) * dF[7] + Ks(2, 7) * dF[5]);
      Kr(3, 3) = iJ * icste *
                 (Ks(3, 0) * dF[4] + Ks(3, 1) * dF[3] + Ks(3, 3) * dF[1] +
                  Ks(3, 4) * dF[0] + Ks(3, 5) * dF[7] + Ks(3, 7) * dF[5]);
      Kr(4, 3) = iJ * icste *
                 (Ks(4, 0) * dF[4] + Ks(4, 1) * dF[3] + Ks(4, 3) * dF[1] +
                  Ks(4, 4) * dF[0] + Ks(4, 5) * dF[7] + Ks(4, 7) * dF[5]);
      Kr(5, 3) = iJ * icste *
                 (Ks(5, 0) * dF[4] + Ks(5, 1) * dF[3] + Ks(5, 3) * dF[1] +
                  Ks(5, 4) * dF[0] + Ks(5, 5) * dF[7] + Ks(5, 7) * dF[5]);
      // column associated with the component (0, 2) of the rate of deformation
      Kr(0, 4) = iJ * icste *
                 (Ks(0, 0) * dF[6] + Ks(0, 2) * dF[5] + Ks(0, 3) * dF[8] +
                  Ks(0, 5) * dF[2] + Ks(0, 6) * dF[0] + Ks(0, 8) * dF[3]);
      Kr(1, 4) = iJ * icste *
                 (Ks(1, 0) * dF[6] + Ks(1, 2) * dF[5] + Ks(1, 3) * dF[8] +
                  Ks(1, 5) * dF[2] + Ks(1, 6) * dF[0] + Ks(1, 8) * dF[3]);
      Kr(2, 4) = iJ * icste *
                 (Ks(2, 0) * dF[6] + Ks(2, 2) * dF[5] + Ks(2, 3) * dF[8] +
                  Ks(2, 5) * dF[2] + Ks(2, 6) * dF[0] + Ks(2, 8) * dF[3]);
      Kr(3, 4) = iJ * icste *
                 (Ks(3, 0) * dF[6] + Ks(3, 2) * dF[5] + Ks(3, 3) * dF[8] +
                  Ks(3, 5) * dF[2] + Ks(3, 6) * dF[0] + Ks(3, 8) * dF[3]);
      Kr(4, 4) = iJ * icste *
                 (Ks(4, 0) * dF[6] + Ks(4, 2) * dF[5] + Ks(4, 3) * dF[8] +
                  Ks(4, 5) * dF[2] + Ks(4, 6) * dF[0] + Ks(4, 8) * dF[3]);
      Kr(5, 4) = iJ * icste *
                 (Ks(5, 0) * dF[6] + Ks(5, 2) * dF[5] + Ks(5, 3) * dF[8] +
                  Ks(5, 5) * dF[2] + Ks(5, 6) * dF[0] + Ks(5, 8) * dF[3]);
      // column associated with the component (1, 2) of the rate of deformation
      Kr(0, 5) = iJ * icste *
                 (Ks(0, 1) * dF[8] + Ks(0, 2) * dF[7] + Ks(0, 4) * dF[6] +
                  Ks(0, 6) * dF[4] + Ks(0, 7) * dF[2] + Ks(0, 8) * dF[1]);
      Kr(1, 5) = iJ * icste *
                 (Ks(1, 1) * dF[8] + Ks(1, 2) * dF[7] + Ks(1, 4) * dF[6] +
                  Ks(1, 6) * dF[4] + Ks(1, 7) * dF[2] + Ks(1, 8) * dF[1]);
      Kr(2, 5) = iJ * icste *
                 (Ks(2, 1) * dF[8] + Ks(2, 2) * dF[7] + Ks(2, 4) * dF[6] +
                  Ks(2, 6) * dF[4] + Ks(2, 7) * dF[2] + Ks(2, 8) * dF[1]);
      Kr(3, 5) = iJ * icste *
                 (Ks(3, 1) * dF[8] + Ks(3, 2) * dF[7] + Ks(3, 4) * dF[6] +
                  Ks(3, 6) * dF[4] + Ks(3, 7) * dF[2] + Ks(3, 8) * dF[1]);
      Kr(4, 5) = iJ * icste *
                 (Ks(4, 1) * dF[8] + Ks(4, 2) * dF[7] + Ks(4, 4) * dF[6] +
                  Ks(4, 6) * dF[4] + Ks(4, 7) * dF[2] + Ks(4, 8) * dF[1]);
      Kr(5, 5) = iJ * icste *
                 (Ks(5, 1) * dF[8] + Ks(5, 2) * dF[7] + Ks(5, 4) * dF[6] +
                  Ks(5, 6) * dF[4] + Ks(5, 7) * dF[2] + Ks(5, 8) * dF[1]);
    }
  };  // end of struct DTAU_DDF_to_ABAQUS_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the Kirchhoff stress with respect
   * to the deformation gradient increment (DTAU_DDF) to the moduli associated
   * with the Truesdell rate of the Cauchy stress (C_TRUESDELL).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * and C_TRUESDELL relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DTAU_DDF_to_C_TRUESDELL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DTAU_DDF_to_C_TRUESDELL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::t2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF0 = tfel::math::invert(F0);
      const tfel::math::tensor<1u, real> dF = F * iF0;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * Ks(0, 0) * dF[0] - 2 * s[0];
      Kr(1, 0) = iJ * Ks(1, 0) * dF[0];
      Kr(2, 0) = iJ * Ks(2, 0) * dF[0];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * Ks(0, 1) * dF[1];
      Kr(1, 1) = iJ * Ks(1, 1) * dF[1] - 2 * s[1];
      Kr(2, 1) = iJ * Ks(2, 1) * dF[1];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * dF[2];
      Kr(1, 2) = iJ * Ks(1, 2) * dF[2];
      Kr(2, 2) = iJ * Ks(2, 2) * dF[2] - 2 * s[2];
    }
  };  // end of struct DTAU_DDF_to_C_TRUESDELL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DTAU_DDF_to_C_TRUESDELL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::t2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF0 = tfel::math::invert(F0);
      const tfel::math::tensor<2u, real> dF = F * iF0;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * (Ks(0, 0) * dF[0] + Ks(0, 3) * dF[3]) - 2 * s[0];
      Kr(1, 0) = iJ * (Ks(1, 0) * dF[0] + Ks(1, 3) * dF[3]);
      Kr(2, 0) = iJ * (Ks(2, 0) * dF[0] + Ks(2, 3) * dF[3]);
      Kr(3, 0) = iJ * (Ks(3, 0) * dF[0] + Ks(3, 3) * dF[3]) - s[3];
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * dF[1] + Ks(0, 4) * dF[4]);
      Kr(1, 1) = iJ * (Ks(1, 1) * dF[1] + Ks(1, 4) * dF[4]) - 2 * s[1];
      Kr(2, 1) = iJ * (Ks(2, 1) * dF[1] + Ks(2, 4) * dF[4]);
      Kr(3, 1) = iJ * (Ks(3, 1) * dF[1] + Ks(3, 4) * dF[4]) - s[3];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * Ks(0, 2) * dF[2];
      Kr(1, 2) = iJ * Ks(1, 2) * dF[2];
      Kr(2, 2) = iJ * Ks(2, 2) * dF[2] - 2 * s[2];
      Kr(3, 2) = iJ * Ks(3, 2) * dF[2];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                     (Ks(0, 0) * dF[4] + Ks(0, 1) * dF[3] + Ks(0, 3) * dF[1] +
                      Ks(0, 4) * dF[0]) -
                 s[3];
      Kr(1, 3) = iJ * icste *
                     (Ks(1, 0) * dF[4] + Ks(1, 1) * dF[3] + Ks(1, 3) * dF[1] +
                      Ks(1, 4) * dF[0]) -
                 s[3];
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * dF[4] + Ks(2, 1) * dF[3] + Ks(2, 3) * dF[1] +
                  Ks(2, 4) * dF[0]);
      Kr(3, 3) = iJ * icste *
                     (Ks(3, 0) * dF[4] + Ks(3, 1) * dF[3] + Ks(3, 3) * dF[1] +
                      Ks(3, 4) * dF[0]) -
                 s[0] - s[1];
    }
  };  // end of struct DTAU_DDF_to_C_TRUESDELL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DTAU_DDF_to_C_TRUESDELL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::t2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF0 = tfel::math::invert(F0);
      const tfel::math::tensor<3u, real> dF = F * iF0;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      // column associated with the component (0, 0) of the rate of deformation
      Kr(0, 0) = iJ * (Ks(0, 0) * dF[0] + Ks(0, 3) * dF[3] + Ks(0, 5) * dF[5]) -
                 2 * s[0];
      Kr(1, 0) = iJ * (Ks(1, 0) * dF[0] + Ks(1, 3) * dF[3] + Ks(1, 5) * dF[5]);
      Kr(2, 0) = iJ * (Ks(2, 0) * dF[0] + Ks(2, 3) * dF[3] + Ks(2, 5) * dF[5]);
      Kr(3, 0) =
          iJ * (Ks(3, 0) * dF[0] + Ks(3, 3) * dF[3] + Ks(3, 5) * dF[5]) - s[3];
      Kr(4, 0) =
          iJ * (Ks(4, 0) * dF[0] + Ks(4, 3) * dF[3] + Ks(4, 5) * dF[5]) - s[4];
      Kr(5, 0) = iJ * (Ks(5, 0) * dF[0] + Ks(5, 3) * dF[3] + Ks(5, 5) * dF[5]);
      // column associated with the component (1, 1) of the rate of deformation
      Kr(0, 1) = iJ * (Ks(0, 1) * dF[1] + Ks(0, 4) * dF[4] + Ks(0, 7) * dF[7]);
      Kr(1, 1) = iJ * (Ks(1, 1) * dF[1] + Ks(1, 4) * dF[4] + Ks(1, 7) * dF[7]) -
                 2 * s[1];
      Kr(2, 1) = iJ * (Ks(2, 1) * dF[1] + Ks(2, 4) * dF[4] + Ks(2, 7) * dF[7]);
      Kr(3, 1) =
          iJ * (Ks(3, 1) * dF[1] + Ks(3, 4) * dF[4] + Ks(3, 7) * dF[7]) - s[3];
      Kr(4, 1) = iJ * (Ks(4, 1) * dF[1] + Ks(4, 4) * dF[4] + Ks(4, 7) * dF[7]);
      Kr(5, 1) =
          iJ * (Ks(5, 1) * dF[1] + Ks(5, 4) * dF[4] + Ks(5, 7) * dF[7]) - s[5];
      // column associated with the component (2, 2) of the rate of deformation
      Kr(0, 2) = iJ * (Ks(0, 2) * dF[2] + Ks(0, 6) * dF[6] + Ks(0, 8) * dF[8]);
      Kr(1, 2) = iJ * (Ks(1, 2) * dF[2] + Ks(1, 6) * dF[6] + Ks(1, 8) * dF[8]);
      Kr(2, 2) = iJ * (Ks(2, 2) * dF[2] + Ks(2, 6) * dF[6] + Ks(2, 8) * dF[8]) -
                 2 * s[2];
      Kr(3, 2) = iJ * (Ks(3, 2) * dF[2] + Ks(3, 6) * dF[6] + Ks(3, 8) * dF[8]);
      Kr(4, 2) =
          iJ * (Ks(4, 2) * dF[2] + Ks(4, 6) * dF[6] + Ks(4, 8) * dF[8]) - s[4];
      Kr(5, 2) =
          iJ * (Ks(5, 2) * dF[2] + Ks(5, 6) * dF[6] + Ks(5, 8) * dF[8]) - s[5];
      // column associated with the component (0, 1) of the rate of deformation
      Kr(0, 3) = iJ * icste *
                     (Ks(0, 0) * dF[4] + Ks(0, 1) * dF[3] + Ks(0, 3) * dF[1] +
                      Ks(0, 4) * dF[0] + Ks(0, 5) * dF[7] + Ks(0, 7) * dF[5]) -
                 s[3];
      Kr(1, 3) = iJ * icste *
                     (Ks(1, 0) * dF[4] + Ks(1, 1) * dF[3] + Ks(1, 3) * dF[1] +
                      Ks(1, 4) * dF[0] + Ks(1, 5) * dF[7] + Ks(1, 7) * dF[5]) -
                 s[3];
      Kr(2, 3) = iJ * icste *
                 (Ks(2, 0) * dF[4] + Ks(2, 1) * dF[3] + Ks(2, 3) * dF[1] +
                  Ks(2, 4) * dF[0] + Ks(2, 5) * dF[7] + Ks(2, 7) * dF[5]);
      Kr(3, 3) = iJ * icste *
                     (Ks(3, 0) * dF[4] + Ks(3, 1) * dF[3] + Ks(3, 3) * dF[1] +
                      Ks(3, 4) * dF[0] + Ks(3, 5) * dF[7] + Ks(3, 7) * dF[5]) -
                 s[0] - s[1];
      Kr(4, 3) = iJ * icste *
                     (Ks(4, 0) * dF[4] + Ks(4, 1) * dF[3] + Ks(4, 3) * dF[1] +
                      Ks(4, 4) * dF[0] + Ks(4, 5) * dF[7] + Ks(4, 7) * dF[5]) -
                 icste * s[5];
      Kr(5, 3) = iJ * icste *
                     (Ks(5, 0) * dF[4] + Ks(5, 1) * dF[3] + Ks(5, 3) * dF[1] +
                      Ks(5, 4) * dF[0] + Ks(5, 5) * dF[7] + Ks(5, 7) * dF[5]) -
                 icste * s[4];
      // column associated with the component (0, 2) of the rate of deformation
      Kr(0, 4) = iJ * icste *
                     (Ks(0, 0) * dF[6] + Ks(0, 2) * dF[5] + Ks(0, 3) * dF[8] +
                      Ks(0, 5) * dF[2] + Ks(0, 6) * dF[0] + Ks(0, 8) * dF[3]) -
                 s[4];
      Kr(1, 4) = iJ * icste *
                 (Ks(1, 0) * dF[6] + Ks(1, 2) * dF[5] + Ks(1, 3) * dF[8] +
                  Ks(1, 5) * dF[2] + Ks(1, 6) * dF[0] + Ks(1, 8) * dF[3]);
      Kr(2, 4) = iJ * icste *
                     (Ks(2, 0) * dF[6] + Ks(2, 2) * dF[5] + Ks(2, 3) * dF[8] +
                      Ks(2, 5) * dF[2] + Ks(2, 6) * dF[0] + Ks(2, 8) * dF[3]) -
                 s[4];
      Kr(3, 4) = iJ * icste *
                     (Ks(3, 0) * dF[6] + Ks(3, 2) * dF[5] + Ks(3, 3) * dF[8] +
                      Ks(3, 5) * dF[2] + Ks(3, 6) * dF[0] + Ks(3, 8) * dF[3]) -
                 icste * s[5];
      Kr(4, 4) = iJ * icste *
                     (Ks(4, 0) * dF[6] + Ks(4, 2) * dF[5] + Ks(4, 3) * dF[8] +
                      Ks(4, 5) * dF[2] + Ks(4, 6) * dF[0] + Ks(4, 8) * dF[3]) -
                 s[0] - s[2];
      Kr(5, 4) = iJ * icste *
                     (Ks(5, 0) * dF[6] + Ks(5, 2) * dF[5] + Ks(5, 3) * dF[8] +
                      Ks(5, 5) * dF[2] + Ks(5, 6) * dF[0] + Ks(5, 8) * dF[3]) -
                 icste * s[3];
      // column associated with the component (1, 2) of the rate of deformation
      Kr(0, 5) = iJ * icste *
                 (Ks(0, 1) * dF[8] + Ks(0, 2) * dF[7] + Ks(0, 4) * dF[6] +
                  Ks(0, 6) * dF[4] + Ks(0, 7) * dF[2] + Ks(0, 8) * dF[1]);
      Kr(1, 5) = iJ * icste *
                     (Ks(1, 1) * dF[8] + Ks(1, 2) * dF[7] + Ks(1, 4) * dF[6] +
                      Ks(1, 6) * dF[4] + Ks(1, 7) * dF[2] + Ks(1, 8) * dF[1]) -
                 s[5];
      Kr(2, 5) = iJ * icste *
                     (Ks(2, 1) * dF[8] + Ks(2, 2) * dF[7] + Ks(2, 4) * dF[6] +
                      Ks(2, 6) * dF[4] + Ks(2, 7) * dF[2] + Ks(2, 8) * dF[1]) -
                 s[5];
      Kr(3, 5) = iJ * icste *
                     (Ks(3, 1) * dF[8] + Ks(3, 2) * dF[7] + Ks(3, 4) * dF[6] +
                      Ks(3, 6) * dF[4] + Ks(3, 7) * dF[2] + Ks(3, 8) * dF[1]) -
                 icste * s[4];
      Kr(4, 5) = iJ * icste *
                     (Ks(4, 1) * dF[8] + Ks(4, 2) * dF[7] + Ks(4, 4) * dF[6] +
                      Ks(4, 6) * dF[4] + Ks(4, 7) * dF[2] + Ks(4, 8) * dF[1]) -
                 icste * s[3];
      Kr(5, 5) = iJ * icste *
                     (Ks(5, 1) * dF[8] + Ks(5, 2) * dF[7] + Ks(5, 4) * dF[6] +
                      Ks(5, 6) * dF[4] + Ks(5, 7) * dF[2] + Ks(5, 8) * dF[1]) -
                 s[1] - s[2];
    }
  };  // end of struct DTAU_DDF_to_C_TRUESDELL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the right Cauchy-Green tensor (DS_DC) to the derivative of
   * the second Piola-Kirchhoff stress with respect to the deformation gradient
   * (DS_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DC relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,C=2\,\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DS_DF relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DC_to_DS_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DC_to_DS_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F) noexcept {
      const auto x0 = 2 * F[0];
      const auto x1 = 2 * F[1];
      const auto x2 = 2 * F[2];
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * x0;
      Kr(0, 1) = Ks(0, 1) * x1;
      Kr(0, 2) = Ks(0, 2) * x2;
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * x0;
      Kr(1, 1) = Ks(1, 1) * x1;
      Kr(1, 2) = Ks(1, 2) * x2;
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * x0;
      Kr(2, 1) = Ks(2, 1) * x1;
      Kr(2, 2) = Ks(2, 2) * x2;
    }
  };  // end of struct DS_DC_to_DS_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DC_to_DS_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      const auto x0 = 2 * F[0];
      const auto x1 = cste * F[3];
      const auto x2 = 2 * F[1];
      const auto x3 = cste * F[4];
      const auto x4 = 2 * F[2];
      const auto x5 = 2 * F[3];
      const auto x6 = cste * F[0];
      const auto x7 = 2 * F[4];
      const auto x8 = cste * F[1];
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * x0 + Ks(0, 3) * x1;
      Kr(0, 1) = Ks(0, 1) * x2 + Ks(0, 3) * x3;
      Kr(0, 2) = Ks(0, 2) * x4;
      Kr(0, 3) = Ks(0, 1) * x5 + Ks(0, 3) * x6;
      Kr(0, 4) = Ks(0, 0) * x7 + Ks(0, 3) * x8;
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * x0 + Ks(1, 3) * x1;
      Kr(1, 1) = Ks(1, 1) * x2 + Ks(1, 3) * x3;
      Kr(1, 2) = Ks(1, 2) * x4;
      Kr(1, 3) = Ks(1, 1) * x5 + Ks(1, 3) * x6;
      Kr(1, 4) = Ks(1, 0) * x7 + Ks(1, 3) * x8;
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * x0 + Ks(2, 3) * x1;
      Kr(2, 1) = Ks(2, 1) * x2 + Ks(2, 3) * x3;
      Kr(2, 2) = Ks(2, 2) * x4;
      Kr(2, 3) = Ks(2, 1) * x5 + Ks(2, 3) * x6;
      Kr(2, 4) = Ks(2, 0) * x7 + Ks(2, 3) * x8;
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * x0 + Ks(3, 3) * x1;
      Kr(3, 1) = Ks(3, 1) * x2 + Ks(3, 3) * x3;
      Kr(3, 2) = Ks(3, 2) * x4;
      Kr(3, 3) = Ks(3, 1) * x5 + Ks(3, 3) * x6;
      Kr(3, 4) = Ks(3, 0) * x7 + Ks(3, 3) * x8;
    }
  };  // end of struct DS_DC_to_DS_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DC_to_DS_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      const auto x0 = 2 * F[0];
      const auto x1 = cste * F[3];
      const auto x2 = cste * F[5];
      const auto x3 = 2 * F[1];
      const auto x4 = cste * F[4];
      const auto x5 = cste * F[7];
      const auto x6 = 2 * F[2];
      const auto x7 = cste * F[6];
      const auto x8 = cste * F[8];
      const auto x9 = 2 * F[3];
      const auto x10 = cste * F[0];
      const auto x11 = 2 * F[4];
      const auto x12 = cste * F[1];
      const auto x13 = 2 * F[5];
      const auto x14 = 2 * F[6];
      const auto x15 = cste * F[2];
      const auto x16 = 2 * F[7];
      const auto x17 = 2 * F[8];
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * x0 + Ks(0, 3) * x1 + Ks(0, 4) * x2;
      Kr(0, 1) = Ks(0, 1) * x3 + Ks(0, 3) * x4 + Ks(0, 5) * x5;
      Kr(0, 2) = Ks(0, 2) * x6 + Ks(0, 4) * x7 + Ks(0, 5) * x8;
      Kr(0, 3) = Ks(0, 1) * x9 + Ks(0, 3) * x10 + Ks(0, 5) * x2;
      Kr(0, 4) = Ks(0, 0) * x11 + Ks(0, 3) * x12 + Ks(0, 4) * x5;
      Kr(0, 5) = Ks(0, 2) * x13 + Ks(0, 4) * x10 + Ks(0, 5) * x1;
      Kr(0, 6) = Ks(0, 0) * x14 + Ks(0, 3) * x8 + Ks(0, 4) * x15;
      Kr(0, 7) = Ks(0, 2) * x16 + Ks(0, 4) * x4 + Ks(0, 5) * x12;
      Kr(0, 8) = Ks(0, 1) * x17 + Ks(0, 3) * x7 + Ks(0, 5) * x15;
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * x0 + Ks(1, 3) * x1 + Ks(1, 4) * x2;
      Kr(1, 1) = Ks(1, 1) * x3 + Ks(1, 3) * x4 + Ks(1, 5) * x5;
      Kr(1, 2) = Ks(1, 2) * x6 + Ks(1, 4) * x7 + Ks(1, 5) * x8;
      Kr(1, 3) = Ks(1, 1) * x9 + Ks(1, 3) * x10 + Ks(1, 5) * x2;
      Kr(1, 4) = Ks(1, 0) * x11 + Ks(1, 3) * x12 + Ks(1, 4) * x5;
      Kr(1, 5) = Ks(1, 2) * x13 + Ks(1, 4) * x10 + Ks(1, 5) * x1;
      Kr(1, 6) = Ks(1, 0) * x14 + Ks(1, 3) * x8 + Ks(1, 4) * x15;
      Kr(1, 7) = Ks(1, 2) * x16 + Ks(1, 4) * x4 + Ks(1, 5) * x12;
      Kr(1, 8) = Ks(1, 1) * x17 + Ks(1, 3) * x7 + Ks(1, 5) * x15;
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * x0 + Ks(2, 3) * x1 + Ks(2, 4) * x2;
      Kr(2, 1) = Ks(2, 1) * x3 + Ks(2, 3) * x4 + Ks(2, 5) * x5;
      Kr(2, 2) = Ks(2, 2) * x6 + Ks(2, 4) * x7 + Ks(2, 5) * x8;
      Kr(2, 3) = Ks(2, 1) * x9 + Ks(2, 3) * x10 + Ks(2, 5) * x2;
      Kr(2, 4) = Ks(2, 0) * x11 + Ks(2, 3) * x12 + Ks(2, 4) * x5;
      Kr(2, 5) = Ks(2, 2) * x13 + Ks(2, 4) * x10 + Ks(2, 5) * x1;
      Kr(2, 6) = Ks(2, 0) * x14 + Ks(2, 3) * x8 + Ks(2, 4) * x15;
      Kr(2, 7) = Ks(2, 2) * x16 + Ks(2, 4) * x4 + Ks(2, 5) * x12;
      Kr(2, 8) = Ks(2, 1) * x17 + Ks(2, 3) * x7 + Ks(2, 5) * x15;
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * x0 + Ks(3, 3) * x1 + Ks(3, 4) * x2;
      Kr(3, 1) = Ks(3, 1) * x3 + Ks(3, 3) * x4 + Ks(3, 5) * x5;
      Kr(3, 2) = Ks(3, 2) * x6 + Ks(3, 4) * x7 + Ks(3, 5) * x8;
      Kr(3, 3) = Ks(3, 1) * x9 + Ks(3, 3) * x10 + Ks(3, 5) * x2;
      Kr(3, 4) = Ks(3, 0) * x11 + Ks(3, 3) * x12 + Ks(3, 4) * x5;
      Kr(3, 5) = Ks(3, 2) * x13 + Ks(3, 4) * x10 + Ks(3, 5) * x1;
      Kr(3, 6) = Ks(3, 0) * x14 + Ks(3, 3) * x8 + Ks(3, 4) * x15;
      Kr(3, 7) = Ks(3, 2) * x16 + Ks(3, 4) * x4 + Ks(3, 5) * x12;
      Kr(3, 8) = Ks(3, 1) * x17 + Ks(3, 3) * x7 + Ks(3, 5) * x15;
      // derivatives of the component (0, 2) of the stress
      Kr(4, 0) = Ks(4, 0) * x0 + Ks(4, 3) * x1 + Ks(4, 4) * x2;
      Kr(4, 1) = Ks(4, 1) * x3 + Ks(4, 3) * x4 + Ks(4, 5) * x5;
      Kr(4, 2) = Ks(4, 2) * x6 + Ks(4, 4) * x7 + Ks(4, 5) * x8;
      Kr(4, 3) = Ks(4, 1) * x9 + Ks(4, 3) * x10 + Ks(4, 5) * x2;
      Kr(4, 4) = Ks(4, 0) * x11 + Ks(4, 3) * x12 + Ks(4, 4) * x5;
      Kr(4, 5) = Ks(4, 2) * x13 + Ks(4, 4) * x10 + Ks(4, 5) * x1;
      Kr(4, 6) = Ks(4, 0) * x14 + Ks(4, 3) * x8 + Ks(4, 4) * x15;
      Kr(4, 7) = Ks(4, 2) * x16 + Ks(4, 4) * x4 + Ks(4, 5) * x12;
      Kr(4, 8) = Ks(4, 1) * x17 + Ks(4, 3) * x7 + Ks(4, 5) * x15;
      // derivatives of the component (1, 2) of the stress
      Kr(5, 0) = Ks(5, 0) * x0 + Ks(5, 3) * x1 + Ks(5, 4) * x2;
      Kr(5, 1) = Ks(5, 1) * x3 + Ks(5, 3) * x4 + Ks(5, 5) * x5;
      Kr(5, 2) = Ks(5, 2) * x6 + Ks(5, 4) * x7 + Ks(5, 5) * x8;
      Kr(5, 3) = Ks(5, 1) * x9 + Ks(5, 3) * x10 + Ks(5, 5) * x2;
      Kr(5, 4) = Ks(5, 0) * x11 + Ks(5, 3) * x12 + Ks(5, 4) * x5;
      Kr(5, 5) = Ks(5, 2) * x13 + Ks(5, 4) * x10 + Ks(5, 5) * x1;
      Kr(5, 6) = Ks(5, 0) * x14 + Ks(5, 3) * x8 + Ks(5, 4) * x15;
      Kr(5, 7) = Ks(5, 2) * x16 + Ks(5, 4) * x4 + Ks(5, 5) * x12;
      Kr(5, 8) = Ks(5, 1) * x17 + Ks(5, 3) * x7 + Ks(5, 5) * x15;
    }
  };  // end of struct DS_DC_to_DS_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the right Cauchy-Green tensor (DS_DC) to the derivative of
   * the Cauchy stress with respect to the deformation gradient (DSIG_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DC relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,C=2\,\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DC_to_DSIG_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DC_to_DSIG_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<1u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] - dJ[0] * s[0]) + 2 * siF[0];
        Kr(1, 0) = iJ * (u1 * F[1] - dJ[0] * s[1]);
        Kr(2, 0) = iJ * (u2 * F[2] - dJ[0] * s[2]);
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] - dJ[1] * s[0]);
        Kr(1, 1) = iJ * (u1 * F[1] - dJ[1] * s[1]) + 2 * siF[1];
        Kr(2, 1) = iJ * (u2 * F[2] - dJ[1] * s[2]);
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] - dJ[2] * s[0]);
        Kr(1, 2) = iJ * (u1 * F[1] - dJ[2] * s[1]);
        Kr(2, 2) = iJ * (u2 * F[2] - dJ[2] * s[2]) + 2 * siF[2];
      }
    }
  };  // end of struct DS_DC_to_DSIG_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DC_to_DSIG_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<2u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[0];
        const auto x3 = cste * F[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] - dJ[0] * s[0]) + 2 * siF[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] - dJ[0] * s[1]);
        Kr(2, 0) = iJ * (u2 * F[2] - dJ[0] * s[2]);
        Kr(3, 0) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[0] * s[3]) +
                   cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[1];
        const auto x3 = cste * F[4];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] - dJ[1] * s[0]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] - dJ[1] * s[1]) + 2 * siF[1];
        Kr(2, 1) = iJ * (u2 * F[2] - dJ[1] * s[2]);
        Kr(3, 1) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[1] * s[3]) +
                   cste * siF[3];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] - dJ[2] * s[0]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] - dJ[2] * s[1]);
        Kr(2, 2) = iJ * (u2 * F[2] - dJ[2] * s[2]) + 2 * siF[2];
        Kr(3, 2) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[2] * s[3]);
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[3];
        const auto x3 = cste * F[0];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] - dJ[3] * s[0]) + 2 * siF[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] - dJ[3] * s[1]);
        Kr(2, 3) = iJ * (u2 * F[2] - dJ[3] * s[2]);
        Kr(3, 3) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[3] * s[3]) +
                   cste * siF[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[4];
        const auto x3 = cste * F[1];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] - dJ[4] * s[0]);
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] - dJ[4] * s[1]) + 2 * siF[4];
        Kr(2, 4) = iJ * (u2 * F[2] - dJ[4] * s[2]);
        Kr(3, 4) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[4] * s[3]) +
                   cste * siF[0];
      }
    }
  };  // end of struct DS_DC_to_DSIG_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DC_to_DSIG_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<3u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[0];
        const auto x3 = cste * F[3];
        const auto x4 = cste * F[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[0] * s[0]) +
                   2 * siF[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[0] * s[1]);
        Kr(2, 0) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[0] * s[2]);
        Kr(3, 0) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[0] * s[3]) +
            cste * siF[4];
        Kr(4, 0) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[0] * s[4]) +
            cste * siF[6];
        Kr(5, 0) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[0] * s[5]);
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[1];
        const auto x3 = cste * F[4];
        const auto x5 = cste * F[7];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 1) * x1 + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 1) * x1 + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[1] * s[0]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[1] * s[1]) +
                   2 * siF[1];
        Kr(2, 1) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[1] * s[2]);
        Kr(3, 1) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[1] * s[3]) +
            cste * siF[3];
        Kr(4, 1) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[1] * s[4]);
        Kr(5, 1) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[1] * s[5]) +
            cste * siF[8];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[2];
        const auto x4 = cste * F[6];
        const auto x5 = cste * F[8];
        const auto a0 = Ks(0, 2) * x2 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * x2 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * x2 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 2) * x2 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 2) * x2 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 2) * x2 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[2] * s[0]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[2] * s[1]);
        Kr(2, 2) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[2] * s[2]) +
                   2 * siF[2];
        Kr(3, 2) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[2] * s[3]);
        Kr(4, 2) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[2] * s[4]) +
            cste * siF[5];
        Kr(5, 2) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[2] * s[5]) +
            cste * siF[7];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[3];
        const auto x3 = cste * F[0];
        const auto x5 = cste * F[5];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 1) * x1 + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 1) * x1 + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[3] * s[0]) +
                   2 * siF[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[3] * s[1]);
        Kr(2, 3) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[3] * s[2]);
        Kr(3, 3) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[3] * s[3]) +
            cste * siF[1];
        Kr(4, 3) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[3] * s[4]) +
            cste * siF[8];
        Kr(5, 3) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[3] * s[5]);
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[4];
        const auto x3 = cste * F[1];
        const auto x4 = cste * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[4] * s[0]);
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[4] * s[1]) +
                   2 * siF[4];
        Kr(2, 4) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[4] * s[2]);
        Kr(3, 4) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[4] * s[3]) +
            cste * siF[0];
        Kr(4, 4) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[4] * s[4]);
        Kr(5, 4) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[4] * s[5]) +
            cste * siF[6];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[5];
        const auto x4 = cste * F[0];
        const auto x5 = cste * F[3];
        const auto a0 = Ks(0, 2) * x2 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * x2 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * x2 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 2) * x2 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 2) * x2 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 2) * x2 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 5) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[5] * s[0]) +
                   2 * siF[5];
        Kr(1, 5) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[5] * s[1]);
        Kr(2, 5) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[5] * s[2]);
        Kr(3, 5) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[5] * s[3]) +
            cste * siF[7];
        Kr(4, 5) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[5] * s[4]) +
            cste * siF[2];
        Kr(5, 5) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[5] * s[5]);
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[6];
        const auto x3 = cste * F[8];
        const auto x4 = cste * F[2];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 6) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[6] * s[0]);
        Kr(1, 6) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[6] * s[1]);
        Kr(2, 6) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[6] * s[2]) +
                   2 * siF[6];
        Kr(3, 6) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[6] * s[3]);
        Kr(4, 6) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[6] * s[4]) +
            cste * siF[0];
        Kr(5, 6) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[6] * s[5]) +
            cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[7];
        const auto x4 = cste * F[4];
        const auto x5 = cste * F[1];
        const auto a0 = Ks(0, 2) * x2 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * x2 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * x2 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 2) * x2 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 2) * x2 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 2) * x2 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 7) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[7] * s[0]);
        Kr(1, 7) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[7] * s[1]) +
                   2 * siF[7];
        Kr(2, 7) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[7] * s[2]);
        Kr(3, 7) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[7] * s[3]) +
            cste * siF[5];
        Kr(4, 7) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[7] * s[4]);
        Kr(5, 7) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[7] * s[5]) +
            cste * siF[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[8];
        const auto x3 = cste * F[6];
        const auto x5 = cste * F[2];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 1) * x1 + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 1) * x1 + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 8) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[8] * s[0]);
        Kr(1, 8) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[8] * s[1]);
        Kr(2, 8) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[8] * s[2]) +
                   2 * siF[8];
        Kr(3, 8) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[8] * s[3]);
        Kr(4, 8) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[8] * s[4]) +
            cste * siF[3];
        Kr(5, 8) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[8] * s[5]) +
            cste * siF[1];
      }
    }
  };  // end of struct DS_DC_to_DSIG_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the right Cauchy-Green tensor (DS_DC) to the derivative of
   * the Kirchhoff stress with respect to the deformation gradient increment
   * (DTAU_DDF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient increment \f$\Delta\,F=F\,F_{0}^{-1}\f$. Let
   * \f$\delta\,F\f$ be the variation of the deformation gradient associated
   * with this component, \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of
   * \f$l\f$ and \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DC
   * relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,C=2\,\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DC_to_DTAU_DDF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DC_to_DTAU_DDF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<1u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient increment
        const auto x0 = 2 * F0[0] * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = u0 * F[0] + 2 * tidF[0];
        Kr(1, 0) = u1 * F[1];
        Kr(2, 0) = u2 * F[2];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient increment
        const auto x1 = 2 * F0[1] * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = u0 * F[0];
        Kr(1, 1) = u1 * F[1] + 2 * tidF[1];
        Kr(2, 1) = u2 * F[2];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient increment
        const auto x2 = 2 * F0[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = u0 * F[0];
        Kr(1, 2) = u1 * F[1];
        Kr(2, 2) = u2 * F[2] + 2 * tidF[2];
      }
    }
  };  // end of struct DS_DC_to_DTAU_DDF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DC_to_DTAU_DDF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<2u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient increment
        const auto x0 = 2 * F0[0] * F[0];
        const auto x1 = 2 * F0[3] * F[3];
        const auto x3 = cste * (F0[0] * F[3] + F0[3] * F[0]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = u0 * F[0] + u3 * F[3] + 2 * tidF[0];
        Kr(1, 0) = u1 * F[1] + u4 * F[4];
        Kr(2, 0) = u2 * F[2];
        Kr(3, 0) = cste * (u0 * F[4] + u3 * F[1] + tidF[4]);
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient increment
        const auto x0 = 2 * F0[4] * F[4];
        const auto x1 = 2 * F0[1] * F[1];
        const auto x3 = cste * (F0[1] * F[4] + F0[4] * F[1]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = u0 * F[0] + u3 * F[3];
        Kr(1, 1) = u1 * F[1] + u4 * F[4] + 2 * tidF[1];
        Kr(2, 1) = u2 * F[2];
        Kr(3, 1) = cste * (u0 * F[4] + u3 * F[1] + tidF[3]);
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient increment
        const auto x2 = 2 * F0[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = u0 * F[0] + u3 * F[3];
        Kr(1, 2) = u1 * F[1] + u4 * F[4];
        Kr(2, 2) = u2 * F[2] + 2 * tidF[2];
        Kr(3, 2) = cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient increment
        const auto x0 = 2 * F0[4] * F[0];
        const auto x1 = 2 * F0[1] * F[3];
        const auto x3 = cste * (F0[1] * F[0] + F0[4] * F[3]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = u0 * F[0] + u3 * F[3] + 2 * tidF[3];
        Kr(1, 3) = u1 * F[1] + u4 * F[4];
        Kr(2, 3) = u2 * F[2];
        Kr(3, 3) = cste * (u0 * F[4] + u3 * F[1] + tidF[1]);
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient increment
        const auto x0 = 2 * F0[0] * F[4];
        const auto x1 = 2 * F0[3] * F[1];
        const auto x3 = cste * (F0[0] * F[1] + F0[3] * F[4]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 4) = u0 * F[0] + u3 * F[3];
        Kr(1, 4) = u1 * F[1] + u4 * F[4] + 2 * tidF[4];
        Kr(2, 4) = u2 * F[2];
        Kr(3, 4) = cste * (u0 * F[4] + u3 * F[1] + tidF[0]);
      }
    }
  };  // end of struct DS_DC_to_DTAU_DDF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DC_to_DTAU_DDF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<3u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivatives with respect to the components of the row 0 of the
        // deformation gradient
        const auto x00 = 2 * F[0];
        const auto x03 = cste * F[3];
        const auto x04 = cste * F[5];
        const auto r00 = Ks(0, 0) * x00 + Ks(0, 3) * x03 + Ks(0, 4) * x04;
        const auto r01 = Ks(1, 0) * x00 + Ks(1, 3) * x03 + Ks(1, 4) * x04;
        const auto r02 = Ks(2, 0) * x00 + Ks(2, 3) * x03 + Ks(2, 4) * x04;
        const auto r03 =
            icste * (Ks(3, 0) * x00 + Ks(3, 3) * x03 + Ks(3, 4) * x04);
        const auto r04 =
            icste * (Ks(4, 0) * x00 + Ks(4, 3) * x03 + Ks(4, 4) * x04);
        const auto r05 =
            icste * (Ks(5, 0) * x00 + Ks(5, 3) * x03 + Ks(5, 4) * x04);
        const auto x11 = 2 * F[3];
        const auto x13 = cste * F[0];
        const auto x15 = cste * F[5];
        const auto r10 = Ks(0, 1) * x11 + Ks(0, 3) * x13 + Ks(0, 5) * x15;
        const auto r11 = Ks(1, 1) * x11 + Ks(1, 3) * x13 + Ks(1, 5) * x15;
        const auto r12 = Ks(2, 1) * x11 + Ks(2, 3) * x13 + Ks(2, 5) * x15;
        const auto r13 =
            icste * (Ks(3, 1) * x11 + Ks(3, 3) * x13 + Ks(3, 5) * x15);
        const auto r14 =
            icste * (Ks(4, 1) * x11 + Ks(4, 3) * x13 + Ks(4, 5) * x15);
        const auto r15 =
            icste * (Ks(5, 1) * x11 + Ks(5, 3) * x13 + Ks(5, 5) * x15);
        const auto x22 = 2 * F[5];
        const auto x24 = cste * F[0];
        const auto x25 = cste * F[3];
        const auto r20 = Ks(0, 2) * x22 + Ks(0, 4) * x24 + Ks(0, 5) * x25;
        const auto r21 = Ks(1, 2) * x22 + Ks(1, 4) * x24 + Ks(1, 5) * x25;
        const auto r22 = Ks(2, 2) * x22 + Ks(2, 4) * x24 + Ks(2, 5) * x25;
        const auto r23 =
            icste * (Ks(3, 2) * x22 + Ks(3, 4) * x24 + Ks(3, 5) * x25);
