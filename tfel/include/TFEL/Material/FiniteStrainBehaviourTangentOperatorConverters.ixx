          // gradient increment
          const auto a0 = r00 * F0[4] + r10 * F0[1] + r20 * F0[7];
          const auto a1 = r01 * F0[4] + r11 * F0[1] + r21 * F0[7];
          const auto a2 = r02 * F0[4] + r12 * F0[1] + r22 * F0[7];
          const auto a3 = r03 * F0[4] + r13 * F0[1] + r23 * F0[7];
          const auto a4 = r04 * F0[4] + r14 * F0[1] + r24 * F0[7];
          const auto a5 = r05 * F0[4] + r15 * F0[1] + r25 * F0[7];
          const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
          const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
          const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
          const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
          const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
          const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
          const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
          const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
          const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
          Kr(0, 8) = u0 * F[0] + u3 * F[3] + u5 * F[5];
          Kr(1, 8) = u1 * F[1] + u4 * F[4] + u7 * F[7];
          Kr(2, 8) = u2 * F[2] + u6 * F[6] + u8 * F[8] + 2 * tidF[8];
          Kr(3, 8) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
          Kr(4, 8) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2] + tidF[3]);
          Kr(5, 8) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2] + tidF[1]);
        }
      }
    }
  };  // end of struct DS_DC_to_DTAU_DDF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the right Cauchy-Green tensor (DS_DC) to the derivative of
   * the first Piola-Kirchhoff stress with respect to the deformation gradient
   * (DPK1_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DC relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,C=2\,\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DPK1_DF relates
   * \f[
   * \delta\,P=\left(\delta\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DC_to_DPK1_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DC_to_DPK1_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        Kr(0, 0) = a0 * F[0] + S[0];
        Kr(1, 0) = a1 * F[1];
        Kr(2, 0) = a2 * F[2];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        Kr(0, 1) = a0 * F[0];
        Kr(1, 1) = a1 * F[1] + S[1];
        Kr(2, 1) = a2 * F[2];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        Kr(0, 2) = a0 * F[0];
        Kr(1, 2) = a1 * F[1];
        Kr(2, 2) = a2 * F[2] + S[2];
      }
    }
  };  // end of struct DS_DC_to_DPK1_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DC_to_DPK1_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[0];
        const auto x3 = cste * F[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3);
        Kr(0, 0) = a0 * F[0] + a3 * F[3] + S[0];
        Kr(1, 0) = a1 * F[1] + a3 * F[4];
        Kr(2, 0) = a2 * F[2];
        Kr(3, 0) = a1 * F[3] + a3 * F[0] + icste * S[3];
        Kr(4, 0) = a0 * F[4] + a3 * F[1];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[1];
        const auto x3 = cste * F[4];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3);
        Kr(0, 1) = a0 * F[0] + a3 * F[3];
        Kr(1, 1) = a1 * F[1] + a3 * F[4] + S[1];
        Kr(2, 1) = a2 * F[2];
        Kr(3, 1) = a1 * F[3] + a3 * F[0];
        Kr(4, 1) = a0 * F[4] + a3 * F[1] + icste * S[3];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        Kr(0, 2) = a0 * F[0] + a3 * F[3];
        Kr(1, 2) = a1 * F[1] + a3 * F[4];
        Kr(2, 2) = a2 * F[2] + S[2];
        Kr(3, 2) = a1 * F[3] + a3 * F[0];
        Kr(4, 2) = a0 * F[4] + a3 * F[1];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[3];
        const auto x3 = cste * F[0];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3);
        Kr(0, 3) = a0 * F[0] + a3 * F[3] + icste * S[3];
        Kr(1, 3) = a1 * F[1] + a3 * F[4];
        Kr(2, 3) = a2 * F[2];
        Kr(3, 3) = a1 * F[3] + a3 * F[0] + S[1];
        Kr(4, 3) = a0 * F[4] + a3 * F[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[4];
        const auto x3 = cste * F[1];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3);
        Kr(0, 4) = a0 * F[0] + a3 * F[3];
        Kr(1, 4) = a1 * F[1] + a3 * F[4] + icste * S[3];
        Kr(2, 4) = a2 * F[2];
        Kr(3, 4) = a1 * F[3] + a3 * F[0];
        Kr(4, 4) = a0 * F[4] + a3 * F[1] + S[0];
      }
    }
  };  // end of struct DS_DC_to_DPK1_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DC_to_DPK1_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[0];
        const auto x3 = cste * F[3];
        const auto x4 = cste * F[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 0) = a0 * F[0] + a3 * F[3] + a4 * F[5] + S[0];
        Kr(1, 0) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 0) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 0) = a1 * F[3] + a3 * F[0] + a5 * F[5] + icste * S[3];
        Kr(4, 0) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 0) = a2 * F[5] + a4 * F[0] + a5 * F[3] + icste * S[4];
        Kr(6, 0) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 0) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 0) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[1];
        const auto x3 = cste * F[4];
        const auto x5 = cste * F[7];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 1) * x1 + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 1) * x1 + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 1) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 1) = a1 * F[1] + a3 * F[4] + a5 * F[7] + S[1];
        Kr(2, 1) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 1) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 1) = a0 * F[4] + a3 * F[1] + a4 * F[7] + icste * S[3];
        Kr(5, 1) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 1) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 1) = a2 * F[7] + a4 * F[4] + a5 * F[1] + icste * S[5];
        Kr(8, 1) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[2];
        const auto x4 = cste * F[6];
        const auto x5 = cste * F[8];
        const auto a0 = Ks(0, 2) * x2 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * x2 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * x2 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 2) * x2 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 2) * x2 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 2) * x2 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 2) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 2) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 2) = a2 * F[2] + a4 * F[6] + a5 * F[8] + S[2];
        Kr(3, 2) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 2) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 2) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 2) = a0 * F[6] + a3 * F[8] + a4 * F[2] + icste * S[4];
        Kr(7, 2) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 2) = a1 * F[8] + a3 * F[6] + a5 * F[2] + icste * S[5];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[3];
        const auto x3 = cste * F[0];
        const auto x5 = cste * F[5];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 1) * x1 + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 1) * x1 + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 3) = a0 * F[0] + a3 * F[3] + a4 * F[5] + icste * S[3];
        Kr(1, 3) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 3) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 3) = a1 * F[3] + a3 * F[0] + a5 * F[5] + S[1];
        Kr(4, 3) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 3) = a2 * F[5] + a4 * F[0] + a5 * F[3] + icste * S[5];
        Kr(6, 3) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 3) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 3) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[4];
        const auto x3 = cste * F[1];
        const auto x4 = cste * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 4) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 4) = a1 * F[1] + a3 * F[4] + a5 * F[7] + icste * S[3];
        Kr(2, 4) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 4) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 4) = a0 * F[4] + a3 * F[1] + a4 * F[7] + S[0];
        Kr(5, 4) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 4) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 4) = a2 * F[7] + a4 * F[4] + a5 * F[1] + icste * S[4];
        Kr(8, 4) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[5];
        const auto x4 = cste * F[0];
        const auto x5 = cste * F[3];
        const auto a0 = Ks(0, 2) * x2 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * x2 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * x2 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 2) * x2 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 2) * x2 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 2) * x2 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 5) = a0 * F[0] + a3 * F[3] + a4 * F[5] + icste * S[4];
        Kr(1, 5) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 5) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 5) = a1 * F[3] + a3 * F[0] + a5 * F[5] + icste * S[5];
        Kr(4, 5) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 5) = a2 * F[5] + a4 * F[0] + a5 * F[3] + S[2];
        Kr(6, 5) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 5) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 5) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x0 = 2 * F[6];
        const auto x3 = cste * F[8];
        const auto x4 = cste * F[2];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 6) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 6) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 6) = a2 * F[2] + a4 * F[6] + a5 * F[8] + icste * S[4];
        Kr(3, 6) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 6) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 6) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 6) = a0 * F[6] + a3 * F[8] + a4 * F[2] + S[0];
        Kr(7, 6) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 6) = a1 * F[8] + a3 * F[6] + a5 * F[2] + icste * S[3];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x2 = 2 * F[7];
        const auto x4 = cste * F[4];
        const auto x5 = cste * F[1];
        const auto a0 = Ks(0, 2) * x2 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * x2 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * x2 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 2) * x2 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 2) * x2 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 2) * x2 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 7) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 7) = a1 * F[1] + a3 * F[4] + a5 * F[7] + icste * S[5];
        Kr(2, 7) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 7) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 7) = a0 * F[4] + a3 * F[1] + a4 * F[7] + icste * S[4];
        Kr(5, 7) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 7) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 7) = a2 * F[7] + a4 * F[4] + a5 * F[1] + S[2];
        Kr(8, 7) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x1 = 2 * F[8];
        const auto x3 = cste * F[6];
        const auto x5 = cste * F[2];
        const auto a0 = Ks(0, 1) * x1 + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * x1 + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * x1 + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 1) * x1 + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 1) * x1 + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 1) * x1 + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 8) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 8) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 8) = a2 * F[2] + a4 * F[6] + a5 * F[8] + icste * S[5];
        Kr(3, 8) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 8) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 8) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 8) = a0 * F[6] + a3 * F[8] + a4 * F[2] + icste * S[3];
        Kr(7, 8) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 8) = a1 * F[8] + a3 * F[6] + a5 * F[2] + S[1];
      }
    }
  };  // end of struct DS_DC_to_DPK1_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the right Cauchy-Green tensor (DS_DC) to the moduli
   * associated with the Jaumann rate of the Kirchhoff stress divided by the
   * change of volume (ABAQUS).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DC relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,C=2\,\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and ABAQUS relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-w\,\tau+\tau\,w\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DC_to_ABAQUS_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DC_to_ABAQUS_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = 2 * F[0] * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = iJ * u0 * F[0] + 2 * s[0];
        Kr(1, 0) = iJ * u1 * F[1];
        Kr(2, 0) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x1 = 2 * F[1] * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = iJ * u0 * F[0];
        Kr(1, 1) = iJ * u1 * F[1] + 2 * s[1];
        Kr(2, 1) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = 2 * F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = iJ * u0 * F[0];
        Kr(1, 2) = iJ * u1 * F[1];
        Kr(2, 2) = iJ * u2 * F[2] + 2 * s[2];
      }
    }
  };  // end of struct DS_DC_to_ABAQUS_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DC_to_ABAQUS_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = 2 * F[0] * F[0];
        const auto x1 = 2 * F[3] * F[3];
        const auto x3 = 2 * cste * F[0] * F[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3]) + 2 * s[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 0) = iJ * u2 * F[2];
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1]) + s[3];
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = 2 * F[4] * F[4];
        const auto x1 = 2 * F[1] * F[1];
        const auto x3 = 2 * cste * F[1] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4]) + 2 * s[1];
        Kr(2, 1) = iJ * u2 * F[2];
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1]) + s[3];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = 2 * F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 2) = iJ * u2 * F[2] + 2 * s[2];
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[0] * F[4];
        const auto x1 = 2 * cste * F[1] * F[3];
        const auto x3 = 2 * (F[0] * F[1] + F[3] * F[4]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3]) + s[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4]) + s[3];
        Kr(2, 3) = iJ * u2 * F[2];
        Kr(3, 3) = iJ * cste * (u0 * F[4] + u3 * F[1]) + s[0] + s[1];
      }
    }
  };  // end of struct DS_DC_to_ABAQUS_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DC_to_ABAQUS_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = 2 * F[0] * F[0];
        const auto x1 = 2 * F[3] * F[3];
        const auto x2 = 2 * F[5] * F[5];
        const auto x3 = 2 * cste * F[0] * F[3];
        const auto x4 = 2 * cste * F[0] * F[5];
        const auto x5 = 2 * cste * F[3] * F[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]) + 2 * s[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 0) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + s[3];
        Kr(4, 0) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + s[4];
        Kr(5, 0) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = 2 * F[4] * F[4];
        const auto x1 = 2 * F[1] * F[1];
        const auto x2 = 2 * F[7] * F[7];
        const auto x3 = 2 * cste * F[1] * F[4];
        const auto x4 = 2 * cste * F[4] * F[7];
        const auto x5 = 2 * cste * F[1] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]) + 2 * s[1];
        Kr(2, 1) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + s[3];
        Kr(4, 1) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 1) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + s[5];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x0 = 2 * F[6] * F[6];
        const auto x1 = 2 * F[8] * F[8];
        const auto x2 = 2 * F[2] * F[2];
        const auto x3 = 2 * cste * F[6] * F[8];
        const auto x4 = 2 * cste * F[2] * F[6];
        const auto x5 = 2 * cste * F[2] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 2) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]) + 2 * s[2];
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 2) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + s[4];
        Kr(5, 2) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + s[5];
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[0] * F[4];
        const auto x1 = 2 * cste * F[1] * F[3];
        const auto x2 = 2 * cste * F[5] * F[7];
        const auto x3 = 2 * (F[0] * F[1] + F[3] * F[4]);
        const auto x4 = 2 * (F[0] * F[7] + F[4] * F[5]);
        const auto x5 = 2 * (F[1] * F[5] + F[3] * F[7]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]) + s[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]) + s[3];
        Kr(2, 3) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 3) =
            iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + s[0] + s[1];
        Kr(4, 3) =
            iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + icste * s[5];
        Kr(5, 3) =
            iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + icste * s[4];
      }
      {
        // column associated with the component (0, 2) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[0] * F[6];
        const auto x1 = 2 * cste * F[3] * F[8];
        const auto x2 = 2 * cste * F[2] * F[5];
        const auto x3 = 2 * (F[0] * F[8] + F[3] * F[6]);
        const auto x4 = 2 * (F[0] * F[2] + F[5] * F[6]);
        const auto x5 = 2 * (F[2] * F[3] + F[5] * F[8]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]) + s[4];
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 4) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]) + s[4];
        Kr(3, 4) =
            iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + icste * s[5];
        Kr(4, 4) =
            iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + s[0] + s[2];
        Kr(5, 4) =
            iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + icste * s[3];
      }
      {
        // column associated with the component (1, 2) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[4] * F[6];
        const auto x1 = 2 * cste * F[1] * F[8];
        const auto x2 = 2 * cste * F[2] * F[7];
        const auto x3 = 2 * (F[1] * F[6] + F[4] * F[8]);
        const auto x4 = 2 * (F[2] * F[4] + F[6] * F[7]);
        const auto x5 = 2 * (F[1] * F[2] + F[7] * F[8]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 5) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 5) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]) + s[5];
        Kr(2, 5) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]) + s[5];
        Kr(3, 5) =
            iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + icste * s[4];
        Kr(4, 5) =
            iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + icste * s[3];
        Kr(5, 5) =
            iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + s[1] + s[2];
      }
    }
  };  // end of struct DS_DC_to_ABAQUS_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the right Cauchy-Green tensor (DS_DC) to the moduli
   * associated with the Truesdell rate of the Cauchy stress (C_TRUESDELL).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DC relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,C=2\,\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and C_TRUESDELL relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DC_to_C_TRUESDELL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DC_to_C_TRUESDELL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = 2 * F[0] * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = iJ * u0 * F[0];
        Kr(1, 0) = iJ * u1 * F[1];
        Kr(2, 0) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x1 = 2 * F[1] * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = iJ * u0 * F[0];
        Kr(1, 1) = iJ * u1 * F[1];
        Kr(2, 1) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = 2 * F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = iJ * u0 * F[0];
        Kr(1, 2) = iJ * u1 * F[1];
        Kr(2, 2) = iJ * u2 * F[2];
      }
    }
  };  // end of struct DS_DC_to_C_TRUESDELL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DC_to_C_TRUESDELL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = 2 * F[0] * F[0];
        const auto x1 = 2 * F[3] * F[3];
        const auto x3 = 2 * cste * F[0] * F[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 0) = iJ * u2 * F[2];
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = 2 * F[4] * F[4];
        const auto x1 = 2 * F[1] * F[1];
        const auto x3 = 2 * cste * F[1] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 1) = iJ * u2 * F[2];
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = 2 * F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 2) = iJ * u2 * F[2];
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[0] * F[4];
        const auto x1 = 2 * cste * F[1] * F[3];
        const auto x3 = 2 * (F[0] * F[1] + F[3] * F[4]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 3) = iJ * u2 * F[2];
        Kr(3, 3) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
    }
  };  // end of struct DS_DC_to_C_TRUESDELL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DC_to_C_TRUESDELL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the right Cauchy-Green tensor
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = 2 * F[0] * F[0];
        const auto x1 = 2 * F[3] * F[3];
        const auto x2 = 2 * F[5] * F[5];
        const auto x3 = 2 * cste * F[0] * F[3];
        const auto x4 = 2 * cste * F[0] * F[5];
        const auto x5 = 2 * cste * F[3] * F[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 0) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 0) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 0) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = 2 * F[4] * F[4];
        const auto x1 = 2 * F[1] * F[1];
        const auto x2 = 2 * F[7] * F[7];
        const auto x3 = 2 * cste * F[1] * F[4];
        const auto x4 = 2 * cste * F[4] * F[7];
        const auto x5 = 2 * cste * F[1] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 1) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 1) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 1) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x0 = 2 * F[6] * F[6];
        const auto x1 = 2 * F[8] * F[8];
        const auto x2 = 2 * F[2] * F[2];
        const auto x3 = 2 * cste * F[6] * F[8];
        const auto x4 = 2 * cste * F[2] * F[6];
        const auto x5 = 2 * cste * F[2] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 2) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 2) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 2) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[0] * F[4];
        const auto x1 = 2 * cste * F[1] * F[3];
        const auto x2 = 2 * cste * F[5] * F[7];
        const auto x3 = 2 * (F[0] * F[1] + F[3] * F[4]);
        const auto x4 = 2 * (F[0] * F[7] + F[4] * F[5]);
        const auto x5 = 2 * (F[1] * F[5] + F[3] * F[7]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 3) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 3) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 3) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 3) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (0, 2) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[0] * F[6];
        const auto x1 = 2 * cste * F[3] * F[8];
        const auto x2 = 2 * cste * F[2] * F[5];
        const auto x3 = 2 * (F[0] * F[8] + F[3] * F[6]);
        const auto x4 = 2 * (F[0] * F[2] + F[5] * F[6]);
        const auto x5 = 2 * (F[2] * F[3] + F[5] * F[8]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 4) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 4) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 4) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 4) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 2) of the rate of
        // deformation
        const auto x0 = 2 * cste * F[4] * F[6];
        const auto x1 = 2 * cste * F[1] * F[8];
        const auto x2 = 2 * cste * F[2] * F[7];
        const auto x3 = 2 * (F[1] * F[6] + F[4] * F[8]);
        const auto x4 = 2 * (F[2] * F[4] + F[6] * F[7]);
        const auto x5 = 2 * (F[1] * F[2] + F[7] * F[8]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 5) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 5) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 5) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 5) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 5) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 5) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
    }
  };  // end of struct DS_DC_to_C_TRUESDELL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the Green-Lagrange strain (DS_DEGL) to the derivative of
   * the second Piola-Kirchhoff stress with respect to the deformation gradient
   * (DS_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DS_DF relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DEGL_to_DS_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DEGL_to_DS_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F) noexcept {
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F[0];
      Kr(0, 1) = Ks(0, 1) * F[1];
      Kr(0, 2) = Ks(0, 2) * F[2];
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F[0];
      Kr(1, 1) = Ks(1, 1) * F[1];
      Kr(1, 2) = Ks(1, 2) * F[2];
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F[0];
      Kr(2, 1) = Ks(2, 1) * F[1];
      Kr(2, 2) = Ks(2, 2) * F[2];
    }
  };  // end of struct DS_DEGL_to_DS_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DEGL_to_DS_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto x0 = icste * F[3];
      const auto x1 = icste * F[4];
      const auto x2 = icste * F[0];
      const auto x3 = icste * F[1];
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F[0] + Ks(0, 3) * x0;
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 3) * x1;
      Kr(0, 2) = Ks(0, 2) * F[2];
      Kr(0, 3) = Ks(0, 1) * F[3] + Ks(0, 3) * x2;
      Kr(0, 4) = Ks(0, 0) * F[4] + Ks(0, 3) * x3;
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * x0;
      Kr(1, 1) = Ks(1, 1) * F[1] + Ks(1, 3) * x1;
      Kr(1, 2) = Ks(1, 2) * F[2];
      Kr(1, 3) = Ks(1, 1) * F[3] + Ks(1, 3) * x2;
      Kr(1, 4) = Ks(1, 0) * F[4] + Ks(1, 3) * x3;
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * x0;
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 3) * x1;
      Kr(2, 2) = Ks(2, 2) * F[2];
      Kr(2, 3) = Ks(2, 1) * F[3] + Ks(2, 3) * x2;
      Kr(2, 4) = Ks(2, 0) * F[4] + Ks(2, 3) * x3;
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * x0;
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 3) * x1;
      Kr(3, 2) = Ks(3, 2) * F[2];
      Kr(3, 3) = Ks(3, 1) * F[3] + Ks(3, 3) * x2;
      Kr(3, 4) = Ks(3, 0) * F[4] + Ks(3, 3) * x3;
    }
  };  // end of struct DS_DEGL_to_DS_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DEGL_to_DS_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto x0 = icste * F[3];
      const auto x1 = icste * F[5];
      const auto x2 = icste * F[4];
      const auto x3 = icste * F[7];
      const auto x4 = icste * F[6];
      const auto x5 = icste * F[8];
      const auto x6 = icste * F[0];
      const auto x7 = icste * F[1];
      const auto x8 = icste * F[2];
      // derivatives of the component (0, 0) of the stress
      Kr(0, 0) = Ks(0, 0) * F[0] + Ks(0, 3) * x0 + Ks(0, 4) * x1;
      Kr(0, 1) = Ks(0, 1) * F[1] + Ks(0, 3) * x2 + Ks(0, 5) * x3;
      Kr(0, 2) = Ks(0, 2) * F[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
      Kr(0, 3) = Ks(0, 1) * F[3] + Ks(0, 3) * x6 + Ks(0, 5) * x1;
      Kr(0, 4) = Ks(0, 0) * F[4] + Ks(0, 3) * x7 + Ks(0, 4) * x3;
      Kr(0, 5) = Ks(0, 2) * F[5] + Ks(0, 4) * x6 + Ks(0, 5) * x0;
      Kr(0, 6) = Ks(0, 0) * F[6] + Ks(0, 3) * x5 + Ks(0, 4) * x8;
      Kr(0, 7) = Ks(0, 2) * F[7] + Ks(0, 4) * x2 + Ks(0, 5) * x7;
      Kr(0, 8) = Ks(0, 1) * F[8] + Ks(0, 3) * x4 + Ks(0, 5) * x8;
      // derivatives of the component (1, 1) of the stress
      Kr(1, 0) = Ks(1, 0) * F[0] + Ks(1, 3) * x0 + Ks(1, 4) * x1;
      Kr(1, 1) = Ks(1, 1) * F[1] + Ks(1, 3) * x2 + Ks(1, 5) * x3;
      Kr(1, 2) = Ks(1, 2) * F[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
      Kr(1, 3) = Ks(1, 1) * F[3] + Ks(1, 3) * x6 + Ks(1, 5) * x1;
      Kr(1, 4) = Ks(1, 0) * F[4] + Ks(1, 3) * x7 + Ks(1, 4) * x3;
      Kr(1, 5) = Ks(1, 2) * F[5] + Ks(1, 4) * x6 + Ks(1, 5) * x0;
      Kr(1, 6) = Ks(1, 0) * F[6] + Ks(1, 3) * x5 + Ks(1, 4) * x8;
      Kr(1, 7) = Ks(1, 2) * F[7] + Ks(1, 4) * x2 + Ks(1, 5) * x7;
      Kr(1, 8) = Ks(1, 1) * F[8] + Ks(1, 3) * x4 + Ks(1, 5) * x8;
      // derivatives of the component (2, 2) of the stress
      Kr(2, 0) = Ks(2, 0) * F[0] + Ks(2, 3) * x0 + Ks(2, 4) * x1;
      Kr(2, 1) = Ks(2, 1) * F[1] + Ks(2, 3) * x2 + Ks(2, 5) * x3;
      Kr(2, 2) = Ks(2, 2) * F[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
      Kr(2, 3) = Ks(2, 1) * F[3] + Ks(2, 3) * x6 + Ks(2, 5) * x1;
      Kr(2, 4) = Ks(2, 0) * F[4] + Ks(2, 3) * x7 + Ks(2, 4) * x3;
      Kr(2, 5) = Ks(2, 2) * F[5] + Ks(2, 4) * x6 + Ks(2, 5) * x0;
      Kr(2, 6) = Ks(2, 0) * F[6] + Ks(2, 3) * x5 + Ks(2, 4) * x8;
      Kr(2, 7) = Ks(2, 2) * F[7] + Ks(2, 4) * x2 + Ks(2, 5) * x7;
      Kr(2, 8) = Ks(2, 1) * F[8] + Ks(2, 3) * x4 + Ks(2, 5) * x8;
      // derivatives of the component (0, 1) of the stress
      Kr(3, 0) = Ks(3, 0) * F[0] + Ks(3, 3) * x0 + Ks(3, 4) * x1;
      Kr(3, 1) = Ks(3, 1) * F[1] + Ks(3, 3) * x2 + Ks(3, 5) * x3;
      Kr(3, 2) = Ks(3, 2) * F[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5;
      Kr(3, 3) = Ks(3, 1) * F[3] + Ks(3, 3) * x6 + Ks(3, 5) * x1;
      Kr(3, 4) = Ks(3, 0) * F[4] + Ks(3, 3) * x7 + Ks(3, 4) * x3;
      Kr(3, 5) = Ks(3, 2) * F[5] + Ks(3, 4) * x6 + Ks(3, 5) * x0;
      Kr(3, 6) = Ks(3, 0) * F[6] + Ks(3, 3) * x5 + Ks(3, 4) * x8;
      Kr(3, 7) = Ks(3, 2) * F[7] + Ks(3, 4) * x2 + Ks(3, 5) * x7;
      Kr(3, 8) = Ks(3, 1) * F[8] + Ks(3, 3) * x4 + Ks(3, 5) * x8;
      // derivatives of the component (0, 2) of the stress
      Kr(4, 0) = Ks(4, 0) * F[0] + Ks(4, 3) * x0 + Ks(4, 4) * x1;
      Kr(4, 1) = Ks(4, 1) * F[1] + Ks(4, 3) * x2 + Ks(4, 5) * x3;
      Kr(4, 2) = Ks(4, 2) * F[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5;
      Kr(4, 3) = Ks(4, 1) * F[3] + Ks(4, 3) * x6 + Ks(4, 5) * x1;
      Kr(4, 4) = Ks(4, 0) * F[4] + Ks(4, 3) * x7 + Ks(4, 4) * x3;
      Kr(4, 5) = Ks(4, 2) * F[5] + Ks(4, 4) * x6 + Ks(4, 5) * x0;
      Kr(4, 6) = Ks(4, 0) * F[6] + Ks(4, 3) * x5 + Ks(4, 4) * x8;
      Kr(4, 7) = Ks(4, 2) * F[7] + Ks(4, 4) * x2 + Ks(4, 5) * x7;
      Kr(4, 8) = Ks(4, 1) * F[8] + Ks(4, 3) * x4 + Ks(4, 5) * x8;
      // derivatives of the component (1, 2) of the stress
      Kr(5, 0) = Ks(5, 0) * F[0] + Ks(5, 3) * x0 + Ks(5, 4) * x1;
      Kr(5, 1) = Ks(5, 1) * F[1] + Ks(5, 3) * x2 + Ks(5, 5) * x3;
      Kr(5, 2) = Ks(5, 2) * F[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5;
      Kr(5, 3) = Ks(5, 1) * F[3] + Ks(5, 3) * x6 + Ks(5, 5) * x1;
      Kr(5, 4) = Ks(5, 0) * F[4] + Ks(5, 3) * x7 + Ks(5, 4) * x3;
      Kr(5, 5) = Ks(5, 2) * F[5] + Ks(5, 4) * x6 + Ks(5, 5) * x0;
      Kr(5, 6) = Ks(5, 0) * F[6] + Ks(5, 3) * x5 + Ks(5, 4) * x8;
      Kr(5, 7) = Ks(5, 2) * F[7] + Ks(5, 4) * x2 + Ks(5, 5) * x7;
      Kr(5, 8) = Ks(5, 1) * F[8] + Ks(5, 3) * x4 + Ks(5, 5) * x8;
    }
  };  // end of struct DS_DEGL_to_DS_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the Green-Lagrange strain (DS_DEGL) to the derivative of
   * the Cauchy stress with respect to the deformation gradient (DSIG_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DEGL_to_DSIG_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DEGL_to_DSIG_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<1u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto a0 = Ks(0, 0) * F[0];
        const auto a1 = Ks(1, 0) * F[0];
        const auto a2 = Ks(2, 0) * F[0];
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] - dJ[0] * s[0]) + 2 * siF[0];
        Kr(1, 0) = iJ * (u1 * F[1] - dJ[0] * s[1]);
        Kr(2, 0) = iJ * (u2 * F[2] - dJ[0] * s[2]);
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto a0 = Ks(0, 1) * F[1];
        const auto a1 = Ks(1, 1) * F[1];
        const auto a2 = Ks(2, 1) * F[1];
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] - dJ[1] * s[0]);
        Kr(1, 1) = iJ * (u1 * F[1] - dJ[1] * s[1]) + 2 * siF[1];
        Kr(2, 1) = iJ * (u2 * F[2] - dJ[1] * s[2]);
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto a0 = Ks(0, 2) * F[2];
        const auto a1 = Ks(1, 2) * F[2];
        const auto a2 = Ks(2, 2) * F[2];
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] - dJ[2] * s[0]);
        Kr(1, 2) = iJ * (u1 * F[1] - dJ[2] * s[1]);
        Kr(2, 2) = iJ * (u2 * F[2] - dJ[2] * s[2]) + 2 * siF[2];
      }
    }
  };  // end of struct DS_DEGL_to_DSIG_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DEGL_to_DSIG_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<2u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * F[3];
        const auto a0 = Ks(0, 0) * F[0] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * F[0] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * F[0] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * F[0] + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] - dJ[0] * s[0]) + 2 * siF[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] - dJ[0] * s[1]);
        Kr(2, 0) = iJ * (u2 * F[2] - dJ[0] * s[2]);
        Kr(3, 0) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[0] * s[3]) +
                   cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * F[4];
        const auto a0 = Ks(0, 1) * F[1] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * F[1] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * F[1] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * F[1] + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] - dJ[1] * s[0]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] - dJ[1] * s[1]) + 2 * siF[1];
        Kr(2, 1) = iJ * (u2 * F[2] - dJ[1] * s[2]);
        Kr(3, 1) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[1] * s[3]) +
                   cste * siF[3];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto a0 = Ks(0, 2) * F[2];
        const auto a1 = Ks(1, 2) * F[2];
        const auto a2 = Ks(2, 2) * F[2];
        const auto a3 = icste * Ks(3, 2) * F[2];
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] - dJ[2] * s[0]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] - dJ[2] * s[1]);
        Kr(2, 2) = iJ * (u2 * F[2] - dJ[2] * s[2]) + 2 * siF[2];
        Kr(3, 2) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[2] * s[3]);
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * F[0];
        const auto a0 = Ks(0, 1) * F[3] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * F[3] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * F[3] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * F[3] + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] - dJ[3] * s[0]) + 2 * siF[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] - dJ[3] * s[1]);
        Kr(2, 3) = iJ * (u2 * F[2] - dJ[3] * s[2]);
        Kr(3, 3) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[3] * s[3]) +
                   cste * siF[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * F[1];
        const auto a0 = Ks(0, 0) * F[4] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * F[4] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * F[4] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * F[4] + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] - dJ[4] * s[0]);
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] - dJ[4] * s[1]) + 2 * siF[4];
        Kr(2, 4) = iJ * (u2 * F[2] - dJ[4] * s[2]);
        Kr(3, 4) = iJ * (cste * (u0 * F[4] + u3 * F[1]) - dJ[4] * s[3]) +
                   cste * siF[0];
      }
    }
  };  // end of struct DS_DEGL_to_DSIG_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DEGL_to_DSIG_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto dJ = tfel::math::computeDeterminantDerivative(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<3u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * F[3];
        const auto x4 = icste * F[5];
        const auto a0 = Ks(0, 0) * F[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * F[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * F[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * F[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * F[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * F[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[0] * s[0]) +
                   2 * siF[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[0] * s[1]);
        Kr(2, 0) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[0] * s[2]);
        Kr(3, 0) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[0] * s[3]) +
            cste * siF[4];
        Kr(4, 0) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[0] * s[4]) +
            cste * siF[6];
        Kr(5, 0) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[0] * s[5]);
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * F[4];
        const auto x5 = icste * F[7];
        const auto a0 = Ks(0, 1) * F[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * F[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * F[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * F[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * F[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * F[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[1] * s[0]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[1] * s[1]) +
                   2 * siF[1];
        Kr(2, 1) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[1] * s[2]);
        Kr(3, 1) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[1] * s[3]) +
            cste * siF[3];
        Kr(4, 1) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[1] * s[4]);
        Kr(5, 1) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[1] * s[5]) +
            cste * siF[8];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * F[6];
        const auto x5 = icste * F[8];
        const auto a0 = Ks(0, 2) * F[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * F[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * F[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * F[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * F[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * F[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[2] * s[0]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[2] * s[1]);
        Kr(2, 2) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[2] * s[2]) +
                   2 * siF[2];
        Kr(3, 2) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[2] * s[3]);
        Kr(4, 2) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[2] * s[4]) +
            cste * siF[5];
        Kr(5, 2) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[2] * s[5]) +
            cste * siF[7];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * F[0];
        const auto x5 = icste * F[5];
        const auto a0 = Ks(0, 1) * F[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * F[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * F[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * F[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * F[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * F[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[3] * s[0]) +
                   2 * siF[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[3] * s[1]);
        Kr(2, 3) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[3] * s[2]);
        Kr(3, 3) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[3] * s[3]) +
            cste * siF[1];
        Kr(4, 3) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[3] * s[4]) +
            cste * siF[8];
        Kr(5, 3) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[3] * s[5]);
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * F[1];
        const auto x4 = icste * F[7];
        const auto a0 = Ks(0, 0) * F[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * F[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * F[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * F[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * F[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * F[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[4] * s[0]);
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[4] * s[1]) +
                   2 * siF[4];
        Kr(2, 4) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[4] * s[2]);
        Kr(3, 4) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[4] * s[3]) +
            cste * siF[0];
        Kr(4, 4) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[4] * s[4]);
        Kr(5, 4) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[4] * s[5]) +
            cste * siF[6];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x4 = icste * F[0];
        const auto x5 = icste * F[3];
        const auto a0 = Ks(0, 2) * F[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * F[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * F[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * F[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * F[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * F[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 5) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[5] * s[0]) +
                   2 * siF[5];
        Kr(1, 5) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[5] * s[1]);
        Kr(2, 5) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[5] * s[2]);
        Kr(3, 5) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[5] * s[3]) +
            cste * siF[7];
        Kr(4, 5) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[5] * s[4]) +
            cste * siF[2];
        Kr(5, 5) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[5] * s[5]);
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x3 = icste * F[8];
        const auto x4 = icste * F[2];
        const auto a0 = Ks(0, 0) * F[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * F[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * F[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * F[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * F[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * F[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 6) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[6] * s[0]);
        Kr(1, 6) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[6] * s[1]);
        Kr(2, 6) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[6] * s[2]) +
                   2 * siF[6];
        Kr(3, 6) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[6] * s[3]);
        Kr(4, 6) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[6] * s[4]) +
            cste * siF[0];
        Kr(5, 6) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[6] * s[5]) +
            cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x4 = icste * F[4];
        const auto x5 = icste * F[1];
        const auto a0 = Ks(0, 2) * F[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * F[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * F[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * F[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * F[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * F[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 7) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[7] * s[0]);
        Kr(1, 7) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[7] * s[1]) +
                   2 * siF[7];
        Kr(2, 7) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[7] * s[2]);
        Kr(3, 7) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[7] * s[3]) +
            cste * siF[5];
        Kr(4, 7) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[7] * s[4]);
        Kr(5, 7) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[7] * s[5]) +
            cste * siF[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x3 = icste * F[6];
        const auto x5 = icste * F[2];
        const auto a0 = Ks(0, 1) * F[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * F[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * F[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * F[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * F[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * F[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 8) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5] - dJ[8] * s[0]);
        Kr(1, 8) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7] - dJ[8] * s[1]);
        Kr(2, 8) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8] - dJ[8] * s[2]) +
                   2 * siF[8];
        Kr(3, 8) =
            iJ * (cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) - dJ[8] * s[3]);
        Kr(4, 8) =
            iJ * (cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) - dJ[8] * s[4]) +
            cste * siF[3];
        Kr(5, 8) =
            iJ * (cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) - dJ[8] * s[5]) +
            cste * siF[1];
      }
    }
  };  // end of struct DS_DEGL_to_DSIG_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the Green-Lagrange strain (DS_DEGL) to the derivative of
   * the Kirchhoff stress with respect to the deformation gradient increment
   * (DTAU_DDF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient increment \f$\Delta\,F=F\,F_{0}^{-1}\f$. Let
   * \f$\delta\,F\f$ be the variation of the deformation gradient associated
   * with this component, \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of
   * \f$l\f$ and \f$\delta\,\tau\f$ the variation of the Kirchhoff stress.
   * DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DEGL_to_DTAU_DDF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DEGL_to_DTAU_DDF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<1u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient increment
        const auto x0 = F0[0] * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = u0 * F[0] + 2 * tidF[0];
        Kr(1, 0) = u1 * F[1];
        Kr(2, 0) = u2 * F[2];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient increment
        const auto x1 = F0[1] * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = u0 * F[0];
        Kr(1, 1) = u1 * F[1] + 2 * tidF[1];
        Kr(2, 1) = u2 * F[2];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient increment
        const auto x2 = F0[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = u0 * F[0];
        Kr(1, 2) = u1 * F[1];
        Kr(2, 2) = u2 * F[2] + 2 * tidF[2];
      }
    }
  };  // end of struct DS_DEGL_to_DTAU_DDF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DEGL_to_DTAU_DDF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<2u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient increment
        const auto x0 = F0[0] * F[0];
        const auto x1 = F0[3] * F[3];
        const auto x3 = icste * (F0[0] * F[3] + F0[3] * F[0]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = u0 * F[0] + u3 * F[3] + 2 * tidF[0];
        Kr(1, 0) = u1 * F[1] + u4 * F[4];
        Kr(2, 0) = u2 * F[2];
        Kr(3, 0) = cste * (u0 * F[4] + u3 * F[1] + tidF[4]);
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient increment
        const auto x0 = F0[4] * F[4];
        const auto x1 = F0[1] * F[1];
        const auto x3 = icste * (F0[1] * F[4] + F0[4] * F[1]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = u0 * F[0] + u3 * F[3];
        Kr(1, 1) = u1 * F[1] + u4 * F[4] + 2 * tidF[1];
        Kr(2, 1) = u2 * F[2];
        Kr(3, 1) = cste * (u0 * F[4] + u3 * F[1] + tidF[3]);
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient increment
        const auto x2 = F0[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = u0 * F[0] + u3 * F[3];
        Kr(1, 2) = u1 * F[1] + u4 * F[4];
        Kr(2, 2) = u2 * F[2] + 2 * tidF[2];
        Kr(3, 2) = cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient increment
        const auto x0 = F0[4] * F[0];
        const auto x1 = F0[1] * F[3];
        const auto x3 = icste * (F0[1] * F[0] + F0[4] * F[3]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = u0 * F[0] + u3 * F[3] + 2 * tidF[3];
        Kr(1, 3) = u1 * F[1] + u4 * F[4];
        Kr(2, 3) = u2 * F[2];
        Kr(3, 3) = cste * (u0 * F[4] + u3 * F[1] + tidF[1]);
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient increment
        const auto x0 = F0[0] * F[4];
        const auto x1 = F0[3] * F[1];
        const auto x3 = icste * (F0[0] * F[1] + F0[3] * F[4]);
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 4) = u0 * F[0] + u3 * F[3];
        Kr(1, 4) = u1 * F[1] + u4 * F[4] + 2 * tidF[4];
        Kr(2, 4) = u2 * F[2];
        Kr(3, 4) = cste * (u0 * F[4] + u3 * F[1] + tidF[0]);
      }
    }
  };  // end of struct DS_DEGL_to_DTAU_DDF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DEGL_to_DTAU_DDF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<3u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivatives with respect to the components of the row 0 of the
        // deformation gradient
        const auto x03 = icste * F[3];
        const auto x04 = icste * F[5];
        const auto r00 = Ks(0, 0) * F[0] + Ks(0, 3) * x03 + Ks(0, 4) * x04;
        const auto r01 = Ks(1, 0) * F[0] + Ks(1, 3) * x03 + Ks(1, 4) * x04;
        const auto r02 = Ks(2, 0) * F[0] + Ks(2, 3) * x03 + Ks(2, 4) * x04;
        const auto r03 =
            icste * (Ks(3, 0) * F[0] + Ks(3, 3) * x03 + Ks(3, 4) * x04);
        const auto r04 =
            icste * (Ks(4, 0) * F[0] + Ks(4, 3) * x03 + Ks(4, 4) * x04);
        const auto r05 =
            icste * (Ks(5, 0) * F[0] + Ks(5, 3) * x03 + Ks(5, 4) * x04);
        const auto x13 = icste * F[0];
        const auto x15 = icste * F[5];
        const auto r10 = Ks(0, 1) * F[3] + Ks(0, 3) * x13 + Ks(0, 5) * x15;
        const auto r11 = Ks(1, 1) * F[3] + Ks(1, 3) * x13 + Ks(1, 5) * x15;
        const auto r12 = Ks(2, 1) * F[3] + Ks(2, 3) * x13 + Ks(2, 5) * x15;
        const auto r13 =
            icste * (Ks(3, 1) * F[3] + Ks(3, 3) * x13 + Ks(3, 5) * x15);
        const auto r14 =
            icste * (Ks(4, 1) * F[3] + Ks(4, 3) * x13 + Ks(4, 5) * x15);
        const auto r15 =
            icste * (Ks(5, 1) * F[3] + Ks(5, 3) * x13 + Ks(5, 5) * x15);
        const auto x24 = icste * F[0];
        const auto x25 = icste * F[3];
        const auto r20 = Ks(0, 2) * F[5] + Ks(0, 4) * x24 + Ks(0, 5) * x25;
        const auto r21 = Ks(1, 2) * F[5] + Ks(1, 4) * x24 + Ks(1, 5) * x25;
        const auto r22 = Ks(2, 2) * F[5] + Ks(2, 4) * x24 + Ks(2, 5) * x25;
        const auto r23 =
            icste * (Ks(3, 2) * F[5] + Ks(3, 4) * x24 + Ks(3, 5) * x25);
        const auto r24 =
            icste * (Ks(4, 2) * F[5] + Ks(4, 4) * x24 + Ks(4, 5) * x25);
        const auto r25 =
            icste * (Ks(5, 2) * F[5] + Ks(5, 4) * x24 + Ks(5, 5) * x25);
        {
          // derivative with respect to the component (0, 0) of the deformation
          // gradient increment
          const auto a0 = r00 * F0[0] + r10 * F0[3] + r20 * F0[5];
          const auto a1 = r01 * F0[0] + r11 * F0[3] + r21 * F0[5];
          const auto a2 = r02 * F0[0] + r12 * F0[3] + r22 * F0[5];
          const auto a3 = r03 * F0[0] + r13 * F0[3] + r23 * F0[5];
          const auto a4 = r04 * F0[0] + r14 * F0[3] + r24 * F0[5];
          const auto a5 = r05 * F0[0] + r15 * F0[3] + r25 * F0[5];
          const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
          const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
          const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
          const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
          const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
          const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
          const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
          const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
          const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
