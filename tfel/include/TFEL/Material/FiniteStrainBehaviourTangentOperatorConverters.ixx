          Kr(2, 8) = u2 * F[2] + u6 * F[6] + u8 * F[8] + 2 * tidF[8];
          Kr(3, 8) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
          Kr(4, 8) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2] + tidF[3]);
          Kr(5, 8) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2] + tidF[1]);
        }
      }
    }
  };  // end of struct DS_DEGL_to_DTAU_DDF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the Green-Lagrange strain (DS_DEGL) to the derivative of
   * the first Piola-Kirchhoff stress with respect to the deformation gradient
   * (DPK1_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and DPK1_DF relates
   * \f[
   * \delta\,P=\left(\delta\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DEGL_to_DPK1_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DEGL_to_DPK1_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto a0 = Ks(0, 0) * F[0];
        const auto a1 = Ks(1, 0) * F[0];
        const auto a2 = Ks(2, 0) * F[0];
        Kr(0, 0) = a0 * F[0] + S[0];
        Kr(1, 0) = a1 * F[1];
        Kr(2, 0) = a2 * F[2];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto a0 = Ks(0, 1) * F[1];
        const auto a1 = Ks(1, 1) * F[1];
        const auto a2 = Ks(2, 1) * F[1];
        Kr(0, 1) = a0 * F[0];
        Kr(1, 1) = a1 * F[1] + S[1];
        Kr(2, 1) = a2 * F[2];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto a0 = Ks(0, 2) * F[2];
        const auto a1 = Ks(1, 2) * F[2];
        const auto a2 = Ks(2, 2) * F[2];
        Kr(0, 2) = a0 * F[0];
        Kr(1, 2) = a1 * F[1];
        Kr(2, 2) = a2 * F[2] + S[2];
      }
    }
  };  // end of struct DS_DEGL_to_DPK1_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DEGL_to_DPK1_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * F[3];
        const auto a0 = Ks(0, 0) * F[0] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * F[0] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * F[0] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * F[0] + Ks(3, 3) * x3);
        Kr(0, 0) = a0 * F[0] + a3 * F[3] + S[0];
        Kr(1, 0) = a1 * F[1] + a3 * F[4];
        Kr(2, 0) = a2 * F[2];
        Kr(3, 0) = a1 * F[3] + a3 * F[0] + icste * S[3];
        Kr(4, 0) = a0 * F[4] + a3 * F[1];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * F[4];
        const auto a0 = Ks(0, 1) * F[1] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * F[1] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * F[1] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * F[1] + Ks(3, 3) * x3);
        Kr(0, 1) = a0 * F[0] + a3 * F[3];
        Kr(1, 1) = a1 * F[1] + a3 * F[4] + S[1];
        Kr(2, 1) = a2 * F[2];
        Kr(3, 1) = a1 * F[3] + a3 * F[0];
        Kr(4, 1) = a0 * F[4] + a3 * F[1] + icste * S[3];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto a0 = Ks(0, 2) * F[2];
        const auto a1 = Ks(1, 2) * F[2];
        const auto a2 = Ks(2, 2) * F[2];
        const auto a3 = icste * Ks(3, 2) * F[2];
        Kr(0, 2) = a0 * F[0] + a3 * F[3];
        Kr(1, 2) = a1 * F[1] + a3 * F[4];
        Kr(2, 2) = a2 * F[2] + S[2];
        Kr(3, 2) = a1 * F[3] + a3 * F[0];
        Kr(4, 2) = a0 * F[4] + a3 * F[1];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * F[0];
        const auto a0 = Ks(0, 1) * F[3] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * F[3] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * F[3] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * F[3] + Ks(3, 3) * x3);
        Kr(0, 3) = a0 * F[0] + a3 * F[3] + icste * S[3];
        Kr(1, 3) = a1 * F[1] + a3 * F[4];
        Kr(2, 3) = a2 * F[2];
        Kr(3, 3) = a1 * F[3] + a3 * F[0] + S[1];
        Kr(4, 3) = a0 * F[4] + a3 * F[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * F[1];
        const auto a0 = Ks(0, 0) * F[4] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * F[4] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * F[4] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * F[4] + Ks(3, 3) * x3);
        Kr(0, 4) = a0 * F[0] + a3 * F[3];
        Kr(1, 4) = a1 * F[1] + a3 * F[4] + icste * S[3];
        Kr(2, 4) = a2 * F[2];
        Kr(3, 4) = a1 * F[3] + a3 * F[0];
        Kr(4, 4) = a0 * F[4] + a3 * F[1] + S[0];
      }
    }
  };  // end of struct DS_DEGL_to_DPK1_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DEGL_to_DPK1_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * F[3];
        const auto x4 = icste * F[5];
        const auto a0 = Ks(0, 0) * F[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * F[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * F[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * F[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * F[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * F[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 0) = a0 * F[0] + a3 * F[3] + a4 * F[5] + S[0];
        Kr(1, 0) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 0) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 0) = a1 * F[3] + a3 * F[0] + a5 * F[5] + icste * S[3];
        Kr(4, 0) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 0) = a2 * F[5] + a4 * F[0] + a5 * F[3] + icste * S[4];
        Kr(6, 0) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 0) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 0) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * F[4];
        const auto x5 = icste * F[7];
        const auto a0 = Ks(0, 1) * F[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * F[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * F[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * F[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * F[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * F[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 1) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 1) = a1 * F[1] + a3 * F[4] + a5 * F[7] + S[1];
        Kr(2, 1) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 1) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 1) = a0 * F[4] + a3 * F[1] + a4 * F[7] + icste * S[3];
        Kr(5, 1) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 1) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 1) = a2 * F[7] + a4 * F[4] + a5 * F[1] + icste * S[5];
        Kr(8, 1) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * F[6];
        const auto x5 = icste * F[8];
        const auto a0 = Ks(0, 2) * F[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * F[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * F[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * F[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * F[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * F[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 2) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 2) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 2) = a2 * F[2] + a4 * F[6] + a5 * F[8] + S[2];
        Kr(3, 2) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 2) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 2) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 2) = a0 * F[6] + a3 * F[8] + a4 * F[2] + icste * S[4];
        Kr(7, 2) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 2) = a1 * F[8] + a3 * F[6] + a5 * F[2] + icste * S[5];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * F[0];
        const auto x5 = icste * F[5];
        const auto a0 = Ks(0, 1) * F[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * F[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * F[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * F[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * F[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * F[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 3) = a0 * F[0] + a3 * F[3] + a4 * F[5] + icste * S[3];
        Kr(1, 3) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 3) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 3) = a1 * F[3] + a3 * F[0] + a5 * F[5] + S[1];
        Kr(4, 3) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 3) = a2 * F[5] + a4 * F[0] + a5 * F[3] + icste * S[5];
        Kr(6, 3) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 3) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 3) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * F[1];
        const auto x4 = icste * F[7];
        const auto a0 = Ks(0, 0) * F[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * F[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * F[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * F[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * F[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * F[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 4) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 4) = a1 * F[1] + a3 * F[4] + a5 * F[7] + icste * S[3];
        Kr(2, 4) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 4) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 4) = a0 * F[4] + a3 * F[1] + a4 * F[7] + S[0];
        Kr(5, 4) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 4) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 4) = a2 * F[7] + a4 * F[4] + a5 * F[1] + icste * S[4];
        Kr(8, 4) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x4 = icste * F[0];
        const auto x5 = icste * F[3];
        const auto a0 = Ks(0, 2) * F[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * F[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * F[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * F[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * F[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * F[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 5) = a0 * F[0] + a3 * F[3] + a4 * F[5] + icste * S[4];
        Kr(1, 5) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 5) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 5) = a1 * F[3] + a3 * F[0] + a5 * F[5] + icste * S[5];
        Kr(4, 5) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 5) = a2 * F[5] + a4 * F[0] + a5 * F[3] + S[2];
        Kr(6, 5) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 5) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 5) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x3 = icste * F[8];
        const auto x4 = icste * F[2];
        const auto a0 = Ks(0, 0) * F[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * F[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * F[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * F[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * F[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * F[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 6) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 6) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 6) = a2 * F[2] + a4 * F[6] + a5 * F[8] + icste * S[4];
        Kr(3, 6) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 6) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 6) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 6) = a0 * F[6] + a3 * F[8] + a4 * F[2] + S[0];
        Kr(7, 6) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 6) = a1 * F[8] + a3 * F[6] + a5 * F[2] + icste * S[3];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x4 = icste * F[4];
        const auto x5 = icste * F[1];
        const auto a0 = Ks(0, 2) * F[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * F[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * F[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * F[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * F[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * F[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 7) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 7) = a1 * F[1] + a3 * F[4] + a5 * F[7] + icste * S[5];
        Kr(2, 7) = a2 * F[2] + a4 * F[6] + a5 * F[8];
        Kr(3, 7) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 7) = a0 * F[4] + a3 * F[1] + a4 * F[7] + icste * S[4];
        Kr(5, 7) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 7) = a0 * F[6] + a3 * F[8] + a4 * F[2];
        Kr(7, 7) = a2 * F[7] + a4 * F[4] + a5 * F[1] + S[2];
        Kr(8, 7) = a1 * F[8] + a3 * F[6] + a5 * F[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x3 = icste * F[6];
        const auto x5 = icste * F[2];
        const auto a0 = Ks(0, 1) * F[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * F[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * F[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * F[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * F[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * F[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 8) = a0 * F[0] + a3 * F[3] + a4 * F[5];
        Kr(1, 8) = a1 * F[1] + a3 * F[4] + a5 * F[7];
        Kr(2, 8) = a2 * F[2] + a4 * F[6] + a5 * F[8] + icste * S[5];
        Kr(3, 8) = a1 * F[3] + a3 * F[0] + a5 * F[5];
        Kr(4, 8) = a0 * F[4] + a3 * F[1] + a4 * F[7];
        Kr(5, 8) = a2 * F[5] + a4 * F[0] + a5 * F[3];
        Kr(6, 8) = a0 * F[6] + a3 * F[8] + a4 * F[2] + icste * S[3];
        Kr(7, 8) = a2 * F[7] + a4 * F[4] + a5 * F[1];
        Kr(8, 8) = a1 * F[8] + a3 * F[6] + a5 * F[2] + S[1];
      }
    }
  };  // end of struct DS_DEGL_to_DPK1_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the Green-Lagrange strain (DS_DEGL) to the spatial moduli
   * (SPATIAL_MODULI).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and SPATIAL_MODULI relates
   * \f[
   * \delta\,\tau-l\,\tau-\tau\,l^{T}
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DEGL_to_SPATIAL_MODULI_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DEGL_to_SPATIAL_MODULI_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: spatial moduli
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F) noexcept {
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = u0 * F[0];
        Kr(1, 0) = u1 * F[1];
        Kr(2, 0) = u2 * F[2];
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x1 = F[1] * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = u0 * F[0];
        Kr(1, 1) = u1 * F[1];
        Kr(2, 1) = u2 * F[2];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = u0 * F[0];
        Kr(1, 2) = u1 * F[1];
        Kr(2, 2) = u2 * F[2];
      }
    }
  };  // end of struct DS_DEGL_to_SPATIAL_MODULI_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DEGL_to_SPATIAL_MODULI_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: spatial moduli
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto x1 = F[3] * F[3];
        const auto x3 = cste * F[0] * F[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = u0 * F[0] + u3 * F[3];
        Kr(1, 0) = u1 * F[1] + u4 * F[4];
        Kr(2, 0) = u2 * F[2];
        Kr(3, 0) = cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = F[4] * F[4];
        const auto x1 = F[1] * F[1];
        const auto x3 = cste * F[1] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = u0 * F[0] + u3 * F[3];
        Kr(1, 1) = u1 * F[1] + u4 * F[4];
        Kr(2, 1) = u2 * F[2];
        Kr(3, 1) = cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = u0 * F[0] + u3 * F[3];
        Kr(1, 2) = u1 * F[1] + u4 * F[4];
        Kr(2, 2) = u2 * F[2];
        Kr(3, 2) = cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[4];
        const auto x1 = cste * F[1] * F[3];
        const auto x3 = F[0] * F[1] + F[3] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = u0 * F[0] + u3 * F[3];
        Kr(1, 3) = u1 * F[1] + u4 * F[4];
        Kr(2, 3) = u2 * F[2];
        Kr(3, 3) = cste * (u0 * F[4] + u3 * F[1]);
      }
    }
  };  // end of struct DS_DEGL_to_SPATIAL_MODULI_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DEGL_to_SPATIAL_MODULI_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: spatial moduli
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto x1 = F[3] * F[3];
        const auto x2 = F[5] * F[5];
        const auto x3 = cste * F[0] * F[3];
        const auto x4 = cste * F[0] * F[5];
        const auto x5 = cste * F[3] * F[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 0) = u0 * F[0] + u3 * F[3] + u5 * F[5];
        Kr(1, 0) = u1 * F[1] + u4 * F[4] + u7 * F[7];
        Kr(2, 0) = u2 * F[2] + u6 * F[6] + u8 * F[8];
        Kr(3, 0) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 0) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 0) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = F[4] * F[4];
        const auto x1 = F[1] * F[1];
        const auto x2 = F[7] * F[7];
        const auto x3 = cste * F[1] * F[4];
        const auto x4 = cste * F[4] * F[7];
        const auto x5 = cste * F[1] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 1) = u0 * F[0] + u3 * F[3] + u5 * F[5];
        Kr(1, 1) = u1 * F[1] + u4 * F[4] + u7 * F[7];
        Kr(2, 1) = u2 * F[2] + u6 * F[6] + u8 * F[8];
        Kr(3, 1) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 1) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 1) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x0 = F[6] * F[6];
        const auto x1 = F[8] * F[8];
        const auto x2 = F[2] * F[2];
        const auto x3 = cste * F[6] * F[8];
        const auto x4 = cste * F[2] * F[6];
        const auto x5 = cste * F[2] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 2) = u0 * F[0] + u3 * F[3] + u5 * F[5];
        Kr(1, 2) = u1 * F[1] + u4 * F[4] + u7 * F[7];
        Kr(2, 2) = u2 * F[2] + u6 * F[6] + u8 * F[8];
        Kr(3, 2) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 2) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 2) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[4];
        const auto x1 = cste * F[1] * F[3];
        const auto x2 = cste * F[5] * F[7];
        const auto x3 = F[0] * F[1] + F[3] * F[4];
        const auto x4 = F[0] * F[7] + F[4] * F[5];
        const auto x5 = F[1] * F[5] + F[3] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 3) = u0 * F[0] + u3 * F[3] + u5 * F[5];
        Kr(1, 3) = u1 * F[1] + u4 * F[4] + u7 * F[7];
        Kr(2, 3) = u2 * F[2] + u6 * F[6] + u8 * F[8];
        Kr(3, 3) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 3) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 3) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (0, 2) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[6];
        const auto x1 = cste * F[3] * F[8];
        const auto x2 = cste * F[2] * F[5];
        const auto x3 = F[0] * F[8] + F[3] * F[6];
        const auto x4 = F[0] * F[2] + F[5] * F[6];
        const auto x5 = F[2] * F[3] + F[5] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 4) = u0 * F[0] + u3 * F[3] + u5 * F[5];
        Kr(1, 4) = u1 * F[1] + u4 * F[4] + u7 * F[7];
        Kr(2, 4) = u2 * F[2] + u6 * F[6] + u8 * F[8];
        Kr(3, 4) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 4) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 4) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 2) of the rate of
        // deformation
        const auto x0 = cste * F[4] * F[6];
        const auto x1 = cste * F[1] * F[8];
        const auto x2 = cste * F[2] * F[7];
        const auto x3 = F[1] * F[6] + F[4] * F[8];
        const auto x4 = F[2] * F[4] + F[6] * F[7];
        const auto x5 = F[1] * F[2] + F[7] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 5) = u0 * F[0] + u3 * F[3] + u5 * F[5];
        Kr(1, 5) = u1 * F[1] + u4 * F[4] + u7 * F[7];
        Kr(2, 5) = u2 * F[2] + u6 * F[6] + u8 * F[8];
        Kr(3, 5) = cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 5) = cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 5) = cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
    }
  };  // end of struct DS_DEGL_to_SPATIAL_MODULI_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the Green-Lagrange strain (DS_DEGL) to the moduli
   * associated with the Jaumann rate of the Kirchhoff stress divided by the
   * change of volume (ABAQUS).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and ABAQUS relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-w\,\tau+\tau\,w\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DEGL_to_ABAQUS_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DEGL_to_ABAQUS_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = iJ * u0 * F[0] + 2 * s[0];
        Kr(1, 0) = iJ * u1 * F[1];
        Kr(2, 0) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x1 = F[1] * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = iJ * u0 * F[0];
        Kr(1, 1) = iJ * u1 * F[1] + 2 * s[1];
        Kr(2, 1) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = iJ * u0 * F[0];
        Kr(1, 2) = iJ * u1 * F[1];
        Kr(2, 2) = iJ * u2 * F[2] + 2 * s[2];
      }
    }
  };  // end of struct DS_DEGL_to_ABAQUS_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DEGL_to_ABAQUS_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto x1 = F[3] * F[3];
        const auto x3 = cste * F[0] * F[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3]) + 2 * s[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 0) = iJ * u2 * F[2];
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1]) + s[3];
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = F[4] * F[4];
        const auto x1 = F[1] * F[1];
        const auto x3 = cste * F[1] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4]) + 2 * s[1];
        Kr(2, 1) = iJ * u2 * F[2];
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1]) + s[3];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 2) = iJ * u2 * F[2] + 2 * s[2];
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[4];
        const auto x1 = cste * F[1] * F[3];
        const auto x3 = F[0] * F[1] + F[3] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3]) + s[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4]) + s[3];
        Kr(2, 3) = iJ * u2 * F[2];
        Kr(3, 3) = iJ * cste * (u0 * F[4] + u3 * F[1]) + s[0] + s[1];
      }
    }
  };  // end of struct DS_DEGL_to_ABAQUS_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DEGL_to_ABAQUS_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto x1 = F[3] * F[3];
        const auto x2 = F[5] * F[5];
        const auto x3 = cste * F[0] * F[3];
        const auto x4 = cste * F[0] * F[5];
        const auto x5 = cste * F[3] * F[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]) + 2 * s[0];
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 0) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + s[3];
        Kr(4, 0) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + s[4];
        Kr(5, 0) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = F[4] * F[4];
        const auto x1 = F[1] * F[1];
        const auto x2 = F[7] * F[7];
        const auto x3 = cste * F[1] * F[4];
        const auto x4 = cste * F[4] * F[7];
        const auto x5 = cste * F[1] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]) + 2 * s[1];
        Kr(2, 1) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + s[3];
        Kr(4, 1) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 1) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + s[5];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x0 = F[6] * F[6];
        const auto x1 = F[8] * F[8];
        const auto x2 = F[2] * F[2];
        const auto x3 = cste * F[6] * F[8];
        const auto x4 = cste * F[2] * F[6];
        const auto x5 = cste * F[2] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 2) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]) + 2 * s[2];
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 2) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + s[4];
        Kr(5, 2) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + s[5];
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[4];
        const auto x1 = cste * F[1] * F[3];
        const auto x2 = cste * F[5] * F[7];
        const auto x3 = F[0] * F[1] + F[3] * F[4];
        const auto x4 = F[0] * F[7] + F[4] * F[5];
        const auto x5 = F[1] * F[5] + F[3] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]) + s[3];
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]) + s[3];
        Kr(2, 3) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 3) =
            iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + s[0] + s[1];
        Kr(4, 3) =
            iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + icste * s[5];
        Kr(5, 3) =
            iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + icste * s[4];
      }
      {
        // column associated with the component (0, 2) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[6];
        const auto x1 = cste * F[3] * F[8];
        const auto x2 = cste * F[2] * F[5];
        const auto x3 = F[0] * F[8] + F[3] * F[6];
        const auto x4 = F[0] * F[2] + F[5] * F[6];
        const auto x5 = F[2] * F[3] + F[5] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]) + s[4];
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 4) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]) + s[4];
        Kr(3, 4) =
            iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + icste * s[5];
        Kr(4, 4) =
            iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + s[0] + s[2];
        Kr(5, 4) =
            iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + icste * s[3];
      }
      {
        // column associated with the component (1, 2) of the rate of
        // deformation
        const auto x0 = cste * F[4] * F[6];
        const auto x1 = cste * F[1] * F[8];
        const auto x2 = cste * F[2] * F[7];
        const auto x3 = F[1] * F[6] + F[4] * F[8];
        const auto x4 = F[2] * F[4] + F[6] * F[7];
        const auto x5 = F[1] * F[2] + F[7] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 5) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 5) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]) + s[5];
        Kr(2, 5) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]) + s[5];
        Kr(3, 5) =
            iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]) + icste * s[4];
        Kr(4, 5) =
            iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]) + icste * s[3];
        Kr(5, 5) =
            iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]) + s[1] + s[2];
      }
    }
  };  // end of struct DS_DEGL_to_ABAQUS_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the derivative of the second Piola-Kirchhoff stress
   * with respect to the Green-Lagrange strain (DS_DEGL) to the moduli
   * associated with the Truesdell rate of the Cauchy stress (C_TRUESDELL).
   * The result is computed column by column, i.e. component by component of the
   * rate of deformation. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * and C_TRUESDELL relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct DS_DEGL_to_C_TRUESDELL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct DS_DEGL_to_C_TRUESDELL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F) noexcept {
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 0) = iJ * u0 * F[0];
        Kr(1, 0) = iJ * u1 * F[1];
        Kr(2, 0) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x1 = F[1] * F[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 1) = iJ * u0 * F[0];
        Kr(1, 1) = iJ * u1 * F[1];
        Kr(2, 1) = iJ * u2 * F[2];
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * F[0];
        const auto u1 = a1 * F[1];
        const auto u2 = a2 * F[2];
        Kr(0, 2) = iJ * u0 * F[0];
        Kr(1, 2) = iJ * u1 * F[1];
        Kr(2, 2) = iJ * u2 * F[2];
      }
    }
  };  // end of struct DS_DEGL_to_C_TRUESDELL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct DS_DEGL_to_C_TRUESDELL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto x1 = F[3] * F[3];
        const auto x3 = cste * F[0] * F[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 0) = iJ * u2 * F[2];
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = F[4] * F[4];
        const auto x1 = F[1] * F[1];
        const auto x3 = cste * F[1] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 1) = iJ * u2 * F[2];
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x2 = F[2] * F[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 2) = iJ * u2 * F[2];
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[4];
        const auto x1 = cste * F[1] * F[3];
        const auto x3 = F[0] * F[1] + F[3] * F[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * F[0] + a3 * F[3];
        const auto u1 = a1 * F[1] + a3 * F[4];
        const auto u2 = a2 * F[2];
        const auto u3 = a1 * F[3] + a3 * F[0];
        const auto u4 = a0 * F[4] + a3 * F[1];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3]);
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4]);
        Kr(2, 3) = iJ * u2 * F[2];
        Kr(3, 3) = iJ * cste * (u0 * F[4] + u3 * F[1]);
      }
    }
  };  // end of struct DS_DEGL_to_C_TRUESDELL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct DS_DEGL_to_C_TRUESDELL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] Ks: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      {
        // column associated with the component (0, 0) of the rate of
        // deformation
        const auto x0 = F[0] * F[0];
        const auto x1 = F[3] * F[3];
        const auto x2 = F[5] * F[5];
        const auto x3 = cste * F[0] * F[3];
        const auto x4 = cste * F[0] * F[5];
        const auto x5 = cste * F[3] * F[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 0) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 0) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 0) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 0) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 0) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 0) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 1) of the rate of
        // deformation
        const auto x0 = F[4] * F[4];
        const auto x1 = F[1] * F[1];
        const auto x2 = F[7] * F[7];
        const auto x3 = cste * F[1] * F[4];
        const auto x4 = cste * F[4] * F[7];
        const auto x5 = cste * F[1] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 1) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 1) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 1) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 1) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 1) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 1) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (2, 2) of the rate of
        // deformation
        const auto x0 = F[6] * F[6];
        const auto x1 = F[8] * F[8];
        const auto x2 = F[2] * F[2];
        const auto x3 = cste * F[6] * F[8];
        const auto x4 = cste * F[2] * F[6];
        const auto x5 = cste * F[2] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 2) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 2) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 2) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 2) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 2) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 2) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (0, 1) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[4];
        const auto x1 = cste * F[1] * F[3];
        const auto x2 = cste * F[5] * F[7];
        const auto x3 = F[0] * F[1] + F[3] * F[4];
        const auto x4 = F[0] * F[7] + F[4] * F[5];
        const auto x5 = F[1] * F[5] + F[3] * F[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 3) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 3) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 3) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 3) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 3) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 3) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (0, 2) of the rate of
        // deformation
        const auto x0 = cste * F[0] * F[6];
        const auto x1 = cste * F[3] * F[8];
        const auto x2 = cste * F[2] * F[5];
        const auto x3 = F[0] * F[8] + F[3] * F[6];
        const auto x4 = F[0] * F[2] + F[5] * F[6];
        const auto x5 = F[2] * F[3] + F[5] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 4) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 4) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 4) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 4) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 4) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 4) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
      {
        // column associated with the component (1, 2) of the rate of
        // deformation
        const auto x0 = cste * F[4] * F[6];
        const auto x1 = cste * F[1] * F[8];
        const auto x2 = cste * F[2] * F[7];
        const auto x3 = F[1] * F[6] + F[4] * F[8];
        const auto x4 = F[2] * F[4] + F[6] * F[7];
        const auto x5 = F[1] * F[2] + F[7] * F[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * F[0] + a3 * F[3] + a4 * F[5];
        const auto u1 = a1 * F[1] + a3 * F[4] + a5 * F[7];
        const auto u2 = a2 * F[2] + a4 * F[6] + a5 * F[8];
        const auto u3 = a1 * F[3] + a3 * F[0] + a5 * F[5];
        const auto u4 = a0 * F[4] + a3 * F[1] + a4 * F[7];
        const auto u5 = a2 * F[5] + a4 * F[0] + a5 * F[3];
        const auto u6 = a0 * F[6] + a3 * F[8] + a4 * F[2];
        const auto u7 = a2 * F[7] + a4 * F[4] + a5 * F[1];
        const auto u8 = a1 * F[8] + a3 * F[6] + a5 * F[2];
        Kr(0, 5) = iJ * (u0 * F[0] + u3 * F[3] + u5 * F[5]);
        Kr(1, 5) = iJ * (u1 * F[1] + u4 * F[4] + u7 * F[7]);
        Kr(2, 5) = iJ * (u2 * F[2] + u6 * F[6] + u8 * F[8]);
        Kr(3, 5) = iJ * cste * (u0 * F[4] + u3 * F[1] + u5 * F[7]);
        Kr(4, 5) = iJ * cste * (u0 * F[6] + u3 * F[8] + u5 * F[2]);
        Kr(5, 5) = iJ * cste * (u1 * F[8] + u4 * F[6] + u7 * F[2]);
      }
    }
  };  // end of struct DS_DEGL_to_C_TRUESDELL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the spatial moduli (SPATIAL_MODULI) to the derivative
   * of the Kirchhoff stress with respect to the deformation gradient (DTAU_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. SPATIAL_MODULI
   * relates
   * \f[
   * \delta\,\tau-l\,\tau-\tau\,l^{T}
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct SPATIAL_MODULI_to_DTAU_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct SPATIAL_MODULI_to_DTAU_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = Ks(0, 0) * iF[0] + 2 * P[0];
      Kr(1, 0) = Ks(1, 0) * iF[0];
      Kr(2, 0) = Ks(2, 0) * iF[0];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = Ks(0, 1) * iF[1];
      Kr(1, 1) = Ks(1, 1) * iF[1] + 2 * P[1];
      Kr(2, 1) = Ks(2, 1) * iF[1];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2];
      Kr(1, 2) = Ks(1, 2) * iF[2];
      Kr(2, 2) = Ks(2, 2) * iF[2] + 2 * P[2];
    }
  };  // end of struct SPATIAL_MODULI_to_DTAU_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct SPATIAL_MODULI_to_DTAU_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + 2 * P[0];
        Kr(1, 0) = Ks(1, 0) * iF[0] + Ks(1, 3) * x3;
        Kr(2, 0) = Ks(2, 0) * iF[0] + Ks(2, 3) * x3;
        Kr(3, 0) = Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + cste * P[4];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        Kr(0, 1) = Ks(0, 1) * iF[1] + Ks(0, 3) * x3;
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + 2 * P[1];
        Kr(2, 1) = Ks(2, 1) * iF[1] + Ks(2, 3) * x3;
        Kr(3, 1) = Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + cste * P[3];
      }
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2];
      Kr(1, 2) = Ks(1, 2) * iF[2];
      Kr(2, 2) = Ks(2, 2) * iF[2] + 2 * P[2];
      Kr(3, 2) = Ks(3, 2) * iF[2];
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + 2 * P[3];
        Kr(1, 3) = Ks(1, 0) * iF[4] + Ks(1, 3) * x3;
        Kr(2, 3) = Ks(2, 0) * iF[4] + Ks(2, 3) * x3;
        Kr(3, 3) = Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + cste * P[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        Kr(0, 4) = Ks(0, 1) * iF[3] + Ks(0, 3) * x3;
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + 2 * P[4];
        Kr(2, 4) = Ks(2, 1) * iF[3] + Ks(2, 3) * x3;
        Kr(3, 4) = Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + cste * P[0];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DTAU_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct SPATIAL_MODULI_to_DTAU_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto x4 = icste * iF[5];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + 2 * P[0];
        Kr(1, 0) = Ks(1, 0) * iF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        Kr(2, 0) = Ks(2, 0) * iF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        Kr(3, 0) =
            Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4 + cste * P[4];
        Kr(4, 0) =
            Ks(4, 0) * iF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4 + cste * P[6];
        Kr(5, 0) = Ks(5, 0) * iF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4;
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto x5 = icste * iF[7];
        Kr(0, 1) = Ks(0, 1) * iF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + 2 * P[1];
        Kr(2, 1) = Ks(2, 1) * iF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        Kr(3, 1) =
            Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5 + cste * P[3];
        Kr(4, 1) = Ks(4, 1) * iF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5;
        Kr(5, 1) =
            Ks(5, 1) * iF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5 + cste * P[8];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * iF[6];
        const auto x5 = icste * iF[8];
        Kr(0, 2) = Ks(0, 2) * iF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        Kr(1, 2) = Ks(1, 2) * iF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        Kr(2, 2) = Ks(2, 2) * iF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + 2 * P[2];
        Kr(3, 2) = Ks(3, 2) * iF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5;
        Kr(4, 2) =
            Ks(4, 2) * iF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5 + cste * P[5];
        Kr(5, 2) =
            Ks(5, 2) * iF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5 + cste * P[7];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto x4 = icste * iF[7];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + 2 * P[3];
        Kr(1, 3) = Ks(1, 0) * iF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        Kr(2, 3) = Ks(2, 0) * iF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        Kr(3, 3) =
            Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4 + cste * P[1];
        Kr(4, 3) =
            Ks(4, 0) * iF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4 + cste * P[8];
        Kr(5, 3) = Ks(5, 0) * iF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto x5 = icste * iF[5];
        Kr(0, 4) = Ks(0, 1) * iF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + 2 * P[4];
        Kr(2, 4) = Ks(2, 1) * iF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        Kr(3, 4) =
            Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5 + cste * P[0];
        Kr(4, 4) = Ks(4, 1) * iF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5;
        Kr(5, 4) =
            Ks(5, 1) * iF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5 + cste * P[6];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[8];
        const auto x4 = icste * iF[2];
        Kr(0, 5) = Ks(0, 0) * iF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + 2 * P[5];
        Kr(1, 5) = Ks(1, 0) * iF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        Kr(2, 5) = Ks(2, 0) * iF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        Kr(3, 5) =
            Ks(3, 0) * iF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4 + cste * P[7];
        Kr(4, 5) =
            Ks(4, 0) * iF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4 + cste * P[2];
        Kr(5, 5) = Ks(5, 0) * iF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4;
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x4 = icste * iF[0];
        const auto x5 = icste * iF[3];
        Kr(0, 6) = Ks(0, 2) * iF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        Kr(1, 6) = Ks(1, 2) * iF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        Kr(2, 6) = Ks(2, 2) * iF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + 2 * P[6];
        Kr(3, 6) = Ks(3, 2) * iF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5;
        Kr(4, 6) =
            Ks(4, 2) * iF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5 + cste * P[0];
        Kr(5, 6) =
            Ks(5, 2) * iF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5 + cste * P[4];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[6];
        const auto x5 = icste * iF[2];
        Kr(0, 7) = Ks(0, 1) * iF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        Kr(1, 7) = Ks(1, 1) * iF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + 2 * P[7];
        Kr(2, 7) = Ks(2, 1) * iF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        Kr(3, 7) =
            Ks(3, 1) * iF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5 + cste * P[5];
        Kr(4, 7) = Ks(4, 1) * iF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5;
        Kr(5, 7) =
            Ks(5, 1) * iF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5 + cste * P[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x4 = icste * iF[4];
        const auto x5 = icste * iF[1];
        Kr(0, 8) = Ks(0, 2) * iF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        Kr(1, 8) = Ks(1, 2) * iF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        Kr(2, 8) = Ks(2, 2) * iF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + 2 * P[8];
        Kr(3, 8) = Ks(3, 2) * iF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5;
        Kr(4, 8) =
            Ks(4, 2) * iF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5 + cste * P[3];
        Kr(5, 8) =
            Ks(5, 2) * iF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5 + cste * P[1];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DTAU_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the spatial moduli (SPATIAL_MODULI) to the derivative
   * of the Kirchhoff stress with respect to the deformation gradient increment
   * (DTAU_DDF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient increment \f$\Delta\,F=F\,F_{0}^{-1}\f$. Let
   * \f$\delta\,F\f$ be the variation of the deformation gradient associated
   * with this component, \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of
   * \f$l\f$ and \f$\delta\,\tau\f$ the variation of the Kirchhoff stress.
   * SPATIAL_MODULI relates
   * \f[
   * \delta\,\tau-l\,\tau-\tau\,l^{T}
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DTAU_DDF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,\Delta\,F=\delta\,F\,F_{0}^{-1}
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct SPATIAL_MODULI_to_DTAU_DDF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct SPATIAL_MODULI_to_DTAU_DDF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: spatial moduli
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F0,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const tfel::math::tensor<1u, real> idF = F0 * iF;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<1u, stress> tidF = P * tfel::math::transpose(F0);
      // derivative with respect to the component (0, 0) of the deformation
      // gradient increment
      Kr(0, 0) = Ks(0, 0) * idF[0] + 2 * tidF[0];
      Kr(1, 0) = Ks(1, 0) * idF[0];
      Kr(2, 0) = Ks(2, 0) * idF[0];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient increment
      Kr(0, 1) = Ks(0, 1) * idF[1];
      Kr(1, 1) = Ks(1, 1) * idF[1] + 2 * tidF[1];
      Kr(2, 1) = Ks(2, 1) * idF[1];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient increment
      Kr(0, 2) = Ks(0, 2) * idF[2];
      Kr(1, 2) = Ks(1, 2) * idF[2];
      Kr(2, 2) = Ks(2, 2) * idF[2] + 2 * tidF[2];
    }
  };  // end of struct SPATIAL_MODULI_to_DTAU_DDF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct SPATIAL_MODULI_to_DTAU_DDF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: spatial moduli
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F0,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const tfel::math::tensor<2u, real> idF = F0 * iF;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<2u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient increment
        const auto x3 = icste * idF[3];
        Kr(0, 0) = Ks(0, 0) * idF[0] + Ks(0, 3) * x3 + 2 * tidF[0];
        Kr(1, 0) = Ks(1, 0) * idF[0] + Ks(1, 3) * x3;
        Kr(2, 0) = Ks(2, 0) * idF[0] + Ks(2, 3) * x3;
        Kr(3, 0) = Ks(3, 0) * idF[0] + Ks(3, 3) * x3 + cste * tidF[4];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient increment
        const auto x3 = icste * idF[4];
        Kr(0, 1) = Ks(0, 1) * idF[1] + Ks(0, 3) * x3;
        Kr(1, 1) = Ks(1, 1) * idF[1] + Ks(1, 3) * x3 + 2 * tidF[1];
        Kr(2, 1) = Ks(2, 1) * idF[1] + Ks(2, 3) * x3;
        Kr(3, 1) = Ks(3, 1) * idF[1] + Ks(3, 3) * x3 + cste * tidF[3];
      }
      // derivative with respect to the component (2, 2) of the deformation
      // gradient increment
      Kr(0, 2) = Ks(0, 2) * idF[2];
      Kr(1, 2) = Ks(1, 2) * idF[2];
      Kr(2, 2) = Ks(2, 2) * idF[2] + 2 * tidF[2];
      Kr(3, 2) = Ks(3, 2) * idF[2];
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient increment
        const auto x3 = icste * idF[1];
        Kr(0, 3) = Ks(0, 0) * idF[4] + Ks(0, 3) * x3 + 2 * tidF[3];
        Kr(1, 3) = Ks(1, 0) * idF[4] + Ks(1, 3) * x3;
        Kr(2, 3) = Ks(2, 0) * idF[4] + Ks(2, 3) * x3;
        Kr(3, 3) = Ks(3, 0) * idF[4] + Ks(3, 3) * x3 + cste * tidF[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient increment
        const auto x3 = icste * idF[0];
        Kr(0, 4) = Ks(0, 1) * idF[3] + Ks(0, 3) * x3;
        Kr(1, 4) = Ks(1, 1) * idF[3] + Ks(1, 3) * x3 + 2 * tidF[4];
        Kr(2, 4) = Ks(2, 1) * idF[3] + Ks(2, 3) * x3;
        Kr(3, 4) = Ks(3, 1) * idF[3] + Ks(3, 3) * x3 + cste * tidF[0];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DTAU_DDF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct SPATIAL_MODULI_to_DTAU_DDF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient increment
     * \param[in] Ks: spatial moduli
     * \param[in] F0: deformation gradient at the beginning of the time step
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F0,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const tfel::math::tensor<3u, real> idF = F0 * iF;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<3u, stress> tidF = P * tfel::math::transpose(F0);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient increment
        const auto x3 = icste * idF[3];
        const auto x4 = icste * idF[5];
        Kr(0, 0) =
            Ks(0, 0) * idF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + 2 * tidF[0];
        Kr(1, 0) = Ks(1, 0) * idF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        Kr(2, 0) = Ks(2, 0) * idF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        Kr(3, 0) =
            Ks(3, 0) * idF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4 + cste * tidF[4];
        Kr(4, 0) =
            Ks(4, 0) * idF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4 + cste * tidF[6];
        Kr(5, 0) = Ks(5, 0) * idF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4;
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient increment
        const auto x3 = icste * idF[4];
        const auto x5 = icste * idF[7];
        Kr(0, 1) = Ks(0, 1) * idF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        Kr(1, 1) =
            Ks(1, 1) * idF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + 2 * tidF[1];
        Kr(2, 1) = Ks(2, 1) * idF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        Kr(3, 1) =
            Ks(3, 1) * idF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5 + cste * tidF[3];
        Kr(4, 1) = Ks(4, 1) * idF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5;
        Kr(5, 1) =
            Ks(5, 1) * idF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5 + cste * tidF[8];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient increment
        const auto x4 = icste * idF[6];
        const auto x5 = icste * idF[8];
        Kr(0, 2) = Ks(0, 2) * idF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        Kr(1, 2) = Ks(1, 2) * idF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        Kr(2, 2) =
            Ks(2, 2) * idF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + 2 * tidF[2];
        Kr(3, 2) = Ks(3, 2) * idF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5;
        Kr(4, 2) =
            Ks(4, 2) * idF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5 + cste * tidF[5];
        Kr(5, 2) =
            Ks(5, 2) * idF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5 + cste * tidF[7];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient increment
        const auto x3 = icste * idF[1];
        const auto x4 = icste * idF[7];
        Kr(0, 3) =
            Ks(0, 0) * idF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + 2 * tidF[3];
        Kr(1, 3) = Ks(1, 0) * idF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        Kr(2, 3) = Ks(2, 0) * idF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        Kr(3, 3) =
            Ks(3, 0) * idF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4 + cste * tidF[1];
        Kr(4, 3) =
            Ks(4, 0) * idF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4 + cste * tidF[8];
        Kr(5, 3) = Ks(5, 0) * idF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient increment
        const auto x3 = icste * idF[0];
        const auto x5 = icste * idF[5];
        Kr(0, 4) = Ks(0, 1) * idF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        Kr(1, 4) =
            Ks(1, 1) * idF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + 2 * tidF[4];
        Kr(2, 4) = Ks(2, 1) * idF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        Kr(3, 4) =
            Ks(3, 1) * idF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5 + cste * tidF[0];
        Kr(4, 4) = Ks(4, 1) * idF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5;
        Kr(5, 4) =
            Ks(5, 1) * idF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5 + cste * tidF[6];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient increment
        const auto x3 = icste * idF[8];
        const auto x4 = icste * idF[2];
        Kr(0, 5) =
            Ks(0, 0) * idF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + 2 * tidF[5];
        Kr(1, 5) = Ks(1, 0) * idF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        Kr(2, 5) = Ks(2, 0) * idF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        Kr(3, 5) =
            Ks(3, 0) * idF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4 + cste * tidF[7];
        Kr(4, 5) =
            Ks(4, 0) * idF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4 + cste * tidF[2];
        Kr(5, 5) = Ks(5, 0) * idF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4;
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient increment
        const auto x4 = icste * idF[0];
        const auto x5 = icste * idF[3];
        Kr(0, 6) = Ks(0, 2) * idF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        Kr(1, 6) = Ks(1, 2) * idF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        Kr(2, 6) =
            Ks(2, 2) * idF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + 2 * tidF[6];
        Kr(3, 6) = Ks(3, 2) * idF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5;
        Kr(4, 6) =
            Ks(4, 2) * idF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5 + cste * tidF[0];
        Kr(5, 6) =
            Ks(5, 2) * idF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5 + cste * tidF[4];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient increment
        const auto x3 = icste * idF[6];
        const auto x5 = icste * idF[2];
        Kr(0, 7) = Ks(0, 1) * idF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        Kr(1, 7) =
            Ks(1, 1) * idF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + 2 * tidF[7];
        Kr(2, 7) = Ks(2, 1) * idF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        Kr(3, 7) =
            Ks(3, 1) * idF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5 + cste * tidF[5];
        Kr(4, 7) = Ks(4, 1) * idF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5;
        Kr(5, 7) =
            Ks(5, 1) * idF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5 + cste * tidF[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient increment
        const auto x4 = icste * idF[4];
        const auto x5 = icste * idF[1];
        Kr(0, 8) = Ks(0, 2) * idF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        Kr(1, 8) = Ks(1, 2) * idF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        Kr(2, 8) =
            Ks(2, 2) * idF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + 2 * tidF[8];
        Kr(3, 8) = Ks(3, 2) * idF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5;
        Kr(4, 8) =
            Ks(4, 2) * idF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5 + cste * tidF[3];
        Kr(5, 8) =
            Ks(5, 2) * idF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5 + cste * tidF[1];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DTAU_DDF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the spatial moduli (SPATIAL_MODULI) to the derivative
   * of the Cauchy stress with respect to the deformation gradient (DSIG_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. SPATIAL_MODULI
   * relates
   * \f[
   * \delta\,\tau-l\,\tau-\tau\,l^{T}
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct SPATIAL_MODULI_to_DSIG_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct SPATIAL_MODULI_to_DSIG_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<1u, stress> siF = iJ * P;
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = iJ * Ks(0, 0) * iF[0] - iF[0] * s[0] + 2 * siF[0];
      Kr(1, 0) = iJ * Ks(1, 0) * iF[0] - iF[0] * s[1];
      Kr(2, 0) = iJ * Ks(2, 0) * iF[0] - iF[0] * s[2];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = iJ * Ks(0, 1) * iF[1] - iF[1] * s[0];
      Kr(1, 1) = iJ * Ks(1, 1) * iF[1] - iF[1] * s[1] + 2 * siF[1];
      Kr(2, 1) = iJ * Ks(2, 1) * iF[1] - iF[1] * s[2];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = iJ * Ks(0, 2) * iF[2] - iF[2] * s[0];
      Kr(1, 2) = iJ * Ks(1, 2) * iF[2] - iF[2] * s[1];
      Kr(2, 2) = iJ * Ks(2, 2) * iF[2] - iF[2] * s[2] + 2 * siF[2];
    }
  };  // end of struct SPATIAL_MODULI_to_DSIG_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct SPATIAL_MODULI_to_DSIG_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<2u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        Kr(0, 0) =
            iJ * (Ks(0, 0) * iF[0] + Ks(0, 3) * x3) - iF[0] * s[0] + 2 * siF[0];
        Kr(1, 0) = iJ * (Ks(1, 0) * iF[0] + Ks(1, 3) * x3) - iF[0] * s[1];
        Kr(2, 0) = iJ * (Ks(2, 0) * iF[0] + Ks(2, 3) * x3) - iF[0] * s[2];
        Kr(3, 0) = iJ * (Ks(3, 0) * iF[0] + Ks(3, 3) * x3) - iF[0] * s[3] +
                   cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        Kr(0, 1) = iJ * (Ks(0, 1) * iF[1] + Ks(0, 3) * x3) - iF[1] * s[0];
        Kr(1, 1) =
            iJ * (Ks(1, 1) * iF[1] + Ks(1, 3) * x3) - iF[1] * s[1] + 2 * siF[1];
        Kr(2, 1) = iJ * (Ks(2, 1) * iF[1] + Ks(2, 3) * x3) - iF[1] * s[2];
        Kr(3, 1) = iJ * (Ks(3, 1) * iF[1] + Ks(3, 3) * x3) - iF[1] * s[3] +
                   cste * siF[3];
      }
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = iJ * Ks(0, 2) * iF[2] - iF[2] * s[0];
      Kr(1, 2) = iJ * Ks(1, 2) * iF[2] - iF[2] * s[1];
      Kr(2, 2) = iJ * Ks(2, 2) * iF[2] - iF[2] * s[2] + 2 * siF[2];
      Kr(3, 2) = iJ * Ks(3, 2) * iF[2] - iF[2] * s[3];
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        Kr(0, 3) =
            iJ * (Ks(0, 0) * iF[4] + Ks(0, 3) * x3) - iF[4] * s[0] + 2 * siF[3];
        Kr(1, 3) = iJ * (Ks(1, 0) * iF[4] + Ks(1, 3) * x3) - iF[4] * s[1];
        Kr(2, 3) = iJ * (Ks(2, 0) * iF[4] + Ks(2, 3) * x3) - iF[4] * s[2];
        Kr(3, 3) = iJ * (Ks(3, 0) * iF[4] + Ks(3, 3) * x3) - iF[4] * s[3] +
                   cste * siF[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        Kr(0, 4) = iJ * (Ks(0, 1) * iF[3] + Ks(0, 3) * x3) - iF[3] * s[0];
        Kr(1, 4) =
            iJ * (Ks(1, 1) * iF[3] + Ks(1, 3) * x3) - iF[3] * s[1] + 2 * siF[4];
        Kr(2, 4) = iJ * (Ks(2, 1) * iF[3] + Ks(2, 3) * x3) - iF[3] * s[2];
        Kr(3, 4) = iJ * (Ks(3, 1) * iF[3] + Ks(3, 3) * x3) - iF[3] * s[3] +
                   cste * siF[0];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DSIG_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct SPATIAL_MODULI_to_DSIG_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::tensor<3u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto x4 = icste * iF[5];
        Kr(0, 0) = iJ * (Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4) -
                   iF[0] * s[0] + 2 * siF[0];
        Kr(1, 0) = iJ * (Ks(1, 0) * iF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4) -
                   iF[0] * s[1];
        Kr(2, 0) = iJ * (Ks(2, 0) * iF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4) -
                   iF[0] * s[2];
        Kr(3, 0) = iJ * (Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4) -
                   iF[0] * s[3] + cste * siF[4];
        Kr(4, 0) = iJ * (Ks(4, 0) * iF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4) -
                   iF[0] * s[4] + cste * siF[6];
        Kr(5, 0) = iJ * (Ks(5, 0) * iF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4) -
                   iF[0] * s[5];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto x5 = icste * iF[7];
        Kr(0, 1) = iJ * (Ks(0, 1) * iF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5) -
                   iF[1] * s[0];
        Kr(1, 1) = iJ * (Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5) -
                   iF[1] * s[1] + 2 * siF[1];
        Kr(2, 1) = iJ * (Ks(2, 1) * iF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5) -
                   iF[1] * s[2];
        Kr(3, 1) = iJ * (Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5) -
                   iF[1] * s[3] + cste * siF[3];
        Kr(4, 1) = iJ * (Ks(4, 1) * iF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5) -
                   iF[1] * s[4];
        Kr(5, 1) = iJ * (Ks(5, 1) * iF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5) -
                   iF[1] * s[5] + cste * siF[8];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * iF[6];
        const auto x5 = icste * iF[8];
        Kr(0, 2) = iJ * (Ks(0, 2) * iF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5) -
                   iF[2] * s[0];
        Kr(1, 2) = iJ * (Ks(1, 2) * iF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5) -
                   iF[2] * s[1];
        Kr(2, 2) = iJ * (Ks(2, 2) * iF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5) -
                   iF[2] * s[2] + 2 * siF[2];
        Kr(3, 2) = iJ * (Ks(3, 2) * iF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5) -
                   iF[2] * s[3];
        Kr(4, 2) = iJ * (Ks(4, 2) * iF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5) -
                   iF[2] * s[4] + cste * siF[5];
        Kr(5, 2) = iJ * (Ks(5, 2) * iF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5) -
                   iF[2] * s[5] + cste * siF[7];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto x4 = icste * iF[7];
        Kr(0, 3) = iJ * (Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4) -
                   iF[4] * s[0] + 2 * siF[3];
        Kr(1, 3) = iJ * (Ks(1, 0) * iF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4) -
                   iF[4] * s[1];
        Kr(2, 3) = iJ * (Ks(2, 0) * iF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4) -
                   iF[4] * s[2];
        Kr(3, 3) = iJ * (Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4) -
                   iF[4] * s[3] + cste * siF[1];
        Kr(4, 3) = iJ * (Ks(4, 0) * iF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4) -
                   iF[4] * s[4] + cste * siF[8];
        Kr(5, 3) = iJ * (Ks(5, 0) * iF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4) -
                   iF[4] * s[5];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto x5 = icste * iF[5];
        Kr(0, 4) = iJ * (Ks(0, 1) * iF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5) -
                   iF[3] * s[0];
        Kr(1, 4) = iJ * (Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5) -
                   iF[3] * s[1] + 2 * siF[4];
        Kr(2, 4) = iJ * (Ks(2, 1) * iF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5) -
                   iF[3] * s[2];
        Kr(3, 4) = iJ * (Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5) -
                   iF[3] * s[3] + cste * siF[0];
        Kr(4, 4) = iJ * (Ks(4, 1) * iF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5) -
                   iF[3] * s[4];
        Kr(5, 4) = iJ * (Ks(5, 1) * iF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5) -
                   iF[3] * s[5] + cste * siF[6];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[8];
        const auto x4 = icste * iF[2];
        Kr(0, 5) = iJ * (Ks(0, 0) * iF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4) -
                   iF[6] * s[0] + 2 * siF[5];
        Kr(1, 5) = iJ * (Ks(1, 0) * iF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4) -
                   iF[6] * s[1];
        Kr(2, 5) = iJ * (Ks(2, 0) * iF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4) -
                   iF[6] * s[2];
        Kr(3, 5) = iJ * (Ks(3, 0) * iF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4) -
                   iF[6] * s[3] + cste * siF[7];
        Kr(4, 5) = iJ * (Ks(4, 0) * iF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4) -
                   iF[6] * s[4] + cste * siF[2];
        Kr(5, 5) = iJ * (Ks(5, 0) * iF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4) -
                   iF[6] * s[5];
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x4 = icste * iF[0];
        const auto x5 = icste * iF[3];
        Kr(0, 6) = iJ * (Ks(0, 2) * iF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5) -
                   iF[5] * s[0];
        Kr(1, 6) = iJ * (Ks(1, 2) * iF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5) -
                   iF[5] * s[1];
        Kr(2, 6) = iJ * (Ks(2, 2) * iF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5) -
                   iF[5] * s[2] + 2 * siF[6];
        Kr(3, 6) = iJ * (Ks(3, 2) * iF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5) -
                   iF[5] * s[3];
        Kr(4, 6) = iJ * (Ks(4, 2) * iF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5) -
                   iF[5] * s[4] + cste * siF[0];
        Kr(5, 6) = iJ * (Ks(5, 2) * iF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5) -
                   iF[5] * s[5] + cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[6];
        const auto x5 = icste * iF[2];
        Kr(0, 7) = iJ * (Ks(0, 1) * iF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5) -
                   iF[8] * s[0];
        Kr(1, 7) = iJ * (Ks(1, 1) * iF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5) -
                   iF[8] * s[1] + 2 * siF[7];
        Kr(2, 7) = iJ * (Ks(2, 1) * iF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5) -
                   iF[8] * s[2];
        Kr(3, 7) = iJ * (Ks(3, 1) * iF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5) -
                   iF[8] * s[3] + cste * siF[5];
        Kr(4, 7) = iJ * (Ks(4, 1) * iF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5) -
                   iF[8] * s[4];
        Kr(5, 7) = iJ * (Ks(5, 1) * iF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5) -
                   iF[8] * s[5] + cste * siF[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x4 = icste * iF[4];
        const auto x5 = icste * iF[1];
        Kr(0, 8) = iJ * (Ks(0, 2) * iF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5) -
                   iF[7] * s[0];
        Kr(1, 8) = iJ * (Ks(1, 2) * iF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5) -
                   iF[7] * s[1];
        Kr(2, 8) = iJ * (Ks(2, 2) * iF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5) -
                   iF[7] * s[2] + 2 * siF[8];
        Kr(3, 8) = iJ * (Ks(3, 2) * iF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5) -
                   iF[7] * s[3];
        Kr(4, 8) = iJ * (Ks(4, 2) * iF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5) -
                   iF[7] * s[4] + cste * siF[3];
        Kr(5, 8) = iJ * (Ks(5, 2) * iF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5) -
                   iF[7] * s[5] + cste * siF[1];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DSIG_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the spatial moduli (SPATIAL_MODULI) to the derivative
   * of the first Piola-Kirchhoff stress with respect to the deformation
   * gradient (DPK1_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. SPATIAL_MODULI
   * relates
   * \f[
   * \delta\,\tau-l\,\tau-\tau\,l^{T}
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DPK1_DF relates
   * \f[
   * \delta\,P=\left(\delta\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct SPATIAL_MODULI_to_DPK1_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct SPATIAL_MODULI_to_DPK1_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto a0 = Ks(0, 0) * iF[0];
        const auto a1 = Ks(1, 0) * iF[0];
        const auto a2 = Ks(2, 0) * iF[0];
        Kr(0, 0) = a0 * iF[0] + S[0];
        Kr(1, 0) = a1 * iF[1];
        Kr(2, 0) = a2 * iF[2];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto a0 = Ks(0, 1) * iF[1];
        const auto a1 = Ks(1, 1) * iF[1];
        const auto a2 = Ks(2, 1) * iF[1];
        Kr(0, 1) = a0 * iF[0];
        Kr(1, 1) = a1 * iF[1] + S[1];
        Kr(2, 1) = a2 * iF[2];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto a0 = Ks(0, 2) * iF[2];
        const auto a1 = Ks(1, 2) * iF[2];
        const auto a2 = Ks(2, 2) * iF[2];
        Kr(0, 2) = a0 * iF[0];
        Kr(1, 2) = a1 * iF[1];
        Kr(2, 2) = a2 * iF[2] + S[2];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DPK1_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct SPATIAL_MODULI_to_DPK1_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto a0 = Ks(0, 0) * iF[0] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * iF[0] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * iF[0] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * iF[0] + Ks(3, 3) * x3);
        Kr(0, 0) = a0 * iF[0] + a3 * iF[3] + S[0];
        Kr(1, 0) = a1 * iF[1] + a3 * iF[4];
        Kr(2, 0) = a2 * iF[2];
        Kr(3, 0) = a0 * iF[4] + a3 * iF[1] + icste * S[3];
        Kr(4, 0) = a1 * iF[3] + a3 * iF[0];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto a0 = Ks(0, 1) * iF[1] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * iF[1] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * iF[1] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * iF[1] + Ks(3, 3) * x3);
        Kr(0, 1) = a0 * iF[0] + a3 * iF[3];
        Kr(1, 1) = a1 * iF[1] + a3 * iF[4] + S[1];
        Kr(2, 1) = a2 * iF[2];
        Kr(3, 1) = a0 * iF[4] + a3 * iF[1];
        Kr(4, 1) = a1 * iF[3] + a3 * iF[0] + icste * S[3];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto a0 = Ks(0, 2) * iF[2];
        const auto a1 = Ks(1, 2) * iF[2];
        const auto a2 = Ks(2, 2) * iF[2];
        const auto a3 = icste * Ks(3, 2) * iF[2];
        Kr(0, 2) = a0 * iF[0] + a3 * iF[3];
        Kr(1, 2) = a1 * iF[1] + a3 * iF[4];
        Kr(2, 2) = a2 * iF[2] + S[2];
        Kr(3, 2) = a0 * iF[4] + a3 * iF[1];
        Kr(4, 2) = a1 * iF[3] + a3 * iF[0];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto a0 = Ks(0, 0) * iF[4] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * iF[4] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * iF[4] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * iF[4] + Ks(3, 3) * x3);
        Kr(0, 3) = a0 * iF[0] + a3 * iF[3] + icste * S[3];
        Kr(1, 3) = a1 * iF[1] + a3 * iF[4];
        Kr(2, 3) = a2 * iF[2];
        Kr(3, 3) = a0 * iF[4] + a3 * iF[1] + S[1];
        Kr(4, 3) = a1 * iF[3] + a3 * iF[0];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto a0 = Ks(0, 1) * iF[3] + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 1) * iF[3] + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 1) * iF[3] + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 1) * iF[3] + Ks(3, 3) * x3);
        Kr(0, 4) = a0 * iF[0] + a3 * iF[3];
        Kr(1, 4) = a1 * iF[1] + a3 * iF[4] + icste * S[3];
        Kr(2, 4) = a2 * iF[2];
        Kr(3, 4) = a0 * iF[4] + a3 * iF[1];
        Kr(4, 4) = a1 * iF[3] + a3 * iF[0] + S[0];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DPK1_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct SPATIAL_MODULI_to_DPK1_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the first Piola-Kirchhoff stress with
     * respect to the deformation gradient
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tot2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto S =
          tfel::math::convertCauchyStressToSecondPiolaKirchhoffStress(s, F);
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto x4 = icste * iF[5];
        const auto a0 = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * iF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * iF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * iF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * iF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 0) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5] + S[0];
        Kr(1, 0) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        Kr(2, 0) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        Kr(3, 0) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7] + icste * S[3];
        Kr(4, 0) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        Kr(5, 0) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2] + icste * S[4];
        Kr(6, 0) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        Kr(7, 0) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(8, 0) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto x5 = icste * iF[7];
        const auto a0 = Ks(0, 1) * iF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * iF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * iF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * iF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 1) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        Kr(1, 1) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7] + S[1];
        Kr(2, 1) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        Kr(3, 1) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        Kr(4, 1) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5] + icste * S[3];
        Kr(5, 1) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        Kr(6, 1) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        Kr(7, 1) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2] + icste * S[5];
        Kr(8, 1) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * iF[6];
        const auto x5 = icste * iF[8];
        const auto a0 = Ks(0, 2) * iF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * iF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * iF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * iF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * iF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * iF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 2) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        Kr(1, 2) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        Kr(2, 2) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8] + S[2];
        Kr(3, 2) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        Kr(4, 2) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        Kr(5, 2) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        Kr(6, 2) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3] + icste * S[4];
        Kr(7, 2) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(8, 2) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1] + icste * S[5];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto x4 = icste * iF[7];
        const auto a0 = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * iF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * iF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * iF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * iF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 3) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5] + icste * S[3];
        Kr(1, 3) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        Kr(2, 3) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        Kr(3, 3) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7] + S[1];
        Kr(4, 3) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        Kr(5, 3) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2] + icste * S[5];
        Kr(6, 3) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        Kr(7, 3) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(8, 3) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto x5 = icste * iF[5];
        const auto a0 = Ks(0, 1) * iF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * iF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * iF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * iF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 4) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        Kr(1, 4) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7] + icste * S[3];
        Kr(2, 4) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        Kr(3, 4) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        Kr(4, 4) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5] + S[0];
        Kr(5, 4) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        Kr(6, 4) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        Kr(7, 4) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2] + icste * S[4];
        Kr(8, 4) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[8];
        const auto x4 = icste * iF[2];
        const auto a0 = Ks(0, 0) * iF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4;
        const auto a1 = Ks(1, 0) * iF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4;
        const auto a2 = Ks(2, 0) * iF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4;
        const auto a3 =
            icste * (Ks(3, 0) * iF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4);
        const auto a4 =
            icste * (Ks(4, 0) * iF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4);
        const auto a5 =
            icste * (Ks(5, 0) * iF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4);
        Kr(0, 5) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5] + icste * S[4];
        Kr(1, 5) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        Kr(2, 5) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        Kr(3, 5) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7] + icste * S[5];
        Kr(4, 5) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        Kr(5, 5) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2] + S[2];
        Kr(6, 5) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        Kr(7, 5) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(8, 5) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x4 = icste * iF[0];
        const auto x5 = icste * iF[3];
        const auto a0 = Ks(0, 2) * iF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * iF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * iF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * iF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * iF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * iF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 6) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        Kr(1, 6) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        Kr(2, 6) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8] + icste * S[4];
        Kr(3, 6) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        Kr(4, 6) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        Kr(5, 6) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        Kr(6, 6) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3] + S[0];
        Kr(7, 6) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(8, 6) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1] + icste * S[3];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[6];
        const auto x5 = icste * iF[2];
        const auto a0 = Ks(0, 1) * iF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 1) * iF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 1) * iF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 1) * iF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 1) * iF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 1) * iF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5);
        Kr(0, 7) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        Kr(1, 7) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7] + icste * S[5];
        Kr(2, 7) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        Kr(3, 7) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        Kr(4, 7) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5] + icste * S[4];
        Kr(5, 7) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        Kr(6, 7) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        Kr(7, 7) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2] + S[2];
        Kr(8, 7) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x4 = icste * iF[4];
        const auto x5 = icste * iF[1];
        const auto a0 = Ks(0, 2) * iF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 2) * iF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 2) * iF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 =
            icste * (Ks(3, 2) * iF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 =
            icste * (Ks(4, 2) * iF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 =
            icste * (Ks(5, 2) * iF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        Kr(0, 8) = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        Kr(1, 8) = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        Kr(2, 8) = a2 * iF[2] + a4 * iF[6] + a5 * iF[8] + icste * S[5];
        Kr(3, 8) = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        Kr(4, 8) = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        Kr(5, 8) = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        Kr(6, 8) = a2 * iF[5] + a4 * iF[0] + a5 * iF[3] + icste * S[3];
        Kr(7, 8) = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(8, 8) = a2 * iF[7] + a4 * iF[4] + a5 * iF[1] + S[1];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DPK1_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the spatial moduli (SPATIAL_MODULI) to the derivative
   * of the second Piola-Kirchhoff stress with respect to the Green-Lagrange
   * strain (DS_DEGL).
   * The result is computed column by column, i.e. component by component of the
   * Green-Lagrange strain. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. SPATIAL_MODULI
   * relates
   * \f[
   * \delta\,\tau-l\,\tau-\tau\,l^{T}
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DS_DEGL relates
   * \f[
   * \delta\,S=F^{-1}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)\,F^{-T}
   * \quad\mathrm{to}\quad
   * \delta\,E=\mathrm{sym}\left(F^{T}\,\delta\,F\right)
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct SPATIAL_MODULI_to_DS_DEGL_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct SPATIAL_MODULI_to_DS_DEGL_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F) noexcept {
      const auto iF = tfel::math::invert(F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto x0 = iF[0] * iF[0];
        const auto a0 = Ks(0, 0) * x0;
        const auto a1 = Ks(1, 0) * x0;
        const auto a2 = Ks(2, 0) * x0;
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 0) = u0 * iF[0];
        Kr(1, 0) = u1 * iF[1];
        Kr(2, 0) = u2 * iF[2];
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto x1 = iF[1] * iF[1];
        const auto a0 = Ks(0, 1) * x1;
        const auto a1 = Ks(1, 1) * x1;
        const auto a2 = Ks(2, 1) * x1;
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 1) = u0 * iF[0];
        Kr(1, 1) = u1 * iF[1];
        Kr(2, 1) = u2 * iF[2];
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto x2 = iF[2] * iF[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto u0 = a0 * iF[0];
        const auto u1 = a1 * iF[1];
        const auto u2 = a2 * iF[2];
        Kr(0, 2) = u0 * iF[0];
        Kr(1, 2) = u1 * iF[1];
        Kr(2, 2) = u2 * iF[2];
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DS_DEGL_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct SPATIAL_MODULI_to_DS_DEGL_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto x0 = iF[0] * iF[0];
        const auto x1 = iF[3] * iF[3];
        const auto x3 = cste * iF[0] * iF[3];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 0) = u0 * iF[0] + u3 * iF[3];
        Kr(1, 0) = u1 * iF[1] + u4 * iF[4];
        Kr(2, 0) = u2 * iF[2];
        Kr(3, 0) = cste * (u0 * iF[4] + u3 * iF[1]);
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto x0 = iF[4] * iF[4];
        const auto x1 = iF[1] * iF[1];
        const auto x3 = cste * iF[1] * iF[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 1) = u0 * iF[0] + u3 * iF[3];
        Kr(1, 1) = u1 * iF[1] + u4 * iF[4];
        Kr(2, 1) = u2 * iF[2];
        Kr(3, 1) = cste * (u0 * iF[4] + u3 * iF[1]);
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto x2 = iF[2] * iF[2];
        const auto a0 = Ks(0, 2) * x2;
        const auto a1 = Ks(1, 2) * x2;
        const auto a2 = Ks(2, 2) * x2;
        const auto a3 = icste * Ks(3, 2) * x2;
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 2) = u0 * iF[0] + u3 * iF[3];
        Kr(1, 2) = u1 * iF[1] + u4 * iF[4];
        Kr(2, 2) = u2 * iF[2];
        Kr(3, 2) = cste * (u0 * iF[4] + u3 * iF[1]);
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto x0 = cste * iF[0] * iF[4];
        const auto x1 = cste * iF[1] * iF[3];
        const auto x3 = iF[0] * iF[1] + iF[3] * iF[4];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 3) * x3;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 3) * x3;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 3) * x3;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 3) * x3);
        const auto u0 = a0 * iF[0] + a3 * iF[3];
        const auto u1 = a1 * iF[1] + a3 * iF[4];
        const auto u2 = a2 * iF[2];
        const auto u3 = a1 * iF[3] + a3 * iF[0];
        const auto u4 = a0 * iF[4] + a3 * iF[1];
        Kr(0, 3) = u0 * iF[0] + u3 * iF[3];
        Kr(1, 3) = u1 * iF[1] + u4 * iF[4];
        Kr(2, 3) = u2 * iF[2];
        Kr(3, 3) = cste * (u0 * iF[4] + u3 * iF[1]);
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DS_DEGL_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct SPATIAL_MODULI_to_DS_DEGL_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the second Piola-Kirchhoff stress with
     * respect to the Green-Lagrange strain
     * \param[in] Ks: spatial moduli
     * \param[in] F: deformation gradient at the end of the time step
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::st2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      {
        // column associated with the component (0, 0) of the Green-Lagrange
        // strain
        const auto x0 = iF[0] * iF[0];
        const auto x1 = iF[3] * iF[3];
        const auto x2 = iF[5] * iF[5];
        const auto x3 = cste * iF[0] * iF[3];
        const auto x4 = cste * iF[0] * iF[5];
        const auto x5 = cste * iF[3] * iF[5];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 0) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5];
        Kr(1, 0) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7];
        Kr(2, 0) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8];
        Kr(3, 0) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]);
        Kr(4, 0) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]);
        Kr(5, 0) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]);
      }
      {
        // column associated with the component (1, 1) of the Green-Lagrange
        // strain
        const auto x0 = iF[4] * iF[4];
        const auto x1 = iF[1] * iF[1];
        const auto x2 = iF[7] * iF[7];
        const auto x3 = cste * iF[1] * iF[4];
        const auto x4 = cste * iF[4] * iF[7];
        const auto x5 = cste * iF[1] * iF[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 1) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5];
        Kr(1, 1) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7];
        Kr(2, 1) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8];
        Kr(3, 1) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]);
        Kr(4, 1) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]);
        Kr(5, 1) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]);
      }
      {
        // column associated with the component (2, 2) of the Green-Lagrange
        // strain
        const auto x0 = iF[6] * iF[6];
        const auto x1 = iF[8] * iF[8];
        const auto x2 = iF[2] * iF[2];
        const auto x3 = cste * iF[6] * iF[8];
        const auto x4 = cste * iF[2] * iF[6];
        const auto x5 = cste * iF[2] * iF[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 2) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5];
        Kr(1, 2) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7];
        Kr(2, 2) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8];
        Kr(3, 2) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]);
        Kr(4, 2) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]);
        Kr(5, 2) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]);
      }
      {
        // column associated with the component (0, 1) of the Green-Lagrange
        // strain
        const auto x0 = cste * iF[0] * iF[4];
        const auto x1 = cste * iF[1] * iF[3];
        const auto x2 = cste * iF[5] * iF[7];
        const auto x3 = iF[0] * iF[1] + iF[3] * iF[4];
        const auto x4 = iF[0] * iF[7] + iF[4] * iF[5];
        const auto x5 = iF[1] * iF[5] + iF[3] * iF[7];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 3) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5];
        Kr(1, 3) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7];
        Kr(2, 3) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8];
        Kr(3, 3) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]);
        Kr(4, 3) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]);
        Kr(5, 3) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]);
      }
      {
        // column associated with the component (0, 2) of the Green-Lagrange
        // strain
        const auto x0 = cste * iF[0] * iF[6];
        const auto x1 = cste * iF[3] * iF[8];
        const auto x2 = cste * iF[2] * iF[5];
        const auto x3 = iF[0] * iF[8] + iF[3] * iF[6];
        const auto x4 = iF[0] * iF[2] + iF[5] * iF[6];
        const auto x5 = iF[2] * iF[3] + iF[5] * iF[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 4) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5];
        Kr(1, 4) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7];
        Kr(2, 4) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8];
        Kr(3, 4) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]);
        Kr(4, 4) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]);
        Kr(5, 4) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]);
      }
      {
        // column associated with the component (1, 2) of the Green-Lagrange
        // strain
        const auto x0 = cste * iF[4] * iF[6];
        const auto x1 = cste * iF[1] * iF[8];
        const auto x2 = cste * iF[2] * iF[7];
        const auto x3 = iF[1] * iF[6] + iF[4] * iF[8];
        const auto x4 = iF[2] * iF[4] + iF[6] * iF[7];
        const auto x5 = iF[1] * iF[2] + iF[7] * iF[8];
        const auto a0 = Ks(0, 0) * x0 + Ks(0, 1) * x1 + Ks(0, 2) * x2 +
                        Ks(0, 3) * x3 + Ks(0, 4) * x4 + Ks(0, 5) * x5;
        const auto a1 = Ks(1, 0) * x0 + Ks(1, 1) * x1 + Ks(1, 2) * x2 +
                        Ks(1, 3) * x3 + Ks(1, 4) * x4 + Ks(1, 5) * x5;
        const auto a2 = Ks(2, 0) * x0 + Ks(2, 1) * x1 + Ks(2, 2) * x2 +
                        Ks(2, 3) * x3 + Ks(2, 4) * x4 + Ks(2, 5) * x5;
        const auto a3 = icste * (Ks(3, 0) * x0 + Ks(3, 1) * x1 + Ks(3, 2) * x2 +
                                 Ks(3, 3) * x3 + Ks(3, 4) * x4 + Ks(3, 5) * x5);
        const auto a4 = icste * (Ks(4, 0) * x0 + Ks(4, 1) * x1 + Ks(4, 2) * x2 +
                                 Ks(4, 3) * x3 + Ks(4, 4) * x4 + Ks(4, 5) * x5);
        const auto a5 = icste * (Ks(5, 0) * x0 + Ks(5, 1) * x1 + Ks(5, 2) * x2 +
                                 Ks(5, 3) * x3 + Ks(5, 4) * x4 + Ks(5, 5) * x5);
        const auto u0 = a0 * iF[0] + a3 * iF[3] + a4 * iF[5];
        const auto u1 = a1 * iF[1] + a3 * iF[4] + a5 * iF[7];
        const auto u2 = a2 * iF[2] + a4 * iF[6] + a5 * iF[8];
        const auto u3 = a1 * iF[3] + a3 * iF[0] + a5 * iF[5];
        const auto u4 = a0 * iF[4] + a3 * iF[1] + a4 * iF[7];
        const auto u5 = a2 * iF[5] + a4 * iF[0] + a5 * iF[3];
        const auto u6 = a0 * iF[6] + a3 * iF[8] + a4 * iF[2];
        const auto u7 = a2 * iF[7] + a4 * iF[4] + a5 * iF[1];
        const auto u8 = a1 * iF[8] + a3 * iF[6] + a5 * iF[2];
        Kr(0, 5) = u0 * iF[0] + u3 * iF[3] + u5 * iF[5];
        Kr(1, 5) = u1 * iF[1] + u4 * iF[4] + u7 * iF[7];
        Kr(2, 5) = u2 * iF[2] + u6 * iF[6] + u8 * iF[8];
        Kr(3, 5) = cste * (u0 * iF[4] + u3 * iF[1] + u5 * iF[7]);
        Kr(4, 5) = cste * (u0 * iF[6] + u3 * iF[8] + u5 * iF[2]);
        Kr(5, 5) = cste * (u1 * iF[8] + u4 * iF[6] + u7 * iF[2]);
      }
    }
  };  // end of struct SPATIAL_MODULI_to_DS_DEGL_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the moduli associated with the Truesdell rate of the
   * Cauchy stress (C_TRUESDELL) to the derivative of the Cauchy stress with
   * respect to the deformation gradient (DSIG_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. C_TRUESDELL
   * relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-l\,\tau-\tau\,l^{T}\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct C_TRUESDELL_to_DSIG_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct C_TRUESDELL_to_DSIG_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const tfel::math::tensor<1u, stress> siF = iJ * P;
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = Ks(0, 0) * iF[0] - iF[0] * s[0] + 2 * siF[0];
      Kr(1, 0) = Ks(1, 0) * iF[0] - iF[0] * s[1];
      Kr(2, 0) = Ks(2, 0) * iF[0] - iF[0] * s[2];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = Ks(0, 1) * iF[1] - iF[1] * s[0];
      Kr(1, 1) = Ks(1, 1) * iF[1] - iF[1] * s[1] + 2 * siF[1];
      Kr(2, 1) = Ks(2, 1) * iF[1] - iF[1] * s[2];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2] - iF[2] * s[0];
      Kr(1, 2) = Ks(1, 2) * iF[2] - iF[2] * s[1];
      Kr(2, 2) = Ks(2, 2) * iF[2] - iF[2] * s[2] + 2 * siF[2];
    }
  };  // end of struct C_TRUESDELL_to_DSIG_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct C_TRUESDELL_to_DSIG_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const tfel::math::tensor<2u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 - iF[0] * s[0] + 2 * siF[0];
        Kr(1, 0) = Ks(1, 0) * iF[0] + Ks(1, 3) * x3 - iF[0] * s[1];
        Kr(2, 0) = Ks(2, 0) * iF[0] + Ks(2, 3) * x3 - iF[0] * s[2];
        Kr(3, 0) =
            Ks(3, 0) * iF[0] + Ks(3, 3) * x3 - iF[0] * s[3] + cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        Kr(0, 1) = Ks(0, 1) * iF[1] + Ks(0, 3) * x3 - iF[1] * s[0];
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 - iF[1] * s[1] + 2 * siF[1];
        Kr(2, 1) = Ks(2, 1) * iF[1] + Ks(2, 3) * x3 - iF[1] * s[2];
        Kr(3, 1) =
            Ks(3, 1) * iF[1] + Ks(3, 3) * x3 - iF[1] * s[3] + cste * siF[3];
      }
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2] - iF[2] * s[0];
      Kr(1, 2) = Ks(1, 2) * iF[2] - iF[2] * s[1];
      Kr(2, 2) = Ks(2, 2) * iF[2] - iF[2] * s[2] + 2 * siF[2];
      Kr(3, 2) = Ks(3, 2) * iF[2] - iF[2] * s[3];
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 - iF[4] * s[0] + 2 * siF[3];
        Kr(1, 3) = Ks(1, 0) * iF[4] + Ks(1, 3) * x3 - iF[4] * s[1];
        Kr(2, 3) = Ks(2, 0) * iF[4] + Ks(2, 3) * x3 - iF[4] * s[2];
        Kr(3, 3) =
            Ks(3, 0) * iF[4] + Ks(3, 3) * x3 - iF[4] * s[3] + cste * siF[1];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        Kr(0, 4) = Ks(0, 1) * iF[3] + Ks(0, 3) * x3 - iF[3] * s[0];
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 - iF[3] * s[1] + 2 * siF[4];
        Kr(2, 4) = Ks(2, 1) * iF[3] + Ks(2, 3) * x3 - iF[3] * s[2];
        Kr(3, 4) =
            Ks(3, 1) * iF[3] + Ks(3, 3) * x3 - iF[3] * s[3] + cste * siF[0];
      }
    }
  };  // end of struct C_TRUESDELL_to_DSIG_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct C_TRUESDELL_to_DSIG_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Truesdell rate of the Cauchy
     * stress
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto cste = tfel::math::Cste<real>::sqrt2;
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const tfel::math::tensor<3u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto x4 = icste * iF[5];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4 -
                   iF[0] * s[0] + 2 * siF[0];
        Kr(1, 0) =
            Ks(1, 0) * iF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4 - iF[0] * s[1];
        Kr(2, 0) =
            Ks(2, 0) * iF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4 - iF[0] * s[2];
        Kr(3, 0) = Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4 -
                   iF[0] * s[3] + cste * siF[4];
        Kr(4, 0) = Ks(4, 0) * iF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4 -
                   iF[0] * s[4] + cste * siF[6];
        Kr(5, 0) =
            Ks(5, 0) * iF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4 - iF[0] * s[5];
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto x5 = icste * iF[7];
        Kr(0, 1) =
            Ks(0, 1) * iF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5 - iF[1] * s[0];
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5 -
                   iF[1] * s[1] + 2 * siF[1];
        Kr(2, 1) =
            Ks(2, 1) * iF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5 - iF[1] * s[2];
        Kr(3, 1) = Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5 -
                   iF[1] * s[3] + cste * siF[3];
        Kr(4, 1) =
            Ks(4, 1) * iF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5 - iF[1] * s[4];
        Kr(5, 1) = Ks(5, 1) * iF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5 -
                   iF[1] * s[5] + cste * siF[8];
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * iF[6];
        const auto x5 = icste * iF[8];
        Kr(0, 2) =
            Ks(0, 2) * iF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5 - iF[2] * s[0];
        Kr(1, 2) =
            Ks(1, 2) * iF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5 - iF[2] * s[1];
        Kr(2, 2) = Ks(2, 2) * iF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5 -
                   iF[2] * s[2] + 2 * siF[2];
        Kr(3, 2) =
            Ks(3, 2) * iF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5 - iF[2] * s[3];
        Kr(4, 2) = Ks(4, 2) * iF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5 -
                   iF[2] * s[4] + cste * siF[5];
        Kr(5, 2) = Ks(5, 2) * iF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5 -
                   iF[2] * s[5] + cste * siF[7];
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto x4 = icste * iF[7];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4 -
                   iF[4] * s[0] + 2 * siF[3];
        Kr(1, 3) =
            Ks(1, 0) * iF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4 - iF[4] * s[1];
        Kr(2, 3) =
            Ks(2, 0) * iF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4 - iF[4] * s[2];
        Kr(3, 3) = Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4 -
                   iF[4] * s[3] + cste * siF[1];
        Kr(4, 3) = Ks(4, 0) * iF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4 -
                   iF[4] * s[4] + cste * siF[8];
        Kr(5, 3) =
            Ks(5, 0) * iF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4 - iF[4] * s[5];
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto x5 = icste * iF[5];
        Kr(0, 4) =
            Ks(0, 1) * iF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5 - iF[3] * s[0];
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5 -
                   iF[3] * s[1] + 2 * siF[4];
        Kr(2, 4) =
            Ks(2, 1) * iF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5 - iF[3] * s[2];
        Kr(3, 4) = Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5 -
                   iF[3] * s[3] + cste * siF[0];
        Kr(4, 4) =
            Ks(4, 1) * iF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5 - iF[3] * s[4];
        Kr(5, 4) = Ks(5, 1) * iF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5 -
                   iF[3] * s[5] + cste * siF[6];
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[8];
        const auto x4 = icste * iF[2];
        Kr(0, 5) = Ks(0, 0) * iF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4 -
                   iF[6] * s[0] + 2 * siF[5];
        Kr(1, 5) =
            Ks(1, 0) * iF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4 - iF[6] * s[1];
        Kr(2, 5) =
            Ks(2, 0) * iF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4 - iF[6] * s[2];
        Kr(3, 5) = Ks(3, 0) * iF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4 -
                   iF[6] * s[3] + cste * siF[7];
        Kr(4, 5) = Ks(4, 0) * iF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4 -
                   iF[6] * s[4] + cste * siF[2];
        Kr(5, 5) =
            Ks(5, 0) * iF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4 - iF[6] * s[5];
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x4 = icste * iF[0];
        const auto x5 = icste * iF[3];
        Kr(0, 6) =
            Ks(0, 2) * iF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5 - iF[5] * s[0];
        Kr(1, 6) =
            Ks(1, 2) * iF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5 - iF[5] * s[1];
        Kr(2, 6) = Ks(2, 2) * iF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5 -
                   iF[5] * s[2] + 2 * siF[6];
        Kr(3, 6) =
            Ks(3, 2) * iF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5 - iF[5] * s[3];
        Kr(4, 6) = Ks(4, 2) * iF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5 -
                   iF[5] * s[4] + cste * siF[0];
        Kr(5, 6) = Ks(5, 2) * iF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5 -
                   iF[5] * s[5] + cste * siF[4];
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[6];
        const auto x5 = icste * iF[2];
        Kr(0, 7) =
            Ks(0, 1) * iF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5 - iF[8] * s[0];
        Kr(1, 7) = Ks(1, 1) * iF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5 -
                   iF[8] * s[1] + 2 * siF[7];
        Kr(2, 7) =
            Ks(2, 1) * iF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5 - iF[8] * s[2];
        Kr(3, 7) = Ks(3, 1) * iF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5 -
                   iF[8] * s[3] + cste * siF[5];
        Kr(4, 7) =
            Ks(4, 1) * iF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5 - iF[8] * s[4];
        Kr(5, 7) = Ks(5, 1) * iF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5 -
                   iF[8] * s[5] + cste * siF[2];
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x4 = icste * iF[4];
        const auto x5 = icste * iF[1];
        Kr(0, 8) =
            Ks(0, 2) * iF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5 - iF[7] * s[0];
        Kr(1, 8) =
            Ks(1, 2) * iF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5 - iF[7] * s[1];
        Kr(2, 8) = Ks(2, 2) * iF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5 -
                   iF[7] * s[2] + 2 * siF[8];
        Kr(3, 8) =
            Ks(3, 2) * iF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5 - iF[7] * s[3];
        Kr(4, 8) = Ks(4, 2) * iF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5 -
                   iF[7] * s[4] + cste * siF[3];
        Kr(5, 8) = Ks(5, 2) * iF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5 -
                   iF[7] * s[5] + cste * siF[1];
      }
    }
  };  // end of struct C_TRUESDELL_to_DSIG_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the moduli associated with the Jaumann rate of the
   * Kirchhoff stress (C_TAU_JAUMANN) to the derivative of the Kirchhoff stress
   * with respect to the deformation gradient (DTAU_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. C_TAU_JAUMANN
   * relates
   * \f[
   * \delta\,\tau-w\,\tau+\tau\,w
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct C_TAU_JAUMANN_to_DTAU_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct C_TAU_JAUMANN_to_DTAU_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const tfel::math::stensor<1u, stress> tau = J * s;
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = Ks(0, 0) * iF[0] + P[0] - iF[0] * tau[0];
      Kr(1, 0) = Ks(1, 0) * iF[0];
      Kr(2, 0) = Ks(2, 0) * iF[0];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = Ks(0, 1) * iF[1];
      Kr(1, 1) = Ks(1, 1) * iF[1] + P[1] - iF[1] * tau[1];
      Kr(2, 1) = Ks(2, 1) * iF[1];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2];
      Kr(1, 2) = Ks(1, 2) * iF[2];
      Kr(2, 2) = Ks(2, 2) * iF[2] + P[2] - iF[2] * tau[2];
    }
  };  // end of struct C_TAU_JAUMANN_to_DTAU_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct C_TAU_JAUMANN_to_DTAU_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const tfel::math::stensor<2u, stress> tau = J * s;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + P[0] - iF[0] * tau[0];
        Kr(1, 0) = Ks(1, 0) * iF[0] + Ks(1, 3) * x3 - icste * iF[3] * tau[3];
        Kr(2, 0) = Ks(2, 0) * iF[0] + Ks(2, 3) * x3;
        Kr(3, 0) = Ks(3, 0) * iF[0] + Ks(3, 3) * x3 +
                   icste * (P[4] - iF[3] * tau[0]) - iF[0] * tau[3] / 2;
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        Kr(0, 1) = Ks(0, 1) * iF[1] + Ks(0, 3) * x3 - icste * iF[4] * tau[3];
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + P[1] - iF[1] * tau[1];
        Kr(2, 1) = Ks(2, 1) * iF[1] + Ks(2, 3) * x3;
        Kr(3, 1) = Ks(3, 1) * iF[1] + Ks(3, 3) * x3 +
                   icste * (P[3] - iF[4] * tau[1]) - iF[1] * tau[3] / 2;
      }
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2];
      Kr(1, 2) = Ks(1, 2) * iF[2];
      Kr(2, 2) = Ks(2, 2) * iF[2] + P[2] - iF[2] * tau[2];
      Kr(3, 2) = Ks(3, 2) * iF[2];
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + P[3] - iF[4] * tau[0];
        Kr(1, 3) = Ks(1, 0) * iF[4] + Ks(1, 3) * x3 - icste * iF[1] * tau[3];
        Kr(2, 3) = Ks(2, 0) * iF[4] + Ks(2, 3) * x3;
        Kr(3, 3) = Ks(3, 0) * iF[4] + Ks(3, 3) * x3 +
                   icste * (P[1] - iF[1] * tau[0]) - iF[4] * tau[3] / 2;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        Kr(0, 4) = Ks(0, 1) * iF[3] + Ks(0, 3) * x3 - icste * iF[0] * tau[3];
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + P[4] - iF[3] * tau[1];
        Kr(2, 4) = Ks(2, 1) * iF[3] + Ks(2, 3) * x3;
        Kr(3, 4) = Ks(3, 1) * iF[3] + Ks(3, 3) * x3 +
                   icste * (P[0] - iF[0] * tau[1]) - iF[3] * tau[3] / 2;
      }
    }
  };  // end of struct C_TAU_JAUMANN_to_DTAU_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct C_TAU_JAUMANN_to_DTAU_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const tfel::math::stensor<3u, stress> tau = J * s;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto x4 = icste * iF[5];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + P[0] -
                   iF[0] * tau[0];
        Kr(1, 0) = Ks(1, 0) * iF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4 -
                   icste * iF[3] * tau[3];
        Kr(2, 0) = Ks(2, 0) * iF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4 -
                   icste * iF[5] * tau[4];
        Kr(3, 0) = Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4 +
                   icste * (P[4] - iF[3] * tau[0]) - iF[0] * tau[3] / 2;
        Kr(4, 0) = Ks(4, 0) * iF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4 +
                   icste * (P[6] - iF[5] * tau[0]) - iF[0] * tau[4] / 2;
        Kr(5, 0) = Ks(5, 0) * iF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4 -
                   (iF[3] * tau[4] + iF[5] * tau[3]) / 2;
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto x5 = icste * iF[7];
        Kr(0, 1) = Ks(0, 1) * iF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5 -
                   icste * iF[4] * tau[3];
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + P[1] -
                   iF[1] * tau[1];
        Kr(2, 1) = Ks(2, 1) * iF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5 -
                   icste * iF[7] * tau[5];
        Kr(3, 1) = Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5 +
                   icste * (P[3] - iF[4] * tau[1]) - iF[1] * tau[3] / 2;
        Kr(4, 1) = Ks(4, 1) * iF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5 -
                   (iF[4] * tau[5] + iF[7] * tau[3]) / 2;
        Kr(5, 1) = Ks(5, 1) * iF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5 +
                   icste * (P[8] - iF[7] * tau[1]) - iF[1] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * iF[6];
        const auto x5 = icste * iF[8];
        Kr(0, 2) = Ks(0, 2) * iF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5 -
                   icste * iF[6] * tau[4];
        Kr(1, 2) = Ks(1, 2) * iF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5 -
                   icste * iF[8] * tau[5];
        Kr(2, 2) = Ks(2, 2) * iF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + P[2] -
                   iF[2] * tau[2];
        Kr(3, 2) = Ks(3, 2) * iF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5 -
                   (iF[6] * tau[5] + iF[8] * tau[4]) / 2;
        Kr(4, 2) = Ks(4, 2) * iF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                   icste * (P[5] - iF[6] * tau[2]) - iF[2] * tau[4] / 2;
        Kr(5, 2) = Ks(5, 2) * iF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                   icste * (P[7] - iF[8] * tau[2]) - iF[2] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto x4 = icste * iF[7];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + P[3] -
                   iF[4] * tau[0];
        Kr(1, 3) = Ks(1, 0) * iF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4 -
                   icste * iF[1] * tau[3];
        Kr(2, 3) = Ks(2, 0) * iF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4 -
                   icste * iF[7] * tau[4];
        Kr(3, 3) = Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4 +
                   icste * (P[1] - iF[1] * tau[0]) - iF[4] * tau[3] / 2;
        Kr(4, 3) = Ks(4, 0) * iF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4 +
                   icste * (P[8] - iF[7] * tau[0]) - iF[4] * tau[4] / 2;
        Kr(5, 3) = Ks(5, 0) * iF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4 -
                   (iF[1] * tau[4] + iF[7] * tau[3]) / 2;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto x5 = icste * iF[5];
        Kr(0, 4) = Ks(0, 1) * iF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5 -
                   icste * iF[0] * tau[3];
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + P[4] -
                   iF[3] * tau[1];
        Kr(2, 4) = Ks(2, 1) * iF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5 -
                   icste * iF[5] * tau[5];
        Kr(3, 4) = Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5 +
                   icste * (P[0] - iF[0] * tau[1]) - iF[3] * tau[3] / 2;
        Kr(4, 4) = Ks(4, 1) * iF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5 -
                   (iF[0] * tau[5] + iF[5] * tau[3]) / 2;
        Kr(5, 4) = Ks(5, 1) * iF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5 +
                   icste * (P[6] - iF[5] * tau[1]) - iF[3] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[8];
        const auto x4 = icste * iF[2];
        Kr(0, 5) = Ks(0, 0) * iF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + P[5] -
                   iF[6] * tau[0];
        Kr(1, 5) = Ks(1, 0) * iF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4 -
                   icste * iF[8] * tau[3];
        Kr(2, 5) = Ks(2, 0) * iF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4 -
                   icste * iF[2] * tau[4];
        Kr(3, 5) = Ks(3, 0) * iF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4 +
                   icste * (P[7] - iF[8] * tau[0]) - iF[6] * tau[3] / 2;
        Kr(4, 5) = Ks(4, 0) * iF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4 +
                   icste * (P[2] - iF[2] * tau[0]) - iF[6] * tau[4] / 2;
        Kr(5, 5) = Ks(5, 0) * iF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4 -
                   (iF[2] * tau[3] + iF[8] * tau[4]) / 2;
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x4 = icste * iF[0];
        const auto x5 = icste * iF[3];
        Kr(0, 6) = Ks(0, 2) * iF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5 -
                   icste * iF[0] * tau[4];
        Kr(1, 6) = Ks(1, 2) * iF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5 -
                   icste * iF[3] * tau[5];
        Kr(2, 6) = Ks(2, 2) * iF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + P[6] -
                   iF[5] * tau[2];
        Kr(3, 6) = Ks(3, 2) * iF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5 -
                   (iF[0] * tau[5] + iF[3] * tau[4]) / 2;
        Kr(4, 6) = Ks(4, 2) * iF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                   icste * (P[0] - iF[0] * tau[2]) - iF[5] * tau[4] / 2;
        Kr(5, 6) = Ks(5, 2) * iF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                   icste * (P[4] - iF[3] * tau[2]) - iF[5] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[6];
        const auto x5 = icste * iF[2];
        Kr(0, 7) = Ks(0, 1) * iF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5 -
                   icste * iF[6] * tau[3];
        Kr(1, 7) = Ks(1, 1) * iF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + P[7] -
                   iF[8] * tau[1];
        Kr(2, 7) = Ks(2, 1) * iF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5 -
                   icste * iF[2] * tau[5];
        Kr(3, 7) = Ks(3, 1) * iF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5 +
                   icste * (P[5] - iF[6] * tau[1]) - iF[8] * tau[3] / 2;
        Kr(4, 7) = Ks(4, 1) * iF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5 -
                   (iF[2] * tau[3] + iF[6] * tau[5]) / 2;
        Kr(5, 7) = Ks(5, 1) * iF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5 +
                   icste * (P[2] - iF[2] * tau[1]) - iF[8] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x4 = icste * iF[4];
        const auto x5 = icste * iF[1];
        Kr(0, 8) = Ks(0, 2) * iF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5 -
                   icste * iF[4] * tau[4];
        Kr(1, 8) = Ks(1, 2) * iF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5 -
                   icste * iF[1] * tau[5];
        Kr(2, 8) = Ks(2, 2) * iF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + P[8] -
                   iF[7] * tau[2];
        Kr(3, 8) = Ks(3, 2) * iF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5 -
                   (iF[1] * tau[4] + iF[4] * tau[5]) / 2;
        Kr(4, 8) = Ks(4, 2) * iF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5 +
                   icste * (P[3] - iF[4] * tau[2]) - iF[7] * tau[4] / 2;
        Kr(5, 8) = Ks(5, 2) * iF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5 +
                   icste * (P[1] - iF[1] * tau[2]) - iF[7] * tau[5] / 2;
      }
    }
  };  // end of struct C_TAU_JAUMANN_to_DTAU_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the moduli associated with the Jaumann rate of the
   * Kirchhoff stress divided by the change of volume (ABAQUS) to the derivative
   * of the Kirchhoff stress with respect to the deformation gradient (DTAU_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. ABAQUS relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-w\,\tau+\tau\,w\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DTAU_DF relates
   * \f[
   * \delta\,\tau
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct ABAQUS_to_DTAU_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct ABAQUS_to_DTAU_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::stensor<1u, stress> tau = J * s;
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = J * Ks(0, 0) * iF[0] + P[0] - iF[0] * tau[0];
      Kr(1, 0) = J * Ks(1, 0) * iF[0];
      Kr(2, 0) = J * Ks(2, 0) * iF[0];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = J * Ks(0, 1) * iF[1];
      Kr(1, 1) = J * Ks(1, 1) * iF[1] + P[1] - iF[1] * tau[1];
      Kr(2, 1) = J * Ks(2, 1) * iF[1];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = J * Ks(0, 2) * iF[2];
      Kr(1, 2) = J * Ks(1, 2) * iF[2];
      Kr(2, 2) = J * Ks(2, 2) * iF[2] + P[2] - iF[2] * tau[2];
    }
  };  // end of struct ABAQUS_to_DTAU_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct ABAQUS_to_DTAU_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::stensor<2u, stress> tau = J * s;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        Kr(0, 0) =
            J * (Ks(0, 0) * iF[0] + Ks(0, 3) * x3) + P[0] - iF[0] * tau[0];
        Kr(1, 0) =
            J * (Ks(1, 0) * iF[0] + Ks(1, 3) * x3) - icste * iF[3] * tau[3];
        Kr(2, 0) = J * (Ks(2, 0) * iF[0] + Ks(2, 3) * x3);
        Kr(3, 0) = J * (Ks(3, 0) * iF[0] + Ks(3, 3) * x3) +
                   icste * (P[4] - iF[3] * tau[0]) - iF[0] * tau[3] / 2;
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        Kr(0, 1) =
            J * (Ks(0, 1) * iF[1] + Ks(0, 3) * x3) - icste * iF[4] * tau[3];
        Kr(1, 1) =
            J * (Ks(1, 1) * iF[1] + Ks(1, 3) * x3) + P[1] - iF[1] * tau[1];
        Kr(2, 1) = J * (Ks(2, 1) * iF[1] + Ks(2, 3) * x3);
        Kr(3, 1) = J * (Ks(3, 1) * iF[1] + Ks(3, 3) * x3) +
                   icste * (P[3] - iF[4] * tau[1]) - iF[1] * tau[3] / 2;
      }
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = J * Ks(0, 2) * iF[2];
      Kr(1, 2) = J * Ks(1, 2) * iF[2];
      Kr(2, 2) = J * Ks(2, 2) * iF[2] + P[2] - iF[2] * tau[2];
      Kr(3, 2) = J * Ks(3, 2) * iF[2];
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        Kr(0, 3) =
            J * (Ks(0, 0) * iF[4] + Ks(0, 3) * x3) + P[3] - iF[4] * tau[0];
        Kr(1, 3) =
            J * (Ks(1, 0) * iF[4] + Ks(1, 3) * x3) - icste * iF[1] * tau[3];
        Kr(2, 3) = J * (Ks(2, 0) * iF[4] + Ks(2, 3) * x3);
        Kr(3, 3) = J * (Ks(3, 0) * iF[4] + Ks(3, 3) * x3) +
                   icste * (P[1] - iF[1] * tau[0]) - iF[4] * tau[3] / 2;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        Kr(0, 4) =
            J * (Ks(0, 1) * iF[3] + Ks(0, 3) * x3) - icste * iF[0] * tau[3];
        Kr(1, 4) =
            J * (Ks(1, 1) * iF[3] + Ks(1, 3) * x3) + P[4] - iF[3] * tau[1];
        Kr(2, 4) = J * (Ks(2, 1) * iF[3] + Ks(2, 3) * x3);
        Kr(3, 4) = J * (Ks(3, 1) * iF[3] + Ks(3, 3) * x3) +
                   icste * (P[0] - iF[0] * tau[1]) - iF[3] * tau[3] / 2;
      }
    }
  };  // end of struct ABAQUS_to_DTAU_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct ABAQUS_to_DTAU_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Kirchhoff stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto J = tfel::math::det(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const tfel::math::stensor<3u, stress> tau = J * s;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto x4 = icste * iF[5];
        Kr(0, 0) = J * (Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4) +
                   P[0] - iF[0] * tau[0];
        Kr(1, 0) = J * (Ks(1, 0) * iF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4) -
                   icste * iF[3] * tau[3];
        Kr(2, 0) = J * (Ks(2, 0) * iF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4) -
                   icste * iF[5] * tau[4];
        Kr(3, 0) = J * (Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4) +
                   icste * (P[4] - iF[3] * tau[0]) - iF[0] * tau[3] / 2;
        Kr(4, 0) = J * (Ks(4, 0) * iF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4) +
                   icste * (P[6] - iF[5] * tau[0]) - iF[0] * tau[4] / 2;
        Kr(5, 0) = J * (Ks(5, 0) * iF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4) -
                   (iF[3] * tau[4] + iF[5] * tau[3]) / 2;
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto x5 = icste * iF[7];
        Kr(0, 1) = J * (Ks(0, 1) * iF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5) -
                   icste * iF[4] * tau[3];
        Kr(1, 1) = J * (Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5) +
                   P[1] - iF[1] * tau[1];
        Kr(2, 1) = J * (Ks(2, 1) * iF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5) -
                   icste * iF[7] * tau[5];
        Kr(3, 1) = J * (Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5) +
                   icste * (P[3] - iF[4] * tau[1]) - iF[1] * tau[3] / 2;
        Kr(4, 1) = J * (Ks(4, 1) * iF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5) -
                   (iF[4] * tau[5] + iF[7] * tau[3]) / 2;
        Kr(5, 1) = J * (Ks(5, 1) * iF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5) +
                   icste * (P[8] - iF[7] * tau[1]) - iF[1] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * iF[6];
        const auto x5 = icste * iF[8];
        Kr(0, 2) = J * (Ks(0, 2) * iF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5) -
                   icste * iF[6] * tau[4];
        Kr(1, 2) = J * (Ks(1, 2) * iF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5) -
                   icste * iF[8] * tau[5];
        Kr(2, 2) = J * (Ks(2, 2) * iF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5) +
                   P[2] - iF[2] * tau[2];
        Kr(3, 2) = J * (Ks(3, 2) * iF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5) -
                   (iF[6] * tau[5] + iF[8] * tau[4]) / 2;
        Kr(4, 2) = J * (Ks(4, 2) * iF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5) +
                   icste * (P[5] - iF[6] * tau[2]) - iF[2] * tau[4] / 2;
        Kr(5, 2) = J * (Ks(5, 2) * iF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5) +
                   icste * (P[7] - iF[8] * tau[2]) - iF[2] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto x4 = icste * iF[7];
        Kr(0, 3) = J * (Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4) +
                   P[3] - iF[4] * tau[0];
        Kr(1, 3) = J * (Ks(1, 0) * iF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4) -
                   icste * iF[1] * tau[3];
        Kr(2, 3) = J * (Ks(2, 0) * iF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4) -
                   icste * iF[7] * tau[4];
        Kr(3, 3) = J * (Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4) +
                   icste * (P[1] - iF[1] * tau[0]) - iF[4] * tau[3] / 2;
        Kr(4, 3) = J * (Ks(4, 0) * iF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4) +
                   icste * (P[8] - iF[7] * tau[0]) - iF[4] * tau[4] / 2;
        Kr(5, 3) = J * (Ks(5, 0) * iF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4) -
                   (iF[1] * tau[4] + iF[7] * tau[3]) / 2;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto x5 = icste * iF[5];
        Kr(0, 4) = J * (Ks(0, 1) * iF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5) -
                   icste * iF[0] * tau[3];
        Kr(1, 4) = J * (Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5) +
                   P[4] - iF[3] * tau[1];
        Kr(2, 4) = J * (Ks(2, 1) * iF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5) -
                   icste * iF[5] * tau[5];
        Kr(3, 4) = J * (Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5) +
                   icste * (P[0] - iF[0] * tau[1]) - iF[3] * tau[3] / 2;
        Kr(4, 4) = J * (Ks(4, 1) * iF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5) -
                   (iF[0] * tau[5] + iF[5] * tau[3]) / 2;
        Kr(5, 4) = J * (Ks(5, 1) * iF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5) +
                   icste * (P[6] - iF[5] * tau[1]) - iF[3] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[8];
        const auto x4 = icste * iF[2];
        Kr(0, 5) = J * (Ks(0, 0) * iF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4) +
                   P[5] - iF[6] * tau[0];
        Kr(1, 5) = J * (Ks(1, 0) * iF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4) -
                   icste * iF[8] * tau[3];
        Kr(2, 5) = J * (Ks(2, 0) * iF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4) -
                   icste * iF[2] * tau[4];
        Kr(3, 5) = J * (Ks(3, 0) * iF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4) +
                   icste * (P[7] - iF[8] * tau[0]) - iF[6] * tau[3] / 2;
        Kr(4, 5) = J * (Ks(4, 0) * iF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4) +
                   icste * (P[2] - iF[2] * tau[0]) - iF[6] * tau[4] / 2;
        Kr(5, 5) = J * (Ks(5, 0) * iF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4) -
                   (iF[2] * tau[3] + iF[8] * tau[4]) / 2;
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x4 = icste * iF[0];
        const auto x5 = icste * iF[3];
        Kr(0, 6) = J * (Ks(0, 2) * iF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5) -
                   icste * iF[0] * tau[4];
        Kr(1, 6) = J * (Ks(1, 2) * iF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5) -
                   icste * iF[3] * tau[5];
        Kr(2, 6) = J * (Ks(2, 2) * iF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5) +
                   P[6] - iF[5] * tau[2];
        Kr(3, 6) = J * (Ks(3, 2) * iF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5) -
                   (iF[0] * tau[5] + iF[3] * tau[4]) / 2;
        Kr(4, 6) = J * (Ks(4, 2) * iF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5) +
                   icste * (P[0] - iF[0] * tau[2]) - iF[5] * tau[4] / 2;
        Kr(5, 6) = J * (Ks(5, 2) * iF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5) +
                   icste * (P[4] - iF[3] * tau[2]) - iF[5] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[6];
        const auto x5 = icste * iF[2];
        Kr(0, 7) = J * (Ks(0, 1) * iF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5) -
                   icste * iF[6] * tau[3];
        Kr(1, 7) = J * (Ks(1, 1) * iF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5) +
                   P[7] - iF[8] * tau[1];
        Kr(2, 7) = J * (Ks(2, 1) * iF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5) -
                   icste * iF[2] * tau[5];
        Kr(3, 7) = J * (Ks(3, 1) * iF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5) +
                   icste * (P[5] - iF[6] * tau[1]) - iF[8] * tau[3] / 2;
        Kr(4, 7) = J * (Ks(4, 1) * iF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5) -
                   (iF[2] * tau[3] + iF[6] * tau[5]) / 2;
        Kr(5, 7) = J * (Ks(5, 1) * iF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5) +
                   icste * (P[2] - iF[2] * tau[1]) - iF[8] * tau[5] / 2;
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x4 = icste * iF[4];
        const auto x5 = icste * iF[1];
        Kr(0, 8) = J * (Ks(0, 2) * iF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5) -
                   icste * iF[4] * tau[4];
        Kr(1, 8) = J * (Ks(1, 2) * iF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5) -
                   icste * iF[1] * tau[5];
        Kr(2, 8) = J * (Ks(2, 2) * iF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5) +
                   P[8] - iF[7] * tau[2];
        Kr(3, 8) = J * (Ks(3, 2) * iF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5) -
                   (iF[1] * tau[4] + iF[4] * tau[5]) / 2;
        Kr(4, 8) = J * (Ks(4, 2) * iF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5) +
                   icste * (P[3] - iF[4] * tau[2]) - iF[7] * tau[4] / 2;
        Kr(5, 8) = J * (Ks(5, 2) * iF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5) +
                   icste * (P[1] - iF[1] * tau[2]) - iF[7] * tau[5] / 2;
      }
    }
  };  // end of struct ABAQUS_to_DTAU_DF_Converter<3u>

  /*!
   * \brief an helper structure meant to be specialized in each spatial
   * dimension, converting the moduli associated with the Jaumann rate of the
   * Kirchhoff stress divided by the change of volume (ABAQUS) to the derivative
   * of the Cauchy stress with respect to the deformation gradient (DSIG_DF).
   * The result is computed column by column, i.e. component by component of the
   * deformation gradient. Let \f$\delta\,F\f$ be the variation of the
   * deformation gradient associated with this component,
   * \f$l=\delta\,F\,F^{-1}\f$, \f$w\f$ the skew part of \f$l\f$ and
   * \f$\delta\,\tau\f$ the variation of the Kirchhoff stress. ABAQUS relates
   * \f[
   * \frac{1}{J}\,\left(\delta\,\tau-w\,\tau+\tau\,w\right)
   * \quad\mathrm{to}\quad
   * d=\mathrm{sym}\left(l\right)
   * \f]
   * and DSIG_DF relates
   * \f[
   * \delta\,\sigma=\frac{1}{J}\,\delta\,\tau-\mathrm{tr}\left(l\right)\,\sigma
   * \quad\mathrm{to}\quad
   * \delta\,F
   * \f]
   * so that no intermediate tangent operator is stored.
   * \tparam N: spatial dimension
   */
  template <unsigned short N>
  struct ABAQUS_to_DSIG_DF_Converter;

  /*!
   * \brief partial specialisation in 1D
   */
  template <>
  struct ABAQUS_to_DSIG_DF_Converter<1u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<1u, stress>& Kr,
        const tfel::math::st2tost2<1u, stress>& Ks,
        const tfel::math::tensor<1u, real>& F,
        const tfel::math::stensor<1u, stress>& s) noexcept {
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const tfel::math::tensor<1u, stress> siF = iJ * P;
      // derivative with respect to the component (0, 0) of the deformation
      // gradient
      Kr(0, 0) = Ks(0, 0) * iF[0] + siF[0] - 2 * iF[0] * s[0];
      Kr(1, 0) = Ks(1, 0) * iF[0] - iF[0] * s[1];
      Kr(2, 0) = Ks(2, 0) * iF[0] - iF[0] * s[2];
      // derivative with respect to the component (1, 1) of the deformation
      // gradient
      Kr(0, 1) = Ks(0, 1) * iF[1] - iF[1] * s[0];
      Kr(1, 1) = Ks(1, 1) * iF[1] + siF[1] - 2 * iF[1] * s[1];
      Kr(2, 1) = Ks(2, 1) * iF[1] - iF[1] * s[2];
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2] - iF[2] * s[0];
      Kr(1, 2) = Ks(1, 2) * iF[2] - iF[2] * s[1];
      Kr(2, 2) = Ks(2, 2) * iF[2] + siF[2] - 2 * iF[2] * s[2];
    }
  };  // end of struct ABAQUS_to_DSIG_DF_Converter<1u>

  /*!
   * \brief partial specialisation in 2D
   */
  template <>
  struct ABAQUS_to_DSIG_DF_Converter<2u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<2u, stress>& Kr,
        const tfel::math::st2tost2<2u, stress>& Ks,
        const tfel::math::tensor<2u, real>& F,
        const tfel::math::stensor<2u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const tfel::math::tensor<2u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + siF[0] - 2 * iF[0] * s[0];
        Kr(1, 0) = Ks(1, 0) * iF[0] + Ks(1, 3) * x3 - iF[0] * s[1] -
                   icste * iF[3] * s[3];
        Kr(2, 0) = Ks(2, 0) * iF[0] + Ks(2, 3) * x3 - iF[0] * s[2];
        Kr(3, 0) = Ks(3, 0) * iF[0] + Ks(3, 3) * x3 - 3 * iF[0] * s[3] / 2 -
                   icste * (iF[3] * s[0] - siF[4]);
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        Kr(0, 1) = Ks(0, 1) * iF[1] + Ks(0, 3) * x3 - iF[1] * s[0] -
                   icste * iF[4] * s[3];
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + siF[1] - 2 * iF[1] * s[1];
        Kr(2, 1) = Ks(2, 1) * iF[1] + Ks(2, 3) * x3 - iF[1] * s[2];
        Kr(3, 1) = Ks(3, 1) * iF[1] + Ks(3, 3) * x3 - 3 * iF[1] * s[3] / 2 -
                   icste * (iF[4] * s[1] - siF[3]);
      }
      // derivative with respect to the component (2, 2) of the deformation
      // gradient
      Kr(0, 2) = Ks(0, 2) * iF[2] - iF[2] * s[0];
      Kr(1, 2) = Ks(1, 2) * iF[2] - iF[2] * s[1];
      Kr(2, 2) = Ks(2, 2) * iF[2] + siF[2] - 2 * iF[2] * s[2];
      Kr(3, 2) = Ks(3, 2) * iF[2] - iF[2] * s[3];
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + siF[3] - 2 * iF[4] * s[0];
        Kr(1, 3) = Ks(1, 0) * iF[4] + Ks(1, 3) * x3 - iF[4] * s[1] -
                   icste * iF[1] * s[3];
        Kr(2, 3) = Ks(2, 0) * iF[4] + Ks(2, 3) * x3 - iF[4] * s[2];
        Kr(3, 3) = Ks(3, 0) * iF[4] + Ks(3, 3) * x3 -
                   icste * (iF[1] * s[0] - siF[1]) - 3 * iF[4] * s[3] / 2;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        Kr(0, 4) = Ks(0, 1) * iF[3] + Ks(0, 3) * x3 - iF[3] * s[0] -
                   icste * iF[0] * s[3];
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + siF[4] - 2 * iF[3] * s[1];
        Kr(2, 4) = Ks(2, 1) * iF[3] + Ks(2, 3) * x3 - iF[3] * s[2];
        Kr(3, 4) = Ks(3, 1) * iF[3] + Ks(3, 3) * x3 -
                   icste * (iF[0] * s[1] - siF[0]) - 3 * iF[3] * s[3] / 2;
      }
    }
  };  // end of struct ABAQUS_to_DSIG_DF_Converter<2u>

  /*!
   * \brief partial specialisation in 3D
   */
  template <>
  struct ABAQUS_to_DSIG_DF_Converter<3u> {
    /*!
     * \tparam stress: stress type
     * \tparam real: numeric type
     * \param[out] Kr: derivative of the Cauchy stress with respect to the
     * deformation gradient
     * \param[in] Ks: moduli associated with the Jaumann rate of the Kirchhoff
     * stress divided by the change of volume
     * \param[in] F: deformation gradient at the end of the time step
     * \param[in] s: Cauchy stress
     */
    template <typename stress, typename real>
    TFEL_HOST_DEVICE static constexpr void exe(
        tfel::math::t2tost2<3u, stress>& Kr,
        const tfel::math::st2tost2<3u, stress>& Ks,
        const tfel::math::tensor<3u, real>& F,
        const tfel::math::stensor<3u, stress>& s) noexcept {
      constexpr auto icste = tfel::math::Cste<real>::isqrt2;
      const auto iF = tfel::math::invert(F);
      const auto P =
          tfel::math::convertCauchyStressToFirstPiolaKirchhoffStress(s, F);
      const auto J = tfel::math::det(F);
      const auto iJ = 1 / J;
      const tfel::math::tensor<3u, stress> siF = iJ * P;
      {
        // derivative with respect to the component (0, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[3];
        const auto x4 = icste * iF[5];
        Kr(0, 0) = Ks(0, 0) * iF[0] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + siF[0] -
                   2 * iF[0] * s[0];
        Kr(1, 0) = Ks(1, 0) * iF[0] + Ks(1, 3) * x3 + Ks(1, 4) * x4 -
                   iF[0] * s[1] - icste * iF[3] * s[3];
        Kr(2, 0) = Ks(2, 0) * iF[0] + Ks(2, 3) * x3 + Ks(2, 4) * x4 -
                   iF[0] * s[2] - icste * iF[5] * s[4];
        Kr(3, 0) = Ks(3, 0) * iF[0] + Ks(3, 3) * x3 + Ks(3, 4) * x4 -
                   3 * iF[0] * s[3] / 2 - icste * (iF[3] * s[0] - siF[4]);
        Kr(4, 0) = Ks(4, 0) * iF[0] + Ks(4, 3) * x3 + Ks(4, 4) * x4 -
                   3 * iF[0] * s[4] / 2 - icste * (iF[5] * s[0] - siF[6]);
        Kr(5, 0) = Ks(5, 0) * iF[0] + Ks(5, 3) * x3 + Ks(5, 4) * x4 -
                   iF[0] * s[5] - (iF[3] * s[4] + iF[5] * s[3]) / 2;
      }
      {
        // derivative with respect to the component (1, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[4];
        const auto x5 = icste * iF[7];
        Kr(0, 1) = Ks(0, 1) * iF[1] + Ks(0, 3) * x3 + Ks(0, 5) * x5 -
                   iF[1] * s[0] - icste * iF[4] * s[3];
        Kr(1, 1) = Ks(1, 1) * iF[1] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + siF[1] -
                   2 * iF[1] * s[1];
        Kr(2, 1) = Ks(2, 1) * iF[1] + Ks(2, 3) * x3 + Ks(2, 5) * x5 -
                   iF[1] * s[2] - icste * iF[7] * s[5];
        Kr(3, 1) = Ks(3, 1) * iF[1] + Ks(3, 3) * x3 + Ks(3, 5) * x5 -
                   3 * iF[1] * s[3] / 2 - icste * (iF[4] * s[1] - siF[3]);
        Kr(4, 1) = Ks(4, 1) * iF[1] + Ks(4, 3) * x3 + Ks(4, 5) * x5 -
                   iF[1] * s[4] - (iF[4] * s[5] + iF[7] * s[3]) / 2;
        Kr(5, 1) = Ks(5, 1) * iF[1] + Ks(5, 3) * x3 + Ks(5, 5) * x5 -
                   3 * iF[1] * s[5] / 2 - icste * (iF[7] * s[1] - siF[8]);
      }
      {
        // derivative with respect to the component (2, 2) of the deformation
        // gradient
        const auto x4 = icste * iF[6];
        const auto x5 = icste * iF[8];
        Kr(0, 2) = Ks(0, 2) * iF[2] + Ks(0, 4) * x4 + Ks(0, 5) * x5 -
                   iF[2] * s[0] - icste * iF[6] * s[4];
        Kr(1, 2) = Ks(1, 2) * iF[2] + Ks(1, 4) * x4 + Ks(1, 5) * x5 -
                   iF[2] * s[1] - icste * iF[8] * s[5];
        Kr(2, 2) = Ks(2, 2) * iF[2] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + siF[2] -
                   2 * iF[2] * s[2];
        Kr(3, 2) = Ks(3, 2) * iF[2] + Ks(3, 4) * x4 + Ks(3, 5) * x5 -
                   iF[2] * s[3] - (iF[6] * s[5] + iF[8] * s[4]) / 2;
        Kr(4, 2) = Ks(4, 2) * iF[2] + Ks(4, 4) * x4 + Ks(4, 5) * x5 -
                   3 * iF[2] * s[4] / 2 - icste * (iF[6] * s[2] - siF[5]);
        Kr(5, 2) = Ks(5, 2) * iF[2] + Ks(5, 4) * x4 + Ks(5, 5) * x5 -
                   3 * iF[2] * s[5] / 2 - icste * (iF[8] * s[2] - siF[7]);
      }
      {
        // derivative with respect to the component (0, 1) of the deformation
        // gradient
        const auto x3 = icste * iF[1];
        const auto x4 = icste * iF[7];
        Kr(0, 3) = Ks(0, 0) * iF[4] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + siF[3] -
                   2 * iF[4] * s[0];
        Kr(1, 3) = Ks(1, 0) * iF[4] + Ks(1, 3) * x3 + Ks(1, 4) * x4 -
                   iF[4] * s[1] - icste * iF[1] * s[3];
        Kr(2, 3) = Ks(2, 0) * iF[4] + Ks(2, 3) * x3 + Ks(2, 4) * x4 -
                   iF[4] * s[2] - icste * iF[7] * s[4];
        Kr(3, 3) = Ks(3, 0) * iF[4] + Ks(3, 3) * x3 + Ks(3, 4) * x4 -
                   icste * (iF[1] * s[0] - siF[1]) - 3 * iF[4] * s[3] / 2;
        Kr(4, 3) = Ks(4, 0) * iF[4] + Ks(4, 3) * x3 + Ks(4, 4) * x4 -
                   3 * iF[4] * s[4] / 2 - icste * (iF[7] * s[0] - siF[8]);
        Kr(5, 3) = Ks(5, 0) * iF[4] + Ks(5, 3) * x3 + Ks(5, 4) * x4 -
                   iF[4] * s[5] - (iF[1] * s[4] + iF[7] * s[3]) / 2;
      }
      {
        // derivative with respect to the component (1, 0) of the deformation
        // gradient
        const auto x3 = icste * iF[0];
        const auto x5 = icste * iF[5];
        Kr(0, 4) = Ks(0, 1) * iF[3] + Ks(0, 3) * x3 + Ks(0, 5) * x5 -
                   iF[3] * s[0] - icste * iF[0] * s[3];
        Kr(1, 4) = Ks(1, 1) * iF[3] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + siF[4] -
                   2 * iF[3] * s[1];
        Kr(2, 4) = Ks(2, 1) * iF[3] + Ks(2, 3) * x3 + Ks(2, 5) * x5 -
                   iF[3] * s[2] - icste * iF[5] * s[5];
        Kr(3, 4) = Ks(3, 1) * iF[3] + Ks(3, 3) * x3 + Ks(3, 5) * x5 -
                   icste * (iF[0] * s[1] - siF[0]) - 3 * iF[3] * s[3] / 2;
        Kr(4, 4) = Ks(4, 1) * iF[3] + Ks(4, 3) * x3 + Ks(4, 5) * x5 -
                   iF[3] * s[4] - (iF[0] * s[5] + iF[5] * s[3]) / 2;
        Kr(5, 4) = Ks(5, 1) * iF[3] + Ks(5, 3) * x3 + Ks(5, 5) * x5 -
                   3 * iF[3] * s[5] / 2 - icste * (iF[5] * s[1] - siF[6]);
      }
      {
        // derivative with respect to the component (0, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[8];
        const auto x4 = icste * iF[2];
        Kr(0, 5) = Ks(0, 0) * iF[6] + Ks(0, 3) * x3 + Ks(0, 4) * x4 + siF[5] -
                   2 * iF[6] * s[0];
        Kr(1, 5) = Ks(1, 0) * iF[6] + Ks(1, 3) * x3 + Ks(1, 4) * x4 -
                   iF[6] * s[1] - icste * iF[8] * s[3];
        Kr(2, 5) = Ks(2, 0) * iF[6] + Ks(2, 3) * x3 + Ks(2, 4) * x4 -
                   iF[6] * s[2] - icste * iF[2] * s[4];
        Kr(3, 5) = Ks(3, 0) * iF[6] + Ks(3, 3) * x3 + Ks(3, 4) * x4 -
                   3 * iF[6] * s[3] / 2 - icste * (iF[8] * s[0] - siF[7]);
        Kr(4, 5) = Ks(4, 0) * iF[6] + Ks(4, 3) * x3 + Ks(4, 4) * x4 -
                   icste * (iF[2] * s[0] - siF[2]) - 3 * iF[6] * s[4] / 2;
        Kr(5, 5) = Ks(5, 0) * iF[6] + Ks(5, 3) * x3 + Ks(5, 4) * x4 -
                   iF[6] * s[5] - (iF[2] * s[3] + iF[8] * s[4]) / 2;
      }
      {
        // derivative with respect to the component (2, 0) of the deformation
        // gradient
        const auto x4 = icste * iF[0];
        const auto x5 = icste * iF[3];
        Kr(0, 6) = Ks(0, 2) * iF[5] + Ks(0, 4) * x4 + Ks(0, 5) * x5 -
                   iF[5] * s[0] - icste * iF[0] * s[4];
        Kr(1, 6) = Ks(1, 2) * iF[5] + Ks(1, 4) * x4 + Ks(1, 5) * x5 -
                   iF[5] * s[1] - icste * iF[3] * s[5];
        Kr(2, 6) = Ks(2, 2) * iF[5] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + siF[6] -
                   2 * iF[5] * s[2];
        Kr(3, 6) = Ks(3, 2) * iF[5] + Ks(3, 4) * x4 + Ks(3, 5) * x5 -
                   iF[5] * s[3] - (iF[0] * s[5] + iF[3] * s[4]) / 2;
        Kr(4, 6) = Ks(4, 2) * iF[5] + Ks(4, 4) * x4 + Ks(4, 5) * x5 -
                   icste * (iF[0] * s[2] - siF[0]) - 3 * iF[5] * s[4] / 2;
        Kr(5, 6) = Ks(5, 2) * iF[5] + Ks(5, 4) * x4 + Ks(5, 5) * x5 -
                   icste * (iF[3] * s[2] - siF[4]) - 3 * iF[5] * s[5] / 2;
      }
      {
        // derivative with respect to the component (1, 2) of the deformation
        // gradient
        const auto x3 = icste * iF[6];
        const auto x5 = icste * iF[2];
        Kr(0, 7) = Ks(0, 1) * iF[8] + Ks(0, 3) * x3 + Ks(0, 5) * x5 -
                   iF[8] * s[0] - icste * iF[6] * s[3];
        Kr(1, 7) = Ks(1, 1) * iF[8] + Ks(1, 3) * x3 + Ks(1, 5) * x5 + siF[7] -
                   2 * iF[8] * s[1];
        Kr(2, 7) = Ks(2, 1) * iF[8] + Ks(2, 3) * x3 + Ks(2, 5) * x5 -
                   iF[8] * s[2] - icste * iF[2] * s[5];
        Kr(3, 7) = Ks(3, 1) * iF[8] + Ks(3, 3) * x3 + Ks(3, 5) * x5 -
                   icste * (iF[6] * s[1] - siF[5]) - 3 * iF[8] * s[3] / 2;
        Kr(4, 7) = Ks(4, 1) * iF[8] + Ks(4, 3) * x3 + Ks(4, 5) * x5 -
                   iF[8] * s[4] - (iF[2] * s[3] + iF[6] * s[5]) / 2;
        Kr(5, 7) = Ks(5, 1) * iF[8] + Ks(5, 3) * x3 + Ks(5, 5) * x5 -
                   icste * (iF[2] * s[1] - siF[2]) - 3 * iF[8] * s[5] / 2;
      }
      {
        // derivative with respect to the component (2, 1) of the deformation
        // gradient
        const auto x4 = icste * iF[4];
        const auto x5 = icste * iF[1];
        Kr(0, 8) = Ks(0, 2) * iF[7] + Ks(0, 4) * x4 + Ks(0, 5) * x5 -
                   iF[7] * s[0] - icste * iF[4] * s[4];
        Kr(1, 8) = Ks(1, 2) * iF[7] + Ks(1, 4) * x4 + Ks(1, 5) * x5 -
                   iF[7] * s[1] - icste * iF[1] * s[5];
        Kr(2, 8) = Ks(2, 2) * iF[7] + Ks(2, 4) * x4 + Ks(2, 5) * x5 + siF[8] -
                   2 * iF[7] * s[2];
        Kr(3, 8) = Ks(3, 2) * iF[7] + Ks(3, 4) * x4 + Ks(3, 5) * x5 -
                   iF[7] * s[3] - (iF[1] * s[4] + iF[4] * s[5]) / 2;
        Kr(4, 8) = Ks(4, 2) * iF[7] + Ks(4, 4) * x4 + Ks(4, 5) * x5 -
                   icste * (iF[4] * s[2] - siF[3]) - 3 * iF[7] * s[4] / 2;
        Kr(5, 8) = Ks(5, 2) * iF[7] + Ks(5, 4) * x4 + Ks(5, 5) * x5 -
                   icste * (iF[1] * s[2] - siF[1]) - 3 * iF[7] * s[5] / 2;
      }
    }
  };  // end of struct ABAQUS_to_DSIG_DF_Converter<3u>

}  // end of namespace tfel::material::internals

#endif /* LIB_TFEL_MATERIAL_FINITESTRAINBEHAVIOURTANGENTOPERATORCONVERTERS_IXX \
        */
