# Repositories of the libraries. The sources of TFEL, mfem-mgis,
# mfem-mgis-examples and mm-opera-hpc are tracked by this repository (copy of
# the last commit of the local repository, made by scripts/sync-tfel.sh and
# scripts/sync-repository.sh). The untracked files of these directories are
# ignored. MGIS is tracked by its patch series (patches/mgis).
/tfel/
/tfel-dev/
/mgis/
/mfem-mgis/
/mfem-mgis-examples/
/mm-opera-hpc/
# builds, installations and dependencies
/build/
/install/
/deps/*
!/deps/spack-sycl/
!/deps/spack/
!/deps/machines/
# files generated by spack in the environments
/deps/spack/*/.spack-env/
/deps/spack/*/spack.lock
/backups/
# drafts: only the reused development tools are tracked
/scratch/*
!/scratch/validate3.sh
!/scratch/dev-test.sh
!/scratch/targeted-test.sh
!/scratch/b2/
/scratch/b2/*
!/scratch/b2/mfront-dev.sh
!/scratch/b2/config-dev*.json
# Python caches
__pycache__/
# local resumption notes, not versioned
/RESUME-NOTES.md

# graphs generated by cases/benchmark_plots.py on the machine of the
# measurements: not versioned
/slides/
