# Dépôts des bibliothèques. Les sources de TFEL modifié sont suivies par ce
# dépôt (copie du dernier commit du dépôt local `tfel/`, faite par
# scripts/sync-tfel.sh) ; les fichiers non suivis de `tfel/` sont ignorés.
# MGIS est suivi par sa série de patchs (patches/mgis). mfem-mgis n'est pas
# modifié (commits de base dans README.md).
/tfel/
/tfel-dev/
/mgis/
/mfem-mgis/
# constructions, installations et dépendances
/build/
/install/
/deps/*
!/deps/spack-sycl/
!/deps/spack/
# files generated by spack in the environments
/deps/spack/*/.spack-env/
/deps/spack/*/spack.lock
/backups/
# brouillons : seuls les outils de développement réutilisés sont suivis
/scratch/*
!/scratch/validate3.sh
!/scratch/dev-test.sh
!/scratch/targeted-test.sh
!/scratch/b2/
/scratch/b2/*
!/scratch/b2/mfront-dev.sh
!/scratch/b2/config-dev*.json
# Python caches
__pycache__/
