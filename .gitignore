# Dépôts des bibliothèques. Les sources de TFEL, de mfem-mgis, de
# mfem-mgis-examples et de mm-opera-hpc sont suivies par ce dépôt (copie du
# dernier commit du dépôt local, faite par scripts/sync-tfel.sh et
# scripts/sync-repository.sh) ; les fichiers non suivis de ces dossiers sont
# ignorés. MGIS est suivi par sa série de patchs (patches/mgis).
/tfel/
/tfel-dev/
/mgis/
/mfem-mgis/
/mfem-mgis-examples/
/mm-opera-hpc/
# constructions, installations et dépendances
/build/
/install/
/deps/*
!/deps/spack-sycl/
!/deps/spack/
# files generated by spack in the environments
/deps/spack/*/.spack-env/
/deps/spack/*/spack.lock
/backups/
# brouillons : seuls les outils de développement réutilisés sont suivis
/scratch/*
!/scratch/validate3.sh
!/scratch/dev-test.sh
!/scratch/targeted-test.sh
!/scratch/b2/
/scratch/b2/*
!/scratch/b2/mfront-dev.sh
!/scratch/b2/config-dev*.json
# Python caches
__pycache__/
# notes de reprise locales, non versionnées
/NOTES-REPRISE.md
