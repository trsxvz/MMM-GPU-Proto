 /*!
  * \brief version of the functions generated by the `generic-parallel`
- * interface for material properties (arguments, strides and statuses),
- * exported by the generated libraries (`<name>_generic_parallel_api_version`
- * symbol, next to the `<name>_generic_parallel_backend` symbol giving the
- * name of the backend). It is incremented at each incompatible change of
- * those functions.
+ * interface for material properties (arguments, strides, execution options
+ * and statuses), exported by the generated libraries
+ * (`<name>_generic_parallel_api_version` symbol, next to the
+ * `<name>_generic_parallel_backend` symbol giving the name of the backend).
+ * It is incremented at each incompatible change of those functions.
  */
-#define MFRONT_GPMP_API_VERSION 1
+#define MFRONT_GPMP_API_VERSION 2
+
+#ifdef __cplusplus
+extern "C" {
+#endif /* __cplusplus */
+
+/*!
+ * \brief options of the execution of the evaluation of a material property,
+ * given by the last argument of the generated functions. A null pointer
+ * denotes the default options. The evaluation is synchronous: the function
+ * returns once the values are computed.
+ */
+typedef struct mfront_gpmp_ExecutionOptions {
+  /*!
+   * \brief queue on which the computations are submitted. Its meaning
+   * depends on the backend (`cudaStream_t` or `hipStream_t`, pointer to a
+   * `sycl::queue` or to an instance of a Kokkos execution space), as for the
+   * behaviours. A null pointer denotes the default queue, if meaningful for
+   * the backend: a queue must be given to the `sycl` backend.
+   */
+  void* queue;
+  /*!
+   * \brief if not null, the stack size of the threads of the device is
+   * never modified and a runtime error is reported if it is too small (see
+   * the `device_stack_size` option of the backends).
+   */
+  int preserve_stack_size;
+} mfront_gpmp_ExecutionOptions;
+
+#ifdef __cplusplus
+}  // end of extern "C"
+#endif /* __cplusplus */
 
 #endif /* LIB_MFRONT_GENERICPARALLELMATERIALPROPERTY_MATERIALPROPERTY_H */
