diff --git a/test-suite/behaviours/generic-parallel/compare.cxx b/test-suite/behaviours/generic-parallel/compare.cxx
new file mode 100644
index 000000000..3c15576ad
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/compare.cxx
@@ -0,0 +1,2162 @@
+/*!
+ * \file   test-suite/behaviours/generic-parallel/compare.cxx
+ * \brief  This program compares the results of a behaviour integrated over a
+ * batch of integration points with the `generic-parallel` interface to the
+ * results of the `generic` interface (one call per point).
+ *
+ * Two time steps of a random loading are computed: the second one starts from
+ * the results of the first one. The first step is computed synchronously,
+ * with the default execution policy of the backend (except for the `sycl`
+ * and `arcane` backends, which have none), and the second one
+ * asynchronously: the statistics of the batch are then given by the calling
+ * code (see the `statistics` member of `mfront_gpb_BatchData`) and analysed
+ * by the report function of the library
+ * (`<behaviour>_generic_parallel_report`) after the synchronization of the
+ * device. The execution policies are created from
+ * the identifier exported by the library
+ * (`<behaviour>_generic_parallel_execution_policy`, see
+ * `makeExecutionPolicy`). All the combinations of the
+ * following cases are tested:
+ *
+ * - type of computation: consistent tangent operator (or the type of
+ *   tangent operator given by the `--tangent-operator` option), elastic
+ *   prediction operator, no tangent operator;
+ * - storage of the fields: point by point, component by component, and
+ *   component by component with the material properties and the external
+ *   state variables given variable by variable (see `Storage`).
+ *
+ * For finite strain behaviours, the stress measure and the tangent operator
+ * are given by the `--finite-strain` option (for instance
+ * `--finite-strain=PK1,DPK1_DF`), and the deformation gradients are
+ * perturbations of the identity.
+ *
+ * The stored and dissipated energies are compared: with the
+ * `--energies=true` option, the behaviour must compute non null energies. With
+ * the
+ * `--speed-of-sound=<mass density>` option, the speed of sound is requested
+ * and compared, the mass density being uniform.
+ *
+ * The `--perturbation-of-internal-state-variables=<amplitude>` option adds a
+ * random perturbation to the initial values of the internal state variables
+ * and the `--out-of-bounds-policy=<behaviour>,<None|Warning|Strict>` option
+ * sets the out of bounds policy in both libraries: those options allow to
+ * test batches where the integration fails at some points.
+ *
+ * The `--parameters=<name>=<value>,...` option changes the values of some
+ * parameters in both libraries.
+ *
+ * The `--initial-internal-state-variables=<values>` option gives the initial
+ * values of the internal state variables of a point (null by default), as a
+ * comma separated list, a single value being used for all the internal state
+ * variables.
+ *
+ * The tested function is an integration, an initialize function, a
+ * post-processing or a rotation function, as given by its name. Initialize
+ * functions and post-processings are executed on random states.
+ *
+ * The sizes of the variables of a point are read in the symbols exported by
+ * the library generated by the `generic` interface. The material properties
+ * are given by the `--material-properties=<values>` option, the amplitude of
+ * the random perturbation of the gradients by the `--amplitude=<value>`
+ * option (`1e-3` by default), the temperature by the `--temperature=<value>`
+ * option (`293.15` by default), the values of the other external state
+ * variables by the `--external-state-variables=<values>` option (the
+ * temperature by default) and the time increment by the
+ * `--time-increment=<value>` option (`1` by default).
+ *
+ * This file can be compiled by a C++ compiler, by a CUDA compiler or by a
+ * HIP compiler. In the two last cases, the data are allocated in managed
+ * memory. The HIP runtime is used if the HIP language is enabled or if the
+ * `MFRONT_GPB_COMPARE_USE_HIP` macro is defined (required on NVIDIA GPUs).
+ * If the `MFRONT_GPB_COMPARE_USE_KOKKOS` macro is defined, Kokkos is
+ * initialized and the data are allocated in its shared memory space (if any).
+ * If the `MFRONT_GPB_COMPARE_USE_SYCL` macro is defined, the data are
+ * allocated in shared USM memory (or in host memory if the
+ * `MFRONT_GPB_COMPARE_USE_HOST_MEMORY` macro is defined) and the
+ * computations are performed on the device selected by the default SYCL
+ * selector. With the `raja` configuration, the `MFRONT_GPB_COMPARE_USE_RAJA`
+ * macro gives the execution policies of RAJA: this file is compiled by
+ * `nvcc` if RAJA is built with CUDA (data in managed memory, default
+ * policy, i.e. the default stream of the current device), by the C++
+ * compiler otherwise. With the `arcane` configuration, the
+ * `MFRONT_GPB_COMPARE_USE_ARCANE` macro initializes the accelerator runtime
+ * of Arccore: the computations are launched on a queue whose execution
+ * policy (`cuda`, `thread` or `sequential`) is given by the
+ * `MFRONT_GPB_COMPARE_ARCANE_QUEUE` environment variable. The preserved
+ * stack size is only checked for the libraries computing on the device.
+ *
+ * \date   05/10/2026
+ */
+
+#include <dlfcn.h>
+#include <array>
+#include <cmath>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <random>
+#include <string>
+#include <string_view>
+#include <vector>
+#include <utility>
+#include <type_traits>
+#include <algorithm>
+#include "runtime.hxx"
+#include "MFront/GenericBehaviour/BehaviourData.h"
+#include "MFront/GenericParallelBehaviour/BatchData.h"
+
+using GenericFunction = int (*)(mfront_gb_BehaviourData*);
+using BatchFunction = int (*)(mfront_gpb_OutputStatus*,
+                              const mfront_gpb_BatchData*);
+
+//! \brief sizes of the data of an integration point
+struct Sizes {
+  std::size_t g, th, mp, isv, esv, K;
+  //! \brief sizes of the external state variables, temperature first
+  std::vector<std::size_t> esvs;
+};
+
+/*!
+ * \brief options of finite strain behaviours, encoded as the second and
+ * third values of the `K` array of the `generic` interface
+ */
+struct FiniteStrainOptions {
+  bool finite_strain = false;
+  double stress_measure = 0;
+  double tangent_operator = 0;
+};
+
+//! \brief states of all the points, stored point by point
+struct States {
+  std::vector<double> g0, g1, th0, th1, mp, isv0, isv1, esv0, esv1, K, rdt;
+  //! \brief stored and dissipated energies
+  std::vector<double> stored_energy0, stored_energy1, dissipated_energy0,
+      dissipated_energy1;
+  //! \brief speed of sound
+  std::vector<double> speed_of_sound;
+  //! \brief uniform mass density, not given to the behaviour if null
+  double mass_density = 0;
+  std::vector<int> status;
+  States(const std::size_t n, const Sizes& s)
+      : g0(n * s.g),
+        g1(n * s.g),
+        th0(n * s.th),
+        th1(n * s.th),
+        mp(n * s.mp),
+        isv0(n * s.isv),
+        isv1(n * s.isv),
+        esv0(n * s.esv),
+        esv1(n * s.esv),
+        K(n * s.K),
+        rdt(n, 1),
+        stored_energy0(n, 0),
+        stored_energy1(n, 0),
+        dissipated_energy0(n, 0),
+        dissipated_energy1(n, 0),
+        speed_of_sound(n, 0),
+        status(n, 0) {}
+};
+
+//! \brief name of a tested function, split in its components
+struct FunctionName {
+  //! \brief name of the behaviour or of the model
+  std::string behaviour;
+  //! \brief modelling hypothesis
+  std::string hypothesis;
+  //! \brief end of the name (initialize function, post-processing or
+  //! rotation), empty for an integration
+  std::string suffix;
+};
+
+/*!
+ * \return the components of the name of a tested function, which starts
+ * with the name of the behaviour followed by the modelling hypothesis
+ * \param[in] f: name of the function
+ */
+static FunctionName parseFunctionName(const std::string& f) {
+  for (const auto* const h : {"AxisymmetricalGeneralisedPlaneStrain",
+                              "AxisymmetricalGeneralisedPlaneStress",
+                              "Axisymmetrical", "GeneralisedPlaneStrain",
+                              "PlaneStrain", "PlaneStress", "Tridimensional"}) {
+    const auto hypothesis = std::string{h};
+    const auto p = f.find("_" + hypothesis);
+    if (p == std::string::npos) {
+      continue;
+    }
+    const auto e = p + 1 + hypothesis.size();
+    if ((e != f.size()) && (f[e] != '_')) {
+      continue;
+    }
+    return {.behaviour = f.substr(0, p),
+            .hypothesis = hypothesis,
+            .suffix = e == f.size() ? "" : f.substr(e + 1)};
+  }
+  fail("no modelling hypothesis in the name of the function '" + f + "'");
+}
+
+/*!
+ * \return a symbol of a library: the symbol specific to the modelling
+ * hypothesis if it exists, the symbol of the behaviour otherwise, or null
+ * \param[in] lib: library
+ * \param[in] f: tested function
+ * \param[in] n: name of the symbol, without the name of the behaviour
+ */
+static const void* findSymbol(const std::string& lib,
+                              const FunctionName& f,
+                              const std::string& n) {
+  auto* const l = dlopen(lib.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (l == nullptr) {
+    fail(dlerror());
+  }
+  for (const auto& s :
+       {f.behaviour + "_" + f.hypothesis + "_" + n, f.behaviour + "_" + n}) {
+    if (const auto* const p = dlsym(l, s.c_str()); p != nullptr) {
+      return p;
+    }
+  }
+  return nullptr;
+}
+
+/*!
+ * \return the size of a variable
+ * \param[in] type: type of the variable, encoded as described by the
+ * `SupportedTypes::getTypeIdentifier` method of `MFront`
+ * \param[in] h: modelling hypothesis
+ */
+static std::size_t getVariableSize(const int type, const std::string& h) {
+  // space dimension: given by the type or by the modelling hypothesis
+  const auto d = [&] {
+    if (((type >> 3) & 3) != 0) {
+      return (type >> 3) & 3;
+    }
+    if (h == "Tridimensional") {
+      return 3;
+    }
+    return h.starts_with("AxisymmetricalGeneralised") ? 1 : 2;
+  }();
+  switch (type & 7) {
+    case 0:
+      return 1;
+    case 1:
+      return d == 1 ? 3 : (d == 2 ? 4 : 6);
+    case 2:
+      return static_cast<std::size_t>(d);
+    case 3:
+      return d == 1 ? 3 : (d == 2 ? 5 : 9);
+  }
+  fail("unsupported type of variable");
+}
+
+//! \brief name and size of a variable
+struct Variable {
+  std::string name;
+  std::size_t size;
+};
+
+/*!
+ * \return the variables of a group (gradients, internal state variables,
+ * etc.), described by the symbols exported by a library
+ * \param[in] lib: library
+ * \param[in] f: tested function
+ * \param[in] g: name of the group (for instance `InternalStateVariables`)
+ */
+static std::vector<Variable> getVariables(const std::string& lib,
+                                          const FunctionName& f,
+                                          const std::string& g) {
+  const auto* const n =
+      static_cast<const unsigned short*>(findSymbol(lib, f, "n" + g));
+  if (n == nullptr) {
+    fail("no symbol giving the number of variables of '" + g + "'");
+  }
+  auto r = std::vector<Variable>{};
+  if (*n == 0) {
+    return r;
+  }
+  const auto* const names =
+      static_cast<const char* const*>(findSymbol(lib, f, g));
+  // the material properties are scalars and have no type
+  const auto* const types =
+      static_cast<const int*>(findSymbol(lib, f, g + "Types"));
+  for (unsigned short i = 0; i != *n; ++i) {
+    r.push_back({.name = names[i],
+                 .size = types == nullptr
+                             ? 1
+                             : getVariableSize(types[i], f.hypothesis)});
+  }
+  return r;
+}
+
+//! \return the sum of the sizes of the given variables
+static std::size_t getSize(const std::vector<Variable>& variables) {
+  auto s = std::size_t{};
+  for (const auto& v : variables) {
+    s += v.size;
+  }
+  return s;
+}
+
+/*!
+ * \return the sizes of the data of a point, as seen by the `generic`
+ * interface, read in the symbols exported by a library
+ * \param[in] lib: library generated by the `generic` interface
+ * \param[in] f: tested function
+ * \param[in] fs: finite strain options
+ */
+static Sizes readSizes(const std::string& lib,
+                       const FunctionName& f,
+                       const FiniteStrainOptions& fs) {
+  const auto g = getVariables(lib, f, "Gradients");
+  const auto th = getVariables(lib, f, "ThermodynamicForces");
+  const auto isvs = getVariables(lib, f, "InternalStateVariables");
+  const auto esvs = getVariables(lib, f, "ExternalStateVariables");
+  // the temperature is the first external state variable
+  auto s = Sizes{.g = getSize(g),
+                 .th = getSize(th),
+                 .mp = getVariables(lib, f, "MaterialProperties").size(),
+                 .isv = getSize(isvs),
+                 .esv = 1 + getSize(esvs),
+                 .K = 0,
+                 .esvs = {1}};
+  for (const auto& v : esvs) {
+    s.esvs.push_back(v.size);
+  }
+  // the elastic material properties and the thermal expansion coefficients
+  // are the first material properties if the behaviour requires the
+  // stiffness tensor or the thermal expansion coefficients tensor (see
+  // `mfront::gb::ThermoElasticMaterialPropertiesNumber`)
+  const auto is_required = [&](const std::string& n) {
+    const auto* const p =
+        static_cast<const unsigned short*>(findSymbol(lib, f, n));
+    return (p != nullptr) && (*p != 0);
+  };
+  const auto* const symmetry = static_cast<const unsigned short*>(
+      findSymbol(lib, f, "ElasticSymmetryType"));
+  const auto orthotropic = (symmetry != nullptr) && (*symmetry == 1);
+  if (is_required("requiresStiffnessTensor")) {
+    if (!orthotropic) {
+      s.mp += 2;
+    } else if (f.hypothesis == "Tridimensional") {
+      s.mp += 9;
+    } else {
+      s.mp += f.hypothesis.starts_with("AxisymmetricalGeneralised") ? 6 : 7;
+    }
+  }
+  if (is_required("requiresThermalExpansionCoefficientTensor")) {
+    s.mp += orthotropic ? 3 : 1;
+  }
+  const auto size = [&](const std::string& n) -> std::size_t {
+    for (const auto* const vs : {&g, &th, &isvs, &esvs}) {
+      for (const auto& v : *vs) {
+        if (v.name == n) {
+          return v.size;
+        }
+      }
+    }
+    if (n == "Temperature") {
+      return 1;
+    }
+    fail("unknown variable '" + n + "' in the tangent operator blocks");
+  };
+  const auto* const nblocks = static_cast<const unsigned short*>(
+      findSymbol(lib, f, "nTangentOperatorBlocks"));
+  if ((nblocks != nullptr) && (*nblocks != 0)) {
+    // the blocks are given as pairs of variables
+    const auto* const blocks = static_cast<const char* const*>(
+        findSymbol(lib, f, "TangentOperatorBlocks"));
+    for (unsigned short i = 0; i + 1 < *nblocks; i += 2) {
+      s.K += size(blocks[i]) * size(blocks[i + 1]);
+    }
+  }
+  // the thermodynamic forces and the tangent operator of the standard finite
+  // strain behaviours depend on the options. The symbols describe the Cauchy
+  // stress and its derivative with respect to the deformation gradient.
+  const auto* const type =
+      static_cast<const unsigned short*>(findSymbol(lib, f, "BehaviourType"));
+  if ((type != nullptr) && (*type == 2)) {
+    const auto T = s.g;
+    const auto S = s.th;
+    s.th = fs.stress_measure == 2 ? T : S;
+    if (fs.tangent_operator == 1) {
+      s.K = S * S;
+    } else if (fs.tangent_operator == 2) {
+      s.K = T * T;
+    } else {
+      s.K = S * T;
+    }
+  }
+  return s;
+}
+
+/*!
+ * \return the memory space of a function of a library (`host`, `device` or
+ * `any`), empty if the symbol is not found
+ * \param[in] lib: library
+ * \param[in] f: tested function
+ */
+static std::string_view getMemorySpace(const std::string& lib,
+                                       const FunctionName& f) {
+  const auto* const m = static_cast<const char* const*>(
+      findSymbol(lib, f, "generic_parallel_memory_space"));
+  return std::string_view{m != nullptr ? *m : ""};
+}
+
+/*!
+ * \return the identifier of the execution policy expected by the tested
+ * function, exported by the library
+ * \param[in] lib: library
+ * \param[in] f: tested function
+ */
+static std::string getExecutionPolicyIdentifier(const std::string& lib,
+                                                const FunctionName& f) {
+  const auto* const p = static_cast<const char* const*>(
+      findSymbol(lib, f, "generic_parallel_execution_policy"));
+  return ((p != nullptr) && (*p != nullptr)) ? std::string{*p} : std::string{};
+}
+
+/*!
+ * \brief check that the version of the data structures exported by the
+ * library is the one of `MFront/GenericParallelBehaviour/BatchData.h`, and
+ * that the library exports the memory space of the fields and the
+ * identifier of its execution policy
+ * \param[in] lib: library
+ * \param[in] f: tested function
+ */
+static void checkVersion(const std::string& lib, const FunctionName& f) {
+  const auto* const v = static_cast<const unsigned short*>(
+      findSymbol(lib, f, "generic_parallel_api_version"));
+  if ((v == nullptr) || (*v != MFRONT_GPB_API_VERSION)) {
+    fail("invalid version of the data structures in library '" + lib + "'");
+  }
+  const auto memory_space = getMemorySpace(lib, f);
+  if ((memory_space != "host") && (memory_space != "device") &&
+      (memory_space != "any")) {
+    fail("invalid memory space in library '" + lib + "'");
+  }
+  if (getExecutionPolicyIdentifier(lib, f).empty()) {
+    fail("no execution policy exported by library '" + lib + "'");
+  }
+}
+
+/*!
+ * \brief call the given function at each point with the behaviour data of
+ * the `generic` interface
+ * \param[in,out] st: states
+ * \param[in] s: sizes of the data of a point
+ * \param[in] fs: finite strain options
+ * \param[in] n: number of points
+ * \param[in] dt: time increment
+ * \param[in] K0: type of computation
+ * \param[in] f: function taking the behaviour data and the index of the
+ * point, and returning the status
+ */
+/*!
+ * \brief initial value of the time step scaling factor of the points
+ * (`--time-step-scaling-factor` option, `1` by default). A value lower than
+ * `0.99` makes the integration of all the points unreliable (status `0`),
+ * except the ones where it fails.
+ */
+static double initial_time_step_scaling_factor = 1;
+
+template <typename Function>
+static void forEachReferencePoint(States& st,
+                                  const Sizes& s,
+                                  const FiniteStrainOptions& fs,
+                                  const std::size_t n,
+                                  const double dt,
+                                  const double K0,
+                                  const Function& f) {
+  for (std::size_t i = 0; i != n; ++i) {
+    auto d = mfront_gb_BehaviourData{};
+    d.error_message = nullptr;
+    d.dt = dt;
+    // the type of computation is stored in the tangent operator, which is
+    // empty for models
+    auto K = std::array<double, 3>{K0, fs.stress_measure, fs.tangent_operator};
+    if (s.K != 0) {
+      std::copy_n(K.begin(), fs.finite_strain ? 3 : 1, st.K.begin() + i * s.K);
+    }
+    d.K = s.K != 0 ? st.K.data() + i * s.K : K.data();
+    st.rdt[i] = initial_time_step_scaling_factor;
+    d.rdt = st.rdt.data() + i;
+    d.speed_of_sound = st.speed_of_sound.data() + i;
+    d.s0.gradients = st.g0.data() + i * s.g;
+    d.s1.gradients = st.g1.data() + i * s.g;
+    d.s0.thermodynamic_forces = st.th0.data() + i * s.th;
+    d.s1.thermodynamic_forces = st.th1.data() + i * s.th;
+    d.s0.material_properties = st.mp.data() + i * s.mp;
+    d.s1.material_properties = st.mp.data() + i * s.mp;
+    d.s0.internal_state_variables = st.isv0.data() + i * s.isv;
+    d.s1.internal_state_variables = st.isv1.data() + i * s.isv;
+    d.s0.external_state_variables = st.esv0.data() + i * s.esv;
+    d.s1.external_state_variables = st.esv1.data() + i * s.esv;
+    d.s0.stored_energy = st.stored_energy0.data() + i;
+    d.s1.stored_energy = st.stored_energy1.data() + i;
+    d.s0.dissipated_energy = st.dissipated_energy0.data() + i;
+    d.s1.dissipated_energy = st.dissipated_energy1.data() + i;
+    d.s0.mass_density = d.s1.mass_density =
+        st.mass_density > 0 ? &(st.mass_density) : nullptr;
+    st.status[i] = f(d, i);
+  }
+}  // end of forEachReferencePoint
+
+//! \brief reference: one call to the `generic` interface per point
+static void integrateReference(States& st,
+                               const Sizes& s,
+                               const FiniteStrainOptions& fs,
+                               const std::size_t n,
+                               const double dt,
+                               const double K0,
+                               GenericFunction f) {
+  forEachReferencePoint(
+      st, s, fs, n, dt, K0,
+      [f](mfront_gb_BehaviourData& d, const std::size_t) { return f(&d); });
+}  // end of integrateReference
+
+/*!
+ * \brief a field of the batch, stored point by point or component by
+ * component
+ */
+/*!
+ * \brief storages of the fields of a batch:
+ *
+ * - `by_point`: the values of a point are contiguous;
+ * - `by_component`: the values of a component are contiguous;
+ * - `by_variable`: as `by_component`, but the material properties and the
+ *   external state variables are given variable by variable, with uniform
+ *   values (null point stride). This storage assumes that the material
+ *   properties and the external state variables are uniform, as in all
+ *   the tests. The material properties are scalars. The external state
+ *   variables may be vectors or tensors.
+ */
+enum struct Storage { by_point, by_component, by_variable };
+
+//! \return a description of a storage
+static const char* toString(const Storage s) {
+  if (s == Storage::by_point) {
+    return "by point";
+  }
+  return s == Storage::by_component ? "by component" : "by variable";
+}
+
+//! \brief all the storages
+static constexpr Storage storages[] = {Storage::by_point, Storage::by_component,
+                                       Storage::by_variable};
+
+struct BatchField {
+  BatchField(const std::vector<double>& v,
+             const std::size_t n_,
+             const std::size_t c_,
+             const bool by_component_)
+      : values(allocate<double>(n_ * c_)),
+        n(n_),
+        c(c_),
+        by_component(by_component_) {
+    for (std::size_t i = 0; i != this->n; ++i) {
+      for (std::size_t j = 0; j != this->c; ++j) {
+        this->values[this->index(i, j)] = v[i * this->c + j];
+      }
+    }
+    prefetch(this->values, this->n * this->c);
+  }
+  BatchField(const BatchField&) = delete;
+  BatchField& operator=(const BatchField&) = delete;
+  ~BatchField() { deallocate(this->values, this->n * this->c); }
+  //! \brief copy the values in a vector storing them point by point
+  void copy(std::vector<double>& v) const {
+    for (std::size_t i = 0; i != this->n; ++i) {
+      for (std::size_t j = 0; j != this->c; ++j) {
+        v[i * this->c + j] = this->values[this->index(i, j)];
+      }
+    }
+  }
+  mfront_gpb_Field field() const {
+    return this->by_component ? mfront_gpb_Field{this->values, 1, this->n}
+                              : mfront_gpb_Field{this->values, this->c, 1};
+  }
+  mfront_gpb_ConstField const_field() const {
+    const auto f = this->field();
+    return {f.values, f.point_stride, f.component_stride};
+  }
+  /*!
+   * \return a field giving the values of the first point at all points,
+   * starting from the `j`-th component
+   */
+  mfront_gpb_ConstField uniform(const std::size_t j) const {
+    return {this->values + this->index(0, j), 0,
+            this->by_component ? this->n : 1};
+  }
+
+ private:
+  std::size_t index(const std::size_t i, const std::size_t j) const {
+    return this->by_component ? j * this->n + i : i * this->c + j;
+  }
+  double* const values;
+  const std::size_t n, c;
+  const bool by_component;
+};
+
+/*!
+ * \brief fields of a batch, initialized from the states of the points.
+ * The batch data refer to those fields.
+ */
+struct BatchFields {
+  BatchFields(const States& st,
+              const Sizes& s,
+              const FiniteStrainOptions& fs,
+              const std::size_t n,
+              const double dt,
+              const double K0,
+              const Storage storage)
+      : by_component(storage != Storage::by_point),
+        g0(st.g0, n, s.g, by_component),
+        g1(st.g1, n, s.g, by_component),
+        th0(st.th0, n, s.th, by_component),
+        th1(st.th1, n, s.th, by_component),
+        mp(st.mp, n, s.mp, by_component),
+        isv0(st.isv0, n, s.isv, by_component),
+        isv1(st.isv1, n, s.isv, by_component),
+        esv0(st.esv0, n, s.esv, by_component),
+        esv1(st.esv1, n, s.esv, by_component),
+        K(st.K, n, s.K, by_component),
+        rdt(st.rdt, n, 1, false),
+        stored_energy0(st.stored_energy0, n, 1, by_component),
+        stored_energy1(st.stored_energy1, n, 1, by_component),
+        dissipated_energy0(st.dissipated_energy0, n, 1, by_component),
+        dissipated_energy1(st.dissipated_energy1, n, 1, by_component),
+        speed_of_sound(st.speed_of_sound, n, 1, by_component),
+        mass_density(std::vector<double>{st.mass_density}, 1, 1, false),
+        status(allocate<int>(n)),
+        number_of_points(n) {
+    prefetch(this->status, n);
+    synchronize();
+    auto& d = this->data;
+    d.execution_policy = executionPolicy();
+    d.number_of_points = n;
+    d.dt = dt;
+    d.options[0] = K0;
+    d.options[1] = fs.stress_measure;
+    d.options[2] = fs.tangent_operator;
+    d.rdt = initial_time_step_scaling_factor;
+    d.tangent_operators = this->K.field();
+    d.rdts = this->rdt.field();
+    d.statuses = this->status;
+    d.s0.gradients = this->g0.const_field();
+    d.s1.gradients = this->g1.const_field();
+    d.s0.thermodynamic_forces = this->th0.const_field();
+    d.s1.thermodynamic_forces = this->th1.field();
+    d.s0.material_properties = this->mp.const_field();
+    d.s1.material_properties = this->mp.const_field();
+    d.s0.internal_state_variables = this->isv0.const_field();
+    d.s1.internal_state_variables = this->isv1.field();
+    d.s0.external_state_variables = this->esv0.const_field();
+    d.s1.external_state_variables = this->esv1.const_field();
+    d.s0.stored_energy = this->stored_energy0.const_field();
+    d.s1.stored_energy = this->stored_energy1.field();
+    d.s0.dissipated_energy = this->dissipated_energy0.const_field();
+    d.s1.dissipated_energy = this->dissipated_energy1.field();
+    d.speed_of_sound = this->speed_of_sound.field();
+    if (storage == Storage::by_variable) {
+      for (std::size_t j = 0; j != s.mp; ++j) {
+        this->mps.push_back(this->mp.uniform(j));
+      }
+      // one field per external state variable
+      for (std::size_t j = 0; const auto size : s.esvs) {
+        this->esvs0.push_back(this->esv0.uniform(j));
+        this->esvs1.push_back(this->esv1.uniform(j));
+        j += size;
+      }
+      // the group fields are ignored
+      d.s0.material_properties = d.s1.material_properties = {};
+      d.s0.external_state_variables = d.s1.external_state_variables = {};
+      d.s0.material_properties_by_variable = this->mps.data();
+      d.s1.material_properties_by_variable = this->mps.data();
+      d.s0.external_state_variables_by_variable = this->esvs0.data();
+      d.s1.external_state_variables_by_variable = this->esvs1.data();
+    }
+    if (st.mass_density > 0) {
+      // uniform mass density
+      d.s0.mass_density = d.s1.mass_density = this->mass_density.const_field();
+      d.s0.mass_density.point_stride = d.s1.mass_density.point_stride = 0;
+    }
+  }
+  BatchFields(const BatchFields&) = delete;
+  BatchFields& operator=(const BatchFields&) = delete;
+  ~BatchFields() { deallocate(this->status, this->number_of_points); }
+  //! \brief copy the outputs in the states
+  void copyResults(States& st) const {
+    this->th1.copy(st.th1);
+    this->isv1.copy(st.isv1);
+    this->K.copy(st.K);
+    this->rdt.copy(st.rdt);
+    this->stored_energy1.copy(st.stored_energy1);
+    this->dissipated_energy1.copy(st.dissipated_energy1);
+    this->speed_of_sound.copy(st.speed_of_sound);
+    std::copy(this->status, this->status + this->number_of_points,
+              st.status.begin());
+  }
+  const bool by_component;
+  const BatchField g0, g1, th0, th1, mp, isv0, isv1, esv0, esv1, K, rdt,
+      stored_energy0, stored_energy1, dissipated_energy0, dissipated_energy1,
+      speed_of_sound, mass_density;
+  //! \brief fields of the material properties, variable by variable
+  std::vector<mfront_gpb_ConstField> mps;
+  //! \brief fields of the external state variables, variable by variable
+  std::vector<mfront_gpb_ConstField> esvs0, esvs1;
+  int* const status;
+  const std::size_t number_of_points;
+  mfront_gpb_BatchData data = {};
+};
+
+/*!
+ * \brief call the given function and measure its execution time
+ * \return the output status
+ * \param[out] ms: execution time in milliseconds
+ * \param[in] f: function taking an output status
+ */
+template <typename Function>
+static mfront_gpb_OutputStatus measure(double& ms, const Function& f) {
+  auto o = mfront_gpb_OutputStatus{};
+  const auto start = std::chrono::steady_clock::now();
+  f(o);
+  const auto end = std::chrono::steady_clock::now();
+  ms = std::chrono::duration<double, std::milli>(end - start).count();
+  return o;
+}  // end of measure
+
+/*!
+ * \brief batch integration with the `generic-parallel` interface
+ * \param[in] report: if not null, the statistics of the batch are given by
+ * the calling code and the device is synchronized after the call. The
+ * returned output status is then built by this function from those
+ * statistics.
+ * \param[in] p: execution policy
+ */
+static mfront_gpb_OutputStatus integrateBatch(
+    States& st,
+    const Sizes& s,
+    const FiniteStrainOptions& fs,
+    const std::size_t n,
+    const double dt,
+    const double K0,
+    const Storage storage,
+    BatchFunction f,
+    const mfront_gpb_ReportPtr report,
+    double& ms,
+    const mfront_gp_AbstractBackendExecutionPolicy* const p =
+        executionPolicy()) {
+  auto b = BatchFields(st, s, fs, n, dt, K0, storage);
+  b.data.execution_policy = p;
+  auto* const statistics =
+      report != nullptr ? allocate<mfront_gpb_Statistics>(1) : nullptr;
+  if (statistics != nullptr) {
+    mfront_gpb_initializeStatistics(statistics, b.data.rdt);
+    b.data.statistics = statistics;
+  }
+  auto o = measure(ms, [&b, f, statistics](mfront_gpb_OutputStatus& r) {
+    f(&r, &b.data);
+    if (statistics != nullptr) {
+      synchronize();
+    }
+  });
+  if (statistics != nullptr) {
+    // the output status only reports the submission of the computations
+    if (o.status == 1) {
+      report(&o, statistics);
+    }
+    deallocate(statistics, 1);
+  }
+  b.copyResults(st);
+  return o;
+}
+
+/*!
+ * \brief tolerance on the relative differences. Both libraries are not
+ * compiled by the same compiler, which may contract the floating point
+ * operations differently: the results agree up to round-off errors, amplified
+ * by the local Newton solvers of the behaviours. A defect gives differences of
+ * the order of one.
+ */
+static constexpr double tolerance = 1e-10;
+
+//! \brief relative difference over the points where the integration succeeded
+static double relativeDifference(const std::vector<double>& a,
+                                 const std::vector<double>& b,
+                                 const std::vector<int>& status,
+                                 const std::size_t c) {
+  auto m = 0., r = 0.;
+  for (std::size_t i = 0; i != status.size(); ++i) {
+    if (status[i] == -1) {
+      continue;
+    }
+    for (std::size_t j = 0; j != c; ++j) {
+      m = std::max(m, std::abs(a[i * c + j] - b[i * c + j]));
+      r = std::max(r, std::abs(a[i * c + j]));
+    }
+  }
+  return r == 0 ? m : m / r;
+}
+
+//! \return the values of a comma separated list, `-` denoting an empty list
+static std::vector<double> parseList(const std::string& l) {
+  auto r = std::vector<double>{};
+  if (l == "-") {
+    return r;
+  }
+  for (auto v = l; !v.empty();) {
+    const auto c = v.find(',');
+    r.push_back(std::stod(v.substr(0, c)));
+    v = c == std::string::npos ? "" : v.substr(c + 1);
+  }
+  return r;
+}
+
+/*!
+ * \return the names and values of parameters
+ * \param[in] l: comma separated list of `name=value` pairs
+ */
+static std::vector<std::pair<std::string, double>> parseParameters(
+    const std::string& l) {
+  auto r = std::vector<std::pair<std::string, double>>{};
+  for (auto v = l; !v.empty();) {
+    const auto c = v.find(',');
+    const auto p = v.substr(0, c);
+    const auto e = p.find('=');
+    if (e == std::string::npos) {
+      fail("invalid parameter '" + p + "'");
+    }
+    r.emplace_back(p.substr(0, e), std::stod(p.substr(e + 1)));
+    v = c == std::string::npos ? "" : v.substr(c + 1);
+  }
+  return r;
+}
+
+/*!
+ * \return the options of finite strain behaviours
+ * \param[in] o: stress measure and tangent operator, separated by a comma
+ */
+static FiniteStrainOptions parseFiniteStrainOptions(const std::string& o) {
+  const auto p = o.find(',');
+  if (p == std::string::npos) {
+    fail("invalid finite strain options '" + o + "'");
+  }
+  const auto sm = o.substr(0, p);
+  const auto to = o.substr(p + 1);
+  auto r = FiniteStrainOptions{.finite_strain = true};
+  if (sm == "CAUCHY") {
+    r.stress_measure = 0;
+  } else if (sm == "PK2") {
+    r.stress_measure = 1;
+  } else if (sm == "PK1") {
+    r.stress_measure = 2;
+  } else {
+    fail("invalid stress measure '" + sm + "'");
+  }
+  if (to == "DSIG_DF") {
+    r.tangent_operator = 0;
+  } else if (to == "DS_DEGL") {
+    r.tangent_operator = 1;
+  } else if (to == "DPK1_DF") {
+    r.tangent_operator = 2;
+  } else if (to == "DTAU_DDF") {
+    r.tangent_operator = 3;
+  } else {
+    fail("invalid tangent operator '" + to + "'");
+  }
+  return r;
+}
+
+/*!
+ * \return true if the summary of the integration of a batch is consistent
+ * with the statuses of the points
+ * \param[in] o: output status
+ * \param[in] status: statuses of the points
+ */
+static bool isConsistent(const mfront_gpb_OutputStatus& o,
+                         const std::vector<int>& status) {
+  const auto nfailures =
+      static_cast<std::size_t>(std::count(status.begin(), status.end(), -1));
+  const auto nunreliable =
+      static_cast<std::size_t>(std::count(status.begin(), status.end(), 0));
+  const auto first_failure = std::find(status.begin(), status.end(), -1);
+  const auto first_failure_index =
+      first_failure != status.end()
+          ? static_cast<std::size_t>(first_failure - status.begin())
+          : ~std::size_t{};
+  const auto first_unreliable = std::find(status.begin(), status.end(), 0);
+  const auto first_unreliable_result_index =
+      first_unreliable != status.end()
+          ? static_cast<std::size_t>(first_unreliable - status.begin())
+          : ~std::size_t{};
+  const auto expected = nfailures != 0 ? -1 : (nunreliable != 0 ? 0 : 1);
+  return (o.status == expected) && (o.number_of_failures == nfailures) &&
+         (o.first_failure_index == first_failure_index) &&
+         (o.number_of_unreliable_results == nunreliable) &&
+         (o.first_unreliable_result_index == first_unreliable_result_index);
+}
+
+//! \brief function tested
+enum struct Mode {
+  INTEGRATION,
+  INITIALIZE_FUNCTION,
+  POST_PROCESSING,
+  ROTATION
+};
+
+//! \brief optional arguments
+struct Options {
+  //! \brief options of finite strain behaviours
+  FiniteStrainOptions finite_strain;
+  //! \brief values of the material properties
+  std::vector<double> material_properties;
+  //! \brief amplitude of the random perturbation of the gradients
+  double amplitude = 1e-3;
+  //! \brief temperature
+  double temperature = 293.15;
+  //! \brief values of the external state variables other than the
+  //! temperature
+  std::vector<double> external_state_variables;
+  //! \brief time increment
+  double time_increment = 1;
+  /*!
+   * \brief initial values of the internal state variables of a point (a
+   * single value is used for all the internal state variables)
+   */
+  std::vector<double> initial_internal_state_variables = {0};
+  //! \brief mass density, if the speed of sound is requested
+  double mass_density = 0;
+  //! \brief if true, the behaviour must compute non null energies
+  bool energies = false;
+  /*!
+   * \brief if true, the batch is also integrated on another device, if any
+   * (see `testOtherDevice`)
+   */
+  bool other_device = false;
+  /*!
+   * \brief if true, the file of parameters written by the calling script is
+   * invalid: the integration must be refused (see `testInvalidParameters`)
+   */
+  bool invalid_parameters = false;
+  //! \brief text expected in the message of an invalid file of parameters
+  std::string invalid_parameters_message = "can't convert";
+  /*!
+   * \brief if true, the batch library also contains the functions of the
+   * `generic` interface (`generic_functions` option of the `generic-parallel`
+   * interface): it must export `Generic` as interface, and its functions of
+   * a point are also compared to its functions of batches of points
+   */
+  bool generic_functions = false;
+  //! \brief type of the tangent operator (consistent tangent operator by
+  //! default)
+  double tangent_operator = 4;
+  //! \brief amplitude of the random perturbation of the internal state
+  //! variables
+  double internal_state_variables_perturbation = 0;
+  //! \brief out of bounds policy (0: None, 1: Warning, 2: Strict), if
+  //! positive
+  int out_of_bounds_policy = -1;
+  //! \brief names and values of the parameters changed in both libraries
+  std::vector<std::pair<std::string, double>> parameters;
+};
+
+//! \return the optional arguments
+static Options parseOptions(const int argc,
+                            const char* const* const argv,
+                            const int first) {
+  auto r = Options{};
+  for (auto i = first; i != argc; ++i) {
+    const auto a = std::string{argv[i]};
+    const auto p = a.find('=');
+    if (p == std::string::npos) {
+      fail("invalid option '" + a + "'");
+    }
+    const auto o = a.substr(0, p);
+    const auto v = a.substr(p + 1);
+    if (o == "--finite-strain") {
+      r.finite_strain = parseFiniteStrainOptions(v);
+    } else if (o == "--material-properties") {
+      r.material_properties = parseList(v);
+    } else if (o == "--amplitude") {
+      r.amplitude = std::stod(v);
+    } else if (o == "--temperature") {
+      r.temperature = std::stod(v);
+    } else if (o == "--external-state-variables") {
+      r.external_state_variables = parseList(v);
+    } else if (o == "--time-increment") {
+      r.time_increment = std::stod(v);
+    } else if (o == "--perturbation-of-internal-state-variables") {
+      r.internal_state_variables_perturbation = std::stod(v);
+    } else if (o == "--out-of-bounds-policy") {
+      r.out_of_bounds_policy = v == "None" ? 0 : (v == "Warning" ? 1 : 2);
+      if ((v != "None") && (v != "Warning") && (v != "Strict")) {
+        fail("invalid out of bounds policy '" + v + "'");
+      }
+    } else if (o == "--tangent-operator") {
+      r.tangent_operator = std::stod(v);
+    } else if (o == "--energies") {
+      r.energies = v == "true";
+    } else if (o == "--other-device") {
+      r.other_device = v == "true";
+    } else if (o == "--invalid-parameters") {
+      r.invalid_parameters = v == "true";
+    } else if (o == "--invalid-parameters-message") {
+      r.invalid_parameters_message = v;
+    } else if (o == "--generic-functions") {
+      r.generic_functions = v == "true";
+    } else if (o == "--time-step-scaling-factor") {
+      initial_time_step_scaling_factor = std::stod(v);
+    } else if (o == "--speed-of-sound") {
+      r.mass_density = std::stod(v);
+    } else if (o == "--initial-internal-state-variables") {
+      r.initial_internal_state_variables = parseList(v);
+    } else if (o == "--parameters") {
+      r.parameters = parseParameters(v);
+    } else {
+      fail("invalid option '" + o + "'");
+    }
+  }
+  return r;
+}
+
+/*!
+ * \brief description of a test: libraries, function, sizes, loading and
+ * options
+ */
+struct Test {
+  std::string generic_library, batch_library, function;
+  //! \brief identifier of the execution policy expected by the library
+  std::string execution_policy;
+  //! \brief components of the name of the tested function
+  FunctionName name;
+  Sizes sizes;
+  Options options;
+  //! \brief function tested
+  Mode mode;
+  //! \brief number of inputs of an initialize function, number of outputs
+  //! of a post-processing or number of rotated values of a point
+  std::size_t number_of_values;
+  //! \brief initial states of the points
+  States initial;
+  //! \brief identity, or null values for small strain behaviours
+  std::vector<double> identity;
+  //! \brief number of points
+  std::size_t n;
+  //! \brief time increment
+  double dt;
+};
+
+/*!
+ * \return the report function of the library of the `generic-parallel`
+ * interface, which analyses the statistics of a batch
+ * \param[in] t: test
+ */
+static mfront_gpb_ReportPtr loadReportFunction(const Test& t) {
+  return reinterpret_cast<mfront_gpb_ReportPtr>(
+      load(t.batch_library, t.name.behaviour + "_generic_parallel_report"));
+}
+
+/*!
+ * \return true if the report function of the library treats the
+ * statistics of a batch where nothing happened as a success, keeping the
+ * initial value of the time step scaling factor, and null statistics as an
+ * invalid argument (status `-5`)
+ * \param[in] t: test
+ */
+static bool testReportFunction(const Test& t) {
+  const auto report = loadReportFunction(t);
+  auto statistics = mfront_gpb_Statistics{};
+  mfront_gpb_initializeStatistics(&statistics, 0.5);
+  auto o1 = mfront_gpb_OutputStatus{};
+  const auto r1 = report(&o1, &statistics);
+  auto o2 = mfront_gpb_OutputStatus{};
+  const auto r2 = report(&o2, nullptr);
+  const auto pass =
+      (r1 == 1) && (o1.status == 1) && (o1.number_of_failures == 0) &&
+      (o1.first_failure_index == ~mfront_gb_size_type{}) &&
+      (o1.number_of_unreliable_results == 0) &&
+      (o1.first_unreliable_result_index == ~mfront_gb_size_type{}) &&
+      (o1.rdt == 0.5) && (r2 == -5) && (o2.status == -5);
+  std::printf("%-12s %-12s status=%2d/%2d | rdt %g | %s\n", "report",
+              "function", o1.status, o2.status, o1.rdt, pass ? "OK" : "FAILED");
+  return pass;
+}
+
+//! \brief print the results of a comparison
+static bool print(const char* const what,
+                  const Storage storage,
+                  const bool pass,
+                  const mfront_gpb_OutputStatus& o,
+                  const std::vector<int>& status,
+                  const double d,
+                  const double ms) {
+  std::printf(
+      "%-12s %-12s status=%2d failures=%6ld | relative difference %.1e | "
+      "%.2f ms | %s\n",
+      what, toString(storage), o.status,
+      static_cast<long>(std::count(status.begin(), status.end(), -1)), d, ms,
+      pass ? "OK" : "FAILED");
+  return pass;
+}
+
+/*!
+ * \return true if the integration of an empty batch whose fields are null
+ * succeeds. The data of an empty `std::vector` may be null, for instance on
+ * a process which has no point of a material.
+ * \param[in] f: batch function
+ * \param[in] fs: options of the finite strain behaviours
+ * \param[in] K0: type of computation
+ */
+static bool testEmptyBatch(BatchFunction f,
+                           const FiniteStrainOptions& fs,
+                           const double K0) {
+  auto d = mfront_gpb_BatchData{};
+  d.number_of_points = 0;
+  d.dt = 1;
+  d.options[0] = K0;
+  d.options[1] = fs.stress_measure;
+  d.options[2] = fs.tangent_operator;
+  d.rdt = 1;
+  d.execution_policy = executionPolicy();
+  auto o = mfront_gpb_OutputStatus{};
+  f(&o, &d);
+  const auto pass = o.status == 1;
+  std::printf("%-12s %-12s status=%2d | %s\n", "empty batch", "null fields",
+              o.status, pass ? "OK" : "FAILED");
+  return pass;
+}
+
+/*!
+ * \return true if an invalid stress measure given to a finite strain
+ * behaviour is reported as an invalid argument (status `-5`) for the whole
+ * batch, and not as an integration failure at every point. General
+ * behaviours, which do not use those options, are not tested.
+ * \param[in] t: test
+ * \param[in] f: batch function
+ * \param[in] K0: type of computation
+ */
+static bool testInvalidComputationOptions(const Test& t,
+                                          BatchFunction f,
+                                          const double K0) {
+  const auto* const type = static_cast<const unsigned short*>(
+      findSymbol(t.batch_library, t.name, "BehaviourType"));
+  if ((type == nullptr) || (*type == 0)) {
+    return true;
+  }
+  auto fs = t.options.finite_strain;
+  // no stress measure is associated with this value
+  fs.stress_measure = 3;
+  auto st = t.initial;
+  auto b = BatchFields(st, t.sizes, fs, t.n, t.dt, K0, Storage::by_point);
+  auto o = mfront_gpb_OutputStatus{};
+  f(&o, &b.data);
+  synchronize();
+  const auto pass = o.status == -5;
+  std::printf("%-12s %-12s status=%2d | %s\n", "invalid", "options", o.status,
+              pass ? "OK" : "FAILED");
+  return pass;
+}
+
+/*!
+ * \return true if the integration on another device than the one used by
+ * the other tests gives the results of the reference. The data shared by
+ * the integration points (`@SharedData`), already copied on the first
+ * device, must then be copied on the other device. This test is skipped if
+ * no other device is available (only SYCL gives access to another device).
+ * \param[in] t: test
+ * \param[in] fg: function of the `generic` interface
+ * \param[in] fb: batch function
+ * \param[in] K0: type of computation
+ */
+static bool testOtherDevice(const Test& t,
+                            GenericFunction fg,
+                            BatchFunction fb,
+                            const double K0) {
+  const auto* const p = otherDeviceExecutionPolicy();
+  if (p == nullptr) {
+    std::printf("%-12s %-12s | skipped: no other device\n", "other", "device");
+    return true;
+  }
+  const auto& s = t.sizes;
+  const auto& fs = t.options.finite_strain;
+  auto ref = t.initial;
+  auto batch = t.initial;
+  auto ms = 0.;
+  integrateReference(ref, s, fs, t.n, t.dt, K0, fg);
+  const auto o = integrateBatch(batch, s, fs, t.n, t.dt, K0, Storage::by_point,
+                                fb, nullptr, ms, p);
+  const auto dth = relativeDifference(ref.th1, batch.th1, ref.status, s.th);
+  const auto pass = (ref.status == batch.status) &&
+                    isConsistent(o, batch.status) && (dth < tolerance);
+  std::printf("%-12s %-12s status=%2d | relative difference %.1e | %s\n",
+              "other", "device", o.status, dth, pass ? "OK" : "FAILED");
+  return pass;
+}
+
+#if defined(GPU_API)
+/*!
+ * \return true if the stack size of the threads, preserved by the
+ * execution policy, is not modified and reported as too small (status
+ * `-7`). The kernels require at least 1024 bytes (see
+ * `mfront::generic_parallel::gpu::ensureStackSize`).
+ * \param[in] t: test
+ * \param[in] fb: batch function
+ * \param[in] K0: type of computation
+ */
+static bool testPreserveStackSize(const Test& t,
+                                  BatchFunction fb,
+                                  const double K0) {
+  auto initial = std::size_t{};
+  check(GPU_API(DeviceGetLimit)(&initial, GPU_API(LimitStackSize)));
+  check(GPU_API(DeviceSetLimit)(GPU_API(LimitStackSize), 256));
+  auto st = t.initial;
+  auto b = BatchFields(st, t.sizes, t.options.finite_strain, t.n, t.dt, K0,
+                       Storage::by_point);
+  const auto preserve =
+      makeExecutionPolicy(t.execution_policy, {.preserve_stack_size = true});
+  b.data.execution_policy = preserve.get();
+  auto o = mfront_gpb_OutputStatus{};
+  fb(&o, &b.data);
+  auto stack_size = std::size_t{};
+  check(GPU_API(DeviceGetLimit)(&stack_size, GPU_API(LimitStackSize)));
+  check(GPU_API(DeviceSetLimit)(GPU_API(LimitStackSize), initial));
+  const auto pass =
+      (o.status == -7) && (stack_size < 1024) &&
+      (std::string_view{o.msg}.starts_with(
+          "the stack size of the threads of the device must be at least"));
+  std::printf("%-12s %-12s status=%2d | %s\n", "preserved", "stack size",
+              o.status, pass ? "OK" : "FAILED");
+  return pass;
+}
+#endif /* defined(GPU_API) */
+
+#if defined(MFRONT_GPB_COMPARE_USE_SYCL)
+/*!
+ * \return true if the queues of the execution policies are treated as
+ * documented: a null policy is an invalid argument (status `-5`), an
+ * asynchronous integration requires an in-order queue (status `-5`
+ * otherwise), and a synchronous integration on an out-of-order queue gives
+ * the results of the reference, with or without statistics.
+ * \param[in] t: test
+ * \param[in] fg: function of the `generic` interface
+ * \param[in] fb: batch function
+ * \param[in] K0: type of computation
+ */
+static bool testSYCLQueues(const Test& t,
+                           GenericFunction fg,
+                           BatchFunction fb,
+                           const double K0) {
+  const auto& s = t.sizes;
+  const auto& fs = t.options.finite_strain;
+  auto ms = 0.;
+  auto st1 = t.initial;
+  const auto o1 = integrateBatch(st1, s, fs, t.n, t.dt, K0, Storage::by_point,
+                                 fb, nullptr, ms, nullptr);
+  // out-of-order queue sharing the device and the context of the queue of
+  // the other tests, hence the allocations of the fields
+  auto q = ::sycl::queue{getQueue().get_context(), getQueue().get_device()};
+  const auto asynchronous =
+      mfront::generic_parallel::makeSyclBackendExecutionPolicy(
+          q, {.asynchronous = true});
+  auto st2 = t.initial;
+  const auto o2 = integrateBatch(st2, s, fs, t.n, t.dt, K0, Storage::by_point,
+                                 fb, loadReportFunction(t), ms, &asynchronous);
+  const auto synchronous =
+      mfront::generic_parallel::makeSyclBackendExecutionPolicy(q);
+  auto ref = t.initial;
+  auto batch = t.initial;
+  integrateReference(ref, s, fs, t.n, t.dt, K0, fg);
+  const auto o3 = integrateBatch(batch, s, fs, t.n, t.dt, K0, Storage::by_point,
+                                 fb, nullptr, ms, &synchronous);
+  // statistics with a synchronous integration on an out-of-order queue
+  auto batch2 = t.initial;
+  const auto o4 =
+      integrateBatch(batch2, s, fs, t.n, t.dt, K0, Storage::by_point, fb,
+                     loadReportFunction(t), ms, &synchronous);
+  const auto dth =
+      std::max(relativeDifference(ref.th1, batch.th1, ref.status, s.th),
+               relativeDifference(ref.th1, batch2.th1, ref.status, s.th));
+  const auto pass =
+      (o1.status == -5) && (o2.status == -5) && (ref.status == batch.status) &&
+      (ref.status == batch2.status) && isConsistent(o3, batch.status) &&
+      isConsistent(o4, batch2.status) && (dth < tolerance);
+  std::printf(
+      "%-12s %-12s status=%2d/%2d/%2d/%2d | relative difference %.1e | %s\n",
+      "sycl", "queues", o1.status, o2.status, o3.status, o4.status, dth,
+      pass ? "OK" : "FAILED");
+  return pass;
+}
+#endif /* defined(MFRONT_GPB_COMPARE_USE_SYCL) */
+
+#if defined(MFRONT_GPB_COMPARE_USE_ARCANE)
+/*!
+ * \return true if the queues of the execution policies are treated as
+ * documented: a null policy and a policy holding a null queue are invalid
+ * arguments (status `-5`), and a synchronous or asynchronous integration on
+ * another queue of the runner of the tests gives the results of the
+ * reference. The asynchronous launch does not change the asynchronous state
+ * of the queue, which is synchronized by the test. A synchronous
+ * integration on an asynchronous queue waits for the completion of the
+ * computations and leaves the queue asynchronous.
+ * \param[in] t: test
+ * \param[in] fg: function of the `generic` interface
+ * \param[in] fb: batch function
+ * \param[in] K0: type of computation
+ */
+static bool testArcaneQueues(const Test& t,
+                             GenericFunction fg,
+                             BatchFunction fb,
+                             const double K0) {
+  const auto& s = t.sizes;
+  const auto& fs = t.options.finite_strain;
+  auto ms = 0.;
+  auto st1 = t.initial;
+  const auto o1 = integrateBatch(st1, s, fs, t.n, t.dt, K0, Storage::by_point,
+                                 fb, nullptr, ms, nullptr);
+  const auto null_queue =
+      mfront::generic_parallel::makeArcaneBackendExecutionPolicy(
+          Arcane::Accelerator::RunQueue{});
+  auto st2 = t.initial;
+  const auto o2 = integrateBatch(st2, s, fs, t.n, t.dt, K0, Storage::by_point,
+                                 fb, nullptr, ms, &null_queue);
+  auto ref = t.initial;
+  integrateReference(ref, s, fs, t.n, t.dt, K0, fg);
+  // synchronous integration on another queue
+  auto q = Arcane::Accelerator::makeQueue(Runtime::current->runner);
+  const auto synchronous =
+      mfront::generic_parallel::makeArcaneBackendExecutionPolicy(q);
+  auto batch = t.initial;
+  const auto o3 = integrateBatch(batch, s, fs, t.n, t.dt, K0, Storage::by_point,
+                                 fb, nullptr, ms, &synchronous);
+  // asynchronous integration on this queue, synchronized here
+  const auto asynchronous =
+      mfront::generic_parallel::makeArcaneBackendExecutionPolicy(
+          q, {.asynchronous = true});
+  auto batch2 = t.initial;
+  auto b = BatchFields(batch2, s, fs, t.n, t.dt, K0, Storage::by_point);
+  auto* const statistics = allocate<mfront_gpb_Statistics>(1);
+  mfront_gpb_initializeStatistics(statistics, b.data.rdt);
+  b.data.statistics = statistics;
+  b.data.execution_policy = &asynchronous;
+  auto o4 = mfront_gpb_OutputStatus{};
+  fb(&o4, &b.data);
+  const auto restored = !q.isAsync();
+  q.barrier();
+  if (o4.status == 1) {
+    loadReportFunction(t)(&o4, statistics);
+  }
+  deallocate(statistics, 1);
+  b.copyResults(batch2);
+  // synchronous integration on an asynchronous queue: the results are read
+  // without synchronization
+  q.setAsync(true);
+  auto batch3 = t.initial;
+  const auto o5 =
+      integrateBatch(batch3, s, fs, t.n, t.dt, K0, Storage::by_point, fb,
+                     nullptr, ms, &synchronous);
+  const auto still_asynchronous = q.isAsync();
+  q.setAsync(false);
+  auto has = [](const mfront_gpb_OutputStatus& o, const char* const m) {
+    return std::string_view{o.msg}.find(m) != std::string_view::npos;
+  };
+  const auto dth =
+      std::max({relativeDifference(ref.th1, batch.th1, ref.status, s.th),
+                relativeDifference(ref.th1, batch2.th1, ref.status, s.th),
+                relativeDifference(ref.th1, batch3.th1, ref.status, s.th)});
+  const auto pass =
+      (o1.status == -5) && has(o1, "the arcane backend requires a queue") &&
+      (o2.status == -5) &&
+      has(o2, "the queue of the execution policy is null") && restored &&
+      still_asynchronous && (ref.status == batch.status) &&
+      (ref.status == batch2.status) && (ref.status == batch3.status) &&
+      isConsistent(o3, batch.status) && isConsistent(o4, batch2.status) &&
+      isConsistent(o5, batch3.status) && (dth < tolerance);
+  std::printf(
+      "%-12s %-12s status=%2d/%2d/%2d/%2d/%2d | relative difference %.1e | "
+      "%s\n",
+      "arcane", "queues", o1.status, o2.status, o3.status, o4.status, o5.status,
+      dth, pass ? "OK" : "FAILED");
+  return pass;
+}
+#endif /* defined(MFRONT_GPB_COMPARE_USE_ARCANE) */
+
+//! \brief result of a call of a function of the library (see
+//! `checkExecutionPolicies`)
+struct PolicyCall {
+  //! \brief output status returned by the function
+  mfront_gpb_OutputStatus status;
+  //! \brief values computed by the function
+  std::vector<double> values;
+  //! \brief true if no computation was pending once the function returned
+  bool idle;
+};
+
+/*!
+ * \return true if a function of the library treats the execution policies
+ * as documented: a policy of another backend and an asynchronous
+ * computation without statistics are invalid arguments (status `-5`, with
+ * the messages of `mfront::generic_parallel::checkBackendExecutionPolicy`), and
+ * a synchronous computation with statistics returns once the computations are
+ * completed (checked with CUDA and HIP, see `isQueueIdle`; the test does not
+ * synchronise the device before reading the results), its output status
+ * reporting no error of the batch, its report and its values being the ones
+ * of the default execution policy of the tests.
+ * \param[in] t: test
+ * \param[in] what: name of the function in the output
+ * \param[in] call: function calling the function of the library on a new
+ * batch with the given execution policy and statistics, and returning its
+ * output status and its values (see `PolicyCall`)
+ */
+template <typename Call>
+static bool checkExecutionPolicies(const Test& t,
+                                   const char* const what,
+                                   const Call& call) {
+  const auto other = makeOtherBackendExecutionPolicy(t.execution_policy);
+  const auto asynchronous =
+      makeExecutionPolicy(t.execution_policy, {.asynchronous = true});
+  const auto synchronous = makeExecutionPolicy(t.execution_policy, {});
+  const auto r0 = call(executionPolicy(), nullptr);
+  const auto r1 = call(other.get(), nullptr);
+  const auto r2 = call(asynchronous.get(), nullptr);
+  auto* const statistics = allocate<mfront_gpb_Statistics>(1);
+  mfront_gpb_initializeStatistics(statistics, initial_time_step_scaling_factor);
+  const auto r3 = call(synchronous.get(), statistics);
+  auto o3 = mfront_gpb_OutputStatus{};
+  loadReportFunction(t)(&o3, statistics);
+  deallocate(statistics, 1);
+  auto has = [](const mfront_gpb_OutputStatus& o, const char* const m) {
+    return std::string_view{o.msg}.find(m) != std::string_view::npos;
+  };
+  const auto pass =
+      (r1.status.status == -5) &&
+      has(r1.status, "the execution policy is not the one of the backend") &&
+      (r2.status.status == -5) &&
+      has(r2.status, "an asynchronous computation requires statistics") &&
+      (r3.status.status == 1) && r3.idle && (o3.status == r0.status.status) &&
+      (o3.number_of_failures == r0.status.number_of_failures) &&
+      (o3.first_failure_index == r0.status.first_failure_index) &&
+      (o3.number_of_unreliable_results ==
+       r0.status.number_of_unreliable_results) &&
+      (r3.values == r0.values);
+  std::printf(
+      "%-12s %-12s status=%2d/%2d/%2d, report %2d | idle %d, same values %d "
+      "| %s\n",
+      what, "policies", r1.status.status, r2.status.status, r3.status.status,
+      o3.status, static_cast<int>(r3.idle),
+      static_cast<int>(r3.values == r0.values), pass ? "OK" : "FAILED");
+  return pass;
+}  // end of checkExecutionPolicies
+
+/*!
+ * \return true if the integration treats the execution policies as
+ * documented (see `checkExecutionPolicies`)
+ * \param[in] t: test
+ * \param[in] fb: batch function
+ * \param[in] K0: type of computation
+ */
+static bool testExecutionPolicies(const Test& t,
+                                  BatchFunction fb,
+                                  const double K0) {
+  return checkExecutionPolicies(
+      t, "execution",
+      [&t, fb, K0](const mfront_gp_AbstractBackendExecutionPolicy* const p,
+                   mfront_gpb_Statistics* const s) {
+        auto st = t.initial;
+        auto b = BatchFields(st, t.sizes, t.options.finite_strain, t.n, t.dt,
+                             K0, Storage::by_point);
+        b.data.execution_policy = p;
+        b.data.statistics = s;
+        auto r = PolicyCall{};
+        fb(&r.status, &b.data);
+        r.idle = isQueueIdle();
+        synchronize();
+        b.copyResults(st);
+        r.values = st.th1;
+        r.values.insert(r.values.end(), st.isv1.begin(), st.isv1.end());
+        return r;
+      });
+}  // end of testExecutionPolicies
+
+/*!
+ * \return true if an invalid file of parameters is reported as invalid
+ * parameters (status `-6`) for the whole batch, nothing being computed.
+ * The file, written by the calling script, is read by the parameters
+ * initializers at the first call: this call must be the first one. The
+ * message must contain the text given by `--invalid-parameters-message`
+ * (`can't convert` by default).
+ * \param[in] t: test
+ */
+static bool testInvalidParameters(const Test& t) {
+  const auto fb = reinterpret_cast<BatchFunction>(
+      load(t.batch_library, t.function + "_generic_parallel"));
+  auto st = t.initial;
+  auto b = BatchFields(st, t.sizes, t.options.finite_strain, t.n, t.dt,
+                       t.options.tangent_operator, Storage::by_point);
+  auto o = mfront_gpb_OutputStatus{};
+  fb(&o, &b.data);
+  synchronize();
+  b.copyResults(st);
+  const auto unchanged =
+      (st.th1 == t.initial.th1) && (st.isv1 == t.initial.isv1);
+  const auto pass =
+      (o.status == -6) && (o.number_of_failures == 0) && unchanged &&
+      (std::string_view{o.msg}.find(t.options.invalid_parameters_message) !=
+       std::string_view::npos);
+  std::printf("%-12s %-12s status=%2d | %s | %s\n", "invalid", "parameters",
+              o.status, o.msg, pass ? "OK" : "FAILED");
+  return pass;
+}
+
+/*!
+ * \brief compare two time steps integrated by both interfaces, for all
+ * types of computation and storages of the fields
+ */
+static bool testIntegration(const Test& t) {
+  const auto fg =
+      reinterpret_cast<GenericFunction>(load(t.generic_library, t.function));
+  const auto fb = reinterpret_cast<BatchFunction>(
+      load(t.batch_library, t.function + "_generic_parallel"));
+  const auto report = loadReportFunction(t);
+  const auto& s = t.sizes;
+  const auto& fs = t.options.finite_strain;
+  const auto n = t.n;
+  // the speed of sound is requested by an offset of the type of computation
+  const auto speed_of_sound = t.initial.mass_density > 0;
+  const auto o0 = speed_of_sound ? 100. : 0.;
+  const auto Kt = t.options.tangent_operator;
+  // execution policy of the asynchronous steps
+  const auto asynchronous =
+      makeExecutionPolicy(t.execution_policy, {.asynchronous = true});
+  auto ok = testEmptyBatch(fb, fs, Kt + o0);
+  ok = testReportFunction(t) && ok;
+  if (fs.finite_strain) {
+    ok = testInvalidComputationOptions(t, fb, Kt + o0) && ok;
+  }
+  for (const auto K0 : {Kt, -1., 0.}) {
+    // models have no tangent operator: with a prediction, they are executed
+    // and update the state, as with the `generic` interface
+    for (const auto storage : storages) {
+      // first step from the initial state, second step from its results
+      auto ref = t.initial;
+      auto batch = t.initial;
+      auto ms1 = 0., ms2 = 0.;
+      integrateReference(ref, s, fs, n, t.dt, Kt + o0, fg);
+      const auto o1 = integrateBatch(batch, s, fs, n, t.dt, Kt + o0, storage,
+                                     fb, nullptr, ms1);
+      // the test is meaningless if the integration fails at all points
+      const auto pass1 = (ref.status == batch.status) &&
+                         isConsistent(o1, batch.status) &&
+                         (o1.number_of_failures != n);
+      for (auto* const st : {&ref, &batch}) {
+        st->g0 = st->g1;
+        st->th0 = st->th1;
+        st->isv0 = st->isv1;
+        st->stored_energy0 = st->stored_energy1;
+        st->dissipated_energy0 = st->dissipated_energy1;
+        // the perturbation of the gradients is increased by 50%
+        for (std::size_t i = 0; i != n; ++i) {
+          for (std::size_t j = 0; j != s.g; ++j) {
+            auto& g = st->g1[i * s.g + j];
+            g = t.identity[j] + 1.5 * (g - t.identity[j]);
+          }
+        }
+      }
+      integrateReference(ref, s, fs, n, t.dt, K0 + o0, fg);
+      const auto o2 = integrateBatch(batch, s, fs, n, t.dt, K0 + o0, storage,
+                                     fb, report, ms2, asynchronous.get());
+      const auto nfailures =
+          std::count(ref.status.begin(), ref.status.end(), -1);
+      const auto dth = relativeDifference(ref.th1, batch.th1, ref.status, s.th);
+      const auto disv =
+          relativeDifference(ref.isv1, batch.isv1, ref.status, s.isv);
+      // the tangent operator is not computed if K0 is in [-0.25, 0.5]
+      const auto tangent = (K0 < -0.25) || (K0 > 0.5);
+      const auto dK =
+          tangent ? relativeDifference(ref.K, batch.K, ref.status, s.K) : 0.;
+      // energies (null if the behaviour does not compute them) and speed
+      // of sound
+      const auto de =
+          std::max(relativeDifference(ref.stored_energy1, batch.stored_energy1,
+                                      ref.status, 1),
+                   relativeDifference(ref.dissipated_energy1,
+                                      batch.dissipated_energy1, ref.status, 1));
+      const auto dsos =
+          speed_of_sound
+              ? relativeDifference(ref.speed_of_sound, batch.speed_of_sound,
+                                   ref.status, 1)
+              : 0.;
+      // the comparison of the energies and of the speed of sound is
+      // meaningless if they are not computed
+      auto computed = [&ref](const std::vector<double>& v) {
+        for (std::size_t i = 0; i != v.size(); ++i) {
+          if ((ref.status[i] != -1) && (v[i] != 0)) {
+            return true;
+          }
+        }
+        return false;
+      };
+      // the energies and the speed of sound are only computed after an
+      // integration
+      const auto integration = K0 > -0.25;
+      const auto energies_computed =
+          (!integration) || (!t.options.energies) ||
+          (computed(ref.stored_energy1) && computed(ref.dissipated_energy1));
+      const auto speed_of_sound_computed =
+          (!integration) || (!speed_of_sound) || computed(ref.speed_of_sound);
+      const auto same_status = ref.status == batch.status;
+      const auto pass = pass1 && same_status && energies_computed &&
+                        speed_of_sound_computed &&
+                        isConsistent(o2, batch.status) && (dth < tolerance) &&
+                        (disv < tolerance) && (dK < tolerance) &&
+                        (de < tolerance) && (dsos < tolerance);
+      ok = ok && pass;
+      std::printf(
+          "K0=%4.1f %-12s status=%2d/%2d failures=%6ld same statuses=%d | "
+          "relative differences: forces %.1e, isvs %.1e, K %.1e, energies "
+          "%.1e, speed of sound %.1e | %.2f ms, %.2f ms | %s\n",
+          K0, toString(storage), o1.status, o2.status,
+          static_cast<long>(nfailures), same_status, dth, disv, dK, de, dsos,
+          ms1, ms2, pass ? "OK" : "FAILED");
+    }
+  }
+  if (t.options.other_device) {
+    ok = testOtherDevice(t, fg, fb, Kt + o0) && ok;
+  }
+  ok = testExecutionPolicies(t, fb, Kt + o0) && ok;
+#if defined(MFRONT_GPB_COMPARE_USE_SYCL)
+  ok = testSYCLQueues(t, fg, fb, Kt + o0) && ok;
+#endif /* defined(MFRONT_GPB_COMPARE_USE_SYCL) */
+#if defined(MFRONT_GPB_COMPARE_USE_ARCANE)
+  ok = testArcaneQueues(t, fg, fb, Kt + o0) && ok;
+#endif /* defined(MFRONT_GPB_COMPARE_USE_ARCANE) */
+#if defined(GPU_API)
+  // the stack size of the threads of the device only concerns the libraries
+  // computing on the device, not those computing on the host compiled by a
+  // GPU compiler (`config-raja-host.json` with a RAJA built with CUDA, or
+  // the `Thread` and `Sequential` queues of Arcane)
+  if ((getMemorySpace(t.batch_library, t.name) == "device") &&
+      computesOnGPU()) {
+    ok = testPreserveStackSize(t, fb, Kt + o0) && ok;
+  }
+#endif /* defined(GPU_API) */
+  return ok;
+}  // end of testIntegration
+
+/*!
+ * \brief the functions of the `generic` interface executing an initialize
+ * function or a post-processing return 0 on success, whereas the functions
+ * of the `generic-parallel` interface report the same statuses as the
+ * integration (1 on success).
+ */
+static void convertReferenceStatuses(std::vector<int>& status) {
+  std::replace(status.begin(), status.end(), 0, 1);
+}
+
+/*!
+ * \brief compare the execution of an initialize function by both
+ * interfaces, for both storages of the fields
+ */
+static bool testInitializeFunction(const Test& t) {
+  using GenericInitializeFunction =
+      int (*)(mfront_gb_BehaviourData*, const mfront_gb_real*);
+  using BatchInitializeFunction =
+      int (*)(mfront_gpb_OutputStatus*, const mfront_gpb_BatchData*,
+              const mfront_gpb_ConstField*);
+  const auto fg = reinterpret_cast<GenericInitializeFunction>(
+      load(t.generic_library, t.function));
+  const auto fb = reinterpret_cast<BatchInitializeFunction>(
+      load(t.batch_library, t.function + "_generic_parallel"));
+  const auto& s = t.sizes;
+  const auto ni = t.number_of_values;
+  auto rng = std::mt19937{1};
+  auto u = std::uniform_real_distribution<double>{-1e8, 1e8};
+  auto inputs = std::vector<double>(t.n * ni);
+  std::generate(inputs.begin(), inputs.end(), [&] { return u(rng); });
+  auto ok = true;
+  for (const auto storage : storages) {
+    auto ref = t.initial;
+    auto batch = t.initial;
+    forEachReferencePoint(
+        ref, s, t.options.finite_strain, t.n, t.dt, 0,
+        [fg, &inputs, ni](mfront_gb_BehaviourData& d, const std::size_t i) {
+          return fg(&d, ni == 0 ? nullptr : inputs.data() + i * ni);
+        });
+    convertReferenceStatuses(ref.status);
+    auto ms = 0.;
+    const auto b =
+        BatchFields(batch, s, t.options.finite_strain, t.n, t.dt, 0, storage);
+    const auto in = BatchField(inputs, t.n, ni, b.by_component);
+    const auto in_field = in.const_field();
+    const auto o = measure(ms, [&](mfront_gpb_OutputStatus& r) {
+      // no field is given if the function has no input
+      fb(&r, &b.data, ni == 0 ? nullptr : &in_field);
+    });
+    b.copyResults(batch);
+    const auto d =
+        std::max(relativeDifference(ref.th1, batch.th1, ref.status, s.th),
+                 relativeDifference(ref.isv1, batch.isv1, ref.status, s.isv));
+    // the test is meaningless if the initialize function changes nothing
+    const auto changed =
+        (ref.th1 != t.initial.th1) || (ref.isv1 != t.initial.isv1);
+    const auto pass = changed && (ref.status == batch.status) &&
+                      isConsistent(o, batch.status) && (d < tolerance);
+    ok = print("initialize", storage, pass, o, batch.status, d, ms) && ok;
+  }
+  ok = checkExecutionPolicies(
+           t, "initialize",
+           [&t, fb, &inputs, ni](
+               const mfront_gp_AbstractBackendExecutionPolicy* const p,
+               mfront_gpb_Statistics* const statistics) {
+             auto st = t.initial;
+             auto b = BatchFields(st, t.sizes, t.options.finite_strain, t.n,
+                                  t.dt, 0, Storage::by_point);
+             b.data.execution_policy = p;
+             b.data.statistics = statistics;
+             const auto in = BatchField(inputs, t.n, ni, b.by_component);
+             const auto in_field = in.const_field();
+             auto r = PolicyCall{};
+             fb(&r.status, &b.data, ni == 0 ? nullptr : &in_field);
+             r.idle = isQueueIdle();
+             synchronize();
+             b.copyResults(st);
+             r.values = st.th1;
+             r.values.insert(r.values.end(), st.isv1.begin(), st.isv1.end());
+             return r;
+           }) &&
+       ok;
+  return ok;
+}  // end of testInitializeFunction
+
+/*!
+ * \brief compare the execution of a post-processing by both interfaces, for
+ * both storages of the fields
+ */
+static bool testPostProcessing(const Test& t) {
+  using GenericPostProcessing =
+      int (*)(mfront_gb_real*, mfront_gb_BehaviourData*);
+  using BatchPostProcessing =
+      int (*)(mfront_gpb_OutputStatus*, const mfront_gpb_Field*,
+              const mfront_gpb_BatchData*);
+  const auto fg = reinterpret_cast<GenericPostProcessing>(
+      load(t.generic_library, t.function));
+  const auto fb = reinterpret_cast<BatchPostProcessing>(
+      load(t.batch_library, t.function + "_generic_parallel"));
+  const auto& s = t.sizes;
+  const auto no = t.number_of_values;
+  auto ok = true;
+  for (const auto storage : storages) {
+    auto ref = t.initial;
+    auto batch = t.initial;
+    auto ref_outputs = std::vector<double>(t.n * no);
+    forEachReferencePoint(ref, s, t.options.finite_strain, t.n, t.dt, 0,
+                          [fg, &ref_outputs, no](mfront_gb_BehaviourData& d,
+                                                 const std::size_t i) {
+                            return fg(ref_outputs.data() + i * no, &d);
+                          });
+    convertReferenceStatuses(ref.status);
+    auto ms = 0.;
+    const auto b =
+        BatchFields(batch, s, t.options.finite_strain, t.n, t.dt, 0, storage);
+    const auto out =
+        BatchField(std::vector<double>(t.n * no), t.n, no, b.by_component);
+    const auto out_field = out.field();
+    const auto o = measure(
+        ms, [&](mfront_gpb_OutputStatus& r) { fb(&r, &out_field, &b.data); });
+    b.copyResults(batch);
+    auto batch_outputs = std::vector<double>(t.n * no);
+    out.copy(batch_outputs);
+    const auto d =
+        relativeDifference(ref_outputs, batch_outputs, ref.status, no);
+    // the test is meaningless if all the outputs are null
+    const auto computed = std::any_of(ref_outputs.begin(), ref_outputs.end(),
+                                      [](const double v) { return v != 0; });
+    const auto pass = computed && (ref.status == batch.status) &&
+                      isConsistent(o, batch.status) && (d < tolerance);
+    ok = print("post-processing", storage, pass, o, batch.status, d, ms) && ok;
+  }
+  ok = checkExecutionPolicies(
+           t, "post-proc.",
+           [&t, fb, no](const mfront_gp_AbstractBackendExecutionPolicy* const p,
+                        mfront_gpb_Statistics* const statistics) {
+             auto st = t.initial;
+             auto b = BatchFields(st, t.sizes, t.options.finite_strain, t.n,
+                                  t.dt, 0, Storage::by_point);
+             b.data.execution_policy = p;
+             b.data.statistics = statistics;
+             const auto out = BatchField(std::vector<double>(t.n * no), t.n, no,
+                                         b.by_component);
+             const auto out_field = out.field();
+             auto r = PolicyCall{};
+             fb(&r.status, &out_field, &b.data);
+             r.idle = isQueueIdle();
+             synchronize();
+             r.values.resize(t.n * no);
+             out.copy(r.values);
+             return r;
+           }) &&
+       ok;
+  return ok;
+}  // end of testPostProcessing
+
+/*!
+ * \brief compare the rotation of the values of the points of a batch by both
+ * interfaces, for both storages of the fields, with a rotation matrix per
+ * point or a uniform rotation matrix
+ */
+static bool testRotation(const Test& t) {
+  using GenericRotation =
+      void (*)(mfront_gb_real*, const mfront_gb_real*, const mfront_gb_real*);
+  using BatchRotation =
+      int (*)(mfront_gpb_OutputStatus*, const mfront_gpb_RotationData*);
+  const auto fg =
+      reinterpret_cast<GenericRotation>(load(t.generic_library, t.function));
+  const auto fb = reinterpret_cast<BatchRotation>(
+      load(t.batch_library, t.function + "_generic_parallel"));
+  const auto n = t.n;
+  const auto ns = t.number_of_values;
+  auto rng = std::mt19937{3};
+  auto u = std::uniform_real_distribution<double>{-1, 1};
+  auto src = std::vector<double>(n * ns);
+  std::generate(src.begin(), src.end(), [&] { return u(rng); });
+  // rotation matrices, stored by rows: rotations around the z axis, then
+  // around the x axis, then around the z axis
+  auto rotations = std::vector<double>(9 * n);
+  for (std::size_t i = 0; i != n; ++i) {
+    const auto a = 3.14 * u(rng), b = 3.14 * u(rng), c = 3.14 * u(rng);
+    const auto ca = std::cos(a), sa = std::sin(a), cb = std::cos(b),
+               sb = std::sin(b), cc = std::cos(c), sc = std::sin(c);
+    const double r[9] = {ca * cc - sa * cb * sc,
+                         -ca * sc - sa * cb * cc,
+                         sa * sb,
+                         sa * cc + ca * cb * sc,
+                         -sa * sc + ca * cb * cc,
+                         -ca * sb,
+                         sb * sc,
+                         sb * cc,
+                         cb};
+    std::copy(r, r + 9, rotations.begin() + 9 * i);
+  }
+  auto ok = true;
+  for (const auto uniform : {false, true}) {
+    // reference: in place rotation at each point
+    auto ref = src;
+    for (std::size_t i = 0; i != n; ++i) {
+      const auto* const rv = rotations.data() + (uniform ? 0 : 9 * i);
+      fg(ref.data() + i * ns, ref.data() + i * ns, rv);
+    }
+    for (const auto by_component : {false, true}) {
+      const auto source = BatchField(src, n, ns, by_component);
+      const auto destination =
+          BatchField(std::vector<double>(n * ns), n, ns, by_component);
+      const auto matrices = BatchField(
+          uniform
+              ? std::vector<double>(rotations.begin(), rotations.begin() + 9)
+              : rotations,
+          uniform ? 1 : n, 9, false);
+      auto d = mfront_gpb_RotationData{};
+      d.number_of_points = n;
+      d.destination = destination.field();
+      d.source = source.const_field();
+      d.rotation_matrices = matrices.const_field();
+      if (uniform) {
+        d.rotation_matrices.point_stride = 0;
+      }
+      d.execution_policy = executionPolicy();
+      auto ms = 0.;
+      const auto o =
+          measure(ms, [&](mfront_gpb_OutputStatus& r) { fb(&r, &d); });
+      auto batch = std::vector<double>(n * ns);
+      destination.copy(batch);
+      const auto status = std::vector<int>(n, 1);
+      const auto diff = relativeDifference(ref, batch, status, ns);
+      // the test is meaningless if the rotation changes nothing
+      const auto rotated = ref != src;
+      const auto pass = rotated && (o.status == 1) && (diff < tolerance);
+      ok = pass && ok;
+      std::printf(
+          "rotation %-8s %-12s status=%2d | relative difference %.1e | %.2f "
+          "ms | %s\n",
+          uniform ? "uniform" : "by point",
+          by_component ? "by component" : "by point", o.status, diff, ms,
+          pass ? "OK" : "FAILED");
+    }
+  }
+  // execution policies (see checkExecutionPolicies)
+  ok = checkExecutionPolicies(
+           t, "rotation",
+           [&](const mfront_gp_AbstractBackendExecutionPolicy* const p,
+               mfront_gpb_Statistics* const statistics) {
+             const auto source = BatchField(src, n, ns, false);
+             const auto destination =
+                 BatchField(std::vector<double>(n * ns), n, ns, false);
+             const auto matrices = BatchField(rotations, n, 9, false);
+             auto d = mfront_gpb_RotationData{};
+             d.number_of_points = n;
+             d.destination = destination.field();
+             d.source = source.const_field();
+             d.rotation_matrices = matrices.const_field();
+             d.execution_policy = p;
+             d.statistics = statistics;
+             auto r = PolicyCall{};
+             fb(&r.status, &d);
+             r.idle = isQueueIdle();
+             synchronize();
+             r.values.resize(n * ns);
+             destination.copy(r.values);
+             return r;
+           }) &&
+       ok;
+  // asynchronous rotation: the rotations never lower the time step scaling
+  // factor, so that the statistics are not modified on all the backends,
+  // even if their time step scaling factor is greater than one
+  {
+    const auto asynchronous =
+        makeExecutionPolicy(t.execution_policy, {.asynchronous = true});
+    const auto source = BatchField(src, n, ns, false);
+    const auto destination =
+        BatchField(std::vector<double>(n * ns), n, ns, false);
+    const auto matrices = BatchField(rotations, n, 9, false);
+    auto* const statistics = allocate<mfront_gpb_Statistics>(1);
+    mfront_gpb_initializeStatistics(statistics, 2);
+    auto d = mfront_gpb_RotationData{};
+    d.number_of_points = n;
+    d.destination = destination.field();
+    d.source = source.const_field();
+    d.rotation_matrices = matrices.const_field();
+    d.execution_policy = asynchronous.get();
+    d.statistics = statistics;
+    auto o = mfront_gpb_OutputStatus{};
+    fb(&o, &d);
+    synchronize();
+    const auto rdt = mfront_gpb_getTimeStepScalingFactor(statistics);
+    // the report function analyses the statistics as for an integration
+    auto o2 = mfront_gpb_OutputStatus{};
+    loadReportFunction(t)(&o2, statistics);
+    const auto pass = (o.status == 1) &&
+                      (statistics->number_of_failures == 0) &&
+                      (statistics->number_of_unreliable_results == 0) &&
+                      (rdt == 2) && (o2.status == 1) && (o2.rdt == 2);
+    deallocate(statistics, 1);
+    ok = pass && ok;
+    std::printf("rotation with statistics: status=%2d | rdt %g | %s\n",
+                o.status, rdt, pass ? "OK" : "FAILED");
+  }
+  return ok;
+}  // end of testRotation
+
+/*!
+ * \return the function tested and the number of values of its inputs or
+ * outputs (inputs of an initialize function, outputs of a post-processing,
+ * rotated values), deduced from its name and from the symbols exported by
+ * the library generated by the `generic` interface
+ * \param[in] lib: library generated by the `generic` interface
+ * \param[in] f: tested function
+ * \param[in] fs: finite strain options
+ */
+static std::pair<Mode, std::size_t> getMode(const std::string& lib,
+                                            const FunctionName& f,
+                                            const FiniteStrainOptions& fs) {
+  const auto& e = f.suffix;
+  if (e.empty()) {
+    return {Mode::INTEGRATION, 0};
+  }
+  if (e.starts_with("InitializeFunction_")) {
+    return {Mode::INITIALIZE_FUNCTION,
+            getSize(getVariables(lib, f, e + "_Inputs"))};
+  }
+  if (e.starts_with("PostProcessing_")) {
+    return {Mode::POST_PROCESSING,
+            getSize(getVariables(lib, f, e + "_Outputs"))};
+  }
+  // rotation functions: the stress measure or the tangent operator of
+  // finite strain behaviours is given by the end of the name
+  auto o = fs;
+  const auto p = e.find('_');
+  const auto kind = e.substr(0, p);
+  const auto variant = p == std::string::npos ? "" : e.substr(p + 1);
+  const auto stress_measures =
+      std::array<std::string, 3>{"CauchyStress", "PK2Stress", "PK1Stress"};
+  const auto tangent_operators =
+      std::array<std::string, 4>{"dsig_dF", "dPK2_dEGL", "dPK1_dF", "dtau_ddF"};
+  for (std::size_t i = 0; i != stress_measures.size(); ++i) {
+    if (variant == stress_measures[i]) {
+      o.stress_measure = static_cast<double>(i);
+    }
+  }
+  for (std::size_t i = 0; i != tangent_operators.size(); ++i) {
+    if (variant == tangent_operators[i]) {
+      o.tangent_operator = static_cast<double>(i);
+    }
+  }
+  const auto s = readSizes(lib, f, o);
+  if (kind == "rotateGradients") {
+    return {Mode::ROTATION, s.g};
+  } else if (kind == "rotateThermodynamicForces") {
+    return {Mode::ROTATION, s.th};
+  } else if (kind == "rotateTangentOperatorBlocks") {
+    return {Mode::ROTATION, s.K};
+  }
+  fail("unsupported function '" + e + "'");
+}
+
+int main(const int argc, const char* const* const argv) {
+  if (argc < 4) {
+    fail(std::string{"usage: "} + argv[0] +
+         " generic_library batch_library function "
+         "[--material-properties=values] [--amplitude=value] "
+         "[--temperature=value] [--external-state-variables=values] "
+         "[--time-increment=value] "
+         "[--finite-strain=stress_measure,tangent_operator] "
+         "[--initial-internal-state-variables=values] "
+         "[--speed-of-sound=mass_density] [--energies=true] "
+         "[--other-device=true] [--invalid-parameters=true] "
+         "[--invalid-parameters-message=text] "
+         "[--generic-functions=true] [--time-step-scaling-factor=value] "
+         "[--tangent-operator=type] "
+         "[--perturbation-of-internal-state-variables=amplitude] "
+         "[--out-of-bounds-policy=policy] "
+         "[--parameters=name=value,...]");
+  }
+  [[maybe_unused]] const auto runtime = Runtime{};
+  const auto name = parseFunctionName(argv[3]);
+  checkVersion(argv[2], name);
+  const auto options = parseOptions(argc, argv, 4);
+  const auto s = readSizes(argv[1], name, options.finite_strain);
+  const auto [mode, number_of_values] =
+      getMode(argv[1], name, options.finite_strain);
+  // the rotations do not use the material properties
+  const auto mp_values = mode == Mode::ROTATION ? std::vector<double>(s.mp, 0)
+                                                : options.material_properties;
+  const auto amplitude = options.amplitude;
+  const auto T = options.temperature;
+  if (mp_values.size() != s.mp) {
+    fail("invalid number of material properties (" + std::to_string(s.mp) +
+         " expected)");
+  }
+  // not a multiple of the number of threads per block. The number of points
+  // can be changed by the `MFRONT_GPB_COMPARE_NUMBER_OF_POINTS` environment
+  // variable (for debugging).
+  const auto* const np = std::getenv("MFRONT_GPB_COMPARE_NUMBER_OF_POINTS");
+  const std::size_t n = np == nullptr ? 100003 : std::stoul(np);
+  auto t = Test{.generic_library = argv[1],
+                .batch_library = argv[2],
+                .function = argv[3],
+                .execution_policy = getExecutionPolicyIdentifier(argv[2], name),
+                .name = name,
+                .sizes = s,
+                .options = options,
+                .mode = mode,
+                .number_of_values = number_of_values,
+                .initial = States(n, s),
+                .identity = std::vector<double>(s.g, 0),
+                .n = n,
+                .dt = options.time_increment};
+  // the identity, for the deformation gradients of finite strain behaviours
+  if (t.options.finite_strain.finite_strain) {
+    // the first three components of a tensor are its diagonal components
+    for (std::size_t j = 0; j != std::min<std::size_t>(3, s.g); ++j) {
+      t.identity[j] = 1;
+    }
+  }
+  auto rng = std::mt19937{42};
+  auto u = std::uniform_real_distribution<double>{-1, 1};
+  auto& initial = t.initial;
+  for (std::size_t i = 0; i != n; ++i) {
+    for (std::size_t j = 0; j != s.g; ++j) {
+      initial.g0[i * s.g + j] = t.identity[j];
+      initial.g1[i * s.g + j] = t.identity[j] + amplitude * u(rng);
+    }
+    for (std::size_t j = 0; j != s.mp; ++j) {
+      initial.mp[i * s.mp + j] = mp_values[j];
+    }
+    // the temperature is the first external state variable
+    const auto& esvs = t.options.external_state_variables;
+    for (std::size_t j = 0; j != s.esv; ++j) {
+      initial.esv0[i * s.esv + j] = initial.esv1[i * s.esv + j] =
+          ((j == 0) || (j > esvs.size())) ? T : esvs[j - 1];
+    }
+  }
+  initial.mass_density = t.options.mass_density;
+  const auto& isvs = t.options.initial_internal_state_variables;
+  if ((isvs.size() != 1) && (isvs.size() != s.isv)) {
+    fail("invalid number of initial values of the internal state variables");
+  }
+  const auto isv_perturbation = t.options.internal_state_variables_perturbation;
+  for (std::size_t i = 0; i != n; ++i) {
+    for (std::size_t j = 0; j != s.isv; ++j) {
+      initial.isv0[i * s.isv + j] = initial.isv1[i * s.isv + j] =
+          (isvs.size() == 1 ? isvs[0] : isvs[j]) + isv_perturbation * u(rng);
+    }
+  }
+  // out of bounds policy, set in both libraries
+  if (t.options.out_of_bounds_policy >= 0) {
+    using SetOutOfBoundsPolicy = void (*)(const int);
+    for (const auto& l : {t.generic_library, t.batch_library}) {
+      const auto f = reinterpret_cast<SetOutOfBoundsPolicy>(
+          load(l, t.name.behaviour + "_setOutOfBoundsPolicy"));
+      f(t.options.out_of_bounds_policy);
+    }
+  }
+  // parameters, changed in both libraries (the setter is specific to the
+  // modelling hypothesis if the behaviour does not support all of them)
+  using SetParameter = int (*)(const char* const, const double);
+  for (const auto& [pname, pvalue] : t.options.parameters) {
+    for (const auto& l : {t.generic_library, t.batch_library}) {
+      const auto f = reinterpret_cast<SetParameter>(
+          const_cast<void*>(findSymbol(l, t.name, "setParameter")));
+      if (f == nullptr) {
+        fail("no function changing the parameters in '" + l + "'");
+      }
+      if (f(pname.c_str(), pvalue) == 0) {
+        fail("can't set the parameter '" + pname + "'");
+      }
+    }
+  }
+  if (t.mode != Mode::INTEGRATION) {
+    // initialize functions and post-processings are executed on arbitrary
+    // states: stress-like thermodynamic forces and small positive internal
+    // state variables
+    for (auto* const v : {&initial.th0, &initial.th1}) {
+      std::generate(v->begin(), v->end(), [&] { return 1e8 * u(rng); });
+    }
+    for (auto* const v : {&initial.isv0, &initial.isv1}) {
+      std::generate(v->begin(), v->end(),
+                    [&] { return 1e-3 * (1 + u(rng)) / 2; });
+    }
+  }
+  const auto run = [](const Test& test) {
+    if (test.options.invalid_parameters) {
+      return testInvalidParameters(test);
+    }
+    switch (test.mode) {
+      case Mode::INITIALIZE_FUNCTION:
+        return testInitializeFunction(test);
+      case Mode::POST_PROCESSING:
+        return testPostProcessing(test);
+      case Mode::ROTATION:
+        return testRotation(test);
+      default:
+        return testIntegration(test);
+    }
+  };
+  auto ok = run(t);
+  if (t.options.generic_functions) {
+    // the library exports `Generic` as interface, as a library of the
+    // `generic` interface
+    const auto* const interface = static_cast<const char* const*>(
+        findSymbol(t.batch_library, t.name, "mfront_interface"));
+    const auto generic =
+        (interface != nullptr) && (std::string_view{*interface} == "Generic");
+    std::printf("interface of the batch library: %s | %s\n",
+                interface != nullptr ? *interface : "none",
+                generic ? "OK" : "FAILED");
+    // the functions of a point of the batch library are compared to its
+    // functions of batches of points, which have just been compared to the
+    // reference: the parameters and the out of bounds policy, changed above
+    // in the batch library, are shared by both kinds of functions
+    std::printf("functions of a point of the batch library:\n");
+    auto tp = t;
+    tp.generic_library = t.batch_library;
+    ok = generic && run(tp) && ok;
+  }
+  return ok ? EXIT_SUCCESS : EXIT_FAILURE;
+}
