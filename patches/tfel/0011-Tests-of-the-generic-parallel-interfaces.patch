diff --git a/test-suite/behaviours/generic-parallel/BehaviourVariableTest.mfront b/test-suite/behaviours/generic-parallel/BehaviourVariableTest.mfront
new file mode 100644
index 000000000..e367d0e0f
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/BehaviourVariableTest.mfront
@@ -0,0 +1,34 @@
+@DSL Default;
+@Behaviour BehaviourVariableTest;
+@Description {
+  "A behaviour testing behaviour variable factories: the integration is "
+  "delegated to a behaviour variable created by a factory."
+}
+
+@BehaviourVariableFactory f1 {
+  file: "BehaviourVariableTestPlasticity.mfront",
+  variables_suffix: "1",
+  external_names_prefix: "FirstPhase",
+  store_gradients: true,
+  store_thermodynamic_forces: true,
+  shared_external_state_variables: {".+"}
+};
+
+@ProvidesTangentOperator;
+@Integrator{
+  auto b1 = f1.make();
+  if (!initialize(b1)) {
+    return false;
+  }
+  b1.deto = deto;
+  const auto r = b1.integrate(smflag, smt);
+  if (!r) {
+    return false;
+  }
+  // updating the stress
+  sig = b1.sig;
+  if (computeTangentOperator_) {
+    Dt = b1.getTangentOperator();
+  }
+  updateAuxiliaryStateVariables(b1);
+}
diff --git a/test-suite/behaviours/generic-parallel/BehaviourVariableTestPlasticity.mfront b/test-suite/behaviours/generic-parallel/BehaviourVariableTestPlasticity.mfront
new file mode 100644
index 000000000..516fcb392
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/BehaviourVariableTestPlasticity.mfront
@@ -0,0 +1,22 @@
+@DSL IsotropicPlasticMisesFlow;
+@Behaviour BehaviourVariableTestPlasticity;
+@Description {
+  "Behaviour used by the BehaviourVariableTest behaviour. Its parameters "
+  "are not treated as static variables: they are read on the host, and "
+  "given to the device by the behaviour using this behaviour variable."
+}
+
+@UseQt true;
+@Epsilon 1e-14;
+
+@MaterialProperty stress H;
+@MaterialProperty stress s0;
+
+//! \brief factor applied to the hardening modulus (changed by the tests)
+@Parameter real hardening_factor = 1;
+
+@FlowRule {
+  f = seq - hardening_factor * H * p - s0;
+  df_dseq = 1;
+  df_dp = -hardening_factor * H;
+}
diff --git a/test-suite/behaviours/generic-parallel/CubicSplineHardeningTest.mfront b/test-suite/behaviours/generic-parallel/CubicSplineHardeningTest.mfront
