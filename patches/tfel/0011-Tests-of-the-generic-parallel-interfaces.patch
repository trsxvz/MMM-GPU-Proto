+@DSL DefaultGenericBehaviour;
+@Behaviour OrthotropicStationaryHeatTransfer;
+@Description {
+  "Stationary heat transfer with an orthotropic thermal conductivity. "
+  "This behaviour tests the rotation of vectors (temperature gradient and "
+  "heat flux) and of the derivative of a vector with respect to a vector."
+}
+
+@OrthotropicBehaviour;
+
+@Gradient TemperatureGradient gT;
+gT.setGlossaryName("TemperatureGradient");
+
+@Flux HeatFlux j;
+j.setGlossaryName("HeatFlux");
+
+//! \brief thermal conductivities along the material axes
+@MaterialProperty thermalconductivity k[3];
+
+@LocalVariable tmatrix<N, N, thermalconductivity> K;
+
+@InitLocalVariables {
+  K = tmatrix<N, N, thermalconductivity>(thermalconductivity(0));
+  for (unsigned short i = 0; i != N; ++i) {
+    K(i, i) = k[i];
+  }
+}
+
+@Integrator {
+  j = -K * (gT + dgT);
+}
+
+@TangentOperator {
+  dj_ddgT = -K;
+}
diff --git a/test-suite/behaviours/generic-parallel/OrthotropicTangentOperatorBlocksTest.mfront b/test-suite/behaviours/generic-parallel/OrthotropicTangentOperatorBlocksTest.mfront
new file mode 100644
index 000000000..be66431ca
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/OrthotropicTangentOperatorBlocksTest.mfront
@@ -0,0 +1,39 @@
+@DSL DefaultGenericBehaviour;
+@Behaviour OrthotropicTangentOperatorBlocksTest;
+@Description {
+  "An orthotropic behaviour whose tangent operator blocks are associated "
+  "with arrays of variables, and with vectors, symmetric tensors and "
+  "tensors: each thermodynamic force depends on all the gradients. This "
+  "behaviour tests the rotation of all the kinds of tangent operator "
+  "blocks."
+}
+
+@OrthotropicBehaviour;
+
+@Gradient TemperatureGradient g;
+@Flux HeatFlux j;
+@Gradient Stensor e[2];
+@Flux Stensor s[2];
+@Gradient Tensor f;
+@Flux Tensor t;
+
+@TangentOperatorBlocks{dj_ddg, dj_dde, dj_ddf, ds_ddg, ds_dde, ds_ddf,
+                       dt_ddg, dt_dde, dt_ddf};
+
+@Integrator {
+  // the thermodynamic forces are equal to the gradients
+  j = g + dg;
+  for (unsigned short i = 0; i != 2; ++i) {
+    s[i] = e[i] + de[i];
+  }
+  t = f + df;
+}
+
+@TangentOperator {
+  static_cast<void>(smt);  // discard the stiffness matrix type
+  std::fill(Dt.begin(), Dt.end(), real(0));
+  dj_ddg = tmatrix<N, N, real>::Id();
+  ds_dde(0, 0) = Stensor4::Id();
+  ds_dde(1, 1) = Stensor4::Id();
+  dt_ddf = t2tot2<N, real>::Id();
+}
diff --git a/test-suite/behaviours/generic-parallel/ParametersAsStaticVariablesTest.mfront b/test-suite/behaviours/generic-parallel/ParametersAsStaticVariablesTest.mfront
new file mode 100644
index 000000000..2aff28043
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/ParametersAsStaticVariablesTest.mfront
@@ -0,0 +1,63 @@
+@DSL Implicit{parameters_as_static_variables : true};
+@Behaviour ParametersAsStaticVariablesTest;
+@Description {
+  "Norton creep whose parameters are treated as static variables. The "
+  "parameters are bound to references (std::max), which is not allowed for "
+  "static data members in device code."
+}
+
+@Epsilon 1e-16;
+
+@MaterialProperty stress young;
+young.setGlossaryName("YoungModulus");
+@MaterialProperty real nu;
+nu.setGlossaryName("PoissonRatio");
+
+//! Norton coefficient
+@Parameter real A = 8e-67;
+//! Norton exponent
+@Parameter real E = 8.2;
+
+@StateVariable strain p;
+p.setGlossaryName("EquivalentViscoplasticStrain");
+
+@LocalVariable stress lambda;
+@LocalVariable stress mu;
+
+@InitLocalVariables {
+  lambda = computeLambda(young, nu);
+  mu = computeMu(young, nu);
+}
+
+@ComputeStress {
+  sig = lambda * trace(eel) * Stensor::Id() + 2 * mu * eel;
+}
+
+@Integrator {
+  const auto seq = sigmaeq(sig);
+  const auto iseq = 1 / std::max(seq, real(1e-12) * young);
+  const auto n = 3 * deviator(sig) * (iseq / 2);
+  const auto exponent = std::max(E, real(1));
+  const auto tmp = A * pow(seq, exponent - 1);
+  const auto df_dseq = exponent * tmp;
+  feel += dp * n - deto;
+  fp -= tmp * seq * dt;
+  // jacobian
+  dfeel_ddeel += 2 * mu * theta * dp * iseq * (Stensor4::M() - (n ^ n));
+  dfeel_ddp = n;
+  dfp_ddeel = -2 * mu * theta * df_dseq * dt * n;
+}
+
+@TangentOperator {
+  if ((smt == ELASTIC) || (smt == SECANTOPERATOR)) {
+    computeElasticStiffness<N, Type>::exe(Dt, lambda, mu);
+  } else if (smt == CONSISTENTTANGENTOPERATOR) {
+    StiffnessTensor De;
+    Stensor4 Je;
+    computeElasticStiffness<N, Type>::exe(De, lambda, mu);
+    getPartialJacobianInvert(Je);
+    Dt = De * Je;
+  } else {
+    return false;
+  }
+}
diff --git a/test-suite/behaviours/generic-parallel/PolyCrystalSharedDataTest.mfront b/test-suite/behaviours/generic-parallel/PolyCrystalSharedDataTest.mfront
new file mode 100644
index 000000000..14d722f1b
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/PolyCrystalSharedDataTest.mfront
@@ -0,0 +1,127 @@
+@DSL RungeKutta;
+@Algorithm rk54;
+@Behaviour PolyCrystalSharedDataTest;
+@Description {
+  "Berveiller-Zaoui polycrystal with four grains, whose orientations are "
+  "read in a file on the host. The slip systems of the grains are a data "
+  "shared by all the integration points (@SharedData), copied in the "
+  "memory of the device. The file is read relatively to the directory of "
+  "the configuration where the comparisons are run."
+}
+@OrthotropicBehaviour;
+@RequireStiffnessTensor;
+
+// Number of phases
+@IntegerConstant Np = 4;
+// Number of sliding systems
+@IntegerConstant Nss = 12;
+
+@Epsilon 1.e-12;
+
+@MaterialProperty real m;
+@MaterialProperty real K;
+@MaterialProperty real C;
+@MaterialProperty real R0;
+@MaterialProperty real Q;
+@MaterialProperty real b;
+@MaterialProperty real H;
+@MaterialProperty real d1;
+@MaterialProperty real Mu;
+@StateVariable StrainStensor epsp;
+@StateVariable StrainStensor epsg[Np];
+
+// one value per slip system and per grain
+@StateVariable strain g[Nss * Np];
+@StateVariable strain a[Nss * Np];
+@StateVariable strain p[Nss * Np];
+@StateVariable real pg;
+
+@Includes {
+#include "TFEL/Material/PolyCrystalsSlidingSystems.hxx"
+#include "TFEL/Material/MetallicCFCSlidingSystems.hxx"
+#include "TFEL/Material/MetallicCFCGenericSlidingSystemsInteractionMatrix.hxx"
+}
+
+@Members {
+  // Mono crystal  sliding system
+  typedef MetallicCFCSlidingSystems<real> MCSlidingSystems;
+  // Poly crystals sliding system
+  typedef PolyCrystalsSlidingSystems<Np, MCSlidingSystems, real>
+      PCSlidingSystems;
+  // Interaction matrix
+  typedef MetallicCFCGenericSlidingSystemsInteractionMatrix<real>
+      InteractionMatrix;
+}
+
+@SharedData PCSlidingSystems gs =
+    PCSlidingSystems::getPolyCrystalsSlidingSystems("../PolyCrystalsAngles-4.txt");
+
+//! fraction volumique
+@LocalVariable real fv[Np];
+//! interaction matrix
+@LocalVariable tfel::math::tmatrix<Nss, Nss, real> mh;
+
+@InitLocalVariables<Append> {
+  // fractions volumiques
+  for (unsigned short i = 0; i != Np; ++i) {
+    fv[i] = 1.0 / static_cast<real>(Np);
+  }
+  // matrice d'interaction
+  const real h1 = 1.;
+  const real h2 = 1.;
+  const real h3 = 1.;
+  const real h4 = 1.;
+  const real h5 = 1.;
+  const real h6 = 1.;
+  mh = InteractionMatrix::getInteractionMatrix(h1, h2, h3, h4, h5, h6);
+}
+
+@ComputeStress {
+  sig = D * eel;
+}
+
+@Derivative {
+  StressStensor sigg(stress(0));
+  depsp = Stensor(strainrate(0));
+  // boucle sur le nombre de phases (ou grains)
+  real pe[Nss];
+  for (unsigned short k = 0; k != Np; ++k) {
+    // localisation BZ
+    real seq = sigmaeq(sig);
+    if (seq > 0) {
+      real alph = 1. / (1.0 + 1.5 * Mu * pg / seq);
+      sigg = sig + Mu * alph * (epsp - epsg[k]);
+    }
+    for (unsigned short i = 0; i != Nss; ++i) {
+      pe[i] = Q * (1. - exp(-b * p[Nss * k + i]));
+    }
+    depsg[k] = Stensor(strainrate(0));
+    for (unsigned short i = 0; i != Nss; ++i) {
+      real Rp = R0;
+      for (unsigned short j = 0; j != Nss; ++j) {
+        Rp += mh(i, j) * pe[j];
+      }
+      // tenseurs mus de chaque grain / systeme dans le repere global
+      StrainStensor mu_ki(gs.mus[k][i].begin());
+      real tau = mu_ki | sigg;
+      real tma = tau - C * a[Nss * k + i];
+      real tmR = abs(tma) - Rp;
+      if (tmR > 1.e5) {
+        return false;
+      }
+      if (tmR > 0.) {
+        real sgn = tma / abs(tma);
+        dg[Nss * k + i] = sgn * pow((tmR / K), m);
+      } else {
+        dg[Nss * k + i] = 0.;
+      }
+      dp[Nss * k + i] = abs(dg[Nss * k + i]);
+      da[Nss * k + i] =
+          dg[Nss * k + i] - d1 * a[Nss * k + i] * abs(dg[Nss * k + i]);
+      depsg[k] += dg[Nss * k + i] * mu_ki;
+    }
+    depsp += depsg[k] * fv[k];
+  }
+  dpg = sqrt((2 * (depsp | depsp)) / 3);
+  deel = -depsp + deto;
+}
