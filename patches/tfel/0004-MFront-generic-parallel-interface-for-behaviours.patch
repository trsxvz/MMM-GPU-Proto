@@ -0,0 +1,150 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/ParallelSTL.hxx
+ * \brief  This file implements the integration of a batch of integration
+ * points with the parallel algorithms of the C++ standard library.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_PARALLELSTL_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_PARALLELSTL_HXX
+
+#include <compare>
+#include <cstddef>
+#include <iterator>
+#include <numeric>
+#include <execution>
+#include "MFront/GenericParallelBehaviour/Integrate.hxx"
+
+namespace mfront::gpb::stlpar {
+
+  /*!
+   * \brief a random access iterator over the indices of the integration
+   * points.
+   *
+   * `std::views::iota` can't be used: the category of its iterators is not
+   * `std::random_access_iterator_tag`, and some implementations of the
+   * parallel algorithms (libstdc++) then run sequentially.
+   */
+  struct CountingIterator {
+    using iterator_category = std::random_access_iterator_tag;
+    using value_type = size_type;
+    using difference_type = std::ptrdiff_t;
+    using pointer = void;
+    using reference = size_type;
+    constexpr reference operator*() const noexcept { return this->i; }
+    constexpr reference operator[](const difference_type n) const noexcept {
+      return this->i + n;
+    }
+    constexpr CountingIterator& operator++() noexcept {
+      ++(this->i);
+      return *this;
+    }
+    constexpr CountingIterator operator++(int) noexcept {
+      auto r = *this;
+      ++(this->i);
+      return r;
+    }
+    constexpr CountingIterator& operator--() noexcept {
+      --(this->i);
+      return *this;
+    }
+    constexpr CountingIterator operator--(int) noexcept {
+      auto r = *this;
+      --(this->i);
+      return r;
+    }
+    constexpr CountingIterator& operator+=(const difference_type n) noexcept {
+      this->i += n;
+      return *this;
+    }
+    constexpr CountingIterator& operator-=(const difference_type n) noexcept {
+      this->i -= n;
+      return *this;
+    }
+    friend constexpr CountingIterator operator+(
+        const CountingIterator a, const difference_type n) noexcept {
+      return {a.i + n};
+    }
+    friend constexpr CountingIterator operator+(
+        const difference_type n, const CountingIterator a) noexcept {
+      return {a.i + n};
+    }
+    friend constexpr CountingIterator operator-(
+        const CountingIterator a, const difference_type n) noexcept {
+      return {a.i - n};
+    }
+    friend constexpr difference_type operator-(
+        const CountingIterator a, const CountingIterator b) noexcept {
+      return static_cast<difference_type>(a.i) -
+             static_cast<difference_type>(b.i);
+    }
+    friend constexpr auto operator<=>(const CountingIterator&,
+                                      const CountingIterator&) = default;
+    //! \brief current index
+    size_type i;
+  };
+
+  static_assert(std::random_access_iterator<CountingIterator>);
+
+  /*!
+   * \brief integrate the behaviour at the points of a batch.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam Sizes: sizes of the data of an integration point
+   * \tparam ParametersType: type of the structure holding the parameters
+   * \tparam ExecutionPolicy: execution policy
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   * \param[in] policy: execution policy
+   * \return the status
+   */
+  template <typename Behaviour,
+            typename Sizes,
+            typename ParametersType,
+            typename ExecutionPolicy>
+  int integrate(OutputStatus& s,
+                const BatchData& d,
+                const ParametersType& parameters,
+                const tfel::material::OutOfBoundsPolicy p,
+                ExecutionPolicy&& policy) {
+    if (!check<Sizes>(s, d)) {
+      return s.status;
+    }
+    const auto first = CountingIterator{0};
+    const auto last = CountingIterator{d.number_of_points};
+    const auto initial_statistics = BatchStatistics{.rdt = d.rdt};
+    auto reduce = [](const BatchStatistics& a, const BatchStatistics& b) {
+      return combine(a, b);
+    };
+    const auto r = [&] {
+      if (areAllFieldsStoredPointByPoint<Sizes>(d)) {
+        return std::transform_reduce(
+            policy, first, last, initial_statistics, reduce,
+            [d, parameters, p](const size_type i) {
+              return BatchStatistics::from(
+                  mfront::gpb::integrate<Behaviour, Sizes, true>(
+                      d, i, parameters, p));
+            });
+      }
+      return std::transform_reduce(
+          policy, first, last, initial_statistics, reduce,
+          [d, parameters, p](const size_type i) {
+            return BatchStatistics::from(
+                mfront::gpb::integrate<Behaviour, Sizes, false>(d, i,
+                                                                parameters, p));
+          });
+    }();
+    return report(s, r);
+  }  // end of integrate
+
+}  // end of namespace mfront::gpb::stlpar
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_PARALLELSTL_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviourInterface.hxx b/mfront/include/MFront/GenericParallelBehaviourInterface.hxx
new file mode 100644
index 000000000..0ff1a035d
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviourInterface.hxx
@@ -0,0 +1,100 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviourInterface.hxx
+ * \brief  This file declares the `generic-parallel` behaviour interface
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX
+
+#include <memory>
+#include "MFront/GenericBehaviourInterface.hxx"
+
+namespace mfront {
+
+  namespace generic_parallel::behaviour {
+    // forward declaration
+    struct AbstractBackend;
+  }  // end of namespace generic_parallel::behaviour
+
+  /*!
+   * \brief an interface integrating a behaviour over a batch of integration
+   * points on GPUs (CUDA, HIP) or CPUs (parallel algorithms of the C++
+   * standard library).
+   *
+   * Integrating a batch is equivalent to calling the function generated by
+   * the `generic` interface at each integration point. This interface reuses
+   * the members added by the `generic` interface to the behaviour class and
+   * adds a constructor taking the values of the parameters as an argument,
+   * since the parameters initializers can't be accessed from device code.
+   */
+  struct MFRONT_VISIBILITY_EXPORT GenericParallelBehaviourInterface
+      : public GenericBehaviourInterface {
+    //! \return the interface name
+    [[nodiscard]] static std::string getName();
+    //! \brief default constructor
+    GenericParallelBehaviourInterface();
+    //
+    [[nodiscard]] std::string getInterfaceName() const override;
+    void setOptions(const DataMap&) override;
+    [[nodiscard]] std::pair<bool, tokens_iterator> treatKeyword(
+        BehaviourDescription&,
+        const std::string&,
+        const std::vector<std::string>&,
+        tokens_iterator,
+        const tokens_iterator) override;
+    [[nodiscard]] std::string getParametersSourceInBehaviourConstructor(
+        const BehaviourDescription&, const Hypothesis) const override;
+    [[nodiscard]] bool areDynamicallyAllocatedVectorsAllowed() const override;
+    void endTreatment(const BehaviourDescription&,
+                      const FileDescription&) const override;
+    void getTargetsDescription(TargetsDescription&,
+                               const BehaviourDescription&) override;
+    [[nodiscard]] std::string getLibraryName(
+        const BehaviourDescription&) const override;
+    //! \brief destructor
+    ~GenericParallelBehaviourInterface() override;
+
+   protected:
+    [[nodiscard]] std::string getBehaviourConstructorTemplateDeclaration()
+        const override;
+    [[nodiscard]] std::string getBehaviourConstructorArguments() const override;
+    /*!
+     * \return the name of the generated header file
+     * \param[in] name: name of the behaviour, including the library
+     */
+    [[nodiscard]] virtual std::string getHeaderFileName(
+        const std::string&) const;
+    /*!
+     * \return the name of the generated source file
+     * \param[in] name: name of the behaviour, including the library
+     */
+    [[nodiscard]] virtual std::string getSourceFileName(
+        const std::string&) const;
+    /*!
+     * \brief write the header file
+     * \param[in] bd: behaviour description
+     * \param[in] fd: file description
+     */
+    virtual void writeHeaderFile(const BehaviourDescription&,
+                                 const FileDescription&) const;
+    /*!
+     * \brief write the source file
+     * \param[in] bd: behaviour description
+     * \param[in] fd: file description
+     */
+    virtual void writeSourceFile(const BehaviourDescription&,
+                                 const FileDescription&) const;
+    //! \brief backend
+    std::unique_ptr<generic_parallel::behaviour::AbstractBackend> backend;
+  };  // end of struct GenericParallelBehaviourInterface
+
+}  // end of namespace mfront
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX */
