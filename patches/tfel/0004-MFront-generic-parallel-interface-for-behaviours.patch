+/*!
+ * \file mfront/include/MFront/GenericParallel/Behaviour/ParallelSTLBackend.hxx
+ * \brief  This file declares the backend of the `generic-parallel` behaviour
+ * interface based on the parallel algorithms of the C++ standard library
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_BEHAVIOUR_PARALLELSTLBACKEND_HXX
+#define LIB_MFRONT_GENERICPARALLEL_BEHAVIOUR_PARALLELSTLBACKEND_HXX
+
+#include "TFEL/Utilities/Data.hxx"
+#include "MFront/MFrontConfig.hxx"
+#include "MFront/GenericParallel/Behaviour/AbstractBackend.hxx"
+
+namespace mfront::generic_parallel::behaviour {
+
+  /*!
+   * \brief backend based on the parallel algorithms of the C++ standard
+   * library.
+   *
+   * Options:
+   *
+   * - `execution_policy`: `sequenced_policy` (or `seq`),
+   *   `unsequenced_policy` (or `unseq`), `parallel_policy` (or `par`) or
+   *   `parallel_unsequenced_policy` (or `par_unseq`, default).
+   */
+  struct MFRONT_VISIBILITY_EXPORT ParallelSTLBackend final : AbstractBackend {
+    //! \brief default constructor
+    ParallelSTLBackend();
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    ParallelSTLBackend(const tfel::utilities::DataMap&);
+    //
+    [[nodiscard]] std::string getName() const override;
+    [[nodiscard]] std::string getSourceFileExtension() const override;
+    void writeSpecificIncludes(std::ostream&) const override;
+    void writeIntegrationCall(std::ostream&) const override;
+    //! \brief destructor
+    ~ParallelSTLBackend() noexcept override;
+
+   private:
+    //! \brief execution policy
+    std::string execution_policy = "std::execution::par_unseq";
+  };  // end of ParallelSTLBackend
+
+}  // end of namespace mfront::generic_parallel::behaviour
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_BEHAVIOUR_PARALLELSTLBACKEND_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/BatchData.h b/mfront/include/MFront/GenericParallelBehaviour/BatchData.h
new file mode 100644
index 000000000..8137a68fc
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/BatchData.h
@@ -0,0 +1,188 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/BatchData.h
+ * \brief  This file declares the data structures exchanged with the
+ * functions generated by the `generic-parallel` behaviour interface.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_BATCHDATA_H
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_BATCHDATA_H
+
+#include "MFront/GenericBehaviour/Types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif /* __cplusplus */
+
+/*!
+ * \brief values of a group of variables (gradients, internal state
+ * variables, etc.) at all the integration points of a batch.
+ *
+ * The `j`-th component of the group at the `i`-th integration point is
+ * stored at `values[i * point_stride + j * component_stride]`. Common
+ * layouts are:
+ *
+ * - point by point: `point_stride` is the size of the group and
+ *   `component_stride` is one;
+ * - component by component, which gives coalesced memory accesses on GPUs:
+ *   `point_stride` is one and `component_stride` is the number of points;
+ * - uniform values (inputs only): `point_stride` is zero.
+ *
+ * `values` may be null if the group is empty or if an optional output is not
+ * requested.
+ */
+typedef struct {
+  //! \brief pointer to the first value
+  const mfront_gb_real* values;
+  //! \brief stride between two integration points
+  mfront_gb_size_type point_stride;
+  //! \brief stride between two components
+  mfront_gb_size_type component_stride;
+} mfront_gpb_ConstField;
+
+//! \brief mutable version of `mfront_gpb_ConstField`
+typedef struct {
+  //! \brief pointer to the first value
+  mfront_gb_real* values;
+  //! \brief stride between two integration points
+  mfront_gb_size_type point_stride;
+  //! \brief stride between two components
+  mfront_gb_size_type component_stride;
+} mfront_gpb_Field;
+
+//! \brief state of the material at the beginning of the time step
+typedef struct {
+  mfront_gpb_ConstField gradients;
+  mfront_gpb_ConstField thermodynamic_forces;
+  mfront_gpb_ConstField mass_density;
+  mfront_gpb_ConstField material_properties;
+  mfront_gpb_ConstField internal_state_variables;
+  mfront_gpb_ConstField stored_energy;
+  mfront_gpb_ConstField dissipated_energy;
+  mfront_gpb_ConstField external_state_variables;
+} mfront_gpb_InitialState;
+
+//! \brief state of the material at the end of the time step
+typedef struct {
+  mfront_gpb_ConstField gradients;
+  //! \brief output
+  mfront_gpb_Field thermodynamic_forces;
+  mfront_gpb_ConstField mass_density;
+  mfront_gpb_ConstField material_properties;
+  //! \brief output
+  mfront_gpb_Field internal_state_variables;
+  //! \brief output, optional
+  mfront_gpb_Field stored_energy;
+  //! \brief output, optional
+  mfront_gpb_Field dissipated_energy;
+  mfront_gpb_ConstField external_state_variables;
+} mfront_gpb_State;
+
+/*!
+ * \brief description of a batch of integration points.
+ *
+ * Integrating a batch is equivalent to calling the function generated by
+ * the `generic` interface at each integration point, with the same values
+ * of the time increment and of the computation options. All the pointers
+ * must be accessible by the device on which the computations are performed.
+ */
+typedef struct {
+  //! \brief number of integration points
+  mfront_gb_size_type number_of_points;
+  //! \brief time increment
+  mfront_gb_real dt;
+  /*!
+   * \brief computation options. Those options have the same meaning as the
+   * three first values of the array `K` of the `mfront_gb_BehaviourData`
+   * structure (type of computation, stress measure and type of tangent
+   * operator for finite strain behaviours).
+   */
+  mfront_gb_real options[3];
+  /*!
+   * \brief initial value of the time step scaling factor, used at each
+   * integration point
+   */
+  mfront_gb_real rdt;
+  //! \brief tangent or prediction operators (output, optional)
+  mfront_gpb_Field tangent_operators;
+  //! \brief time step scaling factors at each point (output, optional)
+  mfront_gpb_Field rdts;
+  //! \brief speed of sound (output, only used if requested by the options)
+  mfront_gpb_Field speed_of_sound;
+  /*!
+   * \brief status of each integration point (output, optional):
+   *
+   * - `-1`: the integration failed;
+   * - `0`: the integration succeeded but the time step scaling factor is
+   *   lower than 0.99;
+   * - `1`: the integration succeeded.
+   */
+  int* statuses;
+  //! \brief state at the beginning of the time step
+  mfront_gpb_InitialState s0;
+  //! \brief state at the end of the time step
+  mfront_gpb_State s1;
+  /*!
+   * \brief queue on which the computations are performed, if meaningful for
+   * the backend (`cudaStream_t` or `hipStream_t`). A null pointer denotes
+   * the default queue.
+   */
+  void* queue;
+} mfront_gpb_BatchData;
+
+/*!
+ * \brief summary of the integration of a batch. The `status` member is
+ * also the value returned by the functions generated by the interface:
+ *
+ * - `1`: the integration succeeded at all points;
+ * - `0`: the integration succeeded at all points, but the time step scaling
+ *   factor is lower than 0.99 at some points;
+ * - `-1`: the integration failed at some points;
+ * - `-2`: invalid arguments, nothing was computed;
+ * - `-3`: runtime error of the backend (allocation, kernel launch, etc.).
+ */
+typedef struct {
+  //! \brief status
+  int status;
+  //! \brief number of points where the integration failed
+  mfront_gb_size_type number_of_failures;
+  //! \brief number of points where the time step scaling factor is too low
+  mfront_gb_size_type number_of_unreliable_results;
+  //! \brief minimum of the time step scaling factors over the batch
+  mfront_gb_real rdt;
+  //! \brief error message
+  char msg[512];
+} mfront_gpb_OutputStatus;
+
+#ifdef __cplusplus
+}  // end of extern "C"
+#endif /* __cplusplus */
+
+#ifdef __cplusplus
+
+namespace mfront::gpb {
+
+  //! \brief a simple alias
+  using ConstField = ::mfront_gpb_ConstField;
+  //! \brief a simple alias
+  using Field = ::mfront_gpb_Field;
+  //! \brief a simple alias
+  using InitialState = ::mfront_gpb_InitialState;
+  //! \brief a simple alias
+  using State = ::mfront_gpb_State;
+  //! \brief a simple alias
+  using BatchData = ::mfront_gpb_BatchData;
+  //! \brief a simple alias
+  using OutputStatus = ::mfront_gpb_OutputStatus;
+
+}  // end of namespace mfront::gpb
+
+#endif /* __cplusplus */
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_BATCHDATA_H */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/GPU.hxx b/mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
new file mode 100644
index 000000000..e27270200
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
@@ -0,0 +1,300 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
+ * \brief  This file implements the integration of a batch of integration
+ * points with CUDA or HIP. This file must be compiled by a CUDA or a HIP
+ * compiler.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_GPU_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_GPU_HXX
+
+#include <mutex>
+#include <cstring>
+#if defined(__HIPCC__)
+#include <hip/hip_runtime.h>
+#define MFRONT_GPB_GPU_API(f) hip##f
+#else
+#include <cuda_runtime.h>
+#define MFRONT_GPB_GPU_API(f) cuda##f
+#endif
+#include "MFront/GenericParallelBehaviour/Integrate.hxx"
+
+namespace mfront::gpb::gpu {
+
+  namespace internals {
+
+    /*!
+     * \brief statistics on the integration of a batch, stored on the
+     * device. The time step scaling factor is stored as an ordered key (see
+     * `toOrderedKey`) so that its minimum can be computed with an integer
+     * atomic operation.
+     */
+    struct DeviceStatistics {
+      unsigned long long number_of_failures;
+      unsigned long long number_of_unreliable_results;
+      unsigned long long rdt;
+    };
+
+    /*!
+     * \return an unsigned integer whose ordering is the same as the
+     * ordering of the given floating point values
+     */
+    TFEL_HOST_DEVICE inline unsigned long long toOrderedKey(const double v) {
+#ifdef TFEL_DEVICE_CODE
+      const auto b = static_cast<unsigned long long>(__double_as_longlong(v));
+#else
+      auto b = (unsigned long long){};
+      std::memcpy(&b, &v, sizeof(b));
+#endif
+      constexpr auto sign = 0x8000000000000000ull;
+      return (b & sign) ? ~b : (b | sign);
+    }  // end of toOrderedKey
+
+    //! \brief inverse of `toOrderedKey` (host only)
+    inline double fromOrderedKey(const unsigned long long k) {
+      constexpr auto sign = 0x8000000000000000ull;
+      const auto b = (k & sign) ? (k & ~sign) : ~k;
+      auto v = double{};
+      std::memcpy(&v, &b, sizeof(v));
+      return v;
+    }  // end of fromOrderedKey
+
+    /*!
+     * \brief increase the stack size of the threads if the given kernel
+     * requires it. The default stack size (1024 bytes with CUDA) is too
+     * small for some behaviours and is not increased automatically.
+     * \return the error code of the runtime
+     * \param[in] k: kernel
+     */
+    template <typename Kernel>
+    MFRONT_GPB_GPU_API(Error_t) ensureStackSize(Kernel k) {
+      using Error = MFRONT_GPB_GPU_API(Error_t);
+      // the stack size is a property of the context, shared by all threads
+      static std::mutex m;
+      auto a = MFRONT_GPB_GPU_API(FuncAttributes){};
+      if (const auto e = MFRONT_GPB_GPU_API(FuncGetAttributes)(&a, k);
+          e != MFRONT_GPB_GPU_API(Success)) {
+        return e;
+      }
+      // the static estimate of the local memory of the kernel may be
+      // slightly lower than the actual stack usage (by a few tens of bytes
+      // for a kernel calling the pow function of libdevice), so a margin is
+      // added
+      constexpr auto margin = std::size_t{512};
+      constexpr auto granularity = std::size_t{1024};
+      const auto required =
+          ((a.localSizeBytes + margin + granularity - 1) / granularity) *
+          granularity;
+      auto lock = std::lock_guard<std::mutex>{m};
+      auto l = std::size_t{};
+      if (const auto e = MFRONT_GPB_GPU_API(DeviceGetLimit)(
+              &l, MFRONT_GPB_GPU_API(LimitStackSize));
+          e != MFRONT_GPB_GPU_API(Success)) {
+        return e;
+      }
+      if (required <= l) {
+        return Error{MFRONT_GPB_GPU_API(Success)};
+      }
+      return MFRONT_GPB_GPU_API(DeviceSetLimit)(
+          MFRONT_GPB_GPU_API(LimitStackSize), required);
+    }  // end of ensureStackSize
+
+    //! \brief sum of the values of a warp, in the first thread of the warp
+    template <typename T>
+    __device__ inline T warpSum(T v) {
+      for (int o = warpSize / 2; o > 0; o /= 2) {
+#if defined(__HIP_PLATFORM_AMD__)
+        v += __shfl_down(v, o);
+#else
+        v += __shfl_down_sync(0xffffffffu, v, o);
+#endif
+      }
+      return v;
+    }  // end of warpSum
+
+    //! \brief minimum of the values of a warp, in the first thread of the warp
+    __device__ inline unsigned long long warpMin(unsigned long long v) {
+      for (int o = warpSize / 2; o > 0; o /= 2) {
+#if defined(__HIP_PLATFORM_AMD__)
+        const auto w = __shfl_down(v, o);
+#else
+        const auto w = __shfl_down_sync(0xffffffffu, v, o);
+#endif
+        v = w < v ? w : v;
+      }
+      return v;
+    }  // end of warpMin
+
+    /*!
+     * \brief integrate the behaviour at the points of a batch, one thread
+     * per point. The number of threads per block must be a multiple of the
+     * warp size.
+     *
+     * \param[in] d: batch data
+     * \param[in] parameters: values of the parameters
+     * \param[in] p: out of bounds policy
+     * \param[out] s: statistics
+     * \param[in] rdt0: ordered key of the initial time step scaling factor
+     */
+    template <typename Behaviour,
+              typename Sizes,
+              bool direct,
+              typename ParametersType>
+    __global__ void integrate(const BatchData d,
+                              const ParametersType parameters,
+                              const tfel::material::OutOfBoundsPolicy p,
+                              DeviceStatistics* const s,
+                              const unsigned long long rdt0) {
+      const auto i = static_cast<size_type>(blockIdx.x) * blockDim.x +
+                     static_cast<size_type>(threadIdx.x);
+      auto failures = 0u;
+      auto unreliable_results = 0u;
+      auto rdt = rdt0;
+      if (i < d.number_of_points) {
+        const auto r = mfront::gpb::integrate<Behaviour, Sizes, direct>(
+            d, i, parameters, p);
+        failures = r.status == -1 ? 1u : 0u;
+        unreliable_results = r.status == 0 ? 1u : 0u;
+        rdt = toOrderedKey(r.rdt);
+      }
+      // the atomic operations are only performed if a point of the warp
+      // failed or decreased the time step scaling factor
+      failures = warpSum(failures);
+      unreliable_results = warpSum(unreliable_results);
+      rdt = warpMin(rdt);
+      if (threadIdx.x % warpSize == 0) {
+        if (failures != 0) {
+          atomicAdd(&(s->number_of_failures),
+                    static_cast<unsigned long long>(failures));
+        }
+        if (unreliable_results != 0) {
+          atomicAdd(&(s->number_of_unreliable_results),
+                    static_cast<unsigned long long>(unreliable_results));
+        }
+        if (rdt < rdt0) {
+          atomicMin(&(s->rdt), rdt);
+        }
+      }
+    }  // end of integrate
+
+  }  // end of namespace internals
+
+  /*!
+   * \brief integrate the behaviour at the points of a batch.
+   *
+   * The kernel is launched on the queue given by the batch data. This
+   * function waits for its completion.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam Sizes: sizes of the data of an integration point
+   * \tparam ParametersType: type of the structure holding the parameters
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   * \param[in] threads_per_block: number of threads per block, rounded up to
+   * a multiple of the warp size
+   * \return the status
+   */
+  template <typename Behaviour, typename Sizes, typename ParametersType>
+  int integrate(OutputStatus& s,
+                const BatchData& d,
+                const ParametersType& parameters,
+                const tfel::material::OutOfBoundsPolicy p,
+                const unsigned int threads_per_block) {
+    using Stream = MFRONT_GPB_GPU_API(Stream_t);
+    using Error = MFRONT_GPB_GPU_API(Error_t);
+    if (!check<Sizes>(s, d)) {
+      return s.status;
+    }
+    if (d.number_of_points == 0) {
+      return s.status;
+    }
+    // report a runtime error, only the first error is reported
+    auto failed = [&s](const Error e) {
+      if (e == MFRONT_GPB_GPU_API(Success)) {
+        return false;
+      }
+      if (s.status != -3) {
+        report(s, -3, MFRONT_GPB_GPU_API(GetErrorString)(e));
+      }
+      return true;
+    };
+    auto device = 0;
+    auto warp_size = 0;
+    if (failed(MFRONT_GPB_GPU_API(GetDevice)(&device)) ||
+        failed(MFRONT_GPB_GPU_API(DeviceGetAttribute)(
+            &warp_size, MFRONT_GPB_GPU_API(DevAttrWarpSize), device))) {
+      return s.status;
+    }
+    const auto ws = static_cast<unsigned int>(warp_size);
+    const auto nthreads = ((threads_per_block + ws - 1) / ws) * ws;
+    const auto nblocks = (d.number_of_points + nthreads - 1) / nthreads;
+    const auto stream = static_cast<Stream>(d.queue);
+    const auto rdt0 = internals::toOrderedKey(d.rdt);
+    auto statistics =
+        internals::DeviceStatistics{.number_of_failures = 0,
+                                    .number_of_unreliable_results = 0,
+                                    .rdt = rdt0};
+    internals::DeviceStatistics* device_statistics = nullptr;
+    if (failed(MFRONT_GPB_GPU_API(MallocAsync)(
+            reinterpret_cast<void**>(&device_statistics),
+            sizeof(internals::DeviceStatistics), stream))) {
+      return s.status;
+    }
+    const auto launched = [&] {
+      if (failed(MFRONT_GPB_GPU_API(MemcpyAsync)(
+              device_statistics, &statistics, sizeof(statistics),
+              MFRONT_GPB_GPU_API(MemcpyHostToDevice), stream))) {
+        return false;
+      }
+      if (areAllFieldsStoredPointByPoint<Sizes>(d)) {
+        constexpr auto k =
+            internals::integrate<Behaviour, Sizes, true, ParametersType>;
+        if (failed(internals::ensureStackSize(k))) {
+          return false;
+        }
+        k<<<nblocks, nthreads, 0, stream>>>(d, parameters, p,
+                                            device_statistics, rdt0);
+      } else {
+        constexpr auto k =
+            internals::integrate<Behaviour, Sizes, false, ParametersType>;
+        if (failed(internals::ensureStackSize(k))) {
+          return false;
+        }
+        k<<<nblocks, nthreads, 0, stream>>>(d, parameters, p,
+                                            device_statistics, rdt0);
+      }
+      if (failed(MFRONT_GPB_GPU_API(GetLastError)())) {
+        return false;
+      }
+      return !failed(MFRONT_GPB_GPU_API(MemcpyAsync)(
+          &statistics, device_statistics, sizeof(statistics),
+          MFRONT_GPB_GPU_API(MemcpyDeviceToHost), stream));
+    }();
+    const auto freed =
+        !failed(MFRONT_GPB_GPU_API(FreeAsync)(device_statistics, stream));
+    const auto synchronized =
+        !failed(MFRONT_GPB_GPU_API(StreamSynchronize)(stream));
+    if (!(launched && freed && synchronized)) {
+      return s.status;
+    }
+    return report(
+        s, BatchStatistics{.number_of_failures = statistics.number_of_failures,
+                           .number_of_unreliable_results =
+                               statistics.number_of_unreliable_results,
+                           .rdt = internals::fromOrderedKey(statistics.rdt)});
+  }  // end of integrate
+
+}  // end of namespace mfront::gpb::gpu
+
+#undef MFRONT_GPB_GPU_API
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_GPU_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
