index 000000000..5dccade5b
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
@@ -0,0 +1,615 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
+ * \brief  This file implements the integration of a behaviour at one point
+ * of a batch, and the utilities shared by all the backends of the
+ * `generic-parallel` behaviour interface.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_INTEGRATE_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_INTEGRATE_HXX
+
+#include <cstring>
+#include <exception>
+#include <string_view>
+#include "TFEL/Config/TFELConfig.hxx"
+#include "TFEL/Math/General/MathObjectTraits.hxx"
+#include "TFEL/Math/Array/View.hxx"
+#include "TFEL/Material/OutOfBoundsPolicy.hxx"
+#include "TFEL/Material/MechanicalBehaviourTraits.hxx"
+#include "MFront/GenericBehaviour/Types.hxx"
+#include "MFront/GenericBehaviour/State.hxx"
+#include "MFront/GenericBehaviour/BehaviourData.hxx"
+#include "MFront/GenericParallelBehaviour/BatchData.h"
+
+namespace mfront::gpb {
+
+  //! \brief a simple alias
+  using real = mfront::gb::real;
+  //! \brief a simple alias
+  using size_type = mfront_gb_size_type;
+
+  /*!
+   * \brief sizes of the data of an integration point, as seen by the
+   * `generic` interface. Those sizes are known when the code is generated.
+   *
+   * The templates of this file take those sizes through a type `Sizes`
+   * whose static member `value` is of type `PointDataSizes`: CUDA compilers
+   * don't support class types as non-type template parameters of kernels.
+   */
+  struct PointDataSizes {
+    size_type gradients = 0;
+    size_type thermodynamic_forces = 0;
+    size_type material_properties = 0;
+    size_type internal_state_variables = 0;
+    size_type external_state_variables = 0;
+    size_type tangent_operator = 0;
+  };
+
+  //! \brief parameters of a behaviour without parameters
+  struct NoParameters {};
+
+  //! \brief result of the integration at one point
+  struct PointResult {
+    //! \brief status, as returned by the `generic` interface
+    int status;
+    //! \brief time step scaling factor
+    real rdt;
+  };
+
+  /*!
+   * \brief decoded computation options (see the documentation of the `K`
+   * member of `mfront_gb_BehaviourData`)
+   */
+  struct ComputationOptions {
+    TFEL_HOST_DEVICE constexpr explicit ComputationOptions(
+        const real* const options) noexcept
+        : speed_of_sound(options[0] > 50),
+          Ke(options[0] > 50 ? options[0] - 100 : options[0]) {}
+    //! \return true if only the prediction operator is requested
+    TFEL_HOST_DEVICE constexpr bool isPredictionRequested() const noexcept {
+      return this->Ke < real{-0.25};
+    }
+    //! \return true if a tangent operator is computed after integration
+    TFEL_HOST_DEVICE constexpr bool isTangentOperatorRequested()
+        const noexcept {
+      return this->Ke > real{0.5};
+    }
+    //! \brief true if the speed of sound is requested
+    bool speed_of_sound;
+    //! \brief type of computation
+    real Ke;
+  };
+
+  /*!
+   * \brief local copy of the values of a group of variables at one point
+   * \tparam N: number of values
+   */
+  template <size_type N>
+  struct LocalValues {
+    TFEL_HOST_DEVICE constexpr real* data() noexcept { return this->values; }
+    //! \brief values, the array has at least one element
+    real values[N == 0 ? 1 : N];
+  };
+
+  namespace internals {
+
+    //! \return the values of a field at the given point
+    template <typename FieldType>
+    TFEL_HOST_DEVICE constexpr auto pointer(const FieldType& f,
+                                            const size_type i) noexcept {
+      return f.values == nullptr ? f.values : f.values + i * f.point_stride;
+    }  // end of pointer
+
+    //! \brief copy the values of a field at the given point
+    template <size_type N>
+    TFEL_HOST_DEVICE constexpr void gather(LocalValues<N>& dest,
+                                           const ConstField& f,
+                                           const size_type i) noexcept {
+      if constexpr (N != 0) {
+        if (f.values == nullptr) {
+          return;
+        }
+        const auto* const p = f.values + i * f.point_stride;
+        for (size_type j = 0; j != N; ++j) {
+          dest.values[j] = p[j * f.component_stride];
+        }
+      }
+    }  // end of gather
+
+    //! \brief copy the given values in a field at the given point
+    template <size_type N>
+    TFEL_HOST_DEVICE constexpr void scatter(
+        const Field& f, const size_type i, const LocalValues<N>& src) noexcept {
+      if constexpr (N != 0) {
+        if (f.values == nullptr) {
+          return;
+        }
+        auto* const p = f.values + i * f.point_stride;
+        for (size_type j = 0; j != N; ++j) {
+          p[j * f.component_stride] = src.values[j];
+        }
+      }
+    }  // end of scatter
+
+    //! \brief copy a scalar value in a field at the given point
+    TFEL_HOST_DEVICE constexpr void scatter(const Field& f,
+                                            const size_type i,
+                                            const real v) noexcept {
+      if (f.values != nullptr) {
+        f.values[i * f.point_stride] = v;
+      }
+    }  // end of scatter
+
+    //! \return the value of a scalar field at the given point, or a default
+    TFEL_HOST_DEVICE constexpr real value(const ConstField& f,
+                                          const size_type i,
+                                          const real v) noexcept {
+      return f.values == nullptr ? v : f.values[i * f.point_stride];
+    }  // end of value
+
+  }  // end of namespace internals
+
+  /*!
+   * \brief export a tangent operator
+   * \param[out] v: exported values
+   * \param[in] K: tangent operator
+   */
+  template <typename TangentOperatorType>
+  TFEL_HOST_DEVICE void exportTangentOperator(real* const v,
+                                              const TangentOperatorType& K) {
+    if constexpr (tfel::math::ScalarConcept<TangentOperatorType>) {
+      *v = tfel::math::base_type_cast(K);
+    } else {
+      tfel::math::map<TangentOperatorType>(v) = K;
+    }
+  }  // end of exportTangentOperator
+
+  /*!
+   * \brief integrate the behaviour over a time step at one point.
+   *
+   * This function is an exception-free equivalent of `mfront::gb::integrate`
+   * which can be called in device code. Error messages are not reported.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam ParametersType: type of the structure holding the parameters
+   * \param[in,out] d: behaviour data
+   * \param[in] o: computation options
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   * \return the same status as `mfront::gb::integrate`
+   */
+  template <typename Behaviour, typename ParametersType>
+  TFEL_HOST_DEVICE int integrate(mfront::gb::BehaviourData& d,
+                                 const ComputationOptions& o,
+                                 const ParametersType& parameters,
+                                 const tfel::material::OutOfBoundsPolicy p) {
+    using MTraits = tfel::material::MechanicalBehaviourTraits<Behaviour>;
+    using speed = typename Behaviour::speed;
+    using massdensity = typename Behaviour::massdensity;
+    constexpr auto f = Behaviour::STANDARDTANGENTOPERATOR;
+    auto& rdt = *(d.rdt);
+    Behaviour b(d, parameters);
+    b.setOutOfBoundsPolicy(p);
+    if (!b.initialize()) {
+      return -1;
+    }
+    if (!b.checkBounds()) {
+      rdt = b.getMinimalTimeStepScalingFactor();
+      return -1;
+    }
+    if (o.isPredictionRequested()) {
+      if (o.speed_of_sound) {
+        *(d.speed_of_sound) = tfel::math::base_type_cast(
+            b.computeSpeedOfSound(massdensity(*(d.s0.mass_density))));
+      }
+      if constexpr (!MTraits::hasPredictionOperator) {
+        return -1;
+      } else {
+        const auto smt = [&o] {
+          if (o.Ke > real{-1.5}) {
+            return Behaviour::ELASTIC;
+          } else if (o.Ke > real{-2.5}) {
+            return Behaviour::SECANTOPERATOR;
+          }
+          return Behaviour::TANGENTOPERATOR;
+        }();
+        if (!b.computePredictionOperator(f, smt)) {
+          return -1;
+        }
+        exportTangentOperator(d.K, b.getTangentOperator());
+        return 1;
+      }
+    }
+    const auto smt = [&o] {
+      if (o.Ke < real{0.5}) {
+        return Behaviour::NOSTIFFNESSREQUESTED;
+      } else if (o.Ke < real{1.5}) {
+        return Behaviour::ELASTIC;
+      } else if (o.Ke < real{2.5}) {
+        return Behaviour::SECANTOPERATOR;
+      } else if (o.Ke < real{3.5}) {
+        return Behaviour::TANGENTOPERATOR;
+      }
+      return Behaviour::CONSISTENTTANGENTOPERATOR;
+    }();
+    if constexpr (!MTraits::hasConsistentTangentOperator) {
+      if (smt != Behaviour::NOSTIFFNESSREQUESTED) {
+        return -1;
+      }
+    }
+    const auto tsf = b.computeAPrioriTimeStepScalingFactor(rdt);
+    rdt = tsf.second;
+    if (!tsf.first) {
+      return -1;
+    }
+    if (b.integrate(f, smt) == Behaviour::FAILURE) {
+      rdt = b.getMinimalTimeStepScalingFactor();
+      return -1;
+    }
+    const auto atsf = b.computeAPosterioriTimeStepScalingFactor(rdt);
+    if (rdt > atsf.second) {
+      rdt = atsf.second;
+    }
+    if (!atsf.first) {
+      return -1;
+    }
+    b.exportStateData(d.s1);
+    if constexpr (MTraits::hasConsistentTangentOperator) {
+      if (o.isTangentOperatorRequested()) {
+        exportTangentOperator(d.K, b.getTangentOperator());
+      }
+    }
+    if constexpr (MTraits::hasComputeInternalEnergy) {
+      if (d.s1.stored_energy != nullptr) {
+        using stress = typename Behaviour::stress;
+        auto e = stress{*(d.s0.stored_energy)};
+        b.computeInternalEnergy(e);
+        *(d.s1.stored_energy) = tfel::math::base_type_cast(e);
+      }
+    }
+    if constexpr (MTraits::hasComputeDissipatedEnergy) {
+      if (d.s1.dissipated_energy != nullptr) {
+        using stress = typename Behaviour::stress;
+        auto e = stress{*(d.s0.dissipated_energy)};
+        b.computeDissipatedEnergy(e);
+        *(d.s1.dissipated_energy) = tfel::math::base_type_cast(e);
+      }
+    }
+    if (o.speed_of_sound) {
+      *(d.speed_of_sound) = tfel::math::base_type_cast(
+          b.computeSpeedOfSound(massdensity(*(d.s1.mass_density))));
+    }
+    return rdt < real{0.99} ? 0 : 1;
+  }  // end of integrate
+
+  /*!
+   * \brief integrate the behaviour at the `i`-th point of a batch.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam Sizes: sizes of the data of an integration point
+   * \tparam direct: if true, all the fields are stored point by point and
+   * the behaviour directly reads and writes them. Otherwise, the values of
+   * the point are gathered in local arrays and the results are scattered
+   * after the integration.
+   * \tparam ParametersType: type of the structure holding the parameters
+   * \param[in] d: batch data
+   * \param[in] i: index of the integration point
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   */
+  template <typename Behaviour,
+            typename Sizes,
+            bool direct,
+            typename ParametersType>
+  TFEL_HOST_DEVICE PointResult
+  integrate(const BatchData& d,
+            const size_type i,
+            const ParametersType& parameters,
+            const tfel::material::OutOfBoundsPolicy p) {
+    using namespace internals;
+    constexpr auto sizes = PointDataSizes{Sizes::value};
+    const auto o = ComputationOptions{d.options};
+    auto r = PointResult{.status = -1, .rdt = d.rdt};
+    auto speed_of_sound = real{};
+    auto energies0 = LocalValues<2>{
+        {value(d.s0.stored_energy, i, 0), value(d.s0.dissipated_energy, i, 0)}};
+    auto energies1 = LocalValues<2>{};
+    auto bd = mfront::gb::BehaviourData{};
+    bd.error_message = nullptr;
+    bd.dt = d.dt;
+    bd.rdt = &(r.rdt);
+    bd.speed_of_sound = &speed_of_sound;
+    bd.s0.mass_density = pointer(d.s0.mass_density, i);
+    bd.s1.mass_density = pointer(d.s1.mass_density, i);
+    bd.s0.stored_energy = energies0.data();
+    bd.s0.dissipated_energy = energies0.data() + 1;
+    bd.s1.stored_energy =
+        d.s1.stored_energy.values == nullptr ? nullptr : energies1.data();
+    bd.s1.dissipated_energy = d.s1.dissipated_energy.values == nullptr
+                                  ? nullptr
+                                  : energies1.data() + 1;
+    if constexpr (direct) {
+      bd.K = pointer(d.tangent_operators, i);
+      bd.s0.gradients = pointer(d.s0.gradients, i);
+      bd.s1.gradients = pointer(d.s1.gradients, i);
+      bd.s0.thermodynamic_forces = pointer(d.s0.thermodynamic_forces, i);
+      bd.s1.thermodynamic_forces = pointer(d.s1.thermodynamic_forces, i);
+      bd.s0.material_properties = pointer(d.s0.material_properties, i);
+      bd.s1.material_properties = pointer(d.s1.material_properties, i);
+      bd.s0.internal_state_variables =
+          pointer(d.s0.internal_state_variables, i);
+      bd.s1.internal_state_variables =
+          pointer(d.s1.internal_state_variables, i);
+      bd.s0.external_state_variables =
+          pointer(d.s0.external_state_variables, i);
+      bd.s1.external_state_variables =
+          pointer(d.s1.external_state_variables, i);
+      r.status = integrate<Behaviour>(bd, o, parameters, p);
+    } else {
+      auto K = LocalValues<sizes.tangent_operator>{};
+      auto g0 = LocalValues<sizes.gradients>{};
+      auto g1 = LocalValues<sizes.gradients>{};
+      auto th0 = LocalValues<sizes.thermodynamic_forces>{};
+      auto th1 = LocalValues<sizes.thermodynamic_forces>{};
+      auto mp0 = LocalValues<sizes.material_properties>{};
+      auto mp1 = LocalValues<sizes.material_properties>{};
+      auto isvs0 = LocalValues<sizes.internal_state_variables>{};
+      auto isvs1 = LocalValues<sizes.internal_state_variables>{};
+      auto esvs0 = LocalValues<sizes.external_state_variables>{};
+      auto esvs1 = LocalValues<sizes.external_state_variables>{};
+      gather(g0, d.s0.gradients, i);
+      gather(g1, d.s1.gradients, i);
+      gather(th0, d.s0.thermodynamic_forces, i);
+      gather(mp0, d.s0.material_properties, i);
+      gather(mp1, d.s1.material_properties, i);
+      gather(isvs0, d.s0.internal_state_variables, i);
+      gather(esvs0, d.s0.external_state_variables, i);
+      gather(esvs1, d.s1.external_state_variables, i);
+      bd.K = K.data();
+      bd.s0.gradients = g0.data();
+      bd.s1.gradients = g1.data();
+      bd.s0.thermodynamic_forces = th0.data();
+      bd.s1.thermodynamic_forces = th1.data();
+      bd.s0.material_properties = mp0.data();
+      bd.s1.material_properties = mp1.data();
+      bd.s0.internal_state_variables = isvs0.data();
+      bd.s1.internal_state_variables = isvs1.data();
+      bd.s0.external_state_variables = esvs0.data();
+      bd.s1.external_state_variables = esvs1.data();
+      r.status = integrate<Behaviour>(bd, o, parameters, p);
+      if (r.status != -1) {
+        if (o.isPredictionRequested() || o.isTangentOperatorRequested()) {
+          scatter(d.tangent_operators, i, K);
+        }
+        if (!o.isPredictionRequested()) {
+          scatter(d.s1.thermodynamic_forces, i, th1);
+          scatter(d.s1.internal_state_variables, i, isvs1);
+        }
+      }
+    }
+    if ((r.status != -1) && (!o.isPredictionRequested())) {
+      scatter(d.s1.stored_energy, i, energies1.values[0]);
+      scatter(d.s1.dissipated_energy, i, energies1.values[1]);
+    }
+    if ((r.status != -1) && (o.speed_of_sound)) {
+      scatter(d.speed_of_sound, i, speed_of_sound);
+    }
+    scatter(d.rdts, i, r.rdt);
+    if (d.statuses != nullptr) {
+      d.statuses[i] = r.status;
+    }
+    return r;
+  }  // end of integrate
+
+  /*!
+   * \brief statistics on the integration of a batch, combined by
+   * parallel reductions
+   */
+  struct BatchStatistics {
+    //! \return the statistics associated with the result at one point
+    TFEL_HOST_DEVICE static constexpr BatchStatistics from(
+        const PointResult& r) noexcept {
+      return {.number_of_failures = r.status == -1 ? 1u : 0u,
+              .number_of_unreliable_results = r.status == 0 ? 1u : 0u,
+              .rdt = r.rdt};
+    }
+    //! \brief combine two statistics
+    TFEL_HOST_DEVICE friend constexpr BatchStatistics combine(
+        const BatchStatistics& a, const BatchStatistics& b) noexcept {
+      return {.number_of_failures = a.number_of_failures + b.number_of_failures,
+              .number_of_unreliable_results = a.number_of_unreliable_results +
+                                              b.number_of_unreliable_results,
+              .rdt = a.rdt < b.rdt ? a.rdt : b.rdt};
+    }
+    size_type number_of_failures = 0;
+    size_type number_of_unreliable_results = 0;
+    real rdt = 1;
+  };
+
+  /*!
+   * \brief set the status and the error message of an output status
+   * \param[out] s: output status
+   * \param[in] status: status
+   * \param[in] msg: error message
+   * \return the status
+   */
+  inline int report(OutputStatus& s,
+                    const int status,
+                    const std::string_view msg) noexcept {
+    constexpr auto msize = sizeof(s.msg) - 1;
+    const auto n = msg.size() < msize ? msg.size() : msize;
+    s.status = status;
+    std::memcpy(s.msg, msg.data(), n);
+    s.msg[n] = '\0';
+    return status;
+  }  // end of report
+
+  /*!
+   * \brief fill an output status from the statistics of a batch
+   * \return the status
+   */
+  inline int report(OutputStatus& s, const BatchStatistics& r) noexcept {
+    s.number_of_failures = r.number_of_failures;
+    s.number_of_unreliable_results = r.number_of_unreliable_results;
+    s.rdt = r.rdt;
+    if (r.number_of_failures != 0) {
+      return report(s, -1, "integration failed at some integration points");
+    }
+    s.status = r.number_of_unreliable_results != 0 ? 0 : 1;
+    return s.status;
+  }  // end of report
+
+  /*!
+   * \brief check the consistency of the batch data. The output status is
+   * initialized.
+   * \tparam Sizes: sizes of the data of an integration point
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \return true if the batch data are valid
+   */
+  template <typename Sizes>
+  bool check(OutputStatus& s, const BatchData& d) noexcept {
+    constexpr auto sizes = PointDataSizes{Sizes::value};
+    s.status = 1;
+    s.number_of_failures = 0;
+    s.number_of_unreliable_results = 0;
+    s.rdt = d.rdt;
+    s.msg[0] = '\0';
+    const auto n = d.number_of_points;
+    auto check_input = [&s](const ConstField& f, const size_type size,
+                            const std::string_view name) {
+      if ((size != 0) && (f.values == nullptr)) {
+        report(s, -2, name);
+        return false;
+      }
+      return true;
+    };
+    auto check_output = [&s, n](const auto& f, const size_type size,
+                                const bool required,
+                                const std::string_view name) {
+      if (size == 0) {
+        return true;
+      }
+      if ((required) && (f.values == nullptr)) {
+        report(s, -2, name);
+        return false;
+      }
+      if ((f.values != nullptr) && (f.point_stride == 0) && (n > 1)) {
+        report(s, -2, name);
+        return false;
+      }
+      return true;
+    };
+    const auto o = ComputationOptions{d.options};
+    const auto tangent_operator_required =
+        o.isPredictionRequested() || o.isTangentOperatorRequested();
+    return check_input(d.s0.gradients, sizes.gradients,
+                       "missing gradients at the beginning of the time "
+                       "step") &&
+           check_input(d.s1.gradients, sizes.gradients,
+                       "missing gradients at the end of the time step") &&
+           check_input(d.s0.thermodynamic_forces, sizes.thermodynamic_forces,
+                       "missing thermodynamic forces at the beginning of the "
+                       "time step") &&
+           check_input(d.s0.material_properties, sizes.material_properties,
+                       "missing material properties at the beginning of the "
+                       "time step") &&
+           check_input(d.s1.material_properties, sizes.material_properties,
+                       "missing material properties at the end of the time "
+                       "step") &&
+           check_input(d.s0.internal_state_variables,
+                       sizes.internal_state_variables,
+                       "missing internal state variables at the beginning "
+                       "of the time step") &&
+           check_input(d.s0.external_state_variables,
+                       sizes.external_state_variables,
+                       "missing external state variables at the beginning "
+                       "of the time step") &&
+           check_input(d.s1.external_state_variables,
+                       sizes.external_state_variables,
+                       "missing external state variables at the end of the "
+                       "time step") &&
+           check_input(d.s0.mass_density, o.speed_of_sound ? 1 : 0,
+                       "missing mass density at the beginning of the time "
+                       "step") &&
+           check_input(d.s1.mass_density, o.speed_of_sound ? 1 : 0,
+                       "missing mass density at the end of the time step") &&
+           check_output(d.s1.thermodynamic_forces, sizes.thermodynamic_forces,
+                        true, "invalid thermodynamic forces") &&
+           check_output(d.s1.internal_state_variables,
+                        sizes.internal_state_variables, true,
+                        "invalid internal state variables") &&
+           check_output(d.tangent_operators, sizes.tangent_operator,
+                        tangent_operator_required,
+                        "invalid tangent operators") &&
+           check_output(d.s1.stored_energy, 1, false,
+                        "invalid stored energies") &&
+           check_output(d.s1.dissipated_energy, 1, false,
+                        "invalid dissipated energies") &&
+           check_output(d.rdts, 1, false,
+                        "invalid time step scaling factors") &&
+           check_output(d.speed_of_sound, 1, o.speed_of_sound,
+                        "invalid speeds of sound");
+  }  // end of check
+
+  /*!
+   * \return true if all the fields are stored point by point, i.e. if the
+   * behaviour can directly read and write the values of a point.
+   * \tparam Sizes: sizes of the data of an integration point
+   * \param[in] d: batch data
+   */
+  template <typename Sizes>
+  constexpr bool areAllFieldsStoredPointByPoint(const BatchData& d) noexcept {
+    constexpr auto sizes = PointDataSizes{Sizes::value};
+    auto is_contiguous = [](const auto& f, const size_type size) {
+      return (size <= 1) || (f.values == nullptr) || (f.component_stride == 1);
+    };
+    return is_contiguous(d.s0.gradients, sizes.gradients) &&
+           is_contiguous(d.s1.gradients, sizes.gradients) &&
+           is_contiguous(d.s0.thermodynamic_forces,
+                         sizes.thermodynamic_forces) &&
+           is_contiguous(d.s1.thermodynamic_forces,
+                         sizes.thermodynamic_forces) &&
+           is_contiguous(d.s0.material_properties, sizes.material_properties) &&
+           is_contiguous(d.s1.material_properties, sizes.material_properties) &&
+           is_contiguous(d.s0.internal_state_variables,
+                         sizes.internal_state_variables) &&
+           is_contiguous(d.s1.internal_state_variables,
+                         sizes.internal_state_variables) &&
+           is_contiguous(d.s0.external_state_variables,
+                         sizes.external_state_variables) &&
+           is_contiguous(d.s1.external_state_variables,
+                         sizes.external_state_variables) &&
+           is_contiguous(d.tangent_operators, sizes.tangent_operator);
+  }  // end of areAllFieldsStoredPointByPoint
+
+  /*!
+   * \brief call the given function and convert exceptions to an error
+   * status. This is meant for the host part of the generated functions.
+   * \param[out] s: output status
+   * \param[in] f: function
+   */
+  template <typename Function>
+  int handleExceptions(OutputStatus* const s, Function&& f) noexcept {
+    if (s == nullptr) {
+      return -2;
+    }
+    try {
+      return f();
+    } catch (std::exception& e) {
+      return report(*s, -3, e.what());
+    } catch (...) {
+      return report(*s, -3, "unknown exception");
+    }
+  }  // end of handleExceptions
+
+}  // end of namespace mfront::gpb
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_INTEGRATE_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/ParallelSTL.hxx b/mfront/include/MFront/GenericParallelBehaviour/ParallelSTL.hxx
new file mode 100644
index 000000000..956ef7ab7
--- /dev/null
