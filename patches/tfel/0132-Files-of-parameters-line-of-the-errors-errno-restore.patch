diff --git a/test-suite/material-properties/generic-parallel/test-parameters-errno.cxx b/test-suite/material-properties/generic-parallel/test-parameters-errno.cxx
new file mode 100644
index 000000000..689ff6929
--- /dev/null
+++ b/test-suite/material-properties/generic-parallel/test-parameters-errno.cxx
@@ -0,0 +1,81 @@
+/*!
+ * \file   test-parameters-errno.cxx
+ * \brief  This file tests that reading the file of parameters of a material
+ * property generated by the `generic` interface does not change `errno`:
+ * a value which sets `errno` while being converted (a subnormal number) must
+ * not make the first evaluation fail with the status `-3`. The library is
+ * the one built by `build-libraries.sh`.
+ * \date   21/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#include <cmath>
+#include <cerrno>
+#include <cstdio>
+#include <string>
+#include <fstream>
+#include <iostream>
+
+#include "TFEL/Tests/TestCase.hxx"
+#include "TFEL/Tests/TestProxy.hxx"
+#include "TFEL/Tests/TestManager.hxx"
+
+#include "MFront/GenericMaterialProperty/MaterialProperty.h"
+
+extern "C" mfront_gmp_real UO2_YoungModulus_Martin1989(
+    mfront_gmp_OutputStatus* const,
+    const mfront_gmp_real* const,
+    const mfront_gmp_size_type,
+    const mfront_gmp_OutOfBoundsPolicy);
+
+struct ParametersErrnoTest : public tfel::tests::TestCase {
+  ParametersErrnoTest()
+      : tfel::tests::TestCase("MFront/MaterialProperty/Generic",
+                              "ParametersErrnoTest") {
+  }  // end of ParametersErrnoTest
+
+  tfel::tests::TestResult execute() override {
+    // the file of parameters is read at the first call of the function:
+    // no other call is made by this test
+    const auto file = std::string{"UO2_YoungModulus_Martin1989-parameters.txt"};
+    {
+      auto out = std::ofstream{file};
+      out << "d2E_dT2 1e-310\n";
+    }
+    const double args[2] = {300, 0.1};
+    auto s = mfront_gmp_OutputStatus{};
+    errno = 0;
+    const auto E = UO2_YoungModulus_Martin1989(
+        &s, args, 2, GENERIC_MATERIALPROPERTY_NONE_POLICY);
+    TFEL_TESTS_CHECK_EQUAL(s.status, 0);
+    TFEL_TESTS_CHECK_EQUAL(errno, 0);
+    // value with the parameter of the file (the default value of `d2E_dT2`
+    // gives another value)
+    const auto E0 = 2.2693e11;
+    const auto dE_dT = -1.53994698e7;
+    const auto Eref = (1 - 0.1 / 0.4) * (E0 + dE_dT * 300);
+    TFEL_TESTS_ASSERT(std::abs(E - Eref) < 1e-12 * std::abs(Eref));
+    std::remove(file.c_str());
+    return this->result;
+  }  // end of execute
+};
+
+TFEL_TESTS_GENERATE_PROXY(ParametersErrnoTest, "ParametersErrnoTest");
+
+/* coverity [UNCAUGHT_EXCEPT]*/
+int main(const int argc, const char* const* argv) {
+  if (argc != 2) {
+    std::cerr << "no test name given on the command line (argc: " << argc
+              << ")";
+    return EXIT_FAILURE;
+  }
+  auto& m = tfel::tests::TestManager::getTestManager();
+  m.addTestOutput(std::cout);
+  m.addXMLTestOutput(std::string{argv[1]} + ".xml");
+  return m.execute().success() ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
