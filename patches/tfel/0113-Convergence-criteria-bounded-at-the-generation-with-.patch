From 2393fe69e0aa19f9241d96a63b9bcc4299a02d9a Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 21:36:06 +0200
Subject: [PATCH] Convergence criteria bounded at the generation with the float
 type

With the float numerical type (real_type option), the convergence criteria
(@Epsilon of the implicit, Runge-Kutta and isotropic DSLs) are bounded
below by 10 times the machine epsilon of float (1.2e-6), and the
perturbation of the numerical jacobian by a tenth of this bound, with a
warning: the values written for double (1e-14 or less) can't be reached.
Bounding the default values at the generation keeps the values given at
run time (setParameter, file of parameters), unlike a bound applied by
the caller when loading the library.
---
 mfront/include/MFront/BehaviourDSLCommon.hxx | 14 ++++++++++++++
 mfront/src/BehaviourDSLCommon.cxx            | 19 +++++++++++++++++++
 mfront/src/ImplicitDSLBase.cxx               |  9 +++++++--
 mfront/src/IsotropicBehaviourDSLBase.cxx     |  4 +++-
 mfront/src/RungeKuttaDSLBase.cxx             |  4 +++-
 5 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/mfront/include/MFront/BehaviourDSLCommon.hxx b/mfront/include/MFront/BehaviourDSLCommon.hxx
index 80c44624c..79c69706d 100644
--- a/mfront/include/MFront/BehaviourDSLCommon.hxx
+++ b/mfront/include/MFront/BehaviourDSLCommon.hxx
@@ -554,6 +554,20 @@ namespace mfront {
     virtual void treatPostProcessing();
     //! \brief treat the `@StrainMeasure` keyword
     virtual void treatStrainMeasure();
+    /*!
+     * \return the value of a convergence criterion or of a perturbation,
+     * bounded below, with the float numerical type (`real_type` DSL option),
+     * by `f` times 10 times the machine epsilon of this type: the values
+     * written for double (1e-14 or less) can't be reached with float. A
+     * warning is reported when the value is changed.
+     * \param[in] n: name of the parameter
+     * \param[in] v: value
+     * \param[in] f: factor (0.1 for the perturbation of the numerical
+     * jacobian, the ratio used by default)
+     */
+    double getConvergenceCriterionForRealType(const std::string_view,
+                                              const double,
+                                              const double = 1) const;
     /*!
      * \brief treat the `@TangentOperator` keyword
      * \note this method read the code block options and determines
diff --git a/mfront/src/BehaviourDSLCommon.cxx b/mfront/src/BehaviourDSLCommon.cxx
index ccd95b246..7e1a6152a 100644
--- a/mfront/src/BehaviourDSLCommon.cxx
+++ b/mfront/src/BehaviourDSLCommon.cxx
@@ -1677,6 +1677,25 @@ namespace mfront {
     return this->standardModifier(h, var, addThisPtr);
   }  // end of tangentOperatorVariableModifier
 
+  double BehaviourDSLCommon::getConvergenceCriterionForRealType(
+      const std::string_view n, const double v, const double f) const {
+    if (getRealType(this->mb) != "float") {
+      return v;
+    }
+    const auto vmin =
+        f * 10 * static_cast<double>(std::numeric_limits<float>::epsilon());
+    if (v >= vmin) {
+      return v;
+    }
+    auto msg = std::ostringstream{};
+    msg << std::scientific << "the value of '" << n << "' (" << v
+        << ") is raised to " << vmin
+        << " for the float numerical type (real_type option): smaller "
+           "values can't be reached";
+    reportWarning(msg.str());
+    return vmin;
+  }  // end of getConvergenceCriterionForRealType
+
   void BehaviourDSLCommon::treatStrainMeasure() {
     this->checkNotEndOfFile("BehaviourDSLCommon::treatStrainMeasure",
                             "Expected strain measure name.");
diff --git a/mfront/src/ImplicitDSLBase.cxx b/mfront/src/ImplicitDSLBase.cxx
index 48f84724c..60dd1f10b 100644
--- a/mfront/src/ImplicitDSLBase.cxx
+++ b/mfront/src/ImplicitDSLBase.cxx
@@ -690,7 +690,9 @@ namespace mfront {
     e.description =
         "value used to stop the iteration of the implicit algorithm";
     this->mb.addParameter(uh, e, BehaviourData::ALREADYREGISTRED);
-    this->mb.setParameterDefaultValue(uh, "epsilon", epsilon);
+    this->mb.setParameterDefaultValue(
+        uh, "epsilon",
+        this->getConvergenceCriterionForRealType("epsilon", epsilon));
     this->mb.setEntryName(uh, "epsilon", "epsilon");
   }  // ImplicitDSLBase::treatEpsilon
 
@@ -751,7 +753,10 @@ namespace mfront {
         "perturbation value used to compute a finite difference approximation "
         "of the jacobian";
     this->mb.addParameter(h, e, BehaviourData::ALREADYREGISTRED);
-    this->mb.setParameterDefaultValue(h, "numerical_jacobian_epsilon", epsilon);
+    this->mb.setParameterDefaultValue(
+        h, "numerical_jacobian_epsilon",
+        this->getConvergenceCriterionForRealType("numerical_jacobian_epsilon",
+                                                 epsilon, 0.1));
   }  // ImplicitDSLBase::treatEpsilon
 
   void ImplicitDSLBase::treatIterMax() {
diff --git a/mfront/src/IsotropicBehaviourDSLBase.cxx b/mfront/src/IsotropicBehaviourDSLBase.cxx
index f037da65f..f867b21ae 100644
--- a/mfront/src/IsotropicBehaviourDSLBase.cxx
+++ b/mfront/src/IsotropicBehaviourDSLBase.cxx
@@ -227,7 +227,9 @@ namespace mfront {
     this->mb.addParameter(
         h, VariableDescription("real", "\u03B5", "epsilon", 1u, 0u),
         BehaviourData::ALREADYREGISTRED);
-    this->mb.setParameterDefaultValue(h, "epsilon", epsilon);
+    this->mb.setParameterDefaultValue(
+        h, "epsilon",
+        this->getConvergenceCriterionForRealType("epsilon", epsilon));
   }  // IsotropicBehaviourDSLBase::treatEpsilon
 
   void IsotropicBehaviourDSLBase::treatIterMax() {
diff --git a/mfront/src/RungeKuttaDSLBase.cxx b/mfront/src/RungeKuttaDSLBase.cxx
index 6d1bfb8df..7996967d4 100644
--- a/mfront/src/RungeKuttaDSLBase.cxx
+++ b/mfront/src/RungeKuttaDSLBase.cxx
@@ -379,7 +379,9 @@ namespace mfront {
     this->readSpecifiedToken("RungeKuttaDSLBase::treatEpsilon", ";");
     this->mb.addParameter(h, VariableDescription("real", "epsilon", 1u, 0u),
                           BehaviourData::ALREADYREGISTRED);
-    this->mb.setParameterDefaultValue(h, "epsilon", epsilon);
+    this->mb.setParameterDefaultValue(
+        h, "epsilon",
+        this->getConvergenceCriterionForRealType("epsilon", epsilon));
   }  // end of treatEpsilon
 
   void RungeKuttaDSLBase::treatStressErrorNormalizationFactor() {
-- 
