diff --git a/test-suite/behaviours/generic-parallel/compare.cxx b/test-suite/behaviours/generic-parallel/compare.cxx
index e353dd5e4..3b897fd0f 100644
--- a/test-suite/behaviours/generic-parallel/compare.cxx
+++ b/test-suite/behaviours/generic-parallel/compare.cxx
@@ -307,6 +307,33 @@ static void* load(const std::string& lib, const std::string& f) {
   return s;
 }
 
+/*!
+ * \brief check that the version of the data structures exported by the
+ * library is the one of `MFront/GenericParallelBehaviour/BatchData.h`
+ * \param[in] lib: library
+ * \param[in] f: tested function, whose name starts with the name of the
+ * behaviour followed by the modelling hypothesis
+ */
+static void checkVersion(const std::string& lib, const std::string& f) {
+  for (const auto* const h :
+       {"_AxisymmetricalGeneralisedPlaneStrain",
+        "_AxisymmetricalGeneralisedPlaneStress", "_Axisymmetrical",
+        "_GeneralisedPlaneStrain", "_PlaneStrain", "_PlaneStress",
+        "_Tridimensional"}) {
+    const auto p = f.find(h);
+    if (p == std::string::npos) {
+      continue;
+    }
+    const auto* const v = static_cast<const unsigned short*>(
+        load(lib, f.substr(0, p) + "_generic_parallel_api_version"));
+    if (*v != MFRONT_GPB_API_VERSION) {
+      fail("invalid version of the data structures in library '" + lib + "'");
+    }
+    return;
+  }
+  fail("no modelling hypothesis in the name of the function '" + f + "'");
+}
+
 /*!
  * \brief call the given function at each point with the behaviour data of
  * the `generic` interface
@@ -1170,6 +1197,7 @@ int main(const int argc, const char* const* const argv) {
          "[--rotation=number_of_values]");
   }
   [[maybe_unused]] const auto runtime = Runtime{};
+  checkVersion(argv[2], argv[3]);
   const auto s =
       Sizes{std::stoul(argv[4]), std::stoul(argv[5]), std::stoul(argv[6]),
             std::stoul(argv[7]), std::stoul(argv[8]), std::stoul(argv[9])};
