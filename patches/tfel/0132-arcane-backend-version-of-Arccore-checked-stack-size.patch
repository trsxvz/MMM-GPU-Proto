From 9d63cbfeab5b57672012431fb30917cff2fc5982 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 4 Nov 2026 14:39:45 +0100
Subject: [PATCH] arcane backend: version of Arccore checked, stack size of the
 material properties

- The 'arcane' configuration reads the version of Arccore in its version
  header and requires Arccore 2.8.0 or later (Arcane 4.1.16), the version
  with which the backend is tested.
- Material properties: the stack size of the threads is increased on the
  current device of the calling thread, which must be the device of the
  queue, as documented for the behaviours.
---
 cmake/modules/tfel.cmake                      | 25 +++++++++++++++++++
 .../generic-parallel-behaviour-interface.md   |  5 ++--
 ...ic-parallel-material-property-interface.md |  3 ++-
 3 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/cmake/modules/tfel.cmake b/cmake/modules/tfel.cmake
index f3895c91d..05c360a4d 100644
--- a/cmake/modules/tfel.cmake
+++ b/cmake/modules/tfel.cmake
@@ -680,6 +680,31 @@ if(_tfel-enable-generic-parallel-arcane-configuration)
     message(FATAL_ERROR "the 'arcane' configuration requires Arccore built "
             "as shared libraries")
   endif()
+  # version of Arccore, read in its version header: the backend is tested
+  # with Arccore 2.8.0 (Arcane 4.1.16)
+  set(_arccore_version_header "${TFEL_ARCCORE_INCLUDE_DIR}/arccore_version.h")
+  if(NOT EXISTS "${_arccore_version_header}")
+    message(FATAL_ERROR "the version header of Arccore "
+            "'${_arccore_version_header}' is missing")
+  endif()
+  file(STRINGS "${_arccore_version_header}" _arccore_version_lines
+       REGEX "^#define ARCCORE_VERSION_(MAJOR|MINOR|RELEASE) +[0-9]+")
+  set(TFEL_ARCCORE_VERSION "")
+  foreach(_arccore_component MAJOR MINOR RELEASE)
+    string(REGEX MATCH "ARCCORE_VERSION_${_arccore_component} +([0-9]+)"
+           _arccore_match "${_arccore_version_lines}")
+    if(NOT _arccore_match)
+      message(FATAL_ERROR "unable to read the version of Arccore in "
+              "'${_arccore_version_header}'")
+    endif()
+    list(APPEND TFEL_ARCCORE_VERSION "${CMAKE_MATCH_1}")
+  endforeach()
+  list(JOIN TFEL_ARCCORE_VERSION "." TFEL_ARCCORE_VERSION)
+  if(TFEL_ARCCORE_VERSION VERSION_LESS "2.8.0")
+    message(FATAL_ERROR "the 'arcane' configuration requires Arccore 2.8.0 "
+            "or later (Arcane 4.1.16), found ${TFEL_ARCCORE_VERSION}")
+  endif()
+  message(STATUS "Arccore version: ${TFEL_ARCCORE_VERSION}")
   set(TFEL_REQUIRES_CUDA ON)
   define_tfel_cxx_compiler("clang++")
 endif()
diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index f64f6a2f4..a4d95cd4f 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -1044,8 +1044,9 @@ so that an unqualified call to `max` or `min` in the code of a behaviour is
 resolved to the function of the standard library. The libraries are linked with the shared libraries
 of Arccore and with the shared `CUDA` runtime, as Arccore
 (`TFEL_ARCANE_LINKER_FLAGS` substitution). The `arcane` configuration
-requires an Arccore built with `CUDA` (`ARCCORE_ACCELERATOR_MODE=CUDA`) as
-shared libraries, found in `Arccore_ROOT`; the `HIP` queues are handled by
+requires Arccore 2.8.0 or later (Arcane 4.1.16), built with `CUDA`
+(`ARCCORE_ACCELERATOR_MODE=CUDA`) as shared libraries, found in
+`Arccore_ROOT`; the `HIP` queues are handled by
 the headers, but are not supported by the `arcane` configuration.
 
 This backend has no option.
diff --git a/docs/web/generic-parallel-material-property-interface.md b/docs/web/generic-parallel-material-property-interface.md
index 39c28afcb..5e20feb0a 100644
--- a/docs/web/generic-parallel-material-property-interface.md
+++ b/docs/web/generic-parallel-material-property-interface.md
@@ -901,7 +901,8 @@ are launched asynchronously, whatever the asynchronous state of the queue:
 a synchronous evaluation waits for the completion of the commands of the
 queue (`barrier`). The queue has a reference semantics: it must not be used
 by another thread during the call. With a `CUDA` or `HIP` queue, the stack
-size of the threads is increased if the kernel requires it. The source files (`.cu`
+size of the threads of the current device of the calling thread, which must
+be the device of the queue, is increased if the kernel requires it. The source files (`.cu`
 files) are compiled by `clang++` as a `CUDA` compiler and linked with the
 shared libraries of Arccore (see the `config-arcane.json` configuration
 file and the section of the behaviours).
