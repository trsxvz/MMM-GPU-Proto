From a64d95064a111564413913cf1c9859f458d174cc Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 20 Oct 2026 22:05:21 +0200
Subject: [PATCH] generic-parallel models: executed when a prediction is
 requested

As with the `generic` interface, whose models are executed whatever the
type of computation, the models of the `generic-parallel` interface are
now executed when a prediction is requested, and the state at the end of
the time step is updated. Previously, the model was skipped and the state
was not updated.

The integration strategy of the models declares it by the
`updates_state_on_prediction` member, read by `updatesStateOnPrediction`.
The comparison with the `generic` interface now also covers the models
with a prediction.
---
 .../generic-parallel-behaviour-interface.md   |  5 +++--
 .../GenericParallelBehaviour/Integrate.hxx    | 20 ++++++++++++++++++-
 .../ModelIntegrator.hxx                       | 19 ++++++++++--------
 .../behaviours/generic-parallel/compare.cxx   |  6 ++----
 4 files changed, 35 insertions(+), 15 deletions(-)

diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index 959080447..18f0b7b6e 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -525,8 +525,9 @@ function).
 
 As with the `generic` interface, the time step scaling factor is set to
 `0.1` at the points where the model fails. A model has no prediction
-operator: if a prediction is requested, the model is not executed and the
-state at the end of the time step is not updated. In device code, a bound
+operator: as with the `generic` interface, the model is executed and the
+state at the end of the time step is updated whatever the type of
+computation. In device code, a bound
 which is not satisfied makes the model fail and string parameters are not
 supported.
 
diff --git a/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
index e24714efc..5114654bc 100644
--- a/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
+++ b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
@@ -636,6 +636,23 @@ namespace mfront::gpb {
     recordStatus(d, i, r);
   }  // end of record
 
+  /*!
+   * \return if the state at the end of the time step is updated when a
+   * prediction is requested. The behaviours do not update it, as in the
+   * `generic` interface. The models do: the `generic` interface of the
+   * models executes them whatever the type of computation (see
+   * `ModelIntegrator`).
+   * \tparam Integrator: integration strategy
+   */
+  template <typename Integrator>
+  TFEL_HOST_DEVICE constexpr bool updatesStateOnPrediction() noexcept {
+    if constexpr (requires { Integrator::updates_state_on_prediction; }) {
+      return Integrator::updates_state_on_prediction;
+    } else {
+      return false;
+    }
+  }  // end of updatesStateOnPrediction
+
   /*!
    * \brief integrate the behaviour at the `i`-th point of a batch.
    *
@@ -670,7 +687,8 @@ namespace mfront::gpb {
         if (o.isPredictionRequested() || o.isTangentOperatorRequested()) {
           v.scatterTangentOperator();
         }
-        if (!o.isPredictionRequested()) {
+        if ((!o.isPredictionRequested()) ||
+            (updatesStateOnPrediction<Integrator>())) {
           v.scatterState();
           v.scatterEnergies();
         }
