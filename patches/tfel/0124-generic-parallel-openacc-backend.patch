diff --git a/cmake/modules/tfel.cmake b/cmake/modules/tfel.cmake
index 4db4b9e8b..5e2721836 100644
--- a/cmake/modules/tfel.cmake
+++ b/cmake/modules/tfel.cmake
@@ -549,7 +549,9 @@ set(_tfel-generic-parallel_supported_configurations
     "kokkos"
     "raja"
     "openmp-host-gcc"
-    "openmp-offload-nvhpc-gpu")
+    "openmp-offload-nvhpc-gpu"
+    "openacc-nvhpc-gpu"
+    "openacc-nvhpc-multicore")
 
 foreach(conf ${generic-parallel-configurations})
   if(NOT "${conf}" IN_LIST _tfel-generic-parallel_supported_configurations)
@@ -704,7 +706,9 @@ if((_tfel-enable-generic-parallel-stlpar-parunseq-gcc-configuration) OR
 endif()
 
 if((_tfel-enable-generic-parallel-stlpar-parunseq-nvhpc-gpu-configuration) OR
-   (_tfel-enable-generic-parallel-openmp-offload-nvhpc-gpu-configuration))
+   (_tfel-enable-generic-parallel-openmp-offload-nvhpc-gpu-configuration) OR
+   (_tfel-enable-generic-parallel-openacc-nvhpc-gpu-configuration) OR
+   (_tfel-enable-generic-parallel-openacc-nvhpc-multicore-configuration))
   define_tfel_cxx_compiler("nvhpc")
 endif()
 
diff --git a/docs/mfront/CompareToNumericalJacobian.md b/docs/mfront/CompareToNumericalJacobian.md
index 746dd51c5..51d913819 100644
--- a/docs/mfront/CompareToNumericalJacobian.md
+++ b/docs/mfront/CompareToNumericalJacobian.md
@@ -7,8 +7,8 @@ Jacobians are compared by blocks. Blocks for which the comparison
 failed are reported on the standard output. The comparison is thus only
 performed on the host: it is skipped in device code, and in the whole
 library with the compilers translating host and device code in a single
-pass (`nvc++ -stdpar=gpu`, `nvc++ -mp=gpu`, generic compiler of
-AdaptiveCpp).
+pass (`nvc++ -stdpar=gpu`, `nvc++ -mp=gpu`, `nvc++ -acc=gpu`, generic
+compiler of AdaptiveCpp).
 
 The comparison criterion value can be changed used the
 `@JacobianComparisonCriterion` keyword.
