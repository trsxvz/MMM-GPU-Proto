+   *   device when the computations are performed by an NVIDIA GPU (ignored
+   *   otherwise).
+   */
+  struct MFRONT_VISIBILITY_EXPORT OpenACCBackend final : AbstractBackend {
+    //! \brief default constructor
+    OpenACCBackend();
+    /*!
+     * \brief constructor
