From da0cb462db2354f28a65fc23dbfe3471cc533c9a Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 17:36:00 +0200
Subject: [PATCH] Messages and installation fixed

- tfel.cmake: the message listing the supported C++ compilers cites acpp.
- LogarithmicStrainIntegrate.hxx and GreenLagrangeStrainIntegrate.hxx: missing space in the message about the axial strain.
- The headers CUDABackend.hxx, HIPBackend.hxx, ParallelSTLBackend.hxx and SYCLBackend.hxx of the generic-parallel material properties are installed, as the other backends.
- DDIF2: the message about the constant components of the fracture stresses and energies describes the actual rule (the first component decides).
---
 cmake/modules/tfel.cmake                                      | 3 ++-
 mfront/include/CMakeLists.txt                                 | 4 ++++
 .../MFront/GenericBehaviour/GreenLagrangeStrainIntegrate.hxx  | 2 +-
 .../MFront/GenericBehaviour/LogarithmicStrainIntegrate.hxx    | 2 +-
 mfront/src/DDIF2StressPotential.cxx                           | 2 +-
 5 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/cmake/modules/tfel.cmake b/cmake/modules/tfel.cmake
index 28e7a96d6..6b356f337 100644
--- a/cmake/modules/tfel.cmake
+++ b/cmake/modules/tfel.cmake
@@ -528,7 +528,8 @@ function(define_tfel_cxx_compiler compiler)
    message(STATUS "TFEL_NVHPC_COMPILER: ${TFEL_NVHPC_COMPILER}")
  else()
    message(FATAL_ERROR "unsupported C++ compiler '${compiler}'. "
-           "Supported compilers are 'g++', 'clang++', 'icpx', 'nvhpc'")
+           "Supported compilers are 'g++', 'clang++', 'icpx', 'acpp', "
+           "'nvhpc'")
  endif()
 endfunction(define_tfel_cxx_compiler)
 
diff --git a/mfront/include/CMakeLists.txt b/mfront/include/CMakeLists.txt
index de414cbc6..acb944fd6 100644
--- a/mfront/include/CMakeLists.txt
+++ b/mfront/include/CMakeLists.txt
@@ -120,9 +120,13 @@ install_mfront_header(MFront/GenericParallel/MaterialProperty AbstractBackend.hx
 install_mfront_header(MFront/GenericParallel/MaterialProperty BackendBase.hxx)
 install_mfront_header(MFront/GenericParallel/MaterialProperty BackendFactory.hxx)
 install_mfront_header(MFront/GenericParallel/MaterialProperty CUDABackendBase.hxx)
+install_mfront_header(MFront/GenericParallel/MaterialProperty CUDABackend.hxx)
+install_mfront_header(MFront/GenericParallel/MaterialProperty HIPBackend.hxx)
 install_mfront_header(MFront/GenericParallel/MaterialProperty CxxProgrammingModelBackendBase.hxx)
 install_mfront_header(MFront/GenericParallel/MaterialProperty KokkosBackend.hxx)
 install_mfront_header(MFront/GenericParallel/MaterialProperty OpenMPBackend.hxx)
+install_mfront_header(MFront/GenericParallel/MaterialProperty ParallelSTLBackend.hxx)
+install_mfront_header(MFront/GenericParallel/MaterialProperty SYCLBackend.hxx)
 install_mfront_header(MFront GenericBehaviourInterface.hxx)
 install_mfront_header(MFront GenericBehaviourSymbolsGenerator.hxx)
 install_mfront_header(MFront BehaviourRotationFunctions.hxx)
diff --git a/mfront/include/MFront/GenericBehaviour/GreenLagrangeStrainIntegrate.hxx b/mfront/include/MFront/GenericBehaviour/GreenLagrangeStrainIntegrate.hxx
index 589e9d2c3..e17183b83 100644
--- a/mfront/include/MFront/GenericBehaviour/GreenLagrangeStrainIntegrate.hxx
+++ b/mfront/include/MFront/GenericBehaviour/GreenLagrangeStrainIntegrate.hxx
@@ -85,7 +85,7 @@ namespace mfront::gb::green_lagrange_strain {
           }
         } else {
           reportError(d,
-                      "The behaviour does not declare the axial strain"
+                      "The behaviour does not declare the axial strain "
                       "as an internal state variable");
           return false;
         }
diff --git a/mfront/include/MFront/GenericBehaviour/LogarithmicStrainIntegrate.hxx b/mfront/include/MFront/GenericBehaviour/LogarithmicStrainIntegrate.hxx
index 4813255aa..3e2c295fb 100644
--- a/mfront/include/MFront/GenericBehaviour/LogarithmicStrainIntegrate.hxx
+++ b/mfront/include/MFront/GenericBehaviour/LogarithmicStrainIntegrate.hxx
@@ -79,7 +79,7 @@ namespace mfront::gb::logarithmic_strain {
               std::exp(isvs[Traits::axial_strain_offset]));
         } else {
           reportError(d,
-                      "The behaviour does not declare the axial strain"
+                      "The behaviour does not declare the axial strain "
                       "as an internal state variable");
           return false;
         }
diff --git a/mfront/src/DDIF2StressPotential.cxx b/mfront/src/DDIF2StressPotential.cxx
index dc4e1bd13..37235b319 100644
--- a/mfront/src/DDIF2StressPotential.cxx
