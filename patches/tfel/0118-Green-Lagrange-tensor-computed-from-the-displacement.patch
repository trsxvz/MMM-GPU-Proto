From 9de48e9768eb6f2e8572a9b447ebb7005f2e68be Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 14 Oct 2026 19:51:20 +0200
Subject: [PATCH] Green-Lagrange tensor computed from the displacement gradient

computeGreenLagrangeTensorFromDisplacementGradient computes
(H + H^T + H^T H) / 2 from H = F - I. It has no cancellation when F is
close to the identity, contrary to (F^T F - I) / 2.
---
 include/TFEL/Math/Tensor/TensorConcept.hxx | 17 +++++++++++
 include/TFEL/Math/Tensor/TensorConcept.ixx | 33 ++++++++++++++++++++++
 2 files changed, 50 insertions(+)

diff --git a/include/TFEL/Math/Tensor/TensorConcept.hxx b/include/TFEL/Math/Tensor/TensorConcept.hxx
index dfc9b9350..4b480cc5f 100644
--- a/include/TFEL/Math/Tensor/TensorConcept.hxx
+++ b/include/TFEL/Math/Tensor/TensorConcept.hxx
@@ -188,6 +188,23 @@ namespace tfel::math {
    */
   TFEL_HOST_DEVICE constexpr auto computeGreenLagrangeTensor(
       const TensorConcept auto&) noexcept;
+  /*!
+   * \return the Green-Lagrange tensor computed from the displacement
+   * gradient \(H = F - I\):
+   *
+   * \[
+   * \frac{1}{2}\,\left(H + H^{T} + H^{T}\,H\right)
+   * \]
+   *
+   * This expression has no cancellation when \(F\) is close to the
+   * identity, contrary to \(\left(F^{T}\,F - I\right)/2\): the strain is
+   * computed with the relative precision of \(H\).
+   *
+   * \param[in] H: displacement gradient
+   */
+  TFEL_HOST_DEVICE constexpr auto
+  computeGreenLagrangeTensorFromDisplacementGradient(
+      const TensorConcept auto&) noexcept;
   /*!
    * compute the product:
    * \[F.s.F^{T}\]
diff --git a/include/TFEL/Math/Tensor/TensorConcept.ixx b/include/TFEL/Math/Tensor/TensorConcept.ixx
index 47727f881..da23df774 100644
--- a/include/TFEL/Math/Tensor/TensorConcept.ixx
+++ b/include/TFEL/Math/Tensor/TensorConcept.ixx
@@ -214,6 +214,39 @@ namespace tfel::math {
     }
   }  // end of computeGreenLagrangeTensor
 
+  TFEL_HOST_DEVICE constexpr auto
+  computeGreenLagrangeTensorFromDisplacementGradient(
+      const TensorConcept auto& t) noexcept {
+    using TensorType = decltype(t);
+    constexpr auto N = getSpaceDimension<TensorType>();
+    static_assert((N == 1) || (N == 2) || (N == 3), "invalid space dimension");
+    using Result = stensor<N, decltype(t(0) * t(0))>;
+    // the diagonal terms H_ii + (H^T H)_ii / 2 and the off-diagonal terms
+    // (H_ij + H_ji + (H^T H)_ij) / 2, stored multiplied by the square root
+    // of 2
+    if constexpr (N == 1u) {
+      return Result{t[0] + t[0] * t[0] / 2, t[1] + t[1] * t[1] / 2,
+                    t[2] + t[2] * t[2] / 2};
+    } else if constexpr (N == 2u) {
+      constexpr auto icste = Cste<numeric_type<TensorType>>::isqrt2;
+      return Result{t[0] + (t[0] * t[0] + t[4] * t[4]) / 2,
+                    t[1] + (t[1] * t[1] + t[3] * t[3]) / 2,  //
+                    t[2] + t[2] * t[2] / 2,                  //
+                    icste * (t[3] + t[4] + t[0] * t[3] + t[1] * t[4])};
+    } else if constexpr (N == 3u) {
+      constexpr auto icste = Cste<numeric_type<TensorType>>::isqrt2;
+      return Result{t[0] + (t[0] * t[0] + t[4] * t[4] + t[6] * t[6]) / 2,
+                    t[1] + (t[1] * t[1] + t[3] * t[3] + t[8] * t[8]) / 2,
+                    t[2] + (t[2] * t[2] + t[5] * t[5] + t[7] * t[7]) / 2,
+                    icste * (t[3] + t[4] +  //
+                             t[6] * t[8] + t[1] * t[4] + t[0] * t[3]),
+                    icste * (t[5] + t[6] +  //
+                             t[4] * t[7] + t[2] * t[6] + t[0] * t[5]),
+                    icste * (t[7] + t[8] +  //
+                             t[2] * t[8] + t[1] * t[7] + t[3] * t[5])};
+    }
+  }  // end of computeGreenLagrangeTensorFromDisplacementGradient
+
   TFEL_HOST_DEVICE constexpr auto pushForward(
       const StensorConcept auto& p, const TensorConcept auto& F) noexcept {
     return push_forward(p, F);
-- 
