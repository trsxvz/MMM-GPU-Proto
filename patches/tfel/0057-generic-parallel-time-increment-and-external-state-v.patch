From 1897ca55838dbd963951a153ce471376fa46e0ba Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 6 Oct 2026 22:54:31 +0200
Subject: [PATCH] generic-parallel: time increment and external state variables
 of the comparisons

The comparison program accepts the time increment (`--time-increment`)
and the values of the external state variables other than the temperature
(`--external-state-variables`), which were equal to the temperature.
---
 .../behaviours/generic-parallel/compare.cxx   | 26 +++++++++++++++----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/test-suite/behaviours/generic-parallel/compare.cxx b/test-suite/behaviours/generic-parallel/compare.cxx
index d812870a7..0053ed1ae 100644
--- a/test-suite/behaviours/generic-parallel/compare.cxx
+++ b/test-suite/behaviours/generic-parallel/compare.cxx
@@ -46,8 +46,11 @@
  * the library generated by the `generic` interface. The material properties
  * are given by the `--material-properties=<values>` option, the amplitude of
  * the random perturbation of the gradients by the `--amplitude=<value>`
- * option (`1e-3` by default) and the temperature by the
- * `--temperature=<value>` option (`293.15` by default).
+ * option (`1e-3` by default), the temperature by the `--temperature=<value>`
+ * option (`293.15` by default), the values of the other external state
+ * variables by the `--external-state-variables=<values>` option (the
+ * temperature by default) and the time increment by the
+ * `--time-increment=<value>` option (`1` by default).
  *
  * This file can be compiled by a C++ compiler, by a CUDA compiler or by a
  * HIP compiler. In the two last cases, the data are allocated in managed
@@ -977,6 +980,11 @@ struct Options {
   double amplitude = 1e-3;
   //! \brief temperature
   double temperature = 293.15;
+  //! \brief values of the external state variables other than the
+  //! temperature
+  std::vector<double> external_state_variables;
+  //! \brief time increment
+  double time_increment = 1;
   /*!
    * \brief initial values of the internal state variables of a point (a
    * single value is used for all the internal state variables)
@@ -1018,6 +1026,10 @@ static Options parseOptions(const int argc,
       r.amplitude = std::stod(v);
     } else if (o == "--temperature") {
       r.temperature = std::stod(v);
+    } else if (o == "--external-state-variables") {
+      r.external_state_variables = parseList(v);
+    } else if (o == "--time-increment") {
+      r.time_increment = std::stod(v);
     } else if (o == "--perturbation-of-internal-state-variables") {
       r.internal_state_variables_perturbation = std::stod(v);
     } else if (o == "--out-of-bounds-policy") {
@@ -1450,7 +1462,8 @@ int main(const int argc, const char* const* const argv) {
     fail(std::string{"usage: "} + argv[0] +
          " generic_library batch_library function "
          "[--material-properties=values] [--amplitude=value] "
-         "[--temperature=value] "
+         "[--temperature=value] [--external-state-variables=values] "
+         "[--time-increment=value] "
          "[--finite-strain=stress_measure,tangent_operator] "
          "[--initial-internal-state-variables=values] "
          "[--speed-of-sound=mass_density] [--energies=true] "
@@ -1490,7 +1503,7 @@ int main(const int argc, const char* const* const argv) {
                 .initial = States(n, s),
                 .identity = std::vector<double>(s.g, 0),
                 .n = n,
-                .dt = 1};
+                .dt = options.time_increment};
   // the identity, for the deformation gradients of finite strain behaviours
   if (t.options.finite_strain.finite_strain) {
     // the first three components of a tensor are its diagonal components
@@ -1509,8 +1522,11 @@ int main(const int argc, const char* const* const argv) {
     for (std::size_t j = 0; j != s.mp; ++j) {
       initial.mp[i * s.mp + j] = mp_values[j];
     }
+    // the temperature is the first external state variable
+    const auto& esvs = t.options.external_state_variables;
     for (std::size_t j = 0; j != s.esv; ++j) {
-      initial.esv0[i * s.esv + j] = initial.esv1[i * s.esv + j] = T;
+      initial.esv0[i * s.esv + j] = initial.esv1[i * s.esv + j] =
+          ((j == 0) || (j > esvs.size())) ? T : esvs[j - 1];
     }
   }
   initial.mass_density = t.options.mass_density;
-- 
2.43.0

