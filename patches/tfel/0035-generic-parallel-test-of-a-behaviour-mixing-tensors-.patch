diff --git a/test-suite/behaviours/generic-parallel/DefaultGenericSaintVenantKirchhoffElasticity.mfront b/test-suite/behaviours/generic-parallel/DefaultGenericSaintVenantKirchhoffElasticity.mfront
new file mode 100644
index 000000000..54ee1df46
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/DefaultGenericSaintVenantKirchhoffElasticity.mfront
@@ -0,0 +1,51 @@
+@DSL DefaultGenericBehaviour;
+@Behaviour DefaultGenericSaintVenantKirchhoffElasticity;
+@Description {
+  "Saint Venant-Kirchhoff hyperelastic behaviour written with the "
+  "DefaultGenericBehaviour DSL: the gradient is the deformation gradient "
+  "and the thermodynamic force is the first Piola-Kirchhoff stress. "
+  "The product of the deformation gradient (a tensor) by the second "
+  "Piola-Kirchhoff stress (a symmetric tensor) uses a tensor view of the "
+  "symmetric tensor. The tangent operator is converted by the tools of "
+  "the finite strain behaviours."
+}
+
+@Gradient DeformationGradientTensor F;
+F.setGlossaryName("DeformationGradient");
+
+@ThermodynamicForce StressTensor pk1;
+pk1.setEntryName("FirstPiolaKirchhoffStress");
+
+@MaterialProperty stress young;
+young.setGlossaryName("YoungModulus");
+@MaterialProperty real nu;
+nu.setGlossaryName("PoissonRatio");
+
+//! first Lamé coefficient
+@LocalVariable stress lambda;
+//! second Lamé coefficient
+@LocalVariable stress mu;
+//! second Piola-Kirchhoff stress
+@LocalVariable StressStensor S;
+
+@InitLocalVariables {
+  lambda = computeLambda(young, nu);
+  mu = computeMu(young, nu);
+}
+
+@Integrator {
+  const auto F1 = F + dF;
+  const auto e = computeGreenLagrangeTensor(F1);
+  S = lambda * trace(e) * StrainStensor::Id() + 2 * mu * e;
+  pk1 = F1 * S;
+}
+
+@TangentOperator {
+  static_cast<void>(smt);
+  const auto F1 = eval(F + dF);
+  const auto sig = convertSecondPiolaKirchhoffStressToCauchyStress(S, F1);
+  const auto De = eval(lambda * Stensor4::IxI() + 2 * mu * Stensor4::Id());
+  Dt = convert<FiniteStrainBehaviourTangentOperatorBase::DPK1_DF,
+               FiniteStrainBehaviourTangentOperatorBase::DS_DEGL>(De, F, F1,
+                                                                   sig);
+}
diff --git a/test-suite/behaviours/generic-parallel/compare-all.sh b/test-suite/behaviours/generic-parallel/compare-all.sh
index ac9c3a4a2..67b73707c 100644
--- a/test-suite/behaviours/generic-parallel/compare-all.sh
+++ b/test-suite/behaviours/generic-parallel/compare-all.sh
@@ -28,6 +28,13 @@ run GreenLagrangeImplicitNorton_Tridimensional 9 9 2 7 1 81 $fs=PK1,DPK1_DF
 run GreenLagrangeImplicitNorton_PlaneStrain 5 4 2 5 1 20 $fs=CAUCHY,DSIG_DF
 run SaintVenantKirchhoffElasticity_Tridimensional 9 6 2 0 1 54 $fs=CAUCHY,DSIG_DF
 run SaintVenantKirchhoffElasticity_Tridimensional 9 6 2 0 1 36 $fs=PK2,DS_DEGL
+# deformation gradient and first Piola-Kirchhoff stress declared as a
+# gradient and a thermodynamic force (DefaultGenericBehaviour DSL). The
+# --finite-strain option gives deformation gradients close to the identity.
+run DefaultGenericSaintVenantKirchhoffElasticity_Tridimensional 9 9 2 0 1 81 \
+  $fs=PK1,DPK1_DF
+run DefaultGenericSaintVenantKirchhoffElasticity_PlaneStrain 5 5 2 0 1 25 \
+  $fs=PK1,DPK1_DF
 # stored and dissipated energies, speed of sound
 run ImplicitNortonWithEnergies_Tridimensional 6 6 2 7 1 36 1e-3 150e9,0.3 \
   293.15 --speed-of-sound=7800 --energies=true
