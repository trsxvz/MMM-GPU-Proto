+/*!
+ * \file mfront/include/MFront/GenericParallel/OpenACCBackendExecutionPolicy.hxx
+ * \brief  This file declares the execution policy of the `openacc` backend
+ * of the `generic-parallel` interfaces.
+ * \date   22/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_OPENACCBACKENDEXECUTIONPOLICY_HXX
+#define LIB_MFRONT_GENERICPARALLEL_OPENACCBACKENDEXECUTIONPOLICY_HXX
+
+#include "MFront/GenericParallel/BackendExecutionPolicyBase.hxx"
+
+namespace mfront::generic_parallel {
+
+  /*!
+   * \brief execution policy of the `openacc` backend: the computations are
+   * performed synchronously, and only the common options are used
+   */
+  struct OpenACCBackendExecutionPolicy final : BackendExecutionPolicyBase {
+    //! \return the identifier of the policy
+    static constexpr const char* identifier() noexcept { return "openacc"; }
+    /*!
+     * \brief constructor
+     * \param[in] opts: common options
+     */
+    explicit OpenACCBackendExecutionPolicy(
+        const BackendExecutionCommonPolicy& opts = {}) noexcept
+        : BackendExecutionPolicyBase(opts) {}
+    const char* getIdentifier() const noexcept override { return identifier(); }
+  };  // end of struct OpenACCBackendExecutionPolicy
+
+  /*!
+   * \return an execution policy of the `openacc` backend
+   * \param[in] opts: common options
+   */
+  inline OpenACCBackendExecutionPolicy makeOpenACCBackendExecutionPolicy(
+      const BackendExecutionCommonPolicy& opts = {}) noexcept {
+    return OpenACCBackendExecutionPolicy{opts};
+  }  // end of makeOpenACCBackendExecutionPolicy
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_OPENACCBACKENDEXECUTIONPOLICY_HXX */
diff --git a/mfront/include/MFront/GenericParallel/OpenACCStackSize.hxx b/mfront/include/MFront/GenericParallel/OpenACCStackSize.hxx
new file mode 100644
index 000000000..61e529f01
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/OpenACCStackSize.hxx
@@ -0,0 +1,110 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/OpenACCStackSize.hxx
+ * \brief  This file declares a function increasing the stack size of the
+ * threads of the NVIDIA GPU used by OpenACC, shared by the openacc backends
+ * of the `generic-parallel` interfaces.
+ * \date   20/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_OPENACCSTACKSIZE_HXX
+#define LIB_MFRONT_GENERICPARALLEL_OPENACCSTACKSIZE_HXX
+
+#include <cstddef>
+#if defined(__NVCOMPILER_OPENACC_GPU)
+#include <mutex>
+#include <dlfcn.h>
+#include <openacc.h>
+#include "MFront/GenericParallel/DeviceStackSize.hxx"
+#endif /* defined(__NVCOMPILER_OPENACC_GPU) */
+
+namespace mfront::generic_parallel::openacc {
+
+  /*!
+   * \brief increase the stack size of the threads of the current NVIDIA GPU
+   * of OpenACC, if the code is compiled by `nvc++` for a GPU and if the
+   * current device type of OpenACC is an NVIDIA GPU. Nothing is done
+   * otherwise.
+   *
+   * The OpenACC runtime of `nvc++` uses the CUDA driver without the CUDA
+   * runtime: the stack size is set through the driver, on the CUDA context
+   * of OpenACC (`acc_get_current_cuda_context`), the device being
+   * initialized if needed. The driver is looked up among the loaded
+   * libraries, so that this function does not require the CUDA headers.
+   * The `NV_ACC_CUDA_STACKSIZE` environment variable of `nvc++` only sets
+   * the stack size when the device is initialized.
+   *
+   * \return true on success, false if the stack size could not be set or
+   * is too small and must be preserved
+   * \param[in] stack_size: minimal stack size, in bytes. Nothing is done if
+   * null.
+   * \param[in] preserve: if true, the stack size is only checked
+   */
+  inline bool setMinimalStackSize(const std::size_t stack_size,
+                                  const bool preserve = false) noexcept {
+#if defined(__NVCOMPILER_OPENACC_GPU)
+    // `CU_LIMIT_STACK_SIZE` in `CUlimit` and `CUDA_SUCCESS` in `CUresult`
+    constexpr int stack_size_limit = 0;
+    constexpr int success = 0;
+    using PushCurrent = int (*)(void*);
+    using PopCurrent = int (*)(void**);
+    using GetLimit = int (*)(std::size_t*, int);
+    using SetLimit = int (*)(int, std::size_t);
+    if ((stack_size == 0) || (acc_get_device_type() != acc_device_nvidia)) {
+      return true;
+    }
+    auto* context = acc_get_current_cuda_context();
+    if (context == nullptr) {
+      // initialization of the current device of OpenACC
+      acc_set_device_num(acc_get_device_num(acc_device_nvidia),
+                         acc_device_nvidia);
+      context = acc_get_current_cuda_context();
+    }
+    auto* const h = ::dlopen("libcuda.so.1", RTLD_LAZY | RTLD_NOLOAD);
+    if ((context == nullptr) || (h == nullptr)) {
+      if (h != nullptr) {
+        ::dlclose(h);
+      }
+      return false;
+    }
+    const auto push =
+        reinterpret_cast<PushCurrent>(::dlsym(h, "cuCtxPushCurrent_v2"));
+    const auto pop =
+        reinterpret_cast<PopCurrent>(::dlsym(h, "cuCtxPopCurrent_v2"));
+    const auto get_limit =
+        reinterpret_cast<GetLimit>(::dlsym(h, "cuCtxGetLimit"));
+    const auto set_limit =
+        reinterpret_cast<SetLimit>(::dlsym(h, "cuCtxSetLimit"));
+    auto r = (push != nullptr) && (pop != nullptr) &&  //
+             (get_limit != nullptr) && (set_limit != nullptr);
+    if (r) {
+      auto lock = std::lock_guard<std::mutex>{getStackSizeMutex()};
+      r = push(context) == success;
+      if (r) {
+        auto current = std::size_t{};
+        r = get_limit(&current, stack_size_limit) == success;
+        if ((r) && (current < stack_size)) {
+          r = (!preserve) &&
+              (set_limit(stack_size_limit, stack_size) == success);
+        }
+        void* previous = nullptr;
+        r = (pop(&previous) == success) && r;
+      }
+    }
+    ::dlclose(h);
+    return r;
+#else
+    static_cast<void>(stack_size);
+    static_cast<void>(preserve);
+    return true;
+#endif
+  }  // end of setMinimalStackSize
+
+}  // end of namespace mfront::generic_parallel::openacc
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_OPENACCSTACKSIZE_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/OpenACC.hxx b/mfront/include/MFront/GenericParallelBehaviour/OpenACC.hxx
new file mode 100644
index 000000000..74beef20b
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/OpenACC.hxx
@@ -0,0 +1,62 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/OpenACC.hxx
+ * \brief  This file declares the functions of the `openacc` backend of the
+ * `generic-parallel` behaviour interface which are specific to the
+ * behaviours. The primitive of the backend is declared in
+ * `MFront/GenericParallel/OpenACC.hxx`.
+ * \date   20/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_OPENACC_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_OPENACC_HXX
+
+#include <utility>
+#include <stdexcept>
+#include <type_traits>
+#include <openacc.h>
+#include "MFront/GenericParallel/OpenACC.hxx"
+#include "MFront/GenericParallelBehaviour/Integrate.hxx"
+
+namespace mfront::gpb::openacc {
+
+  /*!
+   * \return a copy of a data shared by all the integration points (see the
+   * `@SharedData` keyword) in the memory of the current device of OpenACC
+   * (`acc_malloc`), which is also accessible when the memory of the device
+   * is not unified with the one of the host. A copy is made at the first
+   * call on each device and is never freed, as with the `cuda` and `hip`
+   * backends.
+   * \tparam get_shared_data: function returning the data
+   */
+  template <auto get_shared_data>
+  const auto* getSharedDataCopy() {
+    using T = std::remove_cvref_t<decltype(get_shared_data())>;
+    static_assert(std::is_trivially_copyable_v<T>,
+                  "the shared data must be trivially copyable");
+    // device type and number of the current device
+    using Device = std::pair<int, int>;
+    static auto copies = SharedDataCopies<T, Device>{};
+    const auto type = acc_get_device_type();
+    const auto device =
+        Device{static_cast<int>(type), acc_get_device_num(type)};
+    return copies.get(device, [] {
+      auto v = get_shared_data();
+      auto* const p = static_cast<T*>(acc_malloc(sizeof(T)));
+      if (p == nullptr) {
+        throw std::runtime_error(
+            "mfront::gpb::openacc::getSharedDataCopy: allocation failed");
+      }
+      acc_memcpy_to_device(p, &v, sizeof(T));
+      return static_cast<const T*>(p);
+    });
+  }  // end of getSharedDataCopy
+
+}  // end of namespace mfront::gpb::openacc
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_OPENACC_HXX */
