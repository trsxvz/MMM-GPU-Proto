From 5c6c9e588dd0a8d388436e37b4e16cde45334abb Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 5 Oct 2026 23:06:55 +0200
Subject: [PATCH] MFront: bounds checks of the generic models reported in all
 compilation modes

The functions of the models always return false if a bounds check fails
and the generated code uses the execute method. When the device code is
selected in the whole translation unit (nvc++ -stdpar=gpu, generic
compiler of AdaptiveCpp), bounds checks return a boolean instead of
throwing an exception: the failures of the physical bounds were silently
ignored by the generic interface.
---
 .../include/MFront/GenericModelInterface.hxx  |  8 ++-
 mfront/src/GenericModelInterface.cxx          | 62 +++++++++----------
 2 files changed, 34 insertions(+), 36 deletions(-)

diff --git a/mfront/include/MFront/GenericModelInterface.hxx b/mfront/include/MFront/GenericModelInterface.hxx
index b3830e0a4..30ae1897e 100644
--- a/mfront/include/MFront/GenericModelInterface.hxx
+++ b/mfront/include/MFront/GenericModelInterface.hxx
@@ -25,8 +25,8 @@ namespace mfront {
     /*!
      * \brief if true, the class can be used in device code: its constructor
      * takes the behaviour data and a structure holding the values of the
-     * real parameters, its methods return false if a bounds check fails
-     * and an `execute` method executes all the functions of the model.
+     * real parameters, its methods are host and device functions and the
+     * material laws are evaluated by their device implementations.
      */
     bool device = false;
     //! \brief type of the structure holding the values of the parameters
@@ -36,7 +36,9 @@ namespace mfront {
   /*!
    * \brief write the class implementing a model in the `mfront::gm`
    * namespace, and the class holding the values of its real parameters (see
-   * `getGenericModelParametersInitializerName`)
+   * `getGenericModelParametersInitializerName`). Each function of the model
+   * is implemented by a method returning false if a bounds check fails, and
+   * the `execute` method executes all the functions of the model.
    * \param[out] os: output stream
    * \param[in] fd: file description
    * \param[in] md: model description
diff --git a/mfront/src/GenericModelInterface.cxx b/mfront/src/GenericModelInterface.cxx
index 8b17b7237..afd4e45d2 100644
--- a/mfront/src/GenericModelInterface.cxx
+++ b/mfront/src/GenericModelInterface.cxx
@@ -185,14 +185,14 @@ namespace mfront {
     if ((o.device) || (has_constructor)) {
       os << "{}\n\n";
     }
+    // the functions return false if a bounds check fails. On the host,
+    // bounds checks report failures by exceptions, but they return a boolean
+    // when the device code is selected in the whole translation unit (see
+    // the `TFEL_DEVICE_CODE` macro)
+    const auto annotation = o.device ? "TFEL_HOST_DEVICE " : "";
     for (const auto& f : md.functions) {
-      if (o.device) {
-        os << "TFEL_HOST_DEVICE bool execute_" << f.name
-           << "(mfront_gb_BehaviourData& mfront_model_data) const{\n";
-      } else {
-        os << "void execute_" << f.name
-           << "(mfront_gb_BehaviourData& mfront_model_data) const{\n";
-      }
+      os << annotation << "bool execute_" << f.name
+         << "(mfront_gb_BehaviourData& mfront_model_data) const{\n";
       os << "using namespace std;\n"
          << "using namespace tfel::math;\n"
          << "using namespace tfel::material;\n";
@@ -244,9 +244,7 @@ namespace mfront {
              << "]};\n";
         }
       }
-      // in device code, a failure of a bounds check is reported by the
-      // returned value
-      const auto on_failure = o.device ? "return false;" : "";
+      const auto on_failure = "return false;";
       auto write_physical_bounds = [&os, &raise, &on_failure](
                                        const VariableDescription& v,
                                        const std::string& n,
@@ -325,28 +323,24 @@ namespace mfront {
            << "]) = " << v.name << ";\n";
         static_cast<void>(vdepth);
       }
-      if (o.device) {
-        os << "return true;\n";
-      }
-      os << "} // end of execute_" << f.name << "\n\n";
+      os << "return true;\n"
+         << "} // end of execute_" << f.name << "\n\n";
     }
-    if (o.device) {
-      os << "//! \\brief execute all the functions of the model\n"
-         << "TFEL_HOST_DEVICE bool "
-         << "execute(mfront_gb_BehaviourData& mfront_model_data) const{\n"
-         << "return ";
-      if (md.functions.empty()) {
-        os << "true";
-      }
-      auto first_function = true;
-      for (const auto& f : md.functions) {
-        os << (first_function ? "" : " &&\n") << "this->execute_" << f.name
-           << "(mfront_model_data)";
-        first_function = false;
-      }
-      os << ";\n"
-         << "} // end of execute\n\n";
+    os << "//! \\brief execute all the functions of the model\n"
+       << annotation << "bool "
+       << "execute(mfront_gb_BehaviourData& mfront_model_data) const{\n"
+       << "return ";
+    if (md.functions.empty()) {
+      os << "true";
+    }
+    auto first_function = true;
+    for (const auto& f : md.functions) {
+      os << (first_function ? "" : " &&\n") << "this->execute_" << f.name
+         << "(mfront_model_data)";
+      first_function = false;
     }
+    os << ";\n"
+       << "} // end of execute\n\n";
     os << "private:\n";
     if (!md.members.empty()) {
       os << md.members << "\n\n";
@@ -577,9 +571,11 @@ namespace mfront {
     } else {
       os << "const " << md.className << " m;\n";
     }
-    for (const auto& f : md.functions) {
-      os << "m.execute_" << f.name << "(d);\n";
-    }
+    os << "if(!m.execute(d)){\n"
+       << "mfront::gb::reportError(d, \"model execution failed\");\n"
+       << "*(d.rdt) = 0.1;\n"
+       << "return -1;\n"
+       << "}\n";
     os << "} catch(...){\n"
        << "mfront::gb::reportFailureByException(d);\n"
        << "*(d.rdt) = 0.1;\n"
-- 
2.43.0

