From d38e4e70abcc65a30b86d59c77e3fc633f4917e0 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 17:58:57 +0200
Subject: [PATCH] MFront: configuration files searched where they are installed
 with a suffix

With TFEL_APPEND_SUFFIX, the configuration files are installed in
share/tfel-<suffix>/mfront/configuration-files (TFEL_DATAROOTDIR), while
MFront searched share/tfel/mfront-<suffix>/configuration-files, so that
they were not found unless given by their path, --search-path or
MFRONT_INCLUDE_PATH. MFront now searches the directory where they are
installed; the stray tokens after the #else are removed. The pages of the
generic-parallel interface and the release notes are updated.

The suffixed path was checked by compiling the same expression; the TFEL
build of the prototype has no suffix.
---
 docs/web/generic-parallel-behaviour-interface.md |  7 ++-----
 docs/web/release-notes-5.2.md                    |  8 +++-----
 mfront/src/SearchPathsHandler.cxx                | 10 ++++++----
 3 files changed, 11 insertions(+), 14 deletions(-)

diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index c6463137b..cd7d507e4 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -537,11 +537,8 @@ by the `MFRONT_INCLUDE_PATH` environment variable, then in this directory.
 
 > **Note**
 >
-> If `TFEL_APPEND_SUFFIX` is set, the files are installed in
-> `share/tfel-<suffix>/mfront/configuration-files`, whereas `MFront`
-> searches `share/tfel/mfront-<suffix>/configuration-files`: the
-> configuration files must then be given by their path, or found through
-> the `--search-path` option or the `MFRONT_INCLUDE_PATH` variable.
+> If `TFEL_APPEND_SUFFIX` is set, the files are installed in, and searched
+> by `MFront` in, `share/tfel-<suffix>/mfront/configuration-files`.
 
 | Configuration file                      | Backend  | Compiler and target                                   |
 |:----------------------------------------|:---------|:------------------------------------------------------|
diff --git a/docs/web/release-notes-5.2.md b/docs/web/release-notes-5.2.md
index 580475a23..f8e3a628f 100644
--- a/docs/web/release-notes-5.2.md
+++ b/docs/web/release-notes-5.2.md
@@ -185,11 +185,9 @@ If a file given by the `--configuration-file` option is not found in the
 current directory, `MFront` searches it in the directories given by the
 preceding `--search-path` options, then in the directories listed by the
 `MFRONT_INCLUDE_PATH` variable, then in
-`share/tfel/mfront/configuration-files`. If `TFEL_APPEND_SUFFIX` is set,
-`MFront` searches `share/tfel/mfront-<suffix>/configuration-files`
-instead, where the configuration files are not installed: they must then
-be found through the `--search-path` option or the `MFRONT_INCLUDE_PATH`
-variable.
+`share/tfel/mfront/configuration-files` (or
+`share/tfel-<suffix>/mfront/configuration-files` if `TFEL_APPEND_SUFFIX`
+is set).
 
 ## Add a `build-tests` target
 
diff --git a/mfront/src/SearchPathsHandler.cxx b/mfront/src/SearchPathsHandler.cxx
index 92972ad4f..8acd68a11 100644
--- a/mfront/src/SearchPathsHandler.cxx
+++ b/mfront/src/SearchPathsHandler.cxx
@@ -300,13 +300,15 @@ namespace mfront {
   }  // end of resetPaths
 
   SearchPathsHandler::SearchPathsHandler() {
-    // adding path to configuration files generated automatically
+    // adding path to configuration files generated automatically, installed
+    // in the `mfront/configuration-files` subdirectory of the data directory
+    // of TFEL (`TFEL_DATAROOTDIR` in `cmake/modules/tfel.cmake`)
     const auto root = tfel::getInstallPath();
     const auto ds = tfel::system::dirSeparator();
 #ifdef TFEL_APPEND_SUFFIX
-    this->paths.push_back(root + ds + "share" + ds + "tfel" + ds +
-                          "mfront-" TFEL_SUFFIX + ds + "configuration-files");
-#else "+ds+" * TFEL_APPEND_SUFFIX * "+ds+"
+    this->paths.push_back(root + ds + "share" + ds + "tfel-" TFEL_SUFFIX + ds +
+                          "mfront" + ds + "configuration-files");
+#else  /* TFEL_APPEND_SUFFIX */
     this->paths.push_back(root + ds + "share" + ds + "tfel" + ds + "mfront" +
                           ds + "configuration-files");
 #endif /* TFEL_APPEND_SUFFIX */
-- 
2.43.0

