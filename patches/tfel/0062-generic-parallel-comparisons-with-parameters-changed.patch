From 333edbf6ac03025f2fc8b5af22f11de9202b7a3b Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 7 Oct 2026 03:26:15 +0200
Subject: [PATCH] generic-parallel: comparisons with parameters changed at
 runtime

The generated functions read the values of the parameters on the host at
each call, but no comparison changed them. The `--parameters` option of
the comparison program changes the values of some parameters in both
libraries. The parameters of a behaviour and of a model are now changed in
two comparisons, which fail if the batch ignores the new values.
---
 .../generic-parallel/compare-all.sh           |  6 +++
 .../behaviours/generic-parallel/compare.cxx   | 45 ++++++++++++++++++-
 2 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/test-suite/behaviours/generic-parallel/compare-all.sh b/test-suite/behaviours/generic-parallel/compare-all.sh
index 86c905d2e..651f6bc6b 100644
--- a/test-suite/behaviours/generic-parallel/compare-all.sh
+++ b/test-suite/behaviours/generic-parallel/compare-all.sh
@@ -16,6 +16,10 @@ run HosfordPerfectPlasticity_Tridimensional --amplitude=5e-4
 # elastic properties given by a material law evaluated on the device, and
 # quantities
 run StrainHardeningCreep3_Tridimensional --temperature=600
+# parameters changed in both libraries: the generated functions read their
+# values on the host at each call
+run IsotropicLinearHardeningPlasticity_Tridimensional --amplitude=3e-3 \
+  --parameters=YoungModulus=150e9,PoissonRatio=0.3,HardeningSlope=5e9,YieldStrength=200e6
 # isotropic DSLs: creep, and several flows with an isotropic hardening rule.
 # The MultipleIsotropicMisesFlows DSL does not provide a consistent tangent
 # operator: the generic interface rejects the requests of tangent operators.
@@ -182,6 +186,8 @@ run GenericParallelModelTest_Tridimensional --material-properties=500 \
 run GenericParallelModelTest_PlaneStress --material-properties=500 \
   --amplitude=0 --temperature=600 \
   --perturbation-of-internal-state-variables=1e-4
+run GenericParallelModelTest_Tridimensional --material-properties=500 \
+  --amplitude=0 --temperature=600 --parameters=SwellingCoefficient=1e-3
 run GenericParallelModelWithQuantitiesTest_Axisymmetrical --amplitude=0 \
   --temperature=600
 exit $status
diff --git a/test-suite/behaviours/generic-parallel/compare.cxx b/test-suite/behaviours/generic-parallel/compare.cxx
index 5d1bb387a..b3fce7cd5 100644
--- a/test-suite/behaviours/generic-parallel/compare.cxx
+++ b/test-suite/behaviours/generic-parallel/compare.cxx
@@ -33,6 +33,9 @@
  * sets the out of bounds policy in both libraries: those options allow to
  * test batches where the integration fails at some points.
  *
+ * The `--parameters=<name>=<value>,...` option changes the values of some
+ * parameters in both libraries.
+ *
  * The `--initial-internal-state-variables=<values>` option gives the initial
  * values of the internal state variables of a point (null by default), as a
  * comma separated list, a single value being used for all the internal state
@@ -922,6 +925,26 @@ static std::vector<double> parseList(const std::string& l) {
   return r;
 }
 
+/*!
+ * \return the names and values of parameters
+ * \param[in] l: comma separated list of `name=value` pairs
+ */
+static std::vector<std::pair<std::string, double>> parseParameters(
+    const std::string& l) {
+  auto r = std::vector<std::pair<std::string, double>>{};
+  for (auto v = l; !v.empty();) {
+    const auto c = v.find(',');
+    const auto p = v.substr(0, c);
+    const auto e = p.find('=');
+    if (e == std::string::npos) {
+      fail("invalid parameter '" + p + "'");
+    }
+    r.emplace_back(p.substr(0, e), std::stod(p.substr(e + 1)));
+    v = c == std::string::npos ? "" : v.substr(c + 1);
+  }
+  return r;
+}
+
 /*!
  * \return the options of finite strain behaviours
  * \param[in] o: stress measure and tangent operator, separated by a comma
@@ -1015,6 +1038,8 @@ struct Options {
   //! \brief out of bounds policy (0: None, 1: Warning, 2: Strict), if
   //! positive
   int out_of_bounds_policy = -1;
+  //! \brief names and values of the parameters changed in both libraries
+  std::vector<std::pair<std::string, double>> parameters;
 };
 
 //! \return the optional arguments
@@ -1057,6 +1082,8 @@ static Options parseOptions(const int argc,
       r.mass_density = std::stod(v);
     } else if (o == "--initial-internal-state-variables") {
       r.initial_internal_state_variables = parseList(v);
+    } else if (o == "--parameters") {
+      r.parameters = parseParameters(v);
     } else {
       fail("invalid option '" + o + "'");
     }
@@ -1481,7 +1508,8 @@ int main(const int argc, const char* const* const argv) {
          "[--speed-of-sound=mass_density] [--energies=true] "
          "[--tangent-operator=type] "
          "[--perturbation-of-internal-state-variables=amplitude] "
-         "[--out-of-bounds-policy=policy]");
+         "[--out-of-bounds-policy=policy] "
+         "[--parameters=name=value,...]");
   }
   [[maybe_unused]] const auto runtime = Runtime{};
   const auto name = parseFunctionName(argv[3]);
@@ -1562,6 +1590,21 @@ int main(const int argc, const char* const* const argv) {
       f(t.options.out_of_bounds_policy);
     }
   }
+  // parameters, changed in both libraries (the setter is specific to the
+  // modelling hypothesis if the behaviour does not support all of them)
+  using SetParameter = int (*)(const char* const, const double);
+  for (const auto& [pname, pvalue] : t.options.parameters) {
+    for (const auto& l : {t.generic_library, t.batch_library}) {
+      const auto f = reinterpret_cast<SetParameter>(
+          const_cast<void*>(findSymbol(l, t.name, "setParameter")));
+      if (f == nullptr) {
+        fail("no function changing the parameters in '" + l + "'");
+      }
+      if (f(pname.c_str(), pvalue) == 0) {
+        fail("can't set the parameter '" + pname + "'");
+      }
+    }
+  }
   if (t.mode != Mode::INTEGRATION) {
     // initialize functions and post-processings are executed on arbitrary
     // states: stress-like thermodynamic forces and small positive internal
-- 
2.43.0

