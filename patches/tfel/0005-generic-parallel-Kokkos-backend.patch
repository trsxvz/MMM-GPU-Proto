+/*!
+ * \file   mfront/include/MFront/GenericParallel/KokkosBackend.hxx
+ * \brief  This file declares the Kokkos backend of the `generic-parallel`
+ * interfaces
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_KOKKOSBACKEND_HXX
+#define LIB_MFRONT_GENERICPARALLEL_KOKKOSBACKEND_HXX
+
+#include "TFEL/Utilities/Data.hxx"
+#include "MFront/MFrontConfig.hxx"
+#include "MFront/GenericParallel/AbstractBackend.hxx"
+
+namespace mfront::generic_parallel {
+
+  /*!
+   * \brief backend based on Kokkos.
+   *
+   * The generated library must be compiled with the compiler used to build
+   * Kokkos (for instance `nvcc_wrapper`) and linked with a shared build of
+   * Kokkos, which is shared with the calling code.
+   *
+   * Options:
+   *
+   * - `execution_space`: execution space (`Kokkos::DefaultExecutionSpace` by
+   *   default), for instance `Kokkos::DefaultHostExecutionSpace`.
+   */
+  struct MFRONT_VISIBILITY_EXPORT KokkosBackend final : AbstractBackend {
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    KokkosBackend(const tfel::utilities::DataMap&);
+    //
+    [[nodiscard]] std::string getName() const override;
+    [[nodiscard]] std::string getSourceFileExtension() const override;
+    void writeSpecificIncludes(std::ostream&, const Runtime) const override;
+    [[nodiscard]] std::string getApply() const override;
+    [[nodiscard]] std::string getMemorySpace() const override;
+    [[nodiscard]] std::string getExecutionPolicyType() const override;
+    [[nodiscard]] std::string getSharedDataCopy(
+        std::string_view, std::string_view) const override;
+    //! \brief destructor
+    ~KokkosBackend() noexcept override;
+
+   private:
+    //! \brief execution space
+    std::string execution_space = "Kokkos::DefaultExecutionSpace";
+  };  // end of KokkosBackend
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_KOKKOSBACKEND_HXX */
diff --git a/mfront/include/MFront/GenericParallel/KokkosBackendExecutionPolicy.hxx b/mfront/include/MFront/GenericParallel/KokkosBackendExecutionPolicy.hxx
new file mode 100644
index 000000000..da38349a7
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/KokkosBackendExecutionPolicy.hxx
@@ -0,0 +1,83 @@
+/*!
+ * \file mfront/include/MFront/GenericParallel/KokkosBackendExecutionPolicy.hxx
+ * \brief  This file declares the execution policy of the `kokkos` backend of
+ * the `generic-parallel` interfaces: a class template on the execution
+ * space, whose identifier is made of the name of the backend and of the
+ * name of the execution space.
+ * \date   22/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_KOKKOSBACKENDEXECUTIONPOLICY_HXX
+#define LIB_MFRONT_GENERICPARALLEL_KOKKOSBACKENDEXECUTIONPOLICY_HXX
+
+#include <string>
+#include <Kokkos_Core.hpp>
+#include "MFront/GenericParallel/BackendExecutionPolicyBase.hxx"
+
+namespace mfront::generic_parallel {
+
+  //! \brief options of the execution policy of the `kokkos` backend
+  template <typename ExecutionSpace>
+  struct KokkosBackendExecutionOptions {
+    //! \brief common options
+    BackendExecutionCommonPolicy common_options;
+    /*!
+     * \brief instance of the execution space on which the kernels are
+     * launched, the default instance by default (Kokkos must then be
+     * initialized when the options are built)
+     */
+    ExecutionSpace execution_space = ExecutionSpace{};
+  };  // end of struct KokkosBackendExecutionOptions
+
+  /*!
+   * \brief execution policy of the `kokkos` backend
+   * \tparam ExecutionSpace: execution space, which must be the one selected
+   * by the `execution_space` option of the backend
+   */
+  template <typename ExecutionSpace>
+  struct KokkosBackendExecutionPolicy final : BackendExecutionPolicyBase {
+    /*!
+     * \return the identifier of the policy, for instance "kokkos:Cuda". The
+     * string is never destroyed, so that it lives as long as the program,
+     * as the identifiers of the other policies (string literals). Contrary
+     * to them, this identifier is not a constant expression (the name of
+     * the execution space is not one with all the versions of Kokkos): the
+     * symbol exporting it is initialized when the library is loaded.
+     */
+    static const char* identifier() noexcept {
+      static const auto* const id =
+          new std::string{std::string{"kokkos:"} + ExecutionSpace::name()};
+      return id->c_str();
+    }
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    explicit KokkosBackendExecutionPolicy(
+        const KokkosBackendExecutionOptions<ExecutionSpace>& opts = {})
+        : BackendExecutionPolicyBase(opts.common_options),
+          execution_space(opts.execution_space) {}
+    const char* getIdentifier() const noexcept override { return identifier(); }
+    //! \brief instance of the execution space
+    ExecutionSpace execution_space;
+  };  // end of struct KokkosBackendExecutionPolicy
+
+  /*!
+   * \return an execution policy of the `kokkos` backend
+   * \param[in] opts: options
+   */
+  template <typename ExecutionSpace>
+  KokkosBackendExecutionPolicy<ExecutionSpace> makeKokkosBackendExecutionPolicy(
+      const KokkosBackendExecutionOptions<ExecutionSpace>& opts = {}) {
+    return KokkosBackendExecutionPolicy<ExecutionSpace>{opts};
+  }  // end of makeKokkosBackendExecutionPolicy
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_KOKKOSBACKENDEXECUTIONPOLICY_HXX */
diff --git a/mfront/include/MFront/GenericParallel/KokkosStackSize.hxx b/mfront/include/MFront/GenericParallel/KokkosStackSize.hxx
new file mode 100644
index 000000000..f6c48b350
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/KokkosStackSize.hxx
@@ -0,0 +1,80 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/KokkosStackSize.hxx
+ * \brief  This file declares a function adapting the stack size of the
+ * threads of the device to a function applied by `Kokkos`, shared by the
+ * `generic-parallel` interfaces for behaviours and for material
+ * properties.
+ * \date   08/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_KOKKOSSTACKSIZE_HXX
+#define LIB_MFRONT_GENERICPARALLEL_KOKKOSSTACKSIZE_HXX
+
+#include <string>
+#include <type_traits>
+#include <Kokkos_Core.hpp>
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+#include "MFront/GenericParallel/GPUStackSize.hxx"
+#endif
+
+namespace mfront::generic_parallel::kokkos {
+
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+
+  /*!
+   * \brief kernel which is never launched: its attributes give the stack
+   * size required to apply a function at one point. Kokkos does not
+   * increase the stack size of the threads, which is too small by default
+   * for some behaviours.
+   */
+  template <typename Function>
+  __global__ void stackSizeProbe(const Function f) {
+    f(0);
+  }  // end of stackSizeProbe
+
+#endif /* defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP) */
+
+  /*!
+   * \brief increase the stack size of the threads of the device if the
+   * given function, applied at one point in the given execution space,
+   * requires it. Nothing is done if the execution space is not a CUDA or a
+   * HIP execution space.
+   * \return an error message, empty on success
+   * \tparam ExecutionSpace: execution space
+   * \param[in] f: function applied at one point
+   * \param[in] preserve: if true, the stack size is not modified, and an
+   * error is returned if it is too small
+   */
+  template <typename ExecutionSpace, typename Function>
+  std::string ensureStackSize(const Function& f, const bool preserve) {
+#if defined(KOKKOS_ENABLE_CUDA)
+    constexpr auto device = std::is_same_v<ExecutionSpace, Kokkos::Cuda>;
+#elif defined(KOKKOS_ENABLE_HIP)
+    constexpr auto device = std::is_same_v<ExecutionSpace, Kokkos::HIP>;
+#else
+    constexpr auto device = false;
+#endif
+    static_cast<void>(f);
+    static_cast<void>(preserve);
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+    if constexpr (device) {
+      const auto r = gpu::ensureStackSize<stackSizeProbe<Function>>(preserve);
+      if (!r.succeeded()) {
+        return r.getErrorMessage();
+      }
+    }
+#else
+    static_cast<void>(device);
+#endif
+    return {};
+  }  // end of ensureStackSize
+
+}  // end of namespace mfront::generic_parallel::kokkos
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_KOKKOSSTACKSIZE_HXX */
