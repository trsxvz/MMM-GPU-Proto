+/*!
+ * \file   mfront/include/MFront/GenericParallel/RAJABackend.hxx
+ * \brief  This file declares the RAJA backend of the `generic-parallel`
+ * interfaces
+ * \date   20/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_RAJABACKEND_HXX
+#define LIB_MFRONT_GENERICPARALLEL_RAJABACKEND_HXX
+
+#include "TFEL/Utilities/Data.hxx"
+#include "MFront/MFrontConfig.hxx"
+#include "MFront/GenericParallel/AbstractBackend.hxx"
+
+namespace mfront::generic_parallel {
+
+  /*!
+   * \brief backend based on RAJA.
+   *
+   * The generated library must be compiled with a compiler supporting the
+   * execution policy (for instance `nvcc` with extended lambdas for the
+   * policies of CUDA) and linked with RAJA.
+   *
+   * Options:
+   *
+   * - `execution_policy`: execution policy of RAJA
+   *   (`mfront::generic_parallel::raja::DefaultExecutionPolicy` by default,
+   *   see `MFront/GenericParallel/RAJAExecutionPolicy.hxx`), for instance
+   *   `RAJA::cuda_exec<128>` or `RAJA::omp_parallel_for_exec`. The
+   *   execution policies of OpenMP target and SYCL are not supported.
+   *
+   * The execution policy of the backend (`RAJABackendExecutionPolicy`)
+   * holds a resource of camp matching the execution policy of RAJA. With
+   * the default policy, the default stream of the current device is used
+   * with CUDA and HIP, the default resource of camp otherwise (see
+   * `mfront::generic_parallel::raja::getDefaultResource`).
+   */
+  struct MFRONT_VISIBILITY_EXPORT RAJABackend final : AbstractBackend {
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    RAJABackend(const tfel::utilities::DataMap&);
+    //
+    [[nodiscard]] std::string getName() const override;
+    [[nodiscard]] std::string getSourceFileExtension() const override;
+    void writeSpecificIncludes(std::ostream&, const Runtime) const override;
+    [[nodiscard]] std::string getApply() const override;
+    [[nodiscard]] std::string getMemorySpace() const override;
+    [[nodiscard]] std::string getExecutionPolicyType() const override;
+    [[nodiscard]] std::string getSharedDataCopy(
+        std::string_view, std::string_view) const override;
+    //! \brief destructor
+    ~RAJABackend() noexcept override;
+
+   private:
+    //! \brief execution policy
+    std::string execution_policy =
+        "mfront::generic_parallel::raja::DefaultExecutionPolicy";
+  };  // end of RAJABackend
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_RAJABACKEND_HXX */
diff --git a/mfront/include/MFront/GenericParallel/RAJABackendExecutionPolicy.hxx b/mfront/include/MFront/GenericParallel/RAJABackendExecutionPolicy.hxx
new file mode 100644
index 000000000..b4faa5e70
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/RAJABackendExecutionPolicy.hxx
@@ -0,0 +1,104 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/RAJABackendExecutionPolicy.hxx
+ * \brief  This file declares the execution policy of the `raja` backend of
+ * the `generic-parallel` interfaces: a class template on the resource of
+ * camp associated with the execution policy of RAJA selected by the
+ * backend, whose identifier is made of the name of the backend and of the
+ * platform of the resource.
+ * \date   22/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_RAJABACKENDEXECUTIONPOLICY_HXX
+#define LIB_MFRONT_GENERICPARALLEL_RAJABACKENDEXECUTIONPOLICY_HXX
+
+#include "MFront/GenericParallel/RAJAExecutionPolicy.hxx"
+#include "MFront/GenericParallel/BackendExecutionPolicyBase.hxx"
+
+namespace mfront::generic_parallel {
+
+  namespace raja {
+
+    /*!
+     * \brief identifier of the policies using a resource of camp, null for
+     * the resources which are not supported (see
+     * `isSupportedExecutionPolicy`)
+     */
+    template <typename ResourceType>
+    inline constexpr const char* policy_identifier = nullptr;
+    //! \brief specialisation for the host
+    template <>
+    inline constexpr const char* policy_identifier<camp::resources::Host> =
+        "raja:host";
+#if defined(RAJA_CUDA_ACTIVE)
+    //! \brief specialisation for CUDA
+    template <>
+    inline constexpr const char* policy_identifier<camp::resources::Cuda> =
+        "raja:cuda";
+#endif
+#if defined(RAJA_HIP_ACTIVE)
+    //! \brief specialisation for HIP
+    template <>
+    inline constexpr const char* policy_identifier<camp::resources::Hip> =
+        "raja:hip";
+#endif
+
+  }  // end of namespace raja
+
+  //! \brief options of the execution policy of the `raja` backend
+  template <typename ResourceType>
+  struct RAJABackendExecutionOptions {
+    //! \brief common options
+    BackendExecutionCommonPolicy common_options;
+    /*!
+     * \brief resource on which the loops are executed, the default resource
+     * by default (see `raja::getDefaultResourceOfType`)
+     */
+    ResourceType resource = raja::getDefaultResourceOfType<ResourceType>();
+  };  // end of struct RAJABackendExecutionOptions
+
+  /*!
+   * \brief execution policy of the `raja` backend
+   * \tparam ResourceType: resource of camp associated with the execution
+   * policy of RAJA selected by the `execution_policy` option of the backend
+   * (see `raja::Resource`)
+   */
+  template <typename ResourceType>
+  struct RAJABackendExecutionPolicy final : BackendExecutionPolicyBase {
+    static_assert(raja::policy_identifier<ResourceType> != nullptr,
+                  "unsupported resource");
+    //! \return the identifier of the policy, for instance "raja:cuda"
+    static constexpr const char* identifier() noexcept {
+      return raja::policy_identifier<ResourceType>;
+    }
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    explicit RAJABackendExecutionPolicy(
+        const RAJABackendExecutionOptions<ResourceType>& opts = {})
+        : BackendExecutionPolicyBase(opts.common_options),
+          resource(opts.resource) {}
+    const char* getIdentifier() const noexcept override { return identifier(); }
+    //! \brief resource on which the loops are executed
+    ResourceType resource;
+  };  // end of struct RAJABackendExecutionPolicy
+
+  /*!
+   * \return an execution policy of the `raja` backend
+   * \param[in] opts: options
+   */
+  template <typename ResourceType>
+  RAJABackendExecutionPolicy<ResourceType> makeRAJABackendExecutionPolicy(
+      const RAJABackendExecutionOptions<ResourceType>& opts = {}) {
+    return RAJABackendExecutionPolicy<ResourceType>{opts};
+  }  // end of makeRAJABackendExecutionPolicy
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_RAJABACKENDEXECUTIONPOLICY_HXX */
diff --git a/mfront/include/MFront/GenericParallel/RAJAExecutionPolicy.hxx b/mfront/include/MFront/GenericParallel/RAJAExecutionPolicy.hxx
new file mode 100644
index 000000000..aba717d07
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/RAJAExecutionPolicy.hxx
@@ -0,0 +1,185 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/RAJAExecutionPolicy.hxx
+ * \brief  This file declares the default execution policies of the raja
+ * backends of the `generic-parallel` interfaces, and the functions common to
+ * these backends.
+ * \date   20/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_RAJAEXECUTIONPOLICY_HXX
+#define LIB_MFRONT_GENERICPARALLEL_RAJAEXECUTIONPOLICY_HXX
+
+#include <string>
+#include <type_traits>
+#include "RAJA/RAJA.hpp"
+#if defined(RAJA_CUDA_ACTIVE) || defined(RAJA_HIP_ACTIVE)
+#include "MFront/GenericParallel/GPUStackSize.hxx"
+#endif
+
+namespace mfront::generic_parallel::raja {
+
+  /*!
+   * \brief default execution policy: the asynchronous loop of the GPU if the
+   * code is compiled for CUDA or HIP (128 threads per block, as the default
+   * of the `cuda` and `hip` backends), the parallel loop of OpenMP if RAJA
+   * is built with OpenMP, the sequential loop otherwise.
+   */
+#if defined(RAJA_CUDA_ACTIVE)
+  using DefaultExecutionPolicy = RAJA::cuda_exec_async<128>;
+#elif defined(RAJA_HIP_ACTIVE)
+  using DefaultExecutionPolicy = RAJA::hip_exec_async<128>;
+#elif defined(RAJA_ENABLE_OPENMP)
+  using DefaultExecutionPolicy = RAJA::omp_parallel_for_exec;
+#else
+  using DefaultExecutionPolicy = RAJA::seq_exec;
+#endif
+
+  /*!
+   * \brief default execution policy on the host: the parallel loop of
+   * OpenMP if RAJA is built with OpenMP, the sequential loop otherwise.
+   */
+#if defined(RAJA_ENABLE_OPENMP)
+  using DefaultHostExecutionPolicy = RAJA::omp_parallel_for_exec;
+#else
+  using DefaultHostExecutionPolicy = RAJA::seq_exec;
+#endif
+
+  /*!
+   * \brief true if the execution policy is supported by the raja backends:
+   * the policies of OpenMP target and SYCL are refused, since the resources
+   * of camp associated with them can't allocate the managed memory holding
+   * the statistics, and since the `raja` configuration of TFEL only
+   * compiles for CUDA and for the host
+   */
+  template <typename ExecutionPolicy>
+  inline constexpr bool isSupportedExecutionPolicy =
+      !(RAJA::type_traits::is_target_openmp_policy<ExecutionPolicy>::value ||
+        RAJA::type_traits::is_sycl_policy<ExecutionPolicy>::value);
+
+  /*!
+   * \brief true if the loops of the execution policy run on a GPU (CUDA,
+   * HIP), which may not access the memory of the host
+   */
+  template <typename ExecutionPolicy>
+  inline constexpr bool isDeviceExecutionPolicy =
+      RAJA::type_traits::is_device_exec_policy<ExecutionPolicy>::value;
+
+  /*!
+   * \brief resource of camp associated with an execution policy
+   * (`camp::resources::Cuda`, `camp::resources::Hip` or
+   * `camp::resources::Host`, for instance), held by the execution policies
+   * of the `raja` backend (see
+   * `MFront/GenericParallel/RAJABackendExecutionPolicy.hxx`)
+   */
+  template <typename ExecutionPolicy>
+  using Resource = RAJA::resources::resource_from_pol_t<ExecutionPolicy>;
+
+  /*!
+   * \return the default resource of a type: the default stream of the
+   * current device with CUDA and HIP, as for the `cuda` and `hip` backends
+   * (the default resource of camp is a stream created by camp on the device
+   * 0), the default resource of camp otherwise
+   * \tparam ResourceType: type of the resource
+   */
+  template <typename ResourceType>
+  ResourceType getDefaultResourceOfType() {
+#if defined(RAJA_CUDA_ACTIVE)
+    if constexpr (std::is_same_v<ResourceType, camp::resources::Cuda>) {
+      return camp::resources::Cuda::CudaFromStream(0);
+    }
+#endif
+#if defined(RAJA_HIP_ACTIVE)
+    if constexpr (std::is_same_v<ResourceType, camp::resources::Hip>) {
+      return camp::resources::Hip::HipFromStream(0);
+    }
+#endif
+    return ResourceType::get_default();
+  }  // end of getDefaultResourceOfType
+
+  /*!
+   * \return the resource used by the default execution policy of the `raja`
+   * backend (see `getDefaultResourceOfType`). The unsupported execution
+   * policies are refused at compile time (see `isSupportedExecutionPolicy`).
+   * \tparam ExecutionPolicy: execution policy
+   */
+  template <typename ExecutionPolicy>
+  Resource<ExecutionPolicy> getDefaultResource() {
+    static_assert(isSupportedExecutionPolicy<ExecutionPolicy>,
+                  "the execution policies of OpenMP target and SYCL are not "
+                  "supported by the raja backend");
+    return getDefaultResourceOfType<Resource<ExecutionPolicy>>();
+  }  // end of getDefaultResource
+
+  /*!
+   * \return the identifier of the device of a resource (CUDA and HIP), 0
+   * otherwise. The memory allocated by the resources (statistics, copies of
+   * the shared data) is distinguished by device.
+   * \param[in] r: resource
+   */
+  template <typename ResourceType>
+  int getDevice(const ResourceType& r) {
+    static_cast<void>(r);
+#if defined(RAJA_CUDA_ACTIVE)
+    if constexpr (std::is_same_v<ResourceType, camp::resources::Cuda>) {
+      return r.get_device();
+    }
+#endif
+#if defined(RAJA_HIP_ACTIVE)
+    if constexpr (std::is_same_v<ResourceType, camp::resources::Hip>) {
+      return r.get_device();
+    }
+#endif
+    return 0;
+  }  // end of getDevice
+
+#if defined(RAJA_CUDA_ACTIVE) || defined(RAJA_HIP_ACTIVE)
+
+  /*!
+   * \brief kernel which is never launched: its attributes give the stack
+   * size required to apply a function at one point. RAJA does not increase
+   * the stack size of the threads, which is too small by default for some
+   * behaviours.
+   */
+  template <typename Function>
+  __global__ void stackSizeProbe(const Function f) {
+    f(0);
+  }  // end of stackSizeProbe
+
+#endif /* defined(RAJA_CUDA_ACTIVE) || defined(RAJA_HIP_ACTIVE) */
+
+  /*!
+   * \brief increase the stack size of the threads of the device if the
+   * given function, applied at one point with the given execution policy,
+   * requires it. Nothing is done if the execution policy is not one of CUDA
+   * or HIP.
+   * \return an error message, empty on success
+   * \tparam ExecutionPolicy: execution policy
+   * \param[in] f: function applied at one point
+   * \param[in] preserve: if true, the stack size is not modified, and an
+   * error is returned if it is too small
+   */
+  template <typename ExecutionPolicy, typename Function>
+  std::string ensureStackSize(const Function& f, const bool preserve) {
+    static_cast<void>(f);
+    static_cast<void>(preserve);
+#if defined(RAJA_CUDA_ACTIVE) || defined(RAJA_HIP_ACTIVE)
+    if constexpr (RAJA::type_traits::is_device_exec_policy<
+                      ExecutionPolicy>::value) {
+      const auto r = gpu::ensureStackSize<stackSizeProbe<Function>>(preserve);
+      if (!r.succeeded()) {
+        return r.getErrorMessage();
+      }
+    }
+#endif
+    return {};
+  }  // end of ensureStackSize
+
+}  // end of namespace mfront::generic_parallel::raja
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_RAJAEXECUTIONPOLICY_HXX */
