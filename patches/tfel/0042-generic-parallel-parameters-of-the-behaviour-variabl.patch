From 12d6fccd7958a09a21ff21762abbf5d2b20bf524 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 6 Oct 2026 15:34:53 +0200
Subject: [PATCH] generic-parallel: parameters of the behaviour variables
 checked on the host

In device code, behaviour variables are built by their default
constructor, which uses the default values of their parameters: their
parameters initializers, which may read a parameters file, are only
available on the host. A modified parameter was silently ignored on the
device.

The generated functions now compare, on the host, the values given by
the parameters initializers of the behaviour variables (and of their own
behaviour variables) to their default values, and report an error
(status -2) naming the parameter and the behaviour variable if they
differ.

The parameters of the material properties called by a behaviour are
constants in the code generated by the mfront interface, in host and
device code: the documentation no longer states otherwise.
---
 .../generic-parallel-behaviour-interface.md   |  8 +-
 .../src/GenericParallelBehaviourInterface.cxx | 86 +++++++++++++++++++
 2 files changed, 92 insertions(+), 2 deletions(-)

diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index 843a1d394..88b81a139 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -456,7 +456,6 @@ The following points are specific to device code:
   `@ElasticMaterialProperties`, `@ComputeThermalExpansion`, etc.) are
   evaluated by an implementation generated in the `mfront::device`
   namespace, which returns `NaN` if a physical bound is not satisfied.
-  Their parameters have their default values.
 - the behaviour class is shared by all the interfaces selected in the same
   call of `MFront`. When the `generic-parallel` interface is selected, the
   class is written so that it can be used in device code, with the same
@@ -474,7 +473,12 @@ The following points are specific to device code:
   external models declared by `@Model`) can be used in device code. Their
   parameters take their default values in device code, unless they are
   treated as static variables, since the parameters initializers of the
-  behaviour variables are only available on the host.
+  behaviour variables are only available on the host. The generated
+  functions report an error (status -2) if, on the host, a parameter of a
+  behaviour variable differs from its default value (for instance if it is
+  read from a parameters file).
+- the parameters of the material properties called by the behaviour are
+  constants, in host and device code.
 - the linear system solvers of the implicit DSLs can be used in device
   code, including the `TDLS` solver (`@LinearSystemSolver TDLS`) when
   `TFEL` is built with `TDLS` support.
diff --git a/mfront/src/GenericParallelBehaviourInterface.cxx b/mfront/src/GenericParallelBehaviourInterface.cxx
index a7254c57b..e6bf71e08 100644
--- a/mfront/src/GenericParallelBehaviourInterface.cxx
+++ b/mfront/src/GenericParallelBehaviourInterface.cxx
@@ -14,6 +14,7 @@
 #include <vector>
 #include <string_view>
 #include <fstream>
+#include <sstream>
 #include <functional>
 #include <algorithm>
 #include "TFEL/Raise.hxx"
@@ -27,6 +28,7 @@
 #include "MFront/LibraryDescription.hxx"
 #include "MFront/TargetsDescription.hxx"
 #include "MFront/BehaviourDescription.hxx"
+#include "MFront/BehaviourVariableDescription.hxx"
 #include "MFront/BehaviourRotationFunctions.hxx"
 #include "MFront/GenericBehaviourSymbolsGenerator.hxx"
 #include "MFront/GenericParallel/Behaviour/AbstractBackend.hxx"
@@ -248,6 +250,89 @@ namespace mfront {
     os << "};\n\n";
   }  // end of writeParametersStructure
 
+  /*!
+   * \brief write the checks of the parameters of the behaviour variables
+   * (and of their own behaviour variables).
+   *
+   * In device code, behaviour variables are built by their default
+   * constructor, which uses the default values of their parameters: their
+   * parameters initializers, which may read a parameters file, are only
+   * available on the host. The generated code reports an error if the value
+   * of a parameter given by an initializer differs from its default value.
+   * \param[out] os: output stream
+   * \param[in] bd: behaviour description
+   * \param[in] h: modelling hypothesis
+   */
+  static void writeBehaviourVariablesParametersChecks(
+      std::ostream& os,
+      const BehaviourDescription& bd,
+      const tfel::material::ModellingHypothesis::Hypothesis h) {
+    using tfel::material::ModellingHypothesis;
+    constexpr auto uh = ModellingHypothesis::UNDEFINEDHYPOTHESIS;
+    const auto& d = bd.getBehaviourData(h);
+    auto check = [&os, h](const BehaviourVariableDescription& v,
+                          const std::string& kind) {
+      const auto& ib = v.behaviour;
+      if (!areParametersTreatedAsStaticVariables(ib)) {
+        const auto ns = ib.getAttribute<std::string>(
+            BehaviourDescription::internalNamespace, "");
+        const auto prefix = ns.empty() ? std::string{"tfel::material::"}
+                                       : "tfel::material::" + ns + "::";
+        // default values are written as in the code generated for the
+        // behaviour variable
+        const auto precision = os.precision(14);
+        for (const auto& p : ib.getBehaviourData(h).getParameters()) {
+          const auto initializer =
+              prefix + ib.getClassName() +
+              (ib.hasParameter(uh, p.name) ? ""
+                                           : ModellingHypothesis::toString(h)) +
+              "ParametersInitializer::get()." + p.name;
+          auto conditions = std::vector<std::string>{};
+          if (p.type == "int") {
+            conditions.push_back(
+                initializer + " != " +
+                std::to_string(ib.getIntegerParameterDefaultValue(h, p.name)));
+          } else if (p.type == "ushort") {
+            conditions.push_back(
+                initializer + " != " +
+                std::to_string(
+                    ib.getUnsignedShortParameterDefaultValue(h, p.name)));
+          } else {
+            for (unsigned short i = 0; i != p.arraySize; ++i) {
+              auto c = std::ostringstream{};
+              c.copyfmt(os);
+              c << initializer
+                << (p.arraySize == 1 ? "" : "[" + std::to_string(i) + "]")
+                << " != double("
+                << (p.arraySize == 1
+                        ? ib.getFloattingPointParameterDefaultValue(h, p.name)
+                        : ib.getFloattingPointParameterDefaultValue(h, p.name,
+                                                                    i))
+                << ")";
+              conditions.push_back(c.str());
+            }
+          }
+          for (const auto& c : conditions) {
+            os << "if (" << c << ") {\n"
+               << "return mfront::gpb::report(mfront_status, -2, \"the "
+               << "parameter '" << p.name << "' of the " << kind << " '"
+               << v.name << "' differs from its default value, which is "
+               << "used in device code\");\n"
+               << "}\n";
+          }
+        }
+        os.precision(precision);
+      }
+      writeBehaviourVariablesParametersChecks(os, ib, h);
+    };
+    for (const auto& v : d.getBehaviourVariables()) {
+      check(v, "behaviour variable");
+    }
+    for (const auto& v : d.getBehaviourVariableFactories()) {
+      check(v, "behaviour variable factory");
+    }
+  }  // end of writeBehaviourVariablesParametersChecks
+
   /*!
    * \brief write the initialisation of the values of the parameters from
    * the parameters initializers, which are only available on the host.
@@ -743,6 +828,7 @@ namespace mfront {
          << "auto& mfront_status = *mfront_output_status;\n"
          << "const auto& mfront_data = *mfront_batch_data;\n";
       writeParametersInitialisation(os, bd, h);
+      writeBehaviourVariablesParametersChecks(os, bd, h);
       os << "const auto mfront_policy = " << this->getFunctionNameBasis(name)
          << "_getOutOfBoundsPolicy();\n";
       call();
-- 
