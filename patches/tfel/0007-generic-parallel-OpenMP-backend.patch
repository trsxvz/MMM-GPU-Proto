+/*!
+ * \file   mfront/include/MFront/GenericParallel/OpenMPBackend.hxx
+ * \brief  This file declares the backend of the `generic-parallel` interfaces
+ * based on OpenMP
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_OPENMPBACKEND_HXX
+#define LIB_MFRONT_GENERICPARALLEL_OPENMPBACKEND_HXX
+
+#include "TFEL/Utilities/Data.hxx"
+#include "MFront/MFrontConfig.hxx"
+#include "MFront/GenericParallel/AbstractBackend.hxx"
+
+namespace mfront::generic_parallel {
+
+  /*!
+   * \brief backend based on OpenMP.
+   *
+   * Options:
+   *
+   * - `offload`: if true (default), the computations are offloaded to the
+   *   default device (`target` construct). Otherwise, they are performed by
+   *   the threads of the host (`parallel` construct).
+   * - `device_stack_size`: minimal stack size, in bytes, of the threads of the
+   *   device when the computations are offloaded to an NVIDIA GPU through the
+   *   CUDA runtime (ignored otherwise).
+   */
+  struct MFRONT_VISIBILITY_EXPORT OpenMPBackend final : AbstractBackend {
+    //! \brief default constructor
+    OpenMPBackend();
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    OpenMPBackend(const tfel::utilities::DataMap&);
+    //
+    [[nodiscard]] std::string getName() const override;
+    [[nodiscard]] std::string getSourceFileExtension() const override;
+    void writeSpecificIncludes(std::ostream&, const Runtime) const override;
+    [[nodiscard]] std::string getApply() const override;
+    [[nodiscard]] std::string getMemorySpace() const override;
+    [[nodiscard]] std::string getExecutionPolicyType() const override;
+    //! \brief destructor
+    ~OpenMPBackend() noexcept override;
+
+   private:
+    //! \brief offload the computations to the default device
+    bool offload = true;
+    //! \brief stack size of the threads of the device (0 if not specified)
+    int device_stack_size = 0;
+  };  // end of OpenMPBackend
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_OPENMPBACKEND_HXX */
diff --git a/mfront/include/MFront/GenericParallel/OpenMPBackendExecutionPolicy.hxx b/mfront/include/MFront/GenericParallel/OpenMPBackendExecutionPolicy.hxx
new file mode 100644
index 000000000..23f2eaed3
