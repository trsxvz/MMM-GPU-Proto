diff --git a/mfront/tests/behaviours/TensorialIntegrationVariablesPartialJacobianInvert.mfront b/mfront/tests/behaviours/TensorialIntegrationVariablesPartialJacobianInvert.mfront
new file mode 100644
index 000000000..d7a8eca70
--- /dev/null
+++ b/mfront/tests/behaviours/TensorialIntegrationVariablesPartialJacobianInvert.mfront
@@ -0,0 +1,71 @@
+@DSL Implicit;
+@Behaviour TensorialIntegrationVariablesPartialJacobianInvert;
+@Author Tristan Chenaille;
+@Date 22/11/2026;
+@Description {
+  "This behaviour is used to test the `getPartialJacobianInvert` function "
+  "object when a tensorial integration variable follows another one. The "
+  "elastic strain is the total strain minus a fraction of a symmetric "
+  "tensor whose rate is proportional to the elastic strain. A scalar, "
+  "whose rate is proportional to the trace of the elastic strain, follows "
+  "this tensor. The blocks of the inverse of the jacobian are compared to "
+  "their analytical values when the tangent operator is computed."
+}
+
+@Epsilon 1.e-14;
+@Theta 0.5;
+
+@Parameter stress young = 150e9;
+young.setGlossaryName("YoungModulus");
+@Parameter real nu = 0.3;
+nu.setGlossaryName("PoissonRatio");
+@Parameter real c = 0.5;
+@Parameter real k = 15;
+@Parameter real m = 2;
+
+@StateVariable Stensor a;
+@StateVariable real p;
+
+@LocalVariable stress lambda;
+@LocalVariable stress mu;
+
+@InitLocalVariables {
+  lambda = computeLambda(young, nu);
+  mu = computeMu(young, nu);
+}
+
+@ComputeFinalStress {
+  sig = lambda * trace(eel) * Stensor::Id() + 2 * mu * eel;
+}
+
+@Integrator {
+  const auto e = eel + theta * deel;
+  feel += c * da - deto;
+  dfeel_dda = c * Stensor4::Id();
+  fa -= k * dt * e;
+  dfa_ddeel = -k * dt * theta * Stensor4::Id();
+  fp -= m * dt * trace(e);
+  dfp_ddeel = -m * dt * theta * Stensor::Id();
+}
+
+@TangentOperator {
+  static_cast<void>(smt);
+  Stensor4 Je;
+  Stensor4 Ja;
+  Stensor Jp;
+  getPartialJacobianInvert(Je, Ja, Jp);
+  // The jacobian being made of multiples of the identity, the blocks of
+  // its inverse are known: the integration fails if the blocks returned
+  // differ from them.
+  constexpr auto eps = real(1.e-12);
+  const auto s = k * dt * theta;
+  const auto r = 1 / (1 + c * s);
+  if ((abs(Je - r * Stensor4::Id()) > eps) ||
+      (abs(Ja - s * r * Stensor4::Id()) > eps) ||
+      (abs(Jp - m * dt * theta * r * Stensor::Id()) > eps)) {
+    return false;
+  }
+  StiffnessTensor De;
+  computeElasticStiffness<N, Type>::exe(De, lambda, mu);
+  Dt = De * Je;
+}
diff --git a/mfront/tests/behaviours/UninitializedVariablesTest.mfront b/mfront/tests/behaviours/UninitializedVariablesTest.mfront
new file mode 100644
index 000000000..8b36e63d0
--- /dev/null
+++ b/mfront/tests/behaviours/UninitializedVariablesTest.mfront
@@ -0,0 +1,80 @@
+@DSL Implicit;
+@Behaviour UninitializedVariablesTest;
+@Date 21 / 11 / 2026;
+@Description {
+  "A Norton behaviour testing the `setUninitialized` method on:"
+  "- a tensorial local variable (`n`),"
+  "- an array of local variables (`lame`),"
+  "- an integration variable which is not a state variable (`evp`)."
+  "Those variables are assigned before being used."
+}
+
+@Epsilon 1.e-16;
+@Theta 1;
+
+@MaterialProperty stress young;
+young.setGlossaryName("YoungModulus");
+@MaterialProperty real nu;
+nu.setGlossaryName("PoissonRatio");
+
+//! the Lamé coefficients, computed in `@InitializeLocalVariables`
+@LocalVariable stress lame[2];
+lame.setUninitialized();
+//! the normal, computed in `@Integrator`
+@LocalVariable Stensor n;
+n.setUninitialized();
+
+@StateVariable strain p;
+p.setGlossaryName("EquivalentViscoplasticStrain");
+
+//! the viscoplastic strain, set in `@InitializeLocalVariables`
+@IntegrationVariable StrainStensor evp;
+evp.setUninitialized();
+
+@AuxiliaryStateVariable StrainStensor evp0;
+evp0.setGlossaryName("ViscoplasticStrain");
+
+@InitializeLocalVariables {
+  lame[0] = computeLambda(young, nu);
+  lame[1] = computeMu(young, nu);
+  evp = evp0;
+}
+
+@ComputeStress {
+  sig = lame[0] * trace(eel) * Stensor::Id() + 2 * lame[1] * eel;
+}
+
+@Integrator {
+  constexpr auto A = real(8.e-67);
+  constexpr auto E = real(8.2);
+  const auto seq = sigmaeq(sig);
+  const auto iseq = 1 / (max(seq, real(1.e-12) * young));
+  const auto vp = A * pow(seq, E - 1);
+  n = 3 * deviator(sig) * (iseq / 2);
+  feel += devp - deto;
+  fp -= vp * seq * dt;
+  fevp -= dp * n;
+  // jacobian
+  dfeel_ddevp = Stensor4::Id();
+  dfp_ddeel = -2 * lame[1] * E * vp * dt * n;
+  dfevp_ddeel = -2 * lame[1] * dp * iseq * (Stensor4::M() - (n ^ n));
+  dfevp_ddp = -n;
+}
+
+@UpdateAuxiliaryStateVariables {
+  evp0 = evp;
+}
+
+@TangentOperator {
+  if ((smt == ELASTIC) || (smt == SECANTOPERATOR)) {
+    computeElasticStiffness<N, Type>::exe(Dt, lame[0], lame[1]);
+  } else if (smt == CONSISTENTTANGENTOPERATOR) {
+    StiffnessTensor De;
+    Stensor4 Je;
+    computeElasticStiffness<N, Type>::exe(De, lame[0], lame[1]);
+    getPartialJacobianInvert(Je);
+    Dt = De * Je;
+  } else {
+    return false;
+  }
+}
