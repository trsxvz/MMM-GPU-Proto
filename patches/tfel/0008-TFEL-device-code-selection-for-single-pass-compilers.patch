From 59f368eae31499fbf0b6e113686fbb241363e293 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 5 Oct 2026 17:04:58 +0200
Subject: [PATCH] TFEL: device code selection for single pass compilers

- `TFEL_DEVICE_CODE` is also defined when the host and the device code are
  compiled in a single pass: `nvc++ -stdpar=gpu`, which may offload any
  function called by a parallel algorithm, and the generic compiler of
  AdaptiveCpp (SSCP), which generates the device code at runtime. The
  device code is then selected in the whole translation unit;
- contract violations are not reported in device code, whatever the
  compiler (they were only disabled for CUDA, HIP and after the inclusion
  of the SYCL headers);
- unsigned loop counters in `BoundsCheck` and `fses::fill`, as in the rest
  of TFEL. `nvc++` 25.11 miscompiles device loops with a signed counter
  compared with `!=` to a constant bound at `-O2` and `-O3`.
---
 include/FSES/Utilities.ixx            |  4 ++--
 include/TFEL/Config/TFELConfig.hxx    | 16 ++++++++++++++--
 include/TFEL/Material/BoundsCheck.hxx | 12 ++++++------
 3 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/include/FSES/Utilities.ixx b/include/FSES/Utilities.ixx
index d2498cb7f..17159306f 100644
--- a/include/FSES/Utilities.ixx
+++ b/include/FSES/Utilities.ixx
@@ -186,8 +186,8 @@ TFEL_HOST_DEVICE const GetMatrixNumericType_t<MatrixType>& at(const MatrixType&
 
 template <typename MatrixType, typename NumericType>
 TFEL_HOST_DEVICE void fill(MatrixType& m, const NumericType& v) {
-  for (int i = 0; i != 3; ++i) {
-    for (int j = 0; j != 3; ++j) {
+  for (unsigned short i = 0; i != 3; ++i) {
+    for (unsigned short j = 0; j != 3; ++j) {
       at(m, i, j) = v;
     }
   }
diff --git a/include/TFEL/Config/TFELConfig.hxx b/include/TFEL/Config/TFELConfig.hxx
index de8577e23..40ef04783 100644
--- a/include/TFEL/Config/TFELConfig.hxx
+++ b/include/TFEL/Config/TFELConfig.hxx
@@ -372,12 +372,24 @@
  * This macro allows to select code that can't be executed on the device,
  * for instance when throwing an exception, while keeping the same behaviour
  * on the host.
+ *
+ * Some compilers translate host and device code in a single pass: in this
+ * case, the device code is selected in the whole translation unit. This is
+ * the case of `nvc++ -stdpar=gpu`, which may offload any function called by
+ * a parallel algorithm of the standard library, and of the generic compiler
+ * of AdaptiveCpp (`SSCP`), which generates device code at runtime.
  */
-#if (defined __CUDA_ARCH__) || (defined __HIP_DEVICE_COMPILE__) || \
-    (defined __SYCL_DEVICE_ONLY__)
+#if (defined __CUDA_ARCH__) || (defined __HIP_DEVICE_COMPILE__) ||    \
+    (defined __SYCL_DEVICE_ONLY__) || (defined __NVCOMPILER_STDPAR_GPU) || \
+    (defined __ACPP_ENABLE_LLVM_SSCP_TARGET__)
 #ifndef TFEL_DEVICE_CODE
 #define TFEL_DEVICE_CODE 1
 #endif /* TFEL_DEVICE_CODE */
 #endif
 
+// contract violations are not reported in device code
+#if (defined TFEL_DEVICE_CODE) && (!defined TFEL_NO_REPORT_CONTRACT_VIOLATION)
+#define TFEL_NO_REPORT_CONTRACT_VIOLATION 1
+#endif
+
 #endif /* LIB_TFEL_CONFIG_HXX */
diff --git a/include/TFEL/Material/BoundsCheck.hxx b/include/TFEL/Material/BoundsCheck.hxx
index 08b85e5b5..4f9f4873c 100644
--- a/include/TFEL/Material/BoundsCheck.hxx
+++ b/include/TFEL/Material/BoundsCheck.hxx
@@ -312,10 +312,10 @@ namespace tfel::material {
         const tfel::math::base_type<T> lBound,
         const OutOfBoundsPolicy p = Strict) {
       auto r = true;
-      for (int i = 0; i != static_cast<int>(s.size()); ++i) {
+      for (unsigned short i = 0; i != s.size(); ++i) {
         const auto v = tfel::math::base_type_cast(s(i));
         if (v < lBound) {
-          r = treatOutOfLowerBound(name, i, v, lBound, p) && r;
+          r = treatOutOfLowerBound(name, static_cast<int>(i), v, lBound, p) && r;
         }
       }
       return r;
@@ -327,10 +327,10 @@ namespace tfel::material {
         const tfel::math::base_type<T> uBound,
         const OutOfBoundsPolicy p = Strict) {
       auto r = true;
-      for (int i = 0; i != static_cast<int>(s.size()); ++i) {
+      for (unsigned short i = 0; i != s.size(); ++i) {
         const auto v = tfel::math::base_type_cast(s(i));
         if (v > uBound) {
-          r = treatOutOfUpperBound(name, i, v, uBound, p) && r;
+          r = treatOutOfUpperBound(name, static_cast<int>(i), v, uBound, p) && r;
         }
       }
       return r;
@@ -343,10 +343,10 @@ namespace tfel::material {
         const tfel::math::base_type<T> uBound,
         const OutOfBoundsPolicy p = Strict) {
       auto r = true;
-      for (int i = 0; i != static_cast<int>(s.size()); ++i) {
+      for (unsigned short i = 0; i != s.size(); ++i) {
         const auto v = tfel::math::base_type_cast(s(i));
         if ((v < lBound) || (v > uBound)) {
-          r = treatOutOfBounds(name, i, v, lBound, uBound, p) && r;
+          r = treatOutOfBounds(name, static_cast<int>(i), v, lBound, uBound, p) && r;
         }
       }
       return r;
-- 
2.43.0

