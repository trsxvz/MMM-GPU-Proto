From 7b52939c140b653a85c7c1040b6bc7eb44e52162 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 12 Oct 2026 02:07:34 +0200
Subject: [PATCH] MFront: static variables of the Runge-Kutta DSLs in device
 code

Review of the previous commit, whose message wrongly stated that the
Runge-Kutta DSLs were covered:

- the stiffness tensor recomputed at the intermediate stages and at the
  end of the time step wrote `Class::v` for a static variable: the six
  Runge-Kutta algorithms failed to build for CUDA when the elastic
  material properties depend on a static variable, with `@UseQt true`.
  The two modifiers now write TFEL_STATIC_VARIABLE(Class::v). They are
  also returned by value instead of a reference to a static lambda,
  which kept the class name of the first behaviour treated by the mfront
  process: with several behaviours in the same call, the other ones
  referred to the static variables of the first one;
- the constants of the rkCastem algorithm (rkcastem_div, rkcastem_borne,
  rkcastem_fac, rkcastem_rmin, rkcastem_rmax) are written with the macro:
  rkCastem with `@UseQt true` failed to build for CUDA;
- the static variables given to the behaviour variables
  (`@BehaviourVariable`) and to an external thermal expansion
  coefficient are written with the macro too, for consistency.

The documentation of TFEL_STATIC_VARIABLE mentions the compilers
translating host and device code in a single pass, which use the copy in
the whole translation unit, and the lifetime of a reference bound to the
copy.
---
 include/TFEL/Config/TFELConfig.hxx         |  6 +++
 mfront/src/BehaviourCodeGeneratorBase.cxx  | 10 ++--
 mfront/src/RungeKuttaCodeGeneratorBase.cxx | 54 +++++++++++++---------
 3 files changed, 44 insertions(+), 26 deletions(-)

diff --git a/include/TFEL/Config/TFELConfig.hxx b/include/TFEL/Config/TFELConfig.hxx
index cb5a34ec3..49eca7ccf 100644
--- a/include/TFEL/Config/TFELConfig.hxx
+++ b/include/TFEL/Config/TFELConfig.hxx
@@ -401,6 +401,12 @@
  * quantities. In device code, this macro gives a temporary copy initialised
  * by a constant expression, `(decltype(v){v})`, which can be used. In host
  * code, it gives the variable itself.
+ *
+ * As `TFEL_DEVICE_CODE`, the copy is used in the whole translation unit by
+ * the compilers translating host and device code in a single pass (`nvc++
+ * -stdpar=gpu`, `nvc++ -mp=gpu`, AdaptiveCpp's generic compiler). A
+ * reference bound to the copy is only valid until the end of the full
+ * expression, and its type is not const qualified.
  */
 #ifdef TFEL_DEVICE_CODE
 #define TFEL_STATIC_VARIABLE(v) (decltype(v){v})
diff --git a/mfront/src/BehaviourCodeGeneratorBase.cxx b/mfront/src/BehaviourCodeGeneratorBase.cxx
index fe885d9a4..424fc022b 100644
--- a/mfront/src/BehaviourCodeGeneratorBase.cxx
+++ b/mfront/src/BehaviourCodeGeneratorBase.cxx
@@ -2849,8 +2849,8 @@ namespace mfront {
           out << "tfel::math::base_type_cast(this->" << pi->name << ")";
         } else if (c == BehaviourDescription::MaterialPropertyInput::
                             STATICVARIABLE) {
-          out << "tfel::math::base_type_cast(" << this->bd.getClassName()
-              << "::" << pi->name << ")";
+          out << "tfel::math::base_type_cast(TFEL_STATIC_VARIABLE("
+              << this->bd.getClassName() << "::" << pi->name << "))";
         } else {
           throw_if(true,
                    "thermal expansion coefficients must depend "
@@ -5480,7 +5480,8 @@ namespace mfront {
              << " = this->" << source << " + this->d" << source << ";\n";
         } else if (md.isStaticVariableName(source)) {
           os << "mfront_behaviour_variable_" << b.name << ". " << mp.name
-             << " = " << bd.getClassName() << "::" << source << ";\n";
+             << " = TFEL_STATIC_VARIABLE(" << bd.getClassName()
+             << "::" << source << ");\n";
         } else {
           os << "mfront_behaviour_variable_" << b.name << ". " << mp.name
              << " = this->" << source << ";\n";
@@ -5560,7 +5561,8 @@ namespace mfront {
              << " = this->d" << source << ";\n";
         } else if (md.isStaticVariableName(source)) {
           os << "mfront_behaviour_variable_" << b.name << ". " << esv.name
-             << " = " << bd.getClassName() << "::" << source << ";\n";
+             << " = TFEL_STATIC_VARIABLE(" << bd.getClassName()
+             << "::" << source << ");\n";
           os << "mfront_behaviour_variable_" << b.name << ". d" << esv.name
              << " = " << esv.type << "{};\n";
         } else {
diff --git a/mfront/src/RungeKuttaCodeGeneratorBase.cxx b/mfront/src/RungeKuttaCodeGeneratorBase.cxx
index e140279d7..ad6882e63 100644
--- a/mfront/src/RungeKuttaCodeGeneratorBase.cxx
+++ b/mfront/src/RungeKuttaCodeGeneratorBase.cxx
@@ -132,12 +132,12 @@ namespace mfront {
    * the time step
    */
   static std::function<
-      std::string(const BehaviourDescription::MaterialPropertyInput&)>&
+      std::string(const BehaviourDescription::MaterialPropertyInput&)>
   modifyVariableForStiffnessTensorComputation(const std::string& cn) {
     using MaterialPropertyInput = BehaviourDescription::MaterialPropertyInput;
     using Modifier = std::function<std::string(const MaterialPropertyInput&)>;
-    static Modifier m =
-        [cn](const BehaviourDescription::MaterialPropertyInput& i) {
+    auto m =
+        Modifier{[cn](const BehaviourDescription::MaterialPropertyInput& i) {
           if ((i.category == MaterialPropertyInput::TEMPERATURE) ||
               (i.category == MaterialPropertyInput::EXTERNALSTATEVARIABLE)) {
             return "this->" + i.name + "_";
@@ -150,7 +150,7 @@ namespace mfront {
                      (i.category == MaterialPropertyInput::PARAMETER)) {
             return "this->" + i.name;
           } else if (i.category == MaterialPropertyInput::STATICVARIABLE) {
-            return cn + "::" + i.name;
+            return "TFEL_STATIC_VARIABLE(" + cn + "::" + i.name + ")";
           } else {
             tfel::raise(
                 "modifyVariableForStiffnessTensorComputation: "
@@ -158,7 +158,7 @@ namespace mfront {
                 "variable '" +
                 i.name + "'");
           }
-        };
+        }};
     return m;
   }  // end of modifyVariableForStiffnessTensorComputation
 
@@ -167,12 +167,12 @@ namespace mfront {
    * the time step.
    */
   static std::function<
-      std::string(const BehaviourDescription::MaterialPropertyInput&)>&
+      std::string(const BehaviourDescription::MaterialPropertyInput&)>
   modifyVariableForStiffnessTensorComputation2(const std::string& cn) {
     using MaterialPropertyInput = BehaviourDescription::MaterialPropertyInput;
     using Modifier = std::function<std::string(const MaterialPropertyInput&)>;
-    static Modifier m = [cn](const BehaviourDescription::MaterialPropertyInput&
-                                 i) {
+    auto m = Modifier{[cn](const BehaviourDescription::MaterialPropertyInput&
+                               i) {
       if ((i.category == MaterialPropertyInput::TEMPERATURE) ||
           (i.category ==
            MaterialPropertyInput::AUXILIARYSTATEVARIABLEFROMEXTERNALMODEL) ||
@@ -182,7 +182,7 @@ namespace mfront {
                  (i.category == MaterialPropertyInput::PARAMETER)) {
         return "this->" + i.name;
       } else if (i.category == MaterialPropertyInput::STATICVARIABLE) {
-        return cn + "::" + i.name;
+        return "TFEL_STATIC_VARIABLE(" + cn + "::" + i.name + ")";
       } else {
         tfel::raise(
             "modifyVariableForStiffnessTensorComputation2: "
@@ -190,7 +190,7 @@ namespace mfront {
             "variable '" +
             i.name + "'");
       }
-    };
+    }};
     return m;
   }  // end of modifyVariableForStiffnessTensorComputation2
 
@@ -1620,15 +1620,18 @@ namespace mfront {
        << "2>(((sigf)-(this->sig))|((sigf)-(this->sig))) / errabs;\n"
        << "const auto sqra = tfel::math::power<1, 2>(ra);\n"
        << "// test for convergence\n"
-       << "if ((sqra>" << this->bd.getClassName()
-       << "::rkcastem_div)||(!ieee754::isfinite(ra))){\n"
-       << "dt_ /= " << this->bd.getClassName() << "::rkcastem_div;\n";
+       << "if ((sqra>TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+       << "::rkcastem_div))||(!ieee754::isfinite(ra))){\n"
+       << "dt_ /= TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+       << "::rkcastem_div);\n";
     if (getDebugMode()) {
       os << "cout << \"" << this->bd.getClassName()
          << "::integrate() : multiplying time step by a factor \" << 1/("
-         << this->bd.getClassName() << "::rkcastem_div) << endl;\n";
+         << "TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+         << "::rkcastem_div)) << endl;\n";
     }
-    os << "} else if (ra> " << this->bd.getClassName() << "::rkcastem_borne){\n"
+    os << "} else if (ra> TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+       << "::rkcastem_borne)){\n"
        << "dt_ /= sqra;\n";
     if (getDebugMode()) {
       os << "cout << \"" << this->bd.getClassName()
@@ -1663,15 +1666,20 @@ namespace mfront {
        << "converged=true;\n"
        << "}\n"
        << "if(!converged){\n"
-       << "if ((" << this->bd.getClassName() << "::rkcastem_fac)*sqra < 1){\n"
-       << "dt_ *= " << this->bd.getClassName() << "::rkcastem_fac;\n";
+       << "if ((TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+       << "::rkcastem_fac))*sqra < 1){\n"
+       << "dt_ *= TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+       << "::rkcastem_fac);\n";
     if (getDebugMode()) {
       os << "cout << \"" << this->bd.getClassName()
          << "::integrate() : multiplying time step by a factor \" << "
-         << this->bd.getClassName() << "::rkcastem_fac << endl;\n";
+         << "TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+         << "::rkcastem_fac) << endl;\n";
     }
-    os << "}else if ((sqra< " << this->bd.getClassName() << "::rkcastem_rmin)||"
-       << "(sqra>" << this->bd.getClassName() << "::rkcastem_rmax)){\n";
+    os << "}else if ((sqra< TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+       << "::rkcastem_rmin))||"
+       << "(sqra>TFEL_STATIC_VARIABLE(" << this->bd.getClassName()
+       << "::rkcastem_rmax))){\n";
     os << "dt_ /= sqra;\n";
     if (getDebugMode()) {
       os << "cout << \"" << this->bd.getClassName()
@@ -1682,11 +1690,13 @@ namespace mfront {
        << "}\n"
        << "}\n"
        << "} else { \n"
-       << "dt_ /=  " << this->bd.getClassName() << "::rkcastem_div;\n";
