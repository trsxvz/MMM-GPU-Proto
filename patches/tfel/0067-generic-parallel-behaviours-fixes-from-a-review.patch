+  auto st = t.initial;
+  auto b = BatchFields(st, t.sizes, fs, t.n, t.dt, K0, Storage::by_point);
+  auto o = mfront_gpb_OutputStatus{};
+  f(&o, &b.data);
+  synchronize();
+  const auto pass = o.status == -2;
+  std::printf("%-12s %-12s status=%2d | %s\n", "invalid", "options", o.status,
+              pass ? "OK" : "FAILED");
+  return pass;
+}
