+  template <unsigned short N, typename T>
+  TFEL_HOST_DEVICE constexpr tmatrix<N, N, T> change_basis(
+      const tmatrix<N, N, T>& m, const rotation_matrix<T>& r) noexcept {
+    static_assert((N == 1) || (N == 2) || (N == 3), "invalid space dimension");
+    if constexpr (N == 1) {
+      return m;
+    } else {
+      auto rm = tmatrix<N, N, T>{T{0}};
+      for (unsigned short i = 0; i != N; ++i) {
+        for (unsigned short j = 0; j != N; ++j) {
+          for (unsigned short k = 0; k != N; ++k) {
+            for (unsigned short l = 0; l != N; ++l) {
+              rm(i, j) += r(k, i) * m(k, l) * r(l, j);
+            }
+          }
+        }
+      }
+      return rm;
+    }
