From 0d0fa56247562367bb93b98cb697ea583fec4cbc Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 12 Oct 2026 01:42:08 +0200
Subject: [PATCH] MFront: static variables of the code blocks unchanged in host
 code

Review of the previous commit: the copy `decltype(v){v}` written for the
static variables of the code blocks changed the generated code in host
code, contrary to its message. The copy is a prvalue: taking the address
of the variable, `std::ref(v)`, binding a non-const reference to a scalar
static variable (`auto& r = v`) no longer compiled, and a function
returning a reference to the variable returned a reference to a
temporary. The copy is also a temporary initialised by a constant
expression, not built at compile time.

The static variables are now written `TFEL_STATIC_VARIABLE(v)`: this new
macro of TFELConfig.hxx gives the variable itself in host code and the
copy `(decltype(v){v})` in device code (TFEL_DEVICE_CODE), where a
reference to a constexpr static variable defined in host code is not
allowed anyway. The static variables are scalars, integers (for instance
`@IntegerConstant` and the numbers of sliding systems) or quantities.

The comment of the test law StrainHardeningCreep3 is corrected (static
variable of quantity type, flow rule still zero).
---
 include/TFEL/Config/TFELConfig.hxx            | 19 ++++++++++++++++++
 mfront/src/DSLBase.cxx                        | 20 ++++++++++---------
 .../StrainHardeningCreep3.mfront              |  6 +++---
 3 files changed, 33 insertions(+), 12 deletions(-)

diff --git a/include/TFEL/Config/TFELConfig.hxx b/include/TFEL/Config/TFELConfig.hxx
index a648443dc..c6b1e977b 100644
--- a/include/TFEL/Config/TFELConfig.hxx
+++ b/include/TFEL/Config/TFELConfig.hxx
@@ -389,6 +389,25 @@
 #endif /* TFEL_DEVICE_CODE */
 #endif
 
+/*!
+ * \brief `TFEL_STATIC_VARIABLE(v)` gives the value of a constexpr static
+ * variable `v` in code which may be compiled as device code, such as the
+ * code blocks of the behaviours generated by `MFront`.
+ *
+ * Device code can't refer to a constexpr static variable defined in host
+ * code, which is the case when the variable is given to a function or an
+ * operator taking a reference in an expression evaluated at run time, for
+ * instance `T - Tref` for a static temperature `Tref` of a behaviour using
+ * quantities. In device code, this macro gives a temporary copy initialised
+ * by a constant expression, `(decltype(v){v})`, which can be used. In host
+ * code, it gives the variable itself.
+ */
+#ifdef TFEL_DEVICE_CODE
+#define TFEL_STATIC_VARIABLE(v) (decltype(v){v})
+#else /* TFEL_DEVICE_CODE */
+#define TFEL_STATIC_VARIABLE(v) v
+#endif /* TFEL_DEVICE_CODE */
+
 // contract violations are not reported in device code
 #if (defined TFEL_DEVICE_CODE) && (!defined TFEL_NO_REPORT_CONTRACT_VIOLATION)
 #define TFEL_NO_REPORT_CONTRACT_VIOLATION 1
diff --git a/mfront/src/DSLBase.cxx b/mfront/src/DSLBase.cxx
index e1c386592..d3f37b1f3 100644
--- a/mfront/src/DSLBase.cxx
+++ b/mfront/src/DSLBase.cxx
@@ -376,13 +376,10 @@ namespace mfront {
     }
     auto& res = b.code;
     // writes a static member, the current token. A static variable is
-    // replaced by a copy built at compile time, `decltype(v){v}`: device
-    // code can't refer to a constexpr static member of a class type, such
-    // as a quantity, which is the case when it is given to a function or an
-    // operator taking a reference (for instance `T - Tref` for a static
-    // temperature `Tref`), but can use such a copy (CUDA, HIP). The static
-    // variables being scalars or quantities, the copy has the same type and
-    // value.
+    // written `TFEL_STATIC_VARIABLE(v)`, which gives the variable itself in
+    // host code and a temporary copy initialised by a constant expression in
+    // device code, which can't refer to a constexpr static variable defined
+    // in host code (see TFELConfig.hxx).
     auto writeStaticMember = [this, &res, addClassName](const std::string& n) {
       const auto previous = std::prev(this->current);
       if ((previous->value == "->") || (previous->value == ".") ||
@@ -390,8 +387,13 @@ namespace mfront {
         res += n;
         return;
       }
-      const auto v = addClassName ? this->getClassName() + "::" + n : n;
-      res += "decltype(" + v + "){" + v + "}";
+      res += "TFEL_STATIC_VARIABLE(";
+      if (addClassName) {
+        res += this->getClassName();
+        res += "::";
+      }
+      res += n;
+      res += ")";
     };
     unsigned int openedBlock = 0;
     this->readSpecifiedToken("DSLBase::readNextBlock", delim1);
diff --git a/test-suite/behaviours/generic-parallel/StrainHardeningCreep3.mfront b/test-suite/behaviours/generic-parallel/StrainHardeningCreep3.mfront
index 9b8454013..8acfe3e11 100644
--- a/test-suite/behaviours/generic-parallel/StrainHardeningCreep3.mfront
+++ b/test-suite/behaviours/generic-parallel/StrainHardeningCreep3.mfront
@@ -8,9 +8,9 @@
 @AuxiliaryStateVariable stress l,m;
 @AuxiliaryStateVariable stress l_tdt,m_tdt;
 
-// static variable of a quantity, given by reference to an operator in an
-// expression evaluated at run time, in device code (copy built at compile
-// time by MFront). The flow rule is still null.
+// static variable of quantity type, given by reference to an operator in
+// an expression evaluated at run time, in device code (see
+// TFEL_STATIC_VARIABLE). The flow rule is still zero.
 @StaticVariable strainrate de0 = 0;
 
 @FlowRule{
