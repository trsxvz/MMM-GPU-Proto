new file mode 100644
index 000000000..2f53b6f15
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/GPUStackSize.hxx
@@ -0,0 +1,122 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/GPUStackSize.hxx
+ * \brief  This file declares a function adapting the stack size of the
+ * threads of the device to a CUDA or HIP kernel, shared by the
+ * `generic-parallel` interfaces for behaviours and for material
+ * properties. This file must be compiled by a CUDA or a HIP compiler. The
+ * HIP runtime is used if the `hip/hip_runtime.h` header has been included
+ * before this file or if the HIP language is enabled, the CUDA runtime
+ * otherwise.
+ * \date   08/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_GPUSTACKSIZE_HXX
+#define LIB_MFRONT_GENERICPARALLEL_GPUSTACKSIZE_HXX
+
+#include <mutex>
+#include <string>
+#include <cstddef>
+// the `MFRONT_GENERIC_PARALLEL_GPU_API` macro gives the name of a function
+// or of a type of the runtime used
+#if defined(__HIPCC__) || defined(__HIP__)
+#include <hip/hip_runtime.h>
+#define MFRONT_GENERIC_PARALLEL_GPU_API(f) hip##f
+#else
+#include <cuda_runtime.h>
+#define MFRONT_GENERIC_PARALLEL_GPU_API(f) cuda##f
+#endif
+#include "MFront/GenericParallel/DeviceStackSize.hxx"
+
+namespace mfront::generic_parallel::gpu {
+
+  //! \brief error code of the runtime
+  using Error = MFRONT_GENERIC_PARALLEL_GPU_API(Error_t);
+
+  //! \brief result of `ensureStackSize`
+  struct StackSizeCheck {
+    //! \brief error of the runtime
+    Error error = MFRONT_GENERIC_PARALLEL_GPU_API(Success);
+    /*!
+     * \brief stack size required by the kernel if the current stack size is
+     * too small and must be preserved, zero otherwise
+     */
+    std::size_t required_stack_size = 0;
+    //! \return true if the kernel can be launched
+    [[nodiscard]] bool succeeded() const noexcept {
+      return (this->error == MFRONT_GENERIC_PARALLEL_GPU_API(Success)) &&
+             (this->required_stack_size == 0);
+    }
+    //! \return the error message
+    [[nodiscard]] std::string getErrorMessage() const {
+      if (this->error != MFRONT_GENERIC_PARALLEL_GPU_API(Success)) {
+        return MFRONT_GENERIC_PARALLEL_GPU_API(GetErrorString)(this->error);
+      }
+      return "the stack size of the threads of the device must be at "
+             "least " +
+             std::to_string(this->required_stack_size) +
+             " bytes, but it is preserved by the execution options";
+    }
+  };
+
+  /*!
+   * \brief increase the stack size of the threads of the current device if
+   * the given kernel requires it. The default stack size (1024 bytes with
+   * CUDA) is too small for some behaviours and is not increased
+   * automatically.
+   *
+   * The kernel is a template argument, so that this function is instantiated
+   * in the library defining the kernel. The CUDA runtime is linked
+   * statically by default: each library has its own instance of the
+   * runtime, which only knows the kernels of this library. A function
+   * shared by several libraries, for instance a function taking the kernel
+   * as argument, would be resolved to the instance of one library by the
+   * dynamic linker.
+   *
+   * \tparam kernel: kernel
+   * \param[in] preserve: if true, the stack size is not modified, and the
+   * required stack size is returned if the current one is too small
+   */
+  template <auto kernel>
+  StackSizeCheck ensureStackSize(const bool preserve) noexcept {
+    auto r = StackSizeCheck{};
+    auto a = MFRONT_GENERIC_PARALLEL_GPU_API(FuncAttributes){};
+    // the HIP runtime only provides the untyped overload
+    r.error = MFRONT_GENERIC_PARALLEL_GPU_API(FuncGetAttributes)(
+        &a, reinterpret_cast<const void*>(kernel));
+    if (r.error != MFRONT_GENERIC_PARALLEL_GPU_API(Success)) {
+      return r;
+    }
+    // the static estimate of the local memory of the kernel may be slightly
+    // lower than the actual stack usage (by a few tens of bytes for a kernel
+    // calling the pow function of libdevice), so a margin is added
+    constexpr auto margin = std::size_t{512};
+    constexpr auto granularity = std::size_t{1024};
+    const auto required =
+        ((a.localSizeBytes + margin + granularity - 1) / granularity) *
+        granularity;
+    auto lock = std::lock_guard<std::mutex>{getStackSizeMutex()};
+    auto l = std::size_t{};
+    r.error = MFRONT_GENERIC_PARALLEL_GPU_API(DeviceGetLimit)(
+        &l, MFRONT_GENERIC_PARALLEL_GPU_API(LimitStackSize));
+    if ((r.error != MFRONT_GENERIC_PARALLEL_GPU_API(Success)) ||
+        (required <= l)) {
+      return r;
+    }
+    if (preserve) {
+      r.required_stack_size = required;
+      return r;
+    }
+    r.error = MFRONT_GENERIC_PARALLEL_GPU_API(DeviceSetLimit)(
+        MFRONT_GENERIC_PARALLEL_GPU_API(LimitStackSize), required);
+    return r;
+  }  // end of ensureStackSize
+
+}  // end of namespace mfront::generic_parallel::gpu
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_GPUSTACKSIZE_HXX */
diff --git a/mfront/include/MFront/GenericParallel/KokkosStackSize.hxx b/mfront/include/MFront/GenericParallel/KokkosStackSize.hxx
new file mode 100644
index 000000000..f6c48b350
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/KokkosStackSize.hxx
@@ -0,0 +1,80 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/KokkosStackSize.hxx
+ * \brief  This file declares a function adapting the stack size of the
+ * threads of the device to a function applied by `Kokkos`, shared by the
+ * `generic-parallel` interfaces for behaviours and for material
+ * properties.
+ * \date   08/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_KOKKOSSTACKSIZE_HXX
+#define LIB_MFRONT_GENERICPARALLEL_KOKKOSSTACKSIZE_HXX
+
+#include <string>
+#include <type_traits>
+#include <Kokkos_Core.hpp>
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+#include "MFront/GenericParallel/GPUStackSize.hxx"
+#endif
+
+namespace mfront::generic_parallel::kokkos {
+
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+
+  /*!
+   * \brief kernel which is never launched: its attributes give the stack
+   * size required to apply a function at one point. Kokkos does not
+   * increase the stack size of the threads, which is too small by default
+   * for some behaviours.
+   */
+  template <typename Function>
+  __global__ void stackSizeProbe(const Function f) {
+    f(0);
+  }  // end of stackSizeProbe
+
+#endif /* defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP) */
+
+  /*!
+   * \brief increase the stack size of the threads of the device if the
+   * given function, applied at one point in the given execution space,
+   * requires it. Nothing is done if the execution space is not a CUDA or a
+   * HIP execution space.
+   * \return an error message, empty on success
+   * \tparam ExecutionSpace: execution space
+   * \param[in] f: function applied at one point
+   * \param[in] preserve: if true, the stack size is not modified, and an
+   * error is returned if it is too small
+   */
+  template <typename ExecutionSpace, typename Function>
+  std::string ensureStackSize(const Function& f, const bool preserve) {
+#if defined(KOKKOS_ENABLE_CUDA)
+    constexpr auto device = std::is_same_v<ExecutionSpace, Kokkos::Cuda>;
+#elif defined(KOKKOS_ENABLE_HIP)
+    constexpr auto device = std::is_same_v<ExecutionSpace, Kokkos::HIP>;
+#else
+    constexpr auto device = false;
+#endif
+    static_cast<void>(f);
+    static_cast<void>(preserve);
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+    if constexpr (device) {
+      const auto r = gpu::ensureStackSize<stackSizeProbe<Function>>(preserve);
+      if (!r.succeeded()) {
+        return r.getErrorMessage();
+      }
+    }
+#else
+    static_cast<void>(device);
+#endif
+    return {};
+  }  // end of ensureStackSize
+
+}  // end of namespace mfront::generic_parallel::kokkos
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_KOKKOSSTACKSIZE_HXX */
diff --git a/mfront/include/MFront/GenericParallel/SYCLDeviceCopies.hxx b/mfront/include/MFront/GenericParallel/SYCLDeviceCopies.hxx
new file mode 100644
index 000000000..d65022e5f
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/SYCLDeviceCopies.hxx
@@ -0,0 +1,248 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/SYCLDeviceCopies.hxx
+ * \brief  This file declares the copies in device memory of the arrays which
+ * are not accessible by the device associated with a SYCL queue, shared by
+ * the `generic-parallel` interfaces for behaviours and for material
+ * properties.
+ * \date   08/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_SYCLDEVICECOPIES_HXX
+#define LIB_MFRONT_GENERICPARALLEL_SYCLDEVICECOPIES_HXX
+
+#include <cstddef>
+#include <cstring>
+#include <optional>
+#include <type_traits>
+#include <vector>
+#include <sycl/sycl.hpp>
+#include "TFEL/Raise.hxx"
+
+namespace mfront::generic_parallel::sycl {
+
+  //! \brief a simple alias
+  using size_type = std::size_t;
+
+  //! \brief policy for the transfer of the data of a batch or of a set of points
+  enum struct DataTransferPolicy {
+    /*!
+     * \brief the arrays which are not accessible by the device associated
+     * with the queue (host memory not allocated by SYCL) are copied in
+     * device memory, and the outputs are copied back
+     */
+    AUTOMATIC,
+    //! \brief all the arrays are assumed to be accessible by the device
+    NONE
+  };
+
+  /*!
+   * \brief strided array: the `j`-th component of the `i`-th point is
+   * stored at `values[i * point_stride + j * component_stride]`
+   */
+  template <typename ValueType>
+  struct StridedArray {
+    //! \brief pointer to the first value
+    ValueType* values;
+    //! \brief stride between two points
+    size_type point_stride;
+    //! \brief stride between two components
+    size_type component_stride;
+  };
+
+  /*!
+   * \brief copies in device memory of the fields which are not accessible
+   * by the device associated with a queue. The outputs must be copied back
+   * by calling the `copyOutputs` method.
+   */
+  struct DeviceCopies {
+    /*!
+     * \brief constructor
+     * \param[in] q: queue
+     * \param[in] n: number of points of the fields
+     * \param[in] p: policy for the transfer of the fields. With the `NONE`
+     * policy, no copy is made.
+     */
+    DeviceCopies(::sycl::queue& q,
+                 const size_type n,
+                 const DataTransferPolicy p)
+        : number_of_points(n),
+          queue(q),
+          enabled(p == DataTransferPolicy::AUTOMATIC) {}
+    DeviceCopies(DeviceCopies&&) = delete;
+    DeviceCopies(const DeviceCopies&) = delete;
+    DeviceCopies& operator=(DeviceCopies&&) = delete;
+    DeviceCopies& operator=(const DeviceCopies&) = delete;
+    /*!
+     * \brief copy a field in device memory if it is not accessible by the
+     * device, and make the field refer to the copy. All the values covered
+     * by the strides of the field are copied. For an output, only the
+     * values of the field are copied back, so that the values of other
+     * outputs sharing the same memory (for example, the thermodynamic
+     * forces and the internal state variables of a point stored
+     * contiguously) are not overwritten.
+     * \param[in,out] f: field
+     * \param[in] size: number of components
+     * \param[in] output: if true, the field is an output
+     */
+    template <typename FieldType>
+    void transfer(FieldType& f, const size_type size, const bool output) {
+      const auto n = this->number_of_points;
+      if ((!this->enabled) || (f.values == nullptr) || (size == 0) ||
+          (n == 0) || (this->isAccessible(f.values))) {
+        return;
+      }
+      const auto extent =
+          (n - 1) * f.point_stride + (size - 1) * f.component_stride + 1;
+      using value_type =
+          std::remove_const_t<std::remove_pointer_t<decltype(f.values)>>;
+      const auto l = Layout{n, size, f.point_stride, f.component_stride};
+      f.values = static_cast<value_type*>(this->copy(
+          f.values, extent * sizeof(value_type), sizeof(value_type), output,
+          extent == n * size ? std::optional<Layout>{} : l));
+    }
+    /*!
+     * \brief copy an array in device memory if it is not accessible by the
+     * device, and make the pointer refer to the copy.
+     * \param[in,out] p: pointer to the array
+     * \param[in] size: number of values
+     * \param[in] output: if true, the array is an output
+     */
+    template <typename ValueType>
+    void transfer(ValueType*& p, const size_type size, const bool output) {
+      if ((!this->enabled) || (p == nullptr) || (size == 0) ||
+          (this->isAccessible(p))) {
+        return;
+      }
+      using value_type = std::remove_const_t<ValueType>;
+      p = static_cast<value_type*>(this->copy(p, size * sizeof(value_type),
+                                              sizeof(value_type), output,
+                                              std::optional<Layout>{}));
+    }
+    /*!
+     * \brief copy the outputs back to their original locations, once the
+     * computations submitted to the queue are completed
+     */
+    void copyOutputs() {
+      if (this->copies.empty()) {
+        return;
+      }
+      this->queue.wait_and_throw();
+      for (const auto& c : this->copies) {
+        if (!c.output) {
+          continue;
+        }
+        if (!c.layout.has_value()) {
+          this->queue.memcpy(c.host, c.device, c.size).wait_and_throw();
+          continue;
+        }
+        auto values = std::vector<std::byte>(c.size);
+        this->queue.memcpy(values.data(), c.device, c.size).wait_and_throw();
+        const auto& l = *(c.layout);
+        auto* const host = static_cast<std::byte*>(c.host);
+        for (size_type i = 0; i != l.number_of_points; ++i) {
+          for (size_type k = 0; k != l.number_of_components; ++k) {
+            const auto o =
+                (i * l.point_stride + k * l.component_stride) * c.value_size;
+            std::memcpy(host + o, values.data() + o, c.value_size);
+          }
+        }
+      }
+    }
+    /*!
+     * \return if the given pointer is accessible by the device: any pointer
+     * if the device is the host, the memory allocated by SYCL (unified
+     * shared memory) otherwise
+     * \param[in] p: pointer
+     */
+    [[nodiscard]] bool isAccessible(const void* const p) const {
+      if (this->queue.get_device().is_cpu()) {
+        return true;
+      }
+      return ::sycl::get_pointer_type(p, this->queue.get_context()) !=
+             ::sycl::usm::alloc::unknown;
+    }
+    //! \return if the arrays which are not accessible are copied
+    [[nodiscard]] bool isEnabled() const noexcept { return this->enabled; }
+    //! \return if some arrays have been copied
+    [[nodiscard]] bool holdsCopies() const noexcept {
+      return !this->copies.empty();
+    }
+    //! \brief destructor
+    ~DeviceCopies() {
+      for (const auto& c : this->copies) {
+        ::sycl::free(c.device, this->queue);
+      }
+    }
+
+   private:
+    //! \brief positions of the values of a strided field
+    struct Layout {
+      size_type number_of_points;
+      size_type number_of_components;
+      size_type point_stride;
+      size_type component_stride;
+    };
+    //! \brief description of a copy in device memory
+    struct Copy {
+      //! \brief original location
+      void* host;
+      //! \brief copy
+      void* device;
+      //! \brief size in bytes
+      std::size_t size;
+      //! \brief size of a value in bytes
+      std::size_t value_size;
+      //! \brief if true, the copy must be copied back
+      bool output;
+      /*!
+       * \brief positions of the values of the field, if the copy also
+       * covers values which do not belong to the field
+       */
+      std::optional<Layout> layout;
+    };
+    /*!
+     * \brief copy an array in device memory
+     * \return the copy
+     * \param[in] p: array
+     * \param[in] size: size in bytes
+     * \param[in] value_size: size of a value in bytes
+     * \param[in] output: if true, the copy must be copied back
+     * \param[in] layout: positions of the values to be copied back, if
+     * not all the values of the array
+     */
+    void* copy(const void* const p,
+               const std::size_t size,
+               const std::size_t value_size,
+               const bool output,
+               const std::optional<Layout>& layout) {
+      // the description of the copy is stored before the allocation, so
+      // that the copy is freed by the destructor in case of exception
+      this->copies.reserve(this->copies.size() + 1);
+      auto* const c = ::sycl::malloc_device(size, this->queue);
+      if (c == nullptr) {
+        tfel::raise("memory allocation failed on the SYCL device");
+      }
+      this->copies.push_back(
+          Copy{const_cast<void*>(p), c, size, value_size, output, layout});
+      this->queue.memcpy(c, p, size).wait_and_throw();
+      return c;
+    }
+    //! \brief number of points of the fields
+    const size_type number_of_points;
+    //! \brief copies
+    std::vector<Copy> copies;
+    //! \brief queue
+    ::sycl::queue& queue;
+    //! \brief if false, no copy is made
+    const bool enabled;
+  };
+
+}  // end of namespace mfront::generic_parallel::sycl
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_SYCLDEVICECOPIES_HXX */
