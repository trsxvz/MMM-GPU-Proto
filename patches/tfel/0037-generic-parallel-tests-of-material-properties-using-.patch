diff --git a/test-suite/material-properties/generic-parallel/LinearDataInterpolationTest.mfront b/test-suite/material-properties/generic-parallel/LinearDataInterpolationTest.mfront
new file mode 100644
index 000000000..b08b8b769
--- /dev/null
+++ b/test-suite/material-properties/generic-parallel/LinearDataInterpolationTest.mfront
@@ -0,0 +1,23 @@
+@DSL MaterialProperty;
+@Law LinearDataInterpolationTest;
+@Description {
+  "A material property defined by the linear interpolation of data. The "
+  "abscissae and the ordinates of the data are stored in arrays named "
+  "after the input and the output (`mfront_T_values` and "
+  "`mfront_E_values`), which must not conflict with the names used by the "
+  "generic-parallel interface."
+}
+
+@UseQt true;
+@UnitSystem SI;
+
+@Output stress E;
+E.setGlossaryName("YoungModulus");
+
+@StateVariable temperature T;
+T.setGlossaryName("Temperature");
+
+@Data {
+  values: { 293.15 : 240e9, 693.15 : 180e9, 893.15 : 170e9 },
+  interpolation : "linear"
+}
diff --git a/test-suite/material-properties/generic-parallel/MaterialLawCallTest.mfront b/test-suite/material-properties/generic-parallel/MaterialLawCallTest.mfront
new file mode 100644
index 000000000..6f51942a0
--- /dev/null
+++ b/test-suite/material-properties/generic-parallel/MaterialLawCallTest.mfront
@@ -0,0 +1,20 @@
+@DSL MaterialLaw;
+@Law MaterialLawCallTest;
+@Description {
+  "A material property calling another material property: the shear "
+  "modulus is computed from the Young modulus of Inconel600 and a "
+  "constant Poisson ratio."
+}
+
+@Input TK;
+TK.setGlossaryName("Temperature");
+
+@Output G;
+G.setGlossaryName("ShearModulus");
+
+@MaterialLaw "Inconel600_YoungModulus.mfront";
+
+@Function {
+  const real E = Inconel600_YoungModulus(TK);
+  G = E / (2 * (1 + 0.3));
+}
