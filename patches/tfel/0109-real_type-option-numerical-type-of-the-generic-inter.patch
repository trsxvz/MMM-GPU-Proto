  */
+#ifdef MFRONT_GMP_REAL_TYPE
+typedef MFRONT_GMP_REAL_TYPE mfront_gmp_real;
+#else  /* MFRONT_GMP_REAL_TYPE */
 typedef double mfront_gmp_real;
+#endif /* MFRONT_GMP_REAL_TYPE */
+/*!
