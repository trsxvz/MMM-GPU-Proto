diff --git a/mfront/include/MFront/GenericParallelBehaviour/GPU.hxx b/mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
index e27270200..9980e21d4 100644
--- a/mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
+++ b/mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
@@ -2,7 +2,10 @@
  * \file   mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
  * \brief  This file implements the integration of a batch of integration
  * points with CUDA or HIP. This file must be compiled by a CUDA or a HIP
- * compiler.
+ * compiler. The HIP runtime is used if the `hip/hip_runtime.h` header has
+ * been included before this file or if the HIP language is enabled, the
+ * CUDA runtime otherwise. Including the HIP runtime header first is required
+ * to use HIP on NVIDIA GPUs, since `hipcc` then calls `nvcc`.
  * \date   05/10/2026
  * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
  * reserved.
@@ -17,7 +20,7 @@
 
 #include <mutex>
 #include <cstring>
-#if defined(__HIPCC__)
+#if defined(__HIPCC__) || defined(__HIP__)
 #include <hip/hip_runtime.h>
 #define MFRONT_GPB_GPU_API(f) hip##f
 #else
@@ -30,6 +33,13 @@ namespace mfront::gpb::gpu {
 
   namespace internals {
 
+    //! \brief device attribute giving the warp size
+#if defined(__HIPCC__) || defined(__HIP__)
+    inline constexpr auto warp_size_attribute = hipDeviceAttributeWarpSize;
+#else
+    inline constexpr auto warp_size_attribute = cudaDevAttrWarpSize;
+#endif
+
     /*!
      * \brief statistics on the integration of a batch, stored on the
      * device. The time step scaling factor is stored as an ordered key (see
@@ -79,7 +89,9 @@ namespace mfront::gpb::gpu {
       // the stack size is a property of the context, shared by all threads
       static std::mutex m;
       auto a = MFRONT_GPB_GPU_API(FuncAttributes){};
-      if (const auto e = MFRONT_GPB_GPU_API(FuncGetAttributes)(&a, k);
+      // the HIP runtime only provides the untyped overload
+      if (const auto e = MFRONT_GPB_GPU_API(FuncGetAttributes)(
+              &a, reinterpret_cast<const void*>(k));
           e != MFRONT_GPB_GPU_API(Success)) {
         return e;
       }
@@ -231,7 +243,7 @@ namespace mfront::gpb::gpu {
     auto warp_size = 0;
     if (failed(MFRONT_GPB_GPU_API(GetDevice)(&device)) ||
         failed(MFRONT_GPB_GPU_API(DeviceGetAttribute)(
-            &warp_size, MFRONT_GPB_GPU_API(DevAttrWarpSize), device))) {
+            &warp_size, internals::warp_size_attribute, device))) {
       return s.status;
     }
     const auto ws = static_cast<unsigned int>(warp_size);
diff --git a/mfront/src/GenericParallel/Behaviour/GPUBackend.cxx b/mfront/src/GenericParallel/Behaviour/GPUBackend.cxx
index 5cf92925a..085db618b 100644
--- a/mfront/src/GenericParallel/Behaviour/GPUBackend.cxx
+++ b/mfront/src/GenericParallel/Behaviour/GPUBackend.cxx
@@ -47,6 +47,12 @@ namespace mfront::generic_parallel::behaviour {
 
   std::string HIPBackend::getSourceFileExtension() const { return "hip"; }
 
+  void HIPBackend::writeSpecificIncludes(std::ostream& os) const {
+    // selects the HIP runtime, even on NVIDIA GPUs
+    os << "#include \"hip/hip_runtime.h\"\n";
+    GPUBackend::writeSpecificIncludes(os);
+  }  // end of writeSpecificIncludes
+
   HIPBackend::~HIPBackend() noexcept = default;
 
 }  // end of namespace mfront::generic_parallel::behaviour
diff --git a/test-suite/behaviours/generic-parallel/compare.cxx b/test-suite/behaviours/generic-parallel/compare.cxx
