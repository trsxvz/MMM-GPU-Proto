From d198342b45d7123caa496f800bcc79eb2a40850a Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 5 Oct 2026 14:50:55 +0200
Subject: [PATCH] generic-parallel: HIP backend tested on NVIDIA GPUs

- the HIP backend of the behaviours includes the HIP runtime header before
  `GPU.hxx`, so that the HIP runtime is also used on NVIDIA GPUs, where
  `hipcc` calls `nvcc` and does not define the HIP language macros;
- `GPU.hxx`: the warp size attribute has different names in CUDA and HIP,
  and HIP only provides the untyped overload of `hipFuncGetAttributes`;
- the comparison program can be compiled with the HIP runtime;
- new `hip-hipcc` test for the behaviours;
- `hip-hipcc` configuration: the `nvcc` specific flags are only used on the
  NVIDIA platform, and the HIP include directory is no longer added since
  `hipcc` already knows it (`-isystem /usr/include` breaks the standard
  library headers when HIP is installed in `/usr`).
---
 cmake/modules/tfel.cmake                      |  5 ++-
 .../configuration-files/config-hip-hipcc.json |  2 +-
 .../GenericParallel/Behaviour/GPUBackend.hxx  |  1 +
 .../MFront/GenericParallelBehaviour/GPU.hxx   | 20 ++++++++--
 .../GenericParallel/Behaviour/GPUBackend.cxx  |  6 +++
 .../behaviours/generic-parallel/compare.cxx   | 38 ++++++++++++-------
 .../generic-parallel/hip-hipcc/test.check     | 24 ++++++++++++
 .../generic-parallel/hip-hipcc/test.check     |  2 +-
 8 files changed, 76 insertions(+), 22 deletions(-)
 create mode 100644 test-suite/behaviours/generic-parallel/hip-hipcc/test.check

diff --git a/cmake/modules/tfel.cmake b/cmake/modules/tfel.cmake
index 08cfdbb1f..ac70e4b5e 100644
--- a/cmake/modules/tfel.cmake
+++ b/cmake/modules/tfel.cmake
@@ -582,14 +582,15 @@ if(TFEL_REQUIRES_HIP)
  endif(NOT HIP_PLATFORM)
  if(HIP_PLATFORM STREQUAL "nvidia")
    set(TFEL_REQUIRES_CUDA ON)
-   set(TFEL_HIPCC_FLAGS "-x cu")
+   # hipcc calls nvcc
+   set(TFEL_HIPCC_FLAGS "-x cu -arch=native --compiler-options=-fPIC --expt-relaxed-constexpr -diag-suppress 20012,20208,2810,3189")
    add_tfel_substitution(TFEL_HIPCC_FLAGS "${TFEL_HIPCC_FLAGS}")
    if("hip-clang" IN_LIST generic-parallel-configurations)
     list(APPEND tfel-check-components
          "mfront::material_property::generic-parallel_interface::supported_configuration::hip-clang-nvidia-platform")
    endif("hip-clang" IN_LIST generic-parallel-configuration)
  elseif(HIP_PLATFORM STREQUAL "amd")
-   set(TFEL_HIPCC_FLAGS "")
+   set(TFEL_HIPCC_FLAGS "-fPIC")
    add_tfel_substitution(TFEL_HIPCC_FLAGS "${TFEL_HIPCC_FLAGS}")
  else()
    message(FATAL_ERROR "unsupported value of HIP_PLATFORM. Expected 'amd' or 'nvidia', got '${HIP_PLATFORM}'")
diff --git a/mfront/configuration-files/config-hip-hipcc.json b/mfront/configuration-files/config-hip-hipcc.json
index e0c6d2190..973c7c913 100644
--- a/mfront/configuration-files/config-hip-hipcc.json
+++ b/mfront/configuration-files/config-hip-hipcc.json
@@ -12,6 +12,6 @@ interfaces_options: {
 compilation_options : {
   hip: {
     compiler: "@TFEL_HIPCC_COMPILER@",
-    compilation_flags: "@TFEL_HIPCC_FLAGS@ --compiler-options=-fPIC --std=c++@TFEL_CXX_STANDARD@ --expt-relaxed-constexpr -isystem @TFEL_HIP_INCLUDE_DIR@ -diag-suppress 20012"
+    compilation_flags: "@TFEL_HIPCC_FLAGS@ -O2 --std=c++@TFEL_CXX_STANDARD@"
   }
 }
\ No newline at end of file
diff --git a/mfront/include/MFront/GenericParallel/Behaviour/GPUBackend.hxx b/mfront/include/MFront/GenericParallel/Behaviour/GPUBackend.hxx
