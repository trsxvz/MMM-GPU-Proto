@@ -12,8 +12,10 @@
  *   operator, no tangent operator;
  * - storage of the fields: point by point, component by component.
  *
- * This file can be compiled by a C++ compiler or by a CUDA compiler. In the
- * latter case, the data are allocated in managed memory.
+ * This file can be compiled by a C++ compiler, by a CUDA compiler or by a
+ * HIP compiler. In the two last cases, the data are allocated in managed
+ * memory. The HIP runtime is used if the HIP language is enabled or if the
+ * `MFRONT_GPB_COMPARE_USE_HIP` macro is defined (required on NVIDIA GPUs).
  *
  * \date   05/10/2026
  */
@@ -28,9 +30,13 @@
 #include <vector>
 #include <utility>
 #include <algorithm>
-#ifdef __CUDACC__
+#if defined(__HIP__) || defined(MFRONT_GPB_COMPARE_USE_HIP)
+#include <hip/hip_runtime.h>
+#define GPU_API(f) hip##f
+#elif defined(__CUDACC__)
 #include <cuda_runtime.h>
-#endif /* __CUDACC__ */
+#define GPU_API(f) cuda##f
+#endif
 #include "MFront/GenericBehaviour/BehaviourData.h"
 #include "MFront/GenericParallelBehaviour/BatchData.h"
 
@@ -67,22 +73,22 @@ struct States {
   std::exit(EXIT_FAILURE);
 }
 
-#ifdef __CUDACC__
+#ifdef GPU_API
 
-static void check(const cudaError_t e) {
-  if (e != cudaSuccess) {
-    fail(std::string{"CUDA error: "} + cudaGetErrorString(e));
+static void check(const GPU_API(Error_t) e) {
+  if (e != GPU_API(Success)) {
+    fail(std::string{"GPU error: "} + GPU_API(GetErrorString)(e));
   }
 }
 
 template <typename T>
 static T* allocate(const std::size_t n) {
   T* p = nullptr;
-  check(cudaMallocManaged(&p, std::max<std::size_t>(n, 1) * sizeof(T)));
+  check(GPU_API(MallocManaged)(&p, std::max<std::size_t>(n, 1) * sizeof(T)));
   return p;
 }
 
-static void deallocate(void* const p) { check(cudaFree(p)); }
+static void deallocate(void* const p) { check(GPU_API(Free)(p)); }
 
 //! \brief move the data to the device before the computation
 template <typename T>
@@ -91,16 +97,20 @@ static void prefetch(T* const p, const std::size_t n) {
     return;
   }
   int device = 0;
-  check(cudaGetDevice(&device));
+  check(GPU_API(GetDevice)(&device));
+#if defined(__HIPCC__) || defined(__HIP__)
+  check(hipMemPrefetchAsync(p, n * sizeof(T), device, 0));
+#else
   auto location = cudaMemLocation{};
   location.type = cudaMemLocationTypeDevice;
   location.id = device;
   check(cudaMemPrefetchAsync(p, n * sizeof(T), location, 0, 0));
+#endif
 }
 
-static void synchronize() { check(cudaDeviceSynchronize()); }
+static void synchronize() { check(GPU_API(DeviceSynchronize)()); }
 
-#else /* __CUDACC__ */
+#else /* GPU_API */
 
 template <typename T>
 static T* allocate(const std::size_t n) {
@@ -119,7 +129,7 @@ static void prefetch(T* const, const std::size_t) {}
 
 static void synchronize() {}
 
-#endif /* __CUDACC__ */
+#endif /* GPU_API */
 
 static void* load(const std::string& lib, const std::string& f) {
   auto* const l = dlopen(lib.c_str(), RTLD_NOW | RTLD_LOCAL);
diff --git a/test-suite/behaviours/generic-parallel/hip-hipcc/test.check b/test-suite/behaviours/generic-parallel/hip-hipcc/test.check
new file mode 100644
index 000000000..1e5228326
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/hip-hipcc/test.check
@@ -0,0 +1,24 @@
+@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::hip-hipcc"};
+
+@Environment {"LD_LIBRARY_PATH": "src"};
+// the generic interface gives the reference results. Using both interfaces
+// in the same call also checks that they can be used together.
+@Command "@mfront@ --obuild --search-path=.. --interface=generic --interface=generic-parallel --configuration-file=config-hip-hipcc.json ../IsotropicLinearHardeningPlasticity.mfront ../ImplicitNorton.mfront ../HosfordPerfectPlasticity.mfront ../StrainHardeningCreep3.mfront";
+@Command "@TFEL_HIPCC_COMPILER@ @TFEL_HIPCC_FLAGS@ -O2 --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPB_COMPARE_USE_HIP -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl";
+// arguments: libraries, function, sizes of the gradients, thermodynamic
+// forces, material properties, internal state variables, external state
+// variables and tangent operator, strain amplitude, material properties,
+// temperature
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-hip.so IsotropicLinearHardeningPlasticity_Tridimensional 6 6 0 7 1 36 3e-3 - 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-hip.so IsotropicLinearHardeningPlasticity_PlaneStrain 4 4 0 5 1 16 3e-3 - 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-hip.so ImplicitNorton_Tridimensional 6 6 2 7 1 36 1e-3 150e9,0.3 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-hip.so ImplicitNorton_PlaneStress 4 4 2 6 1 16 1e-3 150e9,0.3 293.15";
+// Hosford criterion: eigen values, local memory larger than the default
+// stack size of CUDA threads
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-hip.so HosfordPerfectPlasticity_Tridimensional 6 6 0 7 1 36 5e-4 - 293.15";
+// elastic properties given by a material law evaluated on the device, and
+// quantities
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-hip.so StrainHardeningCreep3_Tridimensional 6 6 0 11 1 36 1e-3 - 600";
+
+@CleanFiles {"compare"};
+@CleanDirectories {"include", "src"};
