@@ -60,6 +60,7 @@ namespace mfront::generic_parallel::behaviour {
     using GPUBackend::GPUBackend;
     [[nodiscard]] std::string getName() const override;
     [[nodiscard]] std::string getSourceFileExtension() const override;
