From 60536d2016d79e074df9d67fec89226dadfc957b Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 19:23:25 +0200
Subject: [PATCH] generic-parallel: optimisation flags of the libraries of the
 generic interface in the configuration files of g++

The configuration files of g++ on the host (openmp-host-gcc,
stlpar-parunseq-gcc) compiled the libraries with -O2 only. At -O2, g++ 14
only vectorizes loops with a very cheap cost model: the integration of a
single crystal behaviour (finite strain, implicit scheme, 5 grains
polycrystal of mm-opera-hpc) took 78.4 s instead of 67.1 s with
-ftree-vectorize, the time of the library generated by the generic
interface (66.2 s). The flags of `tfel-config --oflags` are now used:
-ftree-vectorize, -DNDEBUG and -DTFEL_NO_RUNTIME_CHECK_BOUNDS (the last two
had no measurable effect on this case).
---
 docs/web/generic-parallel-behaviour-interface.md          | 8 ++++++++
 mfront/configuration-files/config-openmp-host-gcc.json    | 2 +-
 .../configuration-files/config-stlpar-parunseq-gcc.json   | 2 +-
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index 4245577f6..abda379d5 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -535,6 +535,14 @@ option is not found in the current directory.
 Those files use the substitutions of `TFEL` (paths to the compilers,
 flags, etc.) described on the [`TFEL/Config` page](tfel-config.html).
 
+The configuration files of `g++` on the host (`openmp-host-gcc`,
+`stlpar-parunseq-gcc`) use the optimisation flags of the libraries
+generated by the `generic` interface (`-O2 -ftree-vectorize`, without
+runtime checks). At `-O2`, `g++` 14 only vectorizes loops with a very cheap
+cost model: without `-ftree-vectorize`, the integration of a single crystal
+behaviour (finite strain, implicit scheme) was 17% slower than with the
+`generic` interface.
+
 ## `CUDA` and `HIP` backends
 
 One thread integrates the behaviour at one point. The kernel is launched on
diff --git a/mfront/configuration-files/config-openmp-host-gcc.json b/mfront/configuration-files/config-openmp-host-gcc.json
index c9f08f56d..8d2e0f110 100644
--- a/mfront/configuration-files/config-openmp-host-gcc.json
+++ b/mfront/configuration-files/config-openmp-host-gcc.json
@@ -9,7 +9,7 @@ interfaces_options: {
 compilation_options : {
   cxx : {
     compiler: "@TFEL_GXX_COMPILER@",
-    compilation_flags: "-O2 -fopenmp -std=c++@TFEL_CXX_STANDARD@ -march=native"
+    compilation_flags: "-O2 -ftree-vectorize -DNDEBUG -DTFEL_NO_RUNTIME_CHECK_BOUNDS -fopenmp -std=c++@TFEL_CXX_STANDARD@ -march=native"
   }
 },
 linking_options : {
diff --git a/mfront/configuration-files/config-stlpar-parunseq-gcc.json b/mfront/configuration-files/config-stlpar-parunseq-gcc.json
index 3eba47a6c..b49449ccc 100644
--- a/mfront/configuration-files/config-stlpar-parunseq-gcc.json
+++ b/mfront/configuration-files/config-stlpar-parunseq-gcc.json
@@ -9,7 +9,7 @@ interfaces_options: {
 compilation_options : {
   cxx : {
     compiler: "@TFEL_GXX_COMPILER@",
-    compilation_flags: "-O2 -std=c++@TFEL_CXX_STANDARD@ -march=native" 
+    compilation_flags: "-O2 -ftree-vectorize -DNDEBUG -DTFEL_NO_RUNTIME_CHECK_BOUNDS -std=c++@TFEL_CXX_STANDARD@ -march=native" 
   }
 },
 linking_options : {
