From 52eed73989507eafec68dac4a5cd585555d3a248 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 7 Oct 2026 03:26:02 +0200
Subject: [PATCH] MFront: internal linkage of the classes generated for the
 generic models

The parameters of a model generated by the `generic` and `generic-parallel`
interfaces are stored by a static variable of an inline function, emitted
by GCC as a unique symbol (STB_GNU_UNIQUE). The dynamic loader merges such
symbols across libraries, even if they are loaded with RTLD_LOCAL: the
libraries generated by both interfaces for the same model shared their
parameters, and two versions of a model would share an object whose layout
may differ. The generated classes are now declared in an unnamed
namespace. The parameters of the behaviours were already distinct in each
library.
---
 mfront/src/GenericModelInterface.cxx         | 9 +++++++--
 mfront/src/GenericParallelModelInterface.cxx | 9 +++++++--
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/mfront/src/GenericModelInterface.cxx b/mfront/src/GenericModelInterface.cxx
index afd4e45d2..62a35eb05 100644
--- a/mfront/src/GenericModelInterface.cxx
+++ b/mfront/src/GenericModelInterface.cxx
@@ -559,7 +559,11 @@ namespace mfront {
       os << md.sources << "\n\n";
     }
     //
-    os << "namespace mfront::gm{\n\n";
+    // the generated classes have internal linkage: two libraries
+    // generated for the same model do not share their parameters
+    // (static variables of inline functions are unique symbols)
+    os << "namespace mfront::gm{\n\n"
+       << "namespace {\n\n";
     writeGenericModelClass(os, fd, md, GenericModelClassOptions{});
     //
 
@@ -583,7 +587,8 @@ namespace mfront {
        << "}\n"
        << "return 1;\n"
        << "}\n\n";
-    os << "} // end of namespace mfront::gm\n\n";
+    os << "} // end of namespace\n\n"
+       << "} // end of namespace mfront::gm\n\n";
     //
     if ((hasRealParameters(md)) &&
         (!areParametersTreatedAsStaticVariables(md))) {
diff --git a/mfront/src/GenericParallelModelInterface.cxx b/mfront/src/GenericParallelModelInterface.cxx
index 05804552d..66ebc4cdb 100644
--- a/mfront/src/GenericParallelModelInterface.cxx
+++ b/mfront/src/GenericParallelModelInterface.cxx
@@ -234,7 +234,11 @@ namespace mfront {
       os << md.sources << "\n\n";
     }
     const auto parameters = getParametersStructureName(md);
-    os << "namespace mfront::gm{\n\n";
+    // the generated classes have internal linkage: two libraries
+    // generated for the same model do not share their parameters
+    // (static variables of inline functions are unique symbols)
+    os << "namespace mfront::gm{\n\n"
+       << "namespace {\n\n";
     if (hasGenericModelParametersInitializer(md)) {
       // structure holding the values of the parameters, filled on the host
       // and passed by value to the device
@@ -251,7 +255,8 @@ namespace mfront {
     writeGenericModelClass(os, fd, md,
                            GenericModelClassOptions{
                                .device = true, .parameters_type = parameters});
-    os << "} // end of namespace mfront::gm\n\n";
+    os << "} // end of namespace\n\n"
+       << "} // end of namespace mfront::gm\n\n";
     // description of the data of a point
     const auto point_traits = md.className + "PointTraits";
     os << "namespace {\n\n"
-- 
