 ...StrainHardeningMisesCreepCodeGenerator.cxx |   2 +-
 ...ltipleIsotropicMisesFlowsCodeGenerator.cxx |   2 +-
 mfront/src/RungeKuttaCodeGeneratorBase.cxx    |   6 +-
 10 files changed, 77 insertions(+), 88 deletions(-)

diff --git a/include/TFEL/Material/MechanicalBehaviour.hxx b/include/TFEL/Material/MechanicalBehaviour.hxx
index 576ae7557..84067e93d 100644
--- a/include/TFEL/Material/MechanicalBehaviour.hxx
+++ b/include/TFEL/Material/MechanicalBehaviour.hxx
@@ -15,6 +15,7 @@
 #define LIB_TFEL_MATERIAL_MECHANICALBEHAVIOUR_HXX
 
 #include <utility>
+#include <concepts>
 #include "TFEL/Config/TFELTypes.hxx"
 #include "TFEL/Material/ModellingHypothesis.hxx"
 #include "TFEL/Material/FiniteStrainBehaviourTangentOperatorBase.hxx"
@@ -149,7 +150,29 @@ namespace tfel::material {
 
   /*!
    * \class MechanicalBehaviour
-   * \brief This class declares an interface for mechanical behaviours.
+   * \brief This class is the base class of mechanical behaviours. It
+   * defines the types and constants shared by all the behaviours.
+   *
+   * A mechanical behaviour shall provide the following methods (see the
+   * `MechanicalBehaviourConcept` concept):
+   *
+   * - `computePredictionOperator(smflag, smt)`, which only computes a
+   *   prediction operator;
+   * - `integrate(smflag, smt)`, which determines the values of the
+   *   internal state variables at the end of the time step and computes the
+   *   tangent operator if requested;
+   * - `getMinimalTimeStepScalingFactor()`, which returns the minimal
+   *   scaling factor to be used if the integration failed;
+   * - `computeAPrioriTimeStepScalingFactor(rdt)` and
+   *   `computeAPosterioriTimeStepScalingFactor(rdt)`, which return a pair
+   *   containing a boolean (saying if the integration shall be performed,
+   *   or considered a success) and a time step scaling factor proposed by
+   *   the behaviour.
+   *
+   * Those methods are not virtual: behaviours are never manipulated through
+   * a reference to this class and virtual functions are not supported in
+   * device code by some parallel programming models (SYCL).
+   *
    * \param H, modelling hypothesis
    * \param NumType, numerical type.
    * \param bool use_qt, says if one shall use quantities.
@@ -171,72 +194,36 @@ namespace tfel::material {
         ModellingHypothesisToSpaceDimension<H>::value;
     //! \brief a simple alias
     using TFELTypes = tfel::config::Types<N, NumType, use_qt>;
-    /*!
-     * \brief only compute a prediction stiffness matrix.
-     * The result shall be retrieved through the
-     * "getTangeOperator" method
-     * \param[in] smflag : expected tangent operator
-     * \param[in] smt    : expected tangent operator
-     * \return SUCCESS if the integration is successfull.
-     */
-    TFEL_HOST_DEVICE virtual IntegrationResult computePredictionOperator(
-        const SMFlag, const SMType) = 0;
-    /*!
-     * \return the minimal scaling factor to be used. This scaling
-     * factor is used to decrease the time step if the integration
-     * failed.
-     */
-    TFEL_HOST_DEVICE virtual typename TFELTypes::real
-    getMinimalTimeStepScalingFactor() const = 0;
-    /*!
-     * \param[in] dt: time step scaling factor proposed by the calling code
-     * \return a pair containing:
-     * - a boolean syaing if the behaviour integration shall be
-     *   performed
-     * - a scaling factor that can be used to:
-     *     - increase the time step if the integration was successfull
-     *     - decrease the time step if the integration failed or if the
-     *       results were not reliable (time step too large).
-     *
-     * Interfaces to behaviour law shall use the
-     * hasAPrioriTimeStepScalingFactor of the traits class
-     * MechanicalBehaviourTraits to know if the behaviour is able to
-     * give such a time step scaling factor. If not, behaviours
-     * may return the NumType(1) value.
-     */
-    TFEL_HOST_DEVICE virtual std::pair<bool, typename TFELTypes::real>
-    computeAPrioriTimeStepScalingFactor(
-        const typename TFELTypes::real) const = 0;
-    /*!
-     * \brief determine the value of the internal state variables at
-     * the end of the time step
-     * \param[in] smflag : expected tangent operator
-     * \param[in] smt    : expected tangent operator
-     * \return SUCCESS if the integration is successfull.
-     */
-    TFEL_HOST_DEVICE virtual IntegrationResult integrate(const SMFlag,
-                                                         const SMType) = 0;
-    /*!
-     * \param[in] dt: current time step scaling factor
-     * \return a pair containing:
-     * - a boolean syaing if the behaviour integration shall be
-     *   considered a success or a failure
-     * - a scaling factor that can be used to:
-     *     - increase the time step if the integration was successfull
-     *     - decrease the time step if the integration failed or if the
-     *       results were not reliable (time step too large).
-     *
-     * Interfaces to behaviour law shall use the
-     * hasAPosterioriTimeStepScalingFactor of the traits class
-     * MechanicalBehaviourTraits to know if the behaviour is able to
-     * give such a time step scaling factor. If not, behaviours
-     * may return the NumType(1) value.
-     */
-    TFEL_HOST_DEVICE virtual std::pair<bool, typename TFELTypes::real>
-    computeAPosterioriTimeStepScalingFactor(
-        const typename TFELTypes::real) const = 0;
-    //! destructor
-    TFEL_HOST_DEVICE virtual ~MechanicalBehaviour() noexcept = default;
+  };
+
+  /*!
+   * \brief concept satisfied by the classes implementing a mechanical
+   * behaviour (see the documentation of the `MechanicalBehaviour` class).
+   */
+  template <typename BehaviourType>
+  concept MechanicalBehaviourConcept = requires(
+      BehaviourType & b,
+      const BehaviourType& cb,
+      const typename BehaviourType::SMFlag smflag,
+      const typename BehaviourType::SMType smt,
+      const typename BehaviourType::TFELTypes::real rdt) {
+    {
+      b.computePredictionOperator(smflag, smt)
+      } -> std::same_as<typename BehaviourType::IntegrationResult>;
+    {
+      b.integrate(smflag, smt)
+      } -> std::same_as<typename BehaviourType::IntegrationResult>;
+    {
+      cb.getMinimalTimeStepScalingFactor()
+      } -> std::convertible_to<typename BehaviourType::TFELTypes::real>;
+    {
+      cb.computeAPrioriTimeStepScalingFactor(rdt)
+      } -> std::convertible_to<
+          std::pair<bool, typename BehaviourType::TFELTypes::real>>;
+    {
+      cb.computeAPosterioriTimeStepScalingFactor(rdt)
+      } -> std::convertible_to<
+          std::pair<bool, typename BehaviourType::TFELTypes::real>>;
   };
 
 }  // end of namespace tfel::material
