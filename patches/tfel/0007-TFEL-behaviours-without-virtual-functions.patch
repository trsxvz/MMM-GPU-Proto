 .../MFront/GenericBehaviour/Integrate.hxx     |   2 +
 mfront/src/BehaviourCodeGeneratorBase.cxx     |  20 +--
 mfront/src/ImplicitCodeGeneratorBase.cxx      |   6 +-
 .../IsotropicBehaviourCodeGeneratorBase.cxx   |   2 +-
 .../src/IsotropicMisesCreepCodeGenerator.cxx  |   2 +-
