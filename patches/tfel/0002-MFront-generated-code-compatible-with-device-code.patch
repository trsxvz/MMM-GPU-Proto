+   */
+  template <typename InterfacesMap, typename Writer>
+  static void writeInterfacesCode(std::ostream& os,
+                                  const InterfacesMap& interfaces,
+                                  const Writer& w) {
+    auto blocks = std::vector<std::string>{};
+    for (const auto& i : interfaces) {
+      auto b = std::ostringstream{};
+      b.copyfmt(os);
+      w(b, *(i.second));
+      auto code = b.str();
+      if (std::find(blocks.begin(), blocks.end(), code) != blocks.end()) {
+        continue;
+      }
+      os << code;
+      blocks.push_back(std::move(code));
+    }
+  }  // end of writeInterfacesCode
