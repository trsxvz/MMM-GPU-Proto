+#ifndef LIB_MFRONT_GENERICPARALLEL_BEHAVIOUR_OPENMPBACKEND_HXX
+#define LIB_MFRONT_GENERICPARALLEL_BEHAVIOUR_OPENMPBACKEND_HXX
+
+#include "TFEL/Utilities/Data.hxx"
+#include "MFront/MFrontConfig.hxx"
+#include "MFront/GenericParallel/Behaviour/AbstractBackend.hxx"
+
+namespace mfront::generic_parallel::behaviour {
+
+  /*!
+   * \brief backend based on OpenMP.
+   *
+   * Options:
+   *
+   * - `offload`: if true (default), the computations are offloaded to the
+   *   default device (`target` construct). Otherwise, they are performed by
+   *   the threads of the host (`parallel` construct).
+   * - `device_stack_size`: stack size, in bytes, of the threads of the
+   *   device when the computations are offloaded to an NVIDIA GPU through
+   *   the CUDA runtime (ignored otherwise).
+   */
+  struct MFRONT_VISIBILITY_EXPORT OpenMPBackend final : AbstractBackend {
+    //! \brief default constructor
+    OpenMPBackend();
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    OpenMPBackend(const tfel::utilities::DataMap&);
+    //
+    [[nodiscard]] std::string getName() const override;
+    [[nodiscard]] std::string getSourceFileExtension() const override;
+    void writeSpecificIncludes(std::ostream&) const override;
+    void writeCall(std::ostream&,
+                   std::string_view,
+                   std::string_view,
+                   std::string_view) const override;
+    //! \brief destructor
+    ~OpenMPBackend() noexcept override;
+
+   private:
+    //! \brief offload the computations to the default device
+    bool offload = true;
+    //! \brief stack size of the threads of the device (0 if not specified)
+    int device_stack_size = 0;
+  };  // end of OpenMPBackend
+
+}  // end of namespace mfront::generic_parallel::behaviour
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_BEHAVIOUR_OPENMPBACKEND_HXX */
