diff --git a/mfront/include/MFront/GenericParallel/Batch.hxx b/mfront/include/MFront/GenericParallel/Batch.hxx
new file mode 100644
index 000000000..513ded283
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/Batch.hxx
@@ -0,0 +1,231 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/Batch.hxx
+ * \brief  This file declares the statistics, the execution and the report
+ * of the computations on a batch of points, shared by the
+ * `generic-parallel` interfaces for material properties, behaviours and
+ * models, and by the primitives of their backends.
+ * \date   09/11/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_BATCH_HXX
+#define LIB_MFRONT_GENERICPARALLEL_BATCH_HXX
+
+#include <bit>
+#include <cerrno>
+#include <cstddef>
+#include <cstring>
+#include <exception>
+#include <string_view>
+#include "TFEL/Config/TFELConfig.hxx"
+#include "MFront/GenericParallel/StatisticsKeys.hxx"
+#include "MFront/GenericParallel/BackendExecutionPolicy.h"
+
+/*!
+ * The primitives of the backends (`apply`, see for instance
+ * `MFront/GenericParallel/Arcane.hxx`) apply a function at the points of a
+ * batch. This function returns the statistics of a point
+ * (`BatchStatistics`). The primitives combine them, by atomic operations or
+ * by reductions, and report the result through a handler of the statistics
+ * given by the interface (`mfront::gpb::StatisticsHandler` for the behaviours
+ * and the models, `mfront::gpmp::StatisticsHandler` for the material
+ * properties), which provides:
+ *
+ * - the type `OutputStatus` of the output status and the type `Statistics`
+ *   of the statistics updated by the devices and given by the calling code
+ *   (C structures of the interface);
+ * - `initial()`: the statistics of a batch without event, neutral element of
+ *   the reductions;
+ * - `initialize(Statistics&)`: initialization of the statistics updated by
+ *   the devices;
+ * - `report(OutputStatus&, const Statistics&)`: report of the statistics
+ *   updated by the devices, once the computations are completed;
+ * - `report(OutputStatus&, Statistics*, const BatchStatistics&)`: report of
+ *   the statistics combined by a reduction, or accumulation of those
+ *   statistics in the statistics given by the calling code, if any.
+ */
+
+namespace mfront::generic_parallel {
+
+  //! \brief type of the indices and of the numbers of points
+  using size_type = std::size_t;
+
+  /*!
+   * \brief statistics of the computations at one point or at a group of
+   * points of a batch, combined by parallel reductions. The keys are built
+   * by `makeKey`. The material properties leave the time step scaling factor
+   * to its neutral value.
+   * \tparam real: numeric type of the time step scaling factor
+   */
+  template <typename real>
+  struct BatchStatistics {
+    //! \brief combine two statistics
+    TFEL_HOST_DEVICE friend constexpr BatchStatistics combine(
+        const BatchStatistics& a, const BatchStatistics& b) noexcept {
+      return {.number_of_failures = a.number_of_failures + b.number_of_failures,
+              .first_failure = a.first_failure < b.first_failure
+                                   ? a.first_failure
+                                   : b.first_failure,
+              .number_of_unreliable_results = a.number_of_unreliable_results +
+                                              b.number_of_unreliable_results,
+              .first_unreliable_result =
+                  a.first_unreliable_result < b.first_unreliable_result
+                      ? a.first_unreliable_result
+                      : b.first_unreliable_result,
+              .rdt = a.rdt < b.rdt ? a.rdt : b.rdt};
+    }
+    //! \brief number of points where the computations failed
+    size_type number_of_failures = 0;
+    //! \brief key of the first failure (see `makeKey`)
+    unsigned long long first_failure = no_event;
+    //! \brief number of points where the result is unreliable
+    size_type number_of_unreliable_results = 0;
+    //! \brief key of the first unreliable result (see `makeKey`)
+    unsigned long long first_unreliable_result = no_event;
+    //! \brief time step scaling factor
+    real rdt = 1;
+  };
+
+  //! \brief function object combining two statistics
+  struct CombineStatistics {
+    template <typename real>
+    TFEL_HOST_DEVICE constexpr BatchStatistics<real> operator()(
+        const BatchStatistics<real>& a,
+        const BatchStatistics<real>& b) const noexcept {
+      return combine(a, b);
+    }
+  };
+
+  /*!
+   * \return an unsigned integer whose ordering is the same as the ordering
+   * of the given floating point values. This allows to compute the minimum
+   * of floating point values with an integer atomic operation. This is the
+   * encoding of the time step scaling factor in `mfront_gpb_Statistics`
+   * (see `mfront_gpb_initializeStatistics`), available in device code.
+   */
+  TFEL_HOST_DEVICE constexpr unsigned long long toOrderedKey(
+      const double v) noexcept {
+    const auto b = std::bit_cast<unsigned long long>(v);
+    constexpr auto sign = 0x8000000000000000ull;
+    return (b & sign) ? ~b : (b | sign);
+  }  // end of toOrderedKey
+
+  /*!
+   * \brief true if the statistics updated by the devices hold a time step
+   * scaling factor (behaviours and models), false otherwise (material
+   * properties)
+   */
+  template <typename Statistics>
+  inline constexpr bool hasTimeStepScalingFactor =
+      requires(Statistics& s) { s.rdt; };
+
+  /*!
+   * \brief update the statistics shared by the threads with the statistics
+   * of a point or of a group of points, by atomic operations. The shared
+   * statistics are only accessed if an event occurred: a failure, an
+   * unreliable result, or a time step scaling factor lower than the initial
+   * one.
+   * \tparam Atomics: atomic operations of the backend, given by the static
+   * functions `add` and `min` on unsigned 64 bits integers
+   * \param[in,out] s: shared statistics
+   * \param[in] r: statistics of a point or of a group of points
+   * \param[in] rdt0: ordered key of the initial time step scaling factor
+   * (see `toOrderedKey`)
+   */
+  template <typename Atomics, typename Statistics, typename real>
+  TFEL_HOST_DEVICE void updateStatistics(Statistics& s,
+                                         const BatchStatistics<real>& r,
+                                         const unsigned long long rdt0) {
+    if (r.number_of_failures != 0) {
+      Atomics::add(&(s.number_of_failures),
+                   static_cast<unsigned long long>(r.number_of_failures));
+      Atomics::min(&(s.first_failure), r.first_failure);
+    }
+    if (r.number_of_unreliable_results != 0) {
+      Atomics::add(
+          &(s.number_of_unreliable_results),
+          static_cast<unsigned long long>(r.number_of_unreliable_results));
+      Atomics::min(&(s.first_unreliable_result), r.first_unreliable_result);
+    }
+    if constexpr (hasTimeStepScalingFactor<Statistics>) {
+      const auto rdt = toOrderedKey(r.rdt);
+      if (rdt < rdt0) {
+        Atomics::min(&(s.rdt), rdt);
+      }
+    }
+  }  // end of updateStatistics
+
+  /*!
+   * \brief execution of the computations on a batch, as given by the
+   * calling code: the policy, checked by the backend against its own policy
+   * (see `mfront::generic_parallel::checkBackendExecutionPolicy`), and the
+   * statistics
+   * \tparam Statistics: statistics updated by the devices
+   */
+  template <typename Statistics>
+  struct BatchExecution {
+    //! \brief execution policy, or null for the default policy
+    const mfront_gp_AbstractBackendExecutionPolicy* policy;
+    //! \brief statistics, or null
+    Statistics* statistics;
+  };  // end of struct BatchExecution
+
+  /*!
+   * \brief set the status and the error message of an output status
+   * \param[out] s: output status
+   * \param[in] status: status
+   * \param[in] msg: error message
+   * \return the status
+   */
+  template <typename OutputStatus>
+  int report(OutputStatus& s,
+             const int status,
+             const std::string_view msg) noexcept {
+    constexpr auto msize = sizeof(s.msg) - 1;
+    const auto n = msg.size() < msize ? msg.size() : msize;
+    s.status = status;
+    std::memcpy(s.msg, msg.data(), n);
+    s.msg[n] = '\0';
+    return status;
+  }  // end of report
+
+  /*!
+   * \brief call the body of a generated function of batches, so that no
+   * exception goes through its C interface: an exception is reported as an
+   * error of the backend (status `-7`). The output status is initialized
+   * before the call, and `errno` is restored on return: it may be modified
+   * by the runtimes of the backends and by the computations on the host.
+   * \return the status
+   * \param[out] s: output status
+   * \param[in] initialize: function initializing the output status
+   * \param[in] f: body of the function, returning the status
+   */
+  template <typename OutputStatus, typename Initialize, typename Function>
+  int handleExceptions(OutputStatus* const s,
+                       const Initialize& initialize,
+                       Function&& f) noexcept {
+    if (s == nullptr) {
+      return -5;
+    }
+    struct ErrnoGuard {
+      const int value = errno;
+      ~ErrnoGuard() { errno = this->value; }
+    } const errno_guard;
+    initialize(*s);
+    try {
+      return f();
+    } catch (std::exception& e) {
+      return report(*s, -7, e.what());
+    } catch (...) {
+      return report(*s, -7, "unknown exception");
+    }
+  }  // end of handleExceptions
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_BATCH_HXX */
diff --git a/mfront/include/MFront/GenericParallel/GPU.hxx b/mfront/include/MFront/GenericParallel/GPU.hxx
new file mode 100644
index 000000000..ff9ff3501
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/GPU.hxx
@@ -0,0 +1,315 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/GPU.hxx
+ * \brief  This file declares the primitive of the `cuda` and `hip` backends
+ * of the `generic-parallel` interfaces. This file must be compiled by a CUDA
+ * or a HIP compiler. The HIP runtime is used if the `hip/hip_runtime.h`
+ * header has been included before this file or if the HIP language is
+ * enabled, the CUDA runtime otherwise. Including the HIP runtime header
+ * first is required to use HIP on NVIDIA GPUs, since `hipcc` then calls
+ * `nvcc`.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_GPU_HXX
+#define LIB_MFRONT_GENERICPARALLEL_GPU_HXX
+
+#include <limits>
+#include <string>
+#include "MFront/GenericParallel/GPUStackSize.hxx"
+#include "MFront/GenericParallel/Batch.hxx"
+#include "MFront/GenericParallel/StatusBlockPool.hxx"
+#if defined(__HIPCC__) || defined(__HIP__)
+#include "MFront/GenericParallel/HIPBackendExecutionPolicy.hxx"
+#else
+#include "MFront/GenericParallel/CUDABackendExecutionPolicy.hxx"
+#endif
+
+namespace mfront::generic_parallel::gpu {
+
+  namespace internals {
+
+#if defined(__HIPCC__) || defined(__HIP__)
+    //! \brief device attribute giving the warp size
+    inline constexpr auto warp_size_attribute = hipDeviceAttributeWarpSize;
+    //! \brief execution policy of the backend
+    using ExecutionPolicy = HIPBackendExecutionPolicy;
+#else
+    //! \brief device attribute giving the warp size
+    inline constexpr auto warp_size_attribute = cudaDevAttrWarpSize;
+    //! \brief execution policy of the backend
+    using ExecutionPolicy = CUDABackendExecutionPolicy;
+#endif
+
+    /*!
+     * \brief report an error of the runtime. Only the first error is
+     * reported.
+     * \return true if the given code denotes an error
+     * \param[in,out] s: output status
+     * \param[in] e: error code
+     */
+    template <typename OutputStatus>
+    bool failed(OutputStatus& s, const Error e) noexcept {
+      if (e == MFRONT_GENERIC_PARALLEL_GPU_API(Success)) {
+        return false;
+      }
+      if (s.status != -7) {
+        report(s, -7, MFRONT_GENERIC_PARALLEL_GPU_API(GetErrorString)(e));
+      }
+      return true;
+    }  // end of failed
+
+    /*!
+     * \brief increase the stack size of the threads if the given kernel
+     * requires it (see `mfront::generic_parallel::gpu::ensureStackSize`).
+     * \return true on success
+     * \tparam kernel: kernel
+     * \param[in,out] s: output status
+     * \param[in] preserve: if true, the stack size is not modified and an
+     * error is reported if it is too small
+     */
+    template <auto kernel, typename OutputStatus>
+    bool ensureStackSize(OutputStatus& s, const bool preserve) {
+      const auto r = gpu::ensureStackSize<kernel>(preserve);
+      if (failed(s, r.error)) {
+        return false;
+      }
+      if (r.required_stack_size != 0) {
+        report(s, -7, r.getErrorMessage());
+        return false;
+      }
+      return true;
+    }  // end of ensureStackSize
+
+    //! \brief sum of the values of a warp, in the first thread of the warp
+    template <typename T>
+    __device__ inline T warpSum(T v) {
+      for (int o = warpSize / 2; o > 0; o /= 2) {
+#if defined(__HIP_PLATFORM_AMD__)
+        v += __shfl_down(v, o);
+#else
+        v += __shfl_down_sync(0xffffffffu, v, o);
+#endif
+      }
+      return v;
+    }  // end of warpSum
+
+    //! \return true if the predicate is true for a thread of the warp
+    __device__ inline bool warpAny(const bool p) {
+#if defined(__HIP_PLATFORM_AMD__)
+      return __any(p);
+#else
+      return __any_sync(0xffffffffu, p);
+#endif
+    }  // end of warpAny
+
+    //! \brief minimum of the values of a warp, in the first thread of the warp
+    __device__ inline unsigned long long warpMin(unsigned long long v) {
+      for (int o = warpSize / 2; o > 0; o /= 2) {
+#if defined(__HIP_PLATFORM_AMD__)
+        const auto w = __shfl_down(v, o);
+#else
+        const auto w = __shfl_down_sync(0xffffffffu, v, o);
+#endif
+        v = w < v ? w : v;
+      }
+      return v;
+    }  // end of warpMin
+
+    /*!
+     * \brief apply a function at the points of a batch, one thread per
+     * point, and update the statistics of the batch. The number of threads
+     * per block must be a multiple of the warp size.
+     *
+     * \param[in] f: function
+     * \param[in] n: number of points
+     * \param[out] s: statistics
+     * \param[in] rdt0: ordered key of the initial time step scaling factor
+     */
+    template <typename Statistics, typename PointFunction>
+    __global__ void apply(const PointFunction f,
+                          const size_type n,
+                          Statistics* const s,
+                          const unsigned long long rdt0) {
+      const auto i = static_cast<size_type>(blockIdx.x) * blockDim.x +
+                     static_cast<size_type>(threadIdx.x);
+      auto failures = 0u;
+      auto first_failure = no_event;
+      auto unreliable_results = 0u;
+      auto first_unreliable_result = no_event;
+      auto rdt = rdt0;
+      if (i < n) {
+        const auto r = f(i);
+        failures = static_cast<unsigned int>(r.number_of_failures);
+        first_failure = r.first_failure;
+        unreliable_results =
+            static_cast<unsigned int>(r.number_of_unreliable_results);
+        first_unreliable_result = r.first_unreliable_result;
+        rdt = toOrderedKey(r.rdt);
+      }
+      // the statistics are only reduced and updated if a point of the warp
+      // failed, gave an unreliable result or decreased the time step
+      // scaling factor: otherwise, the statistics are not accessed
+      if (!warpAny((failures != 0) || (unreliable_results != 0) ||
+                   (rdt < rdt0))) {
+        return;
+      }
+      failures = warpSum(failures);
+      first_failure = warpMin(first_failure);
+      unreliable_results = warpSum(unreliable_results);
+      first_unreliable_result = warpMin(first_unreliable_result);
+      rdt = warpMin(rdt);
+      if (threadIdx.x % warpSize == 0) {
+        if (failures != 0) {
+          atomicAdd(&(s->number_of_failures),
+                    static_cast<unsigned long long>(failures));
+          atomicMin(&(s->first_failure), first_failure);
+        }
+        if (unreliable_results != 0) {
+          atomicAdd(&(s->number_of_unreliable_results),
+                    static_cast<unsigned long long>(unreliable_results));
+          atomicMin(&(s->first_unreliable_result), first_unreliable_result);
+        }
+        if constexpr (hasTimeStepScalingFactor<Statistics>) {
+          if (rdt < rdt0) {
+            atomicMin(&(s->rdt), rdt);
+          }
+        }
+      }
+    }  // end of apply
+
+    /*!
+     * \return the pool of blocks of managed memory holding the statistics
+     * of the synchronous computations, shared by all the functions of the
+     * library
+     * \tparam Statistics: statistics updated by the devices
+     */
+    template <typename Statistics>
+    auto& getStatisticsBlocks() noexcept {
+      using Pool = StatusBlockPool<Statistics, int>;
+      static auto pool = Pool{};
+      return pool;
+    }  // end of getStatisticsBlocks
+
+  }  // end of namespace internals
+
+  /*!
+   * \brief apply a function at the points of a batch, one thread per point,
+   * and report the statistics of the batch.
+   *
+   * The kernel is launched on the stream given by the execution policy. If
+   * the computations are asynchronous, this function returns once the
+   * kernel is launched. Otherwise, it waits for its completion.
+   *
+   * \tparam StatisticsHandler: handler of the statistics (see
+   * `MFront/GenericParallel/Batch.hxx`)
+   * \tparam PointFunction: function object taking the index of a point and
+   * returning the statistics associated with this point
+   * \param[in,out] s: output status, which must have been initialized
+   * \param[in] n: number of points
+   * \param[in] e: execution of the batch. The policy is a
+   * `CUDABackendExecutionPolicy` (`HIPBackendExecutionPolicy` with HIP), or
+   * null for the default stream.
+   * \param[in] h: handler of the statistics
+   * \param[in] f: function
+   * \param[in] threads_per_block: number of threads per block, rounded up to
+   * a multiple of the warp size
+   * \return the status
+   */
+  template <typename StatisticsHandler, typename PointFunction>
+  int apply(typename StatisticsHandler::OutputStatus& s,
+            const size_type n,
+            const BatchExecution<typename StatisticsHandler::Statistics>& e,
+            const StatisticsHandler& h,
+            const PointFunction& f,
+            const unsigned int threads_per_block) {
+    using Statistics = typename StatisticsHandler::Statistics;
+    using Stream = MFRONT_GENERIC_PARALLEL_GPU_API(Stream_t);
+    using internals::failed;
+    if (n == 0) {
+      return s.status;
+    }
+    const auto p = checkBackendExecutionPolicy<internals::ExecutionPolicy>(
+        e.policy, e.statistics != nullptr);
+    if (p.error != nullptr) {
+      return report(s, -5, p.error);
+    }
+    constexpr auto k = internals::apply<Statistics, PointFunction>;
+    if (!internals::ensureStackSize<k>(s,
+                                       p.common_options.preserve_stack_size)) {
+      return s.status;
+    }
+    auto device = 0;
+    auto warp_size = 0;
+    if (failed(s, MFRONT_GENERIC_PARALLEL_GPU_API(GetDevice)(&device)) ||
+        failed(s, MFRONT_GENERIC_PARALLEL_GPU_API(DeviceGetAttribute)(
+                      &warp_size, internals::warp_size_attribute, device))) {
+      return s.status;
+    }
+    const auto ws = static_cast<unsigned int>(warp_size);
+    const auto nthreads = ((threads_per_block + ws - 1) / ws) * ws;
+    const auto nblocks = (n + nthreads - 1) / nthreads;
+    // the number of blocks must fit in the grid of the device
+    if (nblocks >
+        static_cast<decltype(nblocks)>(std::numeric_limits<int>::max())) {
+      return report(s, -5,
+                    "too many points for the grid of the device (" +
+                        std::to_string(n) + " given)");
+    }
+    const auto stream = p.policy == nullptr ? Stream{} : p.policy->stream;
+    const auto rdt0 = toOrderedKey(h.initial().rdt);
+    if (e.statistics != nullptr) {
+      // statistics given by the calling code: the result is given by the
+      // report function of the library
+      k<<<nblocks, nthreads, 0, stream>>>(f, n, e.statistics, rdt0);
+      if (failed(s, MFRONT_GENERIC_PARALLEL_GPU_API(GetLastError)()) ||
+          p.common_options.asynchronous) {
+        return s.status;
+      }
+      failed(s, MFRONT_GENERIC_PARALLEL_GPU_API(StreamSynchronize)(stream));
+      return s.status;
+    }
+    // synchronous computations: the statistics are held by a block of
+    // managed memory, initialized and read by the host. The device only
+    // accesses this block if an event occurs (see internals::apply): no
+    // data is transferred otherwise.
+    const auto block =
+        internals::getStatisticsBlocks<Statistics>().acquire(device, [] {
+          Statistics* p = nullptr;
+          const auto r = MFRONT_GENERIC_PARALLEL_GPU_API(MallocManaged)(
+              reinterpret_cast<void**>(&p), sizeof(Statistics));
+          return r == MFRONT_GENERIC_PARALLEL_GPU_API(Success) ? p : nullptr;
+        });
+    auto* const statistics = block.get();
+    if (statistics == nullptr) {
+      return report(s, -7, "unable to allocate the statistics of the batch");
+    }
+    h.initialize(*statistics);
+    k<<<nblocks, nthreads, 0, stream>>>(f, n, statistics, rdt0);
+    if (failed(s, MFRONT_GENERIC_PARALLEL_GPU_API(GetLastError)()) ||
+        failed(s, MFRONT_GENERIC_PARALLEL_GPU_API(StreamSynchronize)(stream))) {
+      return s.status;
+    }
+    return h.report(s, *statistics);
+  }  // end of apply
+
+  /*!
+   * \return the primitive of the backend, called by the functions of the
+   * interfaces (see for instance `mfront::gpb::integrateBatch`)
+   * \param[in] threads_per_block: number of threads per block
+   */
+  inline auto makeApply(const unsigned int threads_per_block) {
+    return [threads_per_block](auto& s, const size_type n, const auto& e,
+                               const auto& h, const auto& f) {
+      return gpu::apply(s, n, e, h, f, threads_per_block);
+    };
+  }  // end of makeApply
+
+}  // end of namespace mfront::generic_parallel::gpu
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_GPU_HXX */
