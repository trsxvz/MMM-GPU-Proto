+                      << "ull, true);\n"
+                      << "return {std::numeric_limits<mfront_gmp_real>::"
+                      << "quiet_NaN(), mfront_status};\n";
+                },
+            .warning =
+                [](std::ostream& out, const GenericBase::BoundCheck& c) {
+                  out << "mfront_status.report(" << c.identifier
+                      << "ull, false);\n";
