diff --git a/test-suite/behaviours/generic-parallel/BehaviourVariableTest.mfront b/test-suite/behaviours/generic-parallel/BehaviourVariableTest.mfront
new file mode 100644
index 000000000..e367d0e0f
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/BehaviourVariableTest.mfront
@@ -0,0 +1,34 @@
+@DSL Default;
+@Behaviour BehaviourVariableTest;
+@Description {
+  "A behaviour testing behaviour variable factories: the integration is "
+  "delegated to a behaviour variable created by a factory."
+}
+
+@BehaviourVariableFactory f1 {
+  file: "BehaviourVariableTestPlasticity.mfront",
+  variables_suffix: "1",
+  external_names_prefix: "FirstPhase",
+  store_gradients: true,
+  store_thermodynamic_forces: true,
+  shared_external_state_variables: {".+"}
+};
+
+@ProvidesTangentOperator;
+@Integrator{
+  auto b1 = f1.make();
+  if (!initialize(b1)) {
+    return false;
+  }
+  b1.deto = deto;
+  const auto r = b1.integrate(smflag, smt);
+  if (!r) {
+    return false;
+  }
+  // updating the stress
+  sig = b1.sig;
+  if (computeTangentOperator_) {
+    Dt = b1.getTangentOperator();
+  }
+  updateAuxiliaryStateVariables(b1);
+}
