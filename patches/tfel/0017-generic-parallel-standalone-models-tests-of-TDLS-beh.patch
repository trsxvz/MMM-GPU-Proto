+/*!
+ * \file   mfront/include/MFront/GenericParallelModelInterface.hxx
+ * \brief  This file declares the `generic-parallel` interface for models.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
