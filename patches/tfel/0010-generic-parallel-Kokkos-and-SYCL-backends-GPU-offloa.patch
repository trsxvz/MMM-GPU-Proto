@@ -0,0 +1,157 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/Kokkos.hxx
+ * \brief  This file implements the integration of a batch of integration
+ * points with Kokkos.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_KOKKOS_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_KOKKOS_HXX
+
+#include <type_traits>
+#include <Kokkos_Core.hpp>
+#include "MFront/GenericParallelBehaviour/Integrate.hxx"
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+#include "MFront/GenericParallelBehaviour/GPU.hxx"
+#endif
+
+namespace mfront::gpb::kokkos {
+
+  namespace internals {
+
+    /*!
+     * \brief functor computing the statistics of a batch with
+     * `Kokkos::parallel_reduce`.
+     * \tparam PointIntegrator: function object integrating the behaviour at
+     * one point
+     */
+    template <typename PointIntegrator>
+    struct Reduction {
+      //! \brief type of the reduced value
+      using value_type = BatchStatistics;
+      //! \brief integrate the behaviour at the `i`-th point
+      KOKKOS_FUNCTION void operator()(const size_type i, value_type& s) const {
+        s = combine(s, this->integrator(i));
+      }
+      //! \brief combine two partial results
+      KOKKOS_FUNCTION void join(value_type& s, const value_type& s2) const {
+        s = combine(s, s2);
+      }
+      //! \brief initialize a partial result
+      KOKKOS_FUNCTION void init(value_type& s) const {
+        s = value_type{.rdt = this->initial_rdt};
+      }
+      //! \brief function object integrating the behaviour at one point
+      PointIntegrator integrator;
+      //! \brief initial value of the time step scaling factor
+      real initial_rdt;
+    };
+
+#if defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP)
+
+    /*!
+     * \brief kernel which is never launched: its attributes give the stack
+     * size required to integrate the behaviour at one point. Kokkos does not
+     * increase the stack size of the threads, which is too small by default
+     * for some behaviours.
+     */
+    template <typename PointIntegrator>
+    __global__ void stackSizeProbe(const PointIntegrator f) {
+      f(0);
+    }  // end of stackSizeProbe
+
+#endif /* defined(KOKKOS_ENABLE_CUDA) || defined(KOKKOS_ENABLE_HIP) */
+
+    /*!
+     * \brief prepare the execution of the given point integrator in the given
+     * execution space.
+     * \return true on success
+     * \param[out] s: output status
+     */
+    template <typename ExecutionSpace, typename PointIntegrator>
+    bool prepare(OutputStatus& s) {
+#if defined(KOKKOS_ENABLE_CUDA)
+      constexpr auto device = std::is_same_v<ExecutionSpace, Kokkos::Cuda>;
+#elif defined(KOKKOS_ENABLE_HIP)
+      constexpr auto device = std::is_same_v<ExecutionSpace, Kokkos::HIP>;
+#else
+      constexpr auto device = false;
+#endif
+      if constexpr (device) {
+        const auto e =
+            gpu::internals::ensureStackSize(stackSizeProbe<PointIntegrator>);
+        if (e != decltype(e){}) {
+          report(s, -3, "unable to set the stack size of the threads");
+          return false;
+        }
+      }
+      static_cast<void>(s);
+      return true;
+    }  // end of prepare
+
+  }  // end of namespace internals
+
+  /*!
+   * \brief integrate the behaviour at the points of a batch.
+   *
+   * Kokkos must have been initialized by the calling code. The `queue`
+   * member of the batch data may point to an instance of the execution
+   * space. This function waits for the completion of the computations.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam Sizes: sizes of the data of an integration point
+   * \tparam ExecutionSpace: execution space
+   * \tparam ParametersType: type of the structure holding the parameters
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   * \return the status
+   */
+  template <typename Behaviour,
+            typename Sizes,
+            typename ExecutionSpace,
+            typename ParametersType>
+  int integrate(OutputStatus& s,
+                const BatchData& d,
+                const ParametersType& parameters,
+                const tfel::material::OutOfBoundsPolicy p) {
+    if (!check<Sizes>(s, d)) {
+      return s.status;
+    }
+    if (!Kokkos::is_initialized()) {
+      return report(s, -3, "Kokkos is not initialized");
+    }
+    if (d.number_of_points == 0) {
+      return s.status;
+    }
+    const auto space = d.queue == nullptr
+                           ? ExecutionSpace{}
+                           : *static_cast<const ExecutionSpace*>(d.queue);
+    const auto range =
+        Kokkos::RangePolicy<ExecutionSpace, Kokkos::IndexType<size_type>>(
+            space, 0, d.number_of_points);
+    return dispatch<Behaviour, Sizes>(
+        d, parameters, p, [&s, &d, &range](const auto& integrator) {
+          using PointIntegrator = std::decay_t<decltype(integrator)>;
+          if (!internals::prepare<ExecutionSpace, PointIntegrator>(s)) {
+            return s.status;
+          }
+          // the reduction in a scalar is synchronous
+          auto r = BatchStatistics{};
+          Kokkos::parallel_reduce(
+              "mfront::gpb::kokkos::integrate", range,
+              internals::Reduction<PointIntegrator>{integrator, d.rdt}, r);
+          return report(s, r);
+        });
+  }  // end of integrate
+
+}  // end of namespace mfront::gpb::kokkos
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_KOKKOS_HXX */
