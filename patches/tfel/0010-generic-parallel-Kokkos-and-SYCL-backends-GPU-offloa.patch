+    endif()
     list(APPEND tfel-check-components
          "mfront::behaviour::generic-parallel_interface::supported_configuration::${conf}")
   endif()
@@ -669,3 +675,58 @@ if((_tfel-enable-generic-parallel-stlpar-parunseq-acpp-generic-configuration) OR
    (_tfel-enable-generic-parallel-sycl-gpu-acpp-configuration))
   define_tfel_cxx_compiler("acpp")
 endif()
+
+if(_tfel-enable-generic-parallel-kokkos-configuration)
+  # the generated libraries are compiled with the compiler and the flags
+  # used to build Kokkos, extracted from the imported targets. Kokkos
+  # must be built as a shared library, without relocatable device code.
+  # The `separable_compilation` component prevents Kokkos from redirecting
+  # the compilation of TFEL to its compiler.
+  find_package(Kokkos REQUIRED COMPONENTS separable_compilation)
+  get_target_property(_kokkos_compile_options Kokkos::kokkoscore
+                      INTERFACE_COMPILE_OPTIONS)
+  get_target_property(_kokkos_link_options Kokkos::kokkoscore
+                      INTERFACE_LINK_OPTIONS)
+  get_target_property(_kokkos_include_directories Kokkos::kokkoscore
+                      INTERFACE_INCLUDE_DIRECTORIES)
+  get_target_property(_kokkos_library Kokkos::kokkoscore LOCATION)
+  # the options are given by generator expressions selecting the C++
+  # language, which may contain several options separated by semicolons
+  string(REGEX REPLACE "\\$<\\$<COMPILE_LANGUAGE:CXX>:([^>]*)>" "\\1"
+         _kokkos_flags "${_kokkos_compile_options}")
+  string(REGEX REPLACE "\\$<\\$<LINK_LANGUAGE:CXX>:([^>]*)>" "\\1"
+         _kokkos_linker_flags "${_kokkos_link_options}")
+  list(REMOVE_ITEM _kokkos_flags "")
+  list(REMOVE_ITEM _kokkos_linker_flags "")
+  foreach(_directory IN LISTS _kokkos_include_directories)
+    list(APPEND _kokkos_flags "-I${_directory}")
+  endforeach()
+  if(Kokkos_ENABLE_OPENMP)
+    find_package(OpenMP REQUIRED COMPONENTS CXX)
+    list(APPEND _kokkos_flags ${OpenMP_CXX_FLAGS})
+    list(APPEND _kokkos_linker_flags ${OpenMP_CXX_FLAGS})
+  endif()
+  if(Kokkos_CXX_COMPILER MATCHES "nvcc_wrapper$")
+    # same host compiler as TFEL
+    list(APPEND _kokkos_flags "-ccbin" "${CMAKE_CXX_COMPILER}")
+    list(APPEND _kokkos_linker_flags "-ccbin" "${CMAKE_CXX_COMPILER}")
+  endif()
+  if(Kokkos_ENABLE_CUDA)
+    # Kokkos uses the shared CUDA runtime: the generated libraries and the
+    # calling code must use the same one
+    list(APPEND _kokkos_linker_flags "-cudart" "shared"
+         "-L${CUDAToolkit_LIBRARY_DIR}" "-Wl,-rpath,${CUDAToolkit_LIBRARY_DIR}")
+  endif()
+  get_filename_component(_kokkos_library_directory "${_kokkos_library}" DIRECTORY)
+  list(APPEND _kokkos_linker_flags
+       "-L${_kokkos_library_directory}" "-Wl,-rpath,${_kokkos_library_directory}"
+       "-lkokkoscore")
+  list(JOIN _kokkos_flags " " TFEL_KOKKOS_CXX_FLAGS)
+  list(JOIN _kokkos_linker_flags " " TFEL_KOKKOS_LINKER_FLAGS)
+  add_tfel_substitution(TFEL_KOKKOS_CXX_COMPILER "${Kokkos_CXX_COMPILER}")
+  add_tfel_substitution(TFEL_KOKKOS_CXX_FLAGS "${TFEL_KOKKOS_CXX_FLAGS}")
+  add_tfel_substitution(TFEL_KOKKOS_LINKER_FLAGS "${TFEL_KOKKOS_LINKER_FLAGS}")
+  message(STATUS "Kokkos compiler: ${Kokkos_CXX_COMPILER}")
+  message(STATUS "Kokkos flags: ${TFEL_KOKKOS_CXX_FLAGS}")
+  message(STATUS "Kokkos linker flags: ${TFEL_KOKKOS_LINKER_FLAGS}")
+endif()
