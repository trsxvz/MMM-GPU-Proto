diff --git a/test-suite/behaviours/generic-parallel/kokkos-host/test.check b/test-suite/behaviours/generic-parallel/kokkos-host/test.check
new file mode 100644
index 000000000..a7333f137
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/kokkos-host/test.check
@@ -0,0 +1,24 @@
+@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::kokkos"};
+
+@Environment {"LD_LIBRARY_PATH": "src"};
+// the generic interface gives the reference results. Using both interfaces
+// in the same call also checks that they can be used together.
+@Command "@mfront@ --obuild --search-path=.. --interface=generic --interface=generic-parallel --configuration-file=config-kokkos-host.json ../IsotropicLinearHardeningPlasticity.mfront ../ImplicitNorton.mfront ../HosfordPerfectPlasticity.mfront ../StrainHardeningCreep3.mfront";
+@Command "@TFEL_KOKKOS_CXX_COMPILER@ -O2 -std=c++@TFEL_CXX_STANDARD@ @TFEL_KOKKOS_CXX_FLAGS@ -DMFRONT_GPB_COMPARE_USE_KOKKOS -I@TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl @TFEL_KOKKOS_LINKER_FLAGS@";
+// arguments: libraries, function, sizes of the gradients, thermodynamic
+// forces, material properties, internal state variables, external state
+// variables and tangent operator, strain amplitude, material properties,
+// temperature
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-kokkos.so IsotropicLinearHardeningPlasticity_Tridimensional 6 6 0 7 1 36 3e-3 - 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-kokkos.so IsotropicLinearHardeningPlasticity_PlaneStrain 4 4 0 5 1 16 3e-3 - 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-kokkos.so ImplicitNorton_Tridimensional 6 6 2 7 1 36 1e-3 150e9,0.3 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-kokkos.so ImplicitNorton_PlaneStress 4 4 2 6 1 16 1e-3 150e9,0.3 293.15";
+// Hosford criterion: eigen values, local memory larger than the default
+// stack size of CUDA threads
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-kokkos.so HosfordPerfectPlasticity_Tridimensional 6 6 0 7 1 36 5e-4 - 293.15";
+// elastic properties given by a material law evaluated on the device, and
+// quantities
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-kokkos.so StrainHardeningCreep3_Tridimensional 6 6 0 11 1 36 1e-3 - 600";
+
+@CleanFiles {"compare"};
+@CleanDirectories {"include", "src"};
