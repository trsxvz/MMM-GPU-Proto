+@DSL   MaterialLaw;
+@Material Inconel600;
+@Law      YoungModulus ;
+@Author   S. BEJAOUI;
+@Date     2010-07-23;
+
+@Description
+{
+CEA/DEN/CAD/DEC/SESC/LC2I DO 84 17/03/04
+}
+
+@Input TK;
+
+TK.setGlossaryName("Temperature");
+
+@Output E;
+E.setGlossaryName("YoungModulus");
+
+@PhysicalBounds TK in [0:*[;
+
+@Bounds TK in [0:*[;
