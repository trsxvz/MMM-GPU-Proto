diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
new file mode 100644
index 000000000..cecccdead
--- /dev/null
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -0,0 +1,238 @@
+---
+title: The `generic-parallel` interface for behaviours
+lang: en-EN
+link-citations: true
+colorlinks: true
+geometry:
+  - margin=2cm
+papersize: a4
+figPrefixTemplate: "$$i$$"
+tblPrefixTemplate: "$$i$$"
+secPrefixTemplate: "$$i$$"
+eqnPrefixTemplate: "($$i$$)"
+---
+
+The `generic-parallel` interface integrates a behaviour over a batch of
+integration points, on GPUs (`CUDA`, `HIP`) or on CPUs (parallel
+algorithms of the C++ standard library). It follows the design of the
+[`generic-parallel` interface for material
+properties](generic-parallel-material-property-interface.html): backends
+selected by an option, configuration files, libraries suffixed by the name
+of the backend.
+
+Integrating a batch is equivalent to calling the function generated by the
+[`generic` interface](generic-behaviours-interface.html) at each
+integration point, with the same time increment and the same computation
+options. The two interfaces can be used together:
+
+~~~~{.bash}
+$ mfront --obuild --interface=generic --interface=generic-parallel \
+         --configuration-file=config-cuda-nvcc.json Plasticity.mfront
+The following libraries have been built :
+- libBehaviour.so :  Plasticity_Tridimensional ...
+- libGenericParallelBehaviour-cuda.so :  Plasticity_Tridimensional ...
+~~~~
+
+# Generated functions
+
+For each modelling hypothesis, the interface generates a function with the
+same name as the one generated by the `generic` interface:
+
+~~~~{.cxx}
+int Plasticity_Tridimensional(mfront_gpb_OutputStatus* const,
+                              const mfront_gpb_BatchData* const);
+~~~~
+
+The library also exports the same symbols as the `generic` interface
+(names and types of the variables, parameters, etc.) and the functions
+changing the parameters and the out of bounds policy. The `mfront_interface`
+symbol is equal to `GenericParallel`.
+
+The data structures are declared in
+`MFront/GenericParallelBehaviour/BatchData.h`.
+
+## Fields
+
+The values of a group of variables (gradients, internal state variables,
+etc.) at all the integration points are described by a field:
+
+~~~~{.cxx}
+typedef struct {
+  const mfront_gb_real* values;
+  mfront_gb_size_type point_stride;
+  mfront_gb_size_type component_stride;
+} mfront_gpb_ConstField;
+~~~~
+
+The `j`-th component at the `i`-th point is stored at
+`values[i * point_stride + j * component_stride]`. Usual layouts are:
+
+- point by point: `point_stride` is the size of the group and
+  `component_stride` is equal to one. This is the layout of `MGIS`.
+- component by component: `point_stride` is equal to one and
+  `component_stride` is the number of points. On GPUs, this layout gives
+  coalesced memory accesses.
+- uniform values (inputs only): `point_stride` is null.
+
+`mfront_gpb_Field` is the mutable version of `mfront_gpb_ConstField`. The
+group of variables of a point are the ones of the `generic` interface: for
+instance, the temperature is the first external state variable.
+
+## Batch data
+
+~~~~{.cxx}
+typedef struct {
+  mfront_gb_size_type number_of_points;
+  mfront_gb_real dt;
+  mfront_gb_real options[3];   // the three first values of K
+  mfront_gb_real rdt;          // initial time step scaling factor
+  mfront_gpb_Field tangent_operators;
+  mfront_gpb_Field rdts;       // optional
+  mfront_gpb_Field speed_of_sound;
+  int* statuses;               // optional
+  mfront_gpb_InitialState s0;
+  mfront_gpb_State s1;
+  void* queue;                 // cudaStream_t or hipStream_t, may be null
+} mfront_gpb_BatchData;
+~~~~
+
+`options` has the meaning of the three first values of the array `K` of the
+`generic` interface (type of computation, stress measure and tangent
+operator for finite strain behaviours). The tangent or prediction operators
+are written in `tangent_operators`, which is not used if no tangent
+operator is requested.
+
+All the pointers must be accessible by the device on which the computations
+are performed.
+
+## Output status
+
+~~~~{.cxx}
+typedef struct {
+  int status;
+  mfront_gb_size_type number_of_failures;
+  mfront_gb_size_type number_of_unreliable_results;
+  mfront_gb_real rdt;  // minimum over the batch
+  char msg[512];
+} mfront_gpb_OutputStatus;
+~~~~
+
+The status, also returned by the function, is:
+
+- `1` if the integration succeeded at all points;
+- `0` if the integration succeeded at all points but the time step scaling
+  factor is lower than `0.99` at some points;
+- `-1` if the integration failed at some points (see `statuses` to locate
+  them);
+- `-2` if the arguments are invalid (nothing is computed);
+- `-3` in case of a runtime error of the backend (allocation, launch of a
+  kernel, etc.).
+
+## Parameters
+
+The parameters initializers of the behaviours can't be accessed from device
+code. The interface adds a constructor to the behaviour class, which reads
+the parameters in a structure filled on the host from the parameters
+initializers and passed by value to the kernel. The functions changing the
+values of the parameters can thus be used as with the `generic` interface.
+
+# Backends
+
+The backend is selected in a configuration file:
+
+~~~~{.json}
+interfaces_options: {
+  generic-parallel: {
+    backend: {cuda : {number_of_threads_per_block: 128}}
+  }
+}
+~~~~
+
+The same section is used by the `generic-parallel` interface for material
+properties, so that the same configuration files can be used.
+
+## `CUDA` and `HIP` backends
+
+One thread integrates the behaviour at one point. The kernel is launched on
+the queue given by the batch data and the generated function waits for its
+completion. The summary of the batch is reduced by warp: atomic operations
+are only used by the warps where a point failed or decreased the time step
+scaling factor.
+
+Two kernels are generated for each hypothesis: if all fields are stored
+point by point, the behaviour directly reads and writes them. Otherwise,
+the values of a point are copied in local arrays and the results are copied
+back after the integration.
+
+The default stack size of `CUDA` threads (1024 bytes) is too small for some
+behaviours. The generated function increases it, if needed, before launching
+the kernel.
+
+Options:
+
+- `number_of_threads_per_block` (128 by default), rounded up to a multiple
+  of the warp size.
+
+## Parallel STL backend (`stlpar`)
+
+The behaviour is integrated by `std::transform_reduce` with the given
+execution policy. The indices of the points are given by a counting
+iterator: with `libstdc++`, iterators of `std::views::iota` are not random
+access iterators in the sense of the C++17 iterator categories and the
+parallel algorithms run sequentially.
+
+Options:
+
+- `execution_policy`: `sequenced_policy` (or `seq`), `unsequenced_policy`
+  (or `unseq`), `parallel_policy` (or `par`), `parallel_unsequenced_policy`
+  (or `par_unseq`, default).
+
+# Writing behaviours compatible with GPUs
+
+The code generated by `MFront` is compatible with GPUs. Device specific
+code is selected by the `TFEL_DEVICE_CODE` macro, which is only defined when
+device code is compiled: the behaviour of the other interfaces on CPUs is
+not changed.
+
+The following rules apply to the code blocks written by the user:
+
+- exceptions are not supported in device code: return `false` (in
+  `@InitLocalVariables`, `@Integrator` of the default DSL, etc.) or
+  `FAILURE` instead of throwing an exception. The `raise` and `raise_if`
+  functions can't be used either.
+- the standard streams (`std::cout`) can't be used.
+- function scope static variables must be constant expressions.
+- functions called by the code blocks must be callable in device code
+  (`TFEL_HOST_DEVICE`).
+
+The following points are specific to device code:
+
+- the bounds checks return a failure if a bound is violated and if the out
+  of bounds policy is `Strict`. Warnings are not displayed.
+- material properties called by the behaviour (`@MaterialLaw`,
+  `@ElasticMaterialProperties`, `@ComputeThermalExpansion`, etc.) are
+  evaluated by an implementation generated in the `mfront::device`
+  namespace, which returns `NaN` if a physical bound is not satisfied.
+  Their parameters have their default values.
+- dynamically allocated arrays are not used when the `generic-parallel`
+  interface is selected.
+- parameters treated as static variables are declared as constant members
+  in device code, since static data members can't be used by reference.
+- the profiling of the behaviour is disabled.
+
+# Current limitations
+
+- finite strain behaviours are not supported.
+- the rotation functions of orthotropic behaviours, the initialize functions
+  and the post-processings of the `generic` interface are not generated.
+- the slip systems of single crystals are not available in device code.
+- the `HIP` backend has not been tested on AMD GPUs.
+
+# Tests
+
+The tests are installed in
+`share/tfel/test-suite/behaviours/generic-parallel`. For each configuration,
+the behaviours are generated with the `generic` and `generic-parallel`
+interfaces and the results of the batch integration are compared to the
+results of the `generic` interface on two time steps of a random loading,
+for the two layouts of the fields and three types of computation.
diff --git a/test-suite/behaviours/generic-parallel/HosfordPerfectPlasticity.mfront b/test-suite/behaviours/generic-parallel/HosfordPerfectPlasticity.mfront
new file mode 100644
index 000000000..120237c2c
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/HosfordPerfectPlasticity.mfront
@@ -0,0 +1,48 @@
+@DSL       Implicit;
+@Behaviour HosfordPerfectPlasticity;
+@Author    Thomas Helfer;
+@Description{
+  A simple implementation of a perfect
+  plasticity behaviour using the
+  Hosford stress.
+};
+
+@ModellingHypotheses {".+"};
+
+@Brick StandardElasticity;
+@Epsilon 1.e-16;
+@Theta 1;
+
+@StateVariable strain p;
+p.setGlossaryName("EquivalentPlasticStrain");
+
+@ElasticMaterialProperties {150e9,0.3};
+@Parameter a    = 8;
+@Parameter sigy = 150e6;
+
+@LocalVariable bool b;
+
+@InitializeLocalVariables{
+  const stress seps = 1.e-10*young;
+  const auto sigel = computeElasticPrediction();
+  const auto seqel = computeHosfordStress(sigel,a,seps);
+  b = seqel>sigy;
+}
+
+@Integrator{
+  const stress seps = 1.e-10*young;
+  if(!b){
+    // elastic loading, nothing to be done
+    return true;
+  }
+  real seq;
+  Stensor n;
+  Stensor4 dn;
+  std::tie(seq,n,dn) = computeHosfordStressSecondDerivative(sig,a,seps);
+  feel        += dp*n;
+  dfeel_ddeel += 2*mu*theta*dp*dn;
+  dfeel_ddp    = n;
+  fp           = (seq-sigy)/young;
+  dfp_ddeel    = 2*mu*theta*n/young;
+  dfp_ddp      = 0;
+}
diff --git a/test-suite/behaviours/generic-parallel/ImplicitNorton.mfront b/test-suite/behaviours/generic-parallel/ImplicitNorton.mfront
new file mode 100644
index 000000000..599fed0a8
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/ImplicitNorton.mfront
@@ -0,0 +1,125 @@
+@DSL Implicit;
+@Author Thomas Helfer;
+@Date   21/09/2008;
+@Behaviour ImplicitNorton;
+@Description{
+  This file implements the Norton law, described as:
+  "$$"
+  "\left\{"
+  "  \begin{aligned}"
+  "    \tepsilonto   &= \tepsilonel+\tepsilonvis \\"
+  "    \tsigma       &= \tenseurq{D}\,:\,\tepsilonel\\"
+  "    \tdepsilonvis &= \dot{p}\,\tenseur{n} \\"
+  "    \dot{p}       &= A\,\sigmaeq^{m}"
+  "  \end{aligned}"
+  "\right."
+  "$$"
+}
+
+@ModellingHypotheses {".+"};
+@Epsilon 1.e-16;
+
+@AsterCompareToNumericalTangentOperator[aster] true;
+@AsterStrainPerturbationValue[aster] 1.e-6;
+@AsterTangentOperatorComparisonCriterium[aster] 1.e7;
+
+@MaterialProperty stress young;
+young.setGlossaryName("YoungModulus");
+@MaterialProperty real nu;
+nu.setGlossaryName("PoissonRatio");
+
+@LocalVariable real     lambda;
+@LocalVariable real     mu;
+
+// store for the Von Mises stress 
+// for the tangent operator
+@LocalVariable real seq;
+// store the derivative of the creep function
+// for the tangent operator
+@LocalVariable real df_dseq;
+// store the normal tensor
+// for the tangent operator
+@LocalVariable Stensor n;
+
+@StateVariable real    p;
+@PhysicalBounds p in [0:*[;
+
+@StateVariable<PlaneStress> real etozz;
+PlaneStress::etozz.setGlossaryName("AxialStrain");
+
+@StateVariable<AxisymmetricalGeneralisedPlaneStress> real etozz;
+AxisymmetricalGeneralisedPlaneStress::etozz.setGlossaryName("AxialStrain");
+@ExternalStateVariable<AxisymmetricalGeneralisedPlaneStress> stress sigzz;
+AxisymmetricalGeneralisedPlaneStress::sigzz.setGlossaryName("AxialStress");
+
+/* Initialize Lame coefficients */
+@InitLocalVariables{
+  lambda = computeLambda(young,nu);
+  mu = computeMu(young,nu);
+} // end of @InitLocalVariables
+
+@ComputeStress{
+  sig = lambda*trace(eel)*Stensor::Id()+2*mu*eel;
+} // end of @ComputeStresss
+
+@Integrator{
+  const real A = 8.e-67;
+  const real E = 8.2;
+  seq = sigmaeq(sig);
+  const auto tmp = A*pow(seq,E-1.);
+  df_dseq = E*tmp;
+  const auto iseq = 1/(max(seq,real(1.e-12)*young));
+  n = 3*deviator(sig)*(iseq/2);
+  feel += dp*n-deto;
+  fp   -= tmp*seq*dt;
+  // jacobian
+  dfeel_ddeel += 2.*mu*theta*dp*iseq*(Stensor4::M()-(n^n));
+  dfeel_ddp    = n;
+  dfp_ddeel    = -2*mu*theta*df_dseq*dt*n;
+} // end of @Integrator
+
+@Integrator<PlaneStress,Append,AtEnd>{
+  // the plane stress equation is satisfied at the end of the time
+  // step
+  const stress szz = (lambda+2*mu)*(eel(2)+deel(2))+lambda*(eel(0)+deel(0)+eel(1)+deel(1));
+  fetozz   = szz/young;
+  // modification of the partition of strain
+  feel(2) -= detozz;
+  // jacobian
+  dfeel_ddetozz(2)=-1;
+  dfetozz_ddetozz  = real(0);
+  dfetozz_ddeel(2) = (lambda+2*mu)/young;
+  dfetozz_ddeel(0) = lambda/young;
+  dfetozz_ddeel(1) = lambda/young;
+}
+
+@Integrator<AxisymmetricalGeneralisedPlaneStress,Append,AtEnd>{
+  // the plane stress equation is satisfied at the end of the time
+  // step
+  const stress szz = (lambda+2*mu)*(eel(1)+deel(1))+lambda*(eel(0)+deel(0)+eel(2)+deel(2));
+  fetozz   = (szz-sigzz-dsigzz)/young;
+  // modification of the partition of strain
+  feel(1) -= detozz;
+  // jacobian
+  dfeel_ddetozz(1)=-1;
+  dfetozz_ddetozz  = real(0);
+  dfetozz_ddeel(1) = (lambda+2*mu)/young;
+  dfetozz_ddeel(0) = lambda/young;
+  dfetozz_ddeel(2) = lambda/young;
+}
+
+@IsTangentOperatorSymmetric true;
+@TangentOperator{
+  if((smt==ELASTIC)||(smt==SECANTOPERATOR)||
+     (smt==TANGENTOPERATOR)){
+    computeAlteredElasticStiffness<hypothesis,Type>::exe(Dt,lambda,mu);
+  } else if (smt==CONSISTENTTANGENTOPERATOR){
+    StiffnessTensor Hooke;
+    Stensor4 Je;
+    computeElasticStiffness<N,Type>::exe(Hooke,lambda,mu);
+    getPartialJacobianInvert(Je);
+    Dt = Hooke*Je;
+  } else {
+    return false;
+  }
+}
\ No newline at end of file
