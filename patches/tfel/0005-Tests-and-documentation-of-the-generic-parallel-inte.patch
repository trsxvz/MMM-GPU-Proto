+@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::cuda-nvcc"};
+
+@Environment {"LD_LIBRARY_PATH": "src"};
+// the generic interface gives the reference results. Using both interfaces
+// in the same call also checks that they can be used together.
+@Command "@mfront@ --obuild --search-path=.. --interface=generic --interface=generic-parallel --configuration-file=config-cuda-nvcc.json ../IsotropicLinearHardeningPlasticity.mfront ../ImplicitNorton.mfront ../HosfordPerfectPlasticity.mfront ../StrainHardeningCreep3.mfront";
+@Command "@TFEL_NVCC_COMPILER@ -O2 --std=c++@TFEL_CXX_STANDARD@ -arch=native -x cu -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl";
+// arguments: libraries, function, sizes of the gradients, thermodynamic
+// forces, material properties, internal state variables, external state
+// variables and tangent operator, strain amplitude, material properties,
+// temperature
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-cuda.so IsotropicLinearHardeningPlasticity_Tridimensional 6 6 0 7 1 36 3e-3 - 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-cuda.so IsotropicLinearHardeningPlasticity_PlaneStrain 4 4 0 5 1 16 3e-3 - 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-cuda.so ImplicitNorton_Tridimensional 6 6 2 7 1 36 1e-3 150e9,0.3 293.15";
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-cuda.so ImplicitNorton_PlaneStress 4 4 2 6 1 16 1e-3 150e9,0.3 293.15";
+// Hosford criterion: eigen values, local memory larger than the default
+// stack size of CUDA threads
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-cuda.so HosfordPerfectPlasticity_Tridimensional 6 6 0 7 1 36 5e-4 - 293.15";
+// elastic properties given by a material law evaluated on the device, and
+// quantities
+@Command "./compare src/libBehaviour.so src/libGenericParallelBehaviour-cuda.so StrainHardeningCreep3_Tridimensional 6 6 0 11 1 36 1e-3 - 600";
+
+@CleanFiles {"compare"};
+@CleanDirectories {"include", "src"};
