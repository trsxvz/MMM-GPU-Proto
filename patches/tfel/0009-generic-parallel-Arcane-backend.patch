+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_ARCANEBACKEND_HXX
+#define LIB_MFRONT_GENERICPARALLEL_ARCANEBACKEND_HXX
+
+#include "TFEL/Utilities/Data.hxx"
+#include "MFront/MFrontConfig.hxx"
+#include "MFront/GenericParallel/AbstractBackend.hxx"
+
+namespace mfront::generic_parallel {
+
+  /*!
+   * \brief backend based on the accelerator API of Arccore, the core
+   * component of the Arcane framework.
+   *
+   * The generated source (`.cu` file) must be compiled with the compiler of
+   * the accelerator mode of Arccore (for instance `clang` with `-x cuda` if
+   * Arccore is built with CUDA, see the `cuda` compilation options of the
+   * `arcane` configuration) and the library linked with the libraries of
+   * Arccore.
+   *
+   * The execution policy of the backend (`ArcaneBackendExecutionPolicy`)
+   * holds a queue of Arccore, which is required. The execution policy of
+   * the queue (`CUDA`, `HIP`, `Thread` or `Sequential`) is selected at
+   * runtime: a library compiled for CUDA computes on the GPU or on the
+   * cores of the host, depending on the queue.
+   *
+   * This backend has no option.
+   */
+  struct MFRONT_VISIBILITY_EXPORT ArcaneBackend final : AbstractBackend {
+    /*!
+     * \brief constructor
+     * \param[in] opts: options
+     */
+    ArcaneBackend(const tfel::utilities::DataMap&);
+    //
+    [[nodiscard]] std::string getName() const override;
+    [[nodiscard]] std::string getSourceFileExtension() const override;
+    void writeSpecificIncludes(std::ostream&, const Runtime) const override;
+    [[nodiscard]] std::string getApply() const override;
+    [[nodiscard]] std::string getMemorySpace() const override;
+    [[nodiscard]] std::string getExecutionPolicyType() const override;
+    [[nodiscard]] std::string getSharedDataCopy(
+        std::string_view, std::string_view) const override;
+    //! \brief destructor
+    ~ArcaneBackend() noexcept override;
+  };  // end of ArcaneBackend
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_ARCANEBACKEND_HXX */
diff --git a/mfront/include/MFront/GenericParallel/ArcaneBackendExecutionPolicy.hxx b/mfront/include/MFront/GenericParallel/ArcaneBackendExecutionPolicy.hxx
new file mode 100644
index 000000000..67ed72a06
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/ArcaneBackendExecutionPolicy.hxx
@@ -0,0 +1,77 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/ArcaneBackendExecutionPolicy.hxx
+ * \brief  This file declares the execution policy of the `arcane` backend
+ * of the `generic-parallel` interfaces, which holds a queue of the
+ * accelerator API of Arccore.
+ * \date   23/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_ARCANEBACKENDEXECUTIONPOLICY_HXX
+#define LIB_MFRONT_GENERICPARALLEL_ARCANEBACKENDEXECUTIONPOLICY_HXX
+
+#include <arccore/base/ArccoreGlobal.h>
+#include <arccore/common/accelerator/RunQueue.h>
+#include "MFront/GenericParallel/BackendExecutionPolicyBase.hxx"
+
+namespace mfront::generic_parallel {
+
+  /*!
+   * \brief execution policy of the `arcane` backend. The `arcane` backend
+   * has no default policy: the queue gives the execution policy of Arccore
+   * (`CUDA`, `HIP`, `SYCL`, `Thread` or `Sequential`), which is only known
+   * at runtime, so the queue is required.
+   *
+   * The identifier only depends on the accelerator mode of Arccore, so that
+   * a calling code compiled by a C++ compiler and a library compiled by a
+   * CUDA, HIP or SYCL compiler agree on it. A library compiled in the CUDA
+   * (HIP, SYCL) mode accepts the CUDA (HIP, SYCL), `Thread` and `Sequential`
+   * queues.
+   */
+  struct ArcaneBackendExecutionPolicy final : BackendExecutionPolicyBase {
+    //! \return the identifier of the policy
+    static constexpr const char* identifier() noexcept {
+#if defined(ARCCORE_HAS_CUDA)
+      return "arcane:cuda";
+#elif defined(ARCCORE_HAS_HIP)
+      return "arcane:hip";
+#elif defined(ARCCORE_HAS_SYCL)
+      return "arcane:sycl";
+#else
+      return "arcane:host";
+#endif
+    }
+    /*!
+     * \brief constructor
+     * \param[in] q: queue on which the commands are launched. The queue has
+     * a reference semantics: the policy refers to the queue of the calling
+     * code.
+     * \param[in] opts: common options
+     */
+    ArcaneBackendExecutionPolicy(const ::Arcane::Accelerator::RunQueue& q,
+                                 const BackendExecutionCommonPolicy& opts = {})
+        : BackendExecutionPolicyBase(opts), queue(q) {}
+    const char* getIdentifier() const noexcept override { return identifier(); }
+    //! \brief queue on which the commands are launched
+    ::Arcane::Accelerator::RunQueue queue;
+  };  // end of struct ArcaneBackendExecutionPolicy
+
+  /*!
+   * \return an execution policy of the `arcane` backend
+   * \param[in] q: queue on which the commands are launched (required)
+   * \param[in] opts: common options
+   */
+  inline ArcaneBackendExecutionPolicy makeArcaneBackendExecutionPolicy(
+      const ::Arcane::Accelerator::RunQueue& q,
+      const BackendExecutionCommonPolicy& opts = {}) {
+    return ArcaneBackendExecutionPolicy{q, opts};
+  }  // end of makeArcaneBackendExecutionPolicy
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_ARCANEBACKENDEXECUTIONPOLICY_HXX */
diff --git a/mfront/include/MFront/GenericParallel/ArcaneUtilities.hxx b/mfront/include/MFront/GenericParallel/ArcaneUtilities.hxx
new file mode 100644
index 000000000..6eddfc519
--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/ArcaneUtilities.hxx
@@ -0,0 +1,328 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/ArcaneUtilities.hxx
+ * \brief  This file declares the functions shared by the `arcane` backends
+ * of the `generic-parallel` interfaces: check of the queue, launch of the
+ * loops, memory of the statistics, current device and stack size of the
+ * threads of the device.
+ * \date   23/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_ARCANEUTILITIES_HXX
+#define LIB_MFRONT_GENERICPARALLEL_ARCANEUTILITIES_HXX
+
+#include <string>
+#include <algorithm>
+#include <type_traits>
+#include <arccore/base/ArccoreGlobal.h>
+#include <arccore/common/MemoryUtils.h>
+#include <arccore/common/IMemoryAllocator.h>
+#include <arccore/common/AllocatedMemoryInfo.h>
+#include <arccore/common/MemoryAllocationArgs.h>
+#include <arccore/common/accelerator/RunQueue.h>
+#include <arccore/common/accelerator/DeviceId.h>
+#include <arccore/accelerator/RunCommandLoop.h>
+#if defined(ARCCORE_COMPILING_CUDA_OR_HIP)
+#include "MFront/GenericParallel/GPUStackSize.hxx"
+#endif
+#if defined(ARCCORE_COMPILING_SYCL)
+#include <sycl/sycl.hpp>
+#include <arccore/base/PlatformUtils.h>
+#endif
+
+namespace mfront::generic_parallel::arcane {
+
+  /*!
+   * \return a message explaining why the commands can't be launched on a
+   * queue by the code of the generated library, or a null pointer. The
+   * `Thread` and `Sequential` queues are always supported, the CUDA, HIP
+   * and SYCL queues only if the library is compiled in the same mode.
+   * \param[in] q: queue
+   */
+  inline const char* checkQueue(const ::Arcane::Accelerator::RunQueue& q) {
+    using ::Arcane::Accelerator::eExecutionPolicy;
+    if (q.isNull()) {
+      return "the queue of the execution policy is null";
+    }
+    switch (q.executionPolicy()) {
+      case eExecutionPolicy::Sequential:
+      case eExecutionPolicy::Thread:
+        return nullptr;
+#if defined(ARCCORE_COMPILING_CUDA)
+      case eExecutionPolicy::CUDA:
+        return nullptr;
+#endif
+#if defined(ARCCORE_COMPILING_HIP)
+      case eExecutionPolicy::HIP:
+        return nullptr;
+#endif
+#if defined(ARCCORE_COMPILING_SYCL)
+      case eExecutionPolicy::SYCL:
+        return nullptr;
+#endif
+      default:
+        break;
+    }
+    return "the execution policy of the queue is not supported by the "
+           "library (the CUDA, HIP and SYCL queues require a library compiled "
+           "in the same accelerator mode)";
+  }  // end of checkQueue
+
+#if defined(ARCCORE_COMPILING_SYCL)
+  /*!
+   * \brief masks the floating point exceptions during the launch of
+   * commands on a SYCL queue, and restores them. The SYCL runtime may
+   * compile a kernel at its launch, with the compiler of the driver (the
+   * PTX compiler of NVIDIA with AdaptiveCpp), which expects them masked.
+   * Arcane unmasks them at its initialization.
+   */
+  struct SYCLLaunchFloatingPointExceptions {
+    explicit SYCLLaunchFloatingPointExceptions(
+        const ::Arcane::Accelerator::RunQueue& q)
+        : masked(q.executionPolicy() ==
+                     ::Arcane::Accelerator::eExecutionPolicy::SYCL &&
+                 ::Arcane::Platform::isFloatingExceptionEnabled()) {
+      if (this->masked) {
+        ::Arcane::Platform::enableFloatingException(false);
+      }
+    }
+    SYCLLaunchFloatingPointExceptions(
+        const SYCLLaunchFloatingPointExceptions&) = delete;
+    SYCLLaunchFloatingPointExceptions& operator=(
+        const SYCLLaunchFloatingPointExceptions&) = delete;
+    ~SYCLLaunchFloatingPointExceptions() {
+      if (this->masked) {
+        ::Arcane::Platform::enableFloatingException(true);
+      }
+    }
+
+   private:
+    //! \brief if true, the exceptions were unmasked and are masked
+    const bool masked;
+  };
+#endif
+
+  /*!
+   * \brief launch the commands applying a function at the points `[0, n[`
+   * on a queue.
+   *
+   * The loops of Arccore have 32 bits indices, and the kernels of Arccore
+   * compute the index of a thread on 32 bits: the ranges are split in
+   * commands of at most `2^30` points, so that the index of a thread of the
+   * grid of a command never overflows. The commands are launched
+   * asynchronously, whatever the asynchronous state of the queue, which is
+   * restored afterwards: the calling code waits for their completion
+   * (`barrier`) if needed. With the `Thread` and `Sequential` queues, the
+   * commands are completed on return. If the launch of a command fails, the
+   * commands already launched are completed before the exception is
+   * propagated, so that the memory they access may be released. With a
+   * SYCL queue, the floating point exceptions are masked during the launch
+   * (see `SYCLLaunchFloatingPointExceptions`).
+   *
+   * \tparam Index: type of the indices taken by the function
+   * \param[in] q: queue
+   * \param[in] n: number of points
+   * \param[in] f: function, copied by the commands
+   */
+  template <typename Index, typename Function>
+  void launch(::Arcane::Accelerator::RunQueue& q,
+              const Index n,
+              const Function& f) {
+    using ::Arcane::Int32;
+    using ::Arcane::Int64;
+    constexpr auto chunk = Int64{1} << 30;
+    const auto size = static_cast<Int64>(n);
+    ::Arcane::Accelerator::RunQueue::ScopedAsync asynchronous_launch(&q);
+#if defined(ARCCORE_COMPILING_SYCL)
+    const auto floating_point_exceptions = SYCLLaunchFloatingPointExceptions(q);
+#endif
+    try {
+      for (auto offset = Int64{}; offset < size; offset += chunk) {
+        const auto m = static_cast<Int32>(std::min(chunk, size - offset));
+        auto command = ::Arcane::Accelerator::makeCommand(q);
+        command << RUNCOMMAND_LOOP1(iter, m) {
+          auto [i] = iter();
+          f(static_cast<Index>(offset + i));
+        };
+      }
+    } catch (...) {
+      try {
+        q.barrier();
+      } catch (...) {
+      }
+      throw;
+    }
+  }  // end of launch
+
+  /*!
+   * \return the allocator of the unified memory of Arccore, accessible by
+   * the host and by the devices, or a null pointer if it is not available.
+   * If no accelerator runtime is initialized, Arccore returns the allocator
+   * of the host. This memory holds the data shared by all the points, which
+   * are only read by the devices.
+   */
+  inline ::Arcane::IMemoryAllocator* getUnifiedMemoryAllocator() noexcept {
+    try {
+      return ::Arcane::MemoryUtils::getAllocator(
+          ::Arcane::eMemoryResource::UnifiedMemory);
+    } catch (...) {
+    }
+    return nullptr;
+  }  // end of getUnifiedMemoryAllocator
+
+  /*!
+   * \return the allocator of the memory of the accelerators, or a null
+   * pointer if it is not available. The memory is allocated on the current
+   * device of the calling thread.
+   */
+  inline ::Arcane::IMemoryAllocator* getDeviceMemoryAllocator() noexcept {
+    try {
+      return ::Arcane::MemoryUtils::getAllocator(
+          ::Arcane::eMemoryResource::Device);
+    } catch (...) {
+    }
+    return nullptr;
+  }  // end of getDeviceMemoryAllocator
+
+  /*!
+   * \return the allocator of the pinned memory of the host, accessible by
+   * the accelerators, or a null pointer if it is not available
+   */
+  inline ::Arcane::IMemoryAllocator* getPinnedMemoryAllocator() noexcept {
+    try {
+      return ::Arcane::MemoryUtils::getAllocator(
+          ::Arcane::eMemoryResource::HostPinned);
+    } catch (...) {
+    }
+    return nullptr;
+  }  // end of getPinnedMemoryAllocator
+
+  /*!
+   * \return an object allocated by an allocator of Arccore, which is never
+   * freed, or a null pointer if the allocator is null
+   * \tparam T: type of the object, which must be trivially copyable
+   * \param[in] a: allocator
+   */
+  template <typename T>
+  T* allocate(::Arcane::IMemoryAllocator* const a) {
+    static_assert(std::is_trivially_copyable_v<T>,
+                  "the allocated objects must be trivially copyable");
+    if (a == nullptr) {
+      return nullptr;
+    }
+    const auto m = a->allocate(::Arcane::MemoryAllocationArgs{},
+                               static_cast<::Arcane::Int64>(sizeof(T)));
+    return static_cast<T*>(m.baseAddress());
+  }  // end of allocate
+
+#if defined(ARCCORE_COMPILING_CUDA_OR_HIP)
+
+  /*!
+   * \brief kernel which is never launched: its attributes give the stack
+   * size required to apply a function at one point. Arccore does not
+   * increase the stack size of the threads, which is too small by default
+   * for some behaviours.
+   */
+  template <typename Function>
+  __global__ void stackSizeProbe(const Function f) {
+    f(0);
+  }  // end of stackSizeProbe
+
+  /*!
+   * \brief make the device of a CUDA or HIP queue the current device of the
+   * calling thread, and restore the previous current device at destruction.
+   * The stack size of the threads and the memory allocated by the runtimes
+   * of CUDA and HIP are the ones of the current device.
+   */
+  struct CurrentDeviceGuard {
+    //! \brief constructor
+    explicit CurrentDeviceGuard(const ::Arcane::Accelerator::RunQueue& q) {
+      if (!q.isAcceleratorPolicy()) {
+        return;
+      }
+      const auto d = q.deviceId().asInt32();
+      if (MFRONT_GENERIC_PARALLEL_GPU_API(GetDevice)(&(this->previous)) !=
+          MFRONT_GENERIC_PARALLEL_GPU_API(Success)) {
+        this->failed = true;
+        return;
+      }
+      if (this->previous == d) {
+        return;
+      }
+      if (MFRONT_GENERIC_PARALLEL_GPU_API(SetDevice)(d) !=
+          MFRONT_GENERIC_PARALLEL_GPU_API(Success)) {
+        this->failed = true;
+        return;
+      }
+      this->restore = true;
+    }
+    CurrentDeviceGuard(const CurrentDeviceGuard&) = delete;
+    CurrentDeviceGuard& operator=(const CurrentDeviceGuard&) = delete;
+    //! \brief destructor
+    ~CurrentDeviceGuard() {
+      if (this->restore) {
+        static_cast<void>(
+            MFRONT_GENERIC_PARALLEL_GPU_API(SetDevice)(this->previous));
+      }
+    }
+    //! \brief true if the device of the queue can't be made current
+    bool failed = false;
+
+   private:
+    //! \brief previous current device
+    int previous = 0;
+    //! \brief if true, the previous current device is restored
+    bool restore = false;
+  };
+
+#else /* defined(ARCCORE_COMPILING_CUDA_OR_HIP) */
+
+  //! \brief nothing to do: the device of a SYCL queue is held by the queue
+  struct CurrentDeviceGuard {
+    explicit CurrentDeviceGuard(const ::Arcane::Accelerator::RunQueue&) {}
+    CurrentDeviceGuard(const CurrentDeviceGuard&) = delete;
+    CurrentDeviceGuard& operator=(const CurrentDeviceGuard&) = delete;
+    //! \brief always false
+    bool failed = false;
+  };
+
+#endif /* defined(ARCCORE_COMPILING_CUDA_OR_HIP) */
+
+  /*!
+   * \brief increase the stack size of the threads of the current device of
+   * the calling thread (made the device of the queue by
+   * `CurrentDeviceGuard`) if the given function, applied at one point on a
+   * CUDA or HIP queue, requires it.
+   * Nothing is done for the other queues (SYCL gives no way to set it).
+   * \return an error message, empty on success
+   * \param[in] q: queue
+   * \param[in] f: function applied at one point
+   * \param[in] preserve: if true, the stack size is not modified, and an
+   * error is returned if it is too small
+   */
+  template <typename Function>
+  std::string ensureStackSize(const ::Arcane::Accelerator::RunQueue& q,
+                              const Function& f,
+                              const bool preserve) {
+    static_cast<void>(q);
+    static_cast<void>(f);
+    static_cast<void>(preserve);
+#if defined(ARCCORE_COMPILING_CUDA_OR_HIP)
+    if (q.isAcceleratorPolicy()) {
+      const auto r = gpu::ensureStackSize<stackSizeProbe<Function>>(preserve);
+      if (!r.succeeded()) {
+        return r.getErrorMessage();
+      }
+    }
+#endif
+    return {};
+  }  // end of ensureStackSize
+
+}  // end of namespace mfront::generic_parallel::arcane
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_ARCANEUTILITIES_HXX */
