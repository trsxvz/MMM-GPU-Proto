From 36ba812f068868773da71a5a1e98c04a71a347df Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 19:40:16 +0200
Subject: [PATCH] generic-parallel interface: local variable of the
 post-processings no longer shadowing a member

---
 .../include/MFront/GenericParallelBehaviour/Integrate.hxx   | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
index 5a03a5f7a..0366a5567 100644
--- a/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
+++ b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
@@ -1151,12 +1151,12 @@ namespace mfront::gpb {
             true);
         auto values = LocalValues<number_of_outputs>{};
         // the outputs are written and read through the same pointer
-        auto* const outputs = values.data();
+        auto* const point_outputs = values.data();
         const auto status = Integrator::template executePostProcessing<
             Behaviour, PostProcessing, use_initial_state>(
-            outputs, v.data, o, this->policy, this->parameters);
+            point_outputs, v.data, o, this->policy, this->parameters);
         if (status != -1) {
-          internals::scatterValues(this->outputs, i, outputs,
+          internals::scatterValues(this->outputs, i, point_outputs,
                                    number_of_outputs);
           r.status = 1;
         }
-- 
