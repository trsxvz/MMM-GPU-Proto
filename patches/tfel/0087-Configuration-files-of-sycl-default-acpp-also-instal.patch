From ce0429aa935c330ceaaac31178979f086f175967 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 17:29:52 +0200
Subject: [PATCH] Configuration files of sycl-default-acpp also installed for
 the sycl-gpu-acpp configuration

The tests of the sycl-gpu-acpp configuration use those files: they
failed if sycl-default-acpp was not selected.
---
 docs/web/release-notes-5.2.md             | 4 ++--
 mfront/configuration-files/CMakeLists.txt | 7 +++++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/docs/web/release-notes-5.2.md b/docs/web/release-notes-5.2.md
index 9a6a6bfb4..a16974dce 100644
--- a/docs/web/release-notes-5.2.md
+++ b/docs/web/release-notes-5.2.md
@@ -161,8 +161,8 @@ The following configurations are supported for parallel computations:
   programming model and AdaptiveCpp's `acpp` compiler.
 - `sycl-gpu-acpp`: tests of the `SYCL` backend for material properties on
   the GPU with AdaptiveCpp's `acpp` compiler. Those tests use the
-  configuration files of the `sycl-default-acpp` configuration, which must
-  also be selected.
+  configuration files of the `sycl-default-acpp` configuration, which are
+  installed if one of those two configurations is selected.
 - `kokkos`: configuration associated with the `Kokkos` library, using the
   compiler and the flags of the `Kokkos` installation found by `cmake`
   (default execution space and default host execution space).
diff --git a/mfront/configuration-files/CMakeLists.txt b/mfront/configuration-files/CMakeLists.txt
index afa36705f..3dc1f0947 100644
--- a/mfront/configuration-files/CMakeLists.txt
+++ b/mfront/configuration-files/CMakeLists.txt
@@ -53,10 +53,13 @@ if(_tfel-enable-generic-parallel-sycl-default-icpx-configuration)
   install_configuration_file(config-sycl-default-icpx.json)
 endif(_tfel-enable-generic-parallel-sycl-default-icpx-configuration)
 
-if(_tfel-enable-generic-parallel-sycl-default-acpp-configuration)
+# the tests of the sycl-gpu-acpp configuration use the configuration files
+# of the sycl-default-acpp configuration
+if((_tfel-enable-generic-parallel-sycl-default-acpp-configuration) OR
+   (_tfel-enable-generic-parallel-sycl-gpu-acpp-configuration))
   install_configuration_file(config-sycl-default-acpp.json)
   install_configuration_file(config-sycl-default-acpp-2.json)
-endif(_tfel-enable-generic-parallel-sycl-default-acpp-configuration)
+endif()
 
 # if(_tfel-enable-generic-parallel-stlpar-parunseq-acpp-generic-configuration)
 #   install_configuration_file(config-stlpar-parunseq-acpp-generic.json)
-- 
2.43.0

