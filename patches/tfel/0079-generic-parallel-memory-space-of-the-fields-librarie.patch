--- /dev/null
+++ b/mfront/include/MFront/GenericParallel/MemorySpace.hxx
@@ -0,0 +1,71 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallel/MemorySpace.hxx
+ * \brief  This file declares the memory spaces in which the fields given to
+ * the functions generated by the `generic-parallel` interfaces must be
+ * located, and the memory spaces of the programming models whose target is
+ * selected by the compiler.
+ * \date   09/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLEL_MEMORYSPACE_HXX
+#define LIB_MFRONT_GENERICPARALLEL_MEMORYSPACE_HXX
+
+namespace mfront::generic_parallel {
+
+  /*!
+   * \brief the computations are performed on the host: the fields must be
+   * accessible by the host (ordinary or shared memory)
+   */
+  inline constexpr const char* host_memory_space = "host";
+  /*!
+   * \brief the computations are performed on a device which can't access the
+   * ordinary memory of the host: the fields must be accessible by the device
+   * (memory of the device or shared memory)
+   */
+  inline constexpr const char* device_memory_space = "device";
+  /*!
+   * \brief the fields may be located anywhere (for instance, the fields which
+   * are not accessible by the device are copied)
+   */
+  inline constexpr const char* any_memory_space = "any";
+
+  /*!
+   * \return the memory space of the computations offloaded by `nvc++` (C++
+   * parallel algorithms with `-stdpar=gpu`, OpenMP with `-mp=gpu`): with the
+   * unified memory mode, the device accesses the whole memory of the host.
+   */
+  constexpr const char* getNVHPCOffloadMemorySpace() noexcept {
+#if defined(__NVCOMPILER_GPU_UNIFIED_MEM)
+    return any_memory_space;
+#else
+    return device_memory_space;
+#endif
+  }  // end of getNVHPCOffloadMemorySpace
+
+  //! \return the memory space of the C++ parallel algorithms
+  constexpr const char* getParallelSTLMemorySpace() noexcept {
+#if defined(__NVCOMPILER_STDPAR_GPU)
+    return getNVHPCOffloadMemorySpace();
+#else
+    return host_memory_space;
+#endif
+  }  // end of getParallelSTLMemorySpace
+
+  //! \return the memory space of the computations offloaded by OpenMP
+  constexpr const char* getOpenMPOffloadMemorySpace() noexcept {
+#if defined(__NVCOMPILER_OPENMP_GPU)
+    return getNVHPCOffloadMemorySpace();
+#else
+    return device_memory_space;
+#endif
+  }  // end of getOpenMPOffloadMemorySpace
+
+}  // end of namespace mfront::generic_parallel
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_MEMORYSPACE_HXX */
