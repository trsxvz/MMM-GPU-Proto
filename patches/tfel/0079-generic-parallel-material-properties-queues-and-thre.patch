From 2e3050e4af8718c1648f4023e8546eef8e8489e7 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 15:42:30 +0200
Subject: [PATCH] generic-parallel material properties: queues and thread
 blocks as for the behaviours

With an out-of-order SYCL queue, an asynchronous evaluation is refused and a synchronous evaluation synchronizes the queue before the kernel, so that the evaluation is always ordered after the computations which may compute the arguments. The number of threads per block of the CUDA and HIP backends is 128 by default and rounded up to a multiple of the warp size, as for the behaviours. Test of an out-of-order queue.
---
 .../MaterialProperty/CUDABackendBase.hxx      |  5 ++-
 .../MaterialProperty/CUDABackendBase.cxx      | 28 ++++++++++++--
 .../MaterialProperty/SYCLBackend.cxx          | 38 ++++++++-----------
 .../generic-parallel/test-sycl.cxx            | 27 ++++++++++++-
 4 files changed, 69 insertions(+), 29 deletions(-)

diff --git a/mfront/include/MFront/GenericParallel/MaterialProperty/CUDABackendBase.hxx b/mfront/include/MFront/GenericParallel/MaterialProperty/CUDABackendBase.hxx
index c6ce06b4b..cf7c6971f 100644
--- a/mfront/include/MFront/GenericParallel/MaterialProperty/CUDABackendBase.hxx
+++ b/mfront/include/MFront/GenericParallel/MaterialProperty/CUDABackendBase.hxx
@@ -118,7 +118,10 @@ namespace mfront::generic_parallel::material_property {
         const GenericParallelMaterialPropertyInterface&,
         const MaterialPropertyDescription&,
         const bool) const;
-    //! \brief number of threads per block
+    /*!
+     * \brief number of threads per block, rounded up to a multiple of the
+     * warp size at runtime (128 by default, as for the behaviours)
+     */
     std::optional<int> number_of_threads_per_block;
   };  // end of CUDABackendBase
 
diff --git a/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx b/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
index 490ce3155..bdb0c96b6 100644
--- a/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
+++ b/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
@@ -160,16 +160,36 @@ namespace mfront::generic_parallel::material_property {
       const bool treatStrides) const {
     const auto pm = this->getProgrammingModel();
     const auto name = i.getFunctionName(mpd);
-    const auto block_size = this->number_of_threads_per_block.value_or(64);
+    const auto threads_per_block =
+        this->number_of_threads_per_block.value_or(128);
+    const auto warp_size_attribute =
+        pm == "hip" ? "hipDeviceAttributeWarpSize" : "cudaDevAttrWarpSize";
     // stream given by the execution options (default stream if null)
     os << "const auto mfront_stream = static_cast<" << pm
        << "Stream_t>(mfront_options.queue);\n";
+    // number of threads per block, rounded up to a multiple of the warp
+    // size, as for the behaviours
+    os << "auto mfront_warp_device = int{};\n"
+       << "auto mfront_warp_size = int{};\n"
+       << "if ((" << pm << "GetDevice(&mfront_warp_device) != " << pm
+       << "Success) ||\n"
+       << "(" << pm << "DeviceGetAttribute(&mfront_warp_size, "
+       << warp_size_attribute << ", mfront_warp_device) != " << pm
+       << "Success)) {\n"
+       << "mfront_output_status->status = -6;\n"
+       << "mfront_report(\"unable to get the warp size of the device\");\n"
+       << "return;\n"
+       << "}\n"
+       << "const auto mfront_threads_per_block = static_cast<unsigned int>(("
+       << threads_per_block
+       << " + mfront_warp_size - 1) / mfront_warp_size * mfront_warp_size);\n";
     auto write_kernel_call = [&](const std::string_view npoints,
                                  const bool handleStrides) {
       os << "mfront_" << name << "_kernel"
-         << (handleStrides ? "" : "_without_strides") << "<<<((" << npoints
-         << " + " << block_size - 1 << ") / " << block_size << "), "
-         << block_size << ", 0, mfront_stream>>>(mfront_output, ";
+         << (handleStrides ? "" : "_without_strides")
+         << "<<<static_cast<unsigned int>((" << npoints
+         << " + mfront_threads_per_block - 1) / mfront_threads_per_block), "
+         << "mfront_threads_per_block, 0, mfront_stream>>>(mfront_output, ";
       if (handleStrides) {
         os << "mfront_output_stride, ";
       }
diff --git a/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx b/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx
index bfe2c7934..481e8845b 100644
--- a/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx
+++ b/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx
@@ -20,23 +20,6 @@
 
 namespace mfront::generic_parallel::material_property {
 
-  /*!
-   * \brief write the code waiting for the end of the commands previously
-   * submitted to an out-of-order queue
-   *
-   * With an out-of-order queue, the commands submitted by the generated
-   * functions would not be ordered after the commands previously submitted
-   * by the calling code (for instance the kernels computing the arguments).
-   * An in-order queue orders them.
-   *
-   * \param[in] os: output stream
-   */
-  static void writeOutOfOrderQueueSynchronization(std::ostream& os) {
-    os << "if (!mfront_queue->is_in_order()) {\n"
-       << "mfront_queue->wait_and_throw();\n"
-       << "}\n";
-  }  // end of writeOutOfOrderQueueSynchronization
-
   SYCLBackend::SYCLBackend() {}  // end of SYCLBackend
 
   SYCLBackend::SYCLBackend(const tfel::utilities::DataMap& opts) {
@@ -154,7 +137,21 @@ namespace mfront::generic_parallel::material_property {
        << "return;\n"
        << "}\n"
        << "auto* const mfront_queue = "
-       << "static_cast<::sycl::queue*>(mfront_options.queue);\n";
+       << "static_cast<::sycl::queue*>(mfront_options.queue);\n"
+       // the kernel must be executed after the computations already
+       // submitted to the queue, which may compute the arguments. This is
+       // guaranteed by an in-order queue. With an out-of-order queue, the
+       // evaluation is synchronous and the queue is synchronized before the
+       // kernel, as for the behaviours.
+       << "if (!mfront_queue->is_in_order()) {\n"
+       << "if (mfront_asynchronous) {\n"
+       << "mfront_output_status->status = -5;\n"
+       << "mfront_report(\"asynchronous evaluations require an in-order SYCL "
+       << "queue\");\n"
+       << "return;\n"
+       << "}\n"
+       << "mfront_queue->wait_and_throw();\n"
+       << "}\n";
   }  // end of writeExecutionPreparation
 
   void SYCLBackend::writeKernelCall(
@@ -165,10 +162,6 @@ namespace mfront::generic_parallel::material_property {
       const bool treatStrides) const {
     const auto types = i.getTypesDescription();
     const auto requiresBoundsCheck = this->isBoundsCheckingRequired(mpd);
-    if (!this->handlesDataTransfer()) {
-      // otherwise, done before the data transfers
-      writeOutOfOrderQueueSynchronization(os);
-    }
     writeDeviceStackSizeSetting(os, this->device_stack_size);
     if (requiresBoundsCheck) {
       // the statuses are held by a block of shared memory, identified by
@@ -239,7 +232,6 @@ namespace mfront::generic_parallel::material_property {
     if (!this->handlesDataTransfer()) {
       return;
     }
-    writeOutOfOrderQueueSynchronization(os);
     os << "auto mfront_sycl_copy_events = std::vector<::sycl::event>{};\n";
     if (mpd.inputs.empty()) {
       os << "mfront_sycl_copy_events.reserve(1);\n";
diff --git a/test-suite/material-properties/generic-parallel/test-sycl.cxx b/test-suite/material-properties/generic-parallel/test-sycl.cxx
index ac7c13523..1f5334b8c 100644
--- a/test-suite/material-properties/generic-parallel/test-sycl.cxx
+++ b/test-suite/material-properties/generic-parallel/test-sycl.cxx
@@ -64,6 +64,7 @@ struct Iconel600YoungModulusTest : public tfel::tests::TestCase {
     this->test18();
     this->test14();
     this->test15();
+    this->test16();
     TFEL_TESTS_ASSERT(checkGenericParallelSymbols("sycl"));
     return this->result;
   }  // end of execute
@@ -80,7 +81,9 @@ struct Iconel600YoungModulusTest : public tfel::tests::TestCase {
     // queue is synchronized. The second temperature is out of its physical
     // bounds.
     constexpr auto eps = double{1e-2};
-    auto Q = sycl::queue{TFEL_SYCL_DEVICE_SELECTOR};
+    // an asynchronous evaluation requires an in-order queue
+    auto Q = sycl::queue{TFEL_SYCL_DEVICE_SELECTOR,
+                         sycl::property::queue::in_order{}};
     const auto n = Inconel600_YoungModulus_generic_parallel_number_of_statuses;
     auto *const statuses = sycl::malloc_shared<int>(n, Q);
     auto *const T = sycl::malloc_shared<double>(4, Q);
@@ -109,6 +112,28 @@ struct Iconel600YoungModulusTest : public tfel::tests::TestCase {
     sycl::free(E, Q);
   }
 
+  void test16() {
+    // an asynchronous evaluation is refused with an out-of-order queue
+    auto Q = sycl::queue{TFEL_SYCL_DEVICE_SELECTOR};
+    TFEL_TESTS_ASSERT(!Q.is_in_order());
+    const auto n = Inconel600_YoungModulus_generic_parallel_number_of_statuses;
+    auto *const statuses = sycl::malloc_shared<int>(n, Q);
+    auto *const T = sycl::malloc_shared<double>(4, Q);
+    auto *const E = sycl::malloc_shared<double>(4, Q);
+    std::fill(T, T + 4, 300.);
+    const auto args = std::array<const double *, 1u>{T};
+    const auto args_strides = std::array<mfront_gmp_size_type, 1u>{1};
+    const auto options =
+        mfront_gpmp_ExecutionOptions{.queue = &Q, .statuses = statuses};
+    auto output = mfront_gmp_OutputStatus{};
+    Inconel600_YoungModulus(&output, E, 1, args.data(), args_strides.data(), 1,
+                            4, mfront_gmp_OutOfBoundsPolicy{}, &options);
+    TFEL_TESTS_CHECK_EQUAL(output.status, -5);
+    sycl::free(statuses, Q);
+    sycl::free(T, Q);
+    sycl::free(E, Q);
+  }
+
   void test14() {
     // SYCL has no default queue: a queue must be given by the execution
     // options
