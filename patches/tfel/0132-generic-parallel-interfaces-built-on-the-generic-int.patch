diff --git a/test-suite/behaviours/generic-parallel/check-generic-functions.sh b/test-suite/behaviours/generic-parallel/check-generic-functions.sh
new file mode 100644
index 000000000..bd3598ecf
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/check-generic-functions.sh
@@ -0,0 +1,89 @@
+# Check the libraries of the `generic-parallel` interface which also contain
+# the functions of the `generic` interface (`generic_functions` option):
+# libraries of a few test behaviours are built in the `generic-functions`
+# directory with the tested configuration and this option, and compared to
+# the reference built by build-libraries.sh, with the
+# `--generic-functions=true` option of compare.cxx (interface `Generic`,
+# functions of a point compared to the functions of batches of points,
+# shared parameters and out of bounds policy).
+#
+# usage: sh ../check-generic-functions.sh mfront configuration_file
+#        compare_executable backend [options]
+set -e
+mfront=$1
+configuration=$2
+compare=$3
+backend=$4
+shift 4
+for v in mfront compare; do
+  eval "p=\$$v"
+  case "$p" in
+    /*) ;;
+    */*) eval "$v=\$PWD/\$p" ;;
+  esac
+done
+# the configuration file is looked for in the current directory, then in
+# the configuration files installed with TFEL, as MFront does
+find_configuration() {
+  if [ -f "$1" ]; then
+    echo "$PWD/$1"
+    return
+  fi
+  prefix=$(cd "$(dirname "$(command -v "$mfront")")/.." && pwd)
+  for d in "$prefix"/share/tfel*/mfront/configuration-files; do
+    if [ -f "$d/$1" ]; then
+      echo "$d/$1"
+      return
+    fi
+  done
+  echo "configuration file '$1' not found" >&2
+  exit 1
+}
+configuration=$(find_configuration "$configuration")
+directory=$(cd "$(dirname "$0")" && pwd)
+mkdir -p generic-functions
+cd generic-functions
+cat > config-generic-functions.json << 'END'
+interfaces_options: {
+  generic-parallel: {
+    generic_functions: true
+  }
+}
+END
+files=""
+for b in IsotropicLinearHardeningPlasticity ImplicitNortonWithEnergies \
+  OrthotropicElastic InitializeFunctionTest PostProcessingTest \
+  GenericParallelModelTest; do
+  files="$files $directory/$b.mfront"
+done
+"$mfront" --obuild --search-path="$directory" --interface=generic-parallel \
+  --configuration-file="$configuration" \
+  --configuration-file="$PWD/config-generic-functions.json" $files
+gf="--generic-functions=true $*"
+# compare-functions.sh reads the comparison program and the batch library in
+# the positional parameters (`.` does not take arguments in POSIX shells)
+set -- "$compare" "src/libGenericParallelBehaviour-$backend.so"
+. "$directory/compare-functions.sh"
+# reference built by build-libraries.sh
+reference=../reference/src/libBehaviour.so
+run IsotropicLinearHardeningPlasticity_Tridimensional --amplitude=3e-3 $gf
+run IsotropicLinearHardeningPlasticity_Tridimensional --amplitude=3e-3 \
+  --parameters=YoungModulus=150e9,PoissonRatio=0.3,HardeningSlope=5e9,YieldStrength=200e6 $gf
+run ImplicitNortonWithEnergies_Tridimensional --material-properties=150e9,0.3 \
+  --perturbation-of-internal-state-variables=1e-4 --out-of-bounds-policy=Strict $gf
+run OrthotropicElastic_Tridimensional \
+  --material-properties=200e9,150e9,100e9,0.3,0.25,0.2,70e9,60e9,50e9 $gf
+run OrthotropicElastic_Tridimensional_rotateGradients $gf
+run InitializeFunctionTest_Tridimensional_InitializeFunction_StressFromInitialPressure $gf
+run PostProcessingTest_Tridimensional_PostProcessing_PrincipalStrain \
+  --material-properties=150e9,0.3 $gf
+# standalone model: failures at some points, parameter changed in the batch
+# library
+reference=../reference/src/libModel.so
+batch=src/libGenericParallelModel-$backend.so
+run GenericParallelModelTest_PlaneStress --material-properties=500 \
+  --amplitude=0 --temperature=600 \
+  --perturbation-of-internal-state-variables=1e-4 $gf
+run GenericParallelModelTest_Tridimensional --material-properties=500 \
+  --amplitude=0 --temperature=600 --parameters=SwellingCoefficient=1e-3 $gf
+exit $status
diff --git a/test-suite/behaviours/generic-parallel/compare.cxx b/test-suite/behaviours/generic-parallel/compare.cxx
index c279ab411..cdc85e354 100644
--- a/test-suite/behaviours/generic-parallel/compare.cxx
+++ b/test-suite/behaviours/generic-parallel/compare.cxx
@@ -900,6 +900,13 @@ struct Options {
    * invalid: the integration must be refused (see `testInvalidParameters`)
    */
   bool invalid_parameters = false;
+  /*!
+   * \brief if true, the batch library also contains the functions of the
+   * `generic` interface (`generic_functions` option of the `generic-parallel`
+   * interface): it must export `Generic` as interface, and its functions of
+   * a point are also compared to its functions of batches of points
+   */
+  bool generic_functions = false;
   //! \brief type of the tangent operator (consistent tangent operator by
   //! default)
   double tangent_operator = 4;
@@ -953,6 +960,8 @@ static Options parseOptions(const int argc,
       r.other_device = v == "true";
     } else if (o == "--invalid-parameters") {
       r.invalid_parameters = v == "true";
+    } else if (o == "--generic-functions") {
+      r.generic_functions = v == "true";
     } else if (o == "--speed-of-sound") {
       r.mass_density = std::stod(v);
     } else if (o == "--initial-internal-state-variables") {
@@ -1671,6 +1680,7 @@ int main(const int argc, const char* const* const argv) {
          "[--initial-internal-state-variables=values] "
          "[--speed-of-sound=mass_density] [--energies=true] "
          "[--other-device=true] [--invalid-parameters=true] "
+         "[--generic-functions=true] "
          "[--tangent-operator=type] "
          "[--perturbation-of-internal-state-variables=amplitude] "
          "[--out-of-bounds-policy=policy] "
@@ -1782,20 +1792,40 @@ int main(const int argc, const char* const* const argv) {
                     [&] { return 1e-3 * (1 + u(rng)) / 2; });
     }
   }
-  const auto ok = [&t] {
-    if (t.options.invalid_parameters) {
-      return testInvalidParameters(t);
+  const auto run = [](const Test& test) {
+    if (test.options.invalid_parameters) {
+      return testInvalidParameters(test);
     }
-    switch (t.mode) {
+    switch (test.mode) {
       case Mode::INITIALIZE_FUNCTION:
-        return testInitializeFunction(t);
+        return testInitializeFunction(test);
       case Mode::POST_PROCESSING:
-        return testPostProcessing(t);
+        return testPostProcessing(test);
       case Mode::ROTATION:
-        return testRotation(t);
+        return testRotation(test);
       default:
-        return testIntegration(t);
+        return testIntegration(test);
     }
-  }();
+  };
+  auto ok = run(t);
+  if (t.options.generic_functions) {
+    // the library exports `Generic` as interface, as a library of the
+    // `generic` interface
+    const auto* const interface = static_cast<const char* const*>(
+        findSymbol(t.batch_library, t.name, "mfront_interface"));
+    const auto generic =
+        (interface != nullptr) && (std::string_view{*interface} == "Generic");
+    std::printf("interface of the batch library: %s | %s\n",
+                interface != nullptr ? *interface : "none",
+                generic ? "OK" : "FAILED");
+    // the functions of a point of the batch library are compared to its
+    // functions of batches of points, which have just been compared to the
+    // reference: the parameters and the out of bounds policy, changed above
+    // in the batch library, are shared by both kinds of functions
+    std::printf("functions of a point of the batch library:\n");
+    auto tp = t;
+    tp.generic_library = t.batch_library;
+    ok = generic && run(tp) && ok;
+  }
   return ok ? EXIT_SUCCESS : EXIT_FAILURE;
 }
