From e9fb729905eeb5fc43a872caf8f987862947772b Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 05:10:14 +0200
Subject: [PATCH] nvc++ stdpar configuration without relocatable device code

nvc++ 25.11 exports some constant data of the device code under names
which are only unique in a source file (__staticinit_<counter>_<function>).
Two source files giving the same counter to the same inline function can't
be linked together, so that the device link of a library of several
behaviours fails at random. The device code of each source file is now
linked on its own (-gpu=nordc): the sources generated by MFront do not
call device functions defined in other files.
---
 docs/web/generic-parallel-behaviour-interface.md           | 7 ++++++-
 .../config-stlpar-parunseq-nvhpc-gpu.json                  | 4 ++--
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index 47bc29f41..c44a9347e 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -434,7 +434,12 @@ The memory mode shall be given explicitly by `-gpu=mem:managed` (see the
 `stlpar-parunseq-nvhpc-gpu` configuration): this mode does not depend on
 the support of heterogeneous memory management by the system, and the
 `unified` mode, selected by default on such systems by `nvc++` 25.11,
-miscompiles some behaviours.
+miscompiles some behaviours. The device code of each source file is also
+compiled without relocatable device code (`-gpu=nordc`): `nvc++` 25.11
+exports some constant data of the device code under names which are only
+unique in a source file (`__staticinit_<counter>_<function>`), so that the
+device link of several behaviours fails at random. The sources generated
+by `MFront` do not call device functions defined in other files.
 
 Options:
 
diff --git a/mfront/configuration-files/config-stlpar-parunseq-nvhpc-gpu.json b/mfront/configuration-files/config-stlpar-parunseq-nvhpc-gpu.json
index 992c0bddd..73ff15b41 100644
--- a/mfront/configuration-files/config-stlpar-parunseq-nvhpc-gpu.json
+++ b/mfront/configuration-files/config-stlpar-parunseq-nvhpc-gpu.json
@@ -13,9 +13,9 @@ interfaces_options: {
 compilation_options : {
   cxx : {
     compiler: "@TFEL_NVHPC_COMPILER@",
-    compilation_flags: "-O2 -stdpar=gpu -gpu=mem:managed -std=c++@TFEL_CXX_STANDARD@ -march=native" 
+    compilation_flags: "-O2 -stdpar=gpu -gpu=mem:managed,nordc -std=c++@TFEL_CXX_STANDARD@ -march=native" 
   }
 },
 linking_options : {
-  linker_flags: "-stdpar=gpu -gpu=mem:managed"
+  linker_flags: "-stdpar=gpu -gpu=mem:managed,nordc"
 }
-- 
2.43.0

