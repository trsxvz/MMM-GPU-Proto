From 66d7157dc0f0f5efcd3e255389ad3a2e1d0ce675 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 00:09:28 +0200
Subject: [PATCH] generic-parallel material properties: fixes from a review

- the variant with strides did not compile with the runtime checks
  disabled (`mfront_errno_old` declared only with the checks);
- SYCL backend: the device memory was never freed (empty destructor of
  the data buffers); the extents of the strided fields were too large;
  the values between the values of a strided output were overwritten
  when the output was copied back;
- the array of the pointers to the arguments, generally on the stack of
  the calling code, was read in the kernels. The pointers are copied in
  the kernels, one by one: nvc++ 25.11 does not map an array of pointers
  captured by a lambda in an OpenMP target region;
- the data transfers are made inside the `try` block, so that their
  exceptions do not cross the boundary of the C function;
- the name of the backend is part of the header guard;
- the bounds and the default values of the parameters are written with
  14 significant digits;
- grid size of the CUDA kernels, error message of a negative stride,
  unused variables, copies of the generators of the factory, and a stray
  copy of a source file removed.

The material property test of the openmp-host-gcc configuration also
compiles a material property with the runtime checks disabled.
---
 .../MaterialProperty/CUDABackendBase.cxx      | 23 ++++++++++++++++++-
 .../CxxProgrammingModelBackendBase.cxx        | 20 +++++++++-------
 .../MaterialProperty/SYCLBackend.cxx          |  3 +++
 ...nericParallelMaterialPropertyInterface.cxx |  4 ++--
 .../openmp-host-gcc/test.check                |  3 +++
 5 files changed, 42 insertions(+), 11 deletions(-)

diff --git a/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx b/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
index c675801f7..102ff70b9 100644
--- a/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
+++ b/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
@@ -310,7 +310,7 @@ namespace mfront::generic_parallel::material_property {
          << "};\n";
     }
     // errno is restored before returning, even if the runtime checks are
-    // disabled (checks of a uniform output)
+    // disabled (checks of the strides)
     os << "[[maybe_unused]] const int mfront_errno_old = errno;\n";
     os << "mfront_output_status->status = 0;\n"
        << "mfront_output_status->bounds_status = 0;\n"
@@ -323,6 +323,27 @@ namespace mfront::generic_parallel::material_property {
          << "errno = mfront_errno_old;\n"
          << "return;\n"
          << "}\n";
+      if (treatStrides) {
+        os << "if(!mfront_check_positive_or_null(mfront_output_stride)){\n"
+           << "mfront_output_status->status = -5;\n"
+           << "mfront_report(\"negative output stride "
+           << "(\"+std::to_string(mfront_output_stride)+\" given\");\n"
+           << "errno = mfront_errno_old;\n"
+           << "return;\n"
+           << "}\n";
+        for (std::size_t idx = 0; idx != mpd.inputs.size(); ++idx) {
+          os << "if(!mfront_check_positive_or_null(mfront_args_strides[" << idx
+             << "])){\n"
+             << "mfront_output_status->status = -5;\n"
+             << "mfront_report(\"negative stride given for variable '"
+             << mpd.inputs[idx].getExternalName()
+             << "' (\"+std::to_string(mfront_args_strides[" << idx
+             << "])+\" given)\");\n"
+             << "errno = mfront_errno_old;\n"
+             << "return;\n"
+             << "}\n";
+        }
+      }
       // check number of arguments
       os << "if(mfront_nargs != " << mpd.inputs.size() << "){\n"
          << "mfront_output_status->status = -5;\n"
diff --git a/mfront/src/GenericParallel/MaterialProperty/CxxProgrammingModelBackendBase.cxx b/mfront/src/GenericParallel/MaterialProperty/CxxProgrammingModelBackendBase.cxx
index 3af71825e..39b40b8cd 100644
--- a/mfront/src/GenericParallel/MaterialProperty/CxxProgrammingModelBackendBase.cxx
+++ b/mfront/src/GenericParallel/MaterialProperty/CxxProgrammingModelBackendBase.cxx
@@ -165,7 +165,7 @@ namespace mfront::generic_parallel::material_property {
          << "};\n";
     }
     // errno is restored before returning, even if the runtime checks are
-    // disabled (checks of a uniform output)
+    // disabled (checks of the strides)
     os << "[[maybe_unused]] const int mfront_errno_old = errno;\n";
     os << "mfront_output_status->status = 0;\n"
        << "mfront_output_status->bounds_status = 0;\n"
@@ -303,8 +303,6 @@ namespace mfront::generic_parallel::material_property {
       const bool handleStrides) const {
     const auto types = i.getTypesDescription();
     const auto requiresBoundsCheck = this->isBoundsCheckingRequired(mpd);
-    const auto name = i.getFunctionName(mpd);
-    const auto nname = i.getInterfaceInternalNamespace();
     const auto iucname = i.getInterfaceNameInUpperCase();
     const auto prefix = i.getOutOfBoundsPolicyEnumerationPrefix();
     const auto& function = mpd.f;
@@ -318,11 +316,8 @@ namespace mfront::generic_parallel::material_property {
     if (handleStrides) {
       os << ", mfront_output_stride";
     }
-    // the pointers to the values of the arguments are copied: the array of
-    // those pointers is generally not accessible by the device (for
-    // instance, an array on the stack of the calling code)
     for (std::size_t idx = 0; idx != mpd.inputs.size(); ++idx) {
-      os << ", mfront_arg" << idx << " = mfront_args[" << idx << "]";
+      os << ", mfront_arg" << idx;
     }
     if ((handleStrides) && (!mpd.inputs.empty())) {
       os << ", mfront_args_strides_tmp";
@@ -464,7 +459,16 @@ namespace mfront::generic_parallel::material_property {
       const MaterialPropertyDescription& mpd,
       const FileDescription& fd,
       const bool treatStrides) const {
-    // variables captured by the kernels
+    // variables captured by the kernels. The pointers to the arguments are
+    // copied, since the array of those pointers given by the calling code
+    // is generally not accessible by the device (for example, an array on
+    // the stack of the calling code). They are captured one by one: nvc++
+    // 25.11 does not map an array of pointers captured by a lambda in an
+    // OpenMP target region.
+    for (std::size_t idx = 0; idx != mpd.inputs.size(); ++idx) {
+      os << "const auto mfront_arg" << idx << " = mfront_args[" << idx
+         << "];\n";
+    }
     if (this->isBoundsCheckingRequired(mpd)) {
       os << "auto* const mfront_bounds_statuses = "
          << "mfront_bounds_statuses_storage.data();\n";
diff --git a/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx b/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx
index f995d451f..6da60f7db 100644
--- a/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx
+++ b/mfront/src/GenericParallel/MaterialProperty/SYCLBackend.cxx
@@ -301,6 +301,9 @@ namespace mfront::generic_parallel::material_property {
        << "::mfront::gpmp::sycl::DataBuffer<" << types.real_type
        << ">{*mfront_queue};\n";
     if (treatStrides) {
+      // with a stride greater than one, the values between the values of
+      // the output are copied, so that copying the output back preserves
+      // them
       os << "if (mfront_output_stride == 0) {\n"
          << "mfront_sycl_copy_events.push_back("
          << "mfront_output_ptr.acquire(mfront_output_host,  1, true));\n"
diff --git a/mfront/src/GenericParallelMaterialPropertyInterface.cxx b/mfront/src/GenericParallelMaterialPropertyInterface.cxx
index d93098de6..50587f07d 100644
--- a/mfront/src/GenericParallelMaterialPropertyInterface.cxx
+++ b/mfront/src/GenericParallelMaterialPropertyInterface.cxx
@@ -274,6 +274,7 @@ namespace mfront {
       getLogStream() << "GenericParallelMaterialPropertyInterface::"
                         "writeSrcFile: begin\n";
     }
+    const auto types = this->getTypesDescription();
     const auto nname = this->getInterfaceInternalNamespace();
     const auto name = this->getFunctionName(mpd);
     const auto fn = "src/" + this->getSourceFileName(name);
@@ -284,8 +285,7 @@ namespace mfront {
         "unable to open '" +
             fn + "'");
     os.exceptions(std::ios::badbit | std::ios::failbit);
-    // precision of the bounds and of the parameters treated as static
-    // variables, as in the exported symbols
+    // precision of the bounds and of the default values of the parameters
     os.precision(14);
     const auto& file = fd.fileName;
     const auto& author = fd.authorName;
diff --git a/test-suite/material-properties/generic-parallel/openmp-host-gcc/test.check b/test-suite/material-properties/generic-parallel/openmp-host-gcc/test.check
index c344d3ce3..f01a64002 100644
--- a/test-suite/material-properties/generic-parallel/openmp-host-gcc/test.check
+++ b/test-suite/material-properties/generic-parallel/openmp-host-gcc/test.check
@@ -10,6 +10,9 @@
 @Command "@mfront@ --obuild --configuration-file=config-openmp-host-gcc.json";
 @Command "@TFEL_GXX_COMPILER@ -I @TFEL_INCLUDE_DIR@ -I include -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -DMFRONT_GPMP_TEST_BACKEND=openmp ../test-cxx.cxx -o test-openmp -L @TFEL_LIBRARY_DIR@ -lTFELTests -L src -lGenericParallelUO2-openmp -lGenericParallelInconel600-openmp -lGenericParallelMaterialLaw-openmp";
 @Command "./test-openmp test-openmp-openmp-host-gcc";
+// compilation with the runtime checks disabled
+@Command "@mfront@ --interface=generic-parallel --dsl-option=disable_runtime_checks:true --configuration-file=config-openmp-host-gcc.json ../Inconel600_YoungModulus.mfront";
+@Command "@mfront@ --obuild --configuration-file=config-openmp-host-gcc.json";
 
 @CleanFiles {"test-openmp"};
 @CleanDirectories {"include", "src"};
-- 
2.43.0

