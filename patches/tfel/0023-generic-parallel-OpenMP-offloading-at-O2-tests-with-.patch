From 3d3867c905286f25557d0a15ea7a80369cba40ca Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 6 Oct 2026 01:49:09 +0200
Subject: [PATCH] generic-parallel: OpenMP offloading at -O2, tests with clang
 and icpx

- openmp-offload-nvhpc-gpu: compiled at -O2 (the defects of nvc++ are
  avoided by the two previous commits), minimal stack size of the threads
  of the device set to 16 KiB, as for stlpar-parunseq-nvhpc-gpu.
- stlpar-parunseq-clang and stlpar-parunseq-icpx: linked with TBB, the
  backend of the parallel algorithms of libstdc++.
- tests of the behaviours for the stlpar-parunseq-clang,
  stlpar-parunseq-icpx and sycl-default-icpx configurations.
- documentation of the constructs avoided for nvc++ -mp=gpu.
---
 .../generic-parallel-behaviour-interface.md   | 22 +++++++++++--------
 .../config-openmp-offload-nvhpc-gpu.json      |  5 +++--
 .../stlpar-parunseq-clang/test.check          | 13 +++++++++++
 .../stlpar-parunseq-icpx/test.check           | 13 +++++++++++
 .../sycl-default-icpx/test.check              | 20 +++++++++++++++++
 5 files changed, 62 insertions(+), 11 deletions(-)
 create mode 100644 test-suite/behaviours/generic-parallel/stlpar-parunseq-clang/test.check
 create mode 100644 test-suite/behaviours/generic-parallel/stlpar-parunseq-icpx/test.check
 create mode 100644 test-suite/behaviours/generic-parallel/sycl-default-icpx/test.check

diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index da7f359fd..410b0ce45 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -359,15 +359,19 @@ reductions.
 When the computations are offloaded, the fields of the batch must be
 accessible from the device. With `nvc++ -mp=gpu`, the memory mode shall be
 given explicitly by `-gpu=mem:managed`, as with the `stlpar` backend (see
-the `openmp-offload-nvhpc-gpu` configuration). Offloading with `nvc++`
-25.11 is experimental: at `-O2` and `-O3`, the computation of the tangent
-operator of the behaviours based on the implicit DSLs is miscompiled (the
-integration is reported as failed), which is why this configuration is
-compiled at `-O1`, and the device code of some behaviours (for instance the
-`HosfordPerfectPlasticity` behaviour of the tests) references a static
-block which is not emitted, so that the libraries containing them can't be
-loaded on the device. The `openmp-host-gcc` configuration uses the threads
-of the host.
+the `openmp-offload-nvhpc-gpu` configuration). The `openmp-host-gcc`
+configuration uses the threads of the host.
+
+Two constructs lead `nvc++ -mp=gpu` (25.11 to 26.9) to generate wrong
+device code at `-O2` and `-O3`, and are therefore avoided in the generated
+code and in the headers of `TFEL`:
+
+- a local object holding a reference to a local boolean flag. The function
+  objects given to the tangent operator of the implicit DSLs
+  (`getPartialJacobianInvert`) own their status flag.
+- an assertion in device code. Its text is registered as a static block
+  which is not emitted, so that the library can't be loaded on the
+  device.
 
 Options:
 
diff --git a/mfront/configuration-files/config-openmp-offload-nvhpc-gpu.json b/mfront/configuration-files/config-openmp-offload-nvhpc-gpu.json
index 121cdb4a9..a38b7fa66 100644
--- a/mfront/configuration-files/config-openmp-offload-nvhpc-gpu.json
+++ b/mfront/configuration-files/config-openmp-offload-nvhpc-gpu.json
@@ -4,7 +4,8 @@ dsl_options: {
 interfaces_options: {
   generic-parallel: {
     backend: {openmp: {
-        offload: true
+        offload: true,
+        device_stack_size: 16384
       }
     }
   }
@@ -12,7 +13,7 @@ interfaces_options: {
 compilation_options : {
   cxx : {
     compiler: "@TFEL_NVHPC_COMPILER@",
-    compilation_flags: "-O1 -mp=gpu -gpu=mem:managed -std=c++@TFEL_CXX_STANDARD@ -march=native"
+    compilation_flags: "-O2 -mp=gpu -gpu=mem:managed -std=c++@TFEL_CXX_STANDARD@ -march=native"
   }
 },
 linking_options : {
diff --git a/test-suite/behaviours/generic-parallel/stlpar-parunseq-clang/test.check b/test-suite/behaviours/generic-parallel/stlpar-parunseq-clang/test.check
new file mode 100644
index 000000000..6e7689aaa
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/stlpar-parunseq-clang/test.check
@@ -0,0 +1,13 @@
+@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::stlpar-parunseq-clang"};
+
+@Environment {"LD_LIBRARY_PATH": "src"};
+// the generic interface gives the reference results. Using both interfaces
+// in the same call also checks that they can be used together.
+@Command "@mfront@ --obuild --search-path=.. --interface=generic --interface=generic-parallel --configuration-file=config-stlpar-parunseq-clang.json ../IsotropicLinearHardeningPlasticity.mfront ../ImplicitNorton.mfront ../HosfordPerfectPlasticity.mfront ../StrainHardeningCreep3.mfront ../HenckyImplicitNorton.mfront ../GreenLagrangeImplicitNorton.mfront ../SaintVenantKirchhoffElasticity.mfront ../InitializeFunctionTest.mfront ../PostProcessingTest.mfront ../OrthotropicElastic.mfront ../OrthotropicSaintVenantKirchhoffElasticity.mfront ../OrthotropicStationaryHeatTransfer.mfront ../SingleCrystal_DD_FCC.mfront ../FiniteStrainSingleCrystal.mfront ../ImplicitNortonWithEnergies.mfront ../Norton_rk42.mfront ../Tvergaard.mfront ../BehaviourVariableTest.mfront ../ExternalModelCallerTest.mfront ../StandardElastoViscoPlasticityTest.mfront ../OrthotropicStandardElastoViscoPlasticityTest.mfront ../PorousStandardElastoViscoPlasticityTest.mfront ../GenericParallelModelTest.mfront ../GenericParallelModelWithQuantitiesTest.mfront";
+@Command "@TFEL_CLANGXX_COMPILER@ -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl";
+// comparisons with the `generic` interface, which gives the reference
+// results (see compare-all.sh)
+@Command "sh ../compare-all.sh ./compare src/libGenericParallelBehaviour-stlpar.so";
+
+@CleanFiles {"compare"};
+@CleanDirectories {"include", "src"};
diff --git a/test-suite/behaviours/generic-parallel/stlpar-parunseq-icpx/test.check b/test-suite/behaviours/generic-parallel/stlpar-parunseq-icpx/test.check
new file mode 100644
index 000000000..d39b0a20b
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/stlpar-parunseq-icpx/test.check
@@ -0,0 +1,13 @@
+@Requires {"mfront::behaviour::generic-parallel_interface::supported_configuration::stlpar-parunseq-icpx"};
+
+@Environment {"LD_LIBRARY_PATH": "src"};
+// the generic interface gives the reference results. Using both interfaces
+// in the same call also checks that they can be used together.
+@Command "@mfront@ --obuild --search-path=.. --interface=generic --interface=generic-parallel --configuration-file=config-stlpar-parunseq-icpx.json ../IsotropicLinearHardeningPlasticity.mfront ../ImplicitNorton.mfront ../HosfordPerfectPlasticity.mfront ../StrainHardeningCreep3.mfront ../HenckyImplicitNorton.mfront ../GreenLagrangeImplicitNorton.mfront ../SaintVenantKirchhoffElasticity.mfront ../InitializeFunctionTest.mfront ../PostProcessingTest.mfront ../OrthotropicElastic.mfront ../OrthotropicSaintVenantKirchhoffElasticity.mfront ../OrthotropicStationaryHeatTransfer.mfront ../SingleCrystal_DD_FCC.mfront ../FiniteStrainSingleCrystal.mfront ../ImplicitNortonWithEnergies.mfront ../Norton_rk42.mfront ../Tvergaard.mfront ../BehaviourVariableTest.mfront ../ExternalModelCallerTest.mfront ../StandardElastoViscoPlasticityTest.mfront ../OrthotropicStandardElastoViscoPlasticityTest.mfront ../PorousStandardElastoViscoPlasticityTest.mfront ../GenericParallelModelTest.mfront ../GenericParallelModelWithQuantitiesTest.mfront";
+@Command "@TFEL_ICPX_COMPILER@ -O2 -march=native --std=c++@TFEL_CXX_STANDARD@ -I @TFEL_INCLUDE_DIR@ ../compare.cxx -o compare -ldl";
+// comparisons with the `generic` interface, which gives the reference
+// results (see compare-all.sh)
+@Command "sh ../compare-all.sh ./compare src/libGenericParallelBehaviour-stlpar.so";
