+  template <auto m>
+  struct MethodCaller {
+    //! \brief call the method of the given behaviour
+    template <typename Behaviour, typename... Arguments>
+    TFEL_HOST_DEVICE void operator()(Behaviour& b, Arguments&&... args) const {
+      (b.*m)(std::forward<Arguments>(args)...);
+    }
+  };
