+
+//! \brief maximal value of the indices, meaning no point
+static constexpr auto no_index =
+    std::numeric_limits<mfront_gmp_size_type>::max();
+
+//! \return the young modulus of the `UO2_YoungModulus_Martin1989` law
+[[nodiscard]] static double uo2_young(const double T, const double f) {
+  constexpr auto E0 = 2.2693e11;
+  constexpr auto dE_dT = -1.53994698e7;
+  constexpr auto d2E_dT2 = -1.9198278e4;
+  constexpr auto f0 = 0.4;
+  return (1 - f / f0) * (E0 + dE_dT * T + (d2E_dT2 / 2) * T * T);
+}
+
+struct GenericParallelMaterialPropertyTest : public tfel::tests::TestCase {
+  GenericParallelMaterialPropertyTest()
+      : tfel::tests::TestCase("MFront/MaterialProperty/GenericParallel",
+                              "GenericParallelMaterialPropertyTest") {
+  }  // end of GenericParallelMaterialPropertyTest
+
+  tfel::tests::TestResult execute() override {
+    this->test1();
+    this->test2();
+    this->test3();
+    this->test4();
+    this->test5();
+    this->test6();
+    this->test7();
+    this->test8();
+    this->test9();
+    this->test10();
+    this->test11();
+    this->test12();
+    this->test13();
+    this->test14();
+    this->test15();
+    this->test16();
+    this->test17();
+    TFEL_TESTS_ASSERT(
+        checkGenericParallelSymbols(MFRONT_GPMP_TEST_BACKEND_NAME));
+    return this->result;
+  }  // end of execute
+
+ private:
+  [[nodiscard]] static double fct(const double TK) noexcept {
+    const double TC = TK - 273.15;
+    return (-3.1636e-3 * TC * TC - 3.8654 * TC + 2.1421e+4) * 1e7;
+  }  // end of fct
+
+  //! \brief check that the evaluation succeeded at all points
+  void checkSuccess(const mfront_gpmp_OutputStatus& s, const int status) {
+    TFEL_TESTS_CHECK_EQUAL(status, 0);
+    TFEL_TESTS_CHECK_EQUAL(s.status, 0);
+    TFEL_TESTS_CHECK_EQUAL(s.number_of_failures, mfront_gmp_size_type{0});
+    TFEL_TESTS_CHECK_EQUAL(s.first_failure_index, no_index);
+    TFEL_TESTS_CHECK_EQUAL(s.number_of_unreliable_results,
+                           mfront_gmp_size_type{0});
+    TFEL_TESTS_CHECK_EQUAL(s.first_unreliable_result_index, no_index);
+    TFEL_TESTS_CHECK_EQUAL(s.bounds_status, 0);
+  }  // end of checkSuccess
+
+  // contiguous arrays
+  void test1() {
+    constexpr auto eps = double{1e-2};
+    auto output = mfront_gpmp_OutputStatus{};
+    auto output_qt = mfront_gpmp_OutputStatus{};
+    auto E = test_vector<double>(4);
+    auto E_qt = test_vector<double>(4);
+    const auto T = test_vector<double>{300, 500, 300, 800};
+    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
+    const auto args = std::array<const double*, 1u>{T.data()};
+    const auto r =
+        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 1,
+                 args, contiguous<1>(), 4, policy, testOptions());
+    const auto r_qt = evaluate(Inconel600_YoungModulus_qt_generic_parallel,
+                               output_qt, E_qt.data(), 1, args, contiguous<1>(),
+                               4, policy, testOptions());
+    this->checkSuccess(output, r);
+    this->checkSuccess(output_qt, r_qt);
+    for (std::size_t i = 0; i != E.size(); ++i) {
+      TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[i])) < eps);
+      TFEL_TESTS_ASSERT(std::abs(E_qt[i] - fct(T[i])) < eps);
+    }
+  }
+
+  // uniform argument
+  void test2() {
+    constexpr auto eps = double{1e-2};
+    auto output = mfront_gpmp_OutputStatus{};
+    auto output_qt = mfront_gpmp_OutputStatus{};
+    auto E = test_vector<double>(4);
+    auto E_qt = test_vector<double>(4);
+    const auto T = test_vector<double>{300};
+    const auto policy = mfront_gmp_OutOfBoundsPolicy{};
+    const auto args = std::array<const double*, 1u>{T.data()};
+    const auto strides = std::array<mfront_gmp_size_type, 1u>{0};
+    const auto r =
+        evaluate(Inconel600_YoungModulus_generic_parallel, output, E.data(), 1,
+                 args, strides, 4, policy, testOptions());
+    const auto r_qt =
+        evaluate(Inconel600_YoungModulus_qt_generic_parallel, output_qt,
+                 E_qt.data(), 1, args, strides, 4, policy, testOptions());
+    this->checkSuccess(output, r);
+    this->checkSuccess(output_qt, r_qt);
+    for (std::size_t i = 0; i != E.size(); ++i) {
+      TFEL_TESTS_ASSERT(std::abs(E[i] - fct(T[0])) < eps);
+      TFEL_TESTS_ASSERT(std::abs(E_qt[i] - fct(T[0])) < eps);
+    }
+  }
