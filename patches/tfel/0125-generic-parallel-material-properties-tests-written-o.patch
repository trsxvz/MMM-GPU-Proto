+// clang-format on
+
+#include MFRONT_GPMP_TEST_HEADER(UO2_YoungModulus_Martin1989)
+#include "batch.hxx"
+
+struct InvalidParametersTest : public tfel::tests::TestCase {
+  InvalidParametersTest()
+      : tfel::tests::TestCase("MFront/MaterialProperty/GenericParallel",
+                              "InvalidParametersTest") {
+  }  // end of InvalidParametersTest
+
+  tfel::tests::TestResult execute() override {
+    // the file of parameters is read at the first call of the function:
+    // no other call is made by this test
+    const auto file = std::string{"UO2_YoungModulus_Martin1989-parameters.txt"};
+    {
+      auto out = std::ofstream{file};
+      out << "f0 abc\n";
+    }
+    // nothing is computed: the output and the statuses of the points are
+    // not modified
+    const auto T = std::vector<double>{300, 500};
+    const auto f = std::vector<double>{0.1, 0.1};
+    auto E = std::vector<double>(2, 3);
+    auto statuses = std::vector<int>(2, 12);
+    const auto args = std::array<const double*, 2u>{T.data(), f.data()};
+    auto output = mfront_gpmp_OutputStatus{};
+    TFEL_TESTS_CHECK_EQUAL(
+        evaluate(UO2_YoungModulus_Martin1989_generic_parallel, output, E.data(),
+                 1, args, contiguous<2>(), 2, mfront_gmp_OutOfBoundsPolicy{},
+                 {}, statuses.data()),
+        -6);
+    TFEL_TESTS_CHECK_EQUAL(output.status, -6);
+    TFEL_TESTS_CHECK_EQUAL(output.number_of_failures, mfront_gmp_size_type{0});
+    TFEL_TESTS_ASSERT(std::string{output.msg}.find(
+                          "can't convert 'abc' to floating point value") !=
+                      std::string::npos);
+    for (std::size_t i = 0; i != E.size(); ++i) {
+      TFEL_TESTS_CHECK_EQUAL(E[i], 3.);
+      TFEL_TESTS_CHECK_EQUAL(statuses[i], 12);
+    }
+    std::remove(file.c_str());
+    return this->result;
+  }  // end of execute
+};
+
+TFEL_TESTS_GENERATE_PROXY(InvalidParametersTest, "InvalidParametersTest");
+
+/* coverity [UNCAUGHT_EXCEPT]*/
+int main(const int argc, const char* const* argv) {
+  if (argc != 2) {
+    std::cerr << "no test name given on the command line (argc: " << argc
+              << ")";
+    return EXIT_FAILURE;
+  }
+  auto& m = tfel::tests::TestManager::getTestManager();
+  m.addTestOutput(std::cout);
+  m.addXMLTestOutput(std::string{argv[1]} + ".xml");
+  return m.execute().success() ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
