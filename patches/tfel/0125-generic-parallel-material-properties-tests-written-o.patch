+          "too many points (" + std::to_string(n) + " given)");
+    check(f(&output, nullptr), "no batch data given");
+    auto d = mfront_gpmp_BatchData{
+        .number_of_points = 10,
+        .output = mfront_gpmp_Field{.values = E.data(), .point_stride = 1},
+        .arguments = nullptr,
+        .number_of_arguments = 1,
