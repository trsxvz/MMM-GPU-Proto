+
+#ifndef LIB_MFRONT_GENERICPARALLEL_MATERIALPROPERTY_TESTS_BATCH_HXX
+#define LIB_MFRONT_GENERICPARALLEL_MATERIALPROPERTY_TESTS_BATCH_HXX
+
+#include <array>
+#include <cstddef>
+#include "MFront/GenericParallelMaterialProperty/MaterialProperty.h"
+
+/*!
+ * \return the strides of `N` contiguous arguments
+ */
+template <std::size_t N>
+constexpr std::array<mfront_gmp_size_type, N> contiguous() noexcept {
+  auto s = std::array<mfront_gmp_size_type, N>{};
+  s.fill(1);
+  return s;
+}  // end of contiguous
+
+/*!
+ * \brief evaluate a material property on a batch of points
+ * \return the status returned by the function
+ * \param[in] f: function generated for the material property
+ * \param[out] s: output status
+ * \param[out] output: output values
+ * \param[in] output_stride: stride of the output
+ * \param[in] args: pointers to the values of the arguments
+ * \param[in] strides: strides of the arguments
+ * \param[in] n: number of points
+ * \param[in] p: out of bounds policy
+ * \param[in] o: execution options
+ * \param[out] statuses: statuses of the points, or null
+ * \param[in] nargs: number of arguments given to the function
+ */
+template <std::size_t N>
+int evaluate(const mfront_gpmp_BatchMaterialPropertyPtr f,
+             mfront_gpmp_OutputStatus& s,
+             mfront_gmp_real* const output,
+             const mfront_gmp_size_type output_stride,
+             const std::array<const mfront_gmp_real*, N>& args,
+             const std::array<mfront_gmp_size_type, N>& strides,
+             const mfront_gmp_size_type n,
+             const mfront_gmp_OutOfBoundsPolicy p,
+             const mfront_gpmp_ExecutionOptions& o = {},
+             int* const statuses = nullptr,
+             const mfront_gmp_size_type nargs = N) {
+  auto fields = std::array<mfront_gpmp_ConstField, N>{};
+  for (std::size_t i = 0; i != N; ++i) {
+    fields[i] =
+        mfront_gpmp_ConstField{.values = args[i], .point_stride = strides[i]};
+  }
+  const auto d = mfront_gpmp_BatchData{
+      .number_of_points = n,
+      .output =
+          mfront_gpmp_Field{.values = output, .point_stride = output_stride},
+      .arguments = (N == 0) ? nullptr : fields.data(),
+      .number_of_arguments = nargs,
+      .out_of_bounds_policy = p,
+      .statuses = statuses,
+      .execution = o};
+  return f(&s, &d);
+}  // end of evaluate
+
+#endif /* LIB_MFRONT_GENERICPARALLEL_MATERIALPROPERTY_TESTS_BATCH_HXX */
diff --git a/test-suite/material-properties/generic-parallel/build-libraries.sh b/test-suite/material-properties/generic-parallel/build-libraries.sh
new file mode 100644
index 000000000..64e04fe44
--- /dev/null
+++ b/test-suite/material-properties/generic-parallel/build-libraries.sh
@@ -0,0 +1,26 @@
+# Generation and compilation of the libraries compared by the tests of a
+# configuration (see compare.cxx), shared by the tests of all the
+# configurations.
+#
+# usage: sh ../build-libraries.sh mfront configuration_file
+#
+# The libraries of the `generic` and `generic-parallel` interfaces of the
+# test material properties are built in the current directory with the
+# configuration file of the tested configuration: both libraries are
+# compiled by the same compiler, with the same options.
+set -e
+mfront=$1
+configuration=$2
+case "$mfront" in
+  /*) ;;
+  */*) mfront=$PWD/$mfront ;;
+esac
+directory=$(cd "$(dirname "$0")" && pwd)
+files=""
+for m in PoissonRatioTest Inconel600_YoungModulus Inconel600_YoungModulus-qt \
+  UO2_YoungModulus_Martin1989 LinearDataInterpolationTest MaterialLawCallTest \
+  BoundsOrderTest; do
+  files="$files $directory/$m.mfront"
+done
+"$mfront" --obuild --search-path="$directory" --interface=generic \
+  --interface=generic-parallel --configuration-file="$configuration" $files
diff --git a/test-suite/material-properties/generic-parallel/build-no-runtime-checks.sh b/test-suite/material-properties/generic-parallel/build-no-runtime-checks.sh
new file mode 100644
index 000000000..0d89889d3
--- /dev/null
+++ b/test-suite/material-properties/generic-parallel/build-no-runtime-checks.sh
@@ -0,0 +1,50 @@
+# Generation and compilation of the `Inconel600_YoungModulus` material
+# property with the runtime checks disabled (`disable_runtime_checks` DSL
+# option), in the current directory, with the configuration file of the
+# tested configuration (see test-no-runtime-checks.cxx).
+#
+# usage: sh ../build-no-runtime-checks.sh mfront configuration_file
+#
+# Some configuration files set this option to `false`, which conflicts
+# with the option given on the command line: the material property is
+# then generated with a copy of the configuration file setting it to
+# `true`.
+set -e
+mfront=$1
+configuration=$2
+case "$mfront" in
+  /*) ;;
+  */*) mfront=$PWD/$mfront ;;
+esac
+# the configuration file is looked for in the current directory, then in
+# the configuration files installed with TFEL, as MFront does
+find_configuration() {
+  if [ -f "$1" ]; then
+    echo "$PWD/$1"
+    return
+  fi
+  prefix=$(cd "$(dirname "$(command -v "$mfront")")/.." && pwd)
+  for d in "$prefix"/share/tfel*/mfront/configuration-files; do
+    if [ -f "$d/$1" ]; then
+      echo "$d/$1"
+      return
+    fi
+  done
+  echo "configuration file '$1' not found" >&2
+  exit 1
+}
+configuration=$(find_configuration "$configuration")
+directory=$(cd "$(dirname "$0")" && pwd)
+file=$directory/Inconel600_YoungModulus.mfront
+if grep -q 'disable_runtime_checks' "$configuration"; then
+  sed 's/disable_runtime_checks: *false/disable_runtime_checks: true/' \
+    "$configuration" > no-runtime-checks.json
+  "$mfront" --interface=generic-parallel \
+    --configuration-file=no-runtime-checks.json "$file"
+else
+  cp "$configuration" no-runtime-checks.json
+  "$mfront" --interface=generic-parallel \
+    --dsl-option=disable_runtime_checks:true \
+    --configuration-file=no-runtime-checks.json "$file"
+fi
+"$mfront" --obuild --configuration-file=no-runtime-checks.json
