+
+  // order of the checks, as with the `generic` interface (bounds and
+  // physical bounds on both arguments and on the output of
+  // BoundsOrderTest, z = x - y): the first check making the evaluation fail
+  // is retained, otherwise the last bound violated with the warning policy
+  void test17() {
+    constexpr auto eps = double{1e-14};
+    const auto f = BoundsOrderTest_generic_parallel;
+    auto evaluate_points =
+        [this, f](const test_vector<double>& x, const test_vector<double>& y,
+                  test_vector<double>& z, test_vector<int>& statuses,
+                  const mfront_gmp_OutOfBoundsPolicy p) {
+          auto output = mfront_gpmp_OutputStatus{};
+          const auto args = std::array<const double*, 2u>{x.data(), y.data()};
+          const auto r = evaluate(f, output, z.data(), 1, args, contiguous<2>(),
+                                  x.size(), p, testOptions(), statuses.data());
+          TFEL_TESTS_CHECK_EQUAL(r, output.status);
+          return output;
+        };
+    // success, bounds of both arguments (rank 2 retained), bounds of the
+    // output (rank 3), physical bounds of the output (rank -3), physical
+    // bounds of the first argument (rank -1)
+    const auto x = test_vector<double>{0.5, 1.5, 0.9, 3, -2};
+    const auto y = test_vector<double>{0.5, 1.2, -0.5, 0, 1.5};
+    auto z = test_vector<double>(5);
+    auto statuses = test_vector<int>(5, 12);
+    const auto s = evaluate_points(x, y, z, statuses,
+                                   GENERIC_MATERIALPROPERTY_WARNING_POLICY);
+    TFEL_TESTS_CHECK_EQUAL(s.status, -1);
+    TFEL_TESTS_CHECK_EQUAL(s.bounds_status, -3);
+    TFEL_TESTS_CHECK_EQUAL(s.number_of_failures, mfront_gmp_size_type{2});
+    TFEL_TESTS_CHECK_EQUAL(s.first_failure_index, mfront_gmp_size_type{3});
+    TFEL_TESTS_CHECK_EQUAL(s.number_of_unreliable_results,
+                           mfront_gmp_size_type{2});
+    TFEL_TESTS_CHECK_EQUAL(s.first_unreliable_result_index,
+                           mfront_gmp_size_type{1});
+    const auto expected_statuses = std::array<int, 5u>{0, 1, 1, -1, -1};
+    for (std::size_t i = 0; i != 5; ++i) {
+      TFEL_TESTS_CHECK_EQUAL(statuses[i], expected_statuses[i]);
+      if (expected_statuses[i] < 0) {
+        TFEL_TESTS_ASSERT(std::isnan(z[i]));
+      } else {
+        TFEL_TESTS_ASSERT(std::abs(z[i] - (x[i] - y[i])) < eps);
+      }
+    }
+    // the last bound violated with the warning policy is retained: the
+    // second argument, then the output
+    for (const auto& [xv, yv, rank] :
+         {std::tuple{1.5, 1.2, 2}, std::tuple{0.9, -0.5, 3}}) {
+      const auto x1 = test_vector<double>{xv};
+      const auto y1 = test_vector<double>{yv};
+      auto z1 = test_vector<double>(1);
+      auto s1 = test_vector<int>(1, 12);
+      const auto o = evaluate_points(x1, y1, z1, s1,
+                                     GENERIC_MATERIALPROPERTY_WARNING_POLICY);
+      TFEL_TESTS_CHECK_EQUAL(o.status, 1);
+      TFEL_TESTS_CHECK_EQUAL(o.bounds_status, rank);
+      TFEL_TESTS_CHECK_EQUAL(s1[0], 1);
+    }
+    // with the strict policy, the first violated bound ends the evaluation
+    const auto x2 = test_vector<double>{0.9};
+    const auto y2 = test_vector<double>{-0.5};
+    auto z2 = test_vector<double>(1);
+    auto s2 = test_vector<int>(1, 12);
+    const auto o2 =
+        evaluate_points(x2, y2, z2, s2, GENERIC_MATERIALPROPERTY_STRICT_POLICY);
+    TFEL_TESTS_CHECK_EQUAL(o2.status, -1);
+    TFEL_TESTS_CHECK_EQUAL(o2.bounds_status, -2);
+    TFEL_TESTS_ASSERT(std::isnan(z2[0]));
+  }
+
+  /*!
+   * \brief evaluate a material property depending on the temperature at four
+   * points and compare the results to reference values
+   * \param[in] mp: material property
+   * \param[in] T_values: temperatures
+   * \param[in] references: reference values
+   */
+  void checkTemperatureDependentMaterialProperty(
+      const mfront_gpmp_BatchMaterialPropertyPtr mp,
+      const std::array<double, 4u>& T_values,
+      const std::array<double, 4u>& references) {
+    constexpr auto eps = double{1e-2};
+    auto output = mfront_gpmp_OutputStatus{};
+    auto v = test_vector<double>(T_values.size());
+    const auto T = test_vector<double>(T_values.begin(), T_values.end());
+    const auto args = std::array<const double*, 1u>{T.data()};
+    const auto r =
+        evaluate(mp, output, v.data(), 1, args, contiguous<1>(), T.size(),
+                 mfront_gmp_OutOfBoundsPolicy{}, testOptions());
+    this->checkSuccess(output, r);
+    for (std::size_t i = 0; i != v.size(); ++i) {
+      TFEL_TESTS_ASSERT(std::abs(v[i] - references[i]) < eps);
+    }
+  }
+};
