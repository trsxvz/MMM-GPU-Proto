diff --git a/include/TFEL/Config/TFELConfig.hxx b/include/TFEL/Config/TFELConfig.hxx
index c1361b7ed..04c97da35 100644
--- a/include/TFEL/Config/TFELConfig.hxx
+++ b/include/TFEL/Config/TFELConfig.hxx
@@ -364,4 +364,63 @@
 
 #define TFEL_HOST_DEVICE TFEL_DEVICE TFEL_HOST
 
+/*!
+ * \brief `TFEL_DEVICE_CODE` is defined when the code being compiled is device
+ * code, i.e. during the device compilation pass of `CUDA` and `HIP` sources
+ * and during the device compilation of `SYCL` sources.
+ *
+ * This macro allows to select code that can't be executed on the device,
+ * for instance when throwing an exception, while keeping the same behaviour
+ * on the host.
+ *
+ * Some compilers translate host and device code in a single pass: in this
+ * case, the device code is selected in the whole translation unit. This is
+ * the case of `nvc++ -stdpar=gpu`, `nvc++ -mp=gpu` and `nvc++ -acc=gpu`,
+ * which may offload any function called by a parallel algorithm of the
+ * standard library, in an OpenMP `target` region or in an OpenACC compute
+ * construct, and of the generic compiler of AdaptiveCpp (`SSCP`), which
+ * generates device code at runtime.
+ */
+#if (defined __CUDA_ARCH__) || (defined __HIP_DEVICE_COMPILE__) ||         \
+    (defined __SYCL_DEVICE_ONLY__) || (defined __NVCOMPILER_STDPAR_GPU) || \
+    (defined __NVCOMPILER_OPENMP_GPU) ||                                   \
+    (defined __NVCOMPILER_OPENACC_GPU) ||                                  \
+    (defined __ACPP_ENABLE_LLVM_SSCP_TARGET__)
+#ifndef TFEL_DEVICE_CODE
+#define TFEL_DEVICE_CODE 1
+#endif /* TFEL_DEVICE_CODE */
+#endif
+
+/*!
+ * \brief `TFEL_STATIC_VARIABLE(v)` gives the value of a constexpr static
+ * variable `v` in code which may be compiled as device code, such as the
+ * code blocks of the behaviours generated by `MFront`.
+ *
+ * Device code can't refer to a constexpr static variable defined in host
+ * code, which is the case when the variable is given to a function or an
+ * operator taking a reference in an expression evaluated at run time, for
+ * instance `T - Tref` for a static temperature `Tref` of a behaviour using
+ * quantities. In device code, this macro gives a temporary copy initialised
+ * by a constant expression, `(decltype(v){v})`, which can be used. In host
+ * code, it gives the variable itself.
+ *
+ * As `TFEL_DEVICE_CODE`, the copy is used in the whole translation unit by
+ * the compilers translating host and device code in a single pass (`nvc++
+ * -stdpar=gpu`, `nvc++ -mp=gpu`, `nvc++ -acc=gpu`, AdaptiveCpp's generic
+ * compiler). A reference bound to the copy is only valid until the end of
+ * the full expression, and the address of the copy can't be taken. The type
+ * of the copy is not const qualified for scalar types, but it is const
+ * qualified for class types, such as quantities.
+ */
+#ifdef TFEL_DEVICE_CODE
+#define TFEL_STATIC_VARIABLE(v) (decltype(v){v})
+#else /* TFEL_DEVICE_CODE */
+#define TFEL_STATIC_VARIABLE(v) v
+#endif /* TFEL_DEVICE_CODE */
+
+// contract violations are not reported in device code
+#if (defined TFEL_DEVICE_CODE) && (!defined TFEL_NO_REPORT_CONTRACT_VIOLATION)
+#define TFEL_NO_REPORT_CONTRACT_VIOLATION 1
+#endif
+
 #endif /* LIB_TFEL_CONFIG_HXX */
