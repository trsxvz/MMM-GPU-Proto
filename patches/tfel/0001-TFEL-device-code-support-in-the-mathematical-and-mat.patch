+
+def stensor(name, N):
+    """symmetric tensor of TFEL"""
+    r = T2.null()
+    for i, j in stensor_components(N):
+        v = Poly.atom(f"{name}[{stensor_index(N, i, j)}]")
+        r.m[i][j] = v if i == j else v * ISQRT2
+        r.m[j][i] = r.m[i][j]
+    return r
