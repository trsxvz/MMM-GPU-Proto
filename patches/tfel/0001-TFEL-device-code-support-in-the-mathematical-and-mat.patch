index 000000000..5adaa0ea7
--- /dev/null
+++ b/tools/FiniteStrainBehaviourTangentOperatorConverters/generate.py
@@ -0,0 +1,246 @@
+"""Generates the explicit code of the conversions of the finite strain
+tangent operators (structures `<source>_to_<target>_Converter` of
+include/TFEL/Material/FiniteStrainBehaviourTangentOperatorConverters.ixx).
+
+The conversions are described in conversions.py as the composition of
+elementary relations between the strain measures and between the stress
+measures. The code generated is explicit (no loop, constant indices) and
+computes the result column by column.
+
+usage:
+  generate.py                    writes the header on the standard output
+  generate.py --statistics       number of multiplications and of local
+                                 variables of each conversion
+  generate.py <source> <target>  code of one conversion
+"""
+import os
+import subprocess
+import sys
+
+from conversions import OPERATORS, Conversion
+
+# conversions generated (source, target)
+CONVERSIONS = [
+    ("DSIG_DF", "DSIG_DDF"),
+    ("DSIG_DF", "DTAU_DDF"),
+    ("DSIG_DF", "DPK1_DF"),
+    ("DSIG_DF", "DS_DEGL"),
+    ("DSIG_DF", "ABAQUS"),
+    ("DSIG_DF", "C_TRUESDELL"),
+    ("DSIG_DDF", "DSIG_DF"),
+    ("DTAU_DF", "DTAU_DDF"),
+    ("DTAU_DF", "DS_DEGL"),
+    ("DTAU_DF", "SPATIAL_MODULI"),
+    ("DTAU_DF", "C_TRUESDELL"),
+    ("DTAU_DF", "ABAQUS"),
+    ("DTAU_DDF", "DTAU_DF"),
+    ("DTAU_DDF", "DSIG_DF"),
+    ("DTAU_DDF", "DS_DEGL"),
+    ("DTAU_DDF", "ABAQUS"),
+    ("DTAU_DDF", "C_TRUESDELL"),
+    ("DS_DC", "DS_DF"),
+    ("DS_DC", "DSIG_DF"),
+    ("DS_DC", "DTAU_DDF"),
+    ("DS_DC", "DPK1_DF"),
+    ("DS_DC", "ABAQUS"),
+    ("DS_DC", "C_TRUESDELL"),
+    ("DS_DEGL", "DS_DF"),
+    ("DS_DEGL", "DSIG_DF"),
+    ("DS_DEGL", "DTAU_DDF"),
+    ("DS_DEGL", "DPK1_DF"),
+    ("DS_DEGL", "SPATIAL_MODULI"),
+    ("DS_DEGL", "ABAQUS"),
+    ("DS_DEGL", "C_TRUESDELL"),
+    ("SPATIAL_MODULI", "DTAU_DF"),
+    ("SPATIAL_MODULI", "DTAU_DDF"),
+    ("SPATIAL_MODULI", "DSIG_DF"),
+    ("SPATIAL_MODULI", "DPK1_DF"),
+    ("SPATIAL_MODULI", "DS_DEGL"),
+    ("C_TRUESDELL", "DSIG_DF"),
+    ("C_TAU_JAUMANN", "DTAU_DF"),
+    ("ABAQUS", "DTAU_DF"),
+    ("ABAQUS", "DSIG_DF"),
+]
+
+# clang-format style of TFEL
+STYLE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..",
+                     ".clang-format")
+
+STRAIN_NAMES = {
+    "F": "deformation gradient",
+    "dF": "deformation gradient increment "
+          "\\f$\\Delta\\,F=F\\,F_{0}^{-1}\\f$",
+    "E": "Green-Lagrange strain",
+    "C": "right Cauchy-Green tensor",
+    "d": "rate of deformation",
+}
+
+# variation of the strain measures, as a function of the variation of the
+# deformation gradient
+STRAIN_VARIATIONS = {
+    "F": "\\delta\\,F",
+    "dF": "\\delta\\,\\Delta\\,F=\\delta\\,F\\,F_{0}^{-1}",
+    "E": "\\delta\\,E=\\mathrm{sym}\\left(F^{T}\\,\\delta\\,F\\right)",
+    "C": "\\delta\\,C=2\\,\\mathrm{sym}\\left(F^{T}\\,\\delta\\,F\\right)",
+    "d": "d=\\mathrm{sym}\\left(l\\right)",
+}
+
+# variation of the stress measures, as a function of the variation of the
+# Kirchhoff stress
+STRESS_VARIATIONS = {
+    "tau": "\\delta\\,\\tau",
+    "sig": "\\delta\\,\\sigma=\\frac{1}{J}\\,\\delta\\,\\tau-"
+           "\\mathrm{tr}\\left(l\\right)\\,\\sigma",
+    "S": "\\delta\\,S=F^{-1}\\,\\left(\\delta\\,\\tau-l\\,\\tau-"
+         "\\tau\\,l^{T}\\right)\\,F^{-T}",
+    "P": "\\delta\\,P=\\left(\\delta\\,\\tau-\\tau\\,l^{T}\\right)\\,F^{-T}",
+    "lie": "\\delta\\,\\tau-l\\,\\tau-\\tau\\,l^{T}",
+    "lieJ": "\\frac{1}{J}\\,\\left(\\delta\\,\\tau-l\\,\\tau-"
+            "\\tau\\,l^{T}\\right)",
+    "jau": "\\delta\\,\\tau-w\\,\\tau+\\tau\\,w",
+    "jauJ": "\\frac{1}{J}\\,\\left(\\delta\\,\\tau-w\\,\\tau+"
+            "\\tau\\,w\\right)",
+}
+
+DIMENSIONS = {1: "1D", 2: "2D", 3: "3D"}
+
+
+def wrap(text, prefix, width=78):
+    """wraps a text in a comment"""
+    lines = []
+    line = prefix
+    for word in text.split():
+        if len(line) + 1 + len(word) > width and line != prefix:
+            lines.append(line)
+            line = prefix
+        line += (" " if line != prefix or prefix.endswith("*") else "") + word
+    lines.append(line)
+    return "\n".join(l.rstrip() for l in lines)
+
+
+def structure_name(source, target):
+    return f"{source}_to_{target}_Converter"
+
+
+def specialisation(source, target, N):
+    """partial specialisation of the conversion structure"""
+    c = Conversion(source, target, N)
+    A, B = OPERATORS[source], OPERATORS[target]
+    args = c.arguments()
+    docs = {
+        "F0": "\\param[in] F0: deformation gradient at the beginning of the "
+              "time step",
+        "F": "\\param[in] F: deformation gradient at the end of the time "
+             "step",
+        "s": "\\param[in] s: Cauchy stress",
+    }
+    types = {"F0": f"const tfel::math::tensor<{N}u, real>& F0",
+             "F": f"const tfel::math::tensor<{N}u, real>& F",
+             "s": f"const tfel::math::stensor<{N}u, stress>& s"}
+    parameters = [f"tfel::math::{B.kind}<{N}u, stress>& Kr",
+                  f"const tfel::math::{A.kind}<{N}u, stress>& Ks"] + \
+        [types[a] for a in args]
+    doc = ["\\tparam stress: stress type", "\\tparam real: numeric type",
+           f"\\param[out] Kr: {B.description}",
+           f"\\param[in] Ks: {A.description}"] + [docs[a] for a in args]
+    out = [f"/*!\n * \\brief partial specialisation in {DIMENSIONS[N]}\n */",
+           "template <>",
+           f"struct {structure_name(source, target)}<{N}u> {{",
+           "/*!"] + [wrap(d, " *") for d in doc] + [" */"]
+    out += ["template <typename stress, typename real>",
+            "TFEL_HOST_DEVICE static constexpr void exe(" +
+            ", ".join(parameters) + ") noexcept {"]
+    out += c.body()
+    out += ["}", f"}};  // end of struct {structure_name(source, target)}"
+            f"<{N}u>", ""]
+    return "\n".join(out)
+
+
+def structure(source, target):
+    """declaration and partial specialisations of the conversion structure"""
+    A, B = OPERATORS[source], OPERATORS[target]
+    brief = (f"\\brief an helper structure meant to be specialized in each "
+             f"spatial dimension, converting the {A.description} "
+             f"({source}) to the {B.description} ({target}).")
+    relations = [STRAIN_VARIATIONS[A.strain], STRESS_VARIATIONS[A.stress]]
+    target_relations = [STRAIN_VARIATIONS[B.strain],
+                        STRESS_VARIATIONS[B.stress]]
+    text = (f"The result is computed column by column, i.e. component by "
+            f"component of the {STRAIN_NAMES[B.strain]}. Let "
+            f"\\f$\\delta\\,F\\f$ be the variation of the deformation "
+            f"gradient associated with this component, "
+            f"\\f$l=\\delta\\,F\\,F^{{-1}}\\f$, \\f$w\\f$ the skew part of "
+            f"\\f$l\\f$ and \\f$\\delta\\,\\tau\\f$ the variation of the "
+            f"Kirchhoff stress. {source} relates")
+    out = ["/*!", wrap(brief, " *"), wrap(text, " *"),
+           " * \\f[", wrap(relations[1], " *"), " * \\quad\\mathrm{to}\\quad",
+           wrap(relations[0], " *"), " * \\f]",
+           wrap(f"and {target} relates", " *"),
+           " * \\f[", wrap(target_relations[1], " *"),
+           " * \\quad\\mathrm{to}\\quad",
+           wrap(target_relations[0], " *"), " * \\f]",
+           wrap("so that no intermediate tangent operator is stored.", " *"),
+           " * \\tparam N: spatial dimension", " */",
+           "template <unsigned short N>",
+           f"struct {structure_name(source, target)};", ""]
+    return "\n".join(out) + "\n" + "\n".join(
+        specialisation(source, target, N) for N in (1, 2, 3))
+
+
+def clang_format(text):
+    return subprocess.run(["clang-format", f"--style=file:{STYLE}"],
+                          input=text, capture_output=True, text=True,
+                          check=True).stdout
+
+
+def header():
+    """content of the header"""
+    guard = ("LIB_TFEL_MATERIAL_FINITESTRAINBEHAVIOURTANGENTOPERATOR"
+             "CONVERTERS_IXX")
+    namespace = "tfel::material::internals"
+    out = ["""/*!
+ * \\file   FiniteStrainBehaviourTangentOperatorConverters.ixx
+ * \\brief  conversions of the finite strain tangent operators computed
+ * column by column. This file is generated by the script
+ * tools/FiniteStrainBehaviourTangentOperatorConverters/generate.py.
+ * \\date   22/11/2026
+ * \\copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+""", f"#ifndef {guard}\n#define {guard}\n",
+           """#include "TFEL/Math/General/MathConstants.hxx"
+#include "TFEL/Math/tensor.hxx"
+#include "TFEL/Math/stensor.hxx"
+#include "TFEL/Math/t2tot2.hxx"
+#include "TFEL/Math/t2tost2.hxx"
+#include "TFEL/Math/st2tost2.hxx"
+""", f"namespace {namespace} {{\n"]
+    for source, target in CONVERSIONS:
+        out.append(structure(source, target))
+    out.append(f"}}  // end of namespace {namespace}\n")
+    out.append(f"#endif /* {guard} */")
+    return clang_format("\n".join(out) + "\n")
+
+
+def statistics():
+    print(f"{'conversion':34s} {'1D':>10s} {'2D':>10s} {'3D':>10s}"
+          "   (multiplications / local variables per column)")
+    for source, target in CONVERSIONS:
+        r = [Conversion(source, target, N).operations() for N in (1, 2, 3)]
+        print(f"{source + ' -> ' + target:34s} " +
+              " ".join(f"{m:>6d}/{v:<3d}" for m, v in r))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 1:
+        print(header(), end="")
+    elif sys.argv[1:] == ["--statistics"]:
+        statistics()
+    elif len(sys.argv) == 3:
+        print(clang_format(structure(sys.argv[1], sys.argv[2])), end="")
+    else:
+        sys.exit(__doc__)
diff --git a/tools/FiniteStrainBehaviourTangentOperatorConverters/symbolic.py b/tools/FiniteStrainBehaviourTangentOperatorConverters/symbolic.py
new file mode 100644
index 000000000..d2542f5ac
--- /dev/null
+++ b/tools/FiniteStrainBehaviourTangentOperatorConverters/symbolic.py
@@ -0,0 +1,365 @@
+"""Small symbolic layer used to generate the explicit code of the
+conversions of the finite strain tangent operators.
+
+A second order tensor (`T2`) is a 3x3 array of polynomials (`Poly`) of
+atoms, an atom being a piece of C++ code (a component of a tensor of TFEL,
+a local variable). The coefficients of the polynomials are numbers of the
+form a + b sqrt(2) (`Coef`), which is what the storage of the symmetric
+tensors of TFEL requires. Components which do not exist in the space
+dimension considered are null polynomials, so that the usual tensor
+algebra (products, transposition, symmetric part...) directly gives the
+sums restricted to the existing components.
+"""
+import re
+from fractions import Fraction
+
+# atoms which are factorised as scalar factors when writing a polynomial
+SCALARS = ("J", "iJ")
+
+
+def tensor_index(N, i, j):
+    """index of the component (i, j) of a tensor, None if it does not exist
+    in this space dimension"""
+    t = [[0, 3, 5], [4, 1, 7], [6, 8, 2]][i][j]
+    return t if t < {1: 3, 2: 5, 3: 9}[N] else None
+
+
+def stensor_index(N, i, j):
+    """index of the component (i, j) of a symmetric tensor"""
+    t = [[0, 3, 4], [3, 1, 5], [4, 5, 2]][i][j]
+    return t if t < {1: 3, 2: 4, 3: 6}[N] else None
+
+
+def tensor_components(N):
+    """components (i, j) of a tensor, in the order of their storage"""
+    c = [(i, j) for i in range(3) for j in range(3)
+         if tensor_index(N, i, j) is not None]
+    return sorted(c, key=lambda ij: tensor_index(N, *ij))
+
+
+def stensor_components(N):
+    """components (i, j), i <= j, of a symmetric tensor, in the order of
+    their storage"""
+    c = [(i, j) for i in range(3) for j in range(i, 3)
+         if stensor_index(N, i, j) is not None]
+    return sorted(c, key=lambda ij: stensor_index(N, *ij))
+
+
+class Coef:
+    """number of the form a + b sqrt(2), a and b being rational"""
+    __slots__ = ("a", "b")
+
+    def __init__(self, a=0, b=0):
+        self.a = Fraction(a)
+        self.b = Fraction(b)
+
+    def __add__(self, o):
+        return Coef(self.a + o.a, self.b + o.b)
+
+    def __mul__(self, o):
+        return Coef(self.a * o.a + 2 * self.b * o.b,
+                    self.a * o.b + self.b * o.a)
+
+    def __neg__(self):
+        return Coef(-self.a, -self.b)
+
+    def __eq__(self, o):
+        return self.a == o.a and self.b == o.b
+
+    def is_null(self):
+        return self.a == 0 and self.b == 0
+
+    def split(self):
+        """(sign, q, k) such that the coefficient is sign * q * sqrt(2)^k"""
+        if self.a != 0 and self.b != 0:
+            raise ValueError("unsupported coefficient")
+        q, k = (self.b, 1) if self.a == 0 else (self.a, 0)
+        return (-1 if q < 0 else 1), abs(q), k
+
+
+ONE = Coef(1)
+SQRT2 = Coef(0, 1)
+ISQRT2 = Coef(0, Fraction(1, 2))
+
+
+def as_coef(c):
+    return c if isinstance(c, Coef) else Coef(c)
+
+
+class Poly:
+    """polynomial of atoms"""
+    __slots__ = ("t",)
+
+    def __init__(self, terms=None):
+        self.t = {m: c for m, c in (terms or {}).items() if not c.is_null()}
+
+    @staticmethod
+    def atom(name):
+        return Poly({(name,): ONE})
+
+    def is_null(self):
+        return not self.t
+
+    def is_atomic(self):
+        """null, or a single monomial made of at most one atom"""
+        return len(self.t) <= 1 and all(len(m) <= 1 for m in self.t)
+
+    def scaling(self):
+        """(q, k) if the polynomial is an atom multiplied by a coefficient
+        q * sqrt(2)^k other than 1 and -1, None otherwise"""
+        if len(self.t) != 1:
+            return None
+        (m, c), = self.t.items()
+        _, q, k = c.split()
+        return None if len(m) != 1 or (q, k) == (1, 0) else (q, k)
+
+    def __add__(self, o):
+        r = dict(self.t)
+        for m, c in o.t.items():
+            r[m] = r[m] + c if m in r else c
+        return Poly(r)
+
+    def __neg__(self):
+        return Poly({m: -c for m, c in self.t.items()})
+
+    def __sub__(self, o):
+        return self + (-o)
+
+    def __mul__(self, o):
+        if isinstance(o, T2):
+            return NotImplemented
+        if not isinstance(o, Poly):
+            o = as_coef(o)
+            return Poly({m: c * o for m, c in self.t.items()})
+        r = {}
+        for m1, c1 in self.t.items():
+            for m2, c2 in o.t.items():
+                m = tuple(sorted(m1 + m2))
+                c = c1 * c2
+                r[m] = r[m] + c if m in r else c
+        return Poly(r)
+
+    __rmul__ = __mul__
+
+
+
+def _factor(q, k):
+    """C++ factors (prefix, suffix) of the positive coefficient
+    q * sqrt(2)^k"""
+    name = ""
+    if k == 1:
+        # q sqrt(2) = (2 q) / sqrt(2)
+        if q.denominator % 2 == 0:
+            name, q = "icste", 2 * q
+        else:
+            name = "cste"
+    prefix = [str(q.numerator)] if q.numerator != 1 else []
+    if name:
+        prefix.append(name)
+    suffix = f" / {q.denominator}" if q.denominator != 1 else ""
+    return prefix, suffix
+
+
+def _atom_key(a):
+    # the components of the tangent operator converted first, then the
+    # local variables of the columns, then the other quantities
+    if a.startswith("Ks("):
+        return (0, a)
+    return (1 if re.fullmatch(r"[a-z]\d+", a) else 2, a)
+
+
+def code(p):
+    """C++ expression of a polynomial. The monomials sharing the same
+    scalar factors (J, 1 / J), then the same coefficient, are grouped."""
+    if p.is_null():
+        raise ValueError("null polynomial")
+    monomials = []
+    for m, c in p.t.items():
+        scalars = tuple(a for a in m if a in SCALARS)
+        atoms = sorted((a for a in m if a not in SCALARS), key=_atom_key)
+        monomials.append((scalars, atoms, c))
+    monomials.sort(key=lambda m: (min([_atom_key(a)[0] for a in m[1]],
+                                      default=3),
+                                  [_atom_key(a) for a in m[1]]))
+    groups = {}
+    for scalars, atoms, c in monomials:
+        groups.setdefault(scalars, []).append((atoms, c))
+    terms = []  # (sign, text)
+    for scalars, ms in groups.items():
+        inner = _coefficient_groups(ms)
+        if not scalars:
+            terms += inner
+        elif len(inner) == 1:
+            sign, text = inner[0]
+            terms.append((sign, " * ".join(
+                list(scalars) + ([text] if text != "1" else []))))
+        else:
+            sign = inner[0][0]
+            text = _join([(s * sign, t) for s, t in inner])
+            terms.append((sign, " * ".join(list(scalars) + [f"({text})"])))
+    return _join(terms)
+
+
+def _coefficient_groups(monomials):
+    """terms (sign, text) of a list of monomials (atoms, coefficient), the
+    monomials sharing the same coefficient being grouped"""
+    groups = {}
+    for atoms, c in monomials:
+        sign, q, k = c.split()
+        groups.setdefault((q, k), []).append((sign, atoms))
+    terms = []
+    for (q, k), ms in groups.items():
+        prefix, suffix = _factor(q, k)
+        if not prefix and not suffix:
+            for sign, atoms in ms:
+                terms.append((sign, " * ".join(atoms) if atoms else "1"))
+            continue
+        # the sign of the group is the one of its first monomial
+        sign = ms[0][0]
+        if len(ms) == 1:
+            atoms = ms[0][1]
+            text = " * ".join(prefix + atoms) if (prefix or atoms) else "1"
+        else:
+            inner = _join([(s * sign, " * ".join(a) if a else "1")
+                           for s, a in ms])
+            text = " * ".join(prefix + [f"({inner})"])
+        terms.append((sign, text + suffix))
+    return terms
+
+
+def _join(terms):
+    r = ""
+    for i, (sign, text) in enumerate(terms):
+        if i == 0:
+            r = text if sign > 0 else f"-{text}"
+        else:
+            r += f" + {text}" if sign > 0 else f" - {text}"
+    return r
+
+
+class T2:
+    """second order tensor: 3x3 array of polynomials"""
+
+    def __init__(self, m):
+        self.m = m
+
+    @staticmethod
+    def null():
+        return T2([[Poly() for _ in range(3)] for _ in range(3)])
+
+    def __getitem__(self, ij):
+        return self.m[ij[0]][ij[1]]
+
+    def __matmul__(self, o):
+        r = T2.null()
+        for i in range(3):
+            for j in range(3):
+                v = Poly()
+                for k in range(3):
