+/*!
+ * \return a symbol of a library: the symbol specific to the modelling
+ * hypothesis if it exists, the symbol of the behaviour otherwise, or null
+ * \param[in] lib: library
+ * \param[in] f: tested function
+ * \param[in] n: name of the symbol, without the name of the behaviour
+ */
+static const void* findSymbol(const std::string& lib,
+                              const FunctionName& f,
+                              const std::string& n) {
+  auto* const l = dlopen(lib.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (l == nullptr) {
+    fail(dlerror());
+  }
+  for (const auto& s :
+       {f.behaviour + "_" + f.hypothesis + "_" + n, f.behaviour + "_" + n}) {
+    if (const auto* const p = dlsym(l, s.c_str()); p != nullptr) {
+      return p;
+    }
+  }
+  return nullptr;
+}
