+/*!
+ * \return the size of a variable
+ * \param[in] type: type of the variable, encoded as described by the
+ * `SupportedTypes::getTypeIdentifier` method of `MFront`
+ * \param[in] h: modelling hypothesis
+ */
+static std::size_t getVariableSize(const int type, const std::string& h) {
+  // space dimension: given by the type or by the modelling hypothesis
+  const auto d = [&] {
+    if (((type >> 3) & 3) != 0) {
+      return (type >> 3) & 3;
+    }
+    if (h == "Tridimensional") {
+      return 3;
+    }
+    return h.starts_with("AxisymmetricalGeneralised") ? 1 : 2;
+  }();
+  switch (type & 7) {
+    case 0:
+      return 1;
+    case 1:
+      return d == 1 ? 3 : (d == 2 ? 4 : 6);
+    case 2:
+      return static_cast<std::size_t>(d);
+    case 3:
+      return d == 1 ? 3 : (d == 2 ? 5 : 9);
+  }
+  fail("unsupported type of variable");
+}
