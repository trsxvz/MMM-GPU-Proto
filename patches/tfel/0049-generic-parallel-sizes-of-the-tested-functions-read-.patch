+/*!
+ * \return the variables of a group (gradients, internal state variables,
+ * etc.), described by the symbols exported by a library
+ * \param[in] lib: library
+ * \param[in] f: tested function
+ * \param[in] g: name of the group (for instance `InternalStateVariables`)
+ */
+static std::vector<Variable> getVariables(const std::string& lib,
+                                          const FunctionName& f,
+                                          const std::string& g) {
+  const auto* const n =
+      static_cast<const unsigned short*>(findSymbol(lib, f, "n" + g));
+  if (n == nullptr) {
+    fail("no symbol giving the number of variables of '" + g + "'");
+  }
+  auto r = std::vector<Variable>{};
+  if (*n == 0) {
+    return r;
+  }
+  const auto* const names =
+      static_cast<const char* const*>(findSymbol(lib, f, g));
+  // the material properties are scalars and have no type
+  const auto* const types =
+      static_cast<const int*>(findSymbol(lib, f, g + "Types"));
+  for (unsigned short i = 0; i != *n; ++i) {
+    r.push_back({.name = names[i],
+                 .size = types == nullptr
+                             ? 1
+                             : getVariableSize(types[i], f.hypothesis)});
+  }
+  return r;
+}
+
+//! \return the sum of the sizes of the given variables
+static std::size_t getSize(const std::vector<Variable>& variables) {
+  auto s = std::size_t{};
+  for (const auto& v : variables) {
+    s += v.size;
+  }
+  return s;
+}
