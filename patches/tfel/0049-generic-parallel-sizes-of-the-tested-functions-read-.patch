+/*!
+ * \return the function tested and the number of values of its inputs or
+ * outputs (inputs of an initialize function, outputs of a post-processing,
+ * rotated values), deduced from its name and from the symbols exported by
+ * the library generated by the `generic` interface
+ * \param[in] lib: library generated by the `generic` interface
+ * \param[in] f: tested function
+ * \param[in] fs: finite strain options
+ */
+static std::pair<Mode, std::size_t> getMode(const std::string& lib,
+                                            const FunctionName& f,
+                                            const FiniteStrainOptions& fs) {
+  const auto& e = f.suffix;
+  if (e.empty()) {
+    return {Mode::INTEGRATION, 0};
+  }
+  if (e.starts_with("InitializeFunction_")) {
+    return {Mode::INITIALIZE_FUNCTION,
+            getSize(getVariables(lib, f, e + "_Inputs"))};
+  }
+  if (e.starts_with("PostProcessing_")) {
+    return {Mode::POST_PROCESSING,
+            getSize(getVariables(lib, f, e + "_Outputs"))};
+  }
+  // rotation functions: the stress measure or the tangent operator of
+  // finite strain behaviours is given by the end of the name
+  auto o = fs;
+  const auto p = e.find('_');
+  const auto kind = e.substr(0, p);
+  const auto variant = p == std::string::npos ? "" : e.substr(p + 1);
+  const auto stress_measures =
+      std::array<std::string, 3>{"CauchyStress", "PK2Stress", "PK1Stress"};
+  const auto tangent_operators =
+      std::array<std::string, 4>{"dsig_dF", "dPK2_dEGL", "dPK1_dF", "dtau_ddF"};
+  for (std::size_t i = 0; i != stress_measures.size(); ++i) {
+    if (variant == stress_measures[i]) {
+      o.stress_measure = static_cast<double>(i);
+    }
+  }
+  for (std::size_t i = 0; i != tangent_operators.size(); ++i) {
+    if (variant == tangent_operators[i]) {
+      o.tangent_operator = static_cast<double>(i);
+    }
+  }
+  const auto s = readSizes(lib, f, o);
+  if (kind == "rotateGradients") {
+    return {Mode::ROTATION, s.g};
+  } else if (kind == "rotateThermodynamicForces") {
+    return {Mode::ROTATION, s.th};
+  } else if (kind == "rotateTangentOperatorBlocks") {
+    return {Mode::ROTATION, s.K};
+  }
+  fail("unsupported function '" + e + "'");
+}
