+/*!
+ * \return the sizes of the data of a point, as seen by the `generic`
+ * interface, read in the symbols exported by a library
+ * \param[in] lib: library generated by the `generic` interface
+ * \param[in] f: tested function
+ * \param[in] fs: finite strain options
+ */
+static Sizes readSizes(const std::string& lib,
+                       const FunctionName& f,
+                       const FiniteStrainOptions& fs) {
+  const auto g = getVariables(lib, f, "Gradients");
+  const auto th = getVariables(lib, f, "ThermodynamicForces");
+  const auto isvs = getVariables(lib, f, "InternalStateVariables");
+  const auto esvs = getVariables(lib, f, "ExternalStateVariables");
+  // the temperature is the first external state variable
+  auto s = Sizes{.g = getSize(g),
+                 .th = getSize(th),
+                 .mp = getVariables(lib, f, "MaterialProperties").size(),
+                 .isv = getSize(isvs),
+                 .esv = 1 + getSize(esvs),
+                 .K = 0};
+  // the elastic material properties and the thermal expansion coefficients
+  // are the first material properties if the behaviour requires the
+  // stiffness tensor or the thermal expansion coefficients tensor (see
+  // `mfront::gb::ThermoElasticMaterialPropertiesNumber`)
+  const auto is_required = [&](const std::string& n) {
+    const auto* const p =
+        static_cast<const unsigned short*>(findSymbol(lib, f, n));
+    return (p != nullptr) && (*p != 0);
+  };
+  const auto* const symmetry = static_cast<const unsigned short*>(
+      findSymbol(lib, f, "ElasticSymmetryType"));
+  const auto orthotropic = (symmetry != nullptr) && (*symmetry == 1);
+  if (is_required("requiresStiffnessTensor")) {
+    if (!orthotropic) {
+      s.mp += 2;
+    } else if (f.hypothesis == "Tridimensional") {
+      s.mp += 9;
+    } else {
+      s.mp += f.hypothesis.starts_with("AxisymmetricalGeneralised") ? 6 : 7;
+    }
+  }
+  if (is_required("requiresThermalExpansionCoefficientTensor")) {
+    s.mp += orthotropic ? 3 : 1;
+  }
+  const auto size = [&](const std::string& n) -> std::size_t {
+    for (const auto* const vs : {&g, &th, &isvs, &esvs}) {
+      for (const auto& v : *vs) {
+        if (v.name == n) {
+          return v.size;
+        }
+      }
+    }
+    if (n == "Temperature") {
+      return 1;
+    }
+    fail("unknown variable '" + n + "' in the tangent operator blocks");
+  };
+  const auto* const nblocks = static_cast<const unsigned short*>(
+      findSymbol(lib, f, "nTangentOperatorBlocks"));
+  if ((nblocks != nullptr) && (*nblocks != 0)) {
+    // the blocks are given as pairs of variables
+    const auto* const blocks = static_cast<const char* const*>(
+        findSymbol(lib, f, "TangentOperatorBlocks"));
+    for (unsigned short i = 0; i + 1 < *nblocks; i += 2) {
+      s.K += size(blocks[i]) * size(blocks[i + 1]);
+    }
+  }
+  // the thermodynamic forces and the tangent operator of the standard finite
+  // strain behaviours depend on the options. The symbols describe the Cauchy
+  // stress and its derivative with respect to the deformation gradient.
+  const auto* const type =
+      static_cast<const unsigned short*>(findSymbol(lib, f, "BehaviourType"));
+  if ((type != nullptr) && (*type == 2)) {
+    const auto T = s.g;
+    const auto S = s.th;
+    s.th = fs.stress_measure == 2 ? T : S;
+    if (fs.tangent_operator == 1) {
+      s.K = S * S;
+    } else if (fs.tangent_operator == 2) {
+      s.K = T * T;
+    } else {
+      s.K = S * T;
+    }
+  }
+  return s;
+}
