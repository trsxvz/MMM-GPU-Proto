From 345fef17e648456e006ae79b38c5f12d5081a5a1 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 22:03:02 +0200
Subject: [PATCH] Float bounds: criteria at a tenth of epsilon, perturbation at
 epsilon

With the float numerical type, the convergence criteria (@Epsilon of the
implicit, Runge-Kutta and isotropic DSLs) were raised to 10 times the
machine epsilon (1.2e-6). The criteria of these DSLs are absolute and the
residuals are expressed in strains: with elastic strains of about 1e-4,
1.2e-6 leaves errors of about 1 % on the stresses. With the finite strain
single crystal law of the polycrystal case of mm-opera-hpc, the first
Newton iteration of the structure reduced the residual to 0.45 of its
initial value instead of 0.024 with 1e-8 or 1e-10, which the local solver
reaches in float, and the Newton solver did not converge.

The criteria are now raised to a tenth of the machine epsilon (1.2e-8),
the order of the default criterion of the implicit DSL, that residuals in
strains reach for strains up to about 0.1. The perturbation of the
numerical jacobian has its own bound, the machine epsilon (1.2e-7):
smaller perturbations of the unknowns are lost in their rounding. This
bound also applies to the default perturbation, a tenth of the criterion.
---
 mfront/include/MFront/BehaviourDSLCommon.hxx | 27 +++++++++-----
 mfront/src/BehaviourDSLCommon.cxx            | 39 +++++++++++++++-----
 mfront/src/ImplicitDSLBase.cxx               |  8 ++--
 3 files changed, 51 insertions(+), 23 deletions(-)

diff --git a/mfront/include/MFront/BehaviourDSLCommon.hxx b/mfront/include/MFront/BehaviourDSLCommon.hxx
index ff5869289..2130f2e66 100644
--- a/mfront/include/MFront/BehaviourDSLCommon.hxx
+++ b/mfront/include/MFront/BehaviourDSLCommon.hxx
@@ -555,19 +555,28 @@ namespace mfront {
     //! \brief treat the `@StrainMeasure` keyword
     virtual void treatStrainMeasure();
     /*!
-     * \return the value of a convergence criterion or of a perturbation,
-     * bounded below, with the float numerical type (`real_type` DSL option),
-     * by `f` times 10 times the machine epsilon of this type: the values
-     * written for double (1e-14 or less) can't be reached with float. A
-     * warning is reported when the value is changed.
+     * \return the value of a convergence criterion, bounded below, with the
+     * float numerical type (`real_type` DSL option), by a tenth of the
+     * machine epsilon of this type (1.2e-8, the order of the default
+     * criterion of the implicit DSL): the values written for double (1e-14
+     * or less) can't be reached, whereas residuals expressed in strains
+     * reach this bound for strains up to about 0.1. A looser bound leaves
+     * errors on the stresses of the order of the bound times the elastic
+     * moduli. A warning is reported when the value is changed.
      * \param[in] n: name of the parameter
      * \param[in] v: value
-     * \param[in] f: factor (0.1 for the perturbation of the numerical
-     * jacobian, the ratio used by default)
      */
     double getConvergenceCriterionForRealType(const std::string_view,
-                                              const double,
-                                              const double = 1) const;
+                                              const double) const;
+    /*!
+     * \return the perturbation used to compute the numerical jacobian,
+     * bounded below, with the float numerical type (`real_type` DSL
+     * option), by the machine epsilon of this type (1.2e-7): smaller
+     * perturbations of the unknowns are lost in their rounding. A warning
+     * is reported when the value is changed.
+     * \param[in] v: value
+     */
+    double getNumericalJacobianPerturbationForRealType(const double) const;
     /*!
      * \brief treat the `@TangentOperator` keyword
      * \note this method read the code block options and determines
diff --git a/mfront/src/BehaviourDSLCommon.cxx b/mfront/src/BehaviourDSLCommon.cxx
index b4d037897..fb440bb6d 100644
--- a/mfront/src/BehaviourDSLCommon.cxx
+++ b/mfront/src/BehaviourDSLCommon.cxx
@@ -1677,25 +1677,44 @@ namespace mfront {
     return this->standardModifier(h, var, addThisPtr);
   }  // end of tangentOperatorVariableModifier
 
-  double BehaviourDSLCommon::getConvergenceCriterionForRealType(
-      const std::string_view n, const double v, const double f) const {
-    if (getRealType(this->mb) != "float") {
-      return v;
-    }
-    const auto vmin =
-        f * 10 * static_cast<double>(std::numeric_limits<float>::epsilon());
-    if (v >= vmin) {
+  /*!
+   * \return the given value, raised to the given lower bound with a warning
+   * if the behaviour uses the float numerical type (`real_type` DSL option)
+   * \param[in] bd: behaviour description
+   * \param[in] n: name of the parameter
+   * \param[in] v: value
+   * \param[in] vmin: lower bound
+   */
+  static double raiseForFloatRealType(const BehaviourDescription& bd,
+                                      const std::string_view n,
+                                      const double v,
+                                      const double vmin) {
+    if ((getRealType(bd) != "float") || (v >= vmin)) {
       return v;
     }
     auto msg = std::ostringstream{};
     msg << std::scientific << "the value of '" << n << "' (" << v
         << ") is raised to " << vmin
-        << " for the float numerical type (real_type option): smaller "
-           "values can't be reached";
+        << " for the float numerical type (real_type option)";
     reportWarning(msg.str());
     return vmin;
+  }  // end of raiseForFloatRealType
+
+  double BehaviourDSLCommon::getConvergenceCriterionForRealType(
+      const std::string_view n, const double v) const {
+    const auto vmin =
+        static_cast<double>(std::numeric_limits<float>::epsilon()) / 10;
+    return raiseForFloatRealType(this->mb, n, v, vmin);
   }  // end of getConvergenceCriterionForRealType
 
+  double BehaviourDSLCommon::getNumericalJacobianPerturbationForRealType(
+      const double v) const {
+    const auto vmin =
+        static_cast<double>(std::numeric_limits<float>::epsilon());
+    return raiseForFloatRealType(this->mb, "numerical_jacobian_epsilon", v,
+                                 vmin);
+  }  // end of getNumericalJacobianPerturbationForRealType
+
   void BehaviourDSLCommon::treatStrainMeasure() {
     this->checkNotEndOfFile("BehaviourDSLCommon::treatStrainMeasure",
                             "Expected strain measure name.");
diff --git a/mfront/src/ImplicitDSLBase.cxx b/mfront/src/ImplicitDSLBase.cxx
index cfef01339..971f36969 100644
--- a/mfront/src/ImplicitDSLBase.cxx
+++ b/mfront/src/ImplicitDSLBase.cxx
@@ -755,8 +755,7 @@ namespace mfront {
     this->mb.addParameter(h, e, BehaviourData::ALREADYREGISTRED);
     this->mb.setParameterDefaultValue(
         h, "numerical_jacobian_epsilon",
-        this->getConvergenceCriterionForRealType("numerical_jacobian_epsilon",
-                                                 epsilon, 0.1));
+        this->getNumericalJacobianPerturbationForRealType(epsilon));
   }  // ImplicitDSLBase::treatEpsilon
 
   void ImplicitDSLBase::treatIterMax() {
@@ -1491,8 +1490,9 @@ namespace mfront {
         (this->solver->usesJacobian())) {
       const std::string nje = "numerical_jacobian_epsilon";
       if (!this->mb.hasParameter(uh, nje)) {
-        const auto eps = 0.1 * this->mb.getFloattingPointParameterDefaultValue(
-                                   uh, "epsilon");
+        const auto eps = this->getNumericalJacobianPerturbationForRealType(
+            0.1 *
+            this->mb.getFloattingPointParameterDefaultValue(uh, "epsilon"));
         VariableDescription v("NumericType", nje, 1u, 0u);
         v.description =
             "perturbation value used to compute a numerical "
