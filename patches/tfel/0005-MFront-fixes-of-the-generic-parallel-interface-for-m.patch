     /*!
      * \brief return if the backend shall handle the data transfer from a host
      * to a device
diff --git a/mfront/include/MFront/GenericParallelBehaviour/ParallelSTL.hxx b/mfront/include/MFront/GenericParallelBehaviour/ParallelSTL.hxx
index 956ef7ab7..372658f18 100644
