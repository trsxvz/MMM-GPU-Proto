@@ -0,0 +1,124 @@
+/*!
+ * \file   mfront/include/MFront/GenericBehaviour/RotateTangentOperatorBlock.hxx
+ * \brief  This file declares the `rotateTangentOperatorBlock` function.
+ * \date   08/10/2026
