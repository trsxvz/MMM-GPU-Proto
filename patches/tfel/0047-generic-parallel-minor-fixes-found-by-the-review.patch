From 4ff6165ed084b0c122d6475863b136d6cb346783 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 6 Oct 2026 16:03:50 +0200
Subject: [PATCH] generic-parallel: minor fixes found by the review

- The output status is initialized before reporting a null batch.
- Models pass their default out of bounds policy, which they apply
  themselves, instead of a misleading `None` policy.
- `GenTypeBase` is restored: it is not used in device code since the
  tangent operators of finite strain behaviours rely on
  `TrivialGenTypeBase`.
- `callAndReportExceptions` gets an overload without exception handler.
- The Runge-Kutta DSLs use `makeHostAndDeviceCode`.
- Removal of an orphan comment and of an empty list in `tfel.cmake`. The
  prefixes of the generated names are explained.
---
 cmake/modules/tfel.cmake                      |  9 +--
 include/TFEL/Utilities/GenTypeBase.hxx        | 56 +++++--------------
 .../MFront/GenericBehaviour/Integrate.hxx     | 18 +++++-
 .../ModelIntegrator.hxx                       | 10 ++--
 .../src/GenericParallelBehaviourInterface.cxx | 15 ++---
 mfront/src/GenericParallelModelInterface.cxx  |  8 ++-
 mfront/src/RungeKuttaDSLBase.cxx              | 16 +++---
 7 files changed, 55 insertions(+), 77 deletions(-)

diff --git a/cmake/modules/tfel.cmake b/cmake/modules/tfel.cmake
index c01c69a72..8c6b57058 100644
--- a/cmake/modules/tfel.cmake
+++ b/cmake/modules/tfel.cmake
@@ -552,9 +552,6 @@ set(_tfel-generic-parallel_supported_configurations
     "openmp-host-gcc"
     "openmp-offload-nvhpc-gpu")
 
-# configurations only supported by the behaviours
-set(_tfel-generic-parallel_behaviours_only_configurations)
-
 foreach(conf ${generic-parallel-configurations})
   if(NOT "${conf}" IN_LIST _tfel-generic-parallel_supported_configurations)
     message(FATAL_ERROR "unsupported configuration '${conf}' for the tests of the generic-parallel interface. "
@@ -562,10 +559,8 @@ foreach(conf ${generic-parallel-configurations})
   endif()
   set(_tfel-enable-generic-parallel-${conf}-configuration ON)
   if(NOT ${conf} STREQUAL "hip-clang")
-    if(NOT "${conf}" IN_LIST _tfel-generic-parallel_behaviours_only_configurations)
-      list(APPEND tfel-check-components
-           "mfront::material_property::generic-parallel_interface::supported_configuration::${conf}")
-    endif()
+    list(APPEND tfel-check-components
+         "mfront::material_property::generic-parallel_interface::supported_configuration::${conf}")
     list(APPEND tfel-check-components
          "mfront::behaviour::generic-parallel_interface::supported_configuration::${conf}")
   endif()
