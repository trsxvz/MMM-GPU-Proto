From c44f6df353530f84e01507f7dd68d88cfcb2780c Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 9 Nov 2026 21:53:27 +0100
Subject: [PATCH] generic-parallel models: out of bounds policy of the library,
 as the generic models

The generic models now read their out of bounds policy at runtime and
export <name>_setOutOfBoundsPolicy. The generic-parallel models do the same:
the policy of the library is read on the host by the functions of batches
and by the functions of the generic interface, and given to the model
class, which can be used in device code.
---
 .../generic-parallel-behaviour-interface.md   |  7 +++---
 .../include/MFront/GenericModelInterface.hxx  | 11 +++++----
 .../ModelIntegrator.hxx                       |  9 ++++---
 mfront/src/GenericModelInterface.cxx          | 24 ++++++++++++-------
 mfront/src/GenericParallelModelInterface.cxx  | 17 +++++++++----
 5 files changed, 43 insertions(+), 25 deletions(-)

diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index 2ef005db7..f8e65d6be 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -146,9 +146,10 @@ objects of each variable by `change_basis`.
 
 The library also exports the same symbols as the `generic` interface
 (names and types of the variables, parameters, etc.) and the functions
-changing the parameters and the out of bounds policy. The standalone
-models use their default out of bounds policy: no function changing it is
-generated for them. The `<name>_mfront_interface` symbol is equal to
+changing the parameters and the out of bounds policy, for the behaviours
+and for the standalone models, as the `generic` interface. The out of
+bounds policy is read on the host and given to the computations at each
+point. The `<name>_mfront_interface` symbol is equal to
 `GenericParallel`, for the behaviours and for the standalone models, so
 that a library of this interface can't be taken for a library of the
 `generic` interface. The `<name>_generic_parallel_backend` symbol gives the
diff --git a/mfront/include/MFront/GenericModelInterface.hxx b/mfront/include/MFront/GenericModelInterface.hxx
index 55bd3d7b5..fc3cc285e 100644
--- a/mfront/include/MFront/GenericModelInterface.hxx
+++ b/mfront/include/MFront/GenericModelInterface.hxx
@@ -24,8 +24,10 @@ namespace mfront {
   struct GenericModelClassOptions {
     /*!
      * \brief if true, the class can be used in device code: its constructor
-     * takes the behaviour data and a structure holding the values of the
-     * real parameters, its methods are host and device functions and, in
+     * takes the behaviour data, a structure holding the values of the real
+     * parameters and the out of bounds policy (which is read on the host,
+     * where it can be modified at runtime, see the `generic` interface), its
+     * methods are host and device functions and, in
      * device code, the material laws are evaluated by their device
      * implementations (the functions of the `mfront` interface are used on
      * the host). String parameters are not supported in this case (an
@@ -37,8 +39,9 @@ namespace mfront {
     /*!
      * \brief name of the host function returning the out of bounds policy,
      * which can be modified at runtime (see the `generic` interface). If
-     * empty, or if the class can be used in device code, the default out of
-     * bounds policy of the model is used.
+     * empty, the default out of bounds policy of the model is used. Not used
+     * if the class can be used in device code: the policy is then given to
+     * the constructor.
      */
     std::string out_of_bounds_policy_function = "";
   };
diff --git a/mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx b/mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx
index 31baa8c27..126f06fa0 100644
--- a/mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx
+++ b/mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx
@@ -56,21 +56,20 @@ namespace mfront::gpb {
      * \param[in,out] d: behaviour data
      * \param[in] o: computation options, not used: the model is executed
      * whatever the type of computation
-     * \param[in] p: out of bounds policy, which is the default policy of the
-     * model, applied by the model itself
+     * \param[in] p: out of bounds policy, applied by the model
      * \param[in] parameters: values of the parameters
      */
     template <typename Model, typename ParametersType>
     TFEL_HOST_DEVICE static int integrate(
         mfront::gb::BehaviourData& d,
         const ComputationOptions&,
-        const tfel::material::OutOfBoundsPolicy,
+        const tfel::material::OutOfBoundsPolicy p,
         const ParametersType& parameters) {
       // on the host, the exceptions thrown by the model (bounds checks,
       // material laws) are reported as failures
       const auto status =
-          mfront::gb::callAndReportExceptions(d, [&d, &parameters] {
-            const auto m = Model(d, parameters);
+          mfront::gb::callAndReportExceptions(d, [&d, &parameters, p] {
+            const auto m = Model(d, parameters, p);
             return m.execute(d) ? 1 : -1;
           });
       if (status == -1) {
