+/*!
+ * \brief statistics of the evaluation of a material property on a set of
+ * points.
+ *
+ * The device only updates them when an event occurs at a point (failure or
+ * bound violated with the warning policy), with integer atomic operations or
+ * reductions: their cost is null when the evaluation succeeds. They are
+ * initialized by `mfront_gpmp_initializeStatistics` and analysed by the
+ * `<name>_generic_parallel_report` function exported by the libraries.
+ */
+typedef struct mfront_gpmp_Statistics {
+  /*!
+   * \brief number of points where the evaluation failed (physical bound
+   * violated, bound violated with the strict policy, invalid result)
+   */
+  unsigned long long number_of_failures;
+  /*!
+   * \brief index of the first point where the evaluation failed, or the
+   * maximal value of the type if no point failed
+   */
+  unsigned long long first_failure_index;
+  /*!
+   * \brief number of points where a bound is violated with the warning
+   * policy: the result is computed, but must be used with caution
+   */
+  unsigned long long number_of_unreliable_results;
+  /*!
+   * \brief identifier of the first check which failed, in the order of the
+   * analysis of the statistics (invalid result, physical bounds, bounds), or
+   * the maximal value of the type if no check failed
+   */
+  unsigned long long first_violation;
+} mfront_gpmp_Statistics;
+
+/*!
+ * \brief initialize the statistics of an evaluation
+ * \param[out] s: statistics
+ */
+static inline void mfront_gpmp_initializeStatistics(
+    mfront_gpmp_Statistics* const s) {
+  s->number_of_failures = 0;
+  s->first_failure_index = ~0ull;
+  s->number_of_unreliable_results = 0;
+  s->first_violation = ~0ull;
+} /* end of mfront_gpmp_initializeStatistics */
+
+/*!
+ * \brief summary of the evaluation of a material property on a set of
+ * points. The `status` and `bounds_status` members have the meaning of the
+ * members of the output status of the `generic` interface
+ * (`mfront_gmp_OutputStatus`):
+ *
+ * - `0`: the result has been evaluated at all points;
+ * - `1`: a bound is violated with the warning policy at some points: the
+ *   result is evaluated at all points, but must be used with caution;
+ * - `-1`: a physical bound, or a bound with the strict policy, is violated
+ *   at some points: the result is not evaluated at those points;
+ * - `-2`: an exception was thrown on the host;
+ * - `-4`: the result is not finite at some points;
+ * - `-5`: invalid arguments, nothing was computed;
+ * - `-6`: runtime error of the backend, or invalid parameters;
+ * - `-7`: uniform output with several points or with non uniform arguments.
+ */
+typedef struct mfront_gpmp_OutputStatus {
+  //! \brief status
+  int status;
+  /*!
+   * \brief rank of the variable out of its bounds, starting at one (the
+   * output is after the arguments), or zero. As for the `generic`
+   * interface, it is negative if the evaluation failed (physical bound, or
+   * bound with the strict policy), positive otherwise (bound with the
+   * warning policy).
+   */
+  int bounds_status;
+  //! \brief number of points where the evaluation failed
+  mfront_gmp_size_type number_of_failures;
+  /*!
+   * \brief index of the first point where the evaluation failed, or the
+   * maximal value of the type if no point failed. The `generic` interface
+   * of the same material property, called at this point, gives the detailed
+   * error.
+   */
+  mfront_gmp_size_type first_failure_index;
+  /*!
+   * \brief number of points where a bound is violated with the warning
+   * policy
+   */
+  mfront_gmp_size_type number_of_unreliable_results;
+  //! \brief error message
+  char msg[512];
+} mfront_gpmp_OutputStatus;
