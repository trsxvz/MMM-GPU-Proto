From 90be6227c71f8cd01f006751682983322c09fbcc Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 6 Oct 2026 22:54:31 +0200
Subject: [PATCH] MFront: exceptions of the constructor of the behaviour
 reported as failures

The integration driver of the `generic` interface built the behaviour
before the region converting the exceptions into failures: an exception
thrown by the constructor left the generated function. This is the case
when the data shared by all the integration points can't be built (for
instance when the orientations of the grains of a polycrystal can't be
read). Such errors were previously thrown at the first evaluation of the
derivatives, and reported as failures. The behaviour is now built in the
protected region. If its constructor throws, the time step scaling factor
is left unchanged.
---
 .../include/MFront/GenericBehaviour/Integrate.hxx  | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/mfront/include/MFront/GenericBehaviour/Integrate.hxx b/mfront/include/MFront/GenericBehaviour/Integrate.hxx
index 293b628b7..f72cbd2fa 100644
--- a/mfront/include/MFront/GenericBehaviour/Integrate.hxx
+++ b/mfront/include/MFront/GenericBehaviour/Integrate.hxx
@@ -483,10 +483,15 @@ namespace mfront::gb {
     using speed = typename Behaviour::speed;
     using massdensity = typename Behaviour::massdensity;
     using behaviour_real_type = typename Behaviour::real;
-    Behaviour b(d, args...);
-    b.setOutOfBoundsPolicy(p);
     auto&& rdt = tfel::math::map<behaviour_real_type>(d.rdt);
+    // time step scaling factor reported if an exception is thrown. The
+    // behaviour is built in the protected region, since its constructor may
+    // throw on the host (for instance while building shared data).
+    auto rdt_on_exception = behaviour_real_type{rdt};
     const auto integrate = [&]() -> int {
+      Behaviour b(d, args...);
+      rdt_on_exception = b.getMinimalTimeStepScalingFactor();
+      b.setOutOfBoundsPolicy(p);
       if (!b.initialize()) {
         reportError(d, "behaviour initialisation failed");
         return -1;
@@ -546,9 +551,8 @@ namespace mfront::gb {
       }
       return rdt < behaviour_real_type{0.99} ? 0 : 1;
     };
-    return callAndReportExceptions(d, integrate, [&rdt, &b] {
-      rdt = b.getMinimalTimeStepScalingFactor();
-    });
+    return callAndReportExceptions(
+        d, integrate, [&rdt, &rdt_on_exception] { rdt = rdt_on_exception; });
   }  // end of integrate
 
   /*!
