@@ -0,0 +1,69 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/GPU.hxx
+ * \brief  This file declares the functions of the `cuda` and `hip` backends
+ * of the `generic-parallel` behaviour interface which are specific to the
+ * behaviours. The primitive of the backends is declared in
+ * `MFront/GenericParallel/GPU.hxx`, whose requirements apply.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_GPU_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_GPU_HXX
+
+#include <stdexcept>
+#include <type_traits>
+#include "MFront/GenericParallel/GPU.hxx"
+#include "MFront/GenericParallelBehaviour/Integrate.hxx"
+
+namespace mfront::gpb::gpu {
+
+  /*!
+   * \return a copy of a data in the memory of the current device
+   * \param[in] v: data
+   */
+  template <typename T>
+  const T* copyToDevice(const T& v) {
+    static_assert(std::is_trivially_copyable_v<T>,
+                  "the shared data must be trivially copyable");
+    constexpr auto success = MFRONT_GENERIC_PARALLEL_GPU_API(Success);
+    T* p = nullptr;
+    if (MFRONT_GENERIC_PARALLEL_GPU_API(Malloc)(reinterpret_cast<void**>(&p),
+                                                sizeof(T)) != success) {
+      throw std::runtime_error("memory allocation failed on the device");
+    }
+    if (MFRONT_GENERIC_PARALLEL_GPU_API(Memcpy)(
+            p, &v, sizeof(T),
+            MFRONT_GENERIC_PARALLEL_GPU_API(MemcpyHostToDevice)) != success) {
+      static_cast<void>(MFRONT_GENERIC_PARALLEL_GPU_API(Free)(p));
+      throw std::runtime_error("copy to the device failed");
+    }
+    return p;
+  }  // end of copyToDevice
+
+  /*!
+   * \return a copy of a data shared by all the integration points (see the
+   * `@SharedData` keyword) in the memory of the current device. A copy is
+   * made at the first call on each device and is never freed.
+   * \tparam get_shared_data: function returning the data
+   */
+  template <auto get_shared_data>
+  const auto* getSharedDataCopy() {
+    using T = std::remove_cvref_t<decltype(get_shared_data())>;
+    static auto copies = SharedDataCopies<T, int>{};
+    auto device = int{};
+    if (MFRONT_GENERIC_PARALLEL_GPU_API(GetDevice)(&device) !=
+        MFRONT_GENERIC_PARALLEL_GPU_API(Success)) {
+      throw std::runtime_error("unable to get the current device");
+    }
+    return copies.get(device, [] { return copyToDevice(get_shared_data()); });
+  }  // end of getSharedDataCopy
+
+}  // end of namespace mfront::gpb::gpu
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_GPU_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
new file mode 100644
index 000000000..59ad40bdb
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
@@ -0,0 +1,1611 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/Integrate.hxx
+ * \brief  This file implements the integration of a behaviour at one point
+ * of a batch, and the utilities shared by all the backends of the
+ * `generic-parallel` behaviour interface.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_INTEGRATE_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_INTEGRATE_HXX
+
+#include <bit>
+#include <array>
+#include <cstddef>
+#include <type_traits>
+#include <cstdio>
+#include <cstring>
+#include <exception>
+#include <mutex>
+#include <string_view>
+#include <utility>
+#include <vector>
+#include "TFEL/Config/TFELConfig.hxx"
+#include "TFEL/Math/General/MathObjectTraits.hxx"
+#include "TFEL/Math/Array/View.hxx"
+#include "TFEL/Material/OutOfBoundsPolicy.hxx"
+#include "TFEL/Material/MechanicalBehaviour.hxx"
+#include "TFEL/Material/MechanicalBehaviourTraits.hxx"
+#include "MFront/GenericBehaviour/Types.hxx"
+#include "MFront/GenericBehaviour/State.hxx"
+#include "MFront/GenericBehaviour/BehaviourData.hxx"
+#include "MFront/GenericBehaviour/Integrate.hxx"
+#include "MFront/GenericParallel/StatisticsKeys.hxx"
+#include "MFront/GenericParallel/Batch.hxx"
+#include "MFront/GenericParallelBehaviour/BatchData.h"
+#include "MFront/GenericParallel/BackendExecutionPolicyBase.hxx"
+
+/*!
+ * \brief attribute of the computations at a point which must not be inlined
+ * in the reduction kernels of `nvc++ -stdpar=gpu`. With nvc++ 25.11, the
+ * execution of an initialize function of some finite strain behaviours,
+ * inlined in the kernel of `std::transform_reduce`, reads the inputs at an
+ * address truncated to 32 bits (illegal memory access).
+ */
+#if defined(__NVCOMPILER_STDPAR_GPU)
+#define MFRONT_GPB_NVHPC_STDPAR_NOINLINE __attribute__((noinline))
+#else
+#define MFRONT_GPB_NVHPC_STDPAR_NOINLINE
+#endif
+
+namespace mfront::gpb {
+
+  //! \brief a simple alias
+  using real = mfront::gb::real;
+  //! \brief a simple alias
+  using size_type = mfront_gb_size_type;
+
+  /*!
+   * \brief sizes of the data of an integration point, as seen by the
+   * `generic` interface.
+   *
+   * The templates of this file take the description of the data of a point
+   * through a type `PointTraits`, generated by `MFront`, whose static member
+   * `value` gives the maximal sizes of the data of a point, whose static
+   * members `material_properties_sizes` and `external_state_variables_sizes`
+   * give the number of components of each material property and of each
+   * external state variable, and whose member type `Integrator` gives the
+   * integration strategy (see `StandardIntegrator`). CUDA compilers don't
+   * support class types as non-type template parameters of kernels. For finite
+   * strain behaviours, the sizes of the thermodynamic forces and of the tangent
+   * operator depend on the stress measure and on the tangent operator requested
+   * by the computation options.
+   */
+  struct PointDataSizes {
+    size_type gradients = 0;
+    size_type thermodynamic_forces = 0;
+    size_type material_properties = 0;
+    size_type internal_state_variables = 0;
+    size_type external_state_variables = 0;
+    size_type tangent_operator = 0;
+  };
+
+  //! \brief parameters of a behaviour without parameters
+  struct NoParameters {};
+
+  //! \brief result of the integration at one point
+  struct PointResult {
+    //! \brief status, as returned by the `generic` interface
+    int status;
+    //! \brief time step scaling factor
+    real rdt;
+  };
+
+  //! \brief a simple alias
+  using ComputationOptions = mfront::gb::ComputationOptions;
+
+  //! \return the computation options of a batch
+  TFEL_HOST_DEVICE constexpr ComputationOptions getComputationOptions(
+      const BatchData& d) noexcept {
+    return ComputationOptions{d.options[0], d.options[1], d.options[2]};
+  }  // end of getComputationOptions
+
+  /*!
+   * \brief local copy of the values of a group of variables at one point
+   * \tparam N: number of values
+   */
+  template <size_type N>
+  struct LocalValues {
+    TFEL_HOST_DEVICE constexpr real* data() noexcept { return this->values; }
+    //! \brief values, the array has at least one element
+    real values[N == 0 ? 1 : N];
+  };
+
+  namespace internals {
+
+    //! \return the values of a field at the given point
+    template <typename FieldType>
+    TFEL_HOST_DEVICE constexpr auto pointer(const FieldType& f,
+                                            const size_type i) noexcept {
+      return f.values == nullptr ? f.values : f.values + i * f.point_stride;
+    }  // end of pointer
+
+    /*!
+     * \brief copy the values of a field at the given point in an array
+     *
+     * All the values are read before being written: the compiler can't
+     * assume that the field and the array don't overlap, and would otherwise
+     * wait for each value before reading the next one.
+     *
+     * \tparam N: capacity of the array
+     * \param[out] dest: array
+     * \param[in] f: field
+     * \param[in] i: index of the point
+     * \param[in] n: number of values, not greater than `N`
+     */
+    template <size_type N, typename FieldType>
+    TFEL_HOST_DEVICE constexpr void gatherValues(real* const dest,
+                                                 const FieldType& f,
+                                                 const size_type i,
+                                                 const size_type n) noexcept {
+      if constexpr (N != 0) {
+        if (f.values == nullptr) {
+          return;
+        }
+        const auto* const p = f.values + i * f.point_stride;
+        const auto stride = f.component_stride;
+        real values[N];
+        for (size_type j = 0; j != N; ++j) {
+          if (j < n) {
+            values[j] = p[j * stride];
+          }
+        }
+        for (size_type j = 0; j != N; ++j) {
+          if (j < n) {
+            dest[j] = values[j];
+          }
+        }
+      }
+    }  // end of gatherValues
+
+    /*!
+     * \brief copy the values of an array in a field at the given point
+     *
+     * All the values are read before being written (see `gatherValues`).
+     *
+     * \tparam N: capacity of the array
+     * \param[out] f: field
+     * \param[in] i: index of the point
+     * \param[in] src: array
+     * \param[in] n: number of values, not greater than `N`
+     */
+    template <size_type N>
+    TFEL_HOST_DEVICE constexpr void scatterValues(const Field& f,
+                                                  const size_type i,
+                                                  const real* const src,
+                                                  const size_type n) noexcept {
+      if constexpr (N != 0) {
+        if (f.values == nullptr) {
+          return;
+        }
+        auto* const p = f.values + i * f.point_stride;
+        const auto stride = f.component_stride;
+        real values[N];
+        for (size_type j = 0; j != N; ++j) {
+          if (j < n) {
+            values[j] = src[j];
+          }
+        }
+        for (size_type j = 0; j != N; ++j) {
+          if (j < n) {
+            p[j * stride] = values[j];
+          }
+        }
+      }
+    }  // end of scatterValues
+
+    /*!
+     * \brief copy the values of a field at the given point
+     * \param[out] dest: local copy
+     * \param[in] f: field
+     * \param[in] i: index of the point
+     * \param[in] n: number of values, not greater than the capacity of
+     * `dest`
+     */
+    template <size_type N, typename FieldType>
+    TFEL_HOST_DEVICE constexpr void gather(LocalValues<N>& dest,
+                                           const FieldType& f,
+                                           const size_type i,
+                                           const size_type n) noexcept {
+      if constexpr (N != 0) {
+        gatherValues<N>(dest.values, f, i, n);
+      }
+    }  // end of gather
+
+    /*!
+     * \brief copy the given values in a field at the given point
+     * \param[out] f: field
+     * \param[in] i: index of the point
+     * \param[in] src: local values
+     * \param[in] n: number of values, not greater than the capacity of
+     * `src`
+     */
+    template <size_type N>
+    TFEL_HOST_DEVICE constexpr void scatter(const Field& f,
+                                            const size_type i,
+                                            const LocalValues<N>& src,
+                                            const size_type n) noexcept {
+      if constexpr (N != 0) {
+        scatterValues<N>(f, i, src.values, n);
+      }
+    }  // end of scatter
+
+    //! \brief copy a scalar value in a field at the given point
+    TFEL_HOST_DEVICE constexpr void scatter(const Field& f,
+                                            const size_type i,
+                                            const real v) noexcept {
+      if (f.values != nullptr) {
+        f.values[i * f.point_stride] = v;
+      }
+    }  // end of scatter
+
+    //! \return the value of a scalar field at the given point, or a default
+    TFEL_HOST_DEVICE constexpr real value(const ConstField& f,
+                                          const size_type i,
+                                          const real v) noexcept {
+      return f.values == nullptr ? v : f.values[i * f.point_stride];
+    }  // end of value
+
+  }  // end of namespace internals
+
+  /*!
+   * \brief fields of the variables of a group, one field per variable, and
+   * number of components of each variable.
+   *
+   * The material properties and the external state variables of a batch may
+   * be given as a group or variable by variable. Both forms are converted on
+   * the host in this structure, which is passed by value to the kernels: the
+   * code executed at each point is the same for both forms.
+   *
+   * \tparam N: number of variables
+   */
+  template <std::size_t N>
+  struct VariableFields {
+    //! \brief field of each variable
+    ConstField fields[N == 0 ? 1 : N];
+    //! \brief number of components of each variable
+    size_type sizes[N == 0 ? 1 : N];
+  };
+
+  /*!
+   * \brief fields of the material properties and of the external state
+   * variables at the beginning and at the end of the time step
+   * \tparam PointTraits: description of the data of an integration point
+   */
+  template <typename PointTraits>
+  struct InputFields {
+    //! \brief number of material properties
+    static constexpr auto number_of_material_properties =
+        PointTraits::material_properties_sizes.size();
+    //! \brief number of external state variables
+    static constexpr auto number_of_external_state_variables =
+        PointTraits::external_state_variables_sizes.size();
+    VariableFields<number_of_material_properties> mp0;
+    VariableFields<number_of_material_properties> mp1;
+    VariableFields<number_of_external_state_variables> esv0;
+    VariableFields<number_of_external_state_variables> esv1;
+  };
+
+  namespace internals {
+
+    /*!
+     * \return the fields of the variables of a group
+     * \param[in] group: values of the group
+     * \param[in] by_variable: values of each variable, if not null
+     * \param[in] sizes: number of components of each variable
+     */
+    template <std::size_t N>
+    VariableFields<N> makeVariableFields(
+        const ConstField& group,
+        const ConstField* const by_variable,
+        const std::array<size_type, N>& sizes) noexcept {
+      auto r = VariableFields<N>{};
+      auto offset = size_type{};
+      for (std::size_t v = 0; v != N; ++v) {
+        r.sizes[v] = sizes[v];
+        if (by_variable != nullptr) {
+          r.fields[v] = by_variable[v];
+        } else if (group.values != nullptr) {
+          r.fields[v] =
+              ConstField{group.values + offset * group.component_stride,
+                         group.point_stride, group.component_stride};
+        }
+        offset += sizes[v];
+      }
+      return r;
+    }  // end of makeVariableFields
+
+    /*!
+     * \brief copy the values of the variables of a group at the given point
+     * \param[out] dest: local copy
+     * \param[in] f: fields of the variables
+     * \param[in] i: index of the point
+     */
+    template <size_type M, std::size_t N>
+    TFEL_HOST_DEVICE constexpr void gather(LocalValues<M>& dest,
+                                           const VariableFields<N>& f,
+                                           const size_type i) noexcept {
+      if constexpr ((M != 0) && (N != 0)) {
+        auto* p = dest.values;
+        for (std::size_t v = 0; v != N; ++v) {
+          const auto& fv = f.fields[v];
+          const auto nc = f.sizes[v];
+          if (fv.values != nullptr) {
+            const auto* const src = fv.values + i * fv.point_stride;
+            for (size_type c = 0; c != nc; ++c) {
+              p[c] = src[c * fv.component_stride];
+            }
+          }
+          p += nc;
+        }
+      }
+    }  // end of gather
+
+  }  // end of namespace internals
+
+  /*!
+   * \return the fields of the material properties and of the external
+   * state variables of a batch
+   * \tparam PointTraits: description of the data of an integration point
+   * \param[in] d: batch data
+   */
+  template <typename PointTraits>
+  InputFields<PointTraits> makeInputFields(const BatchData& d) noexcept {
+    using internals::makeVariableFields;
+    constexpr const auto& mps = PointTraits::material_properties_sizes;
+    constexpr const auto& esvs = PointTraits::external_state_variables_sizes;
+    return {
+        .mp0 = makeVariableFields(d.s0.material_properties,
+                                  d.s0.material_properties_by_variable, mps),
+        .mp1 = makeVariableFields(d.s1.material_properties,
+                                  d.s1.material_properties_by_variable, mps),
+        .esv0 =
+            makeVariableFields(d.s0.external_state_variables,
+                               d.s0.external_state_variables_by_variable, esvs),
+        .esv1 = makeVariableFields(d.s1.external_state_variables,
+                                   d.s1.external_state_variables_by_variable,
+                                   esvs)};
+  }  // end of makeInputFields
+
+  /*!
+   * \brief integration strategy of the behaviours which are not finite
+   * strain behaviours: the behaviour is directly integrated by
+   * `mfront::gb::integrate`.
+   *
+   * An integration strategy provides:
+   *
+   * - the sizes of the data of a point for the given computation options;
+   * - the integration of the behaviour at one point, whose behaviour data
+   *   use the conventions of the `generic` interface.
+   */
+  struct StandardIntegrator {
+    /*!
+     * \return the sizes of the data of a point
+     * \tparam PointTraits: description of the data of a point
+     */
+    template <typename PointTraits>
+    TFEL_HOST_DEVICE static constexpr PointDataSizes getPointDataSizes(
+        const ComputationOptions&) noexcept {
+      return PointTraits::value;
+    }  // end of getPointDataSizes
+    /*!
+     * \brief integrate the behaviour at one point
+     * \tparam Behaviour: class implementing the behaviour
+     * \tparam ParametersType: type of the structure holding the parameters
+     * \param[in,out] d: behaviour data
+     * \param[in] o: computation options
+     * \param[in] p: out of bounds policy
+     * \param[in] parameters: values of the parameters
+     */
+    template <typename Behaviour, typename ParametersType>
+    TFEL_HOST_DEVICE static int integrate(
+        mfront::gb::BehaviourData& d,
+        const ComputationOptions& o,
+        const tfel::material::OutOfBoundsPolicy p,
+        const ParametersType& parameters) {
+      return mfront::gb::integrate<Behaviour>(
+          d, o, Behaviour::STANDARDTANGENTOPERATOR, p, parameters);
+    }  // end of integrate
+    /*!
+     * \brief execute an initialize function at one point
+     * \tparam Behaviour: class implementing the behaviour
+     * \tparam InitializeFunction: function object calling the method
+     * implementing the initialize function
+     * \tparam ParametersType: type of the structure holding the parameters
+     * \param[in,out] d: behaviour data
+     * \param[in] values: values of the inputs of the initialize function
+     * \param[in] p: out of bounds policy
+     * \param[in] parameters: values of the parameters
+     */
+    template <typename Behaviour,
+              typename InitializeFunction,
+              typename ParametersType>
+    TFEL_HOST_DEVICE static int executeInitializeFunction(
+        mfront::gb::BehaviourData& d,
+        const real* const values,
+        const ComputationOptions&,
+        const tfel::material::OutOfBoundsPolicy p,
+        const ParametersType& parameters) {
+      return mfront::gb::executeInitializeFunction<Behaviour>(
+          InitializeFunction{}, d, values, p, parameters);
+    }  // end of executeInitializeFunction
+    /*!
+     * \brief execute a post-processing at one point
+     * \tparam Behaviour: class implementing the behaviour
+     * \tparam PostProcessing: function object calling the method
+     * implementing the post-processing
+     * \tparam use_initial_state: boolean stating if the post-processing uses
+     * the initial state of the material
+     * \tparam ParametersType: type of the structure holding the parameters
+     * \param[out] outputs: values of the outputs of the post-processing
+     * \param[in,out] d: behaviour data
+     * \param[in] p: out of bounds policy
+     * \param[in] parameters: values of the parameters
+     */
+    template <typename Behaviour,
+              typename PostProcessing,
+              bool use_initial_state,
+              typename ParametersType>
+    TFEL_HOST_DEVICE static int executePostProcessing(
+        real* const outputs,
+        mfront::gb::BehaviourData& d,
+        const ComputationOptions&,
+        const tfel::material::OutOfBoundsPolicy p,
+        const ParametersType& parameters) {
+      return mfront::gb::executePostProcessing<Behaviour, use_initial_state>(
+          PostProcessing{}, outputs, d, p, parameters);
+    }  // end of executePostProcessing
+  };
+
+  namespace internals {
+
+    /*!
+     * \brief local copies of the values of a point
+     * \tparam PointTraits: description of the data of an integration point
+     */
+    template <typename PointTraits>
+    struct LocalCopies {
+      //! \brief maximal sizes of the data of a point
+      static constexpr auto capacities = PointDataSizes{PointTraits::value};
+      LocalValues<capacities.material_properties> mp0;
+      LocalValues<capacities.material_properties> mp1;
+      LocalValues<capacities.external_state_variables> esvs0;
+      LocalValues<capacities.external_state_variables> esvs1;
+      LocalValues<capacities.tangent_operator> K;
+      LocalValues<capacities.gradients> g0;
+      LocalValues<capacities.gradients> g1;
+      LocalValues<capacities.thermodynamic_forces> th0;
+      LocalValues<capacities.thermodynamic_forces> th1;
+      LocalValues<capacities.internal_state_variables> isvs0;
+      LocalValues<capacities.internal_state_variables> isvs1;
+    };
+
+  }  // end of namespace internals
+
+  /*!
+   * \brief view of the data of the `i`-th point of a batch, as seen by the
+   * `generic` interface.
+   *
+   * The values of the point are copied in local arrays, and the outputs must
+   * be copied back by the `scatter` methods. Reading and writing the fields
+   * directly when they are stored point by point gives no measurable gain
+   * and doubles the number of kernels.
+   *
+   * The behaviour data point to the members of this object, which can't be
+   * copied.
+   *
+   * The outputs of the behaviour are read through the pointers of the
+   * behaviour data, i.e. through the same access path as the behaviour, and
+   * all the inputs are copied by the constructor.
+   *
+   * \note with `nvcc` 13.0, copying the state at the end of the time step
+   * after the construction of the view led to wrong results of the
+   * initialize functions of finite strain behaviours (the optimizer of the
+   * device code dropped the results of the function, which `clang` and
+   * `nvcc -G` do not).
+   *
+   * \tparam PointTraits: description of the data of an integration point
+   */
+  template <typename PointTraits>
+  struct PointView {
+    /*!
+     * \brief constructor
+     * \param[in] d: batch data
+     * \param[in] inputs: fields of the material properties and of the
+     * external state variables
+     * \param[in] i: index of the integration point
+     * \param[in] s: sizes of the data of the point
+     * \param[in] rdt0: initial value of the time step scaling factor
+     * \param[in] gather_end_of_step_state: if true, the thermodynamic forces
+     * and the internal state variables at the end of the time step are
+     * copied, which is required by the functions reading this state or
+     * updating only a part of it (post-processings, initialize functions)
+     */
+    TFEL_HOST_DEVICE PointView(
+        const BatchData& d,
+        const InputFields<PointTraits>& inputs,
+        const size_type i,
+        const PointDataSizes& s,
+        const real rdt0,
+        const bool gather_end_of_step_state = false) noexcept
+        : batch(d),
+          index(i),
+          sizes(s),
+          rdt(rdt0),
+          energies0{{internals::value(d.s0.stored_energy, i, 0),
+                     internals::value(d.s0.dissipated_energy, i, 0)}},
+          energies1{{0, 0}} {
+      using namespace internals;
+      auto& bd = this->data;
+      bd.error_message = nullptr;
+      bd.dt = d.dt;
+      bd.rdt = &(this->rdt);
+      bd.speed_of_sound = &(this->speed_of_sound);
+      bd.s0.mass_density = pointer(d.s0.mass_density, i);
+      bd.s1.mass_density = pointer(d.s1.mass_density, i);
+      bd.s0.stored_energy = this->energies0.data();
+      bd.s0.dissipated_energy = this->energies0.data() + 1;
+      // the energies are always computed if the behaviour computes them, and
+      // only exported if requested
+      bd.s1.stored_energy = this->energies1.data();
+      bd.s1.dissipated_energy = this->energies1.data() + 1;
+      auto& c = this->copies;
+      gather(c.mp0, inputs.mp0, i);
+      gather(c.mp1, inputs.mp1, i);
+      gather(c.esvs0, inputs.esv0, i);
+      gather(c.esvs1, inputs.esv1, i);
+      gather(c.g0, d.s0.gradients, i, s.gradients);
+      gather(c.g1, d.s1.gradients, i, s.gradients);
+      gather(c.th0, d.s0.thermodynamic_forces, i, s.thermodynamic_forces);
+      gather(c.isvs0, d.s0.internal_state_variables, i,
+             s.internal_state_variables);
+      if (gather_end_of_step_state) {
+        gather(c.th1, d.s1.thermodynamic_forces, i, s.thermodynamic_forces);
+        gather(c.isvs1, d.s1.internal_state_variables, i,
+               s.internal_state_variables);
+      }
+      bd.s0.material_properties = c.mp0.data();
+      bd.s1.material_properties = c.mp1.data();
+      bd.s0.external_state_variables = c.esvs0.data();
+      bd.s1.external_state_variables = c.esvs1.data();
+      bd.K = c.K.data();
+      bd.s0.gradients = c.g0.data();
+      bd.s1.gradients = c.g1.data();
+      bd.s0.thermodynamic_forces = c.th0.data();
+      bd.s1.thermodynamic_forces = c.th1.data();
+      bd.s0.internal_state_variables = c.isvs0.data();
+      bd.s1.internal_state_variables = c.isvs1.data();
+    }  // end of PointView
+    //! \brief copy constructor (deleted)
+    PointView(const PointView&) = delete;
+    //! \brief move constructor (deleted)
+    PointView(PointView&&) = delete;
+    //! \brief copy assignement (deleted)
+    PointView& operator=(const PointView&) = delete;
+    //! \brief move assignement (deleted)
+    PointView& operator=(PointView&&) = delete;
+    /*!
+     * \brief copy back the thermodynamic forces and the internal state
+     * variables at the end of the time step
+     */
+    TFEL_HOST_DEVICE void scatterState() const noexcept {
+      const auto& d = this->batch;
+      const auto i = this->index;
+      constexpr auto c = internals::LocalCopies<PointTraits>::capacities;
+      internals::scatterValues<c.thermodynamic_forces>(
+          d.s1.thermodynamic_forces, i, this->data.s1.thermodynamic_forces,
+          this->sizes.thermodynamic_forces);
+      internals::scatterValues<c.internal_state_variables>(
+          d.s1.internal_state_variables, i,
+          this->data.s1.internal_state_variables,
+          this->sizes.internal_state_variables);
+    }  // end of scatterState
+    //! \brief copy back the tangent operator
+    TFEL_HOST_DEVICE void scatterTangentOperator() const noexcept {
+      constexpr auto c = internals::LocalCopies<PointTraits>::capacities;
+      internals::scatterValues<c.tangent_operator>(
+          this->batch.tangent_operators, this->index, this->data.K,
+          this->sizes.tangent_operator);
+    }  // end of scatterTangentOperator
+    //! \brief copy the energies at the end of the time step, if requested
+    TFEL_HOST_DEVICE void scatterEnergies() const noexcept {
+      const auto& d = this->batch;
+      internals::scatter(d.s1.stored_energy, this->index,
+                         *(this->data.s1.stored_energy));
+      internals::scatter(d.s1.dissipated_energy, this->index,
+                         *(this->data.s1.dissipated_energy));
+    }  // end of scatterEnergies
+    //! \brief copy the speed of sound, if requested
+    TFEL_HOST_DEVICE void scatterSpeedOfSound() const noexcept {
+      internals::scatter(this->batch.speed_of_sound, this->index,
+                         *(this->data.speed_of_sound));
+    }  // end of scatterSpeedOfSound
+    //! \return the time step scaling factor
+    TFEL_HOST_DEVICE real getTimeStepScalingFactor() const noexcept {
+      return *(this->data.rdt);
+    }  // end of getTimeStepScalingFactor
+    //! \brief behaviour data, as seen by the `generic` interface
+    mfront::gb::BehaviourData data;
+
+   private:
+    //! \brief batch data
+    const BatchData& batch;
+    //! \brief index of the point
+    const size_type index;
+    //! \brief sizes of the data of the point
+    const PointDataSizes sizes;
+    //! \brief time step scaling factor
+    real rdt;
+    //! \brief speed of sound
+    real speed_of_sound = 0;
+    //! \brief energies at the beginning of the time step
+    LocalValues<2> energies0;
+    /*!
+     * \brief energies at the end of the time step
+     *
+     * \note this member is initialized by the constructor: `nvc++` 25.11
+     * generates invalid device code for a default member initializer
+     * value-initializing an array.
+     */
+    LocalValues<2> energies1;
+    //! \brief local copies of the values of the point
+    internals::LocalCopies<PointTraits> copies;
+  };
+
+  /*!
+   * \brief record the status of a point, if requested
+   * \param[in] d: batch data
+   * \param[in] i: index of the integration point
+   * \param[in] r: result
+   */
+  TFEL_HOST_DEVICE inline void recordStatus(const BatchData& d,
+                                            const size_type i,
+                                            const PointResult& r) noexcept {
+    if (d.statuses != nullptr) {
+      d.statuses[i] = r.status;
+    }
+  }  // end of recordStatus
+
+  /*!
+   * \brief record the status and the time step scaling factor of a point,
+   * if requested. The time step scaling factor is only meaningful for the
+   * integration: the initialize functions and the post-processings only
+   * record the status, so that they can be called with the batch data of
+   * the integration without overwriting the factors proposed by the
+   * behaviour.
+   * \param[in] d: batch data
+   * \param[in] i: index of the integration point
+   * \param[in] r: result
+   */
+  TFEL_HOST_DEVICE inline void record(const BatchData& d,
+                                      const size_type i,
+                                      const PointResult& r) noexcept {
+    internals::scatter(d.rdts, i, r.rdt);
+    recordStatus(d, i, r);
+  }  // end of record
+
+  /*!
+   * \return if the state at the end of the time step is updated when a
+   * prediction is requested. The behaviours do not update it, as in the
+   * `generic` interface. The models do: the `generic` interface of the
+   * models executes them whatever the type of computation (see
+   * `ModelIntegrator`).
+   * \tparam Integrator: integration strategy
+   */
+  template <typename Integrator>
+  TFEL_HOST_DEVICE constexpr bool updatesStateOnPrediction() noexcept {
+    if constexpr (requires { Integrator::updates_state_on_prediction; }) {
+      return Integrator::updates_state_on_prediction;
+    } else {
+      return false;
+    }
+  }  // end of updatesStateOnPrediction
+
+  /*!
+   * \brief integrate the behaviour at the `i`-th point of a batch.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam ParametersType: type of the structure holding the parameters
+   * \param[in] d: batch data
+   * \param[in] inputs: fields of the material properties and of the
+   * external state variables
+   * \param[in] i: index of the integration point
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   */
+  template <typename Behaviour, typename PointTraits, typename ParametersType>
+  TFEL_HOST_DEVICE PointResult
+  integrate(const BatchData& d,
+            const InputFields<PointTraits>& inputs,
+            const size_type i,
+            const ParametersType& parameters,
+            const tfel::material::OutOfBoundsPolicy p) {
+    using Integrator = typename PointTraits::Integrator;
+    const auto o = getComputationOptions(d);
+    auto r = PointResult{.status = -1, .rdt = d.rdt};
+    {
+      auto v = PointView<PointTraits>(
+          d, inputs, i, Integrator::template getPointDataSizes<PointTraits>(o),
+          d.rdt);
+      r.status =
+          Integrator::template integrate<Behaviour>(v.data, o, p, parameters);
+      r.rdt = v.getTimeStepScalingFactor();
+      if (r.status != -1) {
+        if (o.isPredictionRequested() || o.isTangentOperatorRequested()) {
+          v.scatterTangentOperator();
+        }
+        if ((!o.isPredictionRequested()) ||
+            (updatesStateOnPrediction<Integrator>())) {
+          v.scatterState();
+          v.scatterEnergies();
+        }
+        if (o.speed_of_sound) {
+          v.scatterSpeedOfSound();
+        }
+      }
+    }
+    record(d, i, r);
+    return r;
+  }  // end of integrate
+
+  //! \brief index of the first failure when no point failed
+  inline constexpr auto no_failure_index = ~size_type{};
+
+  /*!
+   * \return the key of the statistics associated with an event at a point
+   * (see `MFront/GenericParallel/StatisticsKeys.hxx`). The behaviours and the
+   * models have no check to retain at a point: the identifier of the check
+   * is null.
+   * \param[in] i: index of the point
+   */
+  TFEL_HOST_DEVICE constexpr unsigned long long makeKey(
+      const size_type i) noexcept {
+    return ::mfront::generic_parallel::makeKey(
+        static_cast<unsigned long long>(i), 0);
+  }  // end of makeKey
+
+  /*!
+   * \return the index of the point of a key, or `no_failure_index` if no
+   * event occurred
+   * \param[in] k: key
+   */
+  constexpr size_type getPointIndex(const unsigned long long k) noexcept {
+    if (k == ::mfront::generic_parallel::no_event) {
+      return no_failure_index;
+    }
+    return static_cast<size_type>(::mfront::generic_parallel::getPointIndex(k));
+  }  // end of getPointIndex
+
+  //! \brief statistics on the integration of a batch (see
+  //! `MFront/GenericParallel/Batch.hxx`)
+  using BatchStatistics = ::mfront::generic_parallel::BatchStatistics<real>;
+
+  /*!
+   * \return the statistics associated with the result at one point
+   * \param[in] i: index of the point
+   * \param[in] r: result at this point
+   */
+  TFEL_HOST_DEVICE constexpr BatchStatistics getPointStatistics(
+      const size_type i, const PointResult& r) noexcept {
+    constexpr auto none = ::mfront::generic_parallel::no_event;
+    return {.number_of_failures = r.status == -1 ? 1u : 0u,
+            .first_failure = r.status == -1 ? makeKey(i) : none,
+            .number_of_unreliable_results = r.status == 0 ? 1u : 0u,
+            .first_unreliable_result = r.status == 0 ? makeKey(i) : none,
+            .rdt = r.rdt};
+  }  // end of getPointStatistics
+
+  using ::mfront::generic_parallel::toOrderedKey;
+
+  //! \return the statistics updated by atomic operations
+  inline BatchStatistics getBatchStatistics(
+      const AtomicBatchStatistics& s) noexcept {
+    return {.number_of_failures = static_cast<size_type>(s.number_of_failures),
+            .first_failure = s.first_failure,
+            .number_of_unreliable_results =
+                static_cast<size_type>(s.number_of_unreliable_results),
+            .first_unreliable_result = s.first_unreliable_result,
+            .rdt = mfront_gpb_getTimeStepScalingFactor(&s)};
+  }  // end of getBatchStatistics
+
+  /*!
+   * \brief accumulate the statistics of a batch
+   * \param[in,out] s: accumulated statistics
+   * \param[in] r: statistics of a batch
+   * \param[in] merge_rdt: if false, the time step scaling factor of the
+   * accumulated statistics is not modified
+   */
+  constexpr void accumulate(AtomicBatchStatistics& s,
+                            const BatchStatistics& r,
+                            const bool merge_rdt = true) noexcept {
+    s.number_of_failures += r.number_of_failures;
+    s.first_failure =
+        r.first_failure < s.first_failure ? r.first_failure : s.first_failure;
+    s.number_of_unreliable_results += r.number_of_unreliable_results;
+    s.first_unreliable_result =
+        r.first_unreliable_result < s.first_unreliable_result
+            ? r.first_unreliable_result
+            : s.first_unreliable_result;
+    if (merge_rdt) {
+      const auto rdt = toOrderedKey(r.rdt);
+      s.rdt = rdt < s.rdt ? rdt : s.rdt;
+    }
+  }  // end of accumulate
+
+  using ::mfront::generic_parallel::CombineStatistics;
+
+  using ::mfront::generic_parallel::report;
+
+  /*!
+   * \brief fill an output status from the statistics of a batch: status,
+   * numbers of points, indices of the first failure and of the first
+   * unreliable result, time step scaling factor and error message. This is
+   * the analysis performed by the `<name>_generic_parallel_report` functions.
+   * \return the status
+   * \param[out] s: output status
+   * \param[in] r: statistics
+   */
+  inline int report(OutputStatus& s, const BatchStatistics& r) noexcept {
+    // the keys built by the kernels of the behaviours have a null check
+    // (see `makeKey`): other keys come from other statistics
+    auto is_invalid = [](const unsigned long long k) {
+      return (k != ::mfront::generic_parallel::no_event) &&
+             (::mfront::generic_parallel::getCheck(k) != 0);
+    };
+    if (is_invalid(r.first_failure) || is_invalid(r.first_unreliable_result)) {
+      s.number_of_failures = 0;
+      s.first_failure_index = no_failure_index;
+      s.number_of_unreliable_results = 0;
+      s.first_unreliable_result_index = no_failure_index;
+      s.rdt = 1;
+      return report(s, -5, "invalid statistics (unknown check)");
+    }
+    s.number_of_failures = r.number_of_failures;
+    s.first_failure_index = getPointIndex(r.first_failure);
+    s.number_of_unreliable_results = r.number_of_unreliable_results;
+    s.first_unreliable_result_index = getPointIndex(r.first_unreliable_result);
+    s.rdt = r.rdt;
+    s.msg[0] = '\0';
+    if (r.number_of_failures != 0) {
+      s.status = -1;
+      std::snprintf(s.msg, sizeof(s.msg),
+                    "computations failed at %llu integration points, the "
+                    "first one being the point %llu",
+                    static_cast<unsigned long long>(r.number_of_failures),
+                    static_cast<unsigned long long>(s.first_failure_index));
+    } else {
+      s.status = r.number_of_unreliable_results != 0 ? 0 : 1;
+    }
+    return s.status;
+  }  // end of report
+
+  //! \brief execution of the computations on a batch
+  using BatchExecution =
+      ::mfront::generic_parallel::BatchExecution<AtomicBatchStatistics>;
+
+  /*!
+   * \return the execution of the computations on a batch
+   * \param[in] d: data of the batch
+   */
+  template <typename Data>
+  constexpr BatchExecution getBatchExecution(const Data& d) noexcept {
+    return {.policy = d.execution_policy, .statistics = d.statistics};
+  }  // end of getBatchExecution
+
+  /*!
+   * \brief handler of the statistics of the behaviours and of the models,
+   * given to the primitives of the backends (see
+   * `MFront/GenericParallel/Batch.hxx`)
+   */
+  struct StatisticsHandler {
+    //! \brief a simple alias
+    using OutputStatus = ::mfront::gpb::OutputStatus;
+    //! \brief a simple alias
+    using Statistics = AtomicBatchStatistics;
+    //! \return the statistics of a batch without event
+    constexpr BatchStatistics initial() const noexcept {
+      return {.rdt = this->rdt0};
+    }
+    /*!
+     * \return true: the integration at a point may always fail or reduce
+     * the time step scaling factor
+     */
+    constexpr bool hasEvents() const noexcept { return true; }
+    //! \brief initialize the statistics updated by the devices
+    void initialize(Statistics& s) const noexcept {
+      mfront_gpb_initializeStatistics(&s, this->rdt0);
+    }
+    /*!
+     * \brief report the statistics updated by the devices, once the
+     * computations are completed
+     * \return the status
+     * \param[out] s: output status
+     * \param[in] r: statistics, read on the host
+     */
+    int report(OutputStatus& s, const Statistics& r) const noexcept {
+      return gpb::report(s, getBatchStatistics(r));
+    }
+    /*!
+     * \brief report the statistics of a batch combined by a reduction or,
+     * if the calling code gave statistics, accumulate them in those
+     * statistics (see `mfront_gpb_BatchData`)
+     * \return the status
+     * \param[in,out] s: output status
+     * \param[in] given: statistics given by the calling code, or null
+     * \param[in] r: statistics of the batch
+     */
+    int report(OutputStatus& s,
+               Statistics* const given,
+               const BatchStatistics& r) const noexcept {
+      if (given == nullptr) {
+        return gpb::report(s, r);
+      }
+      // as with the backends updating the statistics by atomic operations,
+      // the time step scaling factor of the statistics is only lowered by
+      // the points which decreased the initial value of the batch
+      accumulate(*given, r, r.rdt < this->rdt0);
+      return s.status;
+    }
+    //! \brief initial value of the time step scaling factor of the batch
+    real rdt0;
+  };  // end of struct StatisticsHandler
+
+  /*!
+   * \brief analyse the statistics of a batch once the computations are
+   * completed (body of the `<name>_generic_parallel_report` functions)
+   * \return the status
+   * \param[out] s: output status
+   * \param[in] statistics: statistics of the batch, read on the host
+   */
+  inline int reportStatistics(
+      OutputStatus& s, const AtomicBatchStatistics* const statistics) noexcept {
+    if (statistics == nullptr) {
+      s.number_of_failures = 0;
+      s.first_failure_index = no_failure_index;
+      s.number_of_unreliable_results = 0;
+      s.first_unreliable_result_index = no_failure_index;
+      s.rdt = 1;
+      return report(s, -5, "no statistics given");
+    }
+    return report(s, getBatchStatistics(*statistics));
+  }  // end of reportStatistics
+
+  /*!
+   * \brief initialize an output status: success, no failure
+   * \param[out] s: output status
+   * \param[in] rdt: time step scaling factor
+   */
+  inline void initialize(OutputStatus& s, const real rdt) noexcept {
+    s.status = 1;
+    s.number_of_failures = 0;
+    s.first_failure_index = no_failure_index;
+    s.number_of_unreliable_results = 0;
+    s.first_unreliable_result_index = no_failure_index;
+    s.rdt = rdt;
+    s.msg[0] = '\0';
+  }  // end of initialize
+
+  /*!
+   * \brief check the consistency of the batch data. The output status is
+   * initialized.
+   * \tparam PointTraits: description of the data of an integration point
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \return true if the batch data are valid
+   */
+  template <typename PointTraits>
+  bool check(OutputStatus& s, const BatchData& d) noexcept {
+    constexpr auto sizes = PointDataSizes{PointTraits::value};
+    initialize(s, d.rdt);
+    const auto n = d.number_of_points;
+    // the index of a point is stored in 48 bits of the keys of the
+    // statistics
+    if (static_cast<unsigned long long>(n) >
+        ::mfront::generic_parallel::maximal_number_of_points) {
+      report(s, -5, "too many points");
+      return false;
+    }
+    if (n == 0) {
+      // nothing is read or written: the fields of an empty batch may be
+      // null (for example, the data of an empty `std::vector`)
+      return true;
+    }
+    auto check_input = [&s](const ConstField& f, const size_type size,
+                            const std::string_view name) {
+      if ((size != 0) && (f.values == nullptr)) {
+        report(s, -5, name);
+        return false;
+      }
+      return true;
+    };
+    // material properties and external state variables, given as a group
+    // or variable by variable
+    auto check_inputs = [&s, &check_input](const ConstField& f,
+                                           const ConstField* const by_variable,
+                                           const auto& variables_sizes,
+                                           const size_type size,
+                                           const std::string_view name) {
+      if (by_variable == nullptr) {
+        return check_input(f, size, name);
+      }
+      for (std::size_t v = 0; v != variables_sizes.size(); ++v) {
+        if ((variables_sizes[v] != 0) && (by_variable[v].values == nullptr)) {
+          report(s, -5, name);
+          return false;
+        }
+      }
+      return true;
+    };
+    constexpr const auto& mps = PointTraits::material_properties_sizes;
+    constexpr const auto& esvs = PointTraits::external_state_variables_sizes;
+    auto check_output = [&s, n](const auto& f, const size_type size,
+                                const bool required,
+                                const std::string_view name) {
+      if (size == 0) {
+        return true;
+      }
+      if ((required) && (f.values == nullptr)) {
+        report(s, -5, name);
+        return false;
+      }
+      if ((f.values != nullptr) && (f.point_stride == 0) && (n > 1)) {
+        report(s, -5, name);
+        return false;
+      }
+      return true;
+    };
+    const auto o = getComputationOptions(d);
+    const auto tangent_operator_required =
+        o.isPredictionRequested() || o.isTangentOperatorRequested();
+    return check_input(d.s0.gradients, sizes.gradients,
+                       "missing gradients at the beginning of the time "
+                       "step") &&
+           check_input(d.s1.gradients, sizes.gradients,
+                       "missing gradients at the end of the time step") &&
+           check_input(d.s0.thermodynamic_forces, sizes.thermodynamic_forces,
+                       "missing thermodynamic forces at the beginning of the "
+                       "time step") &&
+           check_inputs(d.s0.material_properties,
+                        d.s0.material_properties_by_variable, mps,
+                        sizes.material_properties,
+                        "missing material properties at the beginning of the "
+                        "time step") &&
+           check_inputs(d.s1.material_properties,
+                        d.s1.material_properties_by_variable, mps,
+                        sizes.material_properties,
+                        "missing material properties at the end of the time "
+                        "step") &&
+           check_input(d.s0.internal_state_variables,
+                       sizes.internal_state_variables,
+                       "missing internal state variables at the beginning "
+                       "of the time step") &&
+           check_inputs(d.s0.external_state_variables,
+                        d.s0.external_state_variables_by_variable, esvs,
+                        sizes.external_state_variables,
+                        "missing external state variables at the beginning "
+                        "of the time step") &&
+           check_inputs(d.s1.external_state_variables,
+                        d.s1.external_state_variables_by_variable, esvs,
+                        sizes.external_state_variables,
+                        "missing external state variables at the end of the "
+                        "time step") &&
+           check_input(d.s0.mass_density, o.speed_of_sound ? 1 : 0,
+                       "missing mass density at the beginning of the time "
+                       "step") &&
+           check_input(d.s1.mass_density, o.speed_of_sound ? 1 : 0,
+                       "missing mass density at the end of the time step") &&
+           check_output(d.s1.thermodynamic_forces, sizes.thermodynamic_forces,
+                        true, "invalid thermodynamic forces") &&
+           check_output(d.s1.internal_state_variables,
+                        sizes.internal_state_variables, true,
+                        "invalid internal state variables") &&
+           check_output(d.tangent_operators, sizes.tangent_operator,
+                        tangent_operator_required,
+                        "invalid tangent operators") &&
+           check_output(d.s1.stored_energy, 1, false,
+                        "invalid stored energies") &&
+           check_output(d.s1.dissipated_energy, 1, false,
+                        "invalid dissipated energies") &&
+           check_output(d.rdts, 1, false,
+                        "invalid time step scaling factors") &&
+           check_output(d.speed_of_sound, 1, o.speed_of_sound,
+                        "invalid speeds of sound");
+  }  // end of check
+
+  /*!
+   * \brief check the computation options of the integration of a batch,
+   * for the behaviours whose integrator validates them (finite strain
+   * behaviours). Invalid options are an error of the calling code, reported
+   * for the whole batch, and not an integration failure at every point.
+   * \tparam PointTraits: description of the data of an integration point
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \return true if the computation options are valid
+   */
+  template <typename PointTraits>
+  bool checkComputationOptions(OutputStatus& s, const BatchData& d) noexcept {
+    using Integrator = typename PointTraits::Integrator;
+    if constexpr (requires(const ComputationOptions& o) {
+                    Integrator::checkComputationOptions(o);
+                  }) {
+      if (!Integrator::checkComputationOptions(getComputationOptions(d))) {
+        report(s, -5, "invalid computation options");
+        return false;
+      }
+    }
+    return true;
+  }  // end of checkComputationOptions
+
+  /*!
+   * \return the field pointed by the given pointer, or an empty field if
+   * this pointer is null
+   * \param[in] f: pointer to the field
+   */
+  template <typename FieldType>
+  constexpr FieldType getField(const FieldType* const f) noexcept {
+    return f == nullptr ? FieldType{} : *f;
+  }  // end of getField
+
+  /*!
+   * \brief check that a field holding the inputs or the outputs of an
+   * initialize function or a post-processing is valid
+   * \return true if the field is valid
+   * \param[out] s: output status
+   * \param[in] f: field
+   * \param[in] n: number of values of the field at one point
+   * \param[in] name: description of the field
+   */
+  template <typename FieldType>
+  bool checkValues(OutputStatus& s,
+                   const FieldType& f,
+                   const size_type n,
+                   const std::string_view name) noexcept {
+    if ((n != 0) && (f.values == nullptr)) {
+      report(s, -5, name);
+      return false;
+    }
+    return true;
+  }  // end of checkValues
+
+  /*!
+   * \brief data shared by the function objects applied at the points of a
+   * batch (see `PointIntegrator`, `InitializeFunctionExecutor`,
+   * `PostProcessingExecutor`).
+   *
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam ParametersType: type of the structure holding the parameters
+   */
+  template <typename PointTraits, typename ParametersType>
+  struct PointFunctionData {
+    //! \brief batch data
+    BatchData data;
+    //! \brief fields of the material properties and of the external state
+    //! variables
+    InputFields<PointTraits> input_fields;
+    //! \brief values of the parameters
+    ParametersType parameters;
+    //! \brief out of bounds policy
+    tfel::material::OutOfBoundsPolicy policy;
+  };
+
+  /*!
+   * \brief function object integrating the behaviour at one point of a batch
+   * and returning the associated statistics.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam ParametersType: type of the structure holding the parameters
+   */
+  template <typename Behaviour, typename PointTraits, typename ParametersType>
+  struct PointIntegrator : PointFunctionData<PointTraits, ParametersType> {
+    //! \return the statistics of the integration at the `i`-th point
+    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
+      return getPointStatistics(i, integrate<Behaviour, PointTraits>(
+                                       this->data, this->input_fields, i,
+                                       this->parameters, this->policy));
+    }
+  };
+
+  /*!
+   * \return the data shared by the function objects applied at the points of
+   * a batch
+   * \param[in] d: batch data
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   */
+  template <typename PointTraits, typename ParametersType>
+  PointFunctionData<PointTraits, ParametersType> makePointFunctionData(
+      const BatchData& d,
+      const ParametersType& parameters,
+      const tfel::material::OutOfBoundsPolicy p) {
+    return {d, makeInputFields<PointTraits>(d), parameters, p};
+  }  // end of makePointFunctionData
+
+  /*!
+   * \brief function object executing an initialize function at one point of
+   * a batch and returning the associated statistics. The internal state
+   * variables (and the thermodynamic forces) at the end of the time step
+   * are the outputs.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam InitializeFunction: function object calling the method
+   * implementing the initialize function
+   * \tparam number_of_inputs: number of values of the inputs of the
+   * initialize function
+   * \tparam ParametersType: type of the structure holding the parameters
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename InitializeFunction,
+            size_type number_of_inputs,
+            typename ParametersType>
+  struct InitializeFunctionExecutor
+      : PointFunctionData<PointTraits, ParametersType> {
+    //! \return the statistics of the execution at the `i`-th point
+    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
+      return this->execute(i);
+    }
+    /*!
+     * \return the statistics of the execution at the `i`-th point (see
+     * `MFRONT_GPB_NVHPC_STDPAR_NOINLINE`)
+     */
+    MFRONT_GPB_NVHPC_STDPAR_NOINLINE TFEL_HOST_DEVICE BatchStatistics
+    execute(const size_type i) const {
+      using Integrator = typename PointTraits::Integrator;
+      const auto& d = this->data;
+      const auto o = getComputationOptions(d);
+      auto r = PointResult{.status = -1, .rdt = d.rdt};
+      {
+        // the initialize function may only update a part of the state
+        auto v = PointView<PointTraits>(
+            d, this->input_fields, i,
+            Integrator::template getPointDataSizes<PointTraits>(o), d.rdt,
+            true);
+        auto values = LocalValues<number_of_inputs>{};
+        internals::gather(values, this->inputs, i, number_of_inputs);
+        const auto status =
+            Integrator::template executeInitializeFunction<Behaviour,
+                                                           InitializeFunction>(
+                v.data, values.data(), o, this->policy, this->parameters);
+        if (status != -1) {
+          v.scatterState();
+          r.status = 1;
+        }
+      }
+      recordStatus(d, i, r);
+      return getPointStatistics(i, r);
+    }
+    //! \brief values of the inputs of the initialize function
+    ConstField inputs;
+  };
+
+  /*!
+   * \brief function object executing a post-processing at one point of a
+   * batch and returning the associated statistics.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam PostProcessing: function object calling the method
+   * implementing the post-processing
+   * \tparam use_initial_state: boolean stating if the post-processing uses
+   * the initial state of the material
+   * \tparam number_of_outputs: number of values of the outputs of the
+   * post-processing
+   * \tparam ParametersType: type of the structure holding the parameters
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename PostProcessing,
+            bool use_initial_state,
+            size_type number_of_outputs,
+            typename ParametersType>
+  struct PostProcessingExecutor
+      : PointFunctionData<PointTraits, ParametersType> {
+    //! \return the statistics of the execution at the `i`-th point
+    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
+      using Integrator = typename PointTraits::Integrator;
+      const auto& d = this->data;
+      const auto o = getComputationOptions(d);
+      auto r = PointResult{.status = -1, .rdt = d.rdt};
+      {
+        // the post-processing uses the state at the end of the time step
+        auto v = PointView<PointTraits>(
+            d, this->input_fields, i,
+            Integrator::template getPointDataSizes<PointTraits>(o), d.rdt,
+            true);
+        auto values = LocalValues<number_of_outputs>{};
+        // the outputs are written and read through the same pointer
+        auto* const point_outputs = values.data();
+        const auto status = Integrator::template executePostProcessing<
+            Behaviour, PostProcessing, use_initial_state>(
+            point_outputs, v.data, o, this->policy, this->parameters);
+        if (status != -1) {
+          internals::scatterValues<number_of_outputs>(
+              this->outputs, i, point_outputs, number_of_outputs);
+          r.status = 1;
+        }
+      }
+      recordStatus(d, i, r);
+      return getPointStatistics(i, r);
+    }
+    //! \brief values of the outputs of the post-processing
+    Field outputs;
+  };
+
+  /*!
+   * \brief function object rotating the values of the `i`-th point of a
+   * batch and returning the associated statistics.
+   *
+   * \tparam PointRotation: function object rotating the values of a point,
+   * called as `f(dest, src, rv)` with the arguments of the rotation functions
+   * of the `generic` interface, and whose static member `size` is the number
+   * of values of a point.
+   */
+  template <typename PointRotation>
+  struct RotationExecutor {
+    //! \return the statistics of the rotation at the `i`-th point
+    TFEL_HOST_DEVICE BatchStatistics operator()(const size_type i) const {
+      constexpr auto n = static_cast<size_type>(PointRotation::size);
+      auto src = LocalValues<n>{};
+      auto dest = LocalValues<n>{};
+      auto rv = LocalValues<9>{};
+      internals::gather(src, this->data.source, i, n);
+      internals::gather(rv, this->data.rotation_matrices, i, 9);
+      PointRotation{}(dest.data(), src.data(), rv.data());
+      internals::scatter(this->data.destination, i, dest, n);
+      return getPointStatistics(i, PointResult{.status = 1, .rdt = 1});
+    }
+    //! \brief rotation data
+    RotationData data;
+  };
+
+  /*!
+   * \brief initialize the output status and check the data of a rotation
+   * \return true if the data are valid
+   * \param[out] s: output status
+   * \param[in] d: rotation data
+   */
+  inline bool checkRotationData(OutputStatus& s,
+                                const RotationData& d) noexcept {
+    initialize(s, 1);
+    if (static_cast<unsigned long long>(d.number_of_points) >
+        ::mfront::generic_parallel::maximal_number_of_points) {
+      report(s, -5, "too many points");
+      return false;
+    }
+    if ((d.number_of_points != 0) &&
+        ((d.destination.values == nullptr) || (d.source.values == nullptr) ||
+         (d.rotation_matrices.values == nullptr))) {
+      report(s, -5, "invalid rotation data");
+      return false;
+    }
+    return true;
+  }  // end of checkRotationData
+
+  /*!
+   * \brief integrate the behaviour at the points of a batch with the
+   * primitive of a backend.
+   *
+   * The functions of this kind (`executeInitializeFunctionOnBatch`,
+   * `executePostProcessingOnBatch`, `rotateBatch`) check the data, choose
+   * the function object applied at each point and call the primitive of the
+   * backend, which is the only part specific to a backend.
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam ParametersType: type of the structure holding the parameters
+   * \tparam Apply: callable object such that `apply(s, n, e, h, f)` applies
+   * the function object `f` at the `n` points of a batch with the execution
+   * `e` (see `BatchExecution`) and reports the statistics in the output
+   * status `s` through the handler `h` (see `StatisticsHandler`), and
+   * returns the status
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   * \param[in] apply: primitive of the backend
+   * \return the status
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename ParametersType,
+            typename Apply>
+  int integrateBatch(OutputStatus& s,
+                     const BatchData& d,
+                     const ParametersType& parameters,
+                     const tfel::material::OutOfBoundsPolicy p,
+                     const Apply& apply) {
+    if ((!check<PointTraits>(s, d)) ||
+        (!checkComputationOptions<PointTraits>(s, d))) {
+      return s.status;
+    }
+    using Integrator = PointIntegrator<Behaviour, PointTraits, ParametersType>;
+    const auto data = makePointFunctionData<PointTraits>(d, parameters, p);
+    return apply(s, d.number_of_points, getBatchExecution(d),
+                 StatisticsHandler{.rdt0 = d.rdt}, Integrator{data});
+  }  // end of integrateBatch
+
+  /*!
+   * \brief execute an initialize function at the points of a batch with the
+   * primitive of a backend (see `integrateBatch`).
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam InitializeFunction: function object calling the method
+   * implementing the initialize function
+   * \tparam number_of_inputs: number of values of the inputs
+   * \param[out] s: output status
+   * \param[in] d: batch data
+   * \param[in] inputs: values of the inputs of the initialize function
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   * \param[in] apply: primitive of the backend
+   * \return the status
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename InitializeFunction,
+            size_type number_of_inputs,
+            typename ParametersType,
+            typename Apply>
+  int executeInitializeFunctionOnBatch(
+      OutputStatus& s,
+      const BatchData& d,
+      const ConstField& inputs,
+      const ParametersType& parameters,
+      const tfel::material::OutOfBoundsPolicy p,
+      const Apply& apply) {
+    const auto nv = d.number_of_points == 0 ? 0 : number_of_inputs;
+    if ((!check<PointTraits>(s, d)) ||
+        (!checkValues(s, inputs, nv, "invalid inputs"))) {
+      return s.status;
+    }
+    using Executor =
+        InitializeFunctionExecutor<Behaviour, PointTraits, InitializeFunction,
+                                   number_of_inputs, ParametersType>;
+    const auto data = makePointFunctionData<PointTraits>(d, parameters, p);
+    return apply(s, d.number_of_points, getBatchExecution(d),
+                 StatisticsHandler{.rdt0 = d.rdt}, Executor{data, inputs});
+  }  // end of executeInitializeFunctionOnBatch
+
+  /*!
+   * \brief execute a post-processing at the points of a batch with the
+   * primitive of a backend (see `integrateBatch`).
+   *
+   * \tparam Behaviour: class implementing the behaviour
+   * \tparam PointTraits: description of the data of an integration point
+   * \tparam PostProcessing: function object calling the method
+   * implementing the post-processing
+   * \tparam use_initial_state: boolean stating if the post-processing uses
+   * the initial state of the material
+   * \tparam number_of_outputs: number of values of the outputs
+   * \param[out] s: output status
+   * \param[out] outputs: values of the outputs of the post-processing
+   * \param[in] d: batch data
+   * \param[in] parameters: values of the parameters
+   * \param[in] p: out of bounds policy
+   * \param[in] apply: primitive of the backend
+   * \return the status
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename PostProcessing,
+            bool use_initial_state,
+            size_type number_of_outputs,
+            typename ParametersType,
+            typename Apply>
+  int executePostProcessingOnBatch(OutputStatus& s,
+                                   const Field& outputs,
+                                   const BatchData& d,
+                                   const ParametersType& parameters,
+                                   const tfel::material::OutOfBoundsPolicy p,
+                                   const Apply& apply) {
+    const auto nv = d.number_of_points == 0 ? 0 : number_of_outputs;
+    if ((!check<PointTraits>(s, d)) ||
+        (!checkValues(s, outputs, nv, "invalid outputs"))) {
+      return s.status;
+    }
+    using Executor = PostProcessingExecutor<Behaviour, PointTraits,
+                                            PostProcessing, use_initial_state,
+                                            number_of_outputs, ParametersType>;
+    const auto data = makePointFunctionData<PointTraits>(d, parameters, p);
+    return apply(s, d.number_of_points, getBatchExecution(d),
+                 StatisticsHandler{.rdt0 = d.rdt}, Executor{data, outputs});
+  }  // end of executePostProcessingOnBatch
+
+  /*!
+   * \brief rotate the values of the points of a batch of an orthotropic
+   * behaviour with the primitive of a backend (see `integrateBatch`).
+   *
+   * \tparam PointRotation: function object rotating the values of a point
+   * (see `RotationExecutor`)
+   * \param[out] s: output status
+   * \param[in] d: rotation data
+   * \param[in] apply: primitive of the backend
+   * \return the status
+   */
+  template <typename PointRotation, typename Apply>
+  int rotateBatch(OutputStatus& s, const RotationData& d, const Apply& apply) {
+    if (!checkRotationData(s, d)) {
+      return s.status;
+    }
+    return apply(s, d.number_of_points, getBatchExecution(d),
+                 StatisticsHandler{.rdt0 = 1},
+                 RotationExecutor<PointRotation>{d});
+  }  // end of rotateBatch
+
+  /*!
+   * \brief copies of a data shared by all the integration points (see the
+   * `@SharedData` keyword) in the memories of the devices used by a
+   * process, one per device. The copies are never freed.
+   * \tparam T: type of the data
+   * \tparam Device: type identifying a device, comparable with `==`
+   */
+  template <typename T, typename Device>
+  struct SharedDataCopies {
+    /*!
+     * \return the copy on the given device
+     * \param[in] d: device
+     * \param[in] copy: function making a copy on this device, called at the
+     * first request for this device
+     */
+    template <typename CopyFunction>
+    const T* get(const Device& d, const CopyFunction& copy) {
+      const auto lock = std::lock_guard{this->mutex};
+      for (const auto& [device, p] : this->copies) {
+        if (device == d) {
+          return p;
+        }
+      }
+      return this->copies.emplace_back(d, copy()).second;
+    }
+
+   private:
+    //! \brief mutex protecting the copies
+    std::mutex mutex;
+    //! \brief copies, by device
+    std::vector<std::pair<Device, const T*>> copies;
+  };
+
+  /*!
+   * \return a copy of a data shared by all the integration points (see the
+   * `@SharedData` keyword), allocated on the heap at the first call. The
+   * heap must be accessible by the device if the computations are offloaded
+   * (unified or managed memory, as with the `stlpar` backend of `nvc++`).
+   * The copy is never freed.
+   * \tparam get_shared_data: function returning the data
+   */
+  template <auto get_shared_data>
+  const auto* getSharedDataCopy() {
+    using T = std::remove_cvref_t<decltype(get_shared_data())>;
+    static const auto* const p = new T(get_shared_data());
+    return p;
+  }  // end of getSharedDataCopy
+
+  /*!
+   * \brief call the body of a generated function (see
+   * `mfront::generic_parallel::handleExceptions`). The output status is
+   * complete even if an exception is thrown before the batch data are
+   * checked.
+   * \return the status, `-5` (invalid argument) if no output status is given
+   * \param[out] s: output status
+   * \param[in] f: function
+   */
+  template <typename Function>
+  int handleExceptions(OutputStatus* const s, Function&& f) noexcept {
+    return ::mfront::generic_parallel::handleExceptions(
+        s, [](OutputStatus& o) { initialize(o, 1); },
+        std::forward<Function>(f));
+  }  // end of handleExceptions
+
+}  // end of namespace mfront::gpb
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_INTEGRATE_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx b/mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx
new file mode 100644
index 000000000..126f06fa0
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx
@@ -0,0 +1,84 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/ModelIntegrator.hxx
+ * \brief  This file implements the integration strategy of the standalone
+ * models treated by the `generic-parallel` interface.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_MODELINTEGRATOR_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_MODELINTEGRATOR_HXX
+
+#include "MFront/GenericBehaviour/Integrate.hxx"
+#include "MFront/GenericParallelBehaviour/Integrate.hxx"
+
+namespace mfront::gpb {
+
+  /*!
+   * \brief integration strategy of the standalone models, which are treated
+   * as behaviours without gradients: the outputs of the model are the
+   * internal state variables and its inputs are the external state
+   * variables. The model is built from the behaviour data of a point and
+   * from the values of its parameters, then its functions are executed.
+   */
+  struct ModelIntegrator {
+    /*!
+     * \brief the model is executed and the state at the end of the time
+     * step is updated whatever the computation options, as in the `generic`
+     * interface of the models (see `updatesStateOnPrediction`)
+     */
+    static constexpr bool updates_state_on_prediction = true;
+    /*!
+     * \return the sizes of the data of a point
+     * \tparam PointTraits: description of the data of a point
+     */
+    template <typename PointTraits>
+    TFEL_HOST_DEVICE static constexpr PointDataSizes getPointDataSizes(
+        const ComputationOptions&) noexcept {
+      return PointDataSizes{PointTraits::value};
+    }  // end of getPointDataSizes
+    /*!
+     * \brief execute the model at one point
+     * \return 1 on success, -1 otherwise. On failure, the time step scaling
+     * factor is set to 0.1, as in the `generic` interface for models. On the
+     * host, the exceptions thrown by the model are reported as failures.
+     *
+     * A model has no prediction operator: as in the `generic` interface of
+     * the models, the model is also executed if a prediction is requested.
+     *
+     * \tparam Model: class implementing the model
+     * \tparam ParametersType: type of the structure holding the parameters
+     * \param[in,out] d: behaviour data
+     * \param[in] o: computation options, not used: the model is executed
+     * whatever the type of computation
+     * \param[in] p: out of bounds policy, applied by the model
+     * \param[in] parameters: values of the parameters
+     */
+    template <typename Model, typename ParametersType>
+    TFEL_HOST_DEVICE static int integrate(
+        mfront::gb::BehaviourData& d,
+        const ComputationOptions&,
+        const tfel::material::OutOfBoundsPolicy p,
+        const ParametersType& parameters) {
+      // on the host, the exceptions thrown by the model (bounds checks,
+      // material laws) are reported as failures
+      const auto status =
+          mfront::gb::callAndReportExceptions(d, [&d, &parameters, p] {
+            const auto m = Model(d, parameters, p);
+            return m.execute(d) ? 1 : -1;
+          });
+      if (status == -1) {
+        *(d.rdt) = real{0.1};
+      }
+      return status;
+    }  // end of integrate
+  };
+
+}  // end of namespace mfront::gpb
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_MODELINTEGRATOR_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/SYCL.hxx b/mfront/include/MFront/GenericParallelBehaviour/SYCL.hxx
new file mode 100644
index 000000000..bcf1478bc
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/SYCL.hxx
@@ -0,0 +1,370 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/SYCL.hxx
+ * \brief  This file declares the functions of the `sycl` backend of the
+ * `generic-parallel` behaviour interface which are specific to the
+ * behaviours: transfer of the fields of the batches and copies of the shared
+ * data. The primitive of the backend is declared in
+ * `MFront/GenericParallel/SYCL.hxx`.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_SYCL_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_SYCL_HXX
+
+#include <cstddef>
+#include <cstring>
+#include <optional>
+#include <stdexcept>
+#include <type_traits>
+#include <utility>
+#include <vector>
+#include <sycl/sycl.hpp>
+#include "MFront/GenericParallel/SYCL.hxx"
+#include "MFront/GenericParallel/SYCLDeviceCopies.hxx"
+#include "MFront/GenericParallelBehaviour/Integrate.hxx"
+
+namespace mfront::gpb::sycl {
+
+  //! \brief policy for the transfer of the fields of a batch
+  using mfront::generic_parallel::sycl::DataTransferPolicy;
+
+  namespace internals {
+
+    //! \brief copies of the fields which are not accessible by the device
+    using mfront::generic_parallel::sycl::DeviceCopies;
+
+    /*!
+     * \brief batch data whose fields are accessible by the device
+     * associated with a queue. With the `AUTOMATIC` data transfer policy,
+     * the fields which are not accessible are copied in device memory. The
+     * outputs must be copied back by calling the `copyOutputs` method.
+     * \tparam PointTraits: description of the data of an integration point
+     */
+    template <typename PointTraits>
+    struct DeviceBatchData : DeviceCopies {
+      /*!
+       * \brief constructor
+       * \param[in] q: queue
+       * \param[in] d: batch data
+       * \param[in] p: policy for the transfer of the fields
+       */
+      DeviceBatchData(::sycl::queue& q,
+                      const BatchData& d,
+                      const DataTransferPolicy p)
+          : DeviceCopies(q, d.number_of_points, p), data(d) {
+        // the sizes of the thermodynamic forces and of the tangent operator
+        // of the finite strain behaviours depend on the computation options
+        using Integrator = typename PointTraits::Integrator;
+        const auto sizes = Integrator::template getPointDataSizes<PointTraits>(
+            getComputationOptions(d));
+        auto& s0 = this->data.s0;
+        auto& s1 = this->data.s1;
+        this->transfer(s0.gradients, sizes.gradients, false);
+        this->transfer(s1.gradients, sizes.gradients, false);
+        this->transfer(s0.thermodynamic_forces, sizes.thermodynamic_forces,
+                       false);
+        this->transfer(s1.thermodynamic_forces, sizes.thermodynamic_forces,
+                       true);
+        this->transfer(s0.mass_density, 1, false);
+        this->transfer(s1.mass_density, 1, false);
+        // the fields of a group given variable by variable are ignored
+        if (s0.material_properties_by_variable == nullptr) {
+          this->transfer(s0.material_properties, sizes.material_properties,
+                         false);
+        }
+        if (s1.material_properties_by_variable == nullptr) {
+          this->transfer(s1.material_properties, sizes.material_properties,
+                         false);
+        }
+        this->transfer(s0.internal_state_variables,
+                       sizes.internal_state_variables, false);
+        this->transfer(s1.internal_state_variables,
+                       sizes.internal_state_variables, true);
+        this->transfer(s0.stored_energy, 1, false);
+        this->transfer(s1.stored_energy, 1, true);
+        this->transfer(s0.dissipated_energy, 1, false);
+        this->transfer(s1.dissipated_energy, 1, true);
+        if (s0.external_state_variables_by_variable == nullptr) {
+          this->transfer(s0.external_state_variables,
+                         sizes.external_state_variables, false);
+        }
+        if (s1.external_state_variables_by_variable == nullptr) {
+          this->transfer(s1.external_state_variables,
+                         sizes.external_state_variables, false);
+        }
+        constexpr const auto& mps = PointTraits::material_properties_sizes;
+        constexpr const auto& esvs =
+            PointTraits::external_state_variables_sizes;
+        this->transferVariables(s0.material_properties_by_variable, mps,
+                                this->material_properties0);
+        this->transferVariables(s1.material_properties_by_variable, mps,
+                                this->material_properties1);
+        this->transferVariables(s0.external_state_variables_by_variable, esvs,
+                                this->external_state_variables0);
+        this->transferVariables(s1.external_state_variables_by_variable, esvs,
+                                this->external_state_variables1);
+        this->transfer(this->data.tangent_operators, sizes.tangent_operator,
+                       true);
+        this->transfer(this->data.rdts, 1, true);
+        this->transfer(this->data.speed_of_sound, 1, true);
+        this->transfer(this->data.statuses, this->data.number_of_points, true);
+        this->transfer(this->data.statistics, 1, true);
+      }
+      //! \brief batch data whose fields are accessible by the device
+      BatchData data;
+
+     private:
+      /*!
+       * \brief copy in device memory the fields of the variables of a group
+       * given variable by variable which are not accessible by the device
+       * \param[in,out] fields: fields of the variables, replaced by the
+       * fields referring to the copies (this array is only read on the host)
+       * \param[in] sizes: number of components of each variable
+       * \param[out] copies: storage of the fields referring to the copies,
+       * only filled if a field is copied
+       */
+      template <std::size_t N>
+      void transferVariables(const ConstField*& fields,
+                             const std::array<size_type, N>& sizes,
+                             std::vector<ConstField>& copies) {
+        if ((fields == nullptr) || (!this->isEnabled())) {
+          return;
+        }
+        auto accessible = true;
+        for (std::size_t v = 0; (v != N) && (accessible); ++v) {
+          accessible = (fields[v].values == nullptr) || (sizes[v] == 0) ||
+                       (this->isAccessible(fields[v].values));
+        }
+        if (accessible) {
+          return;
+        }
+        copies.assign(fields, fields + N);
+        for (std::size_t v = 0; v != N; ++v) {
+          this->transfer(copies[v], sizes[v], false);
+        }
+        fields = copies.data();
+      }
+      //! \brief fields of the material properties, variable by variable
+      std::vector<ConstField> material_properties0, material_properties1;
+      //! \brief fields of the external state variables, variable by variable
+      std::vector<ConstField> external_state_variables0,
+          external_state_variables1;
+    };
+
+  }  // end of namespace internals
+
+  /*!
+   * \return a copy of a data in the memory of the device associated with a
+   * queue
+   * \param[in] v: data
+   * \param[in] q: queue
+   */
+  template <typename T>
+  const T* copyToDevice(const T& v, ::sycl::queue& q) {
+    static_assert(std::is_trivially_copyable_v<T>,
+                  "the shared data must be trivially copyable");
+    auto* const p = ::sycl::malloc_device<T>(1, q);
+    if (p == nullptr) {
+      throw std::runtime_error("memory allocation failed on the SYCL device");
+    }
+    q.copy(&v, p, 1).wait_and_throw();
+    return p;
+  }  // end of copyToDevice
+
+  /*!
+   * \return a copy of a data shared by all the integration points (see the
+   * `@SharedData` keyword) in the memory of the device associated with the
+   * queue of the execution policy. A copy is made at the first call for
+   * each device and context, and is never freed.
+   * \return the copy, or a null pointer if the policy is invalid (the call
+   * reports this invalid argument before any computation)
+   * \tparam get_shared_data: function returning the data
+   * \param[in] policy: execution policy
+   */
+  template <auto get_shared_data>
+  const auto* getSharedDataCopy(
+      const mfront_gp_AbstractBackendExecutionPolicy* const policy) {
+    using T = std::remove_cvref_t<decltype(get_shared_data())>;
+    using Device = std::pair<::sycl::device, ::sycl::context>;
+    static auto copies = SharedDataCopies<T, Device>{};
+    const auto p =
+        mfront::generic_parallel::sycl::checkExecutionPolicy(policy, true);
+    if (p.error != nullptr) {
+      return static_cast<const T*>(nullptr);
+    }
+    auto q = p.policy->queue;
+    return copies.get(Device{q.get_device(), q.get_context()},
+                      [&q] { return copyToDevice(get_shared_data(), q); });
+  }  // end of getSharedDataCopy
+
+  namespace internals {
+
+    /*!
+     * \brief call a function with batch data whose fields are accessible by
+     * the device associated with the queue of the batch (see
+     * `DeviceBatchData`), and copy the outputs back. If some fields were
+     * copied, this function waits for the completion of the computations.
+     * \param[out] s: output status
+     * \param[in] d: batch data
+     * \param[in] transfers: policy for the transfer of the fields
+     * \param[in] call: function called with the batch data and the copies,
+     * which allow to transfer additional fields
+     * \return the status
+     */
+    template <typename PointTraits, typename Function>
+    int callWithDeviceData(OutputStatus& s,
+                           const BatchData& d,
+                           const DataTransferPolicy transfers,
+                           Function&& call) {
+      const auto p = mfront::generic_parallel::sycl::checkExecutionPolicy(
+          d.execution_policy, d.statistics != nullptr);
+      if (p.error != nullptr) {
+        initialize(s, d.rdt);
+        // the policy is only needed to transfer the fields: an empty batch
+        // is accepted without any check of the policy, as with the other
+        // backends
+        if (d.number_of_points == 0) {
+          return s.status;
+        }
+        return report(s, -5, p.error);
+      }
+      auto q = p.policy->queue;
+      auto dd = DeviceBatchData<PointTraits>(q, d, transfers);
+      const auto r = call(dd.data, static_cast<DeviceCopies&>(dd));
+      dd.copyOutputs();
+      return r;
+    }  // end of callWithDeviceData
+
+  }  // end of namespace internals
+
+  /*!
+   * \brief integrate the behaviour at the points of a batch (see
+   * `mfront::gpb::integrateBatch`).
+   *
+   * The execution policy must be a `SyclBackendExecutionPolicy`. With the
+   * `NONE` data transfer policy, the fields must be accessible by the device
+   * associated with its queue (shared, device or host USM allocations, or
+   * any memory if the device is the host). The computations are
+   * asynchronous if the policy requests it and if no field is copied.
+   *
+   * \param[in] transfers: policy for the transfer of the fields
+   * \param[in] apply: primitive of the backend (see
+   * `mfront::generic_parallel::sycl::makeApply`)
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename ParametersType,
+            typename Apply>
+  int integrateBatch(OutputStatus& s,
+                     const BatchData& d,
+                     const ParametersType& parameters,
+                     const tfel::material::OutOfBoundsPolicy p,
+                     const DataTransferPolicy transfers,
+                     const Apply& apply) {
+    return internals::callWithDeviceData<PointTraits>(
+        s, d, transfers, [&](const BatchData& dd, internals::DeviceCopies&) {
+          return mfront::gpb::integrateBatch<Behaviour, PointTraits>(
+              s, dd, parameters, p, apply);
+        });
+  }  // end of integrateBatch
+
+  /*!
+   * \brief execute an initialize function at the points of a batch (see
+   * `mfront::gpb::executeInitializeFunctionOnBatch` and `integrateBatch`)
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename InitializeFunction,
+            size_type number_of_inputs,
+            typename ParametersType,
+            typename Apply>
+  int executeInitializeFunctionOnBatch(
+      OutputStatus& s,
+      const BatchData& d,
+      const ConstField& inputs,
+      const ParametersType& parameters,
+      const tfel::material::OutOfBoundsPolicy p,
+      const DataTransferPolicy transfers,
+      const Apply& apply) {
+    return internals::callWithDeviceData<PointTraits>(
+        s, d, transfers,
+        [&](const BatchData& dd, internals::DeviceCopies& copies) {
+          auto dinputs = inputs;
+          copies.transfer(dinputs, number_of_inputs, false);
+          return mfront::gpb::executeInitializeFunctionOnBatch<
+              Behaviour, PointTraits, InitializeFunction, number_of_inputs>(
+              s, dd, dinputs, parameters, p, apply);
+        });
+  }  // end of executeInitializeFunctionOnBatch
+
+  /*!
+   * \brief execute a post-processing at the points of a batch (see
+   * `mfront::gpb::executePostProcessingOnBatch` and `integrateBatch`)
+   */
+  template <typename Behaviour,
+            typename PointTraits,
+            typename PostProcessing,
+            bool use_initial_state,
+            size_type number_of_outputs,
+            typename ParametersType,
+            typename Apply>
+  int executePostProcessingOnBatch(OutputStatus& s,
+                                   const Field& outputs,
+                                   const BatchData& d,
+                                   const ParametersType& parameters,
+                                   const tfel::material::OutOfBoundsPolicy p,
+                                   const DataTransferPolicy transfers,
+                                   const Apply& apply) {
+    return internals::callWithDeviceData<PointTraits>(
+        s, d, transfers,
+        [&](const BatchData& dd, internals::DeviceCopies& copies) {
+          auto doutputs = outputs;
+          copies.transfer(doutputs, number_of_outputs, true);
+          return mfront::gpb::executePostProcessingOnBatch<
+              Behaviour, PointTraits, PostProcessing, use_initial_state,
+              number_of_outputs>(s, doutputs, dd, parameters, p, apply);
+        });
+  }  // end of executePostProcessingOnBatch
+
+  /*!
+   * \brief rotate the values of the points of a batch of an orthotropic
+   * behaviour (see `mfront::gpb::rotateBatch` and `integrateBatch`)
+   */
+  template <typename PointRotation, typename Apply>
+  int rotateBatch(OutputStatus& s,
+                  const RotationData& d,
+                  const DataTransferPolicy transfers,
+                  const Apply& apply) {
+    const auto p = mfront::generic_parallel::sycl::checkExecutionPolicy(
+        d.execution_policy, d.statistics != nullptr);
+    if (p.error != nullptr) {
+      initialize(s, 1);
+      // empty batch accepted without any check of the policy (see
+      // `callWithDeviceData`)
+      if (d.number_of_points == 0) {
+        return s.status;
+      }
+      return report(s, -5, p.error);
+    }
+    constexpr auto n = static_cast<size_type>(PointRotation::size);
+    auto q = p.policy->queue;
+    auto copies = internals::DeviceCopies(q, d.number_of_points, transfers);
+    auto dd = d;
+    copies.transfer(dd.source, n, false);
+    copies.transfer(dd.rotation_matrices, 9, false);
+    copies.transfer(dd.destination, n, true);
+    copies.transfer(dd.statistics, 1, true);
+    const auto r = mfront::gpb::rotateBatch<PointRotation>(s, dd, apply);
+    copies.copyOutputs();
+    return r;
+  }  // end of rotateBatch
+
+}  // end of namespace mfront::gpb::sycl
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOUR_SYCL_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviourInterface.hxx b/mfront/include/MFront/GenericParallelBehaviourInterface.hxx
new file mode 100644
index 000000000..f3f753796
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviourInterface.hxx
@@ -0,0 +1,232 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviourInterface.hxx
+ * \brief  This file declares the `generic-parallel` behaviour interface
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX
+
+#include <memory>
+#include <string_view>
+#include "MFront/GenericBehaviourInterface.hxx"
+#include "MFront/GenericBehaviourSymbolsGenerator.hxx"
+
+namespace mfront {
+
+  namespace generic_parallel {
+    // forward declaration
+    struct AbstractBackend;
+  }  // end of namespace generic_parallel
+
+  /*!
+   * \brief an interface integrating a behaviour over a batch of integration
+   * points with a parallel programming model selected by the `backend`
+   * option (`arcane`, `cuda`, `hip`, `kokkos`, `openacc`, `openmp`, `raja`,
+   * `stlpar` or `sycl`), on the host or on a device.
+   *
+   * Integrating a batch is equivalent to calling the function generated by
+   * the `generic` interface at each integration point. This interface reuses
+   * the members added by the `generic` interface to the behaviour class and
+   * adds a constructor taking the values of the parameters as an argument,
+   * since the parameters initializers can't be accessed from device code.
+   */
+  struct MFRONT_VISIBILITY_EXPORT GenericParallelBehaviourInterface
+      : public GenericBehaviourInterface {
+    //! \return the interface name
+    [[nodiscard]] static std::string getName();
+    /*!
+     * \brief write the beginning of a function of the generated library
+     * working on a batch. The exceptions are converted to an error status,
+     * the batch data (`mfront_batch_data`) must be given, and the output
+     * status is initialized. The output status and the batch data are then
+     * available as `mfront_status` and `mfront_data`. An empty batch is
+     * accepted without any check: the generated function returns before
+     * the body, with the status of success. This function is shared with the
+     * `generic-parallel` interface for models.
+     * \param[out] os: output stream
+     * \param[in] f: name of the function
+     * \param[in] arguments: arguments of the function after the output
+     * status
+     * \param[in] captures: captures of those arguments
+     */
+    static void writeBatchFunctionBeginning(std::ostream&,
+                                            std::string_view,
+                                            std::string_view,
+                                            std::string_view);
+    /*!
+     * \return the name of a function of batches of points: the name of the
+     * function of the `generic` interface followed by `_generic_parallel`.
+     * This function is shared with the `generic-parallel` interface for
+     * models.
+     * \param[in] f: name of the function of the `generic` interface
+     */
+    static std::string getBatchFunctionName(std::string_view);
+    /*!
+     * \brief write the declaration of the `<base>_generic_parallel_report`
+     * function, which analyses the statistics of a batch once the
+     * computations are completed. This function is shared with the
+     * `generic-parallel` interface for models.
+     * \param[out] os: output stream
+     * \param[in] base: basis of the names of the functions
+     */
+    static void writeReportFunctionDeclaration(std::ostream&, std::string_view);
+    /*!
+     * \brief write the implementation of the
+     * `<base>_generic_parallel_report` function (see
+     * `writeReportFunctionDeclaration`)
+     * \param[out] os: output stream
+     * \param[in] base: basis of the names of the functions
+     */
+    static void writeReportFunction(std::ostream&, std::string_view);
+    /*!
+     * \return the generator of the symbols of a library. A library also
+     * containing the functions of the `generic` interface
+     * (`generic_functions` option) exports `Generic` as interface, so that
+     * its functions of a point are detected as in a library of the `generic`
+     * interface. This function is shared with the `generic-parallel`
+     * interface for models.
+     * \param[in] generic_functions: true if the library also contains the
+     * functions of the `generic` interface
+     */
+    [[nodiscard]] static std::unique_ptr<GenericBehaviourSymbolsGenerator>
+    makeSymbolsGenerator(const bool);
+    /*!
+     * \brief throw an exception if the given name contains
+     * `_generic_parallel`, which ends the names of the functions of batches
+     * of points and of their metadata. This function is shared with the
+     * `generic-parallel` interface for models.
+     * \param[in] m: calling method
+     * \param[in] n: name of the behaviour or of the model
+     */
+    static void checkName(std::string_view, std::string_view);
+    /*!
+     * \brief write the end of a function started by
+     * `writeBatchFunctionBeginning`
+     * \param[out] os: output stream
+     * \param[in] f: name of the function
+     */
+    static void writeBatchFunctionEnd(std::ostream&, std::string_view);
+    /*!
+     * \brief describe a generated library. This function is shared with the
+     * `generic-parallel` interface for models.
+     * \param[out] d: targets description
+     * \param[in] library: name of the library
+     * \param[in] source: generated source file
+     * \param[in] header: generated header file, relative to the `include`
+     * directory
+     * \param[in] entry_points: entry points of the library
+     */
+    static void describeLibrary(TargetsDescription&,
+                                const std::string&,
+                                const std::string&,
+                                const std::string&,
+                                const std::vector<std::string>&);
+    //! \brief default constructor
+    GenericParallelBehaviourInterface();
+    //
+    [[nodiscard]] std::string getInterfaceName() const override;
+    void setOptions(const DataMap&) override;
+    [[nodiscard]] std::pair<bool, tokens_iterator> treatKeyword(
+        BehaviourDescription&,
+        const std::string&,
+        const std::vector<std::string>&,
+        tokens_iterator,
+        const tokens_iterator) override;
+    [[nodiscard]] std::string getParametersSourceInBehaviourConstructor(
+        const BehaviourDescription&, const Hypothesis) const override;
+    [[nodiscard]] bool requiresDeviceCompatibleBehaviourClass() const override;
+    void endTreatment(const BehaviourDescription&,
+                      const FileDescription&) const override;
+    void getTargetsDescription(TargetsDescription&,
+                               const BehaviourDescription&) override;
+    [[nodiscard]] std::string getLibraryName(
+        const BehaviourDescription&) const override;
+    [[nodiscard]] std::map<std::string,
+                           std::shared_ptr<AbstractBehaviourInterface>>
+    getInterfacesOfAdditionalBehaviourConstructors(
+        const BehaviourDescription&) const override;
+    //! \brief destructor
+    ~GenericParallelBehaviourInterface() override;
+
+   protected:
+    [[nodiscard]] std::string getBehaviourConstructorTemplateDeclaration()
+        const override;
+    [[nodiscard]] std::string getBehaviourConstructorArguments() const override;
+    void writeBehaviourConstructorHeader(std::ostream&,
+                                         const BehaviourDescription&,
+                                         const Hypothesis,
+                                         const std::string&) const override;
+    /*!
+     * \return the name of the generated header file
+     * \param[in] name: name of the behaviour, including the library
+     */
+    [[nodiscard]] virtual std::string getHeaderFileName(
+        const std::string&) const;
+    /*!
+     * \return the name of the generated source file
+     * \param[in] name: name of the behaviour, including the library
+     */
+    [[nodiscard]] virtual std::string getSourceFileName(
+        const std::string&) const;
+    /*!
+     * \brief write the header file
+     * \param[in] bd: behaviour description
+     * \param[in] fd: file description
+     */
+    virtual void writeHeaderFile(const BehaviourDescription&,
+                                 const FileDescription&) const;
+    /*!
+     * \brief write the source file
+     * \param[in] bd: behaviour description
+     * \param[in] fd: file description
+     */
+    virtual void writeSourceFile(const BehaviourDescription&,
+                                 const FileDescription&) const;
+    /*!
+     * \brief write the functions rotating the values of a batch of
+     * integration points of an orthotropic behaviour
+     * \param[out] os: output stream
+     * \param[in] bd: behaviour description
+     * \param[in] name: name of the behaviour
+     * \param[in] h: modelling hypothesis
+     */
+    virtual void writeRotationFunctions(std::ostream&,
+                                        const BehaviourDescription&,
+                                        const std::string&,
+                                        const Hypothesis) const;
+    /*!
+     * \return the name of the source file of the functions of the `generic`
+     * interface (`generic_functions` option)
+     * \param[in] name: name of the behaviour, including the library
+     */
+    [[nodiscard]] virtual std::string getPointwiseSourceFileName(
+        const std::string&) const;
+    /*!
+     * \return the name of the header declaring the functions of the
+     * `generic` interface (`generic_functions` option), in the
+     * `MFront/GenericBehaviour` directory
+     * \param[in] name: name of the behaviour, including the library
+     */
+    [[nodiscard]] virtual std::string getPointwiseHeaderFileName(
+        const std::string&) const;
+    //! \brief backend
+    std::unique_ptr<generic_parallel::AbstractBackend> backend;
+    /*!
+     * \brief if true, the library also contains the functions of the
+     * `generic` interface (`generic_functions` option, false by default):
+     * integration, initialize functions, post-processings and rotations of
+     * a point. The library then exports `Generic` as interface.
+     */
+    bool generic_functions = false;
+  };  // end of struct GenericParallelBehaviourInterface
+
+}  // end of namespace mfront
+
+#endif /* LIB_MFRONT_GENERICPARALLELBEHAVIOURINTERFACE_HXX */
