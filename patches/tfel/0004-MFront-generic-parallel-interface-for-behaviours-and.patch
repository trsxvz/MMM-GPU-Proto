diff --git a/mfront/include/MFront/BehaviourRotationFunctions.hxx b/mfront/include/MFront/BehaviourRotationFunctions.hxx
new file mode 100644
index 000000000..44f16244e
--- /dev/null
+++ b/mfront/include/MFront/BehaviourRotationFunctions.hxx
@@ -0,0 +1,111 @@
+/*!
+ * \file   mfront/include/MFront/BehaviourRotationFunctions.hxx
+ * \brief  This file declares the description of the rotation functions of
+ * orthotropic behaviours, shared by the `generic` and `generic-parallel`
+ * interfaces.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_BEHAVIOURROTATIONFUNCTIONS_HXX
+#define LIB_MFRONT_BEHAVIOURROTATIONFUNCTIONS_HXX
+
+#include <string>
+#include <vector>
+#include <optional>
+#include <cstddef>
+#include <iosfwd>
+#include "TFEL/Material/ModellingHypothesis.hxx"
+#include "MFront/MFrontConfig.hxx"
+
+namespace mfront {
+
+  // forward declaration
+  struct BehaviourDescription;
+
+  /*!
+   * \brief description of a function rotating the values of an integration
+   * point (gradients, thermodynamic forces or tangent operator blocks) of an
+   * orthotropic behaviour.
+   *
+   * The rotation matrix `rv` given to those functions is the rotation matrix
+   * from the global frame to the material frame, stored in column-major
+   * format. The
+   * gradients are rotated from the global frame to the material frame, the
+   * thermodynamic forces and the tangent operator blocks from the material
+   * frame to the global frame.
+   */
+  struct MFRONT_VISIBILITY_EXPORT BehaviourRotationFunction {
+    /*!
+     * \brief a tangent operator block for which TFEL has no type which can
+     * be rotated (derivative of a vector with respect to a symmetric tensor
+     * or a tensor, and conversely, derivative of a tensor with respect to a
+     * symmetric tensor), rotated by `mfront::gb::rotateTangentOperatorBlock`
+     */
+    struct Block {
+      //! \brief type of the derivated object
+      std::string type1;
+      //! \brief type of the object with respect to which the derivative is
+      //! taken
+      std::string type2;
+    };
+    //! \brief a rotated object
+    struct Object {
+      /*!
+       * \brief type of the object, empty for a scalar or for a block for
+       * which TFEL has no type (see `block`, which is tested first)
+       */
+      std::string type;
+      //! \brief offset of the object in the values of a point
+      std::size_t offset;
+      //! \brief description of a block for which TFEL has no type
+      std::optional<Block> block = {};
+    };
+    //! \brief name of the function, appended to the name of the behaviour
+    std::string name;
+    /*!
+     * \brief name of the function rotating an array of values, appended to
+     * the name of the behaviour
+     */
+    std::string array_name;
+    //! \brief description of the rotated values (used in the documentation)
+    std::string description;
+    //! \brief rotated objects
+    std::vector<Object> objects;
+    //! \brief number of values of a point
+    std::size_t size = 0;
+    //! \brief true if the values are rotated to the material frame
+    bool to_material_frame = false;
+  };
+
+  /*!
+   * \return the rotation functions of a behaviour for the given modelling
+   * hypothesis (empty if the behaviour is not orthotropic)
+   * \param[in] bd: behaviour description
+   * \param[in] h: modelling hypothesis
+   */
+  MFRONT_VISIBILITY_EXPORT std::vector<BehaviourRotationFunction>
+  getBehaviourRotationFunctions(
+      const BehaviourDescription&,
+      const tfel::material::ModellingHypothesis::Hypothesis);
+
+  /*!
+   * \brief write the statements rotating the values of one point. Those
+   * statements use the `dest`, `src` and `rv` pointers, which have the
+   * meaning of the arguments of the rotation functions of the `generic`
+   * interface. `dest` and `src` may be equal. The generated code can be used
+   * in device code.
+   * \param[out] os: output stream
+   * \param[in] f: rotation function
+   */
+  MFRONT_VISIBILITY_EXPORT void writePointRotation(
+      std::ostream&, const BehaviourRotationFunction&);
+
+}  // end of namespace mfront
+
+#endif /* LIB_MFRONT_BEHAVIOURROTATIONFUNCTIONS_HXX */
diff --git a/mfront/include/MFront/GenericParallelBehaviour/BatchData.h b/mfront/include/MFront/GenericParallelBehaviour/BatchData.h
new file mode 100644
index 000000000..955add118
--- /dev/null
+++ b/mfront/include/MFront/GenericParallelBehaviour/BatchData.h
@@ -0,0 +1,425 @@
+/*!
+ * \file   mfront/include/MFront/GenericParallelBehaviour/BatchData.h
+ * \brief  This file declares the data structures exchanged with the
+ * functions generated by the `generic-parallel` behaviour interface.
+ * \date   05/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELBEHAVIOUR_BATCHDATA_H
+#define LIB_MFRONT_GENERICPARALLELBEHAVIOUR_BATCHDATA_H
+
+#include <string.h>
+#include "MFront/GenericBehaviour/Types.h"
+#include "MFront/GenericParallel/BackendExecutionPolicy.h"
+
+/*!
+ * \brief version of the data structures declared in this file, exported by
+ * the generated libraries (`<name>_generic_parallel_api_version` symbol).
+ * It is incremented at each incompatible change of those structures.
+ */
+#define MFRONT_GPB_API_VERSION 4
+
+#ifdef __cplusplus
+extern "C" {
+#endif /* __cplusplus */
+
+/*!
+ * \brief statistics of the computations on a batch, accumulated by the
+ * device when they are given by the calling code (see the `statistics`
+ * member of `mfront_gpb_BatchData`). They must be initialized by
+ * `mfront_gpb_initializeStatistics`, on the host. They can then be
+ * copied in device memory. They are analysed by the
+ * `<name>_generic_parallel_report` function of the library which computed
+ * them. The first members are the ones of the statistics of the material
+ * properties (`mfront_gpmp_Statistics`).
+ *
+ * The devices only update the statistics when an event occurs at a point
+ * (failure, unreliable result, decrease of the time step scaling factor).
+ */
+typedef struct mfront_gpb_Statistics {
+  //! \brief number of points where the integration failed
+  unsigned long long number_of_failures;
+  /*!
+   * \brief opaque key of the first point where the integration failed, or
+   * `~0` if no point failed. This key does not depend on the order of the
+   * computations. Only the report function of the library decodes it.
+   */
+  unsigned long long first_failure;
+  //! \brief number of points where the time step scaling factor is too low
+  unsigned long long number_of_unreliable_results;
+  /*!
+   * \brief opaque key of the first point where the time step scaling
+   * factor is too low, or `~0` if there is no such point
+   */
+  unsigned long long first_unreliable_result;
+  /*!
+   * \brief minimum of the time step scaling factors, stored as an unsigned
+   * integer with the same ordering (see
+   * `mfront_gpb_getTimeStepScalingFactor`), so that the device can update
+   * it with an integer atomic operation. On all backends, this is the
+   * minimum of the value given to `mfront_gpb_initializeStatistics`, which
+   * must be the initial value of the time step scaling factor of the batch
+   * (`rdt` member of `mfront_gpb_BatchData`), and of the factors of the
+   * points which are lower than this value.
+   */
+  unsigned long long rdt;
+} mfront_gpb_Statistics;
+
+/*!
+ * \brief values of a group of variables (gradients, internal state
+ * variables, etc.) at all the integration points of a batch.
+ *
+ * The `j`-th component of the group at the `i`-th integration point is
+ * stored at `values[i * point_stride + j * component_stride]`. Common
+ * layouts are:
+ *
+ * - point by point: `point_stride` is the size of the group and
+ *   `component_stride` is one;
+ * - component by component, which gives coalesced memory accesses on GPUs:
+ *   `point_stride` is one and `component_stride` is the number of points;
+ * - uniform values (inputs only): `point_stride` is zero.
+ *
+ * `values` may be null if the group is empty or if an optional output is not
+ * requested.
+ */
+typedef struct mfront_gpb_ConstField {
+  //! \brief pointer to the first value
+  const mfront_gb_real* values;
+  //! \brief stride between two integration points
+  mfront_gb_size_type point_stride;
+  //! \brief stride between two components
+  mfront_gb_size_type component_stride;
+} mfront_gpb_ConstField;
+
+//! \brief mutable version of `mfront_gpb_ConstField`
+typedef struct mfront_gpb_Field {
+  //! \brief pointer to the first value
+  mfront_gb_real* values;
+  //! \brief stride between two integration points
+  mfront_gb_size_type point_stride;
+  //! \brief stride between two components
+  mfront_gb_size_type component_stride;
+} mfront_gpb_Field;
+
+/*!
+ * \brief state of the material at the beginning of the time step
+ *
+ * The material properties and the external state variables can be given
+ * either as a group (one field holding all the variables) or variable by
+ * variable (one field per variable, see `material_properties_by_variable`).
+ * The second form allows different layouts for each variable, for instance
+ * uniform values (null point stride) for some variables only.
+ */
+typedef struct mfront_gpb_InitialState {
+  mfront_gpb_ConstField gradients;
+  mfront_gpb_ConstField thermodynamic_forces;
+  mfront_gpb_ConstField mass_density;
+  mfront_gpb_ConstField material_properties;
+  mfront_gpb_ConstField internal_state_variables;
+  mfront_gpb_ConstField stored_energy;
+  mfront_gpb_ConstField dissipated_energy;
+  mfront_gpb_ConstField external_state_variables;
+  /*!
+   * \brief material properties given variable by variable (optional).
+   *
+   * If not null, this array holds one field per material property, in the
+   * order of the material properties of a point (the elements of an array
+   * being distinct variables), and `material_properties` is ignored. The
+   * array itself is only read on the host.
+   */
+  const mfront_gpb_ConstField* material_properties_by_variable;
+  /*!
+   * \brief external state variables given variable by variable
+   * (optional), see `material_properties_by_variable`
+   */
+  const mfront_gpb_ConstField* external_state_variables_by_variable;
+} mfront_gpb_InitialState;
+
+//! \brief state of the material at the end of the time step
+typedef struct mfront_gpb_State {
+  mfront_gpb_ConstField gradients;
+  //! \brief output
+  mfront_gpb_Field thermodynamic_forces;
+  mfront_gpb_ConstField mass_density;
+  mfront_gpb_ConstField material_properties;
+  //! \brief output
+  mfront_gpb_Field internal_state_variables;
+  //! \brief output, optional
+  mfront_gpb_Field stored_energy;
+  //! \brief output, optional
+  mfront_gpb_Field dissipated_energy;
+  mfront_gpb_ConstField external_state_variables;
+  //! \brief see `mfront_gpb_InitialState`
+  const mfront_gpb_ConstField* material_properties_by_variable;
+  //! \brief see `mfront_gpb_InitialState`
+  const mfront_gpb_ConstField* external_state_variables_by_variable;
+} mfront_gpb_State;
+
+/*!
+ * \brief description of a batch of integration points.
+ *
+ * Integrating a batch is equivalent to calling the function generated by
+ * the `generic` interface at each integration point, with the same values
+ * of the time increment and of the computation options. All the fields must
+ * be located in the memory space exported by the library (symbol
+ * `<name>_generic_parallel_memory_space`, see
+ * `MFront/GenericParallel/MemorySpace.hxx`). With the `any` memory space,
+ * the fields may be located anywhere (for instance, the `sycl` backend
+ * copies the fields which are not accessible by the device). The arrays of
+ * fields given variable by variable are only read on the host.
+ */
+typedef struct mfront_gpb_BatchData {
+  //! \brief number of integration points
+  mfront_gb_size_type number_of_points;
+  //! \brief time increment
+  mfront_gb_real dt;
+  /*!
+   * \brief computation options. Those options have the same meaning as the
+   * three first values of the array `K` of the `mfront_gb_BehaviourData`
+   * structure (type of computation, stress measure and type of tangent
+   * operator for finite strain behaviours).
+   */
+  mfront_gb_real options[3];
+  /*!
+   * \brief initial value of the time step scaling factor, used at each
+   * integration point
+   */
+  mfront_gb_real rdt;
+  //! \brief tangent or prediction operators (output, optional)
+  mfront_gpb_Field tangent_operators;
+  //! \brief time step scaling factors at each point (output, optional)
+  mfront_gpb_Field rdts;
+  //! \brief speed of sound (output, only used if requested by the options)
+  mfront_gpb_Field speed_of_sound;
+  //! \brief state at the beginning of the time step
+  mfront_gpb_InitialState s0;
+  //! \brief state at the end of the time step
+  mfront_gpb_State s1;
+  /*!
+   * \brief status of each integration point (output, optional):
+   *
+   * - `-1`: the integration failed;
+   * - `0`: the integration succeeded but the time step scaling factor is
+   *   lower than 0.99;
+   * - `1`: the integration succeeded.
+   */
+  int* statuses;
+  /*!
+   * \brief statistics of the computations (optional, null if not
+   * requested).
+   *
+   * If null, the output status reports the result of the batch.
+   *
+   * Otherwise, the statistics are accumulated in the given structure,
+   * initialized by `mfront_gpb_initializeStatistics`, which must be
+   * accessible by the device as the fields of the batch (and by the host
+   * with the `stlpar`, `openmp` and `openacc` backends, which accumulate them
+   * on the host). With the automatic data transfers of the `sycl` backend,
+   * statistics which are not accessible by the device are copied, as the
+   * fields. The output status then only reports the errors of the batch, and
+   * the `<name>_generic_parallel_report` function gives the result once the
+   * computations are completed. With the `sycl` backend, asynchronous
+   * computations require an in-order queue (invalid arguments otherwise).
+   *
+   * Statistics are required by asynchronous computations (see
+   * `mfront::generic_parallel::BackendExecutionCommonPolicy`).
+   */
+  mfront_gpb_Statistics* statistics;
+  /*!
+   * \brief execution policy of the backend of the library (see
+   * `MFront/GenericParallel/AbstractBackendExecutionPolicy.hxx`), or null
+   * for the default policy of the backend. The `sycl` backend has no default
+   * policy. A policy of another backend is refused (invalid arguments). The
+   * policy does not have to outlive the call, even for an asynchronous
+   * computation.
+   */
+  const mfront_gp_AbstractBackendExecutionPolicy* execution_policy;
+} mfront_gpb_BatchData;
+
+/*!
+ * \brief data of the rotation of the values (gradients, thermodynamic forces
+ * or tangent operator blocks) of a batch of integration points of an
+ * orthotropic behaviour.
+ */
+typedef struct mfront_gpb_RotationData {
+  //! \brief number of points
+  mfront_gb_size_type number_of_points;
+  //! \brief rotated values
+  mfront_gpb_Field destination;
+  //! \brief values to be rotated, which may be the destination
+  mfront_gpb_ConstField source;
+  /*!
+   * \brief rotation matrices from the global frame to the material frame (9
+   * values per point, stored in column-major format as for the `generic`
+   * interface). The rotation matrix is uniform if the point stride is null.
+   */
+  mfront_gpb_ConstField rotation_matrices;
+  /*!
+   * \brief statistics of the computations, as for `mfront_gpb_BatchData`.
+   * The rotations never fail and never lower the time step scaling factor:
+   * the statistics, if given, are not modified. As for the other
+   * functions, an asynchronous rotation requires statistics.
+   */
+  mfront_gpb_Statistics* statistics;
+  //! \brief execution policy, as for `mfront_gpb_BatchData`
+  const mfront_gp_AbstractBackendExecutionPolicy* execution_policy;
+} mfront_gpb_RotationData;
+
+/*!
+ * \brief summary of the integration of a batch. The `status` member is
+ * also the value returned by the functions generated by the interface:
+ *
+ * - `1`: the integration succeeded at all points;
+ * - `0`: the integration succeeded at all points, but the time step scaling
+ *   factor is lower than 0.99 at some points;
+ * - `-1`: the integration failed at some points;
+ * - `-5`: invalid arguments, nothing was computed;
+ * - `-6`: invalid parameters, nothing was computed;
+ * - `-7`: runtime error of the backend (allocation, kernel launch,
+ *   exception thrown on the host, etc.).
+ *
+ * The codes `1`, `0` and `-1` are the ones of the reported point: the first
+ * point where the integration failed, otherwise the first point where the
+ * time step scaling factor is too low. Those codes are the ones of the
+ * `generic` interface.
+ */
+typedef struct mfront_gpb_OutputStatus {
+  //! \brief status
+  int status;
+  //! \brief number of points where the integration failed
+  mfront_gb_size_type number_of_failures;
+  /*!
+   * \brief index of the first point where the integration failed, or the
+   * maximal value of the type if no point failed. The `generic` interface
+   * of the same behaviour, called at this point, gives the detailed error
+   * message.
+   */
+  mfront_gb_size_type first_failure_index;
+  //! \brief number of points where the time step scaling factor is too low
+  mfront_gb_size_type number_of_unreliable_results;
+  /*!
+   * \brief index of the first point where the time step scaling factor is
+   * too low, or the maximal value of the type if there is no such point
+   */
+  mfront_gb_size_type first_unreliable_result_index;
+  //! \brief minimum of the time step scaling factors over the batch
+  mfront_gb_real rdt;
+  //! \brief error message
+  char msg[512];
+} mfront_gpb_OutputStatus;
+
+/*!
+ * \brief initialize the statistics of a batch
+ * \param[out] s: statistics
+ * \param[in] rdt: initial value of the time step scaling factor of the
+ * batch (`rdt` member of `mfront_gpb_BatchData`)
+ *
+ * \note the ordered key of the time step scaling factor is built from its
+ * value converted to `double`, whatever the numerical type of the
+ * interface, so that its 64 bits are defined
+ */
+static inline void mfront_gpb_initializeStatistics(
+    mfront_gpb_Statistics* const s, const double rdt) {
+  const unsigned long long sign = 0x8000000000000000ull;
+  unsigned long long b;
+  memcpy(&b, &rdt, sizeof(b));
+  s->number_of_failures = 0;
+  s->first_failure = ~0ull;
+  s->number_of_unreliable_results = 0;
+  s->first_unreliable_result = ~0ull;
+  s->rdt = (b & sign) ? ~b : (b | sign);
+} /* end of mfront_gpb_initializeStatistics */
+
+/*!
+ * \return the minimum of the time step scaling factors
+ * \param[in] s: statistics
+ */
+static inline mfront_gb_real mfront_gpb_getTimeStepScalingFactor(
+    const mfront_gpb_Statistics* const s) {
+  const unsigned long long sign = 0x8000000000000000ull;
+  const unsigned long long b = (s->rdt & sign) ? (s->rdt & ~sign) : ~(s->rdt);
+  double rdt;
+  memcpy(&rdt, &b, sizeof(rdt));
+  return (mfront_gb_real)rdt;
+} /* end of mfront_gpb_getTimeStepScalingFactor */
+
+/*!
+ * \brief type of the functions integrating a behaviour, or executing a
+ * model, over a batch of integration points
+ * (`<name>_<hypothesis>_generic_parallel` functions)
+ */
+typedef int (*mfront_gpb_BatchBehaviourPtr)(mfront_gpb_OutputStatus* const,
+                                            const mfront_gpb_BatchData* const);
+
+/*!
+ * \brief type of the functions executing an initialize function over a
+ * batch of integration points
+ * (`<name>_<hypothesis>_InitializeFunction_<f>_generic_parallel` functions)
+ */
+typedef int (*mfront_gpb_BatchInitializeFunctionPtr)(
+    mfront_gpb_OutputStatus* const,
+    const mfront_gpb_BatchData* const,
+    const mfront_gpb_ConstField* const);
+
+/*!
+ * \brief type of the functions executing a post-processing over a batch of
+ * integration points
+ * (`<name>_<hypothesis>_PostProcessing_<f>_generic_parallel` functions)
+ */
+typedef int (*mfront_gpb_BatchPostProcessingPtr)(
+    mfront_gpb_OutputStatus* const,
+    const mfront_gpb_Field* const,
+    const mfront_gpb_BatchData* const);
+
+/*!
+ * \brief type of the rotation functions over a batch of integration points
+ * (`<name>_<hypothesis>_rotate<X>_generic_parallel` functions)
+ */
+typedef int (*mfront_gpb_BatchRotationPtr)(
+    mfront_gpb_OutputStatus* const, const mfront_gpb_RotationData* const);
+
+/*!
+ * \brief type of the function analysing the statistics of a batch, once
+ * the computations are completed (`<name>_generic_parallel_report`
+ * function), and reporting the result in an output status, as a
+ * synchronous computation does
+ */
+typedef int (*mfront_gpb_ReportPtr)(mfront_gpb_OutputStatus* const,
+                                    const mfront_gpb_Statistics* const);
+
+#ifdef __cplusplus
+}  // end of extern "C"
+#endif /* __cplusplus */
+
+#ifdef __cplusplus
+
+namespace mfront::gpb {
+
+  //! \brief a simple alias
+  using AtomicBatchStatistics = ::mfront_gpb_Statistics;
+  //! \brief a simple alias
+  using ConstField = ::mfront_gpb_ConstField;
+  //! \brief a simple alias
+  using Field = ::mfront_gpb_Field;
+  //! \brief a simple alias
+  using InitialState = ::mfront_gpb_InitialState;
+  //! \brief a simple alias
+  using RotationData = ::mfront_gpb_RotationData;
+  //! \brief a simple alias
+  using State = ::mfront_gpb_State;
+  //! \brief a simple alias
+  using BatchData = ::mfront_gpb_BatchData;
