diff --git a/test-suite/behaviours/generic-parallel/ImplicitGenericBehaviourTest.mfront b/test-suite/behaviours/generic-parallel/ImplicitGenericBehaviourTest.mfront
new file mode 100644
index 000000000..7a0173e6e
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/ImplicitGenericBehaviourTest.mfront
@@ -0,0 +1,68 @@
+@DSL ImplicitGenericBehaviour;
+@Behaviour ImplicitGenericBehaviourTest;
+@Description {
+  "Norton creep written with the ImplicitGenericBehaviour DSL: the strain "
+  "and the stress are declared as a gradient and a thermodynamic force."
+}
+
+@Epsilon 1e-16;
+
+@Gradient StrainStensor eto;
+eto.setGlossaryName("Strain");
+@ThermodynamicForce StressStensor sig;
+sig.setGlossaryName("Stress");
+@TangentOperatorBlocks{dsig_ddeto};
+
+@StateVariable StrainStensor eel;
+eel.setGlossaryName("ElasticStrain");
+@StateVariable strain p;
+p.setGlossaryName("EquivalentViscoplasticStrain");
+
+@MaterialProperty stress young;
+young.setGlossaryName("YoungModulus");
+@MaterialProperty real nu;
+nu.setGlossaryName("PoissonRatio");
+
+//! first Lamé coefficient
+@LocalVariable stress lambda;
+//! second Lamé coefficient
+@LocalVariable stress mu;
+
+@InitLocalVariables {
+  lambda = computeLambda(young, nu);
+  mu = computeMu(young, nu);
+}
+
+@ComputeThermodynamicForces {
+  sig = lambda * trace(eel) * StrainStensor::Id() + 2 * mu * eel;
+}
+
+@Integrator {
+  constexpr auto eeps = real(1e-14);
+  constexpr auto A = real(8e-67);
+  constexpr auto E = real(8.2);
+  const auto M = Stensor4::M();
+  const auto seps = 2 * mu * eeps;
+  const auto seq = sigmaeq(sig);
+  const auto iseq = 1 / max(seq, seps);
+  const auto n = 3 * deviator(sig) * (iseq / 2);
+  // elasticity
+  feel += dp * n - deto;
+  // viscoplasticity
+  const auto vp = A * pow(seq, E);
+  fp -= dt * vp;
+  // jacobian
+  const auto dvp_dseq = E * vp * iseq;
+  dfeel_ddeel += 2 * mu * theta * dp * iseq * (M - (n ^ n));
+  dfeel_ddp = n;
+  dfp_ddeel = -2 * mu * theta * dvp_dseq * dt * n;
+}
+
+@TangentOperator {
+  static_cast<void>(smt);
+  const auto De = lambda * Stensor4::IxI() + 2 * mu * Stensor4::Id();
+  dfeel_ddeto = -Stensor4::Id();
+  auto deel_ddeto = Stensor4{};
+  getIntegrationVariablesDerivatives_eto(deel_ddeto);
+  dsig_ddeto = De * deel_ddeto;
+}
diff --git a/test-suite/behaviours/generic-parallel/ImplicitModelTest.mfront b/test-suite/behaviours/generic-parallel/ImplicitModelTest.mfront
new file mode 100644
index 000000000..7ba503dcb
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/ImplicitModelTest.mfront
@@ -0,0 +1,18 @@
+@DSL ImplicitModel;
+@Model ImplicitModelTest;
+@Description {
+  "Linear ordinary differential equation integrated by the ImplicitModel "
+  "DSL."
+}
+
+@Algorithm NewtonRaphson;
+@Epsilon 1e-14;
+@Theta 0.5;
+
+@StateVariable real x;
+@Parameter real A = 1.2;
+
+@Integrator {
+  fx += dt * A * (x + theta * dx);
+  dfx_ddx += theta * A * dt;
+}
diff --git a/test-suite/behaviours/generic-parallel/IsotropicMisesCreepTest.mfront b/test-suite/behaviours/generic-parallel/IsotropicMisesCreepTest.mfront
new file mode 100644
index 000000000..e082f5e94
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/IsotropicMisesCreepTest.mfront
@@ -0,0 +1,20 @@
+@DSL IsotropicMisesCreep;
+@Behaviour IsotropicMisesCreepTest;
+@Description {
+  "Norton creep written with the IsotropicMisesCreep DSL."
+}
+
+@ElasticMaterialProperties {150e9, 0.3};
+
+//! Norton coefficient
+@MaterialProperty real A;
+A.setEntryName("NortonCoefficient");
+//! Norton exponent
+@MaterialProperty real E;
+E.setEntryName("NortonExponent");
+
+@FlowRule {
+  const auto tmp = A * pow(seq, E - 1);
+  f = tmp * seq;
+  df_dseq = E * tmp;
+}
diff --git a/test-suite/behaviours/generic-parallel/MultipleIsotropicMisesFlowsTest.mfront b/test-suite/behaviours/generic-parallel/MultipleIsotropicMisesFlowsTest.mfront
new file mode 100644
index 000000000..9a7d8c834
--- /dev/null
+++ b/test-suite/behaviours/generic-parallel/MultipleIsotropicMisesFlowsTest.mfront
@@ -0,0 +1,26 @@
+@DSL MultipleIsotropicMisesFlows;
+@Behaviour MultipleIsotropicMisesFlowsTest;
+@Description {
+  "Plasticity with a Voce isotropic hardening and Norton creep written "
+  "with the MultipleIsotropicMisesFlows DSL."
+}
+
+@Epsilon 1e-14;
+@Theta 1;
+@ElasticMaterialProperties {150e9, 0.3};
+
+@IsotropicHardeningRule "Voce" {flow_id : 0, R0 : 125e6, Rinf : 500e6, b : 20};
+
+@FlowRule Plasticity {
+  f = seq - R;
+  df_dseq = 1;
+  df_dp = -dR_dp;
+}
+
+@FlowRule Creep {
+  constexpr auto A = real(1e-28);
+  constexpr auto E = real(3);
+  const auto tmp = A * pow(seq, E - 1);
+  f = tmp * seq;
+  df_dseq = E * tmp;
+}
diff --git a/test-suite/behaviours/generic-parallel/compare-all.sh b/test-suite/behaviours/generic-parallel/compare-all.sh
index 67b73707c..88a4b53a3 100644
--- a/test-suite/behaviours/generic-parallel/compare-all.sh
+++ b/test-suite/behaviours/generic-parallel/compare-all.sh
@@ -16,6 +16,21 @@ run HosfordPerfectPlasticity_Tridimensional 6 6 0 7 1 36 5e-4 - 293.15
 # elastic properties given by a material law evaluated on the device, and
 # quantities
 run StrainHardeningCreep3_Tridimensional 6 6 0 11 1 36 1e-3 - 600
+# isotropic DSLs: creep, and several flows with an isotropic hardening rule.
+# The MultipleIsotropicMisesFlows DSL does not provide a consistent tangent
+# operator: the generic interface rejects the requests of tangent operators.
+run IsotropicMisesCreepTest_Tridimensional 6 6 2 7 1 36 1e-3 8e-67,8.2 293.15
+run IsotropicMisesCreepTest_PlaneStrain 4 4 2 5 1 16 1e-3 8e-67,8.2 293.15
+run MultipleIsotropicMisesFlowsTest_Tridimensional 6 6 0 9 1 36 3e-3 - 293.15 \
+  --tangent-operator=0
+run MultipleIsotropicMisesFlowsTest_Axisymmetrical 4 4 0 7 1 16 3e-3 - 293.15 \
+  --tangent-operator=0
+# implicit DSLs for generic behaviours and for models
+run ImplicitGenericBehaviourTest_Tridimensional 6 6 2 7 1 36 1e-3 150e9,0.3 \
+  293.15
+run ImplicitGenericBehaviourTest_PlaneStrain 4 4 2 5 1 16 1e-3 150e9,0.3 293.15
+run ImplicitModelTest_Tridimensional 0 0 0 1 1 0 0 - 293.15 \
+  --initial-internal-state-variables=1 --tangent-operator=0
 # finite strain behaviours (Hencky strain, Green-Lagrange strain, standard
 # finite strain behaviour)
 fs="1e-3 150e9,0.3 293.15 --finite-strain"
