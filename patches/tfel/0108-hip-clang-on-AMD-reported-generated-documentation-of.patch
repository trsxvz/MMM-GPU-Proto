From c6a0067f9e9ba8c9568365647997a74a9c8cb3d0 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 18:18:11 +0200
Subject: [PATCH] hip-clang on AMD reported, generated documentation of
 checkBounds

- tfel.cmake: the hip-clang configuration only targets the NVIDIA platform; on the AMD platform, a warning now tells that it installs no configuration file and declares no test (hip-hipcc being the configuration to use).
- The documentation generated for checkBounds says that the compilers translating host and device code in a single pass follow the device branch on the host too, instead of throwing an exception.
---
 mfront/src/BehaviourCodeGeneratorBase.cxx | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/mfront/src/BehaviourCodeGeneratorBase.cxx b/mfront/src/BehaviourCodeGeneratorBase.cxx
index 424fc022b..bba776173 100644
--- a/mfront/src/BehaviourCodeGeneratorBase.cxx
+++ b/mfront/src/BehaviourCodeGeneratorBase.cxx
@@ -2350,8 +2350,10 @@ namespace mfront {
        << " * \\brief check physical bounds and standard bounds\n"
        << " *\n"
        << " * \\return false if a bound is violated and if this violation\n"
-       << " * is not tolerated by the out of bounds policy. On the host,\n"
-       << " * an exception is thrown in this case.\n"
+       << " * is not tolerated by the out of bounds policy. In host code,\n"
+       << " * an exception is thrown in this case, except with the\n"
+       << " * compilers translating host and device code in a single\n"
+       << " * pass, which follow the device branch on the host too.\n"
        << " */\n"
        << "TFEL_HOST_DEVICE bool checkBounds() const{\n";
     write_physical_bounds(md.getMaterialProperties(), false);
-- 
