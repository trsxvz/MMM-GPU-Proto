From f1f14c537f43e019a29294a7b9457571407d474f Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 6 Oct 2026 06:40:06 +0200
Subject: [PATCH] generic-parallel: material properties using data or other
 material laws on CUDA and HIP

- The kernels of the CUDA and HIP backends named their input fields
  mfront_<input>_values, the name of the abscissae of the data of the
  material properties defined by an interpolation (@Data). They are
  renamed mfront_<input>_field.
- The material laws called by a material property were imported by
  #ifdef TFEL_DEVICE_CODE: the implementations of the mfront::device
  namespace in device code, the functions of the mfront interface
  otherwise. clang also checks the body of a kernel (__global__ function)
  during the compilation of the host code, where only the host functions
  were visible. The kernels now always import the device
  implementations (new device_code_only argument of writeMaterialLaws and
  writeBeginningOfMaterialPropertyBody).
- The documentation of writeBeginningOfMaterialPropertyBody referred to
  writeStaticVariables for the material laws and the reverse.
---
 .../include/MFront/CodeGeneratorUtilities.hxx   | 17 ++++++++++++++++-
 .../MFront/MaterialPropertyDescription.hxx      |  5 ++++-
 mfront/src/CodeGeneratorUtilities.cxx           |  9 ++++++++-
 .../MaterialProperty/CUDABackendBase.cxx        |  3 ++-
 mfront/src/MaterialPropertyDescription.cxx      |  5 +++--
 5 files changed, 33 insertions(+), 6 deletions(-)

diff --git a/mfront/include/MFront/CodeGeneratorUtilities.hxx b/mfront/include/MFront/CodeGeneratorUtilities.hxx
index 86ba441dd..3beccfad4 100644
--- a/mfront/include/MFront/CodeGeneratorUtilities.hxx
+++ b/mfront/include/MFront/CodeGeneratorUtilities.hxx
@@ -232,8 +232,23 @@ namespace mfront {
   MFRONT_VISIBILITY_EXPORT void writeMaterialKnowledgeTypeSymbol(
       std::ostream&, const std::string_view, const MaterialKnowledgeType&);
 
+  /*!
+   * \brief import the material laws called by a behaviour or a material
+   * property.
+   *
+   * In device code, the implementations of the `mfront::device` namespace
+   * are imported. Otherwise, the functions generated by the `mfront`
+   * interface are imported.
+   *
+   * \param[out] os: output stream
+   * \param[in] materialLaws: material laws
+   * \param[in] device_code_only: import the implementations of the
+   * `mfront::device` namespace in host code too. This is required in the
+   * kernels of the `CUDA` and `HIP` backends (`__global__` functions), which
+   * `clang` also checks during the compilation of the host code.
+   */
   MFRONT_VISIBILITY_EXPORT void writeMaterialLaws(
-      std::ostream&, const std::vector<std::string>&);
+      std::ostream&, const std::vector<std::string>&, const bool = false);
 
   MFRONT_VISIBILITY_EXPORT void writeStaticVariables(
       std::ostream&,
diff --git a/mfront/include/MFront/MaterialPropertyDescription.hxx b/mfront/include/MFront/MaterialPropertyDescription.hxx
index a91404869..ef7989226 100644
--- a/mfront/include/MFront/MaterialPropertyDescription.hxx
+++ b/mfront/include/MFront/MaterialPropertyDescription.hxx
@@ -209,13 +209,16 @@ namespace mfront {
    * \param[in] fd: file description
    * \param[in] numeric_type: numeric type used by the interface
    * \param[in] areQuantitiesSupported: allow quantities
+   * \param[in] device_code_only: the body is only executed in device code
+   * (see the `writeMaterialLaws` function)
    */
   MFRONT_VISIBILITY_EXPORT void writeBeginningOfMaterialPropertyBody(
       std::ostream&,
       const MaterialPropertyDescription&,
       const FileDescription&,
       const std::string_view,
-      const bool areQuantitiesSupported);
+      const bool areQuantitiesSupported,
+      const bool device_code_only = false);
   /*!
    * \brief an helper function which writes the declaration of some `TFEL`
    * standard scalar alias. The `tfel::config::ScalarTypes` class for details.
diff --git a/mfront/src/CodeGeneratorUtilities.cxx b/mfront/src/CodeGeneratorUtilities.cxx
index d19462475..e0f014847 100644
--- a/mfront/src/CodeGeneratorUtilities.cxx
+++ b/mfront/src/CodeGeneratorUtilities.cxx
@@ -449,12 +449,19 @@ namespace mfront {
   }  // end of writeMaterialKnowledgeTypeSymbol
 
   void writeMaterialLaws(std::ostream& os,
-                         const std::vector<std::string>& materialLaws) {
+                         const std::vector<std::string>& materialLaws,
+                         const bool device_code_only) {
     if (materialLaws.empty()) {
       return;
     }
     // the implementations of the material laws which can be called in device
     // code are defined in the `mfront::device` namespace
+    if (device_code_only) {
+      for (const auto& l : materialLaws) {
+        os << "using mfront::device::" << l << ";\n";
+      }
+      return;
+    }
     os << "#ifdef TFEL_DEVICE_CODE\n";
     for (const auto& l : materialLaws) {
       os << "using mfront::device::" << l << ";\n";
diff --git a/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx b/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
index 1e9b24d03..c675801f7 100644
--- a/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
+++ b/mfront/src/GenericParallel/MaterialProperty/CUDABackendBase.cxx
@@ -112,7 +112,8 @@ namespace mfront::generic_parallel::material_property {
          << "mfront_" << v.name << "_field";
     }
     os << ",\nconst " << types.integer_type << " mfront_npoints){\n";
-    writeBeginningOfMaterialPropertyBody(os, mpd, fd, "double", true);
+    // the body of the kernel is only executed in device code
+    writeBeginningOfMaterialPropertyBody(os, mpd, fd, "double", true, true);
     //
     os << "const auto mfront_idx = static_cast<" << types.integer_type
        << ">(blockIdx.x) * blockDim.x + threadIdx.x;\n"
diff --git a/mfront/src/MaterialPropertyDescription.cxx b/mfront/src/MaterialPropertyDescription.cxx
index ebd3b6466..db45e3016 100644
--- a/mfront/src/MaterialPropertyDescription.cxx
+++ b/mfront/src/MaterialPropertyDescription.cxx
@@ -34,7 +34,8 @@ namespace mfront {
       const MaterialPropertyDescription& mpd,
       const FileDescription& fd,
       const std::string_view numeric_type,
-      const bool areQuantitiesSupported) {
+      const bool areQuantitiesSupported,
+      const bool device_code_only) {
     const auto use_qt = (areQuantitiesSupported && useQuantities(mpd));
     os << "using namespace std;\n"
        << "using tfel::math::invert_type;\n"
@@ -48,7 +49,7 @@ namespace mfront {
        << "[[maybe_unused]] auto max = [](const auto a, const auto b) "
        << "{ return a > b ? a : b; };\n";
     writeScalarStandardTypedefs(os, mpd, numeric_type, areQuantitiesSupported);
-    writeMaterialLaws(os, mpd.materialLaws);
+    writeMaterialLaws(os, mpd.materialLaws, device_code_only);
     writeStaticVariables(os, mpd.staticVars, fd.fileName);
   }  // end of writeBeginningOfMaterialPropertyBody
 
-- 
