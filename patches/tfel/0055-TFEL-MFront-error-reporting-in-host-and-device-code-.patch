diff --git a/docs/web/generic-parallel-behaviour-interface.md b/docs/web/generic-parallel-behaviour-interface.md
index 33552035a..5242ba1b4 100644
--- a/docs/web/generic-parallel-behaviour-interface.md
+++ b/docs/web/generic-parallel-behaviour-interface.md
@@ -522,11 +522,42 @@ virtual functions are not supported in device code by SYCL.
 
 The following rules apply to the code blocks written by the user:
 
-- exceptions are not supported in device code: return `false` (in
-  `@InitLocalVariables`, `@Integrator` of the default DSL, etc.) or
-  `FAILURE` instead of throwing an exception. The `raise` and `raise_if`
-  functions can't be used either.
-- the standard streams (`std::cout`) can't be used.
+- exceptions are not supported in device code. The `tfel::fail` function
+  reports an error in host and device code: on the host, it throws an
+  exception of the given type, as before; in device code, it returns
+  `false`, which must be returned by the code block:
+
+  ~~~~{.cxx}
+  if (q3 > q1) {
+    return tfel::fail<std::runtime_error>("q3 is greater than q1");
+  }
+  ~~~~
+
+  The `raise` and `raise_if` functions can't be used in device code.
+- returning `false` from the `@Integrator` code block of the implicit DSLs
+  (or from `@Derivative` in the Runge-Kutta DSLs) does not make the
+  integration fail: the correction of the Newton algorithm (or the time
+  step) is reduced. An exception, on the contrary, makes the integration
+  fail. The same result is obtained in device code by calling
+  `this->abortResolution()` (implicit DSLs) or `this->abortIntegration()`
+  (Runge-Kutta DSLs) before `tfel::fail`:
+
+  ~~~~{.cxx}
+  if (omega < 0) {
+    this->abortResolution();
+    return tfel::fail<std::runtime_error>("negative value of omega");
+  }
+  ~~~~
+- the standard streams (`std::cout`) can't be used in device code. They
+  can be kept on the host:
+
+  ~~~~{.cxx}
+  #ifndef TFEL_DEVICE_CODE
+  std::cout << "sig: " << sig << '\n';
+  #endif /* TFEL_DEVICE_CODE */
+  ~~~~
+- error messages built at runtime (`std::ostringstream`, `std::to_string`)
+  are only available on the host, in the same way.
 - function scope static variables must be constant expressions. Constant
   objects built at compile time must be accessed through
   `tfel::utilities::getConstantObject` (`nvcc` does not initialize the
diff --git a/include/TFEL/Math/NonLinearSolvers/TinyNonLinearSolverBase.hxx b/include/TFEL/Math/NonLinearSolvers/TinyNonLinearSolverBase.hxx
index 0db376a18..eda54a08e 100644
--- a/include/TFEL/Math/NonLinearSolvers/TinyNonLinearSolverBase.hxx
+++ b/include/TFEL/Math/NonLinearSolvers/TinyNonLinearSolverBase.hxx
@@ -236,6 +236,25 @@ namespace tfel::math {
      */
     TFEL_HOST_DEVICE constexpr void reportStandardIteration(
         const NumericType) const noexcept {}
+    /*!
+     * \brief abort the resolution: the solver reports a failure as soon as
+     * the current evaluation of the residual or of the correction fails.
+     * This allows to abort the resolution in device code, where exceptions
+     * are not supported (see `tfel::fail`):
+     *
+     * \code{.cpp}
+     * if (omega < 0) {
+     *   this->abortResolution();
+     *   return tfel::fail("negative value of omega");
+     * }
+     * \endcode
+     *
+     * On the host, `tfel::fail` throws an exception, which aborts the
+     * resolution anyway.
+     */
+    TFEL_HOST_DEVICE constexpr void abortResolution() noexcept {
+      this->iter = this->iterMax;
+    }
     //! \brief criterion value
     NumericType epsilon;
     /*!
diff --git a/include/TFEL/Raise.hxx b/include/TFEL/Raise.hxx
index 0181909b1..5dad96c09 100644
--- a/include/TFEL/Raise.hxx
+++ b/include/TFEL/Raise.hxx
@@ -66,6 +66,30 @@ namespace tfel {
   template <typename Exception = std::runtime_error, typename... Args>
   TFEL_VISIBILITY_LOCAL TFEL_INLINE void raise_if(const bool, Args&&...);
 
+  /*!
+   * \brief report a failure in a function returning a boolean, or a type
+   * which can be built from a boolean, in host and device code:
+   *
+   * - on the host, an exception of the given type is thrown;
+   * - in device code, where exceptions are not supported, `false` is
+   *   returned. The caller shall return this value.
+   *
+   * \code{.cpp}
+   * if (q3 > q1) {
+   *   return tfel::fail<std::runtime_error>("q3 is greater than q1");
+   * }
+   * \endcode
+   *
+   * \tparam Exception: type of the exception thrown on the host.
+   * \tparam Args: type of the arguments passed to the exception'
+   * constructor.
+   * \param[in] a: arguments passed to the exception' constructor, which
+   * are only used on the host.
+   */
+  template <typename Exception = std::runtime_error, typename... Args>
+  [[nodiscard]] TFEL_VISIBILITY_LOCAL TFEL_HOST_DEVICE TFEL_INLINE bool fail(
+      Args&&...);
+
 }  // end of namespace tfel
 
 #include "TFEL/Raise.ixx"
diff --git a/include/TFEL/Raise.ixx b/include/TFEL/Raise.ixx
index 80d45c3f6..c0d717e01 100644
--- a/include/TFEL/Raise.ixx
+++ b/include/TFEL/Raise.ixx
@@ -42,6 +42,15 @@ namespace tfel {
     }
   }  // end of raise
 
+  template <typename Exception, typename... Args>
+  TFEL_HOST_DEVICE bool fail([[maybe_unused]] Args&&... a) {
+#ifdef TFEL_DEVICE_CODE
+    return false;
+#else  /* TFEL_DEVICE_CODE */
+    raise<Exception>(std::forward<Args>(a)...);
+#endif /* TFEL_DEVICE_CODE */
+  }  // end of fail
+
 }  // end of namespace tfel
 
 #endif /* LIB_TFEL_RAISE_IXX */
