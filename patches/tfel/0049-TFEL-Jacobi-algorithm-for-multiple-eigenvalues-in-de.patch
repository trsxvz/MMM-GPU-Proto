From db4b2696c8d711f95edb3b86bbe4e568aa2a7bba Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 6 Oct 2026 16:10:27 +0200
Subject: [PATCH] TFEL: Jacobi algorithm for multiple eigenvalues in device
 code only

The eigenvectors of a multiple eigenvalue of a 3D symmetric tensor are
computed by the Jacobi algorithm in device code only, where recursion is
not supported. The host code keeps the analytical algorithm, so that the
results on CPUs are unchanged.
---
 .../Internals/StensorComputeEigenVectors.hxx  | 21 ++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/include/TFEL/Math/Stensor/Internals/StensorComputeEigenVectors.hxx b/include/TFEL/Math/Stensor/Internals/StensorComputeEigenVectors.hxx
index 4440192c1..34c6ec003 100644
--- a/include/TFEL/Math/Stensor/Internals/StensorComputeEigenVectors.hxx
+++ b/include/TFEL/Math/Stensor/Internals/StensorComputeEigenVectors.hxx
@@ -532,16 +532,23 @@ namespace tfel::math::internals {
                    10 * std::numeric_limits<T>::min());
       if ((tfel::math::abs(det1) < prec) && (tfel::math::abs(det2) < prec) &&
           (tfel::math::abs(det3) < prec)) {
-        // vp is a multiple eigenvalue. The eigenvectors are computed by the
-        // Jacobi algorithm, which handles this case without calling the
-        // current function recursively (recursion is not supported by all
-        // parallel programming models in device code)
+        // vp is a multiple eigenvalue
+        tvector<3u, T> v;
+        tmatrix<3u, 3u, T> m;
+#ifdef TFEL_DEVICE_CODE
+        // the eigenvectors are computed by the Jacobi algorithm, which
+        // handles this case without calling the current function
+        // recursively. Recursion is not supported by all parallel
+        // programming models in device code.
         auto sm = tmatrix<3u, 3u, T>{src[0], b,      c,  //
                                      b,      src[1], e,  //
                                      c,      e,      src[2]};
-        tvector<3u, T> v;
-        tmatrix<3u, 3u, T> m;
-        if (fses::syevj3(m, v, sm) != 0) {
+        const auto failed = fses::syevj3(m, v, sm) != 0;
+#else  /* TFEL_DEVICE_CODE */
+        const auto failed =
+            !StensorComputeEigenVectors<3u>::exe(src, v, m, true);
+#endif /* TFEL_DEVICE_CODE */
+        if (failed) {
           v0 = v1 = v2 = T(0);
           return false;
         }
