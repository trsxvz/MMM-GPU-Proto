+/*!
+ * \file   MFront/GenericParallelMaterialProperty/MaterialProperty.h
+ * \brief  This file declares the version of the functions generated by the
+ * `generic-parallel` interface for material properties.
+ * \date   08/10/2026
+ * \copyright Copyright (C) 2006-2025 CEA/DEN, EDF R&D. All rights
+ * reserved.
+ * This project is publicly released under either the GNU GPL Licence with
+ * linking exception or the CECILL-A licence. A copy of thoses licences are
+ * delivered with the sources of TFEL. CEA or EDF may also distribute this
+ * project under specific licensing conditions.
+ */
+
+#ifndef LIB_MFRONT_GENERICPARALLELMATERIALPROPERTY_MATERIALPROPERTY_H
+#define LIB_MFRONT_GENERICPARALLELMATERIALPROPERTY_MATERIALPROPERTY_H
+
+#include "MFront/GenericMaterialProperty/MaterialProperty.h"
+
+/*!
+ * \brief version of the functions generated by the `generic-parallel`
+ * interface for material properties (arguments, strides and statuses),
+ * exported by the generated libraries (`<name>_generic_parallel_api_version`
+ * symbol, next to the `<name>_generic_parallel_backend` symbol giving the
+ * name of the backend). It is incremented at each incompatible change of
+ * those functions.
+ */
+#define MFRONT_GPMP_API_VERSION 1
+
+#endif /* LIB_MFRONT_GENERICPARALLELMATERIALPROPERTY_MATERIALPROPERTY_H */
