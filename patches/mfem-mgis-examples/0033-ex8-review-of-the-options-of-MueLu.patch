From 87c742d2743c840e110871e807d2103d1772e7d4 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 16 Oct 2026 13:00:44 +0200
Subject: [PATCH] ex8: review of the options of MueLu

- The test rjh_plate-muelu uses MINRES instead of the conjugate gradient:
  on the coarse mesh, the tangent operator of the mechanics is not
  positive definite (the conjugate gradient meets directions of negative
  curvature, and only continues).
- -mls is checked at startup, and the options of MueLu without effect
  (-mls and -mld without a MueLu preconditioner, -mld with another
  smoother than jacobi) are reported by warnings.
- README: MueLu requires a Krylov solver of MFEM (the Krylov solvers of
  hypre only accept the preconditioners of hypre), -mls applies to both
  problems, -v does not apply to MueLu, the tangent operator is not
  positive definite on the coarse and refined meshes, measurements with
  MueLu, MINRES advised on the refined mesh.
- The test takes the GPU resource lock: MueLu may compute on the GPU.
---
 ex8/CMakeLists.txt       | 11 +++++++----
 ex8/README.md            | 12 ++++++------
 ex8/Thermomechanical.cxx | 30 ++++++++++++++++++++++++++++++
 3 files changed, 43 insertions(+), 10 deletions(-)

diff --git a/ex8/CMakeLists.txt b/ex8/CMakeLists.txt
index 935483a..b3f18af 100644
--- a/ex8/CMakeLists.txt
+++ b/ex8/CMakeLists.txt
@@ -77,19 +77,22 @@ if(MFEM_MGIS_EXAMPLES_FULL_TESTS)
 else()
   set(rjh_plate_mesh assemblage_hexa_coarse)
 endif()
-# the mechanical problem solved by the conjugate gradient of MFEM
-# preconditioned by MueLu (rigid body modes, Chebyshev smoother), if
-# mfem-mgis has the solvers of Trilinos
+# the mechanical problem solved by MINRES preconditioned by MueLu (rigid
+# body modes, Chebyshev smoother), if mfem-mgis has the solvers of Trilinos:
+# MINRES, not the conjugate gradient, as the tangent operator is not
+# positive definite on the coarse mesh. MueLu may compute on the GPU even
+# when MFEM computes on the CPU (Trilinos without a node of the host).
 if(MFEMMGIS_HAVE_TRILINOS)
   add_test(NAME rjh_plate-muelu
       COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} 2
           $<TARGET_FILE:rjh_plate>
           -m ${rjh_plate_mesh}.msh
-          -lsMc CGSolver -pcMc MueLu -mls chebyshev
+          -lsMc MINRESSolver -pcMc MueLu -mls chebyshev
           -rf ${rjh_plate_mesh}-statistics.ref
       WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
   set_tests_properties(rjh_plate-muelu PROPERTIES
       PROCESSORS 2
+      RESOURCE_LOCK gpu
       ENVIRONMENT OMP_NUM_THREADS=1)
 endif()
 # the mechanical problem is solved by MUMPS
