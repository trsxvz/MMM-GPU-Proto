From d600c917d75552dd23643121ea86b46f99eef76b Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 08:12:00 +0200
Subject: [PATCH] ex4: option --integration-rule-order (IntegrationRuleOrder
 parameter of mfem-mgis)

The order of the integration rules of the behaviour integrator can be
given (for instance 3 for 8 points by element instead of 27), the default
rule of mfem-mgis being used if it is negative.
---
 ex4/ssna303_hypre.cxx | 32 +++++++++++++++++++++-----------
 ex4/ssna303_mumps.cxx | 33 +++++++++++++++++++++------------
 ex4/ssna303_petsc.cxx | 32 +++++++++++++++++++++-----------
 3 files changed, 63 insertions(+), 34 deletions(-)

diff --git a/ex4/ssna303_hypre.cxx b/ex4/ssna303_hypre.cxx
index 4b6400f..f692fcc 100644
--- a/ex4/ssna303_hypre.cxx
+++ b/ex4/ssna303_hypre.cxx
@@ -40,6 +40,9 @@ int main(int argc, char** argv) {
   auto preconditioner = "HypreBoomerAMG";
   auto refinement = 0;
   auto order = 1;
+  // order of the integration rules of the behaviour integrator, the default
+  // rule of mfem-mgis if negative
+  auto integration_rule_order = -1;
   auto nbsteps = 50;
   auto end_time = mfem_mgis::real{1};
   auto profiling = false;
@@ -52,6 +55,9 @@ int main(int argc, char** argv) {
   mfem_mgis::declareDefaultOptions(args);
   args.AddOption(&order, "-o", "--order",
                  "Finite element order (polynomial degree).");
+  args.AddOption(&integration_rule_order, "-iro", "--integration-rule-order",
+                 "Order of the integration rules (for instance 3 for 8 points "
+                 "by element instead of 27), default rule if negative.");
   args.AddOption(&nbsteps, "-ns", "--nbsteps", "Number of time steps.");
   args.AddOption(
       &end_time, "-et", "--end-time",
@@ -91,17 +97,21 @@ int main(int argc, char** argv) {
 
   // loading the mesh
   {
-    auto problem =
-        mfem_mgis::construct<mfem_mgis::NonLinearEvolutionProblem>(
-            ctx,
-            mfem_mgis::Parameters{{"MeshFileName", mesh_file},
-                                  {"FiniteElementFamily", "H1"},
-                                  {"FiniteElementOrder", order},
-                                  {"UnknownsSize", dim},
-                                  {"NumberOfUniformRefinements", refinement},
-                                  {"Hypothesis", "Tridimensional"},
-                                  {"Parallel", true}}) |
-        or_die;
+    auto parameters =
+        mfem_mgis::Parameters{{"MeshFileName", mesh_file},
+                              {"FiniteElementFamily", "H1"},
+                              {"FiniteElementOrder", order},
+                              {"UnknownsSize", dim},
+                              {"NumberOfUniformRefinements", refinement},
+                              {"Hypothesis", "Tridimensional"},
+                              {"Parallel", true}};
+    if (integration_rule_order >= 0) {
+      parameters.insert(ctx, "IntegrationRuleOrder", integration_rule_order) |
+          or_die;
+    }
+    auto problem = mfem_mgis::construct<mfem_mgis::NonLinearEvolutionProblem>(
+                       ctx, parameters) |
+                   or_die;
 
     // 2 1 "Volume"
     if (use_fbar) {
diff --git a/ex4/ssna303_mumps.cxx b/ex4/ssna303_mumps.cxx
index 4cbf93c..5c4504b 100644
--- a/ex4/ssna303_mumps.cxx
+++ b/ex4/ssna303_mumps.cxx
@@ -46,6 +46,9 @@ int main(int argc, char** argv) {
   const char* standard_reference_file = "";
   auto parallel = true;
   auto order = 1;
+  // order of the integration rules of the behaviour integrator, the default
+  // rule of mfem-mgis if negative
+  auto integration_rule_order = -1;
   auto nbsteps = 50;
   auto end_time = mfem_mgis::real{1};
   auto profiling = false;
@@ -57,6 +60,9 @@ int main(int argc, char** argv) {
                  "Perform parallel computations.");
   args.AddOption(&order, "-o", "--order",
                  "Finite element order (polynomial degree).");
+  args.AddOption(&integration_rule_order, "-iro", "--integration-rule-order",
+                 "Order of the integration rules (for instance 3 for 8 points "
+                 "by element instead of 27), default rule if negative.");
   args.AddOption(&nbsteps, "-ns", "--nbsteps", "Number of time steps.");
   args.AddOption(
       &end_time, "-et", "--end-time",
@@ -89,18 +95,21 @@ int main(int argc, char** argv) {
   ctx.enableProfiling(profiling);
   const auto* const output_file = use_fbar ? "force-fbar.txt" : "force.txt";
   // the non linear problem
-  auto problem =
-      mfem_mgis::construct<mfem_mgis::NonLinearEvolutionProblem>(
-          ctx,
-          mfem_mgis::Parameters{
-              {"MeshFileName", mesh_file},
-              {"Materials", mfem_mgis::Parameters{{"NotchedBeam", 1}}},
-              {"FiniteElementFamily", "H1"},
-              {"FiniteElementOrder", order},
-              {"UnknownsSize", dim},
-              {"Hypothesis", "Tridimensional"},
-              {"Parallel", parallel}}) |
-      or_die;
+  auto parameters = mfem_mgis::Parameters{
+      {"MeshFileName", mesh_file},
+      {"Materials", mfem_mgis::Parameters{{"NotchedBeam", 1}}},
+      {"FiniteElementFamily", "H1"},
+      {"FiniteElementOrder", order},
+      {"UnknownsSize", dim},
+      {"Hypothesis", "Tridimensional"},
+      {"Parallel", parallel}};
+  if (integration_rule_order >= 0) {
+    parameters.insert(ctx, "IntegrationRuleOrder", integration_rule_order) |
+        or_die;
+  }
+  auto problem = mfem_mgis::construct<mfem_mgis::NonLinearEvolutionProblem>(
+                     ctx, parameters) |
+                 or_die;
 
   // 2 1 "Volume"
 #ifdef MGIS_HAVE_TFEL
diff --git a/ex4/ssna303_petsc.cxx b/ex4/ssna303_petsc.cxx
index 215eb00..af97a43 100644
--- a/ex4/ssna303_petsc.cxx
+++ b/ex4/ssna303_petsc.cxx
@@ -44,6 +44,9 @@ int main(int argc, char** argv) {
   const char* reference_file = "";
   const char* petscrc_file = "rc_ex10p";
   auto order = 1;
+  // order of the integration rules of the behaviour integrator, the default
+  // rule of mfem-mgis if negative
+  auto integration_rule_order = -1;
   auto nbsteps = 50;
   auto end_time = mfem_mgis::real{1};
   auto profiling = false;
@@ -55,6 +58,9 @@ int main(int argc, char** argv) {
   if (!mfem_mgis::usePETSc()) mfem_mgis::setPETSc(petscrc_file);
   args.AddOption(&order, "-o", "--order",
                  "Finite element order (polynomial degree).");
+  args.AddOption(&integration_rule_order, "-iro", "--integration-rule-order",
+                 "Order of the integration rules (for instance 3 for 8 points "
+                 "by element instead of 27), default rule if negative.");
   args.AddOption(&nbsteps, "-ns", "--nbsteps", "Number of time steps.");
   args.AddOption(
       &end_time, "-et", "--end-time",
@@ -82,17 +88,21 @@ int main(int argc, char** argv) {
 
   {
     // loading the mesh and timer
-    auto problem =
-        mfem_mgis::construct<mfem_mgis::NonLinearEvolutionProblem>(
-            ctx,
-            mfem_mgis::Parameters{{"MeshFileName", mesh_file},
-                                  {"FiniteElementFamily", "H1"},
-                                  {"FiniteElementOrder", order},
-                                  {"UnknownsSize", dim},
-                                  {"NumberOfUniformRefinements", refinement},
-                                  {"Hypothesis", "Tridimensional"},
-                                  {"Parallel", true}}) |
-        or_die;
+    auto parameters =
+        mfem_mgis::Parameters{{"MeshFileName", mesh_file},
+                              {"FiniteElementFamily", "H1"},
+                              {"FiniteElementOrder", order},
+                              {"UnknownsSize", dim},
+                              {"NumberOfUniformRefinements", refinement},
+                              {"Hypothesis", "Tridimensional"},
+                              {"Parallel", true}};
+    if (integration_rule_order >= 0) {
+      parameters.insert(ctx, "IntegrationRuleOrder", integration_rule_order) |
+          or_die;
+    }
+    auto problem = mfem_mgis::construct<mfem_mgis::NonLinearEvolutionProblem>(
+                       ctx, parameters) |
+                   or_die;
 
     // 2 1 "Volume"
     problem.addBehaviourIntegrator(ctx, "Mechanics", 1, library, behaviour) |
