From 73336d52d2eebbc320437d53be4d5939f97195f5 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 10 Nov 2026 02:12:54 +0100
Subject: [PATCH] ex6, ex8: values at the integration points read through the
 views

The arrays of the materials may be stored component by component (the
automatic layout of mfem-mgis for a material integrated by batches on a
GPU) or padded: they are read through the views of MGIS and the call
operator of the partial quadrature functions.

- ex6: values of a point of the partial quadrature functions read by the
  call operator (strided span).
- ex8: the deformation gradients of the mechanical materials and the
  swelling computed by the model (state variable SolidSwelling) are shared
  without copy through their views, the external state variables of the
  thermal materials being stored in the layout of the gradients of the
  mechanical ones (which covers a mechanics integrated on a GPU and a
  thermal problem integrated on the CPU); padded values are refused with a
  message. The statistics of the swelling are read through its view.
---
 ex6/RveNonLinearElastic.cxx |   6 +-
 ex8/headers/Debug.hxx       |  11 +++-
 ex8/headers/Setup.hxx       | 121 ++++++++++++++++++++++++++----------
 3 files changed, 101 insertions(+), 37 deletions(-)

diff --git a/ex6/RveNonLinearElastic.cxx b/ex6/RveNonLinearElastic.cxx
index 6f423b3..3e7a20d 100644
--- a/ex6/RveNonLinearElastic.cxx
+++ b/ex6/RveNonLinearElastic.cxx
@@ -240,12 +240,14 @@ void run_solve(mfem_mgis::attributes::MayAbort,
     // components Fxx, Fyy, Fzz, Fxy, Fyx, Fxz, Fzx, Fyz, Fzy
     const auto Fe = std::array<real, 9>{l[m - 1], 1, 1, 0, 0, 0, 0, 0, 0};
     const auto n = F.getPartialQuadratureSpace().getNumberOfIntegrationPoints();
+    // the call operator gives the values at an integration point whatever
+    // the layout of the arrays of the material
     for (mfem_mgis::size_type i = 0; i != n; ++i) {
-      const auto Fi = F.getIntegrationPointValues(i);
+      const auto Fi = F(i);
       for (std::size_t c = 0; c != Fe.size(); ++c) {
         error = std::max(error, std::abs(Fi[c] - Fe[c]));
       }
-      const auto Pi = P.getIntegrationPointValues(i);
+      const auto Pi = P(i);
       error = std::max(error, std::abs(Pi[0] - Pxx) / Pxx);
     }
   }
diff --git a/ex8/headers/Debug.hxx b/ex8/headers/Debug.hxx
index f14da09..213cf89 100644
--- a/ex8/headers/Debug.hxx
+++ b/ex8/headers/Debug.hxx
@@ -111,9 +111,14 @@ inline std::map<std::string, FieldStatistics> computePhysicsStatistics(
   const auto& swelling_material = setup.swelling_model->getMaterial();
   // read on the host
   swelling_material.synchronizeOnHostForReading();
-  const auto& swelling = swelling_material.s1.internal_state_variables;
-  stats["Swelling"] = computeFieldStatistics(
-      std::vector<double>(swelling.begin(), swelling.end()), comm);
+  // values read through the view of the variable, in all the layouts
+  const auto swelling = mgis::behaviour::getInternalStateVariableView(
+      swelling_material.s1, "SolidSwelling");
+  auto swelling_values = std::vector<double>{};
+  for (mfem_mgis::size_type i = 0; i != swelling.getNumberOfPoints(); ++i) {
+    swelling_values.push_back(swelling(i));
+  }
+  stats["Swelling"] = computeFieldStatistics(swelling_values, comm);
   stats["PowerDensity"] =
       computeFieldStatistics(*(setup.fields[0].Pow_s1_sw), comm);
   return stats;
diff --git a/ex8/headers/Setup.hxx b/ex8/headers/Setup.hxx
index c7b05cd..edaeca6 100644
--- a/ex8/headers/Setup.hxx
+++ b/ex8/headers/Setup.hxx
@@ -1,13 +1,18 @@
 #pragma once
 
