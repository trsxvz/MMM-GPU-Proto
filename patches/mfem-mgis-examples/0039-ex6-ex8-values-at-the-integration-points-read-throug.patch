+        mgis::behaviour::setExternalStateVariable(
+            ctx, *s_mc, "Swelling", swelling,
+            mgis::behaviour::MaterialStateManager::EXTERNAL_STORAGE,
+            mgis::behaviour::MaterialStateManager::NOUPDATE) |
+            or_die;
+      }
 
       mgis::behaviour::setExternalStateVariable(
           ctx, m_mc.s0, "PowerDensity",
