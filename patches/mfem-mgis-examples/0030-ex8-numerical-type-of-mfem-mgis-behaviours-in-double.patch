From f9084eaa7f63923a7534cf488ce0b83ff3c0bb12 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 21:08:29 +0200
Subject: [PATCH] ex8: numerical type of mfem-mgis, behaviours in double for
 MTest

- the physical parameters read by the options parser and the fields at
  the integration points use the numerical type of mfem-mgis (the
  OptionsParser of a MFEM in single precision only accepts real_t); the
  statistics of the fields are computed in double whatever their type.
- MTest computes in double and refuses a behaviour of another type: with
  float, the behaviours are also generated in double for the test of the
  swelling model (u3si2_swelling), whose input file is configured with
  the library to use.
Double: 24/24 on the CPU.
---
 ex8/CMakeLists.txt                            | 25 ++++++++++++++++--
 ex8/headers/Debug.hxx                         | 11 +++++---
 ex8/headers/Setup.hxx                         | 26 +++++++++----------
 .../{Swelling.mtest => Swelling.mtest.in}     |  2 +-
 4 files changed, 44 insertions(+), 20 deletions(-)
 rename ex8/mtest/{Swelling.mtest => Swelling.mtest.in} (94%)

diff --git a/ex8/CMakeLists.txt b/ex8/CMakeLists.txt
index 84e7c3b..6cd2361 100644
--- a/ex8/CMakeLists.txt
+++ b/ex8/CMakeLists.txt
@@ -51,7 +51,7 @@ add_executable(rjh_plate
 # file(COPY), configure_file updates the copies when these files are modified.
 foreach(input mesh/assemblage_hexa.msh mesh/assemblage_hexa_coarse.msh
               assemblage_hexa-statistics.ref
-              assemblage_hexa_coarse-statistics.ref mtest/Swelling.mtest)
+              assemblage_hexa_coarse-statistics.ref)
   get_filename_component(name ${input} NAME)
   configure_file(${CMAKE_CURRENT_SOURCE_DIR}/${input}
                  ${CMAKE_CURRENT_BINARY_DIR}/${name} COPYONLY)
@@ -162,7 +162,28 @@ if(MFEM_USE_MUMPS)
   endif()
 endif()
 
-# comparison of the swelling model to its exact value
+# comparison of the swelling model to its exact value. MTest computes in
+# double: with another numerical type, the behaviours are also generated in
+# double for this test (a mfem-mgis without numerical type uses double).
+if((NOT BehavioursEx8_REAL_TYPE) OR (BehavioursEx8_REAL_TYPE STREQUAL "double"))
+  set(U3SI2_MTEST_LIBRARY
+      "BehavioursEx8/cpu/libU3SI2${CMAKE_SHARED_LIBRARY_SUFFIX}")
+else()
+  set(_mtest_directory "${CMAKE_CURRENT_BINARY_DIR}/BehavioursEx8-mtest")
+  set(U3SI2_MTEST_LIBRARY
+      "${_mtest_directory}/src/libU3SI2-generic${CMAKE_SHARED_LIBRARY_SUFFIX}")
+  file(MAKE_DIRECTORY "${_mtest_directory}")
+  add_custom_command(
+    OUTPUT "${U3SI2_MTEST_LIBRARY}"
+    COMMAND "${MFRONT}" --obuild --interface=generic
+            "--include=${MFRONT_INCLUDE_DIR}" ${MFRONT_LOIS}
+    WORKING_DIRECTORY "${_mtest_directory}"
+    DEPENDS ${MFRONT_LOIS} ${MFRONT_HEADERS}
+    COMMENT "MFront: behaviours of ex8 in double for MTest")
+  add_custom_target(BehavioursEx8-mtest ALL DEPENDS "${U3SI2_MTEST_LIBRARY}")
+endif()
+configure_file(${CMAKE_CURRENT_SOURCE_DIR}/mtest/Swelling.mtest.in
+               ${CMAKE_CURRENT_BINARY_DIR}/Swelling.mtest @ONLY)
 add_test(NAME u3si2_swelling
     COMMAND mtest Swelling.mtest
     WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
diff --git a/ex8/headers/Debug.hxx b/ex8/headers/Debug.hxx
index 1c51a30..b38ab5e 100644
--- a/ex8/headers/Debug.hxx
+++ b/ex8/headers/Debug.hxx
@@ -26,15 +26,18 @@ struct FieldStatistics {
 };
 
 /*!
- * \return the statistics of values distributed over all processes
+ * \return the statistics of values distributed over all processes, computed
+ * in double whatever the type of the values
  * \param[in] values: values of the current process
  * \param[in] comm: communicator
  */
-inline FieldStatistics computeFieldStatistics(const std::vector<double>& values,
-                                              MPI_Comm comm) {
+template <typename ValueType>
+inline FieldStatistics computeFieldStatistics(
+    const std::vector<ValueType>& values, MPI_Comm comm) {
   auto s = FieldStatistics{std::numeric_limits<double>::max(),
                            -std::numeric_limits<double>::max(), 0};
-  for (const auto v : values) {
+  for (const auto value : values) {
+    const auto v = static_cast<double>(value);
     s.min = std::min(s.min, v);
     s.max = std::max(s.max, v);
     s.mean += v;
diff --git a/ex8/headers/Setup.hxx b/ex8/headers/Setup.hxx
index f0b0877..aceb41d 100644
--- a/ex8/headers/Setup.hxx
+++ b/ex8/headers/Setup.hxx
@@ -58,32 +58,32 @@ struct TestParameters {
   int verbosity_level = 0;      // verbosity level of the linear solvers
 
   // Physical properties
-  double Ti = 293.15;           // initial temperature (K)
-  double Te = 315.0;            // external/convection temperature (K)
-  double source = 1e10;         // volumetric power source term
-  double water_pressure = 1e6;  // coolant pressure
-  double end_time = 1e5;        // end time of the simulation
+  mfem_mgis::real Ti = 293.15;           // initial temperature (K)
+  mfem_mgis::real Te = 315.0;            // external/convection temperature (K)
+  mfem_mgis::real source = 1e10;         // volumetric power source term
+  mfem_mgis::real water_pressure = 1e6;  // coolant pressure
+  mfem_mgis::real end_time = 1e5;        // end time of the simulation
   int nbsteps = 1;              // number of time steps
-  double t_ramp = 1e5;          // duration of the power ramp
-  double h_conv = 5e4;          // thermal convection coefficient
+  mfem_mgis::real t_ramp = 1e5;          // duration of the power ramp
+  mfem_mgis::real h_conv = 5e4;          // thermal convection coefficient
 };
 
 struct GaussFieldStorage {
-  std::shared_ptr<std::vector<double>>
+  std::shared_ptr<std::vector<mfem_mgis::real>>
       T_s0;  // temperature at the beginning of the time step
-  std::shared_ptr<std::vector<double>>
+  std::shared_ptr<std::vector<mfem_mgis::real>>
       T_s1;  // temperature at the end of the time step
 
-  std::shared_ptr<std::vector<double>>
+  std::shared_ptr<std::vector<mfem_mgis::real>>
       Pow_s0_sw;  // power density (swelling model) at the beginning of the time
                   // step
-  std::shared_ptr<std::vector<double>>
+  std::shared_ptr<std::vector<mfem_mgis::real>>
       Pow_s1_sw;  // power density (swelling model) at the end of the time step
 
-  std::shared_ptr<std::vector<double>>
+  std::shared_ptr<std::vector<mfem_mgis::real>>
       Pow_s0_mmc;  // power density (mechanical material) at the beginning of
                    // the time step
-  std::shared_ptr<std::vector<double>>
+  std::shared_ptr<std::vector<mfem_mgis::real>>
       Pow_s1_mmc;  // power density (mechanical material) at the end of the time
                    // step
 };
