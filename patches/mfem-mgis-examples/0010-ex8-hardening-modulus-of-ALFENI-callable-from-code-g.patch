From 8bbec29af7cd97ee44ee84ed4fa2d1b7cc29fcea Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 14:50:21 +0200
Subject: [PATCH] ex8: hardening modulus of ALFENI callable from code generated
 for a GPU

computeHardeningModulus, called by ALFENI_IsotropicLinearHardeningPlasticity,
is now constexpr: the behaviours of ex8 can be generated by the
generic-parallel interface of MFront with the cuda backend (nvcc with
--expt-relaxed-constexpr), a host function being otherwise refused in the
device code. The generic interface is not affected.
---
 ex8/MFront/ALFENI_HardeningModulus.hxx | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/ex8/MFront/ALFENI_HardeningModulus.hxx b/ex8/MFront/ALFENI_HardeningModulus.hxx
index d115542..1ae30f4 100644
--- a/ex8/MFront/ALFENI_HardeningModulus.hxx
+++ b/ex8/MFront/ALFENI_HardeningModulus.hxx
@@ -1,6 +1,8 @@
 #pragma once
 
-inline double computeHardeningModulus(const double T_actuelle) {
+// constexpr: also callable from the code of the behaviours generated for a
+// GPU (nvcc with --expt-relaxed-constexpr)
+constexpr double computeHardeningModulus(const double T_actuelle) noexcept {
   double H = 1500e6;
 
   if (T_actuelle > 573.15) {
-- 
