diff --git a/README.md b/README.md
index 7340f6b..e317388 100644
--- a/README.md
+++ b/README.md
@@ -45,8 +45,15 @@ or `restricted`, selects the test mode explicitly:
 cmake -B build -DCMAKE_BUILD_TYPE=Release -DMFEM_MGIS_EXAMPLES_TEST_MODE=restricted
 ```
 
-The `MFEM_MGIS_EXAMPLES_GPU_TESTS` option (off by default) adds the tests of the examples which
-support it on a CUDA device, when MFEM is compiled with CUDA. A GPU is then required to run them.
+The `MFEM_MGIS_EXAMPLES_GPU_TESTS` option (off by default) adds the tests of the examples on a GPU
+(option `--execution gpu`, or `mixed` when a phase stays on the CPU), when MFEM is compiled with
+CUDA or HIP. A GPU is then required to run them.
+
+All the examples accept the options of mfem-mgis, in particular `--execution cpu|gpu|mixed`, which
+places the computations on the CPU, on the GPU, or each phase (finite elements, behaviours, linear
+solvers, post-processings) on one of them. Each example builds its behaviour libraries for the CPU
+and, if MFEM uses a GPU, for the GPU (CMake function `mfem_mgis_add_behaviours_library` of
+mfem-mgis), and uses the one placed by `--execution`, unless a library is given by its option `-l`.
 
 For an installation on a supercomputer without internet please follow the procedure described here for MFEM-MGIS installation: https://thelfer.github.io/mfem-mgis/installation_guide/installation_guide.html#installation-guide-on-topaze-ccrt-of-mfem-mgis-examples
 
diff --git a/config/TestMode.cmake b/config/TestMode.cmake
index d72b7a7..f96f6ce 100644
--- a/config/TestMode.cmake
+++ b/config/TestMode.cmake
@@ -39,19 +39,23 @@ endif()
 
 # Tests on a GPU, selected by the MFEM_MGIS_EXAMPLES_GPU_TESTS option (off by
 # default, a GPU being required when the tests are run): the examples which
-# support it are also tested on a CUDA device, if MFEM is compiled with CUDA
-# (as described by mfem-mgis, which must be found before this file is
-# included). The MFEM_MGIS_EXAMPLES_CUDA_TESTS variable is then true.
+# support it are also tested with the option --execution gpu (or mixed), if
+# MFEM is compiled with CUDA or HIP (as described by mfem-mgis, which must be
+# found before this file is included). The MFEM_MGIS_EXAMPLES_RUN_GPU_TESTS
+# variable is then true.
 option(MFEM_MGIS_EXAMPLES_GPU_TESTS "Test the examples on a GPU too" OFF)
-set(MFEM_MGIS_EXAMPLES_CUDA_TESTS OFF)
+set(MFEM_MGIS_EXAMPLES_RUN_GPU_TESTS OFF)
 if(MFEM_MGIS_EXAMPLES_GPU_TESTS)
   get_property(_mfem_mgis_examples_mfem_use_cuda GLOBAL
                PROPERTY MFEM_MGIS_MFEM_USE_CUDA)
-  if(_mfem_mgis_examples_mfem_use_cuda STREQUAL "YES")
-    set(MFEM_MGIS_EXAMPLES_CUDA_TESTS ON)
-    message(STATUS "Tests of the examples on a GPU: CUDA")
+  get_property(_mfem_mgis_examples_mfem_use_hip GLOBAL
+               PROPERTY MFEM_MGIS_MFEM_USE_HIP)
+  if((_mfem_mgis_examples_mfem_use_cuda STREQUAL "YES") OR
+     (_mfem_mgis_examples_mfem_use_hip STREQUAL "YES"))
+    set(MFEM_MGIS_EXAMPLES_RUN_GPU_TESTS ON)
+    message(STATUS "Tests of the examples on a GPU: yes")
   else()
     message(STATUS "Tests of the examples on a GPU: none, MFEM is not "
-                   "compiled with CUDA")
+                   "compiled with CUDA nor HIP")
   endif()
 endif()
