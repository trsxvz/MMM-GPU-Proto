From 68b1515d05856be38c83484a3e91a00514e67e73 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 12 Oct 2026 01:47:33 +0200
Subject: [PATCH] ex7: description of the behaviour library and mfem-mgis
 options

The option -l is described as in ex2, ex4, ex5 and ex6 (a library
generated by the generic-parallel interface may be given), and the
comment of declareDefaultOptions mentions the device, not only PETSc.
---
 ex7/MixedOxideFuels.cxx | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/ex7/MixedOxideFuels.cxx b/ex7/MixedOxideFuels.cxx
index 9822496..35b368e 100644
--- a/ex7/MixedOxideFuels.cxx
+++ b/ex7/MixedOxideFuels.cxx
@@ -62,7 +62,9 @@ struct TestParameters {
 
 void common_parameters(mfem::OptionsParser& args, TestParameters& p) {
   args.AddOption(&p.mesh_file, "-m", "--mesh", "Mesh file to use.");
-  args.AddOption(&p.library, "-l", "--library", "Material library.");
+  args.AddOption(&p.library, "-l", "--library",
+                 "Behaviour library (for instance a library generated by "
+                 "the generic-parallel interface).");
   args.AddOption(&p.order, "-o", "--order",
                  "Finite element order (polynomial degree).");
   args.AddOption(&p.refinement, "-r", "--refinement",
@@ -76,7 +78,8 @@ void common_parameters(mfem::OptionsParser& args, TestParameters& p) {
                  "no comparison if empty.");
   args.AddOption(&p.verbosity_level, "-v", "--verbosity-level",
                  "Verbosity level of the linear solvers.");
-  // PETSc options, handled by mfem_mgis::initialize
+  // options of mfem-mgis, such as the device (--device) and PETSc, handled
+  // by mfem_mgis::initialize
   mfem_mgis::declareDefaultOptions(args);
 
   args.Parse();
-- 
