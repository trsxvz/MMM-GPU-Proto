From b62fa17ec8ed205b2b4d93e6f3d197f698f4d522 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 21:46:20 +0200
Subject: [PATCH] ex8: symmetry of MUMPS for NewtonK0, ignored options
 reported, documentation

- The option -msMc also applies to the elastic operator factorized by
  MUMPS with NewtonK0 (SymmetricIndefinite by default, as before); its
  default for the Newton method is still Unsymmetric. An invalid value is
  refused even if MUMPS is not used.
- The options -amgMc and -msMc print a warning when they have no effect
  (no BoomerAMG preconditioner, linear solver other than MUMPS).
- The help and the README describe the options -nlsMc, -oMc, -amgMc and
  -msMc, and the assumption of the symmetric modes of MUMPS (the
  symmetry is not checked).
- Test rjh_plate-mumps-spd: the tangent operator given to MUMPS as a
  symmetric positive definite matrix, compared to the reference.
---
 ex8/CMakeLists.txt       | 13 ++++++++
 ex8/README.md            |  4 +++
 ex8/Thermomechanical.cxx | 14 +++++++--
 ex8/headers/Setup.hxx    |  8 +++--
 ex8/headers/Utils.hxx    | 66 ++++++++++++++++++++++++++++++++--------
 5 files changed, 86 insertions(+), 19 deletions(-)

diff --git a/ex8/CMakeLists.txt b/ex8/CMakeLists.txt
index 8b19119..7f3ae6b 100644
--- a/ex8/CMakeLists.txt
+++ b/ex8/CMakeLists.txt
@@ -112,6 +112,19 @@ set(rjh_plate_kernels_environment
 set_tests_properties(rjh_plate-kernels PROPERTIES
     PROCESSORS 2
     ENVIRONMENT "${rjh_plate_kernels_environment}")
+# the tangent operator of the mechanical problem given to MUMPS as a
+# symmetric positive definite matrix, compared to the same reference
+add_test(NAME rjh_plate-mumps-spd
+    COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} 2
+        $<TARGET_FILE:rjh_plate>
+        -m ${rjh_plate_mesh}.msh
+        -lsMc MUMPSSolver
+        -msMc SymmetricPositiveDefinite
+        -rf ${rjh_plate_mesh}-statistics.ref
+    WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
+set_tests_properties(rjh_plate-mumps-spd PROPERTIES
+    PROCESSORS 2
+    ENVIRONMENT "${rjh_plate_kernels_environment}")
 # the mechanical problem solved by the NewtonK0 method (tangent systems
 # solved by GMRES preconditioned by the elastic operator, factorized by
 # MUMPS at each time step), all the computations being made by kernels
diff --git a/ex8/README.md b/ex8/README.md
index a7edfea..ec80d71 100644
--- a/ex8/README.md
+++ b/ex8/README.md
@@ -82,6 +82,10 @@ Here is a summary table of the available options:
 | `-pcTh` | `--preconditioner-thermal` | Preconditioner associated with the thermal solver (default: `HypreBoomerAMG`), ignored for direct solvers. |
 | `-lsMc` | `--linearsolver-mechanics` | Name of the linear solver to use for the mechanics problem: the direct solver `MUMPSSolver` (default) or an iterative solver (e.g., `HyprePCG`). |
 | `-pcMc` | `--preconditioner-mechanics` | Preconditioner associated with the mechanics solver (default: `HypreBoomerAMG`), ignored for direct solvers. |
+| `-nlsMc` | `--nonlinear-solver-mechanics` | Non linear solver of the mechanics problem: `Newton` (default) or `NewtonK0` (tangent systems solved by GMRES preconditioned by the elastic operator, factorized by MUMPS at each time step). |
+| `-oMc` | `--ordering-mechanics` | Ordering of the degrees of freedom of the mechanics problem: `byNODES` (default) or `byVDIM`. |
+| `-amgMc` | `--amg-strategy-mechanics` | Strategy of the `HypreBoomerAMG` preconditioner of the mechanics problem: `System`, `Elasticity` (requires `byVDIM`) or `None` (default: the one of `mfem-mgis`). A warning is printed if the mechanics solver has no BoomerAMG preconditioner. |
+| `-msMc` | `--mumps-symmetry-mechanics` | Symmetry of the matrices of the mechanics problem given to MUMPS (tangent operator with `Newton`, elastic operator with `NewtonK0`): `Unsymmetric`, `SymmetricIndefinite` or `SymmetricPositiveDefinite` (default: `Unsymmetric` with `Newton`, `SymmetricIndefinite` with `NewtonK0`). The symmetric modes give the lower triangle of the matrices to MUMPS without checking their symmetry; the tangent operator of this example is symmetric and positive definite, and `SymmetricPositiveDefinite` speeds up its factorizations by about 30 %. |
 | `-o` | `--order` | Finite element order (polynomial degree, default: `1`). |
 | `-r` | `--refinement` | Uniform refinement level of the mesh (default: `0`). |
 | `-pp`, `-no-pp` | `--post-processing`, `--no-post-processing` | Enables (default) or disables the export of results for ParaView. |
