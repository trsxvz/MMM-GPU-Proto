+#else
+      // UMFPACK is not available (refused by MFEM with float, for instance)
+      mfem_mgis::abort(
+          "ssna303: the sequential computation requires UMFPACK (MFEM "
+          "with SuiteSparse): use --parallel (MUMPS)");
+#endif
     }
   }
