From 965fc05a8dd215e818e8c23b81ef6c35fde3005d Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 14:58:22 +0200
Subject: [PATCH] ex8: gradients of the mechanical materials synchronized
 before the heat transfer

The heat transfer behaviours read the deformation gradients of the
mechanical materials on the host, as external state variables given with
the EXTERNAL_STORAGE mode. When the mechanical behaviours are integrated on
a device (behaviours generated by the generic-parallel interface for this
device), the copies on the host of these gradients are not synchronized by
mfem-mgis: FieldUpdaterModel, the first model of each coupling iteration,
now synchronizes them for reading (see Material::synchronizeOnHost).

The host synchronization of the displacement added by 3a907f1 is removed:
it was redundant, GetVectorGradient reading the values through HostRead.
The GPU tests (MFEM_MGIS_EXAMPLES_GPU_TESTS option) and the tests of ex8
are documented in the README files.
---
 README.md                          |  3 +++
 ex8/README.md                      |  4 +++-
 ex8/Thermomechanical.cxx           |  8 +++++++-
 ex8/headers/BoundaryConditions.hxx | 26 +++++++++++++++++++++-----
 4 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/README.md b/README.md
index a92570b..7340f6b 100644
--- a/README.md
+++ b/README.md
@@ -45,6 +45,9 @@ or `restricted`, selects the test mode explicitly:
 cmake -B build -DCMAKE_BUILD_TYPE=Release -DMFEM_MGIS_EXAMPLES_TEST_MODE=restricted
 ```
 
+The `MFEM_MGIS_EXAMPLES_GPU_TESTS` option (off by default) adds the tests of the examples which
+support it on a CUDA device, when MFEM is compiled with CUDA. A GPU is then required to run them.
+
 For an installation on a supercomputer without internet please follow the procedure described here for MFEM-MGIS installation: https://thelfer.github.io/mfem-mgis/installation_guide/installation_guide.html#installation-guide-on-topaze-ccrt-of-mfem-mgis-examples
 
 ## Test case description
diff --git a/ex8/README.md b/ex8/README.md
index 1444eab..23a810d 100644
--- a/ex8/README.md
+++ b/ex8/README.md
@@ -123,8 +123,10 @@ The figures show the results at t = 2e6 s. They are computed with `mpirun -n 4 .
 
 ## Tests
 
-Three tests are run by `ctest`:
+The following tests are run by `ctest`:
 
 - `rjh_plate` runs the simulation on 2 processes with the default mesh and compares the statistics of the temperature and of the displacement to the reference values of `assemblage_hexa-statistics.ref`. In the restricted test mode, used by default in the debug and coverage builds, it uses the coarser mesh `assemblage_hexa_coarse.msh` and the reference values of `assemblage_hexa_coarse-statistics.ref`;
+- `rjh_plate-kernels` runs the same simulation with the integration of the behaviours by batches and the gradients, the inner forces and the tangent operator computed by kernels (environment variables of mfem-mgis), compared to the same reference;
+- `rjh_plate-cuda` and `rjh_plate-kernels-cuda` run both simulations on a CUDA device, if the `MFEM_MGIS_EXAMPLES_GPU_TESTS` option is set (see the main README);
 - `u3si2_swelling` compares the swelling model to its exact value under a power ramp (`mtest/Swelling.mtest`);
 - `robin_test` compares the Robin boundary condition to the exact solution of a bar (see `Robin/README.md`).
diff --git a/ex8/Thermomechanical.cxx b/ex8/Thermomechanical.cxx
index 7184cb4..3d67eb3 100644
--- a/ex8/Thermomechanical.cxx
+++ b/ex8/Thermomechanical.cxx
@@ -198,9 +198,15 @@ int main(int argc, char* argv[]) {
   c->setMaximumNumberOfIterations(ctx, 10) | or_die;
   c->addConvergenceCriterion(ctx, criterion) | or_die;
 
+  auto mechanical_materials = std::vector<const mfem_mgis::Material*>{};
+  for (const int mat_id : {1, 2, 3}) {
+    mechanical_materials.push_back(
+        &(mechanics.getMaterial(ctx, mat_id, 0) | or_die));
+  }
   auto updater_model = std::make_shared<FieldUpdaterModel>(
       ctx, mesh, setup.fields[0].Pow_s0_sw, setup.fields[0].Pow_s1_sw,
-      power_history, &u_mech, &mechanics.getUnknowns(mfem_mgis::ets));
+      power_history, &u_mech, &mechanics.getUnknowns(mfem_mgis::ets),
+      std::move(mechanical_materials));
 
   c->addModel(ctx, updater_model) | or_die;
   c->addModel(ctx, heat_transfer_model) | or_die;
diff --git a/ex8/headers/BoundaryConditions.hxx b/ex8/headers/BoundaryConditions.hxx
index 925d098..8635376 100644
--- a/ex8/headers/BoundaryConditions.hxx
+++ b/ex8/headers/BoundaryConditions.hxx
@@ -2,6 +2,8 @@
 #include <functional>
 #include <vector>
 #include <memory>
+#include <utility>
+#include "MFEMMGIS/Material.hxx"
 #include "MFEMMGIS/ModelBase.hxx"
 #include "MFEMMGIS/TimeStep.hxx"
 #include "MFEMMGIS/NonLinearEvolutionProblem.hxx"
@@ -22,8 +24,10 @@ void apply_boundary_conditions(
     mfem::GridFunction* u_mech);
 
 // Model used to manually update the source term before passing it to the
-// constitutive model responsible for swelling, and the displacement field
-// used by the Robin boundary condition.
+// constitutive model responsible for swelling, the displacement field used
+// by the Robin boundary condition, and the copies on the host of the
+// gradients of the mechanical materials, read by the heat transfer
+// behaviours (see Setup.hxx).
 class FieldUpdaterModel : public mfem_mgis::ModelBase {
  private:
   std::shared_ptr<std::vector<mfem_mgis::real>> Pow_s0;
@@ -31,6 +35,9 @@ class FieldUpdaterModel : public mfem_mgis::ModelBase {
   std::function<double(double)> power_history;
   mfem::GridFunction* u_mech;
   const mfem::Vector* u_mech_true;
+  // mechanical materials whose gradients are read on the host by the heat
+  // transfer behaviours as external state variables
+  std::vector<const mfem_mgis::Material*> mechanical_materials;
   std::string name;
 
  public:
@@ -40,13 +47,15 @@ class FieldUpdaterModel : public mfem_mgis::ModelBase {
                     std::shared_ptr<std::vector<mfem_mgis::real>> pow1,
                     std::function<double(double)> history_func,
                     mfem::GridFunction* u,
-                    const mfem::Vector* u_true)
+                    const mfem::Vector* u_true,
+                    std::vector<const mfem_mgis::Material*> materials)
       : mfem_mgis::ModelBase(ctx, mesh),
         Pow_s0(pow0),
         Pow_s1(pow1),
         power_history(history_func),
         u_mech(u),
         u_mech_true(u_true),
+        mechanical_materials(std::move(materials)),
         name("FieldUpdater") {}
 
   [[nodiscard]] std::string getName() const noexcept override { return name; }
@@ -61,8 +70,15 @@ class FieldUpdaterModel : public mfem_mgis::ModelBase {
     for (auto& val : *Pow_s0) val = p0;
     for (auto& val : *Pow_s1) val = p1;
     u_mech->SetFromTrueDofs(*u_mech_true);
-    // the displacement is read on the host by the Robin boundary condition
-    static_cast<void>(u_mech->HostRead());
+    // the mechanical behaviours may be integrated on a device, without
+    // synchronization of their arrays on the host (see
+    // mfem_mgis::Material::synchronizeOnHost)
+    for (const auto* const m : mechanical_materials) {
+      for (const auto s : {mfem_mgis::bts, mfem_mgis::ets}) {
+        m->synchronizeOnHostForReading(
+            mfem_mgis::MaterialArrays::StateArray::GRADIENTS, s);
+      }
+    }
 
     return {mfem_mgis::ExitStatus::success,
             mfem_mgis::ComputeNextStateOutput{}};
