From 936f23cd687917b2224fbf8e65110d1c2528ab0f Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 03:04:28 +0200
Subject: [PATCH] ex4: options of mfem-mgis, behaviour library and ParaView
 export (hypre)

The variant solved by hypre declares the default options of mfem-mgis
(--device, --hypre-device-pool-size), and takes the behaviour library
(-l, for instance a library generated by the generic-parallel interface)
and the export for ParaView (-no-pv to disable it) as options, for the
measurements on the GPU.
---
 ex4/ssna303_hypre.cxx | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/ex4/ssna303_hypre.cxx b/ex4/ssna303_hypre.cxx
index 10d921c..d1eb834 100644
--- a/ex4/ssna303_hypre.cxx
+++ b/ex4/ssna303_hypre.cxx
@@ -41,9 +41,12 @@ int main(int argc, char** argv) {
   auto nbsteps = 50;
   auto end_time = mfem_mgis::real{1};
   auto profiling = false;
+  auto paraview = true;
 
   // options treatment
   mfem::OptionsParser args(argc, argv);
+  // options of mfem-mgis (device, pool of memory of hypre on the GPU)
+  mfem_mgis::declareDefaultOptions(args);
   args.AddOption(&order, "-o", "--order",
                  "Finite element order (polynomial degree).");
   args.AddOption(&nbsteps, "-ns", "--nbsteps", "Number of time steps.");
@@ -61,6 +64,11 @@ int main(int argc, char** argv) {
   args.AddOption(&profiling, "-prof", "--profiling", "-no-prof",
                  "--no-profiling",
                  "Print the time spent in each phase of the computation.");
+  args.AddOption(&library, "-l", "--library",
+                 "Behaviour library (for instance a library generated by "
+                 "the generic-parallel interface).");
+  args.AddOption(&paraview, "-pv", "--paraview", "-no-pv", "--no-paraview",
+                 "Export the displacements for ParaView at each step.");
   args.Parse();
   if (args.Help()) {
     args.PrintUsage(mfem_mgis::getOutputStream());
@@ -182,11 +190,13 @@ int main(int argc, char** argv) {
     }
 
     // vtk export
-    problem.addPostProcessing(
-        ctx, "ParaviewExportResults",
-        {{"OutputFileName",
-          std::string("ssna303-displacements-HFGMRES_WS_1")}}) |
-        or_die;
+    if (paraview) {
+      problem.addPostProcessing(
+          ctx, "ParaviewExportResults",
+          {{"OutputFileName",
+            std::string("ssna303-displacements-HFGMRES_WS_1")}}) |
+          or_die;
+    }
     problem.addPostProcessing(
         ctx, "ComputeResultantForceOnBoundary",
         {{"Boundary", 2}, {"OutputFileName", "force_HFGMRES_WS_1.txt"}}) |
-- 
2.43.0

