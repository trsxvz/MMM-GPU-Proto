 ex7/MixedOxideFuels.cxx  | 47 ++++++++++++++++++++++++++++++++--------
 ex7/README.md            | 29 ++++++++++++++++++++-----
 ex8/README.md            | 18 +++++++++------
 ex8/Thermomechanical.cxx | 34 ++++++++++++++++++++---------
 ex8/headers/Setup.hxx    | 10 ++++-----
 ex8/headers/Utils.hxx    | 40 ++++++++++++++++++++++------------
 7 files changed, 139 insertions(+), 51 deletions(-)

