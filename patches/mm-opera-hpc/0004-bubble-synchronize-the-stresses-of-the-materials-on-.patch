From 59076954be0d04860e9f22ce6e0410da595127fe Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 16:33:19 +0200
Subject: [PATCH] bubble: synchronize the stresses of the materials on the host
 before reading them

---
 bubble/src/Utilities.cxx | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/bubble/src/Utilities.cxx b/bubble/src/Utilities.cxx
index 9e0d248..bb74249 100644
--- a/bubble/src/Utilities.cxx
+++ b/bubble/src/Utilities.cxx
@@ -59,7 +59,8 @@ namespace opera_hpc {
     }
     const auto mid = l.material_identifier->id;
 
-    // Pointer to stress values at end of time step
+    // Pointer to stress values at end of time step, read on the host
+    m.synchronizeOnHostForReading();
     const auto *stress_values = m.s1.thermodynamic_forces.data();
 
     // Initialize with very small value to find maximum
@@ -176,6 +177,8 @@ namespace opera_hpc {
       mfem_mgis::abort("getPointsAboveStressThresholdImplementation only works on materials");
     }
     const auto mid = l.material_identifier->id;
+    // stress values at the end of the time step, read on the host
+    m.synchronizeOnHostForReading();
     const auto *stress_values = m.s1.thermodynamic_forces.data();
 
     // Local collection of locations exceeding threshold
@@ -322,6 +325,8 @@ namespace opera_hpc {
       mfem_mgis::abort("getPointsandStressAboveStressThresholdImplementation only works on materials");
     }
     const auto mid = l.material_identifier->id;
+    // stress values at the end of the time step, read on the host
+    m.synchronizeOnHostForReading();
     const auto *stress_values = m.s1.thermodynamic_forces.data();
 
     // Collect both stress values and locations
-- 
