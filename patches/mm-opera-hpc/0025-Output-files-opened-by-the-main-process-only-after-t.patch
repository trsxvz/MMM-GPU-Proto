From 39077dff02c008de5f171a7214f2c6ae1524b58f Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 18:25:40 +0200
Subject: [PATCH] Output files opened by the main process only, after the
 options

- bubble: the output files were opened, hence emptied, before the parsing
  of the options, so that `-h` or an invalid option erased the results of
  a previous run; they were also opened by all the processes, whereas only
  the main one writes them. They are now opened after the parsing, by the
  main process, which aborts all the processes if it can't open them.
- polycrystal and cermet: every process opened the file of the
  macroscopic results and wrote the same lines at the same positions. The
  file is now opened and written by the main process only.
---
 bubble/src/Bubble.cxx                         | 37 +++++++++++--------
 cermet/cermet.cxx                             | 15 +++++---
 ...ialMacroscopicStressPeriodicSimulation.hxx |  2 +-
 polycrystal/UniaxialPolycrystal.cxx           | 15 +++++---
 ...ialMacroscopicStressPeriodicSimulation.cxx | 11 ++++--
 5 files changed, 47 insertions(+), 33 deletions(-)

diff --git a/bubble/src/Bubble.cxx b/bubble/src/Bubble.cxx
index 5ac0b84..1800ce1 100644
--- a/bubble/src/Bubble.cxx
+++ b/bubble/src/Bubble.cxx
@@ -343,28 +343,33 @@ int main(int argc, char** argv) {
   auto ctx = mfem_mgis::Context();
   auto or_die = ctx.getFatalFailureHandler();
   ctx.enableProfiling(true);
-  // Open output file for bubble stress results
-  std::string bubbles_selected = "bubbles_and_stresses_selected.txt";
-  std::string hydrostatic_stress_f = "sig_hydro.txt";
-  std::ofstream outfile_sighydr(hydrostatic_stress_f);
-  std::ofstream output_file_locations(bubbles_selected);
-
-  if (!output_file_locations.is_open()) {
-    std::cerr << "Failed to open the file: " << bubbles_selected << std::endl;
-    return EXIT_FAILURE;
-  }
-
-  if (!outfile_sighydr.is_open()) {
-    std::cerr << "Failed to open the file: " << hydrostatic_stress_f
-              << std::endl;
-    return EXIT_FAILURE;
-  }
 
   // Parse command-line parameters
   TestParameters p;
   mfem::OptionsParser args(argc, argv);
   fill_parameters(args, p);
 
+  // Open the output files of the bubble stresses and of the hydrostatic
+  // stress, written by the main process only, after the parsing of the
+  // options, so that the help does not overwrite the results of a previous
+  // run
+  const auto bubbles_selected =
+      std::string{"bubbles_and_stresses_selected.txt"};
+  const auto hydrostatic_stress_f = std::string{"sig_hydro.txt"};
+  std::ofstream outfile_sighydr;
+  std::ofstream output_file_locations;
+  const auto open = [](std::ofstream& file, const std::string& name) {
+    file.open(name);
+    if (!file.is_open()) {
+      std::cerr << "Failed to open the file: " << name << std::endl;
+      mfem_mgis::abort(EXIT_FAILURE);
+    }
+  };
+  if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) {
+    open(output_file_locations, bubbles_selected);
+    open(outfile_sighydr, hydrostatic_stress_f);
+  }
+
   print_memory_footprint("[Start]");
 
   // Physical parameters
diff --git a/cermet/cermet.cxx b/cermet/cermet.cxx
index 76b0648..d4d26ee 100644
--- a/cermet/cermet.cxx
+++ b/cermet/cermet.cxx
@@ -304,13 +304,16 @@ int main(int argc, char **argv) {
     }
     return times;
   }();
-  //
-  std::ofstream out(p.output_file);
-  if (!out) {
-    std::cerr << "can't open output file '" << p.output_file << "'\n";
-    return EXIT_FAILURE;
+  // main output file, written by the main process only
+  std::ofstream out;
+  if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) {
+    out.open(p.output_file);
+    if (!out) {
+      std::cerr << "can't open output file '" << p.output_file << "'\n";
+      mfem_mgis::abort(EXIT_FAILURE);
+    }
+    out.precision(14);
   }
-  out.precision(14);
   //
   const auto np = mm_opera_hpc::UniaxialMacroscopicStressPeriodicSimulation::
       NumericalParameters{.macroscopic_elastic_material_properties = mp};
diff --git a/include/MM_OPERA_HPC/UniaxialMacroscopicStressPeriodicSimulation.hxx b/include/MM_OPERA_HPC/UniaxialMacroscopicStressPeriodicSimulation.hxx
index 6ee9374..b0ecb66 100644
--- a/include/MM_OPERA_HPC/UniaxialMacroscopicStressPeriodicSimulation.hxx
+++ b/include/MM_OPERA_HPC/UniaxialMacroscopicStressPeriodicSimulation.hxx
@@ -92,7 +92,7 @@ namespace mm_opera_hpc {
      * \brief run the simulation over the given temporal sequences
      * \param[in] out: output files for the macroscopic results (diagonal
      * components of the deformation gradient and diagonal components of the
-     * Cauchy stress).
+     * Cauchy stress), written by the main process only.
      * \param[in] temporal_sequences: list of times defining the
      * temporal sequences.
      * \pre the times must be sorted in ascending order
diff --git a/polycrystal/UniaxialPolycrystal.cxx b/polycrystal/UniaxialPolycrystal.cxx
index 44e7f90..8f41b86 100644
--- a/polycrystal/UniaxialPolycrystal.cxx
+++ b/polycrystal/UniaxialPolycrystal.cxx
@@ -332,13 +332,16 @@ int main(int argc, char *argv[]) {
   const auto Fzz = [&p](const mfem_mgis::real ets) {
     return 1 + p.linear_strain_rate * ets;
   };
-  // main output file
-  std::ofstream out(p.output_file);
-  if (!out) {
-    std::cerr << "can't open output file '" << p.output_file << "'\n";
-    return EXIT_FAILURE;
+  // main output file, written by the main process only
+  std::ofstream out;
+  if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) {
+    out.open(p.output_file);
+    if (!out) {
+      std::cerr << "can't open output file '" << p.output_file << "'\n";
+      mfem_mgis::abort(EXIT_FAILURE);
+    }
+    out.precision(14);
   }
-  out.precision(14);
   // setting the simulation and running it
   const auto np = mm_opera_hpc::UniaxialMacroscopicStressPeriodicSimulation::
       NumericalParameters{.macroscopic_elastic_material_properties = mp};
diff --git a/src/UniaxialMacroscopicStressPeriodicSimulation.cxx b/src/UniaxialMacroscopicStressPeriodicSimulation.cxx
index 50865db..6fa2a8a 100644
--- a/src/UniaxialMacroscopicStressPeriodicSimulation.cxx
+++ b/src/UniaxialMacroscopicStressPeriodicSimulation.cxx
@@ -6,6 +6,7 @@
  */
 
 #include <cmath>
