From 7416eb8c0ffe4faf5e9fd2a953f6769941d442fa Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 14:14:59 +0200
Subject: [PATCH] Behaviour libraries for the CPU and the GPU, placed by
 --execution

The bubble, the cermet and the polycrystal build their behaviour
libraries with the CMake function mfem_mgis_add_behaviours_library of
mfem-mgis: for the CPU (generic interface) and, if MFEM uses a GPU, for the
GPU (generic-parallel interface). Their option -l gives a library; by
default, the library placed by the option --execution of mfem-mgis is used
(mfem_mgis::getBehavioursLibrary).

Tests on a GPU (option MM_OPERA_HPC_GPU_TESTS, for MFEM compiled with CUDA
or HIP): --execution gpu for the three cases, and the polycrystal with its
behaviours on the CPU (4 tests). Tests: 6/6 on the CPU, 4/4 on the GPU.
---
 CMakeLists.txt                      | 18 ++++++++++++++++++
 bubble/CMakeLists.txt               | 20 +++++++++++---------
 bubble/src/Bubble.cxx               | 24 +++++++++++++++++++++---
 cermet/CMakeLists.txt               | 29 ++++++++++++++---------------
 cermet/cermet.cxx                   | 27 ++++++++++++++++++++++-----
 polycrystal/CMakeLists.txt          | 28 ++++++++++++++--------------
 polycrystal/UniaxialPolycrystal.cxx | 22 +++++++++++++++++++---
 7 files changed, 119 insertions(+), 49 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d86d7e6..9bd1308 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -38,6 +38,24 @@ else(CMAKE_CONFIGURATION_TYPES)
    endif(NOT TARGET check)
 endif(CMAKE_CONFIGURATION_TYPES)
 
+# Tests on a GPU, selected by the MM_OPERA_HPC_GPU_TESTS option (off by
+# default, a GPU being required when the tests are run): the cases are also
+# tested with the option --execution gpu, if MFEM is compiled with CUDA or
+# HIP (as described by mfem-mgis). The MM_OPERA_HPC_RUN_GPU_TESTS variable is
+# then true.
+option(MM_OPERA_HPC_GPU_TESTS "Test the cases on a GPU too" OFF)
+set(MM_OPERA_HPC_RUN_GPU_TESTS OFF)
+if(MM_OPERA_HPC_GPU_TESTS)
+  get_property(_mm_opera_hpc_mfem_use_cuda GLOBAL
+               PROPERTY MFEM_MGIS_MFEM_USE_CUDA)
+  get_property(_mm_opera_hpc_mfem_use_hip GLOBAL
+               PROPERTY MFEM_MGIS_MFEM_USE_HIP)
+  if((_mm_opera_hpc_mfem_use_cuda STREQUAL "YES") OR
+     (_mm_opera_hpc_mfem_use_hip STREQUAL "YES"))
+    set(MM_OPERA_HPC_RUN_GPU_TESTS ON)
+  endif()
+endif()
+
 add_subdirectory(src)
 add_subdirectory(polycrystal)
 add_subdirectory(bubble)
