From 1a9eaf242e2af2c6765d37fbc258bf1211f318d9 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 19:06:38 +0200
Subject: [PATCH] Rejected time steps not written, review of the output files

- uniaxial periodic simulation: the values of a time step were written
  before the test of the fixed-point algorithm, so that a rejected step
  left non-converged values in the output file, at the same time as the
  accepted ones; they are now written only for an accepted step. A
  fixed-point algorithm converging at its last allowed iteration was also
  counted as a failure: the failure is now the absence of convergence
  after at most the given number of iterations.
- bubble: the output files are only opened when the post-processing step,
  which writes them, is enabled.
- the errors of opening of the output files use the message overload of
  mfem_mgis::abort; the usage is printed by the main process only when the
  mesh file is missing; documentation of the output stream of `run`.
---
 bubble/src/Bubble.cxx                         | 17 ++++++++--------
 cermet/cermet.cxx                             | 10 ++++++----
 ...ialMacroscopicStressPeriodicSimulation.hxx |  5 +++--
 polycrystal/UniaxialPolycrystal.cxx           | 10 ++++++----
 polycrystal/common.hxx                        |  5 +++--
 ...ialMacroscopicStressPeriodicSimulation.cxx | 20 +++++++++----------
 6 files changed, 37 insertions(+), 30 deletions(-)

diff --git a/bubble/src/Bubble.cxx b/bubble/src/Bubble.cxx
index 24bd591..63a79f6 100644
--- a/bubble/src/Bubble.cxx
+++ b/bubble/src/Bubble.cxx
@@ -243,9 +243,10 @@ void fill_parameters(mfem::OptionsParser& args, TestParameters& p) {
     exit(args.Help() ? EXIT_SUCCESS : EXIT_FAILURE);
   }
   if (p.mesh_file == nullptr) {
-    if (mfem_mgis::isMPIMainProcessForDefaultCommunicator())
+    if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) {
       std::cout << "ERROR: Mesh file missing" << std::endl;
-    args.PrintUsage(std::cout);
+      args.PrintUsage(std::cout);
+    }
     mfem_mgis::abort(EXIT_FAILURE);
   }
   if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) args.PrintOptions(std::cout);
@@ -350,9 +351,9 @@ int main(int argc, char** argv) {
   fill_parameters(args, p);
 
   // Open the output files of the bubble stresses and of the hydrostatic
-  // stress, written by the main process only, after the parsing of the
-  // options, so that the help does not overwrite the results of a previous
-  // run
+  // stress, written by the post-processing step on the main process only,
+  // after the parsing of the options, so that the help does not overwrite
+  // the results of a previous run
   const auto bubbles_selected =
       std::string{"bubbles_and_stresses_selected.txt"};
   const auto hydrostatic_stress_f = std::string{"sig_hydro.txt"};
@@ -361,11 +362,11 @@ int main(int argc, char** argv) {
   const auto open = [](std::ofstream& file, const std::string& name) {
     file.open(name);
     if (!file.is_open()) {
-      std::cerr << "Failed to open the file: " << name << std::endl;
-      mfem_mgis::abort(EXIT_FAILURE);
+      mfem_mgis::abort(("Failed to open the file: " + name).c_str());
     }
   };
-  if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) {
+  if ((p.post_processing) &&
+      (mfem_mgis::isMPIMainProcessForDefaultCommunicator())) {
     open(output_file_locations, bubbles_selected);
     open(outfile_sighydr, hydrostatic_stress_f);
   }
