From 5ac8a70c76c0f9957a99825a1ec8dfa37047d60a Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sat, 17 Oct 2026 01:10:14 +0200
Subject: [PATCH] Hashin-Shtrikman bounds, check scripts, ParaView exports,
 documentation

- the Hashin-Shtrikman bounds of the shear modulus (printed only) used
  wrong formulas: the lower bound was the Voigt value;
- check_polycrystal_restults.py and check_cermet_restults.py now exit with
  a non null status on a mismatch or if no time is common to the results
  and to the reference, and match the times once rounded (float outputs);
- the fields exported to ParaView by the polycrystal are labelled with the
  time of the end of the step;
- the documentation states that only the normal stresses are uniaxial (the
  macroscopic shear stresses are the reactions of the null off-diagonal
  components of the deformation gradient) and that the macroscopic elastic
  properties are given by the estimate of Kroener.
---
 cermet/check_cermet_restults.py               | 26 +++++++++++++------
 ...ialMacroscopicStressPeriodicSimulation.hxx |  6 +++--
 polycrystal/README.md                         |  4 ++-
 polycrystal/UniaxialPolycrystal.cxx           |  3 ++-
 polycrystal/check_polycrystal_restults.py     | 26 +++++++++++++------
 src/MacroscropicElasticMaterialProperties.cxx | 10 +++++--
 6 files changed, 53 insertions(+), 22 deletions(-)

diff --git a/cermet/check_cermet_restults.py b/cermet/check_cermet_restults.py
index c6513be..e180adf 100644
--- a/cermet/check_cermet_restults.py
+++ b/cermet/check_cermet_restults.py
@@ -1,10 +1,13 @@
+import sys
+
 import numpy as np
 import pandas as pd
 
-tolerance = 4 # 2%
+# relative difference accepted, in %
+tolerance = 4
 
 # --- Lecture du fichier .res ---
-data_res = pd.read_csv("cermet.res", sep="\s+", header=None)
+data_res = pd.read_csv("cermet.res", sep=r"\s+", header=None)
 data_res.columns = [f"col{i+1}" for i in range(data_res.shape[1])]
 data_res['col1'] = data_res['col1'].astype(float)
 
@@ -15,14 +18,17 @@ data_csv = data_csv[data_csv[0] != '']            # supprimer lignes vides
 data_csv[0] = data_csv[0].astype(float)
 
 # --- Fusion sur la première colonne ---
+# the times are matched once rounded: in single precision, the program
+# writes 0.40000000596046 for 0.4
+data_res['time_key'] = data_res['col1'].round(6)
+data_csv['time_key'] = data_csv[0].round(6)
 merged = pd.merge(
     data_res,
     data_csv,
-    left_on='col1',
-    right_on=0,
+    on='time_key',
     how='inner',
     suffixes=('_res', '_csv')
-)
+).drop(columns='time_key')
 
 # --- Comparaison ---
 col_res = 'col7'      # 7ème colonne du .res
@@ -48,8 +54,12 @@ output.columns = ['Time', 'MFEM/MGIS', 'CAST3M', 'RelDiff_%', 'Status']
 print(output)
 output.to_csv("comparison_results.csv", index=False)
 
-# Check if the 'Status' column contains any "MISMATCH"
+# Check if the 'Status' column contains any "MISMATCH": the exit status is
+# not null on a mismatch, or if no time is common to both files
+if output.empty:
+    print("No time common to the results and to the reference!")
+    sys.exit(1)
 if (output['Status'] == 'MISMATCH').any():
     print("There is at least one MISMATCH in the data!")
-else:
-    print("Check PASS.")
+    sys.exit(1)
+print("Check PASS.")
