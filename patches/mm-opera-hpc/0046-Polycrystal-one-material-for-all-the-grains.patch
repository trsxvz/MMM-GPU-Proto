diff --git a/CMakeLists.txt b/CMakeLists.txt
index 32a538f..529d0f6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -95,6 +95,51 @@ function(mm_opera_hpc_add_checked_test)
                    -- ${_t_COMMAND})
 endfunction()
 
+# Tests comparing the results of a case to the ones of the same case run
+# with additional options, which must not change them: the case is run
+# twice by cmake/run-and-compare.py, each run in its own directory
+# (<name>/reference and <name>/compared in the build directory of the case,
+# so that the files given to the command must be absolute paths), then the
+# values of their output files are compared, by ranges of columns, with a
+# relative tolerance (see the script). Without Python 3, the case is only
+# run with the additional options.
+#
+# usage: mm_opera_hpc_add_compared_test(NAME <name>
+#            COMPARISONS <output file> <columns> <relative tolerance>
+#                        [<output file> <columns> <relative tolerance>...]
+#            OPTIONS <additional option...>
+#            COMMAND <command...>)
+set(MM_OPERA_HPC_RUN_AND_COMPARE
+    "${CMAKE_CURRENT_SOURCE_DIR}/cmake/run-and-compare.py")
+function(mm_opera_hpc_add_compared_test)
+  cmake_parse_arguments(_t "" "NAME" "COMPARISONS;OPTIONS;COMMAND" ${ARGN})
+  if(NOT Python3_Interpreter_FOUND)
+    add_test(NAME ${_t_NAME} COMMAND ${_t_COMMAND} ${_t_OPTIONS})
+    return()
+  endif()
+  set(_comparisons)
+  list(LENGTH _t_COMPARISONS _n)
+  math(EXPR _last "${_n} - 1")
+  foreach(_i RANGE 0 ${_last} 3)
+    math(EXPR _j "${_i} + 1")
+    math(EXPR _k "${_i} + 2")
+    list(GET _t_COMPARISONS ${_i} _file)
+    list(GET _t_COMPARISONS ${_j} _columns)
+    list(GET _t_COMPARISONS ${_k} _tolerance)
+    list(APPEND _comparisons --compare ${_file} ${_columns} ${_tolerance})
+  endforeach()
+  set(_options)
+  foreach(_option ${_t_OPTIONS})
+    list(APPEND _options "--option=${_option}")
+  endforeach()
+  add_test(NAME ${_t_NAME}
+           COMMAND ${Python3_EXECUTABLE}
+                   ${MM_OPERA_HPC_RUN_AND_COMPARE}
+                   --directory ${CMAKE_CURRENT_BINARY_DIR}/${_t_NAME}
+                   ${_comparisons} ${_options}
+                   -- ${_t_COMMAND})
+endfunction()
+
 add_subdirectory(src)
 add_subdirectory(polycrystal)
 add_subdirectory(bubble)
diff --git a/cmake/run-and-compare.py b/cmake/run-and-compare.py
new file mode 100755
index 0000000..69fca3a
--- /dev/null
+++ b/cmake/run-and-compare.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Runs a test case twice, the second time with additional options, then
+compares the values of the output files of the two runs, with a relative
+tolerance.
+
+usage: run-and-compare.py --directory <directory>
+           --compare <file> <columns> <tolerance> [--compare ...]
+           --option=<option> [--option=<option> ...] -- <command...>
+
+- the command is run in <directory>/reference then, followed by the
+  additional options, in <directory>/compared: an output file whose name is
+  fixed by the case is overwritten neither by the other run nor by another
+  test. The files given to the command must thus be absolute paths, and its
+  output files relative ones;
+- <file>: output file, in the directory of each run;
+- <columns>: columns compared (starting at 1), as ranges separated by
+  commas, for instance `1,2-4,5-7` (`2-`: from the second column to the last
+  one). The values of a range are of the same nature (the components of a
+  stress, for instance): the difference between two values is relative to
+  the largest absolute value of the range in the row, so that a component
+  which is null up to the rounding errors can be compared;
+- <tolerance>: relative tolerance on the values of this file;
+- the directories of the two runs are emptied before running the command,
+  so that a result of a previous run can't be compared.
+
+The values are separated by spaces or by commas; the lines whose first
+field is not a number are headers. Only the standard library is used.
+"""
+
+import argparse
+import math
+import os
+import shutil
+import subprocess
+import sys
+
+
+def is_number(s):
+    try:
+        float(s)
+        return True
+    except ValueError:
+        return False
+
+
+def read_values(path):
+    """returns the rows of values"""
+    rows = []
+    with open(path) as f:
+        for line in f:
+            sep = "," if "," in line else None
+            fields = [v.strip() for v in line.split(sep)]
+            fields = [v for v in fields if v]
+            if fields and is_number(fields[0]):
+                rows.append([float(v) for v in fields])
+    return rows
+
+
+def read_ranges(columns):
+    """returns the ranges of columns as pairs (first, last), starting at 1,
+    the last one being None for the last column of the file"""
+    ranges = []
+    for r in columns.split(","):
+        first, sep, last = r.partition("-")
+        if not sep:
+            last = first
+        ranges.append((int(first), int(last) if last else None))
+    return ranges
+
+
+def compare(name, reference, compared, columns, tolerance):
+    """compares two files, returns true if their values are the same up to
+    the tolerance"""
+    a = read_values(reference)
+    b = read_values(compared)
+    if not a:
+        print(f"no row in '{reference}': MISMATCH")
+        return False
+    if [len(r) for r in a] != [len(r) for r in b]:
+        print(f"'{name}': {len(a)} and {len(b)} rows, or rows of different "
+              "sizes: MISMATCH")
+        return False
+    success = True
+    for first, last in read_ranges(columns):
+        error = 0.
+        for ra, rb in zip(a, b):
+            va = ra[first - 1:last]
+            vb = rb[first - 1:last]
+            # a missing column or a value which is not finite is a mismatch
+            if len(ra) < (last or first) or \
+                    not all(math.isfinite(v) for v in va + vb):
+                error = math.inf
+                break
+            scale = max(abs(v) for v in va + vb)
+            if scale != 0:
+                difference = max(abs(x - y) for x, y in zip(va, vb))
+                error = max(error, difference / scale)
+        ok = error <= tolerance
+        print(f"'{name}', columns {first}-{last if last else ''}, "
+              f"{len(a)} rows: maximum relative difference {error:.3g} "
+              f"(tolerance {tolerance:g}): {'OK' if ok else 'MISMATCH'}")
+        success = success and ok
+    return success
+
+
+def main():
+    if "--" not in sys.argv:
+        sys.exit("run-and-compare.py: no command given (after --)")
+    i = sys.argv.index("--")
+    command = sys.argv[i + 1:]
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--directory", required=True)
+    parser.add_argument("--compare", nargs=3, action="append", required=True,
+                        metavar=("FILE", "COLUMNS", "TOLERANCE"))
+    parser.add_argument("--option", action="append", required=True)
+    args = parser.parse_args(sys.argv[1:i])
+    directories = {}
+    for run, options in (("reference", []), ("compared", args.option)):
+        d = os.path.join(args.directory, run)
+        shutil.rmtree(d, ignore_errors=True)
+        os.makedirs(d)
+        directories[run] = d
+        # the outputs of the command precede the ones of this script
+        sys.stdout.flush()
+        status = subprocess.run(command + options, cwd=d).returncode
+        if status != 0:
+            sys.exit(f"run-and-compare.py: the {run} command failed "
+                     f"(status {status})")
+    success = True
+    for name, columns, tolerance in args.compare:
+        files = [os.path.join(directories[r], name)
+                 for r in ("reference", "compared")]
+        missing = [f for f in files if not os.path.exists(f)]
+        if missing:
+            sys.exit(f"run-and-compare.py: no output file '{missing[0]}'")
+        success = compare(name, files[0], files[1], columns,
+                          float(tolerance)) and success
+    sys.exit(0 if success else 1)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as e:
+        # reported as the other failures (see the tests expecting a pattern
+        # in the output, whose exit status is ignored by ctest)
+        sys.exit(f"run-and-compare.py: {e!r}")
diff --git a/polycrystal/CMakeLists.txt b/polycrystal/CMakeLists.txt
index 224a60f..5a7952c 100755
--- a/polycrystal/CMakeLists.txt
+++ b/polycrystal/CMakeLists.txt
@@ -36,6 +36,63 @@ mm_opera_hpc_add_checked_test(NAME UniaxialPolycrystalTest-DisplacementGradient
   COMMAND $<TARGET_FILE:uniaxial-polycrystal> ${_polycrystal_options}
           --macroscopic-stress-output-file polycrystal-test-dg.res
           --displacement-gradient)
+# the same with one material for all the grains (option --single-material),
+# whose number is written when the option is taken into account (expected in
+# the output, which reveals an ignored option; ctest then ignores the exit
+# status: a mismatch, a failure of the command or an error of the scripts
+# of cmake/ is recognized by its message)
+mm_opera_hpc_add_checked_test(NAME UniaxialPolycrystalTest-SingleMaterial
+  FILE polycrystal-test-single-material.res ${_polycrystal_checks}
+  COMMAND $<TARGET_FILE:uniaxial-polycrystal> ${_polycrystal_options}
+          --macroscopic-stress-output-file polycrystal-test-single-material.res
+          --single-material)
+# one material for all the grains gives the results of one material per
+# grain: two time steps of 0.2 s with the averages of the stresses per grain
+# (post-processings without the ParaView export), with and without the
+# option, on one process and on two. Compared: the main output file
+# (time, diagonal components of the deformation gradient, diagonal
+# components of the stress, relatively to the axial one) and the averages
+# per grain (file avgStressPolycrystal, relatively to the largest component
+# at each time).
+# In double, the two computations only differ by the order of some sums:
+# relative differences of 1e-16 were measured on the main output file of
+# this case (4e-17 on one process, 1e-16 on two), and 3e-13 for 100 grains
+# on 96 processes. Its 14 digits are compared with a tolerance of 1e-9,
+# which still accepts linear solves (relative tolerance of 1e-12) stopping
+# one iteration apart. The averages per grain are written with 6 digits,
+# hence the tolerance of 2e-5 (twice a unit of the last digit); they were
+# identical. In float, the stresses are only known within 3e4 Pa or so (see
+# the tolerances of the simulation), for an axial stress of 1.8e7 Pa at the
+# first time step: tolerance of 1 %, the one of the comparison to Cast3M.
+if("${MFEMMGIS_REAL_TYPE}" STREQUAL "float")
+  set(_polycrystal_comparisons polycrystal.res 1,2-4,5-7 1e-2
+                               avgStressPolycrystal 1,2- 1e-2)
+else()
+  set(_polycrystal_comparisons polycrystal.res 1,2-4,5-7 1e-9
+                               avgStressPolycrystal 1,2- 2e-5)
+endif()
+set(_polycrystal_comparison_options
+    --disable-paraview-export --nstep 2 --duration 0.4
+    --mesh ${CMAKE_CURRENT_SOURCE_DIR}/mesh/5crystals.msh
+    --vect ${CMAKE_CURRENT_SOURCE_DIR}/mesh/vectors_5crystals.txt
+    --macroscopic-stress-output-file polycrystal.res)
+mm_opera_hpc_add_compared_test(
+  NAME UniaxialPolycrystalTest-SingleMaterial-Comparison
+  COMPARISONS ${_polycrystal_comparisons}
+  OPTIONS --single-material
+  COMMAND $<TARGET_FILE:uniaxial-polycrystal>
+          ${_polycrystal_comparison_options})
+mm_opera_hpc_add_compared_test(
+  NAME UniaxialPolycrystalTestPar-SingleMaterial-Comparison
+  COMPARISONS ${_polycrystal_comparisons}
+  OPTIONS --single-material
+  COMMAND mpirun -n 2 $<TARGET_FILE:uniaxial-polycrystal>
+          ${_polycrystal_comparison_options})
+set_tests_properties(UniaxialPolycrystalTest-SingleMaterial
+  UniaxialPolycrystalTest-SingleMaterial-Comparison
+  UniaxialPolycrystalTestPar-SingleMaterial-Comparison PROPERTIES
+  PASS_REGULAR_EXPRESSION "Nombre de grains : +5"
+  FAIL_REGULAR_EXPRESSION "MISMATCH;run-and-check.py: ;run-and-compare.py: ;no row ;Traceback")
 if(MM_OPERA_HPC_RUN_GPU_TESTS AND BehavioursPolycrystal_HAVE_GPU_BEHAVIOURS)
   mm_opera_hpc_add_checked_test(NAME UniaxialPolycrystalTest-gpu
     FILE polycrystal-test-gpu.res ${_polycrystal_checks}
