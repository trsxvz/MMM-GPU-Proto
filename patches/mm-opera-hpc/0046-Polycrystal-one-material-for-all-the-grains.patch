     mfem_mgis::attributes::MayAbort,
     mfem_mgis::Context &,
@@ -195,7 +220,15 @@ static void setupMaterials(
     mfem_mgis::Context &,
     mfem_mgis::PeriodicNonLinearEvolutionProblem &,
