From 1ba7636eb208a0bca04b84a62f9c360a51987eb1 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 16:26:27 +0200
Subject: [PATCH] Help option (-h) exits with success again

Since the invalid options exit with EXIT_FAILURE, the help, which MFEM reports as a parsing that is not good, also failed in the cermet, the bubble and the polycrystal. The status is now EXIT_SUCCESS for the help.
---
 bubble/src/Bubble.cxx               | 5 +++--
 cermet/cermet.cxx                   | 5 +++--
 polycrystal/UniaxialPolycrystal.cxx | 5 +++--
 3 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/bubble/src/Bubble.cxx b/bubble/src/Bubble.cxx
index 851bfe3..63a4b2f 100644
--- a/bubble/src/Bubble.cxx
+++ b/bubble/src/Bubble.cxx
@@ -237,8 +237,9 @@ void fill_parameters(mfem::OptionsParser& args, TestParameters& p) {
   if (!args.Good()) {
     if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) args.PrintUsage(std::cout);
     mfem_mgis::finalize();
-    // an invalid option is a failure, which a test must see
-    exit(EXIT_FAILURE);
+    // the help (-h) is a success, an invalid option a failure, which a
+    // test must see
+    exit(args.Help() ? EXIT_SUCCESS : EXIT_FAILURE);
   }
   if (p.mesh_file == nullptr) {
     if (mfem_mgis::isMPIMainProcessForDefaultCommunicator())
diff --git a/cermet/cermet.cxx b/cermet/cermet.cxx
index 77cad5e..427f41a 100644
--- a/cermet/cermet.cxx
+++ b/cermet/cermet.cxx
@@ -100,8 +100,9 @@ static void parseCommandLineOptions(mfem::OptionsParser &args,
   if (!args.Good()) {
     if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) args.PrintUsage(std::cout);
     mfem_mgis::finalize();
-    // an invalid option is a failure, which a test must see
-    exit(EXIT_FAILURE);
+    // the help (-h) is a success, an invalid option a failure, which a
+    // test must see
+    exit(args.Help() ? EXIT_SUCCESS : EXIT_FAILURE);
   }
   if (p.mesh_file == nullptr) {
     if (mfem_mgis::isMPIMainProcessForDefaultCommunicator())
diff --git a/polycrystal/UniaxialPolycrystal.cxx b/polycrystal/UniaxialPolycrystal.cxx
index 787822a..db30c1e 100644
--- a/polycrystal/UniaxialPolycrystal.cxx
+++ b/polycrystal/UniaxialPolycrystal.cxx
@@ -436,8 +436,9 @@ static void parseCommandLineArguments(mfem::OptionsParser &args,
   if (!args.Good()) {
     if (mfem_mgis::isMPIMainProcessForDefaultCommunicator()) args.PrintUsage(std::cout);
     mfem_mgis::finalize();
-    // an invalid option is a failure, which a test must see
-    exit(EXIT_FAILURE);
+    // the help (-h) is a success, an invalid option a failure, which a
+    // test must see
+    exit(args.Help() ? EXIT_SUCCESS : EXIT_FAILURE);
   }
   if (p.mesh_file == nullptr) {
     if (mfem_mgis::isMPIMainProcessForDefaultCommunicator())
