From 575762a7ba761ba6babbb01ab4b429d2b801a03a Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 18:48:20 +0200
Subject: [PATCH] Cermet and bubble: options of mfem-mgis, library of the
 cermet

The options of mfem-mgis (declareDefaultOptions: --device, --kokkos...)
are declared by the cermet and by the bubble, whose parsers refused
them. The cermet has an option -l (--library) giving the library of the
behaviours of the grains and of the metallic interface, for instance a
library generated by the generic-parallel interface of MFront.
---
 bubble/src/Bubble.cxx |  2 ++
 cermet/cermet.cxx     | 13 +++++++++----
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/bubble/src/Bubble.cxx b/bubble/src/Bubble.cxx
index 317301f..28b1b35 100644
--- a/bubble/src/Bubble.cxx
+++ b/bubble/src/Bubble.cxx
@@ -185,6 +185,8 @@ struct TestParameters : PhysicalParameters {
  * \param p Parameter structure to fill
  */
 void fill_parameters(mfem::OptionsParser& args, TestParameters& p) {
+  // options of mfem-mgis (device of MFEM...)
+  mfem_mgis::declareDefaultOptions(args);
   args.AddOption(&p.mesh_file, "-m", "--mesh", "Mesh file to use.");
   args.AddOption(&p.parallel_mesh, "-pm", "--parallel-mesh",
                  "Parallel mesh format or not");
diff --git a/cermet/cermet.cxx b/cermet/cermet.cxx
index bde43d7..845cbcf 100644
--- a/cermet/cermet.cxx
+++ b/cermet/cermet.cxx
@@ -49,8 +49,8 @@ struct TestParameters {
   //  const char *behaviourGrain = "MonoCristal_UO2";
   const char *behaviourGrain = "Mono_UO2_Cosh_Jaco3";
   const char *behaviourMetal = "NortonCr";
-  const char *libraryGrain = "src/libBehaviour.so";
-  const char *libraryMetal = "src/libBehaviour.so";
+  //! \brief library of the behaviours of the grains and of the interface
+  const char* library = "src/libBehaviour.so";
   const char *vector_file = "vectors_5grains.txt";
   int order = 1;
   int refinement = 0;
@@ -62,11 +62,16 @@ struct TestParameters {
 
 static void parseCommandLineOptions(mfem::OptionsParser &args,
                                     TestParameters &p) {
+  // options of mfem-mgis (device of MFEM...)
+  mfem_mgis::declareDefaultOptions(args);
   args.AddOption(&p.output_file, "", "--macroscopic-stress-output-file",
                  "main output file containing the evolution of the diagonal "
                  "components of the deformation gradient and the  diagonal "
                  "components of the Cauchy stress.");
   args.AddOption(&p.mesh_file, "-m", "--mesh", "Mesh file to use.");
+  args.AddOption(&p.library, "-l", "--library",
+                 "Material library containing the behaviours of the grains "
+                 "and of the metallic interface.");
   args.AddOption(&p.order, "-o", "--order",
                  "Finite element order (polynomial degree).");
   args.AddOption(&p.refinement, "-r", "--refinement",
@@ -160,7 +165,7 @@ static void setup_material_properties(
 
   // TEST metal
   {
-    problem.addBehaviourIntegrator(ctx, "Mechanics", 1, p.libraryMetal,
+    problem.addBehaviourIntegrator(ctx, "Mechanics", 1, p.library,
                                    p.behaviourMetal) |
         or_die;
     auto &metal = problem.getMaterial(ctx, 1, 0) | or_die;
@@ -168,7 +173,7 @@ static void setup_material_properties(
   }
 
   for (int grainID = 2; grainID <= nMat; grainID++) {
-    problem.addBehaviourIntegrator(ctx, "Mechanics", grainID, p.libraryGrain,
+    problem.addBehaviourIntegrator(ctx, "Mechanics", grainID, p.library,
                                    p.behaviourGrain) |
         or_die;
     auto &grain = problem.getMaterial(ctx, grainID, 0) | or_die;
-- 
