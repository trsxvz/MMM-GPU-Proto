diff --git a/bindings/c/include/MGIS/Behaviour/MaterialStateManager.h b/bindings/c/include/MGIS/Behaviour/MaterialStateManager.h
index 86e83b8..b4d1569 100644
--- a/bindings/c/include/MGIS/Behaviour/MaterialStateManager.h
+++ b/bindings/c/include/MGIS/Behaviour/MaterialStateManager.h
@@ -52,6 +52,25 @@ typedef enum {
   MGIS_BV_UPDATE_POLICY = 1
 } mgis_bv_MaterialStateManagerUpdatePolicy;
 
+/*!
+ * \brief layout of the arrays of a material state manager (see
+ * `mgis::FieldLayout`)
+ */
+typedef enum {
+  /*!
+   * \brief the components of a point are contiguous: the `j`-th component of
+   * the `i`-th point is stored at `values[i * stride + j]`, where `stride` is
+   * the number of values of a point
+   */
+  MGIS_BV_POINT_BY_POINT = 0,
+  /*!
+   * \brief the values of a component are contiguous: the `j`-th component of
+   * the `i`-th point is stored at `values[j * n + i]`, where `n` is the
+   * number of points
+   */
+  MGIS_BV_COMPONENT_BY_COMPONENT = 1
+} mgis_bv_FieldLayout;
+
 /*!
  * \brief bind the gradients to the given array
  * \param[in,out] s: initializer
@@ -116,9 +135,18 @@ mgis_bv_material_state_manager_get_number_of_integration_points(
  */
 MGIS_C_EXPORT mgis_status mgis_bv_material_state_manager_get_gradients(
     mgis_real**, mgis_bv_MaterialStateManager* const);
+/*!
+ * \param[out] l: a pointer where the layout of the arrays will be written
+ * \param[in]  s: state manager
+ */
+MGIS_C_EXPORT mgis_status mgis_bv_material_state_manager_get_layout(
+    mgis_bv_FieldLayout* const, mgis_bv_MaterialStateManager* const);
 /*!
  * \param[out] gs: a pointer where the gradients' stride will be written
  * \param[in]  s: state manager
+ * \note the stride is the number of values of a point. It is the stride
+ * between two points only if the layout is `MGIS_BV_POINT_BY_POINT` (see
+ * `mgis_bv_material_state_manager_get_layout`).
  */
 MGIS_C_EXPORT mgis_status mgis_bv_material_state_manager_get_gradients_stride(
     mgis_size_type* const, mgis_bv_MaterialStateManager* const);
diff --git a/bindings/c/src/MaterialDataManager.cxx b/bindings/c/src/MaterialDataManager.cxx
index bc861a6..b1852c7 100644
--- a/bindings/c/src/MaterialDataManager.cxx
+++ b/bindings/c/src/MaterialDataManager.cxx
@@ -54,6 +54,24 @@ mgis_status mgis_bv_material_data_manager_initializer_bind_tangent_operator(
   return mgis_report_success();
 }  // end of mgis_bv_material_data_manager_initializer_bind_tangent_operator
 
+mgis_status mgis_bv_material_data_manager_initializer_set_layout(
+    mgis_bv_MaterialDataManagerInitializer* d, const mgis_bv_FieldLayout l) {
+  if (d == nullptr) {
+    return mgis_report_failure(
+        "mgis_bv_material_data_manager_initializer_set_layout: "
+        "null argument");
+  }
+  if ((l != MGIS_BV_POINT_BY_POINT) && (l != MGIS_BV_COMPONENT_BY_COMPONENT)) {
+    return mgis_report_failure(
+        "mgis_bv_material_data_manager_initializer_set_layout: "
+        "invalid layout");
+  }
+  d->layout = l == MGIS_BV_POINT_BY_POINT
+                  ? mgis::FieldLayout::POINT_BY_POINT
+                  : mgis::FieldLayout::COMPONENT_BY_COMPONENT;
+  return mgis_report_success();
+}  // end of mgis_bv_material_data_manager_initializer_set_layout
+
 mgis_status mgis_bv_material_data_manager_initializer_bind_speed_of_sound(
     mgis_bv_MaterialDataManagerInitializer* d,
     mgis_real* const p,
