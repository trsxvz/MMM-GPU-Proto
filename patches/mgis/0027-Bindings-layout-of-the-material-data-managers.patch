+       result(r)
+    use, intrinsic :: iso_c_binding, only: c_int
+    use mgis, only: mgis_status
+    implicit none
+    interface
+       function material_state_manager_get_layout_wrapper(l, s) &
+            bind(c,name = 'mgis_bv_material_state_manager_get_layout') &
+            result(r)
+         use, intrinsic :: iso_c_binding, only: c_ptr, c_int
+         use mgis, only: mgis_status
+         integer(kind=c_int), intent(out) :: l
+         type(c_ptr), intent(in),value :: s
+         type(mgis_status) :: r
+       end function material_state_manager_get_layout_wrapper
+    end interface
+    integer(kind=c_int), intent(out) :: l
+    type(MaterialStateManager), intent(in) :: s
+    type(mgis_status) :: r
+    r = material_state_manager_get_layout_wrapper(l, s %ptr)
+  end function material_state_manager_get_layout
+  !
+  ! check that the arrays of a material state manager are stored point by
+  ! point, as required by the functions returning them as two-dimensional
+  ! arrays (one column per point)
+  function material_state_manager_check_point_by_point_layout(s, f) &
+       result(r)
+    use, intrinsic :: iso_c_binding, only: c_int
+    use mgis, only: mgis_status, report_failure, MGIS_SUCCESS
+    implicit none
+    type(MaterialStateManager), intent(in) :: s
+    character(len=*), intent(in) :: f
+    type(mgis_status) :: r
+    integer(kind=c_int) l
+    r = material_state_manager_get_layout(l, s)
+    if( r%exit_status .ne. MGIS_SUCCESS) then
+       return
+    end if
+    if (l .ne. POINT_BY_POINT) then
+       r = report_failure(f // ": the arrays are stored component by component")
+    end if
+  end function material_state_manager_check_point_by_point_layout
+  !
   function material_state_manager_get_number_of_integration_points(n, s) &
        result(r)
     use, intrinsic :: iso_c_binding, only: c_size_t
@@ -3194,6 +3264,10 @@ contains
