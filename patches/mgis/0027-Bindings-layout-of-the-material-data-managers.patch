+!
+! \file   LayoutTest-f.f90
+! \brief  material data manager whose arrays are stored component by
+!         component, through the fortran bindings: the layout is set by the
+!         initializer, the behaviour is integrated, and the functions
+!         returning the arrays as two-dimensional arrays (one column per
+!         point) report an error
+! \date   08/10/2026
+!
+subroutine test()
+  use, intrinsic :: iso_c_binding, only: c_int
+  use mgis
+  use mgis_behaviour
+  use mgis_testing_utilities
+  implicit none
+  type(ThreadPool) p
+  type(Behaviour) b
+  type(MaterialDataManagerInitializer) i
+  type(MaterialDataManager) m
+  type(MaterialStateManager) s1
+  type(mgis_status) st
+  real(kind=8), dimension (:,:), pointer :: g => null()
+  integer(kind=c_int) :: l
+  integer :: n = 10
+  integer :: ri
+  logical :: r
+  call check_status(create_thread_pool(p, 2))
+  call check_status(load_behaviour(b, &
+       get_mfront_behaviour_test_library_path(), &
+       'Norton', 'Tridimensional'))
+  call check_status(create_material_data_manager_initializer(i))
+  call check_status(material_data_manager_initializer_set_layout(i, &
+       COMPONENT_BY_COMPONENT))
+  call check_status(create_material_data_manager_with_initializer(m, b, i, n))
+  call check_status(material_data_manager_get_state_1(s1, m))
+  call check_status(material_state_manager_get_layout(l, s1))
+  r = check(l == COMPONENT_BY_COMPONENT, 'invalid layout')
+  call check_status(material_state_manager_set_us_external_state_variable( &
+       s1, "Temperature", 293.15d0))
+  call check_status(update_material_data_manager(m))
+  call check_status(integrate_material_data_manager( &
+       ri, p, m, INTEGRATION_NO_TANGENT_OPERATOR, 180d0))
+  r = check(ri.eq.1, 'integration failed')
+  ! the arrays can't be returned as two-dimensional arrays
+  st = material_state_manager_get_gradients(g, s1)
+  r = check(st%exit_status .ne. MGIS_SUCCESS, &
+       'the layout of the gradients has not been checked')
+  ! free ressources
+  call check_status(free_material_data_manager(m))
+  call check_status(free_material_data_manager_initializer(i))
+  call check_status(free_behaviour(b))
+  call check_status(free_thread_pool(p))
+end subroutine test
+
+program main
+  use mgis_testing_utilities
+  call test()
+  call tests_summary()
+  if(.not. status) then
+     stop -1
+  end if
+end program main
