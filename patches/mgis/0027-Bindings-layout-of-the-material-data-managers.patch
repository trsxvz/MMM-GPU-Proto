new file mode 100644
index 0000000..8a118c1
--- /dev/null
+++ b/bindings/python/tests/LayoutTest.py
@@ -0,0 +1,56 @@
+# \file   LayoutTest.py
+# \brief  material data managers whose arrays are stored point by point and
+#         component by component: same results, numpy arrays with the
+#         strides of the layout
+# \date   08/10/2026
+
+import os
+try:
+    import unittest2 as unittest
+except ImportError:
+    import unittest
+import mgis
+import mgis.behaviour as mgis_bv
+
+
+class LayoutTest(unittest.TestCase):
+    def test_pass(self):
+        lib = os.environ['MGIS_TEST_BEHAVIOURS_LIBRARY']
+        h = mgis_bv.Hypothesis.Tridimensional
+        b = mgis_bv.load(lib, 'Norton', h)
+        nig = 10
+        managers = []
+        for layout in [mgis_bv.FieldLayout.POINT_BY_POINT,
+                       mgis_bv.FieldLayout.COMPONENT_BY_COMPONENT]:
+            i = mgis_bv.MaterialDataManagerInitializer()
+            i.layout = layout
+            m = mgis_bv.MaterialDataManager(b, nig, i)
+            self.assertTrue(m.layout == layout)
+            self.assertTrue(m.s1.layout == layout)
+            mgis_bv.setExternalStateVariable(m.s1, 'Temperature', 293.15)
+            mgis_bv.update(m)
+            managers.append(m)
+        # the arrays are seen with the same indices (point, component)
+        g = managers[1].s1.gradients
+        self.assertTrue(g.shape == (nig, 6))
+        self.assertTrue(g.strides == (8, 8 * nig))
+        isvs = managers[1].s1.internal_state_variables
+        self.assertTrue(isvs.strides == (8, 8 * nig))
+        it = mgis_bv.IntegrationType.IntegrationWithConsistentTangentOperator
+        for step in range(0, 3):
+            for m in managers:
+                for j in range(0, nig):
+                    m.s1.gradients[j][0] += 5.e-5 * (1 + 0.1 * j)
+                mgis_bv.integrate(m, it, 180, 0, nig)
+            for a in ['thermodynamic_forces', 'internal_state_variables']:
+                v0 = getattr(managers[0].s1, a)
+                v1 = getattr(managers[1].s1, a)
+                self.assertTrue((v0 == v1).all())
+            self.assertTrue((managers[0].K == managers[1].K).all())
+            for m in managers:
+                mgis_bv.update(m)
+        pass
+
+
+if __name__ == '__main__':
+    unittest.main()
