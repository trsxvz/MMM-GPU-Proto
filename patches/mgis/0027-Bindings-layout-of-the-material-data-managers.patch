+    constexpr auto s = sizeof(double);
+    return pybind11::array_t<double>(
+        {v.getNumberOfPoints(), nr, nc},
+        {v.getPointStride() * s, nc * v.getComponentStride() * s,
+         v.getComponentStride() * s},
+        v.data(), pybind11::none());
+  }  // end of wrapInNumPyArray
+
 }  // end of namespace mgis::python
