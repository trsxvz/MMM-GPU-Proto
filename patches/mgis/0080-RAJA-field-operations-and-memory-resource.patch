+#ifndef LIB_MGIS_MEMORYRESOURCES_RAJAMANAGEDMEMORYRESOURCE_HXX
+#define LIB_MGIS_MEMORYRESOURCES_RAJAMANAGEDMEMORYRESOURCE_HXX
+
+#include <new>
+#include <cstddef>
+#include <type_traits>
+#include <memory_resource>
+#include "RAJA/RAJA.hpp"
+#include "MGIS/MemoryResources/OverAlignedAllocation.hxx"
+
+namespace mgis::memory_resources {
+
+  /*!
+   * \brief default resource of camp: the one of the GPU if the code is
+   * compiled for CUDA or HIP, the one of the host otherwise. This is the
+   * resource of the default execution policy of
+   * `mgis::field_operations::RAJAFieldOperations`.
+   */
+#if defined(RAJA_CUDA_ACTIVE)
+  using RAJADefaultResource = camp::resources::Cuda;
+#elif defined(RAJA_HIP_ACTIVE)
+  using RAJADefaultResource = camp::resources::Hip;
+#else
+  using RAJADefaultResource = camp::resources::Host;
+#endif
+
+  /*!
+   * \return the default instance of a resource of camp: the default stream
+   * of the current device with CUDA and HIP (the default resource of camp is
+   * a stream created by camp on the device 0), the default resource of camp
+   * otherwise. This is the resource used by the `raja` backend of the
+   * `generic-parallel` interface of `MFront` when no queue is given.
+   * \tparam Resource: resource of camp
+   */
+  template <typename Resource>
+  Resource getRAJADefaultResource() {
+#if defined(RAJA_CUDA_ACTIVE)
+    if constexpr (std::is_same_v<Resource, camp::resources::Cuda>) {
+      return camp::resources::Cuda::CudaFromStream(0);
+    }
+#endif
+#if defined(RAJA_HIP_ACTIVE)
+    if constexpr (std::is_same_v<Resource, camp::resources::Hip>) {
+      return camp::resources::Hip::HipFromStream(0);
+    }
+#endif
+    return Resource::get_default();
+  }  // end of getRAJADefaultResource
+
+  /*!
+   * \brief memory resource allocating the managed memory of a resource of
+   * camp, accessible by the host and by the execution policies of RAJA
+   * associated with this resource (shared location of the arrays of a
+   * material data manager). On the host, the managed memory is the memory
+   * of the host. An alignment stricter than the one of the fundamental
+   * types, requested for instance by the pools of the standard library, is
+   * obtained by over-allocation (see `internals::allocateOverAligned`). A
+   * failed allocation throws `std::bad_alloc`; a failed deallocation is
+   * ignored, as by the other memory resources.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code, with its own installation of RAJA.
+   *
+   * \tparam Resource: resource of camp (`camp::resources::Cuda`,
+   * `camp::resources::Hip` or `camp::resources::Host`)
+   */
+  template <typename Resource = RAJADefaultResource>
+  struct RAJAManagedMemoryResource final : std::pmr::memory_resource {
+    /*!
+     * \param[in] r: resource (by default, the default stream of the current
+     * device with CUDA and HIP, see `getRAJADefaultResource`)
+     */
+    explicit RAJAManagedMemoryResource(
+        const Resource& r = getRAJADefaultResource<Resource>())
+        : resource(r) {}
+
+   private:
+    void* do_allocate(const std::size_t s, const std::size_t a) override {
+      // the allocations of camp are aligned for the fundamental types
+      return internals::allocateOverAligned(
+          s, a, alignof(std::max_align_t), [this](const std::size_t n) {
+            auto* p = static_cast<char*>(nullptr);
+            try {
+              p = this->resource.template allocate<char>(
+                  n, camp::resources::MemoryAccess::Managed);
+            } catch (...) {
+              // camp reports the errors of the runtime by exceptions
+              throw std::bad_alloc{};
+            }
+            if (p == nullptr) {
+              throw std::bad_alloc{};
+            }
+            return static_cast<void*>(p);
+          });
+    }
+    void do_deallocate(void* const p,
+                       const std::size_t,
+                       const std::size_t a) override {
+      internals::deallocateOverAligned(
+          p, a, alignof(std::max_align_t), [this](void* const b) {
+            // called by destructors: the errors of the runtime are ignored
+            try {
+              this->resource.deallocate(b,
+                                        camp::resources::MemoryAccess::Managed);
+            } catch (...) {
+            }
+          });
+    }
+    bool do_is_equal(
+        const std::pmr::memory_resource& r) const noexcept override {
+      return dynamic_cast<const RAJAManagedMemoryResource*>(&r) != nullptr;
+    }
+    //! \brief resource of camp
+    Resource resource;
+  };
+
+}  // end of namespace mgis::memory_resources
+
+#endif /* LIB_MGIS_MEMORYRESOURCES_RAJAMANAGEDMEMORYRESOURCE_HXX */
