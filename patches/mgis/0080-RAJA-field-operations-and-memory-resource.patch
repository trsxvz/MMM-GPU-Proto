diff --git a/include/MGIS/FieldOperations/RAJAFieldOperations.hxx b/include/MGIS/FieldOperations/RAJAFieldOperations.hxx
new file mode 100644
index 0000000..5364e80
--- /dev/null
+++ b/include/MGIS/FieldOperations/RAJAFieldOperations.hxx
@@ -0,0 +1,165 @@
+/*!
+ * \file   include/MGIS/FieldOperations/RAJAFieldOperations.hxx
+ * \brief  This file declares the `RAJAFieldOperations` class, which copies
+ * and fills views with the loops of RAJA, on the host or on a device.
+ * \date   20/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_RAJAFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_RAJAFIELDOPERATIONS_HXX
+
+#include "RAJA/RAJA.hpp"
+#include "MGIS/FieldOperations.hxx"
+#include "MGIS/MemoryResources/RAJAManagedMemoryResource.hxx"
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief default execution policy of RAJA: the asynchronous loop of the
+   * GPU if the code is compiled for CUDA or HIP (128 threads per block), the
+   * parallel loop of OpenMP if RAJA is built with OpenMP, the sequential loop
+   * otherwise. This is the default execution policy of the `raja` backend of
+   * the `generic-parallel` interface of `MFront`.
+   */
+#if defined(RAJA_CUDA_ACTIVE)
+  using RAJADefaultExecutionPolicy = RAJA::cuda_exec_async<128>;
+#elif defined(RAJA_HIP_ACTIVE)
+  using RAJADefaultExecutionPolicy = RAJA::hip_exec_async<128>;
+#elif defined(RAJA_ENABLE_OPENMP)
+  using RAJADefaultExecutionPolicy = RAJA::omp_parallel_for_exec;
+#else
+  using RAJADefaultExecutionPolicy = RAJA::seq_exec;
+#endif
+
+}  // end of namespace mgis::field_operations
+
+namespace mgis::field_operations::internals {
+
+  /*!
+   * \brief copy the values of a view in another one (free function: an
+   * extended lambda can't be defined in a private member function with
+   * CUDA). Each iteration processes one point: consecutive iterations
+   * process consecutive points of a component.
+   * \param[in] r: resource of camp
+   * \param[out] dv: first value of the destination
+   * \param[in] dps: stride between two points of the destination
+   * \param[in] dcs: stride between two components of the destination
+   * \param[in] sv: first value of the source
+   * \param[in] sps: stride between two points of the source
+   * \param[in] scs: stride between two components of the source
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   */
+  template <typename ExecutionPolicy, typename Resource>
+  void rajaCopyFieldView(Resource& r,
+                         real* const dv,
+                         const size_type dps,
+                         const size_type dcs,
+                         const real* const sv,
+                         const size_type sps,
+                         const size_type scs,
+                         const size_type n,
+                         const size_type nc) {
+    RAJA::forall<ExecutionPolicy>(r, RAJA::TypedRangeSegment<size_type>(0, n),
+                                  [=] RAJA_HOST_DEVICE(const size_type i) {
+                                    for (size_type j = 0; j < nc; ++j) {
+                                      dv[i * dps + j * dcs] =
+                                          sv[i * sps + j * scs];
+                                    }
+                                  });
+  }  // end of rajaCopyFieldView
+
+  /*!
+   * \brief fill a view (see `rajaCopyFieldView`)
+   * \param[in] r: resource of camp
+   * \param[out] dv: first value of the view
+   * \param[in] ps: stride between two points
+   * \param[in] cs: stride between two components
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] v: value
+   */
+  template <typename ExecutionPolicy, typename Resource>
+  void rajaFillFieldView(Resource& r,
+                         real* const dv,
+                         const size_type ps,
+                         const size_type cs,
+                         const size_type n,
+                         const size_type nc,
+                         const real v) {
+    RAJA::forall<ExecutionPolicy>(r, RAJA::TypedRangeSegment<size_type>(0, n),
+                                  [=] RAJA_HOST_DEVICE(const size_type i) {
+                                    for (size_type j = 0; j < nc; ++j) {
+                                      dv[i * ps + j * cs] = v;
+                                    }
+                                  });
+  }  // end of rajaFillFieldView
+
+}  // end of namespace mgis::field_operations::internals
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in memory accessible by the
+   * given execution policy of RAJA, with a resource of camp matching this
+   * execution policy.
+   *
+   * The operations are submitted to the resource: the calling code must
+   * wait for the resource before reading the values on the host. A copy
+   * between two views with the same dense layout is a copy of a contiguous
+   * memory region by the resource; the other copies, and the fills, use a
+   * loop of RAJA. This is the counterpart of the `raja` backend of the
+   * `generic-parallel` interface of `MFront`, compiled with the same
+   * compiler and the same options (`nvcc` with extended lambdas for the
+   * execution policies of CUDA).
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with its RAJA installation.
+   *
+   * \tparam ExecutionPolicy: execution policy of RAJA
+   */
+  template <typename ExecutionPolicy = RAJADefaultExecutionPolicy>
+  struct RAJAFieldOperations final : FieldOperations {
+    //! \brief resource of camp associated with the execution policy
+    using Resource = RAJA::resources::resource_from_pol_t<ExecutionPolicy>;
+    /*!
+     * \param[in] r: resource (by default, the default stream of the current
+     * device with CUDA and HIP, see
+     * `mgis::memory_resources::getRAJADefaultResource`)
+     */
+    explicit RAJAFieldOperations(
+        const Resource& r =
+            memory_resources::getRAJADefaultResource<Resource>())
+        : resource(r) {}
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nc = d.getNumberOfComponents();
+      if (haveSameDenseLayout(d, s)) {
+        this->resource.memcpy(d.data(), s.data(), n * nc * sizeof(real));
+        return;
+      }
+      internals::rajaCopyFieldView<ExecutionPolicy>(
+          this->resource, d.data(), d.getPointStride(), d.getComponentStride(),
+          s.data(), s.getPointStride(), s.getComponentStride(), n, nc);
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      internals::rajaFillFieldView<ExecutionPolicy>(
+          this->resource, d.data(), d.getPointStride(), d.getComponentStride(),
+          d.getNumberOfPoints(), d.getNumberOfComponents(), v);
+    }  // end of do_fill
+    //! \brief resource on which the operations are submitted
+    Resource resource;
+  };  // end of RAJAFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_RAJAFIELDOPERATIONS_HXX */
