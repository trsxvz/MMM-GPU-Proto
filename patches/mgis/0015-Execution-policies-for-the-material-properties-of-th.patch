     for (size_type i = 0; i != n; ++i) {
       for (size_type j = 0; j != inputs.size(); ++j) {
@@ -141,8 +176,8 @@ namespace mgis::material_property {
       }
       auto si = OutputStatus{};
       values[i] = mp.fct(&si, arguments.data(), arguments.size(), p);
+      si = checkOutputStatus(mp, si);
       if (si.status < 0) {
-        si.msg[sizeof(si.msg) - 1] = '\0';
         return si;
       }
       if ((si.status != 0) && (s.status == 0)) {
@@ -150,8 +185,26 @@ namespace mgis::material_property {
         s = si;
       }
     }
-    s.msg[sizeof(s.msg) - 1] = '\0';
     return s;
   }  // end of evaluate
 
+  OutputStatus evaluate(const BatchExecutionPolicy &e,
+                        std::span<real> values,
+                        const MaterialProperty &mp,
+                        std::span<const std::span<const real>> inputs,
+                        const MemoryLocation l,
+                        const OutOfBoundsPolicy p) {
+    if (!isGenericParallelMaterialProperty(mp)) {
+      mgis::raise("evaluate: material property '" + mp.material_property +
+                  "' has not been generated by the generic-parallel "
+                  "interface");
+    }
+    const auto n = static_cast<size_type>(values.size());
+    checkEvaluationArguments(n, mp, inputs, l);
+    if (n == 0) {
+      return OutputStatus{};
+    }
+    return evaluateBatch(e, values, mp, inputs, p);
+  }  // end of evaluate
+
 }  // end of namespace mgis::material_property
