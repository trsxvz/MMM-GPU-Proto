diff --git a/src/MaterialProperty.cxx b/src/MaterialProperty.cxx
index 4dd263c..41c7b2f 100644
--- a/src/MaterialProperty.cxx
+++ b/src/MaterialProperty.cxx
@@ -109,6 +109,51 @@ namespace mgis::material_property {
     }
   }  // end of checkEvaluationArguments
 
+  /*!
+   * \return the output status of an evaluation, after the checks of the
+   * statuses reporting invalid arguments and errors of the backend, which
+   * are raised as exceptions
+   * \param[in] mp: material property
+   * \param[in] s: output status
+   */
+  static OutputStatus checkOutputStatus(const MaterialProperty &mp,
+                                        OutputStatus s) {
+    s.msg[sizeof(s.msg) - 1] = '\0';
+    // -5: invalid arguments, -6: error of the backend, -7: invalid strides
+    if ((s.status < -4) || (s.status > 1)) {
+      mgis::raise("evaluate: evaluation of material property '" +
+                  mp.material_property + "' failed with status " +
+                  std::to_string(s.status) + " (" + std::string{s.msg} + ")");
+    }
+    return s;
+  }  // end of checkOutputStatus
+
+  /*!
+   * \brief evaluate a material property generated by the `generic-parallel`
+   * interface on a set of points, by one call
+   */
+  static OutputStatus evaluateBatch(
+      const BatchExecutionPolicy &e,
+      std::span<real> values,
+      const MaterialProperty &mp,
+      const std::span<const std::span<const real>> inputs,
+      const OutOfBoundsPolicy p) {
+    const auto n = static_cast<size_type>(values.size());
+    // the uniform inputs have a null stride
+    auto arguments = std::vector<const real *>(inputs.size());
+    auto strides = std::vector<size_type>(inputs.size());
+    for (size_type i = 0; i != inputs.size(); ++i) {
+      arguments[i] = inputs[i].data();
+      strides[i] = inputs[i].size() == n ? 1 : 0;
+    }
+    const auto options = ExecutionOptions{
+        .queue = e.queue, .preserve_stack_size = e.preserve_stack_size ? 1 : 0};
+    auto s = OutputStatus{};
+    mp.batch_fct(&s, values.data(), 1, arguments.data(), strides.data(),
+                 inputs.size(), n, p, &options);
+    return checkOutputStatus(mp, s);
+  }  // end of evaluateBatch
+
   OutputStatus evaluate(std::span<real> values,
