+/*!
+ * \param[in] h: modelling hypothesis
+ * \return the index of the axial component of the tensors in plane stress
+ * (third one) and in axisymmetrical generalised plane stress (second one,
+ * the third one being the hoop component), or an empty optional for the
+ * other hypotheses
+ */
+static std::optional<mgis::size_type> getAxialComponentIndex(
+    const mgis::behaviour::Hypothesis h) {
+  using mgis::behaviour::Hypothesis;
+  if (h == Hypothesis::PLANESTRESS) {
+    return 2;
+  }
+  if (h == Hypothesis::AXISYMMETRICALGENERALISEDPLANESTRESS) {
+    return 1;
+  }
+  return {};
+}  // end of getAxialComponentIndex
