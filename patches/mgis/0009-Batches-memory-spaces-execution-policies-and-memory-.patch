+#ifndef LIB_MGIS_MEMORYRESOURCES_HIPMANAGEDMEMORYRESOURCE_HXX
+#define LIB_MGIS_MEMORYRESOURCES_HIPMANAGEDMEMORYRESOURCE_HXX
+
+#include <new>
+#include <cstddef>
+#include <memory_resource>
+#include <hip/hip_runtime_api.h>
+
+namespace mgis::memory_resources {
+
+  /*!
+   * \brief memory resource allocating managed memory with the runtime of
+   * HIP, accessible by the host and by the devices (shared location of
+   * the arrays of a material data manager)
+   */
+  struct HIPManagedMemoryResource final : std::pmr::memory_resource {
+   private:
+    void* do_allocate(const std::size_t s, const std::size_t a) override {
+      // the managed memory is aligned on 256 bytes at least
+      void* p = nullptr;
+      if ((a > 256) || (hipMallocManaged(&p, s) != hipSuccess)) {
+        throw std::bad_alloc();
+      }
+      return p;
+    }
+    void do_deallocate(void* const p,
+                       const std::size_t,
+                       const std::size_t) override {
+      static_cast<void>(hipFree(p));
+    }
+    bool do_is_equal(
+        const std::pmr::memory_resource& r) const noexcept override {
+      return dynamic_cast<const HIPManagedMemoryResource*>(&r) != nullptr;
+    }
+  };
+
+}  // end of namespace mgis::memory_resources
+
+#endif /* LIB_MGIS_MEMORYRESOURCES_HIPMANAGEDMEMORYRESOURCE_HXX */
