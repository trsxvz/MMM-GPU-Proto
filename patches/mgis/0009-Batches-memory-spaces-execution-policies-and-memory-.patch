diff --git a/include/MGIS/MemoryResources/CUDAManagedMemoryResource.hxx b/include/MGIS/MemoryResources/CUDAManagedMemoryResource.hxx
new file mode 100644
index 0000000..50c3b01
--- /dev/null
+++ b/include/MGIS/MemoryResources/CUDAManagedMemoryResource.hxx
@@ -0,0 +1,53 @@
+/*!
+ * \file   include/MGIS/MemoryResources/CUDAManagedMemoryResource.hxx
+ * \brief  This file declares a memory resource allocating managed memory
+ * with the runtime of CUDA. This header is not compiled by MGIS: it is
+ * compiled by the calling code, which links with the runtime of CUDA.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_MEMORYRESOURCES_CUDAMANAGEDMEMORYRESOURCE_HXX
+#define LIB_MGIS_MEMORYRESOURCES_CUDAMANAGEDMEMORYRESOURCE_HXX
+
+#include <new>
+#include <cstddef>
+#include <memory_resource>
+#include <cuda_runtime_api.h>
+
+namespace mgis::memory_resources {
+
+  /*!
+   * \brief memory resource allocating managed memory with the runtime of
+   * CUDA, accessible by the host and by the devices (shared location of
+   * the arrays of a material data manager)
+   */
+  struct CUDAManagedMemoryResource final : std::pmr::memory_resource {
+   private:
+    void* do_allocate(const std::size_t s, const std::size_t a) override {
+      // the managed memory is aligned on 256 bytes at least
+      void* p = nullptr;
+      if ((a > 256) || (cudaMallocManaged(&p, s) != cudaSuccess)) {
+        throw std::bad_alloc();
+      }
+      return p;
+    }
+    void do_deallocate(void* const p,
+                       const std::size_t,
+                       const std::size_t) override {
+      static_cast<void>(cudaFree(p));
+    }
+    bool do_is_equal(
+        const std::pmr::memory_resource& r) const noexcept override {
+      return dynamic_cast<const CUDAManagedMemoryResource*>(&r) != nullptr;
+    }
+  };
+
+}  // end of namespace mgis::memory_resources
+
+#endif /* LIB_MGIS_MEMORYRESOURCES_CUDAMANAGEDMEMORYRESOURCE_HXX */
