+/*!
+ * \file   include/MGIS/MemoryResources/KokkosSharedSpaceMemoryResource.hxx
+ * \brief  This file declares a memory resource allocating memory in the
+ * shared space of Kokkos. This header is not compiled by MGIS: it is
+ * compiled by the calling code, which uses Kokkos.
+ * \date   08/10/2026
