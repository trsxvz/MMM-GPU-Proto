+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_MEMORYRESOURCES_KOKKOSSHAREDSPACEMEMORYRESOURCE_HXX
+#define LIB_MGIS_MEMORYRESOURCES_KOKKOSSHAREDSPACEMEMORYRESOURCE_HXX
+
+#include <new>
+#include <cstddef>
+#include <memory_resource>
+#include <Kokkos_Core.hpp>
+
+namespace mgis::memory_resources {
+
+  /*!
+   * \brief memory resource allocating memory in the shared space of Kokkos,
+   * accessible by the host and by the default execution space (shared
+   * location of the arrays of a material data manager). Kokkos must be
+   * initialized, and the allocated memory freed before Kokkos is finalized.
+   */
+  struct KokkosSharedSpaceMemoryResource final : std::pmr::memory_resource {
+   private:
+    void* do_allocate(const std::size_t s, const std::size_t a) override {
+      // the allocations of Kokkos are aligned for the fundamental types
+      if (a > alignof(std::max_align_t)) {
+        throw std::bad_alloc();
+      }
+      // kokkos_malloc throws on failure
+      return Kokkos::kokkos_malloc<Kokkos::SharedSpace>(
+          "mgis::memory_resources::KokkosSharedSpaceMemoryResource", s);
+    }
+    void do_deallocate(void* const p,
+                       const std::size_t,
+                       const std::size_t) override {
+      Kokkos::kokkos_free<Kokkos::SharedSpace>(p);
+    }
+    bool do_is_equal(
+        const std::pmr::memory_resource& r) const noexcept override {
+      return dynamic_cast<const KokkosSharedSpaceMemoryResource*>(&r) !=
+             nullptr;
+    }
+  };
+
+}  // end of namespace mgis::memory_resources
+
+#endif /* LIB_MGIS_MEMORYRESOURCES_KOKKOSSHAREDSPACEMEMORYRESOURCE_HXX */
diff --git a/include/MGIS/MemoryResources/SYCLSharedMemoryResource.hxx b/include/MGIS/MemoryResources/SYCLSharedMemoryResource.hxx
new file mode 100644
index 0000000..bfa7115
--- /dev/null
+++ b/include/MGIS/MemoryResources/SYCLSharedMemoryResource.hxx
@@ -0,0 +1,66 @@
+/*!
+ * \file   include/MGIS/MemoryResources/SYCLSharedMemoryResource.hxx
+ * \brief  This file declares a memory resource allocating shared memory
+ * with SYCL. This header is not compiled by MGIS: it is compiled by the
+ * calling code, with a SYCL compiler.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_MEMORYRESOURCES_SYCLSHAREDMEMORYRESOURCE_HXX
+#define LIB_MGIS_MEMORYRESOURCES_SYCLSHAREDMEMORYRESOURCE_HXX
+
+#include <new>
+#include <cstddef>
+#include <memory_resource>
+#include <sycl/sycl.hpp>
+
+namespace mgis::memory_resources {
+
+  /*!
+   * \brief memory resource allocating shared memory with SYCL (unified
+   * shared memory), accessible by the host and by the device of a queue
+   * (shared location of the arrays of a material data manager)
+   */
+  struct SYCLSharedMemoryResource final : std::pmr::memory_resource {
+    /*!
+     * \brief constructor
+     * \param[in] q: queue giving the device and the context of the
+     * allocations
+     */
+    explicit SYCLSharedMemoryResource(const ::sycl::queue& q)
+        : device(q.get_device()), context(q.get_context()) {}
+
+   private:
+    void* do_allocate(const std::size_t s, const std::size_t a) override {
+      auto* const p =
+          ::sycl::aligned_alloc_shared(a, s, this->device, this->context);
+      if (p == nullptr) {
+        throw std::bad_alloc();
+      }
+      return p;
+    }
+    void do_deallocate(void* const p,
+                       const std::size_t,
+                       const std::size_t) override {
+      ::sycl::free(p, this->context);
+    }
+    bool do_is_equal(
+        const std::pmr::memory_resource& r) const noexcept override {
+      const auto* const o = dynamic_cast<const SYCLSharedMemoryResource*>(&r);
+      return (o != nullptr) && (o->context == this->context);
+    }
+    //! \brief device
+    ::sycl::device device;
+    //! \brief context
+    ::sycl::context context;
+  };
+
+}  // end of namespace mgis::memory_resources
+
+#endif /* LIB_MGIS_MEMORYRESOURCES_SYCLSHAREDMEMORYRESOURCE_HXX */
