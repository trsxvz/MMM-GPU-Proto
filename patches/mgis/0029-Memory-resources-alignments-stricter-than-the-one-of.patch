new file mode 100644
index 0000000..566c4d3
--- /dev/null
+++ b/include/MGIS/MemoryResources/OverAlignedAllocation.hxx
@@ -0,0 +1,89 @@
+/*!
+ * \file   include/MGIS/MemoryResources/OverAlignedAllocation.hxx
+ * \brief  This file defines functions allocating memory with an alignment
+ * stricter than the one guaranteed by an allocation function, for the
+ * memory resources of the `MGIS/MemoryResources` directory.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_MEMORYRESOURCES_OVERALIGNEDALLOCATION_HXX
+#define LIB_MGIS_MEMORYRESOURCES_OVERALIGNEDALLOCATION_HXX
+
+#include <new>
+#include <limits>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace mgis::memory_resources::internals {
+
+  /*!
+   * \brief allocate memory with the given alignment.
+   *
+   * If the alignment is not stricter than the one guaranteed by the
+   * allocation function, the memory is allocated directly. Otherwise, the
+   * memory is over-allocated and the address of the allocated block is
+   * stored just before the returned address: the memory must be accessible
+   * by the host (managed or shared memory). The pools of memory of the
+   * standard library request blocks aligned on their size: those
+   * allocations are thus required to use such a memory resource as the
+   * upstream resource of a pool.
+   *
+   * \return the allocated memory
+   * \param[in] s: size in bytes
+   * \param[in] a: alignment, a power of two
+   * \param[in] g: alignment guaranteed by the allocation function
+   * \param[in] allocate: function allocating the given number of bytes,
+   * which throws `std::bad_alloc` on failure
+   */
+  template <typename AllocationFunction>
+  void* allocateOverAligned(const std::size_t s,
+                            const std::size_t a,
+                            const std::size_t g,
+                            const AllocationFunction& allocate) {
+    if (a <= g) {
+      return allocate(s);
+    }
+    // room for the address of the allocated block and for the alignment
+    const auto extra = a + sizeof(void*);
+    if (s > std::numeric_limits<std::size_t>::max() - extra) {
+      throw std::bad_alloc();
+    }
+    void* const b = allocate(s + extra);
+    const auto ab = reinterpret_cast<std::uintptr_t>(b);
+    const auto ap = (ab + sizeof(void*) + a - 1) & ~(std::uintptr_t{a} - 1);
+    auto* const p = reinterpret_cast<std::byte*>(ap);
+    std::memcpy(p - sizeof(void*), &b, sizeof(void*));
+    return p;
+  }  // end of allocateOverAligned
+
+  /*!
+   * \brief free memory allocated by `allocateOverAligned`
+   * \param[in] p: allocated memory
+   * \param[in] a: alignment given to `allocateOverAligned`
+   * \param[in] g: alignment guaranteed by the allocation function
+   * \param[in] deallocate: function freeing the allocated block
+   */
+  template <typename DeallocationFunction>
+  void deallocateOverAligned(void* const p,
+                             const std::size_t a,
+                             const std::size_t g,
+                             const DeallocationFunction& deallocate) {
+    if (a <= g) {
+      deallocate(p);
+      return;
+    }
+    void* b = nullptr;
+    std::memcpy(&b, static_cast<std::byte*>(p) - sizeof(void*), sizeof(void*));
+    deallocate(b);
+  }  // end of deallocateOverAligned
+
+}  // end of namespace mgis::memory_resources::internals
+
+#endif /* LIB_MGIS_MEMORYRESOURCES_OVERALIGNEDALLOCATION_HXX */
