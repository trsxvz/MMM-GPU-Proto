-/*!
- * \brief asynchronous computations whose statuses are allocated by a pool
- * of managed memory: no allocation of managed memory by call
- */
-static void testAsynchronousComputationsWithPool(
-    const std::string& gp_library) {
-  using namespace mgis::behaviour;
-  const auto b = load(gp_library, "Norton", Hypothesis::TRIDIMENSIONAL);
-  constexpr auto n = size_type{16};
-  auto managed = mgis::memory_resources::CUDAManagedMemoryResource{};
-  auto pool = std::pmr::synchronized_pool_resource(&managed);
-  auto i = MaterialDataManagerInitializer{};
-  i.location = mgis::MemoryLocation::SHARED;
-  i.resource = &managed;
-  auto m = MaterialDataManager(b, n, i);
-  auto T = std::pmr::vector<real>(1, 293.15, &managed);
-  setExternalStateVariable(m.s0, "Temperature", T,
-                           MaterialStateManager::EXTERNAL_STORAGE);
-  setExternalStateVariable(m.s1, "Temperature", T,
-                           MaterialStateManager::EXTERNAL_STORAGE);
-  for (size_type k = 0; k != n; ++k) {
-    m.s1.gradients[k * m.s1.gradients_stride] = 1e-3;
-  }
-  auto stream = cudaStream_t{};
-  checkCUDA(cudaStreamCreate(&stream), "cudaStreamCreate");
-  auto p = AsynchronousBatchExecutionPolicy{};
-  p.queue = stream;
-  p.resource = &pool;
-  p.location = mgis::MemoryLocation::SHARED;
-  auto opts = BehaviourIntegrationOptions{};
-  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
-  // a mass density held by the manager on the host is not accessible by the
-  // device: the reason is reported
-  {
-    setMassDensity(m.s0, 7800.);
-    setMassDensity(m.s1, 7800.);
-    auto opts = BehaviourIntegrationOptions{};
-    opts.compute_speed_of_sound = true;
-    check(
-        throws(
-            [&m, &opts] {
-              static_cast<void>(integrate(BatchExecutionPolicy{}, m, opts, 1));
-            },
-            "the mass density is held by the material data manager"),
-        "mass density held on the host: invalid error");
-  }
-  for (int k = 0; k != 3; ++k) {
-    auto pending = std::vector<PendingBatchComputation>{};
-    pending.reserve(4);
-    for (size_type s = 0; s != 4; ++s) {
-      pending.push_back(integrate(p, m, opts, 1, 4 * s, 4 * s + 4));
-    }
-    checkCUDA(cudaStreamSynchronize(stream), "cudaStreamSynchronize");
-    for (const auto& pr : pending) {
-      check(pr.getResult().exit_status == 1,
-            "asynchronous computations: invalid status");
-    }
-  }
-  checkCUDA(cudaStreamDestroy(stream), "cudaStreamDestroy");
-}  // end of testAsynchronousComputationsWithPool
