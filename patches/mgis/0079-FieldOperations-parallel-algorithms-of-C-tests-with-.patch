+++ b/include/MGIS/FieldOperations/ParallelSTLFieldOperations.hxx
@@ -0,0 +1,253 @@
+/*!
+ * \file   include/MGIS/FieldOperations/ParallelSTLFieldOperations.hxx
+ * \brief  This file declares the `ParallelSTLFieldOperations` class, which
+ * copies and fills views with the parallel algorithms of the C++ standard
+ * library, on the host or on a device (`nvc++ -stdpar=gpu`).
+ * \date   19/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_PARALLELSTLFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_PARALLELSTLFIELDOPERATIONS_HXX
+
+#include <compare>
+#include <cstddef>
+#include <iterator>
+#include <algorithm>
+#include <execution>
+#include <type_traits>
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis::field_operations::internals {
+
+  /*!
+   * \brief a random access iterator over a range of indices.
+   *
+   * `std::views::iota` can't be used with the parallel algorithms of some
+   * implementations of the standard library: the category of its iterators,
+   * in the sense of the C++17 iterators, is not
+   * `std::random_access_iterator_tag` and the algorithms then run
+   * sequentially (this is the case of libstdc++).
+   *
+   * This iterator is a C++20 random access iterator. It claims the C++17
+   * random access category although dereferencing it returns a value, not a
+   * reference, as `thrust::counting_iterator` does.
+   */
+  struct ParallelSTLCountingIterator {
+    //! \brief category of the iterator in the sense of the C++17 iterators
+    using iterator_category = std::random_access_iterator_tag;
+    //! \brief type of the indices
+    using value_type = size_type;
+    //! \brief type of the distance between two iterators
+    using difference_type = std::ptrdiff_t;
+    //! \brief type returned by the dereference operator
+    using reference = size_type;
+    //! \return the current index
+    constexpr size_type operator*() const noexcept { return this->index; }
+    //! \return the index at the given distance of the current one
+    constexpr size_type operator[](const difference_type d) const noexcept {
+      return this->index + static_cast<size_type>(d);
+    }
+    constexpr ParallelSTLCountingIterator& operator++() noexcept {
+      ++(this->index);
+      return *this;
+    }
+    constexpr ParallelSTLCountingIterator operator++(int) noexcept {
+      auto r = *this;
+      ++(this->index);
+      return r;
+    }
+    constexpr ParallelSTLCountingIterator& operator--() noexcept {
+      --(this->index);
+      return *this;
+    }
+    constexpr ParallelSTLCountingIterator operator--(int) noexcept {
+      auto r = *this;
+      --(this->index);
+      return r;
+    }
+    constexpr ParallelSTLCountingIterator& operator+=(
+        const difference_type d) noexcept {
+      this->index =
+          static_cast<size_type>(static_cast<difference_type>(this->index) + d);
+      return *this;
+    }
+    constexpr ParallelSTLCountingIterator& operator-=(
+        const difference_type d) noexcept {
+      return *this += -d;
+    }
+    friend constexpr ParallelSTLCountingIterator operator+(
+        ParallelSTLCountingIterator i, const difference_type d) noexcept {
+      return i += d;
+    }
+    friend constexpr ParallelSTLCountingIterator operator+(
+        const difference_type d, ParallelSTLCountingIterator i) noexcept {
+      return i += d;
+    }
+    friend constexpr ParallelSTLCountingIterator operator-(
+        ParallelSTLCountingIterator i, const difference_type d) noexcept {
+      return i -= d;
+    }
+    friend constexpr difference_type operator-(
+        const ParallelSTLCountingIterator a,
+        const ParallelSTLCountingIterator b) noexcept {
+      return static_cast<difference_type>(a.index) -
+             static_cast<difference_type>(b.index);
+    }
+    friend constexpr bool operator==(
+        const ParallelSTLCountingIterator&,
+        const ParallelSTLCountingIterator&) noexcept = default;
+    friend constexpr auto operator<=>(
+        const ParallelSTLCountingIterator&,
+        const ParallelSTLCountingIterator&) noexcept = default;
+    //! \brief current index
+    size_type index = 0;
+  };  // end of ParallelSTLCountingIterator
+
+  static_assert(std::random_access_iterator<ParallelSTLCountingIterator>);
+
+  //! \brief standard execution policies
+  template <typename ExecutionPolicy>
+  inline constexpr bool isStandardExecutionPolicy =
+      std::is_same_v<ExecutionPolicy, std::execution::sequenced_policy> ||
+      std::is_same_v<ExecutionPolicy, std::execution::parallel_policy> ||
+#if __cpp_lib_execution >= 201902L
+      std::is_same_v<ExecutionPolicy, std::execution::unsequenced_policy> ||
+#endif /* __cpp_lib_execution >= 201902L */
+      std::is_same_v<ExecutionPolicy,
+                     std::execution::parallel_unsequenced_policy>;
+
+  /*!
+   * \return the global object of a standard execution policy
+   * (`std::execution::seq`, `par`, `par_unseq` or `unseq`)
+   * \tparam ExecutionPolicy: standard execution policy
+   */
+  template <typename ExecutionPolicy>
+    requires(isStandardExecutionPolicy<ExecutionPolicy>)
+  constexpr const ExecutionPolicy& getStandardExecutionPolicy() noexcept {
+    if constexpr (std::is_same_v<ExecutionPolicy,
+                                 std::execution::sequenced_policy>) {
+      return std::execution::seq;
+    } else if constexpr (std::is_same_v<ExecutionPolicy,
+                                        std::execution::parallel_policy>) {
+      return std::execution::par;
+#if __cpp_lib_execution >= 201902L
+    } else if constexpr (std::is_same_v<ExecutionPolicy,
+                                        std::execution::unsequenced_policy>) {
+      return std::execution::unseq;
+#endif /* __cpp_lib_execution >= 201902L */
+    } else {
+      return std::execution::par_unseq;
+    }
+  }  // end of getStandardExecutionPolicy
+
+}  // end of namespace mgis::field_operations::internals
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views with the parallel algorithms of the
+   * C++ standard library.
+   *
+   * Where the algorithms run depends on the compiler of the calling code:
+   * on the host with `gcc`, `clang` or `icpx` (the views must then be
+   * located in the memory of the host or in shared memory), on an NVIDIA
+   * GPU with `nvc++ -stdpar=gpu` (the views must then be readable by the
+   * GPU: memory of the device, managed memory, or any memory with the
+   * unified memory of `nvc++`). On the host, the parallel algorithms of
+   * libstdc++ run in parallel only if TBB is found when compiling and
+   * linked, and sequentially otherwise. Other compilers offloading the
+   * parallel algorithms (`acpp --acpp-stdpar`, `clang++ --hipstdpar`) are not
+   * tested. This is the counterpart of the `stlpar` backend of the
+   * `generic-parallel` interface of `MFront`, compiled with the same compiler
+   * and the same options. The operations are synchronous.
+   *
+   * A copy between two views with the same dense layout is a copy of a
+   * contiguous memory region (`std::copy`); the other copies, and the
+   * fills, use one call of the function object per point.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code.
+   *
+   * \tparam ExecutionPolicy: type of the execution policy
+   * (`std::execution::parallel_unsequenced_policy` by default). `nvc++
+   * -stdpar=gpu` only offloads the algorithms called with the
+   * `parallel_policy` and the `parallel_unsequenced_policy`.
+   *
+   * The standard leaves the constructors of the execution policies
+   * unspecified: only their global objects (`std::execution::par_unseq`,
+   * etc.) can be used portably (libc++ neither default constructs nor copies
+   * them). The default constructor uses the global object of a standard
+   * policy. A policy that can't be copied is kept by reference and must
+   * outlive this object (this is the case of the global objects).
+   */
+  template <typename ExecutionPolicy =
+                std::execution::parallel_unsequenced_policy>
+    requires(std::is_execution_policy_v<ExecutionPolicy>)
+  struct ParallelSTLFieldOperations final : FieldOperations {
+    //! \brief default constructor, for a standard execution policy
+    ParallelSTLFieldOperations() noexcept
+      requires(internals::isStandardExecutionPolicy<ExecutionPolicy>)
+        : policy(internals::getStandardExecutionPolicy<ExecutionPolicy>()) {}
+    //! \param[in] p: execution policy
+    explicit ParallelSTLFieldOperations(const ExecutionPolicy& p) noexcept
+        : policy(p) {}
+
+   private:
+    //! \brief a simple alias
+    using CountingIterator = internals::ParallelSTLCountingIterator;
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nc = d.getNumberOfComponents();
+      auto* const dv = d.data();
+      const auto* const sv = s.data();
+      if (haveSameDenseLayout(d, s)) {
+        std::copy(this->policy, sv, sv + n * nc, dv);
+        return;
+      }
+      const auto dps = d.getPointStride();
+      const auto dcs = d.getComponentStride();
+      const auto sps = s.getPointStride();
+      const auto scs = s.getComponentStride();
+      // one call per point: consecutive calls process consecutive points of
+      // a component, without computing a division per value
+      std::for_each(this->policy, CountingIterator{0}, CountingIterator{n},
+                    [=](const size_type i) {
+                      for (size_type j = 0; j < nc; ++j) {
+                        dv[i * dps + j * dcs] = sv[i * sps + j * scs];
+                      }
+                    });
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nc = d.getNumberOfComponents();
+      auto* const dv = d.data();
+      if (isDense(d)) {
+        std::fill(this->policy, dv, dv + n * nc, v);
+        return;
+      }
+      const auto ps = d.getPointStride();
+      const auto cs = d.getComponentStride();
+      std::for_each(this->policy, CountingIterator{0}, CountingIterator{n},
+                    [=](const size_type i) {
+                      for (size_type j = 0; j < nc; ++j) {
+                        dv[i * ps + j * cs] = v;
+                      }
+                    });
+    }  // end of do_fill
+    //! \brief execution policy, kept by reference if it can't be copied
+    std::conditional_t<std::is_copy_constructible_v<ExecutionPolicy>,
+                       ExecutionPolicy,
+                       const ExecutionPolicy&>
+        policy;
+  };  // end of ParallelSTLFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_PARALLELSTLFIELDOPERATIONS_HXX */
