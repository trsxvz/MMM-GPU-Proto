+# Build a test executable with nvc++ -stdpar=gpu (`MGIS_NVHPC_GPU_FLAGS`
+# options) and the `MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU` macro, as the
+# libraries of `_mfront_generic_parallel_nvhpc_gpu_check_library`. The
+# definitions are those of the tests compiled by the C++ compiler of MGIS
+# (definitions of the directory and of the MGIS library), the include
+# directories those of the directory, of the MGIS library and of the tests.
+# The executable depends on the headers it includes (`DEPFILE`).
+#
+# usage: mgis_nvhpc_gpu_test(name source)
+function(mgis_nvhpc_gpu_test name source)
+  set(_test "${CMAKE_CURRENT_BINARY_DIR}/${name}")
+  get_property(_definitions DIRECTORY PROPERTY COMPILE_DEFINITIONS)
+  list(APPEND _definitions
+    "$<TARGET_PROPERTY:MFrontGenericInterface,INTERFACE_COMPILE_DEFINITIONS>")
+  # without the empty definitions, which would give `-D` alone
+  set(_definitions "$<FILTER:${_definitions},EXCLUDE,^$>")
+  get_property(_directories DIRECTORY PROPERTY INCLUDE_DIRECTORIES)
+  set(_includes "-I${PROJECT_SOURCE_DIR}/include")
+  foreach(_directory ${_directories})
+    list(APPEND _includes "-I${_directory}")
+  endforeach(_directory ${_directories})
+  add_custom_command(
+    OUTPUT "${_test}"
+    COMMAND "${MGIS_NVHPC_CXX_COMPILER}" ${MGIS_NVHPC_GPU_FLAGS}
+            -DMGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU
+            "$<$<BOOL:${_definitions}>:-D$<JOIN:${_definitions},;-D>>"
+            ${_includes} "-I${CMAKE_CURRENT_SOURCE_DIR}"
+            -MD -MT "${_test}" -MF "${_test}.d"
+            "${CMAKE_CURRENT_SOURCE_DIR}/${source}"
+            -o "${_test}" "$<TARGET_FILE:MFrontGenericInterface>"
+            "-Wl,-rpath,$<TARGET_FILE_DIR:MFrontGenericInterface>"
+    DEPENDS ${source} MFrontGenericInterface
+    DEPFILE "${_test}.d"
+    COMMENT "nvc++ test ${name}"
+    COMMAND_EXPAND_LISTS VERBATIM)
+  add_custom_target(${name}-build DEPENDS "${_test}")
+  add_dependencies(build-tests ${name}-build)
+endfunction(mgis_nvhpc_gpu_test)
+
