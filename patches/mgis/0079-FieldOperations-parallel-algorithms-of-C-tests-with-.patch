+/*!
+ * \file   tests/CUDADeviceArray.hxx
+ * \brief  This file declares an array located in the memory of an NVIDIA
+ * GPU only, allocated and copied with the runtime API of CUDA, used by the
+ * tests of the `cuda` backend and of the `stlpar` backend compiled by
+ * `nvc++ -stdpar=gpu`.
+ * \date   19/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_TESTS_CUDADEVICEARRAY_HXX
+#define LIB_MGIS_TESTS_CUDADEVICEARRAY_HXX
+
+#include <span>
+#include <string>
+#include <vector>
+#include <stdexcept>
+#include <cuda_runtime.h>
+#include "MGIS/Config.hxx"
+
+namespace mgis::tests {
+
+  //! \brief throw an exception if a function of CUDA failed
+  inline void checkCUDA(const cudaError_t e, const char* const f) {
+    if (e != cudaSuccess) {
+      throw std::runtime_error(std::string{f} + ": " + cudaGetErrorString(e));
+    }
+  }  // end of checkCUDA
+
+  //! \brief array in the memory of the device only
+  struct CUDADeviceArray {
+    explicit CUDADeviceArray(const size_type n) : size(n) {
+      checkCUDA(cudaMalloc(&(this->values), n * sizeof(real)), "cudaMalloc");
+    }
+    CUDADeviceArray(CUDADeviceArray&&) = delete;
+    CUDADeviceArray(const CUDADeviceArray&) = delete;
+    ~CUDADeviceArray() { static_cast<void>(cudaFree(this->values)); }
+    std::span<real> span() const { return {this->values, this->size}; }
+    void copyFrom(const std::vector<real>& v) {
+      checkCUDA(cudaMemcpy(this->values, v.data(), v.size() * sizeof(real),
+                           cudaMemcpyHostToDevice),
+                "cudaMemcpy");
+    }
+    std::vector<real> copyToHost() const {
+      auto v = std::vector<real>(this->size);
+      checkCUDA(cudaMemcpy(v.data(), this->values, v.size() * sizeof(real),
+                           cudaMemcpyDeviceToHost),
+                "cudaMemcpy");
+      return v;
+    }
+    real* values = nullptr;
+    size_type size;
+  };
+
+}  // end of namespace mgis::tests
+
+#endif /* LIB_MGIS_TESTS_CUDADEVICEARRAY_HXX */
