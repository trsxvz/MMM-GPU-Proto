+/*!
+ * \file   tests/FieldOperationsParallelSTLTest.cxx
+ * \brief  This test checks the field operations of the
+ * `MGIS/FieldOperations/ParallelSTLFieldOperations.hxx` header, and a
+ * complete cycle with the `stlpar` backend: integration of a behaviour
+ * generated by the `generic-parallel` interface with the `stlpar` backend on
+ * arrays stored component by component, and update of the states with the
+ * parallel algorithms. See `FieldOperationsTest.hxx` for the list of the
+ * checks. The field operations are also checked with the other standard
+ * execution policies.
+ *
+ * The test is compiled twice:
+ *
+ * - by the C++ compiler of `MGIS`: the algorithms run on the host (in
+ *   parallel if they use TBB, as those of libstdc++, and TBB is found) and
+ *   the arrays are located in the memory of the host;
+ * - by `nvc++ -stdpar=gpu`, with the `MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU`
+ *   macro: the algorithms run on the GPU, the arrays are located in the
+ *   memory of the device only, and the statuses of the asynchronous
+ *   computations in managed memory, as in the test of the `cuda` backend.
+ *   The behaviours and the material properties are then compiled by
+ *   `nvc++ -stdpar=gpu` too.
+ * \date   19/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <memory>
+#include <cstdlib>
+#include <execution>
+#include <string_view>
+#include <memory_resource>
+#include "MGIS/FieldOperations/ParallelSTLFieldOperations.hxx"
+#ifdef MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU
+#include "MGIS/MemoryResources/CUDAManagedMemoryResource.hxx"
+#include "CUDADeviceArray.hxx"
+#endif /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+#include "FieldOperationsTest.hxx"
+
+#ifndef MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU
+
+//! \brief array in the memory of the host
+struct HostArray {
+  explicit HostArray(const size_type n)
+      : values(std::make_unique<real[]>(n)), size(n) {}
+  HostArray(HostArray&&) = delete;
+  HostArray(const HostArray&) = delete;
+  std::span<real> span() const { return {this->values.get(), this->size}; }
+  void copyFrom(const std::vector<real>& v) {
+    std::copy(v.begin(), v.end(), this->values.get());
+  }
+  std::vector<real> copyToHost() const {
+    return {this->values.get(), this->values.get() + this->size};
+  }
+  std::unique_ptr<real[]> values;
+  size_type size;
+};
+
+#endif /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+
+/*!
+ * \brief the `stlpar` backend. The parallel algorithms ignore the queues
+ * and are synchronous.
+ */
+struct ParallelSTLBackend {
+#ifdef MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU
+  static constexpr auto location = mgis::MemoryLocation::DEVICE;
+  static constexpr auto shared_location = mgis::MemoryLocation::SHARED;
+  //! \brief the stresses differ by 1.2e-12 (nvc++)
+  static constexpr double cycle_stress_tolerance = 1e-11;
+  using Array = mgis::tests::CUDADeviceArray;
+#else  /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+  static constexpr auto location = mgis::MemoryLocation::HOST;
+  static constexpr auto shared_location = mgis::MemoryLocation::HOST;
+  /*!
+   * \brief the stresses are the same as those of the reference, computed
+   * by the same compiler
+   */
+  static constexpr double cycle_stress_tolerance = 1e-12;
+  using Array = HostArray;
+#endif /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+  ParallelSTLBackend() = default;
+  ParallelSTLBackend(ParallelSTLBackend&&) = delete;
+  ParallelSTLBackend(const ParallelSTLBackend&) = delete;
+  mgis::FieldOperations& operations() { return this->ops; }
+  mgis::BatchExecutionPolicy policy() const { return {}; }
+  mgis::AsynchronousBatchExecutionPolicy asynchronousPolicy() {
+    auto p = mgis::AsynchronousBatchExecutionPolicy{};
+    p.resource = &(this->pool);
+    p.location = shared_location;
+    return p;
+  }
+#ifdef MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU
+  std::pmr::memory_resource* sharedResource() { return &(this->shared); }
+#else  /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+  std::pmr::memory_resource* sharedResource() {
+    return std::pmr::new_delete_resource();
+  }
+#endif /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+  void synchronize() {}
+  void synchronizeDefaultQueue() {}
+
+ private:
+#ifdef MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU
+  mgis::memory_resources::CUDAManagedMemoryResource shared;
+  std::pmr::synchronized_pool_resource pool{&shared};
+#else  /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+  std::pmr::synchronized_pool_resource pool;
+#endif /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+  mgis::field_operations::ParallelSTLFieldOperations<> ops;
+};
+
+/*!
+ * \brief copies and fills with the given execution policy: contiguous copy,
+ * transpositions, dense fill and fill of a component
+ * \param[in] p: execution policy
+ * \param[in] name: name of the execution policy
+ */
+template <typename ExecutionPolicy>
+static void testExecutionPolicy(const ExecutionPolicy& p,
+                                const std::string_view name) {
+  using Array = ParallelSTLBackend::Array;
+  constexpr auto n = size_type{5};
+  constexpr auto nc = size_type{3};
+  auto values = std::vector<real>(n * nc);
+  for (size_type i = 0; i != n * nc; ++i) {
+    values[i] = static_cast<real>(i + 1);
+  }
+  auto a = Array(n * nc);
+  auto b = Array(n * nc);
+  auto c = Array(n * nc);
+  a.copyFrom(values);
+  // the type of the execution policy is deduced from the argument
+  auto ops = mgis::field_operations::ParallelSTLFieldOperations{p};
+  static_assert(
+      std::is_same_v<
+          decltype(ops),
+          mgis::field_operations::ParallelSTLFieldOperations<ExecutionPolicy>>);
+  const auto va =
+      mgis::makeFieldView(a.span(), FieldLayout::POINT_BY_POINT, n, nc);
+  const auto vb = mgis::makeComponentByComponentFieldView(b.span(), n, nc, n);
+  const auto vc =
+      mgis::makeFieldView(c.span(), FieldLayout::POINT_BY_POINT, n, nc);
+  ops.copy(vb, va);  // transposition
+  ops.copy(vc, vb);  // transposition
+  const auto message = std::string{name} + ": ";
+  check(c.copyToHost() == values, message + "invalid transpositions");
+  check(b.copyToHost() == storeComponentByComponent(values, n, nc, n),
+        message + "invalid component by component copy");
+  ops.fill(vc, 0);                               // dense fill
+  ops.copy(va, vc);                              // contiguous copy
+  ops.fill(mgis::getComponents(vb, 1, 1), 2.5);  // strided fill
+  check(a.copyToHost() == std::vector<real>(n * nc, 0),
+        message + "invalid fill or contiguous copy");
+  const auto pb = b.copyToHost();
+  check(areEqual(pb[n + 2], real{2.5}) && areEqual(pb[2], values[2 * nc]),
+        message + "invalid fill of a component");
+}  // end of testExecutionPolicy
+
+//! \brief copies and fills with the other standard execution policies
+static void testExecutionPolicies() {
+  // `nvc++ -stdpar=gpu` runs the algorithms on the GPU only with the
+  // parallel policies: the others would read the memory of the device on
+  // the host
+  testExecutionPolicy(std::execution::par, "par");
+#ifndef MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU
+  testExecutionPolicy(std::execution::seq, "seq");
+#if __cpp_lib_execution >= 201902L
+  testExecutionPolicy(std::execution::unseq, "unseq");
+#endif /* __cpp_lib_execution >= 201902L */
+#endif /* MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU */
+}  // end of testExecutionPolicies
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 5) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-stlpar-library generic-library "
+                 "generic-parallel-stlpar-material-properties-library "
+                 "material-properties-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    testBackend<ParallelSTLBackend>(argv[1], argv[2], argv[3], argv[4]);
+    testExecutionPolicies();
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
