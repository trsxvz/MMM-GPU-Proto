+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_TESTS_FIELDOPERATIONSTEST_HXX
+#define LIB_MGIS_TESTS_FIELDOPERATIONSTEST_HXX
+
+#include <cmath>
+#include <memory>
+#include <algorithm>
+#include <functional>
+#include <span>
+#include <array>
+#include <string>
