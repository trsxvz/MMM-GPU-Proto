+#include "MGIS/Behaviour/Integrate.hxx"
+#include "MGIS/MaterialProperty/MaterialProperty.hxx"
+#include "Tolerance.hxx"
+
+using mgis::FieldLayout;
+using mgis::FieldView;
+using mgis::real;
+using mgis::size_type;
+using mgis::tests::tolerance;
+
+/*!
+ * \brief description of a backend:
+ *
+ * - `location`: location of the arrays of the backend (constant
+ *   expression);
+ * - `shared_location`: location of the memory shared by the host and the
+ *   backend, allocated by `sharedResource` (constant expression);
+ * - `cycle_stress_tolerance`: tolerance on the stresses of the complete
+ *   cycle in double precision, relative to 1e8 Pa, compared to the
+ *   integration point by point on the host (constant expression);
+ * - `Array`: array of values in the memory of the backend, built from its
+ *   size (`size` member), giving a view of its values (`span`), filled from
+ *   values of the host (`copyFrom`), and copied on the host (`copyToHost`);
+ *   the arrays are neither copied nor moved;
+ * - `operations`: field operations of the backend;
+ * - `policy`, `asynchronousPolicy`: synchronous and asynchronous execution
+ *   policies of the backend, the statuses of the asynchronous computations
+ *   being allocated by a pool of the shared memory;
+ * - `synchronize`: wait for the completion of the computations and of the
+ *   operations submitted on the queue of the backend;
+ * - `synchronizeDefaultQueue`: wait for the completion of the computations
+ *   submitted without queue.
+ */
+template <typename Backend>
+concept FieldOperationsTestBackend =
+    std::same_as<std::remove_cvref_t<decltype(Backend::location)>,
+                 mgis::MemoryLocation> &&
+    std::same_as<std::remove_cvref_t<decltype(Backend::shared_location)>,
+                 mgis::MemoryLocation> &&
+    std::same_as<std::remove_cvref_t<decltype(Backend::cycle_stress_tolerance)>,
+                 double> &&
+    requires {
+      // constant expressions
+      typename std::integral_constant<mgis::MemoryLocation, Backend::location>;
+      typename std::integral_constant<mgis::MemoryLocation,
+                                      Backend::shared_location>;
+      typename std::bool_constant<(Backend::cycle_stress_tolerance > 0)>;
+    } && std::default_initializable<Backend> &&
+    std::constructible_from<typename Backend::Array, size_type> &&
+    requires(Backend& b,
+             typename Backend::Array& a,
+             const typename Backend::Array& ca,
+             const std::vector<real>& v) {
+      { ca.size } -> std::convertible_to<size_type>;
+      { ca.span() } -> std::same_as<std::span<real>>;
+      a.copyFrom(v);
+      { ca.copyToHost() } -> std::same_as<std::vector<real>>;
+      { b.operations() } -> std::convertible_to<mgis::FieldOperations&>;
+      { b.policy() } -> std::same_as<mgis::BatchExecutionPolicy>;
+      {
+        b.asynchronousPolicy()
+      } -> std::same_as<mgis::AsynchronousBatchExecutionPolicy>;
+      { b.sharedResource() } -> std::same_as<std::pmr::memory_resource*>;
+      b.synchronize();
+      b.synchronizeDefaultQueue();
+    };
+
+static bool success = true;
+
+/*!
+ * \return true if the two values are equal. The copies and the fills are
+ * exact (`std::equal_to` avoids the warnings of `-Wfloat-equal`).
+ */
+template <typename ValueType>
+static bool areEqual(const ValueType a, const ValueType b) {
+  return std::equal_to<ValueType>{}(a, b);
+}
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+/*!
+ * \return true if the given function throws an exception whose message
+ * contains the given text
+ */
+template <typename Function>
+static bool throws(const Function& f, const std::string_view text) {
+  try {
+    f();
+  } catch (std::exception& e) {
+    return std::string_view{e.what()}.find(text) != std::string_view::npos;
+  }
+  return false;
+}
+
+//! \brief copies and fills of views in the memory of the backend
+template <typename Backend>
+static void testFieldOperations() {
+  using Array = typename Backend::Array;
+  constexpr auto n = size_type{37};
+  constexpr auto nc = size_type{3};
+  auto values = std::vector<real>(n * nc);
+  for (size_type k = 0; k != values.size(); ++k) {
+    values[k] = static_cast<real>(k);
+  }
+  auto a = Array(n * nc);        // point by point
+  auto c = Array(nc * (n + 5));  // component by component, padded
+  auto d = Array(n * nc);        // point by point
+  a.copyFrom(values);
+  auto backend = Backend{};
+  auto& ops = backend.operations();
+  const auto va =
+      mgis::makeFieldView(a.span(), FieldLayout::POINT_BY_POINT, n, nc);
+  const auto vc =
+      mgis::makeComponentByComponentFieldView(c.span(), n, nc, n + 5);
+  const auto vd =
+      mgis::makeFieldView(d.span(), FieldLayout::POINT_BY_POINT, n, nc);
+  ops.fill(FieldView<real>(c.span(), 1, c.size, c.size, 1), -1);
+  ops.copy(vc, va);  // transposition
+  ops.copy(vd, vc);  // transposition
+  backend.synchronize();
+  check(d.copyToHost() == values, "field operations: invalid copies");
+  const auto pc = c.copyToHost();
+  check(areEqual(pc[n], real{-1}) &&
+            areEqual(pc[2 * (n + 5) + n + 4], real{-1}) &&
+            areEqual(pc[(n + 5) + 2], values[2 * nc + 1]),
+        "field operations: invalid component by component copy");
+  ops.fill(vd, 0);                               // dense fill
+  ops.copy(va, vd);                              // contiguous copy
+  ops.fill(mgis::getComponents(vc, 1, 1), 2.5);  // strided fill
+  backend.synchronize();
+  check(a.copyToHost() == std::vector<real>(n * nc, 0),
+        "field operations: invalid fill");
+  const auto pc2 = c.copyToHost();
+  check(
+      areEqual(pc2[(n + 5) + 3], real{2.5}) && areEqual(pc2[3], values[3 * nc]),
+      "field operations: invalid fill of a component");
+}  // end of testFieldOperations
+
+/*!
+ * \brief integration of the Norton behaviour by the backend, arrays stored
+ * component by component in the memory of the backend, update of the states
+ * by the operations of the backend, compared to the integration point by
+ * point on the host
+ */
+template <typename Backend>
+static void testIntegrationCycle(const std::string& gp_library,
+                                 const std::string& library) {
+  using namespace mgis::behaviour;
+  using Array = typename Backend::Array;
+  const auto gp_b = load(gp_library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{64};
+  const auto gs = getArraySize(b.gradients, b.hypothesis);
+  const auto ts = getArraySize(b.thermodynamic_forces, b.hypothesis);
+  const auto is = getArraySize(b.isvs, b.hypothesis);
+  const auto Ks = getTangentOperatorArraySize(b);
+  // reference on the host, point by point
+  auto r = MaterialDataManager(b, n);
+  setExternalStateVariable(r.s0, "Temperature", 293.15);
+  setExternalStateVariable(r.s1, "Temperature", 293.15);
+  // arrays in the memory of the backend, component by component
+  auto g0 = Array(n * gs), g1 = Array(n * gs);
+  auto t0 = Array(n * ts), t1 = Array(n * ts);
+  auto i0 = Array(n * is), i1 = Array(n * is);
+  auto K = Array(n * Ks);
+  auto e0 = Array(n), e1 = Array(n), d0 = Array(n), d1 = Array(n);
+  auto T = Array(1);
+  T.copyFrom({293.15});
+  for (auto* const a : {&g0, &g1, &t0, &t1, &i0, &i1, &e0, &e1, &d0, &d1}) {
+    a->copyFrom(std::vector<real>(a->size, 0));
+  }
+  auto init = MaterialDataManagerInitializer{};
+  init.layout = FieldLayout::COMPONENT_BY_COMPONENT;
+  init.location = Backend::location;
+  init.s0.gradients = g0.span();
+  init.s1.gradients = g1.span();
+  init.s0.thermodynamic_forces = t0.span();
+  init.s1.thermodynamic_forces = t1.span();
+  init.s0.internal_state_variables = i0.span();
+  init.s1.internal_state_variables = i1.span();
+  init.K = K.span();
+  if (b.computesStoredEnergy) {
+    init.s0.stored_energies = e0.span();
+    init.s1.stored_energies = e1.span();
+  }
+  if (b.computesDissipatedEnergy) {
+    init.s0.dissipated_energies = d0.span();
+    init.s1.dissipated_energies = d1.span();
+  }
+  auto m = MaterialDataManager(gp_b, n, init);
+  setExternalStateVariable(m.s0, "Temperature", T.span(),
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  setExternalStateVariable(m.s1, "Temperature", T.span(),
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  auto backend = Backend{};
+  auto& ops = backend.operations();
+  const auto p = backend.policy();
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  auto gradients = std::vector<real>(n * gs, 0);  // component by component
+  // four steps with double. With float, the integration of the most loaded
+  // points fails at the fourth step (stress of about 3e9 Pa, Norton exponent
+  // of 8.2: the residual of the implicit scheme can't reach its criterion),
+  // on the host as by the backend
+  constexpr auto nsteps = std::is_same_v<real, double> ? 4 : 3;
+  for (int step = 0; step != nsteps; ++step) {
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != gs; ++c) {
+        const auto de = 1e-4 * static_cast<real>((step + 1) * (c + 1)) *
+                        (1 + 0.05 * static_cast<real>(i));
+        r.s1.gradients[i * gs + c] += de;
+        gradients[c * n + i] += de;
+      }
+    }
+    g1.copyFrom(gradients);
+    const auto rr = integrate(r, opts, 180);
+    const auto rm = integrate(p, m, opts, 180);
+    check((rr.exit_status == 1) && (rm.exit_status == 1),
+          "cycle: invalid status");
+    update(r);
+    update(m, ops);
+    backend.synchronize();
+  }
+  // comparison of the states at the beginning of the next time step
+  auto compare = [&r, n](const std::vector<real>& v,
+                         const std::span<const real> ref, const size_type nc,
+                         const double scale, const real tol,
+                         const std::string& name) {
+    auto d = 0.;
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != nc; ++c) {
+        d = std::max(d, std::abs(v[c * n + i] - ref[i * nc + c]) / scale);
+      }
+    }
+    static_cast<void>(r);
+    auto message = std::ostringstream{};
+    message << "cycle: invalid " << name << " (" << std::scientific << d
+            << ", tolerance " << tol << ")";
+    check(d < tol, message.str());
+  };
+  // the differences of rounding are amplified by the flow: the tolerance of
+  // the stresses in double depends on the backend (see the
+  // `cycle_stress_tolerance` member of the backends). In float, the stresses
+  // differ by 2.0e-4 after three steps (cuda); the internal state variables
+  // by 5.5e-8
+  compare(t0.copyToHost(), r.s0.thermodynamic_forces, ts, 1e8,
+          tolerance(Backend::cycle_stress_tolerance, 2e-3),
+          "thermodynamic forces");
+  compare(i0.copyToHost(), r.s0.internal_state_variables, is, 1,
+          tolerance(1e-12), "internal state variables");
+  compare(g0.copyToHost(), r.s0.gradients, gs, 1, tolerance(1e-12),
+          "gradients");
+  check(K.copyToHost() == std::vector<real>(n * Ks, 0),
+        "cycle: tangent operator blocks not set to zero");
+  // a copy between a value held by the manager (on the host) and an array of
+  // the device is refused (on the host, the copy is made by the host)
+  if constexpr (Backend::location == mgis::MemoryLocation::DEVICE) {
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    check(throws([&m, &ops] { update(m, ops); }, "can't be copied"),
+          "cycle: mixed copy not refused");
+  }
+  // update of a material data view in the memory of the backend
+  setExternalStateVariable(m.s0, "Temperature", T.span(),
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  auto v = make_view(m);
+  ops.fill(v.s1.thermodynamic_forces, 7);
+  update(v, ops);
+  backend.synchronize();
+  check(t0.copyToHost() == std::vector<real>(n * ts, 7),
+        "cycle: invalid update of a material data view");
+}  // end of testIntegrationCycle
+
+/*!
+ * \brief asynchronous computations whose statuses are allocated by a pool
+ * of the memory shared by the host and the backend (managed memory with
+ * CUDA): no allocation of this memory by call
+ */
+template <typename Backend>
+static void testAsynchronousComputationsWithPool(
+    const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  const auto b = load(gp_library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{16};
+  auto backend = Backend{};
+  auto i = MaterialDataManagerInitializer{};
+  i.location = Backend::shared_location;
+  i.resource = backend.sharedResource();
+  auto m = MaterialDataManager(b, n, i);
+  auto T = std::pmr::vector<real>(1, 293.15, backend.sharedResource());
+  setExternalStateVariable(m.s0, "Temperature", T,
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  setExternalStateVariable(m.s1, "Temperature", T,
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  for (size_type k = 0; k != n; ++k) {
+    m.s1.gradients[k * m.s1.gradients_stride] = 1e-3;
+  }
+  const auto p = backend.asynchronousPolicy();
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  // a mass density held by the manager on the host is not accessible by the
+  // device: the reason is reported (on the host, the integration accepts it)
+  if constexpr (Backend::location == mgis::MemoryLocation::DEVICE) {
+    setMassDensity(m.s0, 7800.);
+    setMassDensity(m.s1, 7800.);
+    auto speed_of_sound_opts = BehaviourIntegrationOptions{};
+    speed_of_sound_opts.compute_speed_of_sound = true;
+    check(throws(
+              [&m, &speed_of_sound_opts] {
+                static_cast<void>(integrate(BatchExecutionPolicy{}, m,
+                                            speed_of_sound_opts, 1));
+              },
+              "the mass density is held by the material data manager"),
+          "mass density held on the host: invalid error");
+  }
+  for (int k = 0; k != 3; ++k) {
+    auto pending = std::vector<PendingBatchComputation>{};
+    pending.reserve(4);
+    for (size_type s = 0; s != 4; ++s) {
+      pending.push_back(integrate(p, m, opts, 1, 4 * s, 4 * s + 4));
+    }
+    backend.synchronize();
+    for (const auto& pr : pending) {
+      check(pr.getResult().exit_status == 1,
+            "asynchronous computations: invalid status");
+    }
+  }
+}  // end of testAsynchronousComputationsWithPool
+
+/*!
+ * \return the maximum of the relative differences between values stored
+ * component by component and values stored point by point
+ * \param[in] v: values stored component by component
+ * \param[in] ref: values stored point by point
+ * \param[in] n: number of points
+ * \param[in] nc: number of components
+ * \param[in] ld: stride between two components of `v`
+ */
+static double compareComponentByComponent(const std::vector<real>& v,
+                                          const std::vector<real>& ref,
+                                          const size_type n,
+                                          const size_type nc,
+                                          const size_type ld) {
+  auto d = real{};
+  for (size_type i = 0; i != n; ++i) {
+    for (size_type c = 0; c != nc; ++c) {
+      const auto r = ref[i * nc + c];
+      d = std::max(
+          d, std::abs(v[c * ld + i] - r) / std::max(std::abs(r), real{1}));
+    }
+  }
+  return d;
+}  // end of compareComponentByComponent
+
+/*!
+ * \return values stored component by component, with a stride `ld`
+ * between two components, from values stored point by point
+ * \param[in] v: values stored point by point
+ * \param[in] n: number of points
+ * \param[in] nc: number of components
+ * \param[in] ld: stride between two components
+ */
+static std::vector<real> storeComponentByComponent(const std::vector<real>& v,
+                                                   const size_type n,
+                                                   const size_type nc,
+                                                   const size_type ld) {
+  auto r = std::vector<real>(nc * ld, 0);
+  for (size_type i = 0; i != n; ++i) {
+    for (size_type c = 0; c != nc; ++c) {
+      r[c * ld + i] = v[i * nc + c];
+    }
+  }
+  return r;
+}  // end of storeComponentByComponent
+
+/*!
+ * \brief rotations of an orthotropic behaviour and evaluations of a
+ * material property on views of arrays located in the memory of the
+ * backend, with arbitrary strides, synchronously and asynchronously (the
+ * statuses and the rotation matrices built from material axes being
+ * allocated by a pool of the memory shared by the host and the backend),
+ * compared to the computations point by point on the host
+ */
+template <typename Backend>
+static void testViews(const std::string& gp_library,
+                      const std::string& library,
+                      const std::string& gp_mp_library,
+                      const std::string& mp_library) {
+  using namespace mgis::behaviour;
+  using Array = typename Backend::Array;
+  constexpr auto n = size_type{29};
+  constexpr auto ld = n + 3;
+  const auto gp_b =
+      load(gp_library, "OrthotropicElasticity", Hypothesis::TRIDIMENSIONAL);
+  const auto b =
+      load(library, "OrthotropicElasticity", Hypothesis::TRIDIMENSIONAL);
+  const auto gs = getArraySize(b.gradients, b.hypothesis);
+  const auto Ks = getTangentOperatorArraySize(b);
+  auto values = [](const size_type size) {
+    auto v = std::vector<real>(size);
+    for (size_type k = 0; k != size; ++k) {
+      v[k] = std::sin(1 + static_cast<double>(k));
+    }
+    return v;
+  };
+  // rotation matrices about the z axis, given point by point
+  auto matrices = std::vector<real>(9 * n);
+  for (size_type i = 0; i != n; ++i) {
+    const auto t = static_cast<real>(0.2 * static_cast<double>(i + 1));
+    const auto m = std::array<real, 9>{
+        std::cos(t), -std::sin(t), 0, std::sin(t), std::cos(t), 0, 0, 0, 1};
+    std::copy(m.begin(), m.end(), matrices.begin() + 9 * i);
+  }
+  // material axes given point by point
+  auto axes1 = std::vector<real>(3 * n, 0);
+  auto axes2 = std::vector<real>(3 * n, 0);
+  for (size_type i = 0; i != n; ++i) {
+    const auto t = static_cast<real>(0.3 * static_cast<double>(i + 1));
+    axes1[3 * i] = std::cos(t);
+    axes1[3 * i + 1] = std::sin(t);
+    axes2[3 * i] = -std::sin(t);
+    axes2[3 * i + 1] = std::cos(t);
+  }
+  const auto r3d =
+      RotationMatrix3D(axes1, axes2, mgis::StorageMode::EXTERNAL_STORAGE);
+  auto backend = Backend{};
+  const auto p = backend.policy();
+  const auto pa = backend.asynchronousPolicy();
+  // rotation in place of the tangent operator blocks, the values and the
+  // matrices being stored component by component in the memory of the
+  // backend
+  const auto K = values(n * Ks);
+  auto rK = std::vector<real>(n * Ks);
+  rotateTangentOperatorBlocks(rK, b, K, std::span<const real>(matrices));
+  auto dK = Array(Ks * ld);
+  dK.copyFrom(storeComponentByComponent(K, n, Ks, ld));
+  auto dm = Array(9 * ld);
+  dm.copyFrom(storeComponentByComponent(matrices, n, 9, ld));
+  rotateTangentOperatorBlocks(
+      p, mgis::makeComponentByComponentFieldView(dK.span(), n, Ks, ld), gp_b,
+      mgis::makeComponentByComponentFieldView(std::span<const real>(dm.span()),
+                                              n, 9, ld),
+      Backend::location);
+  backend.synchronize();
+  check(compareComponentByComponent(dK.copyToHost(), rK, n, Ks, ld) <
+            tolerance(1e-14),
+        "views: invalid rotated tangent operator blocks");
+  // asynchronous rotation of the gradients, from values stored point by
+  // point to values stored component by component, the rotation matrices
+  // being built from material axes
+  const auto g = values(n * gs);
+  auto rg = std::vector<real>(n * gs);
+  rotateGradients(rg, b, g, r3d);
+  auto dg = Array(n * gs);
+  dg.copyFrom(g);
+  auto drg = Array(gs * ld);
+  drg.copyFrom(std::vector<real>(gs * ld, 0));
+  const auto pg = rotateGradients(
+      pa, mgis::makeComponentByComponentFieldView(drg.span(), n, gs, ld), gp_b,
+      mgis::makePointByPointFieldView(std::span<const real>(dg.span()), n, gs,
+                                      gs),
+      r3d, Backend::location);
+  backend.synchronize();
+  check(pg.getResult().exit_status == 1,
+        "views: invalid status of the asynchronous rotation");
+  check(compareComponentByComponent(drg.copyToHost(), rg, n, gs, ld) <
+            tolerance(1e-14),
+        "views: invalid rotated gradients");
+  // rotation of the thermodynamic forces without policy (default queue), in
+  // place, the matrices being given by a view of the memory of the backend
+  const auto ts = getArraySize(b.thermodynamic_forces, b.hypothesis);
+  const auto tf = values(n * ts);
+  auto rtf = std::vector<real>(n * ts);
+  rotateThermodynamicForces(rtf, b, tf, std::span<const real>(matrices));
+  auto dtf = Array(ts * ld);
+  dtf.copyFrom(storeComponentByComponent(tf, n, ts, ld));
+  rotateThermodynamicForces(
+      mgis::makeComponentByComponentFieldView(dtf.span(), n, ts, ld), gp_b,
+      mgis::makeComponentByComponentFieldView(std::span<const real>(dm.span()),
+                                              n, 9, ld),
+      Backend::location);
+  backend.synchronizeDefaultQueue();
+  check(compareComponentByComponent(dtf.copyToHost(), rtf, n, ts, ld) <
+            tolerance(1e-14),
+        "views: invalid rotated thermodynamic forces");
+  // evaluation of a material property: temperatures stored with a stride of
+  // 3, values with a stride of 2
+  {
+    using namespace mgis::material_property;
+    const auto gp_mp = load(gp_mp_library, "Inconel600_YoungModulus");
+    const auto mp = load(mp_library, "Inconel600_YoungModulus");
+    auto T = std::vector<real>(n);
+    auto T3 = std::vector<real>(3 * n, 0);
+    for (size_type i = 0; i != n; ++i) {
+      T[i] = 300 + 20 * static_cast<double>(i);
+      T3[3 * i] = T[i];
+    }
+    auto E = std::vector<real>(n);
+    static_cast<void>(evaluate(E, mp, std::array{std::span<const real>(T)}));
+    auto dT = Array(3 * n);
+    dT.copyFrom(T3);
+    auto dE = Array(2 * n);
+    const auto vE = mgis::makePointByPointFieldView(dE.span(), n, 1, 2);
+    const auto vT = std::array{mgis::makePointByPointFieldView(
+        std::span<const real>(dT.span()), n, 1, 3)};
+    const auto compareE = [&E, &dE] {
+      const auto e = dE.copyToHost();
+      auto d = real{};
+      for (size_type i = 0; i != n; ++i) {
+        d = std::max(d, std::abs(e[2 * i] - E[i]) / E[i]);
+      }
+      return d;
+    };
+    for (const auto async : {false, true}) {
+      dE.copyFrom(std::vector<real>(2 * n, 0));
+      auto status = 0;
+      if (async) {
+        const auto pending = evaluate(pa, vE, gp_mp, vT, Backend::location);
+        backend.synchronize();
+        status = pending.getResult().status;
+      } else {
+        status = evaluate(p, vE, gp_mp, vT, Backend::location).status;
+      }
+      check((status == 0) && (compareE() < tolerance(1e-14)),
+            std::string{"views: invalid "} + (async ? "asynchronous " : "") +
+                "evaluation of the material property");
+    }
+  }
+}  // end of testViews
