diff --git a/cmake/modules/generic-parallel.cmake b/cmake/modules/generic-parallel.cmake
index f8bf575..6329913 100644
--- a/cmake/modules/generic-parallel.cmake
+++ b/cmake/modules/generic-parallel.cmake
@@ -1,27 +1,53 @@
 # Libraries generated by the `generic-parallel` interfaces of `MFront`
 # (behaviours, models and material properties) with a given backend. The
-# options of the backend are its default options. The sources are generated
-# in a directory of their own for each kind of library and each backend,
-# since the `generic` interface generates sources with the same names, and
-# they are generated again when `MFront` changes. The sources of the `cuda`
-# backend require the CUDA language.
+# sources are generated in a directory of their own for each kind of library
+# and each backend, since the `generic` interface generates sources with the
+# same names, and they are generated again when `MFront` or the options of
+# the backend change. The libraries are compiled by the C++ compiler of
+# `MGIS` with the default options of the backend (the sources of the `cuda`
+# backend require the CUDA language), or by `nvc++ -stdpar=gpu` for the
+# `stlpar` backend on an NVIDIA GPU.
 
-# usage: _mfront_generic_parallel_check_library(name kind backend sources...)
-# where `kind` is `behaviours` or `material-properties`. A material property
-# is designated by the name of the generated function, which must be the
-# name of its source file.
-function(_mfront_generic_parallel_check_library name kind backend)
-  set(_directory
-    "${CMAKE_CURRENT_BINARY_DIR}/generic-parallel-${kind}-${backend}")
-  set(_configuration "${_directory}/configuration.json")
-  file(MAKE_DIRECTORY "${_directory}")
-  # the syntax of a backend without options is `backend: "name"`
-  file(WRITE "${_configuration}"
+# DEPFILE of the custom commands
+if(POLICY CMP0116)
+  cmake_policy(SET CMP0116 NEW)
+endif(POLICY CMP0116)
+
+# Writes a file at configuration time if its content changes, so that the
+# rules depending on it are only run again in this case.
+#
+# usage: _mgis_write_file_if_different(file content)
+function(_mgis_write_file_if_different file content)
+  set(_old)
+  if(EXISTS "${file}")
+    file(READ "${file}" _old)
+  endif(EXISTS "${file}")
+  if(NOT "${_old}" STREQUAL "${content}")
+    file(WRITE "${file}" "${content}")
+  endif(NOT "${_old}" STREQUAL "${content}")
+endfunction(_mgis_write_file_if_different)
+
+# Sources generated by the `generic-parallel` interfaces of `MFront`, in a
+# directory of their own.
+#
+# usage: _mfront_generic_parallel_sources(output directory kind backend
+#                                         backend_configuration sources...)
+# where `output` is the name of the variable receiving the sources, `kind` is
+# `behaviours` or `material-properties`, and `backend_configuration` the
+# value of the `backend` entry of the configuration file of `MFront`: the
+# name of the backend between quotes for its default options, or a map
+# giving its options.
+function(_mfront_generic_parallel_sources output directory kind backend
+                                          backend_configuration)
+  set(_configuration "${directory}/configuration.json")
+  file(MAKE_DIRECTORY "${directory}")
+  string(CONCAT _content
     "interfaces_options: {\n"
     "  generic-parallel: {\n"
-    "    backend: \"${backend}\"\n"
+    "    backend: ${backend_configuration}\n"
     "  }\n"
     "}\n")
+  _mgis_write_file_if_different("${_configuration}" "${_content}")
   if(backend STREQUAL "cuda")
     set(_extension "cu")
   else(backend STREQUAL "cuda")
@@ -31,10 +57,10 @@ function(_mfront_generic_parallel_check_library name kind backend)
   foreach(source ${ARGN})
     set(_file "${CMAKE_CURRENT_SOURCE_DIR}/${source}.mfront")
     set(_outputs
-      "${_directory}/src/${source}-generic-parallel-${backend}.${_extension}")
+      "${directory}/src/${source}-generic-parallel-${backend}.${_extension}")
     if(kind STREQUAL "behaviours")
       # code shared with the `generic` interface
-      list(APPEND _outputs "${_directory}/src/${source}.cxx")
+      list(APPEND _outputs "${directory}/src/${source}.cxx")
     endif(kind STREQUAL "behaviours")
     add_custom_command(
       OUTPUT ${_outputs}
@@ -42,11 +68,27 @@ function(_mfront_generic_parallel_check_library name kind backend)
       ARGS "--interface=generic-parallel" ${MGIS_MFRONT_REAL_TYPE_OPTION}
       ARGS "--configuration-file=${_configuration}"
       ARGS "${_file}"
-      DEPENDS "${_file}" "${MFRONT}"
-      WORKING_DIRECTORY "${_directory}"
+      DEPENDS "${_file}" "${MFRONT}" "${_configuration}"
+      WORKING_DIRECTORY "${directory}"
       COMMENT "mfront source ${_file} (generic-parallel interface)")
     list(APPEND _sources ${_outputs})
   endforeach(source ${ARGN})
+  set(${output} ${_sources} PARENT_SCOPE)
+endfunction(_mfront_generic_parallel_sources)
+
+# Library generated by the `generic-parallel` interfaces of `MFront` with the
+# default options of the given backend.
+#
+# usage: _mfront_generic_parallel_check_library(name kind backend sources...)
+# where `kind` is `behaviours` or `material-properties`. A material property
+# is designated by the name of the generated function, which must be the
+# name of its source file.
+function(_mfront_generic_parallel_check_library name kind backend)
+  set(_directory
+    "${CMAKE_CURRENT_BINARY_DIR}/generic-parallel-${kind}-${backend}")
+  # the syntax of a backend without options is `backend: "name"`
+  _mfront_generic_parallel_sources(_sources "${_directory}" ${kind} ${backend}
+    "\"${backend}\"" ${ARGN})
   message(STATUS "Adding library : ${name} (${_sources})")
   add_library(${name} SHARED EXCLUDE_FROM_ALL ${_sources})
   add_dependencies(check ${name})
@@ -104,3 +146,105 @@ function(mfront_generic_parallel_material_properties_check_library name
   _mfront_generic_parallel_check_library(${name} material-properties
     ${backend} ${ARGN})
 endfunction(mfront_generic_parallel_material_properties_check_library)
+
+# options of `nvc++` for the libraries and the tests of the `stlpar` backend
+# on an NVIDIA GPU: those of the GPU of the `stlpar-parunseq-nvhpc-gpu`
+# configuration of TFEL (without `-march=native`)
+set(MGIS_NVHPC_GPU_FLAGS "-O2;-std=c++20;-stdpar=gpu;-gpu=mem:managed,nordc"
+  CACHE STRING "options of nvc++ for the libraries and the tests of the stlpar backend on an NVIDIA GPU")
+
+# Libraries generated by the `generic-parallel` interfaces of `MFront` with
+# the `stlpar` backend (`par_unseq` execution policy) and compiled by
+# `nvc++` for an NVIDIA GPU with the `MGIS_NVHPC_GPU_FLAGS` options.
+# The C++ compiler of `MGIS` is not used: each source is compiled by a custom
+# command, so that the sources are compiled in parallel, the library is
+# linked by another one and described by an imported target. The objects
+# depend on the headers they include (`DEPFILE`, which requires CMake 3.20)
+# and on the options. `MGIS_NVHPC_CXX_COMPILER` gives the path to `nvc++`.
+#
+# usage: _mfront_generic_parallel_nvhpc_gpu_check_library(name kind
+#                                                         sources...)
+function(_mfront_generic_parallel_nvhpc_gpu_check_library name kind)
+  set(_directory
+    "${CMAKE_CURRENT_BINARY_DIR}/generic-parallel-${kind}-stlpar-nvhpc-gpu")
+  _mfront_generic_parallel_sources(_sources "${_directory}" ${kind} stlpar
+    "{stlpar: {execution_policy: \"parallel_unsequenced_policy\", device_stack_size: 16384}}"
+    ${ARGN})
+  set(_library "${_directory}/${CMAKE_SHARED_LIBRARY_PREFIX}${name}")
+  set(_library "${_library}${CMAKE_SHARED_LIBRARY_SUFFIX}")
+  set(_definitions -DMFRONT_COMPILING)
+  if(CMAKE_SIZEOF_VOID_P EQUAL 8)
+    list(APPEND _definitions -DTFEL_ARCH64)
+  else(CMAKE_SIZEOF_VOID_P EQUAL 8)
+    list(APPEND _definitions -DTFEL_ARCH32)
+  endif(CMAKE_SIZEOF_VOID_P EQUAL 8)
+  # the options are written in a file on which the objects depend
+  set(_flags "${_directory}/nvhpc-gpu-flags.txt")
+  _mgis_write_file_if_different("${_flags}" "${MGIS_NVHPC_GPU_FLAGS}\n")
+  # run paths of the libraries of TFEL, as for the libraries compiled by the
+  # C++ compiler of MGIS
+  set(_rpaths)
+  foreach(_tfel_library ${TFEL_MFRONT_LIBRARIES})
+    if(IS_ABSOLUTE "${_tfel_library}")
+      get_filename_component(_rpath "${_tfel_library}" DIRECTORY)
+      list(APPEND _rpaths "-Wl,-rpath,${_rpath}")
+    endif(IS_ABSOLUTE "${_tfel_library}")
+  endforeach(_tfel_library ${TFEL_MFRONT_LIBRARIES})
+  if(_rpaths)
+    list(REMOVE_DUPLICATES _rpaths)
+  endif(_rpaths)
+  message(STATUS "Adding library : ${name} (${_sources}, nvc++)")
+  set(_objects)
+  foreach(_source ${_sources})
+    get_filename_component(_object "${_source}" NAME_WE)
+    set(_object "${_directory}/objects/${_object}.o")
+    add_custom_command(
+      OUTPUT "${_object}"
+      COMMAND "${MGIS_NVHPC_CXX_COMPILER}" ${MGIS_NVHPC_GPU_FLAGS} -fPIC
+              ${_definitions} "-I${_directory}/include"
+              "-I${TFEL_INCLUDE_PATH}" -MD -MT "${_object}"
+              -MF "${_object}.d" -c "${_source}" -o "${_object}"
+      DEPENDS "${_source}" "${_flags}"
+      DEPFILE "${_object}.d"
+      WORKING_DIRECTORY "${_directory}"
+      COMMENT "nvc++ object ${_object} (stlpar backend, NVIDIA GPU)"
+      VERBATIM)
+    list(APPEND _objects "${_object}")
+  endforeach(_source ${_sources})
+  file(MAKE_DIRECTORY "${_directory}/objects")
+  add_custom_command(
+    OUTPUT "${_library}"
+    COMMAND "${MGIS_NVHPC_CXX_COMPILER}" ${MGIS_NVHPC_GPU_FLAGS} -shared
+            ${_objects} -o "${_library}" ${TFEL_MFRONT_LIBRARIES} ${_rpaths}
+    DEPENDS ${_objects} "${_flags}"
+    WORKING_DIRECTORY "${_directory}"
+    COMMENT "nvc++ library ${name} (stlpar backend, NVIDIA GPU)"
+    VERBATIM)
+  add_custom_target(${name}-nvhpc-gpu DEPENDS "${_library}")
+  add_library(${name} SHARED IMPORTED GLOBAL)
+  set_target_properties(${name} PROPERTIES IMPORTED_LOCATION "${_library}")
+  add_dependencies(${name} ${name}-nvhpc-gpu)
+  add_dependencies(check ${name}-nvhpc-gpu)
+endfunction(_mfront_generic_parallel_nvhpc_gpu_check_library)
+
+# Library of behaviours and models generated by the `generic-parallel`
+# interface with the `stlpar` backend for an NVIDIA GPU (`nvc++`).
+#
+# usage: mfront_generic_parallel_nvhpc_gpu_behaviours_check_library(name
+#                                                         behaviours...)
+function(mfront_generic_parallel_nvhpc_gpu_behaviours_check_library name)
+  _mfront_generic_parallel_nvhpc_gpu_check_library(${name} behaviours
+    ${ARGN})
+endfunction(mfront_generic_parallel_nvhpc_gpu_behaviours_check_library)
+
+# Library of material properties generated by the `generic-parallel`
+# interface with the `stlpar` backend for an NVIDIA GPU (`nvc++`).
+#
+# usage: mfront_generic_parallel_nvhpc_gpu_material_properties_check_library(
+#                                                    name properties...)
+function(mfront_generic_parallel_nvhpc_gpu_material_properties_check_library
+         name)
+  _mfront_generic_parallel_nvhpc_gpu_check_library(${name}
+    material-properties ${ARGN})
+endfunction(
+  mfront_generic_parallel_nvhpc_gpu_material_properties_check_library)
