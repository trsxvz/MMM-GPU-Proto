  * \param[out] K: tangent operator
  * \param[in]  d: behaviour data
  */
@@ -222,6 +223,12 @@ mgis_bv_material_data_manager_get_tangent_operator_stride(
 MGIS_C_EXPORT mgis_status
 mgis_bv_material_data_manager_get_number_of_tangent_operator_blocks(
     mgis_size_type* const, mgis_bv_MaterialDataManager* const);
+/*!
+ * \param[out] l: a pointer where the layout of the arrays will be written
+ * \param[in]  d: material data manager
+ */
+MGIS_C_EXPORT mgis_status mgis_bv_material_data_manager_get_layout(
+    mgis_bv_FieldLayout* const, mgis_bv_MaterialDataManager* const);
 /*!
  * \brief update the material data manager
  * \param[in,out] d: data manager
diff --git a/bindings/c/src/MaterialDataManager.cxx b/bindings/c/src/MaterialDataManager.cxx
index 1409399..cebb570 100644
--- a/bindings/c/src/MaterialDataManager.cxx
+++ b/bindings/c/src/MaterialDataManager.cxx
@@ -376,6 +376,19 @@ mgis_status mgis_bv_material_data_manager_get_number_of_tangent_operator_blocks(
   return mgis_report_success();
 }  // end of mgis_bv_material_data_manager_get_number_of_tangent_operator_blocks
 
+mgis_status mgis_bv_material_data_manager_get_layout(
+    mgis_bv_FieldLayout* const l, mgis_bv_MaterialDataManager* const d) {
+  if (d == nullptr) {
+    *l = MGIS_BV_POINT_BY_POINT;
+    return mgis_report_failure(
+        "invalid argument (material data manager is null)");
+  }
+  *l = d->layout == mgis::FieldLayout::POINT_BY_POINT
+           ? MGIS_BV_POINT_BY_POINT
+           : MGIS_BV_COMPONENT_BY_COMPONENT;
+  return mgis_report_success();
+}  // end of mgis_bv_material_data_manager_get_layout
+
 mgis_status mgis_bv_update_material_data_manager(
     mgis_bv_MaterialDataManager* const d) {
   if (d == nullptr) {
