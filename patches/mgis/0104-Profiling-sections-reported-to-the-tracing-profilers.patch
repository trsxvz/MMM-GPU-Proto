 #include <atomic>
@@ -32,14 +33,55 @@ namespace mgis {
     return getSynchronization().load();
   }  // end of getProfilingSynchronization
 
+  //! \brief function reporting the beginning of a section
+  using BeginMarker = void (*)(const char*) noexcept;
+  //! \brief function reporting the end of a section
+  using EndMarker = void (*)() noexcept;
+
+  //! \return the `begin` function set by `setProfilingMarkers`
+  static std::atomic<BeginMarker>& getBeginMarker() noexcept {
+    static std::atomic<BeginMarker> f{nullptr};
+    return f;
+  }  // end of getBeginMarker
+
+  //! \return the `end` function set by `setProfilingMarkers`
+  static std::atomic<EndMarker>& getEndMarker() noexcept {
+    static std::atomic<EndMarker> f{nullptr};
+    return f;
+  }  // end of getEndMarker
+
+  /*!
+   * \brief reports the beginning of a section or of a range, if a function
+   * is set by `setProfilingMarkers`
+   * \param[in] n: name
+   * \return the function reporting the end, null if the beginning is not
+   * reported
+   */
+  static EndMarker beginMarker(const char* const n) noexcept {
+    if (const auto b = getBeginMarker().load(); b != nullptr) {
+      b(n);
+      return getEndMarker().load();
+    }
+    return nullptr;
+  }  // end of beginMarker
+
+  ProfilingMarkers setProfilingMarkers(const ProfilingMarkers& m) noexcept {
+    return {getBeginMarker().exchange(m.begin), getEndMarker().exchange(m.end)};
+  }  // end of setProfilingMarkers
+
+  ProfilingMarkers getProfilingMarkers() noexcept {
+    return {getBeginMarker().load(), getEndMarker().load()};
+  }  // end of getProfilingMarkers
+
   ProfilingSection::ProfilingSection(Context& c,
                                      std::string n,
                                      bool enabled) MGIS_NOEXCEPT
       : ctx_ptr(&c),
         active(enabled) {
     if (this->active && this->ctx_ptr != nullptr) {
-      this->ctx_ptr->pushProfilingNode(std::move(n));
       synchronize();
+      this->end_marker = beginMarker(n.c_str());
+      this->ctx_ptr->pushProfilingNode(std::move(n));
       this->start = std::chrono::high_resolution_clock::now();
     }
   }  // end of ProfilingSection
@@ -51,7 +93,33 @@ namespace mgis {
       const std::chrono::duration<double> dt = end - this->start;
 
       this->ctx_ptr->popProfilingNode(dt.count());
+      if (this->end_marker != nullptr) {
+        this->end_marker();
+      }
     }
   }  // end of ~ProfilingSection
 
+  ProfilingRange::ProfilingRange(const Context& ctx,
+                                 const char* const n) noexcept {
+    if (ProfilingRange::isReported(ctx)) {
+      this->begin(n);
+    }
+  }  // end of ProfilingRange
+
+  bool ProfilingRange::isReported(const Context& ctx) noexcept {
+    return ctx.isProfilingEnabled() && (getBeginMarker().load() != nullptr);
+  }  // end of isReported
+
+  void ProfilingRange::begin(const char* const n) noexcept {
+    synchronize();
+    this->end_marker = beginMarker(n);
+  }  // end of begin
+
+  ProfilingRange::~ProfilingRange() noexcept {
+    if (this->end_marker != nullptr) {
+      synchronize();
+      this->end_marker();
+    }
+  }  // end of ~ProfilingRange
+
 }  // end of namespace mgis
