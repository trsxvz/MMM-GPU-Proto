@@ -67,6 +71,158 @@ struct ProfilingTest final : public tfel::tests::TestCase {
     TFEL_TESTS_ASSERT(mgis::getProfilingSynchronization() == nullptr);
   }
 
+  //! \brief calls of the functions of the markers and of the
+  //! synchronization, in order
+  static inline std::vector<std::string> events;
+  //! \brief marker recording the beginning of a section
+  static void recordBeginning(const char* const n) noexcept {
+    events.push_back(std::string{"begin "} + n);
+  }
+  //! \brief marker recording the end of a section
+  static void recordEnd() noexcept { events.push_back("end"); }
+  //! \brief other marker recording the end of a section
+  static void recordOtherEnd() noexcept { events.push_back("other end"); }
+  //! \brief synchronization function recording its calls
+  static void recordSynchronization() noexcept { events.push_back("sync"); }
+  //! \brief compares the recorded calls to the expected ones
+  void checkEvents(const std::vector<std::string>& expected) {
+    TFEL_TESTS_CHECK_EQUAL(events.size(), expected.size());
+    if (events.size() == expected.size()) {
+      for (std::size_t i = 0; i != events.size(); ++i) {
+        TFEL_TESTS_CHECK_EQUAL(events[i], expected[i]);
+      }
+    }
+    events.clear();
+  }
+
+  void testMarkers() {
+    const auto markers = mgis::ProfilingMarkers{&recordBeginning, &recordEnd};
+    // no marker by default
+    TFEL_TESTS_ASSERT(mgis::getProfilingMarkers().begin == nullptr);
+    TFEL_TESTS_ASSERT(mgis::getProfilingMarkers().end == nullptr);
+    auto previous = mgis::setProfilingMarkers(markers);
+    TFEL_TESTS_ASSERT(previous.begin == nullptr);
+    TFEL_TESTS_ASSERT(previous.end == nullptr);
+    TFEL_TESTS_ASSERT(mgis::getProfilingMarkers().begin == &recordBeginning);
+    TFEL_TESTS_ASSERT(mgis::getProfilingMarkers().end == &recordEnd);
+    events.clear();
+    mgis::Context ctx;
+    ctx.enableProfiling(true);
+    // each active section is reported with its name, at each call
+    {
+      CatchTimeSection(ctx, "Parent");
+      for (int i = 0; i != 2; ++i) {
+        CatchTimeSection(ctx, "Child");
+      }
+      auto s = ctx.startNewProfiling("Other child", true);
+    }
+    this->checkEvents({"begin Parent", "begin Child", "end", "begin Child",
+                       "end", "begin Other child", "end", "end"});
+    // the profiling tree is the one built without markers
+    const auto& root = ctx.getProfilingResultTree();
+    TFEL_TESTS_ASSERT(root.children.size() == 1);
+    if (root.children.size() == 1) {
+      const auto& parent = root.children[0];
+      TFEL_TESTS_CHECK_EQUAL(parent->name, "Parent");
+      TFEL_TESTS_CHECK_EQUAL(parent->calls, 1u);
+      TFEL_TESTS_ASSERT(parent->children.size() == 2);
+      if (parent->children.size() == 2) {
+        TFEL_TESTS_CHECK_EQUAL(parent->children[0]->name, "Child");
+        TFEL_TESTS_CHECK_EQUAL(parent->children[0]->calls, 2u);
+        TFEL_TESTS_CHECK_EQUAL(parent->children[1]->name, "Other child");
+      }
+    }
+    // an inactive section is not reported, a section forced locally is
+    ctx.enableProfiling(false);
+    { CatchTimeSection(ctx, "Inactive"); }
+    this->checkEvents({});
+    { CatchLocalTimeSection(ctx, "Forced", true); }
+    this->checkEvents({"begin Forced", "end"});
+    ctx.enableProfiling(true);
+    // the range reported is the interval measured by the timer: it begins
+    // after the first synchronization and ends after the second one
+    mgis::setProfilingSynchronization(&recordSynchronization);
+    { CatchTimeSection(ctx, "Synchronized"); }
+    this->checkEvents({"sync", "begin Synchronized", "sync", "end"});
+    mgis::setProfilingSynchronization(nullptr);
+    // a section which began before the markers were set is not reported,
+    // a section reported at its beginning is reported at its end by the
+    // function set at its beginning
+    mgis::setProfilingMarkers({});
+    {
+      CatchTimeSection(ctx, "Before");
+      mgis::setProfilingMarkers(markers);
+      {
+        CatchTimeSection(ctx, "After");
+        previous =
+            mgis::setProfilingMarkers({&recordBeginning, &recordOtherEnd});
+        TFEL_TESTS_ASSERT(previous.begin == &recordBeginning);
+        TFEL_TESTS_ASSERT(previous.end == &recordEnd);
+        { CatchTimeSection(ctx, "Other"); }
+        mgis::setProfilingMarkers({});
+        { CatchTimeSection(ctx, "Unreported"); }
+      }
+    }
+    this->checkEvents({"begin After", "begin Other", "other end", "end"});
+    TFEL_TESTS_ASSERT(mgis::getProfilingMarkers().begin == nullptr);
+    TFEL_TESTS_ASSERT(mgis::getProfilingMarkers().end == nullptr);
+  }
+
+  void testRanges() {
+    auto generated = 0;
+    const auto name = [&generated] {
+      ++generated;
+      return std::string{"Step "} + std::to_string(generated);
+    };
+    events.clear();
+    mgis::Context ctx;
+    ctx.enableProfiling(true);
+    // without markers, a range does nothing: its name is not built
+    {
+      mgis::ProfilingRange r1(ctx, "Range");
+      mgis::ProfilingRange r2(ctx, name);
+    }
+    this->checkEvents({});
+    TFEL_TESTS_CHECK_EQUAL(generated, 0);
+    mgis::setProfilingMarkers({&recordBeginning, &recordEnd});
+    // nor does it if the profiling is disabled
+    ctx.enableProfiling(false);
+    {
+      mgis::ProfilingRange r1(ctx, "Range");
+      mgis::ProfilingRange r2(ctx, name);
+    }
+    this->checkEvents({});
+    TFEL_TESTS_CHECK_EQUAL(generated, 0);
+    ctx.enableProfiling(true);
+    // ranges and sections reported in order
+    for (int i = 0; i != 2; ++i) {
+      mgis::ProfilingRange r(ctx, name);
+      CatchTimeSection(ctx, "Section");
+      mgis::ProfilingRange r2(ctx, "Range");
+    }
+    this->checkEvents({"begin Step 1", "begin Section", "begin Range", "end",
+                       "end", "end", "begin Step 2", "begin Section",
+                       "begin Range", "end", "end", "end"});
+    TFEL_TESTS_CHECK_EQUAL(generated, 2);
+    // the ranges are not added to the profiling tree
+    const auto& root = ctx.getProfilingResultTree();
+    TFEL_TESTS_ASSERT(root.children.size() == 1);
+    if (root.children.size() == 1) {
+      TFEL_TESTS_CHECK_EQUAL(root.children[0]->name, "Section");
+      TFEL_TESTS_CHECK_EQUAL(root.children[0]->calls, 2u);
+      TFEL_TESTS_ASSERT(root.children[0]->children.empty());
+    }
+    // a reported range waits for the asynchronous computations at its
+    // beginning and at its end, an unreported one does not
+    mgis::setProfilingSynchronization(&recordSynchronization);
+    { mgis::ProfilingRange r(ctx, "Synchronized"); }
+    this->checkEvents({"sync", "begin Synchronized", "sync", "end"});
+    mgis::setProfilingMarkers({});
+    { mgis::ProfilingRange r(ctx, "Unreported"); }
+    this->checkEvents({});
+    mgis::setProfilingSynchronization(nullptr);
+  }
