   //! \return the function set by `setProfilingSynchronization`
   MGIS_EXPORT ProfilingSynchronization getProfilingSynchronization() noexcept;
 
+  /*!
+   * \brief functions reporting the active profiling sections to an external
+   * tool, for instance to a tracing profiler which shows them as named
+   * ranges (NVTX, roctx, ...)
+   */
+  struct ProfilingMarkers {
+    /*!
+     * \brief function called at the beginning of each active profiling
+     * section, with its name (which shall not be kept after the call)
+     */
+    void (*begin)(const char*) noexcept = nullptr;
+    //! \brief function called at the end of each section given to `begin`
+    void (*end)() noexcept = nullptr;
+  };
+
+  /*!
+   * \brief sets the functions called at the beginning and at the end of each
+   * active profiling section, after the synchronization (see
+   * `setProfilingSynchronization`): the range reported for a section is the
+   * interval measured by its timer. The sections must be properly nested,
+   * which the `CatchTimeSection` macros guarantee. A section which began
+   * before the call is not reported, and a section reported at its beginning
+   * is reported at its end by the function set when it began. The functions
+   * are shared by all the contexts of the process.
+   * \param[in] m: functions, null by default (no report)
+   * \return the previous functions
+   */
+  MGIS_EXPORT ProfilingMarkers
+  setProfilingMarkers(const ProfilingMarkers&) noexcept;
+  //! \return the functions set by `setProfilingMarkers`
+  MGIS_EXPORT ProfilingMarkers getProfilingMarkers() noexcept;
+
   /*!
    * \brief a profiling section, which measures the time spent in its scope
    * and updates the profiling tree of an execution context (see the
@@ -79,6 +113,65 @@ namespace mgis {
     Context* ctx_ptr;
     bool active;
     std::chrono::high_resolution_clock::time_point start;
+    //! \brief function reporting the end of the section, if its beginning
+    //! has been reported (see `ProfilingMarkers`)
+    void (*end_marker)() noexcept = nullptr;
+  };
+
+  /*!
+   * \brief a range only reported by the functions set by
+   * `setProfilingMarkers`: unlike a profiling section, it is neither timed
+   * nor added to the profiling tree of the context, which it leaves
+   * unchanged. Its name may thus change at each call (a time step, an
+   * iteration, ...). As for a section, the computations launched
+   * asynchronously are waited for at the beginning and at the end of a
+   * reported range (see `setProfilingSynchronization`). The range does
+   * nothing if no function is set or if the profiling of the context is
+   * disabled. The ranges and the profiling sections must be properly
+   * nested.
+   */
+  struct MGIS_EXPORT ProfilingRange {
+    /*!
+     * \param[in] ctx: execution context
+     * \param[in] n: name of the range
+     */
+    ProfilingRange(const Context&, const char* const) noexcept;
+    /*!
+     * \param[in] ctx: execution context
+     * \param[in] g: function returning the name of the range, only called
+     * if the range is reported
+     */
+    template <std::invocable NameGenerator>
+    ProfilingRange(const Context& ctx, NameGenerator&& g) {
+      if (ProfilingRange::isReported(ctx)) {
+        const std::string n = g();
+        this->begin(n.c_str());
+      }
+    }  // end of ProfilingRange
+
+    ~ProfilingRange() noexcept;
+
+    ProfilingRange(const ProfilingRange&) = delete;
+    ProfilingRange& operator=(const ProfilingRange&) = delete;
+
+    ProfilingRange(ProfilingRange&&) = delete;
+    ProfilingRange& operator=(ProfilingRange&&) = delete;
+
+   private:
+    /*!
+     * \return true if the ranges are reported: the profiling of the context
+     * is enabled and a function is set by `setProfilingMarkers`
+     * \param[in] ctx: execution context
+     */
+    [[nodiscard]] static bool isReported(const Context&) noexcept;
+    /*!
+     * \brief reports the beginning of the range
+     * \param[in] n: name of the range
+     */
+    void begin(const char* const) noexcept;
+    //! \brief function reporting the end of the range, if its beginning has
+    //! been reported
+    void (*end_marker)() noexcept = nullptr;
   };
 
 }  // end of namespace mgis
