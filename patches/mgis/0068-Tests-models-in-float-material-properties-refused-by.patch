     add_executable(MaterialDataManagerLayoutTest EXCLUDE_FROM_ALL
@@ -319,7 +311,7 @@ if(MGIS_HAVE_MFRONT_SUPPORT)
         OrthotropicElasticity
         InitializeFunctionTest
