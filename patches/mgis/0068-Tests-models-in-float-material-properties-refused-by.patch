From 68d907989e896f09e8a42a10e469a38760d4ec67 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 21:40:30 +0200
Subject: [PATCH] Tests: models in float, material properties refused by
 RealTypeTest

- the models of the tests (ode_rk54, RungeKuttaModelDSL) are generated with
  the float numerical type: only the models of the Model DSL are refused.
  Their tests run in float again; IntegrateTest4 and IntegrateTest5 read
  the parameters as double (interface of the parameters) and use the
  tolerance of Tolerance.hxx.
- RealTypeTest also checks that a material property generated with the
  other numerical type is refused at loading.
Double: 51/51, float: 49/49.
---
 tests/CMakeLists.txt                   | 56 ++++++++++----------------
 tests/GenericParallelCUDATest.cxx      | 10 ++---
 tests/GenericParallelIntegrateTest.cxx | 10 ++---
 tests/IntegrateTest4.cxx               |  6 ++-
 tests/IntegrateTest5.cxx               |  6 ++-
 tests/MaterialDataViewTest.cxx         | 12 ++----
 tests/RealTypeTest.cxx                 | 33 +++++++++++++--
 7 files changed, 69 insertions(+), 64 deletions(-)

diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 6af311a..857f6d9 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -137,20 +137,7 @@ if(MGIS_HAVE_MFRONT_SUPPORT)
     ComputeSpeedOfSound
     EnergyTest)
 
-  # the models are only generated with the double numerical type (real_type
-  # option of mfront): with another type, the tests of the models are not
-  # built, and the tests taking the library of the models as an optional
-  # argument skip them
-  if(MGIS_REAL_TYPE STREQUAL "double")
-    mfront_behaviours_check_library(ModelTest ode_rk54)
-    set(MGIS_TEST_MODELS ode_rk54)
-    set(MGIS_TEST_MODELS_LIBRARY "$<TARGET_FILE:ModelTest>")
-    set(MGIS_TEST_MODELS_TARGET ModelTest)
-  else()
-    set(MGIS_TEST_MODELS)
-    set(MGIS_TEST_MODELS_LIBRARY)
-    set(MGIS_TEST_MODELS_TARGET)
-  endif()
+  mfront_behaviours_check_library(ModelTest ode_rk54)
 
   # behaviour generated with the other numerical type than MGIS (real_type
   # option of mfront), which must be refused at loading
@@ -164,15 +151,20 @@ if(MGIS_HAVE_MFRONT_SUPPORT)
