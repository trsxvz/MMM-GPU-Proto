   add_library_test(IntegrateTest2b IntegrateTest2b.cxx BehaviourTest)
   add_library_test(IntegrateTest3 IntegrateTest3.cxx BehaviourTest)
   add_library_test(IntegrateTest3b IntegrateTest3b.cxx BehaviourTest)
