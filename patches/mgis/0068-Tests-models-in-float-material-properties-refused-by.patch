-        ${MGIS_TEST_MODELS})
+        ode_rk54)
       mfront_generic_parallel_material_properties_check_library(
         GenericParallelMaterialPropertyTestCUDA cuda
         Inconel600_YoungModulus
@@ -335,12 +327,11 @@ if(MGIS_HAVE_MFRONT_SUPPORT)
         "$<TARGET_FILE:BehaviourTest>"
         "$<TARGET_FILE:GenericParallelMaterialPropertyTestCUDA>"
         "$<TARGET_FILE:MaterialPropertyTest>"
-        ${MGIS_TEST_MODELS_LIBRARY})
+        "$<TARGET_FILE:ModelTest>")
       add_dependencies(build-tests GenericParallelCUDATest)
       set_property(TEST GenericParallelCUDATest
         PROPERTY DEPENDS GenericParallelBehaviourTestCUDA BehaviourTest
-        GenericParallelMaterialPropertyTestCUDA MaterialPropertyTest
-        ${MGIS_TEST_MODELS_TARGET})
