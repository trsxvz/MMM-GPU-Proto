From ef3ac699426cff34dde8b40f1467ad38deb85349 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 01:27:38 +0200
Subject: [PATCH] Conversions of function views: temporary views, constness
 documented

---
 include/MGIS/Function/FieldViewSupport.hxx | 20 ++++++++++++++++++++
 tests/MaterialDataManagerLayoutTest.cxx    |  9 +++++++++
 2 files changed, 29 insertions(+)

diff --git a/include/MGIS/Function/FieldViewSupport.hxx b/include/MGIS/Function/FieldViewSupport.hxx
index 716cc6f..8867c67 100644
--- a/include/MGIS/Function/FieldViewSupport.hxx
+++ b/include/MGIS/Function/FieldViewSupport.hxx
@@ -26,6 +26,13 @@ namespace mgis::function {
    * per component (`CoalescedMemoryAccessFunctionViewBase`) have no
    * equivalent: a `FieldView` holds one pointer, as the fields of the
    * functions generated by `MFront` for batches of points.
+   *
+   * The conversions follow the constness of the views of `mgis::function`:
+   * a constant `FunctionView` gives constant values (its `data` member is
+   * deeply constant), whereas a view with a strided coalesced memory access
+   * gives the values of its mutability (its `data` member is shallowly
+   * constant). A temporary `FunctionView` gives the values of its
+   * mutability.
    */
 
   /*!
@@ -43,6 +50,19 @@ namespace mgis::function {
                                 f.getDataStride(), 1);
   }  // end of makeFieldView
 
+  /*!
+   * \return a view on the values of a temporary function view stored point
+   * by point (see the previous overload)
+   * \param[in] f: function view
+   */
+  template <LinearFunctionalSpaceConcept Space,
+            FunctionDataLayoutDescription layout,
+            bool is_mutable>
+  FieldView<std::conditional_t<is_mutable, real, const real>> makeFieldView(
+      FunctionView<Space, layout, is_mutable>&& f) {
+    return makeFieldView(f);
+  }  // end of makeFieldView
+
   /*!
    * \return a constant view on the values of a function stored point by
    * point
diff --git a/tests/MaterialDataManagerLayoutTest.cxx b/tests/MaterialDataManagerLayoutTest.cxx
index 5c535fd..e945d98 100644
--- a/tests/MaterialDataManagerLayoutTest.cxx
+++ b/tests/MaterialDataManagerLayoutTest.cxx
@@ -20,6 +20,8 @@
 #include <cmath>
 #include <span>
 #include <array>
+#include <utility>
+#include <type_traits>
 #include <variant>
 #include <algorithm>
 #include <string>
@@ -420,6 +422,13 @@ static void testMaterialFunctionManager(const std::string& library) {
   if (check(ga.has_value(), "material function manager: no view")) {
     check(mgis::function::makeFieldView(*ga).getPointStride() == 6,
           "material function manager: invalid conversion to a field view");
+    // a temporary function view gives the values of its mutability
+    auto copy = *ga;
+    auto fv = mgis::function::makeFieldView(std::move(copy));
+    static_assert(std::is_same_v<decltype(fv), FieldView<real>>);
+    check(fv.data() == getGradientsView(ma.s1).data(),
+          "material function manager: invalid conversion of a temporary "
+          "function view");
   }
 }  // end of testMaterialFunctionManager
 
