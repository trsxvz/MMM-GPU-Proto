From 4a1b4c534f93a08d1898347c3505e956ff118736 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 17:29:50 +0200
Subject: [PATCH] updateInputValues checks the layouts, error messages fixed

- updateInputValues copies the inputs of the states in their layout, as
  updateValues, but did not check that both states have the same layout:
  it now refuses states of different layouts, as updateValues
  (MaterialDataManagerLayoutTest checks it).
- Error messages: "a uniform" instead of "an uniform", messages of the views
  naming make_view and make_unchecked_view, which share them, double space
  and "do not hold" in the checks of the states, stress measure and sizes of
  the arrays in the finite strain conversions (which reported an
  unsupported tangent operator).
---
 include/MGIS/Behaviour/MaterialStateManager.hxx |  4 ++--
 src/Behaviour.cxx                               |  2 +-
 src/FiniteStrainSupport.cxx                     | 13 +++++++------
 src/MaterialDataView.cxx                        | 13 +++++++++----
 src/MaterialProperty.cxx                        |  2 +-
 src/MaterialStateManager.cxx                    | 12 ++++++++++--
 tests/MaterialDataManagerLayoutTest.cxx         |  4 ++++
 7 files changed, 34 insertions(+), 16 deletions(-)

diff --git a/include/MGIS/Behaviour/MaterialStateManager.hxx b/include/MGIS/Behaviour/MaterialStateManager.hxx
index ad27033..478610c 100644
--- a/include/MGIS/Behaviour/MaterialStateManager.hxx
+++ b/include/MGIS/Behaviour/MaterialStateManager.hxx
@@ -660,8 +660,8 @@ namespace mgis::behaviour {
    * the states (gradients, thermodynamic forces, internal state variables,
    * energies). The calling code copies these arrays, for instance on their
    * copies on a device (see `update(const MaterialDataView&,
-   * FieldOperations&)`). The states must have the same layout, which is not
-   * checked.
+   * FieldOperations&)`). The states must have the same layout, as with
+   * `updateValues`.
    * \return true on success
    * \param[in, out] ctx: execution context
    * \param[out] o: output state
diff --git a/src/Behaviour.cxx b/src/Behaviour.cxx
index 87f3485..6a5e153 100644
--- a/src/Behaviour.cxx
+++ b/src/Behaviour.cxx
@@ -700,7 +700,7 @@ namespace mgis::behaviour {
                   ": invalid number of points of the rotation matrices (" +
                   std::to_string(r.getNumberOfPoints()) + " given, " +
                   std::to_string(n) +
-                  " expected, an uniform rotation being described by a view "
+                  " expected, a uniform rotation being described by a view "
                   "with a null point stride)");
     }
     if (r.getNumberOfComponents() != 9) {
diff --git a/src/FiniteStrainSupport.cxx b/src/FiniteStrainSupport.cxx
index 7f4aeec..3ddda08 100644
--- a/src/FiniteStrainSupport.cxx
+++ b/src/FiniteStrainSupport.cxx
@@ -263,7 +263,7 @@ namespace mgis::behaviour {
     if (t != FiniteStrainStress::PK1) {
       mgis::raise(
           "convertFiniteStrainStress: "
-          "unsupported tangent operator");
+          "unsupported stress measure");
     }
     const auto h = b.hypothesis;
     if ((h != Hypothesis::TRIDIMENSIONAL) &&
@@ -281,9 +281,9 @@ namespace mgis::behaviour {
                                  const FiniteStrainStress t) {
     const auto ts = getTensorSize(m.b.hypothesis);
     if (s.size() != m.n * ts) {
-      mgis::raise(
-          "convertFiniteStrainStress: "
-          "unsupported tangent operator");
+      mgis::raise("convertFiniteStrainStress: invalid size of the array (" +
+                  std::to_string(s.size()) + " values given, " +
+                  std::to_string(m.n * ts) + " expected)");
     }
     convertFiniteStrainStress(makeFieldView(s, m.layout, m.n, ts), m, t);
   }  // end of convertFiniteStrainStress
@@ -923,8 +923,9 @@ namespace mgis::behaviour {
     const auto ts = getTensorSize(m.b.hypothesis);
     if (K.size() != m.n * ts * ts) {
       mgis::raise(
-          "convertFiniteStrainTangentOperator: "
-          "unsupported tangent operator");
+          "convertFiniteStrainTangentOperator: invalid size of the array (" +
+          std::to_string(K.size()) + " values given, " +
+          std::to_string(m.n * ts * ts) + " expected)");
     }
     convertFiniteStrainTangentOperator(makeFieldView(K, m.layout, m.n, ts * ts),
                                        m, t);
diff --git a/src/MaterialDataView.cxx b/src/MaterialDataView.cxx
index f310a14..8bbad65 100644
--- a/src/MaterialDataView.cxx
+++ b/src/MaterialDataView.cxx
@@ -203,8 +203,9 @@ namespace mgis::behaviour {
         return makeUniformFieldView(values, m.n);
       }
       if (values.size() != m.n * s) {
-        mgis::raise("make_view: invalid number of values for '" + v.name +
-                    "' (" + std::to_string(values.size()) + " given)");
+        mgis::raise(
+            "make_view, make_unchecked_view: invalid number of values for '" +
+            v.name + "' (" + std::to_string(values.size()) + " given)");
       }
       return makeFieldView(values, m.layout, m.n, s);
     };
@@ -224,7 +225,9 @@ namespace mgis::behaviour {
     }
     if (std::holds_alternative<real>(mfh.value)) {
       if (s != 1) {
-        mgis::raise("make_view: invalid uniform value for '" + v.name + "'");
+        mgis::raise(
+            "make_view, make_unchecked_view: invalid uniform value for '" +
+            v.name + "'");
       }
       return makeUniformFieldView(
           std::span<const real>(&std::get<real>(mfh.value), 1), m.n);
@@ -283,7 +286,9 @@ namespace mgis::behaviour {
         return makeUniformFieldView(values, m.n);
       }
       if (values.size() != m.n) {
-        mgis::raise("make_view: invalid number of values for the mass density");
+        mgis::raise(
+            "make_view, make_unchecked_view: invalid number of values for the "
+            "mass density");
       }
       return makeFieldView(values, FieldLayout::POINT_BY_POINT, m.n, 1);
     };
diff --git a/src/MaterialProperty.cxx b/src/MaterialProperty.cxx
index a597b0a..d73d744 100644
--- a/src/MaterialProperty.cxx
+++ b/src/MaterialProperty.cxx
@@ -211,7 +211,7 @@ namespace mgis::material_property {
                     mp.material_property + "' (" +
                     std::to_string(inputs[i].getNumberOfPoints()) + " given, " +
                     std::to_string(n) +
-                    " expected, an uniform input being described by a view "
+                    " expected, a uniform input being described by a view "
                     "with a null point stride)");
       }
     }
diff --git a/src/MaterialStateManager.cxx b/src/MaterialStateManager.cxx
index 511047d..547266a 100644
--- a/src/MaterialStateManager.cxx
+++ b/src/MaterialStateManager.cxx
@@ -831,14 +831,14 @@ namespace mgis::behaviour {
           return ctx.registerErrorMessage(
               "material property '" + mp.first +
               "' defined in the material state manager is not defined "
-              " by the behaviour");
+              "by the behaviour");
         }
       }
       return true;
     };
     if (&i.b != &o.b) {
       return ctx.registerErrorMessage(
-          "the material state managers do not holds the same behaviour");
+          "the material state managers do not hold the same behaviour");
     }
     return check_mps(o.b, i.material_properties) &&
            check_mps(o.b, o.material_properties);
@@ -975,6 +975,14 @@ namespace mgis::behaviour {
                          MaterialStateManager& o,
                          const MaterialStateManager& i,
                          FieldOperations& ops) noexcept {
+    // the inputs of the states (material properties, external state
+    // variables) are copied in the layout of the states, as by
+    // `updateValues`
+    if (o.layout != i.layout) {
+      return ctx.registerErrorMessage(
+          "updateInputValues: the arrays of the material state managers "
+          "have different layouts");
+    }
     if (!checkStates(ctx, o, i)) {
       return false;
     }
diff --git a/tests/MaterialDataManagerLayoutTest.cxx b/tests/MaterialDataManagerLayoutTest.cxx
index f0ced43..404df00 100644
--- a/tests/MaterialDataManagerLayoutTest.cxx
+++ b/tests/MaterialDataManagerLayoutTest.cxx
@@ -379,6 +379,10 @@ static void testExternalStateVariables(const std::string& library) {
   auto ctx = mgis::Context{};
   check(!updateValues(ctx, ma->s0, mc->s1),
         "external state variables: layouts not checked by updateValues");
+  auto ops = mgis::HostFieldOperations{};
+  check(!updateInputValues(ctx, ma->s0, mc->s1, ops),
+        "external state variables: layouts not checked by "
+        "updateInputValues");
 }  // end of testExternalStateVariables
 
 //! \brief true if a view can be built on the values of an object
