From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 01:05:35 +0200
Subject: [PATCH] Tests of the rotations and evaluations on views: other cases

- rotations of the thermodynamic forces in plane strain, rotation
  matrices given by views in plane strain.
- refusals of the rotations of the thermodynamic forces and of the
  tangent operator blocks, with and without policies.
- evaluations on views of material properties without bounds and with
  results which are not finite, in shared memory, and without point with
  the policies.
---
 tests/GenericParallelEvaluateTest.cxx  | 63 ++++++++++++++++++++++++++
 tests/GenericParallelIntegrateTest.cxx | 55 ++++++++++++++++++++++
 2 files changed, 118 insertions(+)

diff --git a/tests/GenericParallelEvaluateTest.cxx b/tests/GenericParallelEvaluateTest.cxx
index 81fac40..98d0e56 100644
--- a/tests/GenericParallelEvaluateTest.cxx
+++ b/tests/GenericParallelEvaluateTest.cxx
@@ -444,6 +444,68 @@ static void testEvaluationsOnViews(const std::string& library,
   }
 }  // end of testEvaluationsOnViews
 
+/*!
+ * \brief evaluations on views of the other material properties (values
+ * without bounds, results which are not finite), shared memory, and sets
+ * without point with the execution policies
+ */
+static void testOtherEvaluationsOnViews(const std::string& library,
+                                        const std::string& gp_library) {
+  using namespace mgis::material_property;
+  constexpr auto n = mgis::size_type{4};
+  // the result of MaterialPropertyInvalidResult is not finite at the second
+  // and fourth points
+  const auto T = std::array<mgis::real, n>{250, 300, 350, 300};
+  auto T3 = std::vector<mgis::real>(3 * n, 0);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    T3[3 * i] = T[i];
+  }
+  const auto inputs = std::array{std::span<const mgis::real>(T)};
+  const auto views = std::array{mgis::makePointByPointFieldView(
+      std::span<const mgis::real>(T3), n, 1, 3)};
+  const auto same_result = [](const MaterialPropertyEvaluationResult& a,
+                              const MaterialPropertyEvaluationResult& b) {
+    return (a.status == b.status) && (a.bounds_status == b.bounds_status) &&
+           (a.n == b.n) && (a.error_message == b.error_message);
+  };
+  for (const auto& l : {library, gp_library}) {
+    for (const auto* const name :
+         {"Inconel600_YoungModulus", "MaterialPropertyInvalidResult"}) {
+      const auto mp = load(l, name);
+      const auto gp = isGenericParallelMaterialProperty(mp);
+      const auto msg = std::string{name} + (gp ? ", generic-parallel" : "") +
+                       ", evaluation on views: ";
+      auto E = std::vector<mgis::real>(n);
+      const auto r = evaluate(E, mp, inputs);
+      auto E2 = std::vector<mgis::real>(2 * n, -1);
+      const auto v = mgis::makePointByPointFieldView(std::span(E2), n, 1, 2);
+      const auto rv = evaluate(v, mp, views, MemoryLocation::SHARED);
+      check(same_result(r, rv), msg + "invalid result");
+      for (mgis::size_type i = 0; i != n; ++i) {
+        if ((r.status >= 0) || (i < r.n)) {
+          check(std::bit_cast<std::uint64_t>(E[i]) ==
+                    std::bit_cast<std::uint64_t>(E2[2 * i]),
+                msg + "invalid values");
+        }
+      }
+      if (!gp) {
+        continue;
+      }
+      // sets without point
+      const auto no_input = std::array{mgis::FieldView<const mgis::real>{}};
+      check(evaluate(BatchExecutionPolicy{}, mgis::FieldView<mgis::real>{}, mp,
+                     no_input)
+                    .status == 0,
+            msg + "invalid status without point (synchronous policy)");
+      check(evaluate(AsynchronousBatchExecutionPolicy{},
+                     mgis::FieldView<mgis::real>{}, mp, no_input)
+                    .getResult()
+                    .status == 0,
+            msg + "invalid status without point (asynchronous policy)");
+    }
+  }
+}  // end of testOtherEvaluationsOnViews
+
 int main(const int argc, const char* const* const argv) {
   if (argc != 3) {
     std::cerr << "usage: " << argv[0]
@@ -458,6 +520,7 @@ int main(const int argc, const char* const* const argv) {
     testInvalidArguments(argv[2], argv[1]);
     testAsynchronousEvaluations(argv[2], argv[1]);
     testEvaluationsOnViews(argv[2], argv[1]);
+    testOtherEvaluationsOnViews(argv[2], argv[1]);
   } catch (std::exception& e) {
     std::cerr << e.what() << '\n';
     return EXIT_FAILURE;
