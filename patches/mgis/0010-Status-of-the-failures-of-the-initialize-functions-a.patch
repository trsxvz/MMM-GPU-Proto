From 82c473f66b38b315dc656876e4b4d38a6e0841ae Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 13:25:57 +0200
Subject: [PATCH] Status of the failures of the initialize functions and
 post-processings

A failure of an initialize function or of a post-processing at an
integration point was reported by the index of the point and the error
message, but the exit status stayed equal to 1.
---
 src/Integrate.cxx | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/Integrate.cxx b/src/Integrate.cxx
index 55e1822..6313f6d 100644
--- a/src/Integrate.cxx
+++ b/src/Integrate.cxx
@@ -670,6 +670,7 @@ namespace mgis::behaviour::internals {
       v.dt = mgis::real{};
       const auto ri = (p.f)(&v, nullptr);
       if (ri != 0) {
+        r.exit_status = -1;
         r.n = i;
         v.error_message[511] = '\0';
         r.error_message = std::string(v.error_message);
@@ -709,6 +710,7 @@ namespace mgis::behaviour::internals {
       v.dt = mgis::real{};
       const auto ri = (p.f)(&v, inputs_values + inputs_stride * i);
       if (ri != 0) {
+        r.exit_status = -1;
         r.n = i;
         v.error_message[511] = '\0';
         r.error_message = std::string(v.error_message);
@@ -858,6 +860,7 @@ namespace mgis::behaviour::internals {
       v.dt = mgis::real{};
       const auto ri = (p.f)(outputs_values + outputs_stride * i, &v);
       if (ri != 0) {
+        r.exit_status = -1;
         r.n = i;
         v.error_message[511] = '\0';
         r.error_message = std::string(v.error_message);
-- 
