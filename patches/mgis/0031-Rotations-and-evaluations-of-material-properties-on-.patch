+//! \brief layouts of the values described by a view in the tests
+enum struct TestLayout {
+  //! \brief point by point, densely (as the arrays of the rotations)
+  DENSE,
+  //! \brief point by point, with a stride greater than the number of values
+  PADDED,
+  //! \brief component by component, with a stride greater than the number
+  //! of points
+  COMPONENT_BY_COMPONENT
+};
+
+//! \return the description of a layout
+static std::string getLayoutDescription(const TestLayout l) {
+  if (l == TestLayout::DENSE) {
+    return "dense";
+  } else if (l == TestLayout::PADDED) {
+    return "padded";
+  }
+  return "component by component";
+}  // end of getLayoutDescription
+
+/*!
+ * \return a view of `n` points with `nc` components in the given array,
+ * which is resized and filled with a sentinel value
+ * \param[out] a: array
+ * \param[in] l: layout
+ * \param[in] n: number of points
+ * \param[in] nc: number of components
+ */
+static mgis::FieldView<mgis::real> makeTestView(std::vector<mgis::real>& a,
+                                                const TestLayout l,
+                                                const mgis::size_type n,
+                                                const mgis::size_type nc) {
+  constexpr auto sentinel = mgis::real{-12345};
+  if (l == TestLayout::DENSE) {
+    a.assign(n * nc, sentinel);
+    return mgis::makePointByPointFieldView(std::span(a), n, nc, nc);
+  } else if (l == TestLayout::PADDED) {
+    a.assign(n * (nc + 2), sentinel);
+    return mgis::makePointByPointFieldView(std::span(a), n, nc, nc + 2);
+  }
+  a.assign((n + 3) * nc, sentinel);
+  return mgis::makeComponentByComponentFieldView(std::span(a), n, nc, n + 3);
+}  // end of makeTestView
+
+//! \return true if two values are the same, bit by bit
+static bool same(const mgis::real a, const mgis::real b) {
+  return std::bit_cast<std::uint64_t>(a) == std::bit_cast<std::uint64_t>(b);
+}  // end of same
+
+/*!
+ * \return true if the values of a view are the given ones, bit by bit, and
+ * if the values of its array outside the view have not been modified
+ * \param[in] a: array
+ * \param[in] v: view
+ * \param[in] values: values, stored point by point
+ */
+static bool checkTestView(const std::vector<mgis::real>& a,
+                          const mgis::FieldView<mgis::real>& v,
+                          const std::vector<mgis::real>& values) {
+  constexpr auto sentinel = mgis::real{-12345};
+  const auto n = v.getNumberOfPoints();
+  const auto nc = v.getNumberOfComponents();
+  for (mgis::size_type i = 0; i != n; ++i) {
+    for (mgis::size_type j = 0; j != nc; ++j) {
+      if (!same(v(i, j), values[i * nc + j])) {
+        return false;
+      }
+    }
+  }
+  const auto unchanged = std::count_if(
+      a.begin(), a.end(), [](const mgis::real x) { return same(x, sentinel); });
+  return static_cast<mgis::size_type>(unchanged) == a.size() - n * nc;
+}  // end of checkTestView
+
+/*!
+ * \brief rotations of values described by views of a behaviour: the rotated
+ * values are the ones of the rotations of arrays, bit by bit, for all the
+ * layouts of the source and of the destination, in place or not, with and
+ * without execution policy, the rotation matrices being given in all the
+ * possible ways
+ * \param[in] name: name of the test
+ * \param[in] b: behaviour
+ * \param[in] vsize: number of values of a point
+ * \param[in] rotate: function calling the rotation functions
+ * \param[in] rotations: rotations, given as a tuple of pairs of the
+ * rotation given to the overloads taking arrays and of the rotation given to
+ * the overloads taking views
+ */
+template <typename RotationFunction, typename... Rotations>
+static void testRotationOnViews(const std::string& name,
+                                const mgis::behaviour::Behaviour& b,
+                                const mgis::size_type n,
+                                const mgis::size_type vsize,
+                                const RotationFunction& rotate,
+                                const Rotations&... rotations) {
+  using namespace mgis::behaviour;
+  using mgis::FieldView;
+  using mgis::real;
+  const auto layouts = std::array{TestLayout::DENSE, TestLayout::PADDED,
+                                  TestLayout::COMPONENT_BY_COMPONENT};
+  auto v = std::vector<real>(n * vsize);
+  for (mgis::size_type i = 0; i != v.size(); ++i) {
+    v[i] = std::sin(1 + static_cast<double>(i));
+  }
+  const auto gp = isGenericParallelBehaviour(b);
+  const auto test = [&](const std::string& rname, const auto& rotation) {
+    const auto& ra = rotation.first.get();
+    const auto& rv = rotation.second.get();
+    auto ref = std::vector<real>(v.size());
+    rotate(std::span(ref), b, std::span<const real>(v), ra);
+    // call of a rotation function with the given policy (0: none,
+    // 1: synchronous, 2: asynchronous)
+    const auto call = [&rotate](const int policy, const auto&... args) {
+      if (policy == 0) {
+        rotate(args...);
+      } else if (policy == 1) {
+        rotate(BatchExecutionPolicy{}, args...);
+      } else {
+        const auto r = rotate(AsynchronousBatchExecutionPolicy{}, args...);
+        check(r.getResult().exit_status == 1,
+              "asynchronous rotation: invalid status");
+      }
+    };
+    for (const auto policy : {0, 1, 2}) {
+      if ((!gp) && (policy != 0)) {
+        continue;
+      }
+      const auto msg = name + ", " + rname + ", policy " +
+                       std::to_string(policy) +
+                       (gp ? ", generic-parallel" : ", generic");
+      for (const auto sl : layouts) {
+        auto s = std::vector<real>{};
+        const auto sv = makeTestView(s, sl, n, vsize);
+        for (mgis::size_type i = 0; i != n; ++i) {
+          for (mgis::size_type j = 0; j != vsize; ++j) {
+            sv(i, j) = v[i * vsize + j];
+          }
+        }
+        for (const auto dl : layouts) {
+          auto d = std::vector<real>{};
+          const auto dv = makeTestView(d, dl, n, vsize);
+          call(policy, dv, b, FieldView<const real>(sv), rv);
+          check(checkTestView(d, dv, ref),
+                msg + ", from " + getLayoutDescription(sl) + " to " +
+                    getLayoutDescription(dl) + ": invalid rotated values");
+        }
+        // in place
+        call(policy, sv, b, rv);
+        check(checkTestView(s, sv, ref), msg + ", in place, " +
+                                             getLayoutDescription(sl) +
+                                             ": invalid rotated values");
+      }
+    }
+  };
+  (test(std::get<0>(rotations), std::get<1>(rotations)), ...);
+}  // end of testRotationOnViews
+
+/*!
+ * \brief rotations of values described by views, for the behaviours
