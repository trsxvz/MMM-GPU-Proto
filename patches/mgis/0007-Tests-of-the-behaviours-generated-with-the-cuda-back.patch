From d891c72a6b7043240d4cd2faa03f32aefe7237a9 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 06:13:18 +0200
Subject: [PATCH] Tests of the behaviours generated with the cuda backend

The function generating the libraries of the generic-parallel interface
supports the cuda backend. With the enable-generic-parallel-cuda-tests
option (off by default), GenericParallelCUDATest integrates behaviours on
an NVIDIA GPU with all the data allocated in managed memory by the calling
code (runtime API of CUDA called from code compiled by the C++ compiler),
including the uniform values, and compares the results with the
integration point by point of the generic interface. A uniform value held
by the material state manager is refused.
---
 CMakeLists.txt                    |   4 +
 cmake/modules/behaviours.cmake    |  17 +-
 tests/CMakeLists.txt              |  24 +++
 tests/GenericParallelCUDATest.cxx | 254 ++++++++++++++++++++++++++++++
 4 files changed, 297 insertions(+), 2 deletions(-)
 create mode 100644 tests/GenericParallelCUDATest.cxx

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f79bd74..6b33e2c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -23,6 +23,10 @@ set(CXX_STANDARD_REQUIRED ON)
 
 # enable tests
 option(enable-testing "" ON)
+# tests of the behaviours generated by the generic-parallel interface of MFront
+# with the cuda backend (requires a CUDA compiler and an NVIDIA GPU)
+option(enable-generic-parallel-cuda-tests
+       "test the behaviours generated by the generic-parallel interface of MFront with the cuda backend" OFF)
 
 # portable-build
 option(enable-portable-build "produce binary that can be shared between various machine (same architecture, same gcc version, different processors" OFF)
diff --git a/cmake/modules/behaviours.cmake b/cmake/modules/behaviours.cmake
index 402fd4a..87604ca 100644
--- a/cmake/modules/behaviours.cmake
+++ b/cmake/modules/behaviours.cmake
@@ -91,7 +91,8 @@ endfunction(mfront_behaviours_check_library)
 # Library of behaviours generated by the `generic-parallel` interface of
 # `MFront` with the given backend. The sources are generated in a directory
 # of their own, since the `generic` interface generates sources with the same
-# names, and compiled as the libraries of the `generic` interface.
+# names, and compiled as the libraries of the `generic` interface. The
+# sources of the `cuda` backend require the CUDA language.
 #
 # usage: mfront_generic_parallel_behaviours_check_library(name backend
 #                                                         behaviours...)
@@ -108,11 +109,16 @@ function(mfront_generic_parallel_behaviours_check_library name backend)
     "  }\n"
     "}\n")
   set(_sources)
+  if(backend STREQUAL "cuda")
+    set(_extension "cu")
+  else(backend STREQUAL "cuda")
+    set(_extension "cxx")
+  endif(backend STREQUAL "cuda")
   foreach(source ${ARGN})
     set(_file "${CMAKE_CURRENT_SOURCE_DIR}/${source}.mfront")
     set(_outputs
       "${_directory}/src/${source}.cxx"
-      "${_directory}/src/${source}-generic-parallel-${backend}.cxx")
+      "${_directory}/src/${source}-generic-parallel-${backend}.${_extension}")
     add_custom_command(
       OUTPUT ${_outputs}
       COMMAND "${MFRONT}"
@@ -131,6 +137,13 @@ function(mfront_generic_parallel_behaviours_check_library name backend)
     PRIVATE "${_directory}/include"
     PRIVATE "${TFEL_INCLUDE_PATH}")
   target_link_libraries(${name} PUBLIC ${TFEL_MFRONT_LIBRARIES})
+  if(backend STREQUAL "cuda")
+    set_target_properties(${name} PROPERTIES
+      CUDA_STANDARD 20
+      CUDA_ARCHITECTURES native)
+    target_compile_options(${name} PRIVATE
+      $<$<COMPILE_LANGUAGE:CUDA>:--expt-relaxed-constexpr>)
+  endif(backend STREQUAL "cuda")
   if(backend STREQUAL "stlpar")
     # the parallel algorithms of libstdc++ use TBB
     find_library(MGIS_TBB_LIBRARY tbb)
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index d2e0fe1..006f214 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -174,6 +174,30 @@ if(MGIS_HAVE_MFRONT_SUPPORT)
     PROPERTY DEPENDS GenericParallelBehaviourTest BehaviourTest)
   set_test_environment(GenericParallelIntegrateTest)
 
+  # behaviours generated by the generic-parallel interface with the cuda
+  # backend. The test allocates the data in managed memory with the runtime
+  # API of CUDA, from code compiled by the C++ compiler.
+  if(enable-generic-parallel-cuda-tests)
+    enable_language(CUDA)
+    find_package(CUDAToolkit REQUIRED)
+    mfront_generic_parallel_behaviours_check_library(
+      GenericParallelBehaviourTestCUDA cuda
+      Elasticity
+      Norton)
+    add_executable(GenericParallelCUDATest EXCLUDE_FROM_ALL
+      GenericParallelCUDATest.cxx)
+    target_link_libraries(GenericParallelCUDATest
+      PRIVATE MFrontGenericInterface CUDA::cudart)
+    add_test(NAME GenericParallelCUDATest
+      COMMAND GenericParallelCUDATest
+      "$<TARGET_FILE:GenericParallelBehaviourTestCUDA>"
+      "$<TARGET_FILE:BehaviourTest>")
+    add_dependencies(build-tests GenericParallelCUDATest)
+    set_property(TEST GenericParallelCUDATest
+      PROPERTY DEPENDS GenericParallelBehaviourTestCUDA BehaviourTest)
+    set_test_environment(GenericParallelCUDATest)
+  endif(enable-generic-parallel-cuda-tests)
+
   # Tests that depend on behaviour libraries
   add_library_test_with_tfel_version(LoadMaterialPropertyTest LoadMaterialPropertyTest.cxx MaterialPropertyTest)
 
diff --git a/tests/GenericParallelCUDATest.cxx b/tests/GenericParallelCUDATest.cxx
new file mode 100644
index 0000000..f1af800
--- /dev/null
+++ b/tests/GenericParallelCUDATest.cxx
@@ -0,0 +1,254 @@
+/*!
+ * \file   tests/GenericParallelCUDATest.cxx
+ * \brief  This test integrates behaviours generated by the `generic-parallel`
+ * interface of `MFront` with the `cuda` backend on batches whose data are
+ * allocated by the calling code in managed memory, and compares the results
+ * with the integration point by point of the `generic` interface.
+ *
+ * The data managers use external arrays for all their fields: the arrays
+ * managed by MGIS itself are in the memory of the host, which is not
+ * accessible by the device without heterogeneous memory management.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <cmath>
+#include <span>
+#include <memory>
+#include <string>
+#include <vector>
+#include <cstdlib>
+#include <iostream>
+#include <algorithm>
+#include <stdexcept>
+#include <string_view>
+#include <cuda_runtime_api.h>
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+//! \brief array of values in managed memory
+struct ManagedArray {
+  explicit ManagedArray(const mgis::size_type s) : size(s) {
+    if (s == 0) {
+      return;
+    }
+    void* p = nullptr;
+    if (cudaMallocManaged(&p, s * sizeof(mgis::real)) != cudaSuccess) {
+      throw std::runtime_error("allocation of managed memory failed");
+    }
+    this->values.reset(static_cast<mgis::real*>(p));
+    std::fill(this->values.get(), this->values.get() + s, mgis::real{});
+  }
+  //! \return a view on the values
+  std::span<mgis::real> span() noexcept {
+    return {this->values.get(), this->size};
+  }
+
+ private:
+  struct Deleter {
+    void operator()(mgis::real* const p) const noexcept {
+      static_cast<void>(cudaFree(p));
+    }
+  };
+  std::unique_ptr<mgis::real, Deleter> values;
+  mgis::size_type size;
+};
+
+//! \brief storage, in managed memory, of the state of the points
+struct ManagedState {
+  ManagedState(const mgis::behaviour::Behaviour& b, const mgis::size_type n)
+      : gradients(n * getArraySize(b.gradients, b.hypothesis)),
+        thermodynamic_forces(
+            n * getArraySize(b.thermodynamic_forces, b.hypothesis)),
+        internal_state_variables(n * getArraySize(b.isvs, b.hypothesis)) {}
+  //! \return the initializer of a material state manager
+  mgis::behaviour::MaterialStateManagerInitializer initializer() noexcept {
+    auto i = mgis::behaviour::MaterialStateManagerInitializer{};
+    i.gradients = this->gradients.span();
+    i.thermodynamic_forces = this->thermodynamic_forces.span();
+    i.internal_state_variables = this->internal_state_variables.span();
+    return i;
+  }
+  ManagedArray gradients, thermodynamic_forces, internal_state_variables;
+};
+
+//! \brief storage, in managed memory, of the data of the points
+struct ManagedData {
+  ManagedData(const mgis::behaviour::Behaviour& b, const mgis::size_type n)
+      : K(n * getTangentOperatorArraySize(b)), s0(b, n), s1(b, n) {}
+  //! \return the initializer of a material data manager
+  mgis::behaviour::MaterialDataManagerInitializer initializer() noexcept {
+    auto i = mgis::behaviour::MaterialDataManagerInitializer{};
+    i.K = this->K.span();
+    i.s0 = this->s0.initializer();
+    i.s1 = this->s1.initializer();
+    return i;
+  }
+  ManagedArray K;
+  ManagedState s0, s1;
+};
+
+//! \return the maximum of the differences relative to the given scale
+static double compare(const std::span<const mgis::real> a,
+                      const std::span<const mgis::real> b,
+                      const double scale) {
+  auto d = 0.;
+  for (std::size_t i = 0; i != a.size(); ++i) {
+    d = std::max(d, std::abs(a[i] - b[i]) / scale);
+  }
+  return d;
+}  // end of compare
+
+/*!
+ * \brief behaviour integrated point by point on the host (generic
+ * interface) and as a batch on the device (cuda backend)
+ */
+struct Managers {
+  Managers(const std::string& library,
+           const std::string& gpu_library,
+           const std::string& behaviour,
+           const mgis::size_type n)
+      : b(mgis::behaviour::load(
+            library, behaviour, mgis::behaviour::Hypothesis::TRIDIMENSIONAL)),
+        gpu_b(
+            mgis::behaviour::load(gpu_library,
+                                  behaviour,
+                                  mgis::behaviour::Hypothesis::TRIDIMENSIONAL)),
+        data(gpu_b, n),
+        m(b, n),
+        gpu_m(gpu_b, n, data.initializer()) {}
+  //! \brief integrate and compare the results
+  void integrate(const std::string& name, const mgis::real dt) {
+    using namespace mgis::behaviour;
+    auto opts = BehaviourIntegrationOptions{};
+    opts.integration_type =
+        IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+    const auto r = mgis::behaviour::integrate(this->m, opts, dt);
+    const auto gpu_r = mgis::behaviour::integrate(this->gpu_m, opts, dt);
+    check(r.exit_status == gpu_r.exit_status, name + ": invalid status");
+    // the results differ by rounding errors (contraction of the floating
+    // point operations by the CUDA compiler)
+    constexpr auto eps = 1e-10;
+    check(compare(this->m.s1.thermodynamic_forces,
+                  this->gpu_m.s1.thermodynamic_forces, 1e8) < eps,
+          name + ": invalid thermodynamic forces");
+    check(compare(this->m.s1.internal_state_variables,
+                  this->gpu_m.s1.internal_state_variables, 1) < eps,
+          name + ": invalid internal state variables");
+    check(compare(this->m.K, this->gpu_m.K, 1e10) < eps,
+          name + ": invalid tangent operators");
+  }
+  const mgis::behaviour::Behaviour b;
+  const mgis::behaviour::Behaviour gpu_b;
+  ManagedData data;
+  mgis::behaviour::MaterialDataManager m;
+  mgis::behaviour::MaterialDataManager gpu_m;
+};
+
+//! \brief viscoplastic behaviour, several time steps
+static void testNorton(const std::string& library,
+                       const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{1000};
+  auto managers = Managers(library, gpu_library, "Norton", n);
+  // uniform temperature, given in managed memory
+  auto temperature = ManagedArray(1);
+  temperature.span()[0] = 293.15;
+  for (auto* const s : {&managers.m.s0, &managers.m.s1}) {
+    setExternalStateVariable(*s, "Temperature", 293.15);
+  }
+  for (auto* const s : {&managers.gpu_m.s0, &managers.gpu_m.s1}) {
+    setExternalStateVariable(*s, "Temperature", temperature.span(),
+                             MaterialStateManager::EXTERNAL_STORAGE);
+  }
+  for (int step = 0; step != 10; ++step) {
+    for (auto* const m : {&managers.m, &managers.gpu_m}) {
+      for (mgis::size_type i = 0; i != m->n; ++i) {
+        m->s1.gradients[i * m->s1.gradients_stride] +=
+            5e-5 * (1 + static_cast<double>(i) / m->n);
+      }
+    }
+    managers.integrate("Norton, step " + std::to_string(step), 180);
+    update(managers.m);
+    update(managers.gpu_m);
+  }
+}  // end of testNorton
+
+/*!
+ * \brief elastic behaviour: Young modulus given point by point, uniform
+ * Poisson ratio, both in managed memory. A uniform value stored by MGIS (in
+ * the memory of the host) is refused.
+ */
+static void testElasticity(const std::string& library,
+                           const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{1000};
+  auto managers = Managers(library, gpu_library, "Elasticity", n);
+  auto young = ManagedArray(n);
+  auto nu = ManagedArray(1);
+  auto temperature = ManagedArray(1);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    young.span()[i] = 150e9 + 1e8 * static_cast<double>(i);
+  }
+  nu.span()[0] = 0.3;
+  temperature.span()[0] = 293.15;
+  for (auto* const m : {&managers.m, &managers.gpu_m}) {
+    for (auto* const s : {&m->s0, &m->s1}) {
+      setMaterialProperty(*s, "YoungModulus", young.span(),
+                          MaterialStateManager::EXTERNAL_STORAGE);
+      setMaterialProperty(*s, "PoissonRatio", nu.span(),
+                          MaterialStateManager::EXTERNAL_STORAGE);
+      setExternalStateVariable(*s, "Temperature", temperature.span(),
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    for (mgis::size_type i = 0; i != m->n; ++i) {
+      m->s1.gradients[i * m->s1.gradients_stride] = 1e-3;
+      m->s1.gradients[i * m->s1.gradients_stride + 3] = 2e-4;
+    }
+  }
+  managers.integrate("Elasticity", 1);
+  // uniform value stored in the memory of the host
+  setMaterialProperty(managers.gpu_m.s1, "PoissonRatio", 0.3);
+  auto opts = BehaviourIntegrationOptions{};
+  check(
+      [&managers, &opts] {
+        try {
+          static_cast<void>(integrate(managers.gpu_m, opts, 1));
+        } catch (...) {
+          return true;
+        }
+        return false;
+      }(),
+      "a uniform value in the memory of the host must be refused");
+}  // end of testElasticity
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0] << " cuda-library generic-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    testNorton(argv[2], argv[1]);
+    testElasticity(argv[2], argv[1]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
