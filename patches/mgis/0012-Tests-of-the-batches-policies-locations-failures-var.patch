+/*!
+ * \brief compare the results of the integration point by point on the host
+ * and of the integration of a batch on the device
+ * \param[in] name: name of the test
+ * \param[in] r: result of the integration point by point
+ * \param[in] gpu_r: result of the integration of a batch
+ * \param[in] m: material data manager of the integration point by point
+ * \param[in] gpu_m: material data manager of the integration of a batch
+ */
+static void checkResults(
+    const std::string& name,
+    const mgis::behaviour::BehaviourIntegrationResult& r,
+    const mgis::behaviour::BehaviourIntegrationResult& gpu_r,
+    const mgis::behaviour::MaterialDataManager& m,
+    const mgis::behaviour::MaterialDataManager& gpu_m) {
+  check(r.exit_status == gpu_r.exit_status, name + ": invalid status");
+  // the results differ by rounding errors (contraction of the floating
+  // point operations by the CUDA compiler)
+  constexpr auto eps = 1e-10;
+  check(compare(m.s1.thermodynamic_forces, gpu_m.s1.thermodynamic_forces, 1e8) <
+            eps,
+        name + ": invalid thermodynamic forces");
+  check(compare(m.s1.internal_state_variables,
+                gpu_m.s1.internal_state_variables, 1) < eps,
+        name + ": invalid internal state variables");
+  check(compare(m.K, gpu_m.K, 1e10) < eps,
+        name + ": invalid tangent operators");
+}  // end of checkResults
+
+//! \brief stream of CUDA
+struct Stream {
+  Stream() {
+    if (cudaStreamCreate(&(this->stream)) != cudaSuccess) {
+      throw std::runtime_error("creation of a stream failed");
+    }
+  }
+  Stream(Stream&&) = delete;
+  Stream(const Stream&) = delete;
+  Stream& operator=(Stream&&) = delete;
+  Stream& operator=(const Stream&) = delete;
+  ~Stream() { static_cast<void>(cudaStreamDestroy(this->stream)); }
+  //! \return an execution policy submitting the computations on the stream
+  mgis::behaviour::BatchExecutionPolicy policy() const noexcept {
+    auto p = mgis::behaviour::BatchExecutionPolicy{};
+    p.queue = this->stream;
+    return p;
+  }
+  cudaStream_t stream = nullptr;
+};
