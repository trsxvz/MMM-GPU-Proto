+/*!
+ * \brief rotations of an orthotropic behaviour in plane strain: uniform
+ * rotation and rotation given point by point
+ */
+static void testRotations2D(const std::string& library,
+                            const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto h = Hypothesis::PLANESTRAIN;
+  constexpr auto n = mgis::size_type{6};
+  const auto b = load(library, "OrthotropicElasticity", h);
+  const auto gp_b = load(gp_library, "OrthotropicElasticity", h);
+  auto axes = std::vector<mgis::real>(2 * n);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    const auto t = 0.4 * static_cast<double>(i + 1);
+    axes[2 * i] = std::cos(t);
+    axes[2 * i + 1] = std::sin(t);
+  }
+  const auto uniform =
+      RotationMatrix2D(std::span<const mgis::real>(axes.data(), 2),
+                       mgis::StorageMode::EXTERNAL_STORAGE);
+  const auto per_point =
+      RotationMatrix2D(axes, mgis::StorageMode::EXTERNAL_STORAGE);
+  const auto gsize = getArraySize(b.gradients, h);
+  const auto Ksize = getTangentOperatorArraySize(b);
+  auto test = [&](const std::string& name, const RotationMatrix2D& r) {
+    auto g = std::vector<mgis::real>(gsize * n);
+    for (mgis::size_type i = 0; i != g.size(); ++i) {
+      g[i] = std::sin(2 + static_cast<double>(i));
+    }
+    auto rg = std::vector<mgis::real>(g.size());
+    auto gp_rg = std::vector<mgis::real>(g.size());
+    rotateGradients(rg, b, g, r);
+    rotateGradients(gp_rg, gp_b, g, r);
