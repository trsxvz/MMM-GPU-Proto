+/*!
+ * \brief location of the arrays of the material data managers: arrays
+ * allocated by a memory resource, arrays located on a device, managers
+ * without points
+ */
+static void testMemoryLocations(const std::string& library,
+                                const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  constexpr auto n = mgis::size_type{10};
+  const auto b = load(library, "Norton", h);
+  const auto gp_b = load(gp_library, "Norton", h);
+  const auto opts = BehaviourIntegrationOptions{};
+  // arrays allocated by a memory resource, in a shared location (the
+  // resource used here allocates memory of the host)
+  auto shared = MaterialDataManagerInitializer{};
+  shared.location = MemoryLocation::SHARED;
+  shared.resource = std::pmr::new_delete_resource();
+  auto m = MaterialDataManager(b, n);
+  auto gp_m = MaterialDataManager(gp_b, n, shared);
+  for (auto* const mm : {&m, &gp_m}) {
+    for (auto* const s : {&mm->s0, &mm->s1}) {
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    for (mgis::size_type i = 0; i != n; ++i) {
+      mm->s1.gradients[i * mm->s1.gradients_stride] =
+          2e-3 * static_cast<double>(i + 1) / n;
+    }
+  }
+  const auto ri = integrate(m, opts, 1);
+  const auto gp_ri = integrate(gp_m, opts, 1);
+  check((ri.exit_status == gp_ri.exit_status) &&
+            (compare(m.s1.thermodynamic_forces, gp_m.s1.thermodynamic_forces,
+                     1e8) < 1e-10) &&
+            (compare(m.K, gp_m.K, 1e10) < 1e-10),
+        "arrays allocated by a memory resource: invalid results");
+  // shared location without memory resource: all the arrays must be given
+  auto shared2 = MaterialDataManagerInitializer{};
+  shared2.location = MemoryLocation::SHARED;
+  check(throws([&gp_b, &shared2] { MaterialDataManager(gp_b, n, shared2); },
+               "must be given by the initializer"),
+        "missing arrays in a shared location must be refused");
+  // ... except if there is no point
+  check(
+      !throws([&gp_b, &shared2] { MaterialDataManager(gp_b, 0, shared2); }, ""),
+      "a manager without points must be accepted");
+  // arrays located on a device, refused by the functions of the host
+  auto storage = std::vector<std::vector<mgis::real>>{};
+  auto make = [&storage](const mgis::size_type s) {
+    return std::span<mgis::real>(storage.emplace_back(s));
+  };
+  storage.reserve(16);
+  auto device = MaterialDataManagerInitializer{};
+  device.location = MemoryLocation::DEVICE;
+  device.K = make(n * getTangentOperatorArraySize(b));
+  for (auto* const si : {&device.s0, &device.s1}) {
+    si->gradients = make(n * getArraySize(b.gradients, h));
+    si->thermodynamic_forces =
+        make(n * getArraySize(b.thermodynamic_forces, h));
+    si->internal_state_variables = make(n * getArraySize(b.isvs, h));
+    if (b.computesStoredEnergy) {
+      si->stored_energies = make(n);
+    }
+    if (b.computesDissipatedEnergy) {
+      si->dissipated_energies = make(n);
+    }
+  }
+  auto dm = MaterialDataManager(b, n, device);
+  setExternalStateVariable(dm.s0, "Temperature", 293.15);
+  setExternalStateVariable(dm.s1, "Temperature", 293.15);
+  check(throws([&dm, &opts] { static_cast<void>(integrate(dm, opts, 1)); },
+               "not accessible by the computations"),
+        "the integration on the host of data located on a device must be "
+        "refused");
+  check(throws([&dm] { updateValues(dm.s0, dm.s1); },
+               "not accessible by the host"),
+        "updateValues must refuse data located on a device");
+  auto ev = std::vector<mgis::real>(n);
+  check(throws(
+            [&dm, &ev] {
+              extractInternalStateVariable(ev, dm.s1,
+                                           "EquivalentViscoplasticStrain");
+            },
+            "not accessible by the host"),
+        "extractInternalStateVariable must refuse data located on a device");
+  // a uniform material property stored locally is uniform, whatever the way
+  // it is given
+  auto em = MaterialDataManager(load(library, "Elasticity", h), n);
+  auto nu = std::vector<mgis::real>{0.3};
+  setMaterialProperty(em.s1, "PoissonRatio", nu);
+  check(isMaterialPropertyUniform(em.s1, "PoissonRatio"),
+        "a material property given by one value must be uniform");
+}  // end of testMemoryLocations
