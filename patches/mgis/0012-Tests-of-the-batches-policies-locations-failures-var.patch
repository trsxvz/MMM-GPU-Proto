+/*!
+ * \brief external state variables of various types, including arrays of
+ * variables (whose elements are distinct variables), uniform or given point
+ * by point: the behaviour copies their values at the end of the time step in
+ * internal state variables
+ */
+static void testArraysOfExternalStateVariables(const std::string& library,
+                                               const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{5};
+  auto managers =
+      Managers(library, gp_library, "TensorialExternalStateVariableTest", n);
+  const auto h = managers.b.hypothesis;
+  // values of the external state variables, kept alive during the test
+  auto values = std::vector<std::vector<mgis::real>>{};
+  values.reserve(2 * managers.b.esvs.size());
+  for (const auto* const sv : {&managers.m.s0, &managers.m.s1}) {
+    static_cast<void>(sv);
+    for (const auto& v : managers.b.esvs) {
+      const auto vs = getVariableSize(v, h);
+      // the stress tensor is uniform, the other variables are given point
+      // by point
+      const auto uniform = v.name == "s_esv";
+      auto& vv = values.emplace_back(uniform ? vs : n * vs);
+      for (mgis::size_type i = 0; i != vv.size(); ++i) {
+        vv[i] = std::sin(static_cast<double>(values.size() + 7 * i));
+      }
+    }
+  }
+  managers.apply([&values, &managers](MaterialDataManager& m) {
+    auto p = values.begin();
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      for (const auto& v : managers.b.esvs) {
+        if (v.name == "Temperature") {
+          setExternalStateVariable(*s, v.name, 293.15);
+          ++p;
+          continue;
+        }
+        setExternalStateVariable(*s, v.name, *p,
+                                 MaterialStateManager::EXTERNAL_STORAGE);
+        ++p;
+      }
+    }
+  });
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  managers.integrate("TensorialExternalStateVariableTest", opts, 1);
+  // the internal state variables are the values of the external state
+  // variables at the end of the time step
+  const auto& s1 = managers.gp_m.s1;
+  const auto& esvs = managers.b.esvs;
+  for (std::size_t k = 0; k != esvs.size(); ++k) {
+    if (esvs[k].name == "Temperature") {
+      continue;
+    }
+    auto isv = esvs[k].name;
+    isv.replace(isv.find("_esv"), 4, "_isv");
+    const auto o = getVariableOffset(managers.b.isvs, isv, h);
+    const auto vs = getVariableSize(esvs[k], h);
+    const auto& esv = values[esvs.size() + k];
+    auto d = 0.;
+    for (mgis::size_type i = 0; i != n; ++i) {
+      for (mgis::size_type c = 0; c != vs; ++c) {
+        const auto expected = esv.size() == vs ? esv[c] : esv[i * vs + c];
+        d = std::max(
+            d, std::abs(s1.internal_state_variables
+                            [i * s1.internal_state_variables_stride + o + c] -
+                        expected));
+      }
+    }
+    check(d < 1e-14,
+          "TensorialExternalStateVariableTest: invalid value of " + isv);
+  }
+}  // end of testArraysOfExternalStateVariables
