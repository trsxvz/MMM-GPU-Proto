+/*!
+ * \brief arrays allocated by MGIS with a memory resource allocating managed
+ * memory: no array is given by the calling code
+ */
+static void testMemoryResource(const std::string& library,
+                               const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{1000};
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  // the resource outlives the material data manager
+  auto resource = mgis::memory_resources::CUDAManagedMemoryResource{};
+  const auto b = load(library, "Norton", h);
+  const auto gpu_b = load(gpu_library, "Norton", h);
+  auto i = MaterialDataManagerInitializer{};
+  i.location = MemoryLocation::SHARED;
+  i.resource = &resource;
+  auto m = MaterialDataManager(b, n);
+  auto gpu_m = MaterialDataManager(gpu_b, n, i);
+  auto temperature = ManagedArray(1);
+  temperature.span()[0] = 293.15;
+  for (auto* const s : {&m.s0, &m.s1}) {
+    setExternalStateVariable(*s, "Temperature", 293.15);
+  }
+  for (auto* const s : {&gpu_m.s0, &gpu_m.s1}) {
+    setExternalStateVariable(*s, "Temperature", temperature.span(),
+                             MaterialStateManager::EXTERNAL_STORAGE);
+  }
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  for (int step = 0; step != 3; ++step) {
+    for (auto* const mm : {&m, &gpu_m}) {
+      for (mgis::size_type j = 0; j != n; ++j) {
+        mm->s1.gradients[j * mm->s1.gradients_stride] +=
+            5e-5 * (1 + static_cast<double>(j) / n);
+      }
+    }
+    const auto r = integrate(m, opts, 180);
+    const auto gpu_r = integrate(gpu_m, opts, 180);
+    checkResults("memory resource, step " + std::to_string(step), r, gpu_r, m,
+                 gpu_m);
+    update(m);
+    update(gpu_m);
+  }
+}  // end of testMemoryResource
+
+/*!
+ * \brief computations submitted on a stream which is not the default one:
+ * integration, initialize function, post-processing and rotation
+ */
+static void testStream(const std::string& library,
+                       const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{100};
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  const auto stream = Stream{};
+  const auto p = stream.policy();
+  auto temperature = ManagedArray(1);
+  temperature.span()[0] = 293.15;
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  // integration
+  {
+    auto managers = Managers(library, gpu_library, "Norton", n);
+    setExternalStateVariable(managers.m.s0, "Temperature", 293.15);
+    setExternalStateVariable(managers.m.s1, "Temperature", 293.15);
+    for (auto* const s : {&managers.gpu_m.s0, &managers.gpu_m.s1}) {
+      setExternalStateVariable(*s, "Temperature", temperature.span(),
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    for (auto* const m : {&managers.m, &managers.gpu_m}) {
+      for (mgis::size_type i = 0; i != n; ++i) {
+        m->s1.gradients[i * m->s1.gradients_stride] =
+            2e-4 * (1 + static_cast<double>(i) / n);
+      }
+    }
+    const auto r = integrate(managers.m, opts, 180);
+    const auto gpu_r = integrate(p, managers.gpu_m, opts, 180);
+    checkResults("Norton, stream", r, gpu_r, managers.m, managers.gpu_m);
+  }
+  // initialize function, inputs given point by point in managed memory
+  {
+    auto managers = Managers(library, gpu_library, "InitializeFunctionTest", n);
+    setExternalStateVariable(managers.m.s0, "Temperature", 293.15);
+    setExternalStateVariable(managers.m.s1, "Temperature", 293.15);
+    for (auto* const s : {&managers.gpu_m.s0, &managers.gpu_m.s1}) {
+      setExternalStateVariable(*s, "Temperature", temperature.span(),
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    auto pressures = ManagedArray(n);
+    for (mgis::size_type i = 0; i != n; ++i) {
+      pressures.span()[i] = -1e5 * static_cast<double>(i + 1);
+    }
+    const auto r = executeInitializeFunction(
+        managers.m, "StressFromInitialPressure", pressures.span());
+    const auto gpu_r = executeInitializeFunction(
+        p, managers.gpu_m, "StressFromInitialPressure", pressures.span());
+    check((r.exit_status == 1) && (gpu_r.exit_status == 1) &&
+              (compare(managers.m.s1.thermodynamic_forces,
+                       managers.gpu_m.s1.thermodynamic_forces, 1e8) < 1e-12),
+          "StressFromInitialPressure, stream: invalid results");
+  }
+  // post-processing, outputs in managed memory
+  {
+    auto managers = Managers(library, gpu_library, "PostProcessingTest", n);
+    auto young = ManagedArray(1);
+    auto nu = ManagedArray(1);
+    young.span()[0] = 150e9;
+    nu.span()[0] = 0.3;
+    for (auto* const s : {&managers.m.s0, &managers.m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    for (auto* const s : {&managers.gpu_m.s0, &managers.gpu_m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", young.span(),
+                          MaterialStateManager::EXTERNAL_STORAGE);
+      setMaterialProperty(*s, "PoissonRatio", nu.span(),
+                          MaterialStateManager::EXTERNAL_STORAGE);
+      setExternalStateVariable(*s, "Temperature", temperature.span(),
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    for (auto* const m : {&managers.m, &managers.gpu_m}) {
+      for (mgis::size_type i = 0; i != n; ++i) {
+        for (mgis::size_type c = 0; c != 3; ++c) {
+          m->s1.gradients[i * m->s1.gradients_stride + c] =
+              1e-4 * static_cast<double>((i % 7 + 1) * (c + 1));
+        }
+        m->s1.gradients[i * m->s1.gradients_stride + 3] = 1e-4;
+      }
+    }
+    auto outputs =
+        allocatePostProcessingVariables(managers.m, "PrincipalStrain");
+    auto gpu_outputs = ManagedArray(outputs.size());
+    const auto r =
+        executePostProcessing(outputs, managers.m, "PrincipalStrain");
+    const auto gpu_r = executePostProcessing(gpu_outputs.span(), p,
+                                             managers.gpu_m, "PrincipalStrain");
+    check((r.exit_status == 1) && (gpu_r.exit_status == 1) &&
+              (compare(outputs, gpu_outputs.span(), 1) < 1e-12),
+          "PrincipalStrain, stream: invalid outputs");
+  }
+  // rotation of the gradients, data in managed memory
+  {
+    const auto b = load(library, "OrthotropicElasticity", h);
+    const auto gpu_b = load(gpu_library, "OrthotropicElasticity", h);
+    const auto gsize = getArraySize(b.gradients, h);
+    auto g = ManagedArray(gsize * n);
+    auto gpu_rg = ManagedArray(gsize * n);
+    auto matrix = ManagedArray(9);
+    const auto values =
+        std::array<mgis::real, 9>{0.6, 0.8, 0, -0.8, 0.6, 0, 0, 0, 1};
+    std::copy(values.begin(), values.end(), matrix.span().begin());
+    for (mgis::size_type i = 0; i != gsize * n; ++i) {
+      g.span()[i] = std::sin(1 + static_cast<double>(i));
+    }
+    auto rg = std::vector<mgis::real>(gsize * n);
+    rotateGradients(rg, b, g.span(), matrix.span());
+    rotateGradients(p, gpu_rg.span(), gpu_b, g.span(), matrix.span());
+    check(compare(rg, gpu_rg.span(), 1) < 1e-14,
+          "rotateGradients, stream: invalid rotated values");
+    // the rotation matrices built by MGIS are in the memory of the host
+    const auto axis1 = std::vector<mgis::real>{0.6, 0.8, 0};
+    const auto axis2 = std::vector<mgis::real>{-0.8, 0.6, 0};
+    const auto r3d =
+        RotationMatrix3D(axis1, axis2, mgis::StorageMode::EXTERNAL_STORAGE);
+    check(throws(
+              [&p, &gpu_rg, &gpu_b, &g, &r3d] {
+                rotateGradients(p, gpu_rg.span(), gpu_b, g.span(), r3d);
+              },
+              "must be given as an array"),
+          "rotation matrices built in the memory of the host must be refused");
+  }
+}  // end of testStream
