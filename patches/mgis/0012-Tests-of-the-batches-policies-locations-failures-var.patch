+/*!
+ * \brief integration of a finite strain behaviour with several stress
+ * measures and tangent operators
+ */
+static void testFiniteStrainIntegration(const std::string& library,
+                                        const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{6};
+  using Options = FiniteStrainBehaviourOptions;
+  const auto options =
+      std::array<std::pair<Options::StressMeasure, Options::TangentOperator>,
+                 4>{std::pair{Options::PK1, Options::DPK1_DF},
+                    std::pair{Options::CAUCHY, Options::DSIG_DF},
+                    std::pair{Options::PK2, Options::DS_DEGL},
+                    std::pair{Options::CAUCHY, Options::DTAU_DDF}};
+  for (const auto& [sm, to] : options) {
+    auto o = Options{};
+    o.stress_measure = sm;
+    o.tangent_operator = to;
+    auto managers = Managers(o, library, gp_library,
+                             "OrthotropicFiniteStrainElasticity", n);
+    managers.apply([](MaterialDataManager& m) {
+      for (auto* const s : {&m.s0, &m.s1}) {
+        setExternalStateVariable(*s, "Temperature", 293.15);
+      }
+      for (mgis::size_type i = 0; i != m.n; ++i) {
+        auto* const F = m.s1.gradients.data() + i * m.s1.gradients_stride;
+        F[0] = 1 + 1e-3 * static_cast<double>(i + 1);
+        F[1] = 1 - 2e-4 * static_cast<double>(i);
+        F[3] = 3e-4;
+        F[4] = -1e-4;
+      }
+    });
+    auto opts = BehaviourIntegrationOptions{};
+    opts.integration_type =
+        IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+    managers.integrate("OrthotropicFiniteStrainElasticity, options " +
+                           std::to_string(static_cast<int>(sm)) + "/" +
+                           std::to_string(static_cast<int>(to)),
+                       opts, 1);
+  }
+}  // end of testFiniteStrainIntegration
