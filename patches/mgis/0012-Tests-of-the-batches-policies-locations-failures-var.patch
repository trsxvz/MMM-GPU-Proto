+/*!
+ * \brief failures at some points: the external state variable, given point
+ * by point, is out of its physical bounds at the points 5 and 9
+ */
+static void testPartialFailures(const std::string& library,
+                                const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{12};
+  auto managers = Managers(library, gp_library, "BoundsCheckTest", n);
+  auto ev = std::vector<mgis::real>(n, 300);
+  ev[5] = ev[9] = 600;
+  managers.apply([&ev](MaterialDataManager& m) {
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+      setExternalStateVariable(*s, "ExternalStateVariable", ev,
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    for (mgis::size_type i = 0; i != m.n; ++i) {
+      m.s1.gradients[i * m.s1.gradients_stride] = 1e-3;
+    }
+  });
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  // first, since the integration point by point stops at the first failure
+  // while all the points of a batch are integrated
+  managers.integrate("BoundsCheckTest, range without failure", opts, 1, {0, 5});
+  managers.integrate("BoundsCheckTest", opts, 1);
+  auto gp_r = integrate(managers.gp_m, opts, 1);
+  check((gp_r.exit_status == -1) && (gp_r.n == 5),
+        "BoundsCheckTest: invalid index of the first failure");
+  check(gp_r.error_message.find("2 integration points") != std::string::npos,
+        "BoundsCheckTest: invalid error message");
+  managers.integrate("BoundsCheckTest, range", opts, 1, {7, 12});
+  gp_r = integrate(managers.gp_m, opts, 1, 7, 12);
+  check((gp_r.n == 9) &&
+            (gp_r.error_message.find("point 9") != std::string::npos),
+        "BoundsCheckTest, range: invalid index of the first failure");
+}  // end of testPartialFailures
