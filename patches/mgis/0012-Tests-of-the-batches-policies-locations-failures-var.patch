+/*!
+ * \brief speed of sound, computed with a uniform mass density given by a
+ * span on one value
+ */
+static void testSpeedOfSound(const std::string& library,
+                             const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{4};
+  auto managers = Managers(library, gp_library, "ComputeSpeedOfSound", n);
+  auto rho = std::vector<mgis::real>{7800};
+  managers.apply([&rho](MaterialDataManager& m) {
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setExternalStateVariable(*s, "Temperature", 293.15);
+      setMassDensity(*s, rho, MaterialStateManager::EXTERNAL_STORAGE,
+                     MaterialStateManager::NOUPDATE);
+    }
+  });
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  opts.compute_speed_of_sound = true;
+  managers.integrate("ComputeSpeedOfSound", opts, 1);
+  const auto expected = std::sqrt(150e9 / rho[0]);
+  check(std::all_of(managers.gp_m.speed_of_sound.begin(),
+                    managers.gp_m.speed_of_sound.end(),
+                    [expected](const mgis::real v) {
+                      return std::abs(v - expected) < 1e-10 * expected;
+                    }) &&
+            (compare(managers.m.speed_of_sound, managers.gp_m.speed_of_sound,
+                     expected) < 1e-14),
+        "ComputeSpeedOfSound: invalid speed of sound");
+}  // end of testSpeedOfSound
