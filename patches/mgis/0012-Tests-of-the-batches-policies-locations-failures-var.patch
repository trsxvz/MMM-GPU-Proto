+/*!
+ * \brief functions taking an execution policy: they give the same results as
+ * the functions using the policy of the material data manager, and refuse
+ * the behaviours of the other interfaces
+ */
+static void testExecutionPolicies(const std::string& library,
+                                  const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{8};
+  const auto p = BatchExecutionPolicy{};
+  // initialize functions
+  auto managers = Managers(library, gp_library, "InitializeFunctionTest", n);
+  managers.apply([](MaterialDataManager& m) {
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+  });
+  auto pressures = std::vector<mgis::real>(n);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    pressures[i] = -2e5 * static_cast<double>(i + 1);
+  }
+  static_cast<void>(executeInitializeFunction(
+      managers.m, "StressFromInitialPressure", pressures, 1, 7));
+  const auto r = executeInitializeFunction(
+      p, managers.gp_m, "StressFromInitialPressure", pressures, 1, 7);
+  check((r.exit_status == 1) &&
+            (compare(managers.m.s1.thermodynamic_forces,
+                     managers.gp_m.s1.thermodynamic_forces, 1e8) < 1e-14),
+        "executeInitializeFunction with a policy: invalid results");
+  check(throws(
+            [&p, &managers, &pressures] {
+              static_cast<void>(executeInitializeFunction(
+                  p, managers.m, "StressFromInitialPressure", pressures));
+            },
+            "has not been generated by the generic-parallel interface"),
+        "executeInitializeFunction with a policy: a behaviour of the generic "
+        "interface must be refused");
+  // post-processings
+  auto pmanagers = Managers(library, gp_library, "PostProcessingTest", n);
+  pmanagers.apply([](MaterialDataManager& m) {
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    for (mgis::size_type i = 0; i != m.n; ++i) {
+      m.s1.gradients[i * m.s1.gradients_stride + 1] =
+          1e-4 * static_cast<double>(i + 1);
+    }
+  });
+  auto outputs =
+      allocatePostProcessingVariables(pmanagers.m, "PrincipalStrain");
+  auto gp_outputs =
+      allocatePostProcessingVariables(pmanagers.gp_m, "PrincipalStrain");
+  static_cast<void>(
+      executePostProcessing(outputs, pmanagers.m, "PrincipalStrain"));
+  const auto pr =
+      executePostProcessing(gp_outputs, p, pmanagers.gp_m, "PrincipalStrain");
+  check((pr.exit_status == 1) && (compare(outputs, gp_outputs, 1) < 1e-14),
+        "executePostProcessing with a policy: invalid outputs");
+  check(throws(
+            [&p, &pmanagers, &outputs] {
+              static_cast<void>(executePostProcessing(outputs, p, pmanagers.m,
+                                                      "PrincipalStrain"));
+            },
+            "has not been generated by the generic-parallel interface"),
+        "executePostProcessing with a policy: a behaviour of the generic "
+        "interface must be refused");
+  // rotations
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  const auto b = load(library, "OrthotropicElasticity", h);
+  const auto gp_b = load(gp_library, "OrthotropicElasticity", h);
+  const auto matrix =
+      std::array<mgis::real, 9>{0.6, 0.8, 0, -0.8, 0.6, 0, 0, 0, 1};
+  const auto gsize = getArraySize(b.gradients, h);
+  auto g = std::vector<mgis::real>(gsize * n);
+  for (mgis::size_type i = 0; i != g.size(); ++i) {
+    g[i] = std::sin(3 + static_cast<double>(i));
+  }
+  auto rg = std::vector<mgis::real>(g.size());
+  auto gp_rg = std::vector<mgis::real>(g.size());
+  const auto rm = std::span<const mgis::real>(matrix);
+  rotateGradients(rg, b, g, rm);
+  rotateGradients(p, gp_rg, gp_b, g, rm);
+  check(compare(rg, gp_rg, 1) < 1e-14,
+        "rotateGradients with a policy: invalid rotated values");
+  check(throws([&p, &rg, &b, &g, &rm] { rotateGradients(p, rg, b, g, rm); },
+               "no rotation function of a batch"),
+        "rotateGradients with a policy: a behaviour of the generic interface "
+        "must be refused");
+}  // end of testExecutionPolicies
