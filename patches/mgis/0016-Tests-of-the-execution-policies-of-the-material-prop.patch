From 603376717205ba3d910dc7d76a2cc747242b4f71 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 14:32:18 +0200
Subject: [PATCH] Tests of the execution policies of the material properties

Evaluation with an execution policy on the host and on a CUDA stream which is not the default one, refused for a material property of the generic interface; layout of the execution options checked against TFEL.
---
 tests/GenericParallelCUDATest.cxx     |  9 +++++++++
 tests/GenericParallelEvaluateTest.cxx | 12 ++++++++++++
 tests/GenericParallelLoadTest.cxx     |  4 ++++
 3 files changed, 25 insertions(+)

diff --git a/tests/GenericParallelCUDATest.cxx b/tests/GenericParallelCUDATest.cxx
index ca2d5ad..c7a8c3e 100644
--- a/tests/GenericParallelCUDATest.cxx
+++ b/tests/GenericParallelCUDATest.cxx
@@ -580,6 +580,15 @@ static void testMaterialProperties(const std::string& library,
   check((s.status == 0) && (gpu_s.status == 0) &&
             (compare(E, gpu_E.span(), 1e11) < 1e-12),
         "Inconel600_YoungModulus: invalid values");
+  // evaluation on a stream which is not the default one
+  {
+    const auto stream = Stream{};
+    std::fill(gpu_E.span().begin(), gpu_E.span().end(), mgis::real{});
+    const auto stream_s = evaluate(stream.policy(), gpu_E.span(), gpu_mp,
+                                   inputs, MemoryLocation::SHARED);
+    check((stream_s.status == 0) && (compare(E, gpu_E.span(), 1e11) < 1e-12),
+          "Inconel600_YoungModulus, stream: invalid values");
+  }
   // uniform temperature
   auto T0 = ManagedArray(1);
   T0.span()[0] = 700;
diff --git a/tests/GenericParallelEvaluateTest.cxx b/tests/GenericParallelEvaluateTest.cxx
index f84c252..832dd29 100644
--- a/tests/GenericParallelEvaluateTest.cxx
+++ b/tests/GenericParallelEvaluateTest.cxx
@@ -14,6 +14,7 @@
  */
 
 #include <array>
+#include <algorithm>
 #include <cmath>
 #include <span>
 #include <string>
@@ -114,6 +115,17 @@ static void testEvaluate(const std::string& library,
   auto gp_s = evaluate(gp_E, gp_mp, inputs);
   check((s.status == 0) && (gp_s.status == 0) && (compare(E, gp_E) < 1e-14),
         "Inconel600_YoungModulus: invalid values");
+  // execution policy given explicitly
+  auto e = BatchExecutionPolicy{};
+  e.preserve_stack_size = true;
+  std::fill(gp_E.begin(), gp_E.end(), mgis::real{});
+  gp_s = evaluate(e, gp_E, gp_mp, inputs);
+  check((gp_s.status == 0) && (compare(E, gp_E) < 1e-14),
+        "Inconel600_YoungModulus, execution policy: invalid values");
+  check(throws([&e, &E, &mp, &inputs] { evaluate(e, E, mp, inputs); },
+               "has not been generated by the generic-parallel interface"),
+        "an execution policy must be refused for the material property of "
+        "a point");
   // uniform value
   const auto T0 = std::array<mgis::real, 1>{700};
   const auto uniform_inputs = std::array{std::span<const mgis::real>(T0)};
diff --git a/tests/GenericParallelLoadTest.cxx b/tests/GenericParallelLoadTest.cxx
index 06926ea..a0bcebf 100644
--- a/tests/GenericParallelLoadTest.cxx
+++ b/tests/GenericParallelLoadTest.cxx
@@ -83,6 +83,10 @@ static_assert(offsetof(mgis_mp_OutputStatus, bounds_status) ==
 static_assert(offsetof(mgis_mp_OutputStatus, msg) ==
               offsetof(mfront_gmp_OutputStatus, msg));
 static_assert(sizeof(mgis_size_type) == sizeof(mfront_gmp_size_type));
+static_assert(sizeof(mgis_mp_ExecutionOptions) ==
+              sizeof(mfront_gpmp_ExecutionOptions));
+static_assert(offsetof(mgis_mp_ExecutionOptions, preserve_stack_size) ==
+              offsetof(mfront_gpmp_ExecutionOptions, preserve_stack_size));
 static_assert(static_cast<int>(MGIS_MATERIALPROPERTY_STRICT_POLICY) ==
               static_cast<int>(GENERIC_MATERIALPROPERTY_STRICT_POLICY));
 
-- 
