From 3731baf6212f74cb923fecc6172c913157481a77 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 15 Oct 2026 00:11:45 +0200
Subject: [PATCH] Bindings: getAxialDeformationGradientOffset

C (mgis_bv_behaviour_get_axial_deformation_gradient_offset), Fortran
(behaviour_get_axial_deformation_gradient_offset, one-based offset) and
Python (getAxialDeformationGradientOffset, None without such a variable)
bindings, needed by the callers which provide their own arrays of
internal state variables. The C and Python tests check the offset and
the initial value for a behaviour written with the deformation gradient
in plane stress. Not bound in Julia, whose bindings can not be built
here (jlcxx not available).
---
 bindings/c/include/MGIS/Behaviour/Behaviour.h | 14 ++++++
 bindings/c/src/Behaviour.cxx                  | 11 +++++
 bindings/c/tests/DisplacementGradientTest-c.c | 48 ++++++++++++++++++-
 bindings/fortran/src/mgis_behaviour.f90       | 33 +++++++++++++
 bindings/python/src/Behaviour.cxx             |  4 ++
 .../python/tests/DisplacementGradientTest.py  | 17 +++++++
 docs/web/bindings-cxx.md                      |  2 +-
 7 files changed, 127 insertions(+), 2 deletions(-)

diff --git a/bindings/c/include/MGIS/Behaviour/Behaviour.h b/bindings/c/include/MGIS/Behaviour/Behaviour.h
index 8f7bb0c..e991ef6 100644
--- a/bindings/c/include/MGIS/Behaviour/Behaviour.h
+++ b/bindings/c/include/MGIS/Behaviour/Behaviour.h
@@ -243,6 +243,20 @@ MGIS_C_EXPORT mgis_status mgis_bv_behaviour_get_tangent_operator_array_size(
  */
 MGIS_C_EXPORT mgis_status mgis_bv_behaviour_uses_displacement_gradient(
     int* const, const mgis_bv_Behaviour* const);
+/*!
+ * \brief get the offset of the `AxialDeformationGradient` internal state
+ * variable of a finite strain behaviour in plane stress, which holds the
+ * axial component of the deformation gradient computed by a behaviour
+ * written with the deformation gradient. The states allocated by MGIS set
+ * this variable to one: a caller that provides its own arrays of internal
+ * state variables must do the same.
+ * \param[out] r: 1 if the behaviour has such a variable, 0 otherwise
+ * \param[out] o: offset of the variable, if any
+ * \param[in] b: behaviour
+ */
+MGIS_C_EXPORT mgis_status
+mgis_bv_behaviour_get_axial_deformation_gradient_offset(
+    int* const, mgis_size_type* const, const mgis_bv_Behaviour* const);
 /*
  * The following rotation functions report a failure for a behaviour which
  * provides no rotation function of an integration point: an isotropic
diff --git a/bindings/c/src/Behaviour.cxx b/bindings/c/src/Behaviour.cxx
index 9cb0324..59e2b6e 100644
--- a/bindings/c/src/Behaviour.cxx
+++ b/bindings/c/src/Behaviour.cxx
@@ -400,6 +400,17 @@ mgis_status mgis_bv_behaviour_uses_displacement_gradient(
   return mgis_report_success();
 }  // end of mgis_bv_behaviour_uses_displacement_gradient
 
+mgis_status mgis_bv_behaviour_get_axial_deformation_gradient_offset(
+    int* const r, mgis_size_type* const o, const mgis_bv_Behaviour* const b) {
+  if ((r == nullptr) || (o == nullptr) || (b == nullptr)) {
+    return mgis_report_failure("invalid argument");
+  }
+  const auto offset = mgis::behaviour::getAxialDeformationGradientOffset(*b);
+  *r = static_cast<int>(offset.has_value());
+  *o = offset.value_or(0);
+  return mgis_report_success();
+}  // end of mgis_bv_behaviour_get_axial_deformation_gradient_offset
+
 mgis_status mgis_bv_behaviour_get_library(const char** l,
                                           const mgis_bv_Behaviour* const b) {
   if (b == nullptr) {
diff --git a/bindings/c/tests/DisplacementGradientTest-c.c b/bindings/c/tests/DisplacementGradientTest-c.c
