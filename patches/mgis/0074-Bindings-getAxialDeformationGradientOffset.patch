@@ -15,6 +15,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include "MGIS/Behaviour/Behaviour.h"
+#include "MGIS/Behaviour/MaterialDataManager.h"
 
 int test_status = EXIT_SUCCESS;
 
@@ -62,6 +63,50 @@ static void test(const char* const* argv,
   check_status(mgis_bv_free_behaviour(&b));
 }  // end of test
 
+/*!
+ * \brief offset and initial value of the axial deformation gradient of a
+ * behaviour written with the deformation gradient in plane stress (the
+ * Green-Lagrange strain is stored before it), and absence of this variable
+ * for the behaviour given on the command line, written in a strain
+ * framework
+ */
+static void test_axial_deformation_gradient(const char* const* argv) {
+  mgis_bv_Behaviour* b;
+  mgis_bv_FiniteStrainBehaviourOptions* o;
+  int r;
+  mgis_size_type offset;
+  check_status(mgis_bv_create_finite_strain_behaviour_options(&o));
+  check_status(mgis_bv_load_finite_strain_behaviour(
+      &b, o, argv[1], "SaintVenantKirchhoffElasticity", "PlaneStress"));
+  check_status(
+      mgis_bv_behaviour_get_axial_deformation_gradient_offset(&r, &offset, b));
+  if (check(r == 1, "no axial deformation gradient")) {
+    mgis_bv_MaterialDataManager* m;
+    mgis_bv_MaterialStateManager* s0;
+    mgis_real* isvs;
+    mgis_size_type stride;
+    check(offset == 4, "invalid offset of the axial deformation gradient");
+    check_status(mgis_bv_create_material_data_manager(&m, b, 2));
+    check_status(mgis_bv_material_data_manager_get_state_0(&s0, m));
+    check_status(
+        mgis_bv_material_state_manager_get_internal_state_variables(&isvs, s0));
+    check_status(
+        mgis_bv_material_state_manager_get_internal_state_variables_stride(
+            &stride, s0));
+    check((isvs[offset] == 1) && (isvs[stride + offset] == 1),
+          "invalid initial value of the axial deformation gradient");
+    check_status(mgis_bv_free_material_data_manager(&m));
+  }
+  check_status(mgis_bv_free_behaviour(&b));
+  check_status(mgis_bv_load_finite_strain_behaviour(&b, o, argv[1], argv[2],
+                                                    "PlaneStress"));
+  check_status(
+      mgis_bv_behaviour_get_axial_deformation_gradient_offset(&r, &offset, b));
+  check(r == 0, "unexpected axial deformation gradient");
+  check_status(mgis_bv_free_finite_strain_behaviour_options(&o));
+  check_status(mgis_bv_free_behaviour(&b));
+}  // end of test_axial_deformation_gradient
+
 int main(const int argc, const char* const* argv) {
   if (!check(argc == 3, "expected three arguments")) {
     return EXIT_FAILURE;
@@ -72,5 +117,6 @@ int main(const int argc, const char* const* argv) {
   test(argv, "F", MGIS_BV_DEFORMATION_GRADIENT, 0);
   test(argv, "DisplacementGradient", MGIS_BV_DEFORMATION_GRADIENT, 1);
   test(argv, "H", MGIS_BV_DEFORMATION_GRADIENT, 1);
+  test_axial_deformation_gradient(argv);
   return test_status;
 }  // end of main
diff --git a/bindings/fortran/src/mgis_behaviour.f90 b/bindings/fortran/src/mgis_behaviour.f90
index e7d9234..41771ea 100644
--- a/bindings/fortran/src/mgis_behaviour.f90
+++ b/bindings/fortran/src/mgis_behaviour.f90
@@ -856,6 +856,39 @@ contains
        r = .true.
     end if
   end function behaviour_uses_displacement_gradient
+  ! behaviour_get_axial_deformation_gradient_offset
+  function behaviour_get_axial_deformation_gradient_offset(r,o,b) result(s)
+    use, intrinsic :: iso_c_binding, only: c_int, c_size_t
+    use mgis_fortran_utilities
+    use mgis, only: mgis_status
+    implicit none
+    interface
+       function behaviour_get_axial_deformation_gradient_offset_wrapper(r,o,b) &
+            bind(c,name = 'mgis_bv_behaviour_get_axial_deformation_gradient_offset') &
+            result(s)
+         use, intrinsic :: iso_c_binding, only: c_int, c_size_t, c_ptr
+         use mgis, only: mgis_status
+         implicit none
+         integer(kind=c_int), intent(out) :: r
+         integer(kind=c_size_t), intent(out) :: o
+         type(c_ptr), intent(in), value :: b
+         type(mgis_status) :: s
+       end function behaviour_get_axial_deformation_gradient_offset_wrapper
+    end interface
+    logical, intent(out) :: r
+    integer, intent(out) :: o
+    type(behaviour), intent(in) :: b
+    type(mgis_status) :: s
+    integer(kind=c_int) :: ri
+    integer(kind=c_size_t) :: offset
+    s = behaviour_get_axial_deformation_gradient_offset_wrapper(ri, offset, b%ptr)
+    if (ri .eq. 0) then
+       r = .false.
+    else
+       r = .true.
+    end if
+    o = offset + 1
+  end function behaviour_get_axial_deformation_gradient_offset
   ! behaviour_get_library
   function behaviour_get_library(l,b) result(s)
     use mgis_fortran_utilities
