+        # axial deformation gradient of a behaviour written with the
+        # deformation gradient in plane stress, stored after the
+        # Green-Lagrange strain and initialized to one
+        ps = mgis_bv.Hypothesis.PlaneStress
+        o = mgis_bv.FiniteStrainBehaviourOptions()
