+/*!
+ * \brief initialize functions: inputs given point by point, uniform inputs,
+ * no input, range of points
+ */
+static void testInitializeFunctions(const std::string& library,
+                                    const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{16};
+  auto managers = Managers(library, gp_library, "InitializeFunctionTest", n);
+  managers.apply([](MaterialDataManager& m) {
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+  });
+  // compare the states at the end of the time step
+  auto compare_states = [&managers](const std::string& name) {
+    check(compare(managers.m.s1.thermodynamic_forces,
+                  managers.gp_m.s1.thermodynamic_forces, 1e8) < 1e-12,
+          name + ": invalid thermodynamic forces");
+    check(compare(managers.m.s1.internal_state_variables,
+                  managers.gp_m.s1.internal_state_variables, 1) < 1e-12,
+          name + ": invalid internal state variables");
+  };
+  auto pressures = std::vector<mgis::real>(n);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    pressures[i] = -1e5 * static_cast<double>(i + 1);
+  }
+  const auto pressure = std::vector<mgis::real>{-3e5};
+  auto r = executeInitializeFunction(managers.m, "StressFromInitialPressure",
+                                     pressure);
+  auto gp_r = executeInitializeFunction(managers.gp_m,
+                                        "StressFromInitialPressure", pressure);
+  check(gp_r.exit_status == 1, "StressFromInitialPressure: invalid status");
+  compare_states("StressFromInitialPressure, uniform input");
+  r = executeInitializeFunction(managers.m, "StressFromInitialPressure",
+                                pressures);
+  gp_r = executeInitializeFunction(managers.gp_m, "StressFromInitialPressure",
+                                   pressures);
+  compare_states("StressFromInitialPressure");
+  // the elastic strain is computed from the stress at the beginning of the
+  // time step, which depends on the point
+  managers.apply([](MaterialDataManager& m) { update(m); });
+  r = executeInitializeFunction(managers.m, "ElasticStrainFromInitialStress", 2,
+                                12);
+  gp_r = executeInitializeFunction(managers.gp_m,
+                                   "ElasticStrainFromInitialStress", 2, 12);
+  check(gp_r.exit_status == 1,
+        "ElasticStrainFromInitialStress: invalid status");
+  compare_states("ElasticStrainFromInitialStress, range");
+}  // end of testInitializeFunctions
+
+//! \brief post-processing
+static void testPostProcessing(const std::string& library,
+                               const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{16};
+  auto managers = Managers(library, gp_library, "PostProcessingTest", n);
+  managers.apply([](MaterialDataManager& m) {
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    for (mgis::size_type i = 0; i != m.n; ++i) {
+      for (mgis::size_type c = 0; c != 3; ++c) {
+        m.s1.gradients[i * m.s1.gradients_stride + c] =
+            1e-3 * static_cast<double>((i + 1) * (c + 1));
+      }
+      m.s1.gradients[i * m.s1.gradients_stride + 3] = 1e-4;
+    }
+  });
+  auto outputs = allocatePostProcessingVariables(managers.m, "PrincipalStrain");
+  auto gp_outputs =
+      allocatePostProcessingVariables(managers.gp_m, "PrincipalStrain");
+  const auto r = executePostProcessing(outputs, managers.m, "PrincipalStrain");
+  const auto gp_r =
+      executePostProcessing(gp_outputs, managers.gp_m, "PrincipalStrain");
+  check(gp_r.exit_status == 1, "PrincipalStrain: invalid status");
+  check(compare(outputs, gp_outputs, 1) < 1e-14,
+        "PrincipalStrain: invalid outputs");
+  static_cast<void>(r);
+}  // end of testPostProcessing
