+   * manager.
+   * \param[in] f: initialize function
+   * \param[in] inputs: inputs of the initialize function, or null
+   */
+  static BehaviourIntegrationResult executeBatchInitializeFunction(
+      MaterialDataManager& m,
+      const BehaviourInitializeFunction& f,
+      const ConstField* const inputs,
+      const size_type b,
+      const size_type e) {
+    if (b == e) {
+      return BehaviourIntegrationResult{};
+    }
+    auto d = BatchData(m.batch_execution_policy, m, b, e);
+    auto o = BatchOutputStatus{};
+    const auto status = f.batch_f(&o, &(d.view), inputs);
+    return getBatchResult("executeInitializeFunction", status, o, b);
+  }  // end of executeBatchInitializeFunction
+
