+  /*!
+   * \brief integrate a behaviour generated by the `generic-parallel`
+   * interface on the points `[b, e)` of a material data manager.
+   */
+  static BehaviourIntegrationResult integrateBatch(
+      const BatchExecutionPolicy& p,
+      MaterialDataManager& m,
+      const BehaviourIntegrationOptions& opts,
+      const real dt,
+      const size_type b,
+      const size_type e) {
+    if (m.b.batch_b == nullptr) {
+      mgis::raise(
+          "integrate: the behaviour has not been generated by the "
+          "generic-parallel interface");
+    }
+    if (b == e) {
+      return BehaviourIntegrationResult{};
+    }
+    auto d = BatchData(p, m, b, e);
+    d.view.dt = dt;
+    d.view.options[0] = encodeBehaviourIntegrationOptions(opts);
+    // same initial value of the time step scaling factor as the integration
+    // point by point
+    d.view.rdt = BehaviourIntegrationResult{}.time_step_increase_factor;
+    if ((opts.integration_type !=
+         IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR) &&
+        (m.K_stride != 0)) {
+      d.view.tangent_operators = makeArrayBatchField(m.K, m.K_stride, b);
+    }
+    if (opts.compute_speed_of_sound) {
+      d.view.speed_of_sound = makeArrayBatchField(m.speed_of_sound, 1, b);
+    }
+    auto o = BatchOutputStatus{};
+    const auto status = m.b.batch_b(&o, &(d.view));
+    auto r = getBatchResult("integrate", status, o, b);
+    r.time_step_increase_factor = o.rdt;
+    return r;
   }  // end of integrateBatch
 
+  /*!
+   * \brief execute an initialize function of a behaviour generated by the
