+/*!
+ * \brief model integrated on the device, arrays allocated in managed memory
+ * by a memory resource
+ */
+static void testModel(const std::string& library,
+                      const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{100};
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  auto resource = mgis::memory_resources::CUDAManagedMemoryResource{};
+  const auto b = load(library, "ode_rk54", h);
+  const auto gpu_b = load(gpu_library, "ode_rk54", h);
+  auto i = MaterialDataManagerInitializer{};
+  i.location = MemoryLocation::SHARED;
+  i.resource = &resource;
+  auto m = MaterialDataManager(b, n);
+  auto gpu_m = MaterialDataManager(gpu_b, n, i);
+  auto temperature = ManagedArray(1);
+  temperature.span()[0] = 293.15;
+  for (auto* const s : {&m.s0, &m.s1}) {
+    setExternalStateVariable(*s, "Temperature", 293.15);
+  }
+  for (auto* const s : {&gpu_m.s0, &gpu_m.s1}) {
+    setExternalStateVariable(*s, "Temperature", temperature.span(),
+                             MaterialStateManager::EXTERNAL_STORAGE);
+  }
+  const auto o = getVariableOffset(b.isvs, "x", h);
+  for (auto* const mm : {&m, &gpu_m}) {
+    for (mgis::size_type j = 0; j != n; ++j) {
+      mm->s1
+          .internal_state_variables[j * mm->s1.internal_state_variables_stride +
+                                    o] = 1 + static_cast<double>(j) / n;
+    }
+    update(*mm);
+  }
+  // a parameter different from its default value is taken into account
+  setParameter(b, "A", 2.5);
+  setParameter(gpu_b, "A", 2.5);
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  for (int step = 0; step != 3; ++step) {
+    const auto r = integrate(m, opts, 0.1);
+    const auto gpu_r = integrate(gpu_m, opts, 0.1);
+    checkResults("ode_rk54, step " + std::to_string(step), r, gpu_r, m, gpu_m);
+    update(m);
+    update(gpu_m);
+  }
+}  // end of testModel
+
+/*!
+ * \brief material properties evaluated on the device, values in managed
+ * memory: values given point by point and uniform values, bounds checks,
+ * location of the values
+ */
+static void testMaterialProperties(const std::string& library,
+                                   const std::string& gpu_library) {
+  using namespace mgis::material_property;
+  constexpr auto n = mgis::size_type{1000};
+  const auto mp = load(library, "Inconel600_YoungModulus");
+  const auto gpu_mp = load(gpu_library, "Inconel600_YoungModulus");
+  check(isGenericParallelMaterialProperty(gpu_mp) &&
+            (gpu_mp.backend == "cuda") && (gpu_mp.memory_space == "device"),
+        "invalid description of the material property");
+  auto T = ManagedArray(n);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    T.span()[i] = 300 + static_cast<double>(i);
+  }
+  auto E = std::vector<mgis::real>(n);
+  auto gpu_E = ManagedArray(n);
+  const auto inputs = std::array{std::span<const mgis::real>(T.span())};
+  const auto s = evaluate(E, mp, inputs);
+  const auto gpu_s =
+      evaluate(gpu_E.span(), gpu_mp, inputs, MemoryLocation::SHARED);
+  check((s.status == 0) && (gpu_s.status == 0) &&
+            (compare(E, gpu_E.span(), 1e11) < 1e-12),
+        "Inconel600_YoungModulus: invalid values");
+  // uniform temperature
+  auto T0 = ManagedArray(1);
+  T0.span()[0] = 700;
+  const auto uniform_inputs =
+      std::array{std::span<const mgis::real>(T0.span())};
+  static_cast<void>(evaluate(E, mp, uniform_inputs));
+  static_cast<void>(
+      evaluate(gpu_E.span(), gpu_mp, uniform_inputs, MemoryLocation::SHARED));
+  check(compare(E, gpu_E.span(), 1e11) < 1e-12,
+        "Inconel600_YoungModulus, uniform input: invalid values");
+  // values in the memory of the host
+  check(throws([&gpu_E, &gpu_mp,
+                &inputs] { evaluate(gpu_E.span(), gpu_mp, inputs); },
+               "not accessible by the computations"),
+        "values in the memory of the host must be refused");
+  // bounds checks, the temperature of the third point being out of its
+  // bounds
+  const auto bmp = load(library, "MaterialPropertyBoundCheck");
+  const auto gpu_bmp = load(gpu_library, "MaterialPropertyBoundCheck");
+  auto bT = ManagedArray(4);
+  const auto values = std::array<mgis::real, 4>{250, 280, 350, 210};
+  std::copy(values.begin(), values.end(), bT.span().begin());
+  const auto b_inputs = std::array{std::span<const mgis::real>(bT.span())};
+  auto bE = std::vector<mgis::real>(4);
+  auto gpu_bE = ManagedArray(4);
+  for (const auto& [p, status] :
+       {std::pair{MGIS_MATERIALPROPERTY_WARNING_POLICY, 1},
+        std::pair{MGIS_MATERIALPROPERTY_STRICT_POLICY, -1}}) {
+    const auto bs = evaluate(bE, bmp, b_inputs, MemoryLocation::HOST, p);
+    const auto gpu_bs =
+        evaluate(gpu_bE.span(), gpu_bmp, b_inputs, MemoryLocation::SHARED, p);
+    check((bs.status == status) && (gpu_bs.status == status),
+          "MaterialPropertyBoundCheck: invalid status for policy " +
+              std::to_string(static_cast<int>(p)));
+  }
+}  // end of testMaterialProperties
+
 int main(const int argc, const char* const* const argv) {
