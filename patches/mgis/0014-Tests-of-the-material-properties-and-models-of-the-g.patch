new file mode 100644
index 0000000..f84c252
--- /dev/null
+++ b/tests/GenericParallelEvaluateTest.cxx
@@ -0,0 +1,213 @@
+/*!
+ * \file   tests/GenericParallelEvaluateTest.cxx
+ * \brief  This test loads material properties generated by the
+ * `generic-parallel` interface of `MFront` and compares their evaluation on
+ * sets of points with the evaluation point by point of the same material
+ * properties generated by the `generic` interface.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <array>
+#include <cmath>
+#include <span>
+#include <string>
+#include <vector>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+#include "MGIS/LibrariesManager.hxx"
+#include "MGIS/MaterialProperty/MaterialProperty.hxx"
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+/*!
+ * \return true if the given function throws an exception whose message
+ * contains the given text
+ */
+template <typename Function>
+static bool throws(const Function& f, const std::string_view text) {
+  try {
+    f();
+  } catch (std::exception& e) {
+    return std::string_view{e.what()}.find(text) != std::string_view::npos;
+  }
+  return false;
+}
+
+//! \return the maximum of the relative differences
+static double compare(const std::span<const mgis::real> a,
+                      const std::span<const mgis::real> b) {
+  auto d = 0.;
+  for (std::size_t i = 0; i != a.size(); ++i) {
+    d = std::max(d, std::abs(a[i] - b[i]) / std::abs(b[i]));
+  }
+  return d;
+}  // end of compare
+
+//! \brief loading and description of the material properties
+static void testLoad(const std::string& library,
+                     const std::string& gp_library) {
+  using namespace mgis::material_property;
+  const auto mp = load(library, "Inconel600_YoungModulus");
+  const auto gp_mp = load(gp_library, "Inconel600_YoungModulus");
+  check(!isGenericParallelMaterialProperty(mp) && (mp.fct != nullptr) &&
+            (mp.batch_fct == nullptr) && mp.backend.empty() &&
+            mp.memory_space.empty(),
+        "invalid description of the material property of a point");
+  check(isGenericParallelMaterialProperty(gp_mp) && (gp_mp.fct == nullptr) &&
+            (gp_mp.batch_fct != nullptr) && (gp_mp.backend == "stlpar") &&
+            (gp_mp.memory_space == "host"),
+        "invalid description of the material property of a set of points");
+  check((gp_mp.output == mp.output) && (gp_mp.inputs == mp.inputs),
+        "invalid output or inputs");
+  // the function of a point is refused for a library of sets of points, and
+  // conversely
+  auto& lm = mgis::LibrariesManager::get();
+  check(throws(
+            [&lm, &gp_library] {
+              lm.getMaterialProperty(gp_library, "Inconel600_YoungModulus");
+            },
+            "generated by the generic-parallel interface"),
+        "the function of a point must be refused");
+  check(throws(
+            [&lm, &library] {
+              lm.getBatchMaterialProperty(library, "Inconel600_YoungModulus");
+            },
+            "has not been generated by the generic-parallel interface"),
+        "the function of a set of points must be refused");
+}  // end of testLoad
+
+/*!
+ * \brief evaluation on a set of points: values given point by point,
+ * uniform value, physical bounds
+ */
+static void testEvaluate(const std::string& library,
+                         const std::string& gp_library) {
+  using namespace mgis::material_property;
+  const auto mp = load(library, "Inconel600_YoungModulus");
+  const auto gp_mp = load(gp_library, "Inconel600_YoungModulus");
+  constexpr auto n = std::size_t{10};
+  auto T = std::vector<mgis::real>(n);
+  for (std::size_t i = 0; i != n; ++i) {
+    T[i] = 300 + 50 * static_cast<double>(i);
+  }
+  auto E = std::vector<mgis::real>(n);
+  auto gp_E = std::vector<mgis::real>(n);
+  // values given point by point
+  const auto inputs = std::array{std::span<const mgis::real>(T)};
+  auto s = evaluate(E, mp, inputs);
+  auto gp_s = evaluate(gp_E, gp_mp, inputs);
+  check((s.status == 0) && (gp_s.status == 0) && (compare(E, gp_E) < 1e-14),
+        "Inconel600_YoungModulus: invalid values");
+  // uniform value
+  const auto T0 = std::array<mgis::real, 1>{700};
+  const auto uniform_inputs = std::array{std::span<const mgis::real>(T0)};
+  s = evaluate(E, mp, uniform_inputs);
+  gp_s = evaluate(gp_E, gp_mp, uniform_inputs);
+  check((s.status == 0) && (gp_s.status == 0) && (compare(E, gp_E) < 1e-14) &&
+            (std::abs(gp_E[n - 1] - gp_E[0]) < 1e-14 * gp_E[0]),
+        "Inconel600_YoungModulus, uniform input: invalid values");
+  // a temperature out of its physical bounds
+  T[3] = -1;
+  s = evaluate(E, mp, inputs);
+  gp_s = evaluate(gp_E, gp_mp, inputs);
+  check((s.status == -1) && (gp_s.status == -1),
+        "Inconel600_YoungModulus: the physical bounds must be checked");
+}  // end of testEvaluate
+
+/*!
+ * \brief bounds checks: the status depends on the out of bounds policy, as
+ * for the evaluation point by point
+ */
+static void testBounds(const std::string& library,
+                       const std::string& gp_library) {
+  using namespace mgis::material_property;
+  const auto mp = load(library, "MaterialPropertyBoundCheck");
+  const auto gp_mp = load(gp_library, "MaterialPropertyBoundCheck");
+  // the temperature of the third point is out of its bounds, [200:300]
+  const auto T = std::array<mgis::real, 4>{250, 280, 350, 210};
+  const auto inputs = std::array{std::span<const mgis::real>(T)};
+  auto E = std::vector<mgis::real>(T.size());
+  auto gp_E = std::vector<mgis::real>(T.size());
+  for (const auto& [p, status] :
+       {std::pair{MGIS_MATERIALPROPERTY_NONE_POLICY, 0},
+        std::pair{MGIS_MATERIALPROPERTY_WARNING_POLICY, 1},
+        std::pair{MGIS_MATERIALPROPERTY_STRICT_POLICY, -1}}) {
+    const auto s = evaluate(E, mp, inputs, MemoryLocation::HOST, p);
+    const auto gp_s = evaluate(gp_E, gp_mp, inputs, MemoryLocation::HOST, p);
+    check((s.status == status) && (gp_s.status == status),
+          "MaterialPropertyBoundCheck: invalid status for policy " +
+              std::to_string(static_cast<int>(p)) + " (" +
+              std::to_string(s.status) + ", " + std::to_string(gp_s.status) +
+              ")");
+    if (status >= 0) {
+      check(compare(E, gp_E) < 1e-14,
+            "MaterialPropertyBoundCheck: invalid values");
+    }
+  }
+}  // end of testBounds
+
+//! \brief invalid arguments and locations of the values
+static void testInvalidArguments(const std::string& library,
+                                 const std::string& gp_library) {
+  using namespace mgis::material_property;
+  const auto mp = load(library, "Inconel600_YoungModulus");
+  const auto gp_mp = load(gp_library, "Inconel600_YoungModulus");
+  auto E = std::vector<mgis::real>(4);
+  const auto T = std::vector<mgis::real>(4, 500);
+  const auto inputs = std::array{std::span<const mgis::real>(T)};
+  // the computations of the backend are performed on the host
+  check(
+      throws([&E, &gp_mp,
+              &inputs] { evaluate(E, gp_mp, inputs, MemoryLocation::DEVICE); },
+             "not accessible by the computations"),
+      "values located on a device must be refused");
+  check(evaluate(E, gp_mp, inputs, MemoryLocation::SHARED).status == 0,
+        "values located in a shared memory must be accepted");
+  check(throws([&E, &mp,
+                &inputs] { evaluate(E, mp, inputs, MemoryLocation::DEVICE); },
+               "not accessible by the computations"),
+        "values located on a device must be refused point by point");
+  // number of inputs and of values
+  check(throws([&E, &gp_mp] { evaluate(E, gp_mp, {}); },
+               "invalid number of inputs"),
+        "a missing input must be refused");
+  const auto T3 = std::vector<mgis::real>(3, 500);
+  const auto inputs3 = std::array{std::span<const mgis::real>(T3)};
+  check(throws([&E, &gp_mp, &inputs3] { evaluate(E, gp_mp, inputs3); },
+               "invalid number of values"),
+        "an invalid number of values must be refused");
+}  // end of testInvalidArguments
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-library generic-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    testLoad(argv[2], argv[1]);
+    testEvaluate(argv[2], argv[1]);
+    testBounds(argv[2], argv[1]);
+    testInvalidArguments(argv[2], argv[1]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
