+/*!
+ * \brief model generated by the `generic-parallel` interface, loaded and
+ * integrated as a behaviour, several time steps
+ */
+static void testModel(const std::string& library,
+                      const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{20};
+  auto managers = Managers(library, gp_library, "ode_rk54", n);
+  check(isGenericParallelBehaviour(managers.gp_b),
+        "ode_rk54: invalid interface");
+  managers.apply([](MaterialDataManager& m) {
+    const auto o = getVariableOffset(m.b.isvs, "x", m.b.hypothesis);
+    for (mgis::size_type i = 0; i != m.n; ++i) {
+      m.s1.internal_state_variables[i * m.s1.internal_state_variables_stride +
+                                    o] = 1 + static_cast<double>(i) / m.n;
+    }
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+    update(m);
+  });
+  // a parameter different from its default value is taken into account
+  setParameter(managers.b, "A", 2.5);
+  setParameter(managers.gp_b, "A", 2.5);
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  for (int step = 0; step != 5; ++step) {
+    managers.integrate("ode_rk54, step " + std::to_string(step), opts, 0.1);
+    managers.apply([](MaterialDataManager& m) { update(m); });
+  }
+}  // end of testModel
+
