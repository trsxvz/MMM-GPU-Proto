+    }
+  }  // end of checkHIPStatus
+
+}  // end of namespace mgis::field_operations::internals
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in the memory of a device
+   * (or in managed memory), with the runtime of HIP.
+   *
+   * The operations are asynchronous: they are submitted to the given stream,
+   * which the calling code must synchronize before reading the values on the
+   * host. A copy between two views with the same dense layout is a copy of a
+   * contiguous memory region; the other copies, and the fills by a non null
+   * value, launch a kernel.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with hipcc or clang (HIP).
+   */
+  struct HIPFieldOperations final : FieldOperations {
+    //! \param[in] s: stream (the default stream if null)
+    explicit HIPFieldOperations(const hipStream_t s = nullptr) noexcept : stream(s) {}
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      if (haveSameDenseLayout(d, s)) {
+        internals::checkHIPStatus(
+            hipMemcpyAsync(d.data(), s.data(), nv * sizeof(real), hipMemcpyDefault,
+                            this->stream),
+            "HIPFieldOperations::copy");
+        return;
+      }
+      internals::hipCopyFieldView<real>
+          <<<(nv + block_size - 1) / block_size, block_size, 0, this->stream>>>(
+              d.data(), d.getPointStride(), d.getComponentStride(), s.data(),
+              s.getPointStride(), s.getComponentStride(), n, nv);
+      internals::checkHIPStatus(hipGetLastError(), "HIPFieldOperations::copy");
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      if ((isDense(d)) && (std::bit_cast<std::uint64_t>(v) == 0)) {
+        // positive zero: all the bytes are null
+        internals::checkHIPStatus(
+            hipMemsetAsync(d.data(), 0, nv * sizeof(real), this->stream),
+            "HIPFieldOperations::fill");
+        return;
+      }
+      internals::hipFillFieldView<real>
+          <<<(nv + block_size - 1) / block_size, block_size, 0, this->stream>>>(
+              d.data(), d.getPointStride(), d.getComponentStride(), n, nv, v);
+      internals::checkHIPStatus(hipGetLastError(), "HIPFieldOperations::fill");
+    }  // end of do_fill
+    //! \brief number of threads of a block
+    static constexpr size_type block_size = 256;
+    //! \brief stream
+    hipStream_t stream;
+  };  // end of HIPFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_HIPFIELDOPERATIONS_HXX */
diff --git a/include/MGIS/FieldOperations/KokkosFieldOperations.hxx b/include/MGIS/FieldOperations/KokkosFieldOperations.hxx
new file mode 100644
index 0000000..b55632a
--- /dev/null
+++ b/include/MGIS/FieldOperations/KokkosFieldOperations.hxx
@@ -0,0 +1,108 @@
+/*!
+ * \file   include/MGIS/FieldOperations/KokkosFieldOperations.hxx
+ * \brief  This file declares the `KokkosFieldOperations` class, which copies
+ * and fills views with an instance of a Kokkos execution space.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_KOKKOSFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_KOKKOSFIELDOPERATIONS_HXX
+
+#include <Kokkos_Core.hpp>
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis::field_operations::internals {
+
+  /*!
+   * \brief copy the values of a view in another one, one thread per value
+   * (free function: an extended lambda can't be defined in a private member
+   * function with CUDA)
+   */
+  template <typename ExecutionSpace>
+  void kokkosCopyFieldView(const ExecutionSpace& space,
+                           real* const dv,
+                           const size_type dps,
+                           const size_type dcs,
+                           const real* const sv,
+                           const size_type sps,
+                           const size_type scs,
+                           const size_type n,
+                           const size_type nv) {
+    Kokkos::parallel_for(
+        "mgis::field_operations::copy",
+        Kokkos::RangePolicy<ExecutionSpace>(space, 0, nv),
+        KOKKOS_LAMBDA(const size_type k) {
+          // consecutive threads process consecutive points of a component
+          const auto i = k % n;
+          const auto j = k / n;
+          dv[i * dps + j * dcs] = sv[i * sps + j * scs];
+        });
+  }  // end of kokkosCopyFieldView
+
+  //! \brief fill a view, one thread per value
+  template <typename ExecutionSpace>
+  void kokkosFillFieldView(const ExecutionSpace& space,
+                           real* const dv,
+                           const size_type ps,
+                           const size_type cs,
+                           const size_type n,
+                           const size_type nv,
+                           const real v) {
+    Kokkos::parallel_for(
+        "mgis::field_operations::fill",
+        Kokkos::RangePolicy<ExecutionSpace>(space, 0, nv),
+        KOKKOS_LAMBDA(const size_type k) {
+          dv[(k % n) * ps + (k / n) * cs] = v;
+        });
+  }  // end of kokkosFillFieldView
+
+}  // end of namespace mgis::field_operations::internals
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in memory accessible by the
+   * given execution space, with an instance of this execution space.
+   *
+   * The operations are submitted to the instance: the calling code must
+   * fence the instance before reading the values on the host.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with its Kokkos installation.
+   *
+   * \tparam ExecutionSpace: Kokkos execution space
+   */
+  template <typename ExecutionSpace = Kokkos::DefaultExecutionSpace>
+  struct KokkosFieldOperations final : FieldOperations {
+    //! \param[in] e: instance of the execution space
+    explicit KokkosFieldOperations(const ExecutionSpace& e = ExecutionSpace{})
+        : space(e) {}
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      internals::kokkosCopyFieldView(
+          this->space, d.data(), d.getPointStride(), d.getComponentStride(),
+          s.data(), s.getPointStride(), s.getComponentStride(), n,
+          n * d.getNumberOfComponents());
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      const auto n = d.getNumberOfPoints();
+      internals::kokkosFillFieldView(this->space, d.data(), d.getPointStride(),
+                                     d.getComponentStride(), n,
+                                     n * d.getNumberOfComponents(), v);
+    }  // end of do_fill
+    //! \brief instance of the execution space
+    ExecutionSpace space;
+  };  // end of KokkosFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_KOKKOSFIELDOPERATIONS_HXX */
diff --git a/include/MGIS/FieldOperations/OpenMPFieldOperations.hxx b/include/MGIS/FieldOperations/OpenMPFieldOperations.hxx
new file mode 100644
index 0000000..39e1b1f
--- /dev/null
+++ b/include/MGIS/FieldOperations/OpenMPFieldOperations.hxx
@@ -0,0 +1,78 @@
+/*!
+ * \file   include/MGIS/FieldOperations/OpenMPFieldOperations.hxx
+ * \brief  This file declares the `OpenMPFieldOperations` class, which copies
+ * and fills views located in the memory of a device with the offloading
+ * directives of OpenMP.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_OPENMPFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_OPENMPFIELDOPERATIONS_HXX
+
+#include <omp.h>
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in the memory of a device,
+   * with the offloading directives of OpenMP.
+   *
+   * The addresses of the views must be addresses of the device (for
+   * instance, allocated by `omp_target_alloc`). The operations are
+   * synchronous.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with a compiler supporting the offloading of OpenMP.
+   */
+  struct OpenMPFieldOperations final : FieldOperations {
+    //! \param[in] d: device
+    explicit OpenMPFieldOperations(const int d = omp_get_default_device()) noexcept
+        : device(d) {}
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      auto* const dv = d.data();
+      const auto dps = d.getPointStride();
+      const auto dcs = d.getComponentStride();
+      const auto* const sv = s.data();
+      const auto sps = s.getPointStride();
+      const auto scs = s.getComponentStride();
+      const auto dev = this->device;
+#pragma omp target teams distribute parallel for device(dev) \
+    is_device_ptr(dv, sv)
+      for (size_type k = 0; k < nv; ++k) {
+        // consecutive threads process consecutive points of a component
+        const auto i = k % n;
+        const auto j = k / n;
+        dv[i * dps + j * dcs] = sv[i * sps + j * scs];
+      }
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      auto* const dv = d.data();
+      const auto ps = d.getPointStride();
+      const auto cs = d.getComponentStride();
+      const auto dev = this->device;
+#pragma omp target teams distribute parallel for device(dev) is_device_ptr(dv)
+      for (size_type k = 0; k < nv; ++k) {
+        dv[(k % n) * ps + (k / n) * cs] = v;
+      }
+    }  // end of do_fill
+    //! \brief device
+    int device;
+  };  // end of OpenMPFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_OPENMPFIELDOPERATIONS_HXX */
diff --git a/include/MGIS/FieldOperations/SYCLFieldOperations.hxx b/include/MGIS/FieldOperations/SYCLFieldOperations.hxx
new file mode 100644
index 0000000..26d2ffe
--- /dev/null
+++ b/include/MGIS/FieldOperations/SYCLFieldOperations.hxx
@@ -0,0 +1,84 @@
+/*!
+ * \file   include/MGIS/FieldOperations/SYCLFieldOperations.hxx
+ * \brief  This file declares the `SYCLFieldOperations` class, which copies
+ * and fills views with a SYCL queue.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_SYCLFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_SYCLFIELDOPERATIONS_HXX
+
+#include <sycl/sycl.hpp>
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in memory allocated by the
+   * unified shared memory of SYCL (device or shared memory), with a SYCL
+   * queue.
+   *
+   * The operations are submitted to the queue. With an in-order queue, they
+   * are ordered with the other computations submitted to the queue: the
+   * calling code must wait for the queue before reading the values on the
+   * host. With an out-of-order queue, the calling code must wait for the
+   * queue before submitting computations which depend on them.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with its SYCL compiler.
+   */
+  struct SYCLFieldOperations final : FieldOperations {
+    //! \param[in] q: queue
+    explicit SYCLFieldOperations(sycl::queue& q) noexcept : queue(q) {}
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      if (haveSameDenseLayout(d, s)) {
+        this->queue.memcpy(d.data(), s.data(), nv * sizeof(real));
+        return;
+      }
+      auto* const dv = d.data();
+      const auto dps = d.getPointStride();
+      const auto dcs = d.getComponentStride();
+      const auto* const sv = s.data();
+      const auto sps = s.getPointStride();
+      const auto scs = s.getComponentStride();
+      this->queue.parallel_for(sycl::range<1>(nv), [=](const sycl::id<1> id) {
+        const auto k = static_cast<size_type>(id[0]);
+        // consecutive work-items process consecutive points of a component
+        const auto i = k % n;
+        const auto j = k / n;
+        dv[i * dps + j * dcs] = sv[i * sps + j * scs];
+      });
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      if (isDense(d)) {
+        this->queue.fill(d.data(), v, nv);
+        return;
+      }
+      auto* const dv = d.data();
+      const auto ps = d.getPointStride();
+      const auto cs = d.getComponentStride();
+      this->queue.parallel_for(sycl::range<1>(nv), [=](const sycl::id<1> id) {
+        const auto k = static_cast<size_type>(id[0]);
+        dv[(k % n) * ps + (k / n) * cs] = v;
+      });
+    }  // end of do_fill
+    //! \brief queue
+    sycl::queue& queue;
+  };  // end of SYCLFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_SYCLFIELDOPERATIONS_HXX */
