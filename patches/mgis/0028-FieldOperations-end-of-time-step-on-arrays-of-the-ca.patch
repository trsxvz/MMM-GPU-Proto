+    d[i * dps + j * dcs] = s[i * sps + j * scs];
+  }  // end of hipCopyFieldView
+
+  //! \brief fill a view, one thread per value
+  template <typename ValueType>
+  __global__ void hipFillFieldView(ValueType* const d,
+                                  const size_type ps,
+                                  const size_type cs,
+                                  const size_type n,
+                                  const size_type nv,
+                                  const ValueType v) {
+    const auto k = static_cast<size_type>(blockIdx.x) * blockDim.x + threadIdx.x;
