--- /dev/null
+++ b/tests/FieldOperationsCUDATest.cu
@@ -0,0 +1,320 @@
+/*!
+ * \file   tests/FieldOperationsCUDATest.cu
+ * \brief  This test checks the field operations of the
+ * `MGIS/FieldOperations/CUDAFieldOperations.hxx` header, and a complete cycle
+ * on the GPU: integration of a behaviour generated by the `generic-parallel`
+ * interface with the `cuda` backend on arrays located in the memory of the
+ * device only, stored component by component, and update of the states on
+ * the device. The results are compared to the integration point by point on
+ * the host. Asynchronous computations whose statuses are allocated by a pool
+ * of managed memory are also checked.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <cmath>
+#include <span>
+#include <array>
+#include <string>
+#include <vector>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+#include <memory_resource>
+#include <cuda_runtime.h>
+#include "MGIS/FieldView.hxx"
+#include "MGIS/FieldOperations/CUDAFieldOperations.hxx"
+#include "MGIS/MemoryResources/CUDAManagedMemoryResource.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/MaterialDataView.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+
+using mgis::real;
+using mgis::size_type;
+using mgis::FieldView;
+using mgis::FieldLayout;
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+/*!
+ * \return true if the given function throws an exception whose message
+ * contains the given text
+ */
+template <typename Function>
+static bool throws(const Function& f, const std::string_view text) {
+  try {
+    f();
+  } catch (std::exception& e) {
+    return std::string_view{e.what()}.find(text) != std::string_view::npos;
+  }
+  return false;
+}
+
+static void checkCUDA(const cudaError_t e, const char* const f) {
+  if (e != cudaSuccess) {
+    throw std::runtime_error(std::string{f} + ": " + cudaGetErrorString(e));
+  }
+}
+
+//! \brief array in the memory of the device only
+struct DeviceArray {
+  explicit DeviceArray(const size_type n) : size(n) {
+    checkCUDA(cudaMalloc(&(this->values), n * sizeof(real)), "cudaMalloc");
+  }
+  DeviceArray(DeviceArray&&) = delete;
+  DeviceArray(const DeviceArray&) = delete;
+  ~DeviceArray() { static_cast<void>(cudaFree(this->values)); }
+  std::span<real> span() const { return {this->values, this->size}; }
+  void copyFrom(const std::vector<real>& v) {
+    checkCUDA(cudaMemcpy(this->values, v.data(), v.size() * sizeof(real),
+                         cudaMemcpyHostToDevice),
+              "cudaMemcpy");
+  }
+  std::vector<real> copyToHost() const {
+    auto v = std::vector<real>(this->size);
+    checkCUDA(cudaMemcpy(v.data(), this->values, v.size() * sizeof(real),
+                         cudaMemcpyDeviceToHost),
+              "cudaMemcpy");
+    return v;
+  }
+  real* values = nullptr;
+  size_type size;
+};
+
+//! \brief copies and fills of views in the memory of the device
+static void testFieldOperations() {
+  constexpr auto n = size_type{37};
+  constexpr auto nc = size_type{3};
+  auto values = std::vector<real>(n * nc);
+  for (size_type k = 0; k != values.size(); ++k) {
+    values[k] = static_cast<real>(k);
+  }
+  auto a = DeviceArray(n * nc);      // point by point
+  auto c = DeviceArray(nc * (n + 5));  // component by component, padded
+  auto d = DeviceArray(n * nc);      // point by point
+  a.copyFrom(values);
+  auto stream = cudaStream_t{};
+  checkCUDA(cudaStreamCreate(&stream), "cudaStreamCreate");
+  auto ops = mgis::field_operations::CUDAFieldOperations{stream};
+  const auto va =
+      mgis::makeFieldView(a.span(), FieldLayout::POINT_BY_POINT, n, nc);
+  const auto vc =
+      mgis::makeComponentByComponentFieldView(c.span(), n, nc, n + 5);
+  const auto vd =
+      mgis::makeFieldView(d.span(), FieldLayout::POINT_BY_POINT, n, nc);
+  ops.fill(FieldView<real>(c.span(), 1, c.size, c.size, 1), -1);
+  ops.copy(vc, va);  // transposition
+  ops.copy(vd, vc);  // transposition
+  checkCUDA(cudaStreamSynchronize(stream), "cudaStreamSynchronize");
+  check(d.copyToHost() == values, "CUDAFieldOperations: invalid copies");
+  const auto pc = c.copyToHost();
+  check((pc[n] == -1) && (pc[2 * (n + 5) + n + 4] == -1) &&
+            (pc[(n + 5) + 2] == values[2 * nc + 1]),
+        "CUDAFieldOperations: invalid component by component copy");
+  ops.fill(vd, 0);  // memset
+  ops.copy(va, vd);  // contiguous copy
+  ops.fill(mgis::getComponents(vc, 1, 1), 2.5);  // kernel
+  checkCUDA(cudaStreamSynchronize(stream), "cudaStreamSynchronize");
+  check(a.copyToHost() == std::vector<real>(n * nc, 0),
+        "CUDAFieldOperations: invalid fill");
+  const auto pc2 = c.copyToHost();
+  check((pc2[(n + 5) + 3] == 2.5) && (pc2[3] == values[3 * nc]),
+        "CUDAFieldOperations: invalid fill of a component");
+  checkCUDA(cudaStreamDestroy(stream), "cudaStreamDestroy");
+}  // end of testFieldOperations
+
+/*!
+ * \brief integration of the Norton behaviour on the device, arrays stored
+ * component by component in the memory of the device only, update of the
+ * states on the device, compared to the integration point by point on the
+ * host
+ */
+static void testIntegrationCycle(const std::string& gp_library,
+                                 const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto gp_b = load(gp_library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{64};
+  const auto gs = getArraySize(b.gradients, b.hypothesis);
+  const auto ts = getArraySize(b.thermodynamic_forces, b.hypothesis);
+  const auto is = getArraySize(b.isvs, b.hypothesis);
+  const auto Ks = getTangentOperatorArraySize(b);
+  // reference on the host, point by point
+  auto r = MaterialDataManager(b, n);
+  setExternalStateVariable(r.s0, "Temperature", 293.15);
+  setExternalStateVariable(r.s1, "Temperature", 293.15);
+  // arrays on the device, component by component
+  auto g0 = DeviceArray(n * gs), g1 = DeviceArray(n * gs);
+  auto t0 = DeviceArray(n * ts), t1 = DeviceArray(n * ts);
+  auto i0 = DeviceArray(n * is), i1 = DeviceArray(n * is);
+  auto K = DeviceArray(n * Ks);
+  auto e0 = DeviceArray(n), e1 = DeviceArray(n), d0 = DeviceArray(n),
+       d1 = DeviceArray(n);
+  auto T = DeviceArray(1);
+  T.copyFrom({293.15});
+  for (auto* const a : {&g0, &g1, &t0, &t1, &i0, &i1, &e0, &e1, &d0, &d1}) {
+    a->copyFrom(std::vector<real>(a->size, 0));
+  }
+  auto init = MaterialDataManagerInitializer{};
+  init.layout = FieldLayout::COMPONENT_BY_COMPONENT;
+  init.location = mgis::MemoryLocation::DEVICE;
+  init.s0.gradients = g0.span();
+  init.s1.gradients = g1.span();
+  init.s0.thermodynamic_forces = t0.span();
+  init.s1.thermodynamic_forces = t1.span();
+  init.s0.internal_state_variables = i0.span();
+  init.s1.internal_state_variables = i1.span();
+  init.K = K.span();
+  if (b.computesStoredEnergy) {
+    init.s0.stored_energies = e0.span();
+    init.s1.stored_energies = e1.span();
+  }
+  if (b.computesDissipatedEnergy) {
+    init.s0.dissipated_energies = d0.span();
+    init.s1.dissipated_energies = d1.span();
+  }
+  auto m = MaterialDataManager(gp_b, n, init);
+  setExternalStateVariable(m.s0, "Temperature", T.span(),
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  setExternalStateVariable(m.s1, "Temperature", T.span(),
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  auto stream = cudaStream_t{};
+  checkCUDA(cudaStreamCreate(&stream), "cudaStreamCreate");
+  auto ops = mgis::field_operations::CUDAFieldOperations{stream};
+  auto p = BatchExecutionPolicy{};
+  p.queue = stream;
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  auto gradients = std::vector<real>(n * gs, 0);  // component by component
+  for (int step = 0; step != 4; ++step) {
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != gs; ++c) {
+        const auto de = 1e-4 * static_cast<real>((step + 1) * (c + 1)) *
+                        (1 + 0.05 * static_cast<real>(i));
+        r.s1.gradients[i * gs + c] += de;
+        gradients[c * n + i] += de;
+      }
+    }
+    g1.copyFrom(gradients);
+    const auto rr = integrate(r, opts, 180);
+    const auto rm = integrate(p, m, opts, 180);
+    check(rr.exit_status == rm.exit_status, "cycle: invalid status");
+    update(r);
+    update(m, ops);
+    checkCUDA(cudaStreamSynchronize(stream), "cudaStreamSynchronize");
+  }
+  // comparison of the states at the beginning of the next time step
+  auto compare = [&r, n](const std::vector<real>& v,
+                         const std::span<const real> ref, const size_type nc,
+                         const double scale, const std::string& name) {
+    auto d = 0.;
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != nc; ++c) {
+        d = std::max(d, std::abs(v[c * n + i] - ref[i * nc + c]) / scale);
+      }
+    }
+    static_cast<void>(r);
+    check(d < 1e-12, "cycle: invalid " + name + " (" + std::to_string(d) + ")");
+  };
+  compare(t0.copyToHost(), r.s0.thermodynamic_forces, ts, 1e8,
+          "thermodynamic forces");
+  compare(i0.copyToHost(), r.s0.internal_state_variables, is, 1,
+          "internal state variables");
+  compare(g0.copyToHost(), r.s0.gradients, gs, 1, "gradients");
+  check(K.copyToHost() == std::vector<real>(n * Ks, 0),
+        "cycle: tangent operator blocks not set to zero");
+  // a copy between a value held by the manager (on the host) and an array of
+  // the device is refused
+  setExternalStateVariable(m.s0, "Temperature", 293.15);
+  check(throws([&m, &ops] { update(m, ops); }, "can't be copied"),
+        "cycle: mixed copy not refused");
+  // update of a material data view on the device
+  setExternalStateVariable(m.s0, "Temperature", T.span(),
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  auto v = make_view(m);
+  ops.fill(v.s1.thermodynamic_forces, 7);
+  update(v, ops);
+  checkCUDA(cudaStreamSynchronize(stream), "cudaStreamSynchronize");
+  check(t0.copyToHost() == std::vector<real>(n * ts, 7),
+        "cycle: invalid update of a material data view");
+  checkCUDA(cudaStreamDestroy(stream), "cudaStreamDestroy");
+}  // end of testIntegrationCycle
+
+/*!
+ * \brief asynchronous computations whose statuses are allocated by a pool
+ * of managed memory: no allocation of managed memory by call
+ */
+static void testAsynchronousComputationsWithPool(
+    const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  const auto b = load(gp_library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{16};
+  auto managed = mgis::memory_resources::CUDAManagedMemoryResource{};
+  auto pool = std::pmr::synchronized_pool_resource(&managed);
+  auto i = MaterialDataManagerInitializer{};
+  i.location = mgis::MemoryLocation::SHARED;
+  i.resource = &managed;
+  auto m = MaterialDataManager(b, n, i);
+  auto T = std::pmr::vector<real>(1, 293.15, &managed);
+  setExternalStateVariable(m.s0, "Temperature", T,
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  setExternalStateVariable(m.s1, "Temperature", T,
+                           MaterialStateManager::EXTERNAL_STORAGE);
+  for (size_type k = 0; k != n; ++k) {
+    m.s1.gradients[k * m.s1.gradients_stride] = 1e-3;
+  }
+  auto stream = cudaStream_t{};
+  checkCUDA(cudaStreamCreate(&stream), "cudaStreamCreate");
+  auto p = AsynchronousBatchExecutionPolicy{};
+  p.queue = stream;
+  p.resource = &pool;
+  p.location = mgis::MemoryLocation::SHARED;
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  for (int k = 0; k != 3; ++k) {
+    auto pending = std::vector<PendingBatchComputation>{};
+    pending.reserve(4);
+    for (size_type s = 0; s != 4; ++s) {
+      pending.push_back(integrate(p, m, opts, 1, 4 * s, 4 * s + 4));
+    }
+    checkCUDA(cudaStreamSynchronize(stream), "cudaStreamSynchronize");
+    for (const auto& pr : pending) {
+      check(pr.getResult().exit_status == 1,
+            "asynchronous computations: invalid status");
+    }
+  }
+  checkCUDA(cudaStreamDestroy(stream), "cudaStreamDestroy");
+}  // end of testAsynchronousComputationsWithPool
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-cuda-library generic-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    testFieldOperations();
+    testIntegrationCycle(argv[1], argv[2]);
+    testAsynchronousComputationsWithPool(argv[1]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
