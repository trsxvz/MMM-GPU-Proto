diff --git a/include/MGIS/FieldOperations.hxx b/include/MGIS/FieldOperations.hxx
new file mode 100644
index 0000000..7a9b5b6
--- /dev/null
+++ b/include/MGIS/FieldOperations.hxx
@@ -0,0 +1,132 @@
+/*!
+ * \file   include/MGIS/FieldOperations.hxx
+ * \brief  This file declares the `FieldOperations` interface, which performs
+ * copies and fills of views in the memory of the calling code (memory of the
+ * host, of a device, shared memory)
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_HXX
+
+#include "MGIS/Config.hxx"
+#include "MGIS/FieldView.hxx"
+
+namespace mgis {
+
+  /*!
+   * \brief copies and fills of views, performed by the calling code in its
+   * memory.
+   *
+   * `MGIS` does not depend on any GPU library. The functions which update
+   * arrays located in the memory of a device (for instance, `update` and
+   * `revert` of a material data manager) know which values must be copied,
+   * and delegate the copies to an object implementing this interface, as
+   * the allocations are delegated to a `std::pmr::memory_resource`. The
+   * operations may be asynchronous, ordered on a queue of the calling code:
+   * the calling code must synchronize the queue before reading the values on
+   * the host.
+   *
+   * As `std::pmr::memory_resource`, the public functions are not virtual:
+   * they check the arguments and call the private virtual functions.
+   *
+   * Implementations for the usual GPU programming models are provided by the
+   * headers of the `MGIS/FieldOperations` directory, which are compiled by
+   * the calling code with its own GPU toolchain. `HostFieldOperations`
+   * works in the memory of the host.
+   */
+  struct MGIS_EXPORT FieldOperations {
+    /*!
+     * \brief copy the values of a view in another one
+     * \param[out] d: destination
+     * \param[in] s: source
+     * \note both views must have the same numbers of points and of
+     * components, and must be located in the memory handled by the
+     * operations. The values of the destination must be distinct (see
+     * `FieldView::hasDistinctValues`).
+     */
+    void copy(const FieldView<real>&, const FieldView<const real>&);
+    /*!
+     * \brief set all the values of a view to the given value
+     * \param[out] d: view
+     * \param[in] v: value
+     */
+    void fill(const FieldView<real>&, const real);
+    //! \brief destructor
+    virtual ~FieldOperations();
+
+   private:
+    //! \brief copy the values of a view in another one (checked)
+    virtual void do_copy(const FieldView<real>&,
+                         const FieldView<const real>&) = 0;
+    //! \brief fill a view (checked)
+    virtual void do_fill(const FieldView<real>&, const real) = 0;
+  };  // end of FieldOperations
+
+  /*!
+   * \brief copies and fills of views in the memory of the host (or in
+   * shared memory), performed synchronously by the host
+   */
+  struct MGIS_EXPORT HostFieldOperations final : FieldOperations {
+    //! \brief destructor
+    ~HostFieldOperations() override;
+
+   private:
+    void do_copy(const FieldView<real>&,
+                 const FieldView<const real>&) override;
+    void do_fill(const FieldView<real>&, const real) override;
+  };  // end of HostFieldOperations
+
+  /*!
+   * \return true if the values of a view are stored densely, i.e. if they
+   * occupy the `n * nc` first values of the memory region of the view, so
+   * that a copy between two dense views with the same strides is a copy of
+   * a contiguous memory region.
+   * \param[in] v: view
+   */
+  template <typename ValueType>
+  constexpr bool isDense(const FieldView<ValueType>& v) noexcept {
+    const auto n = v.getNumberOfPoints();
+    const auto nc = v.getNumberOfComponents();
+    if ((n <= 1) && (nc <= 1)) {
+      return true;
+    }
+    if (nc <= 1) {
+      return v.getPointStride() == 1;
+    }
+    if (n <= 1) {
+      return v.getComponentStride() == 1;
+    }
+    return ((v.getPointStride() == nc) && (v.getComponentStride() == 1)) ||
+           ((v.getPointStride() == 1) && (v.getComponentStride() == n));
+  }  // end of isDense
+
+  /*!
+   * \return true if two views are stored densely with the same strides, so
+   * that a copy between them is a copy of a contiguous memory region of
+   * `n * nc` values
+   * \param[in] a: first view
+   * \param[in] b: second view
+   */
+  template <typename ValueType, typename ValueType2>
+  constexpr bool haveSameDenseLayout(const FieldView<ValueType>& a,
+                                     const FieldView<ValueType2>& b) noexcept {
+    if ((!isDense(a)) || (!isDense(b))) {
+      return false;
+    }
+    if ((a.getNumberOfPoints() <= 1) || (a.getNumberOfComponents() <= 1)) {
+      return true;
+    }
+    return (a.getPointStride() == b.getPointStride()) &&
+           (a.getComponentStride() == b.getComponentStride());
+  }  // end of haveSameDenseLayout
+
+}  // end of namespace mgis
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_HXX */
diff --git a/include/MGIS/FieldOperations/CUDAFieldOperations.hxx b/include/MGIS/FieldOperations/CUDAFieldOperations.hxx
new file mode 100644
index 0000000..3b70b44
--- /dev/null
+++ b/include/MGIS/FieldOperations/CUDAFieldOperations.hxx
@@ -0,0 +1,130 @@
+/*!
+ * \file   include/MGIS/FieldOperations/CUDAFieldOperations.hxx
+ * \brief  This file declares the `CUDAFieldOperations` class, which copies
+ * and fills views located in the memory of a device with the runtime of CUDA.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_CUDAFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_CUDAFIELDOPERATIONS_HXX
+
+#include <bit>
+#include <string>
+#include <cstdint>
+#include <stdexcept>
+#include <cuda_runtime.h>
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis::field_operations::internals {
+
+  //! \brief copy the values of a view in another one, one thread per value
+  template <typename ValueType>
+  __global__ void cudaCopyFieldView(ValueType* const d,
+                                  const size_type dps,
+                                  const size_type dcs,
+                                  const ValueType* const s,
+                                  const size_type sps,
+                                  const size_type scs,
+                                  const size_type n,
+                                  const size_type nv) {
+    const auto k = static_cast<size_type>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (k >= nv) {
+      return;
+    }
+    // consecutive threads process consecutive points of a component
+    const auto i = k % n;
+    const auto j = k / n;
+    d[i * dps + j * dcs] = s[i * sps + j * scs];
+  }  // end of cudaCopyFieldView
+
+  //! \brief fill a view, one thread per value
+  template <typename ValueType>
+  __global__ void cudaFillFieldView(ValueType* const d,
+                                  const size_type ps,
+                                  const size_type cs,
+                                  const size_type n,
+                                  const size_type nv,
+                                  const ValueType v) {
+    const auto k = static_cast<size_type>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (k >= nv) {
+      return;
+    }
+    d[(k % n) * ps + (k / n) * cs] = v;
+  }  // end of cudaFillFieldView
+
+  //! \brief report an error of the runtime of CUDA
+  inline void checkCUDAStatus(const cudaError_t e, const char* const f) {
+    if (e != cudaSuccess) {
+      throw std::runtime_error(std::string{f} + ": " + cudaGetErrorString(e));
+    }
+  }  // end of checkCUDAStatus
+
+}  // end of namespace mgis::field_operations::internals
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in the memory of a device
+   * (or in managed memory), with the runtime of CUDA.
+   *
+   * The operations are asynchronous: they are submitted to the given stream,
+   * which the calling code must synchronize before reading the values on the
+   * host. A copy between two views with the same dense layout is a copy of a
+   * contiguous memory region; the other copies, and the fills by a non null
+   * value, launch a kernel.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with nvcc or clang (CUDA).
+   */
+  struct CUDAFieldOperations final : FieldOperations {
+    //! \param[in] s: stream (the default stream if null)
+    explicit CUDAFieldOperations(const cudaStream_t s = nullptr) noexcept : stream(s) {}
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      if (haveSameDenseLayout(d, s)) {
+        internals::checkCUDAStatus(
+            cudaMemcpyAsync(d.data(), s.data(), nv * sizeof(real), cudaMemcpyDefault,
+                            this->stream),
+            "CUDAFieldOperations::copy");
+        return;
+      }
+      internals::cudaCopyFieldView<real>
+          <<<(nv + block_size - 1) / block_size, block_size, 0, this->stream>>>(
+              d.data(), d.getPointStride(), d.getComponentStride(), s.data(),
+              s.getPointStride(), s.getComponentStride(), n, nv);
+      internals::checkCUDAStatus(cudaGetLastError(), "CUDAFieldOperations::copy");
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nv = n * d.getNumberOfComponents();
+      if ((isDense(d)) && (std::bit_cast<std::uint64_t>(v) == 0)) {
+        // positive zero: all the bytes are null
+        internals::checkCUDAStatus(
+            cudaMemsetAsync(d.data(), 0, nv * sizeof(real), this->stream),
+            "CUDAFieldOperations::fill");
+        return;
+      }
+      internals::cudaFillFieldView<real>
+          <<<(nv + block_size - 1) / block_size, block_size, 0, this->stream>>>(
+              d.data(), d.getPointStride(), d.getComponentStride(), n, nv, v);
+      internals::checkCUDAStatus(cudaGetLastError(), "CUDAFieldOperations::fill");
+    }  // end of do_fill
+    //! \brief number of threads of a block
+    static constexpr size_type block_size = 256;
+    //! \brief stream
+    cudaStream_t stream;
+  };  // end of CUDAFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_CUDAFIELDOPERATIONS_HXX */
