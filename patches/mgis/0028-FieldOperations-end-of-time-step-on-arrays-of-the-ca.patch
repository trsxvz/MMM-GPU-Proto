diff --git a/src/FieldOperations.cxx b/src/FieldOperations.cxx
new file mode 100644
index 0000000..7cb5c8f
--- /dev/null
+++ b/src/FieldOperations.cxx
@@ -0,0 +1,77 @@
+/*!
+ * \file   src/FieldOperations.cxx
+ * \brief  This file implements the `FieldOperations` and
+ * `HostFieldOperations` classes
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <string>
+#include <algorithm>
+#include "MGIS/Raise.hxx"
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis {
+
+  void FieldOperations::copy(const FieldView<real>& d,
+                             const FieldView<const real>& s) {
+    if ((d.getNumberOfPoints() != s.getNumberOfPoints()) ||
+        (d.getNumberOfComponents() != s.getNumberOfComponents())) {
+      raise("FieldOperations::copy: the views have different extents");
+    }
+    if (d.empty()) {
+      return;
+    }
+    if (!d.hasDistinctValues()) {
+      raise("FieldOperations::copy: the values of the destination overlap");
+    }
+    this->do_copy(d, s);
+  }  // end of copy
+
+  void FieldOperations::fill(const FieldView<real>& d, const real v) {
+    if (d.empty()) {
+      return;
+    }
+    if (!d.hasDistinctValues()) {
+      raise("FieldOperations::fill: the values of the view overlap");
+    }
+    this->do_fill(d, v);
+  }  // end of fill
+
+  FieldOperations::~FieldOperations() = default;
+
+  HostFieldOperations::~HostFieldOperations() = default;
+
+  void HostFieldOperations::do_copy(const FieldView<real>& d,
+                                    const FieldView<const real>& s) {
+    if (haveSameDenseLayout(d, s)) {
+      const auto nv = d.getNumberOfPoints() * d.getNumberOfComponents();
+      std::copy(s.data(), s.data() + nv, d.data());
+      return;
+    }
+    for (size_type i = 0; i != d.getNumberOfPoints(); ++i) {
+      for (size_type j = 0; j != d.getNumberOfComponents(); ++j) {
+        d(i, j) = s(i, j);
+      }
+    }
+  }  // end of do_copy
+
+  void HostFieldOperations::do_fill(const FieldView<real>& d, const real v) {
+    if (isDense(d)) {
+      const auto nv = d.getNumberOfPoints() * d.getNumberOfComponents();
+      std::fill(d.data(), d.data() + nv, v);
+      return;
+    }
+    for (size_type i = 0; i != d.getNumberOfPoints(); ++i) {
+      for (size_type j = 0; j != d.getNumberOfComponents(); ++j) {
+        d(i, j) = v;
+      }
+    }
+  }  // end of do_fill
+
+}  // end of namespace mgis
