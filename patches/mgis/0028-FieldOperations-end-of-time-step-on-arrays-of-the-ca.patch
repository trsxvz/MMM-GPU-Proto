+namespace mgis::field_operations::internals {
+
+  //! \brief copy the values of a view in another one, one thread per value
+  template <typename ValueType>
+  __global__ void hipCopyFieldView(ValueType* const d,
+                                  const size_type dps,
+                                  const size_type dcs,
+                                  const ValueType* const s,
+                                  const size_type sps,
+                                  const size_type scs,
+                                  const size_type n,
+                                  const size_type nv) {
+    const auto k = static_cast<size_type>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (k >= nv) {
