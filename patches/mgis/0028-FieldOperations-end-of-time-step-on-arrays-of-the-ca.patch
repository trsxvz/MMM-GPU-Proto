         std::get<MutableFieldHolder>(p->second).value);
   }  // end of isExternalStateVariableUniform
 
+  /*!
+   * \brief data of the update of the values of a material state manager from
+   * the values of another one
+   */
+  struct ValuesUpdate {
+    //! \brief execution context
+    Context& ctx;
+    //! \brief operations used to copy the arrays given by the calling code
+    FieldOperations& ops;
+    /*!
+     * \brief true if the arrays given by the calling code are accessible by
+     * the host
+     */
+    const bool host_accessible;
+  };
+
+  /*!
+   * \brief copy values. The arrays given by the calling code are copied by
+   * the field operations. A copy between a value held by the material state
+   * manager (in the memory of the host) and an array given by the calling
+   * code is made by the host, and requires this array to be accessible by
+   * the host.
+   * \param[in] u: data of the update
+   * \param[out] to: destination
+   * \param[in] from: source
+   * \param[in] to_held: true if the destination is held by the material
+   * state manager
+   * \param[in] from_held: true if the source is held by the material state
+   * manager
+   */
+  [[nodiscard]] static bool copyValues(ValuesUpdate& u,
+                                       const std::span<real> to,
+                                       const std::span<const real> from,
+                                       const bool to_held,
+                                       const bool from_held) noexcept {
+    if (to.size() != from.size()) {
+      return u.ctx.registerErrorMessage("arrays' size does not match");
+    }
+    if ((!to_held) && (!from_held)) {
+      const auto nv = static_cast<size_type>(to.size());
+      try {
+        u.ops.copy(FieldView<real>(to, 1, nv, nv, 1),
+                   FieldView<const real>(from, 1, nv, nv, 1));
+      } catch (std::exception& e) {
