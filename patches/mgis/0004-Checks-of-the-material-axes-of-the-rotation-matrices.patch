From 282f2796f3abd26b2dd552a1e27070b8aff59ff8 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 06:08:22 +0200
Subject: [PATCH] Checks of the material axes of the rotation matrices

The number of values of a material axis was refused when it was a multiple
of the dimension (inverted test), so that no RotationMatrix2D or
RotationMatrix3D could be built, and the number of integration points was
compared to the remainder of the division of the number of values by the
dimension instead of the quotient.
---
 src/Behaviour.cxx      | 6 +++---
 src/RotationMatrix.cxx | 4 ++--
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/Behaviour.cxx b/src/Behaviour.cxx
index 6a80deb..a8793bf 100644
--- a/src/Behaviour.cxx
+++ b/src/Behaviour.cxx
@@ -412,7 +412,7 @@ namespace mgis::behaviour {
                   toString(b.hypothesis) + "'");
     }
     if (r.a.size() != 2u) {
-      if (nipts != r.a.size() % 2) {
+      if (nipts != r.a.size() / 2) {
         mgis::raise(std::string(m) +
                     ": the number of integration points handled "
                     "by the rotation matrix is different from the "
@@ -430,7 +430,7 @@ namespace mgis::behaviour {
                   toString(b.hypothesis) + "'");
     }
     if (r.a1.a.size() != 3u) {
-      if (nipts != r.a1.a.size() % 3) {
+      if (nipts != r.a1.a.size() / 3) {
         mgis::raise(std::string(m) +
                     ": the number of integration points handled "
                     "by the rotation matrix is different from the "
@@ -438,7 +438,7 @@ namespace mgis::behaviour {
       }
     }
     if (r.a2.a.size() != 3u) {
-      if (nipts != r.a2.a.size() % 3) {
+      if (nipts != r.a2.a.size() / 3) {
         mgis::raise(std::string(m) +
                     ": the number of integration points handled "
                     "by the rotation matrix is different from the "
diff --git a/src/RotationMatrix.cxx b/src/RotationMatrix.cxx
index 947fff2..6078d44 100644
--- a/src/RotationMatrix.cxx
+++ b/src/RotationMatrix.cxx
@@ -43,7 +43,7 @@ namespace mgis::behaviour {
           "RotationMatrix2D::RotationMatrix2D: "
           "empty values for material axis in 2D");
     }
-    if (!(v.size() % 2)) {
+    if (v.size() % 2 != 0) {
       mgis::raise(
           "RotationMatrix2D::RotationMatrix2D: "
           "invalid number of values for material axis in 2D");
@@ -65,7 +65,7 @@ namespace mgis::behaviour {
           "empty values for material axis in 3D");
     }
     const auto s = v.size();
-    if (!(s % 3)) {
+    if (s % 3 != 0) {
       mgis::raise(
           "RotationMatrix3D::RotationMatrix3D: "
           "invalid number of values for material axis in 3D");
-- 
