+/*!
+ * \brief rotations of the gradients, of the thermodynamic forces and of the
+ * tangent operator blocks of an orthotropic behaviour: uniform rotation
+ * matrix, rotation matrices given point by point, 3D rotation given by two
+ * material axes
+ */
+static void testRotations(const std::string& library,
+                          const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  constexpr auto n = mgis::size_type{8};
+  const auto b = load(library, "OrthotropicElasticity", h);
+  const auto gp_b = load(gp_library, "OrthotropicElasticity", h);
+  // rotation matrices: rotations about the z axis
+  auto matrices = std::vector<mgis::real>(9 * n);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    const auto t = 0.2 * static_cast<double>(i + 1);
+    const auto m = std::array<mgis::real, 9>{
+        std::cos(t), -std::sin(t), 0, std::sin(t), std::cos(t), 0, 0, 0, 1};
+    std::copy(m.begin(), m.end(), matrices.begin() + 9 * i);
+  }
+  const auto uniform = std::span<const mgis::real>(matrices.data(), 9);
+  const auto axis1 = std::vector<mgis::real>{0.6, 0.8, 0};
+  const auto axis2 = std::vector<mgis::real>{-0.8, 0.6, 0};
+  const auto r3d =
+      RotationMatrix3D(axis1, axis2, mgis::StorageMode::EXTERNAL_STORAGE);
+  // values to be rotated
+  auto values = [](const mgis::size_type size) {
+    auto v = std::vector<mgis::real>(size);
+    for (mgis::size_type i = 0; i != size; ++i) {
+      v[i] = std::sin(1 + static_cast<double>(i));
+    }
+    return v;
+  };
+  auto test = [&](const std::string& name, const mgis::size_type vsize,
+                  const auto& rotate, const auto& r) {
+    const auto v = values(vsize * n);
+    auto rv = std::vector<mgis::real>(vsize * n);
+    auto gp_rv = std::vector<mgis::real>(vsize * n);
+    rotate(rv, b, v, r);
+    rotate(gp_rv, gp_b, v, r);
+    check(compare(rv, gp_rv, 1) < 1e-14, name + ": invalid rotated values");
+  };
+  const auto gsize = getArraySize(b.gradients, h);
+  const auto tfsize = getArraySize(b.thermodynamic_forces, h);
+  const auto Ksize = getTangentOperatorArraySize(b);
+  const auto rotate_gradients = [](std::span<mgis::real> d, const Behaviour& bv,
+                                   std::span<const mgis::real> v,
+                                   const auto& r) {
+    rotateGradients(d, bv, v, r);
+  };
+  const auto rotate_forces = [](std::span<mgis::real> d, const Behaviour& bv,
+                                std::span<const mgis::real> v, const auto& r) {
+    rotateThermodynamicForces(d, bv, v, r);
+  };
+  const auto rotate_blocks = [](std::span<mgis::real> d, const Behaviour& bv,
+                                std::span<const mgis::real> v, const auto& r) {
+    rotateTangentOperatorBlocks(d, bv, v, r);
+  };
+  const auto per_point = std::span<const mgis::real>(matrices);
+  test("rotateGradients, uniform", gsize, rotate_gradients, uniform);
+  test("rotateGradients, per point", gsize, rotate_gradients, per_point);
+  test("rotateGradients, 3D", gsize, rotate_gradients, r3d);
+  test("rotateThermodynamicForces, uniform", tfsize, rotate_forces, uniform);
+  test("rotateThermodynamicForces, per point", tfsize, rotate_forces,
+       per_point);
+  test("rotateThermodynamicForces, 3D", tfsize, rotate_forces, r3d);
+  test("rotateTangentOperatorBlocks, uniform", Ksize, rotate_blocks, uniform);
+  test("rotateTangentOperatorBlocks, per point", Ksize, rotate_blocks,
+       per_point);
+  test("rotateTangentOperatorBlocks, 3D", Ksize, rotate_blocks, r3d);
+}  // end of testRotations
