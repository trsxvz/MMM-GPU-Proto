+  /*!
+   * \brief rotate the values of a batch of integration points with a
+   * function generated by the `generic-parallel` interface, on the default
+   * queue of the backend
+   * \param[in] m: calling function
+   * \param[in] f: rotation function
+   * \param[out] dest: rotated values
+   * \param[in] src: values to be rotated, which may be the rotated values
+   * \param[in] vsize: number of values of a point
+   * \param[in] r: rotation matrices (9 values per point, or 9 values for an
+   * uniform rotation)
+   */
+  static void rotateBatch(const char *const m,
+                          const BatchRotationFctPtr f,
+                          std::span<real> dest,
+                          const std::span<const real> &src,
+                          const mgis::size_type vsize,
+                          const std::span<const real> &r) {
+    if (f == nullptr) {
+      mgis::raise(std::string(m) + ": no rotation function defined");
+    }
+    const auto nipts = checkRotateFunctionInputs(m, dest, src, vsize);
+    if ((r.size() != 9) && (r.size() != 9 * nipts)) {
+      mgis::raise(std::string(m) +
+                  ": invalid size for the rotation matrix array");
+    }
+    auto d = BatchRotationDataView{};
+    d.number_of_points = nipts;
+    d.destination = {dest.data(), vsize, 1};
+    d.source = {src.data(), vsize, 1};
+    d.rotation_matrices = {r.data(), r.size() == 9 ? 0 : 9, 1};
+    auto o = BatchOutputStatus{};
+    if (f(&o, &d) != 1) {
+      o.msg[sizeof(o.msg) - 1] = '\0';
+      mgis::raise(std::string(m) + ": " + std::string{o.msg});
+    }
+  }  // end of rotateBatch
+
+  /*!
+   * \return the rotation matrices associated with a rotation description, in
+   * the memory of the host (batch rotations)
+   * \param[in] m: calling function
+   * \param[in] b: behaviour
+   * \param[in] nipts: number of integration points
+   * \param[in] build: function building the rotation matrix of a point
+   * \param[in] uniform: true if the rotation is uniform
+   */
+  template <typename BuildFunction>
+  static std::vector<real> buildBatchRotationMatrices(
+      const char *const m,
+      const Behaviour &b,
+      const mgis::size_type nipts,
+      const BuildFunction &build,
+      const bool uniform) {
+    if ((b.backend == "cuda") || (b.backend == "hip")) {
+      mgis::raise(std::string(m) +
+                  ": the rotation matrices built by MGIS are stored in the "
+                  "memory of the host, which is not accessible by the device "
+                  "of the backend '" +
+                  b.backend +
+                  "': the rotation matrices must be given as an array");
+    }
+    const auto n = uniform ? mgis::size_type{1} : nipts;
+    auto matrices = std::vector<real>(9 * n);
+    for (mgis::size_type i = 0; i != n; ++i) {
+      const auto mi = build(i);
+      std::copy(mi.begin(), mi.end(), matrices.begin() + 9 * i);
+    }
+    return matrices;
+  }  // end of buildBatchRotationMatrices
+
+  /*!
+   * \brief rotate values of a batch with a 2D rotation
+   * \param[in] m: calling function
+   * \param[in] b: behaviour
+   * \param[in] f: rotation function
+   * \param[out] dest: rotated values
+   * \param[in] src: values to be rotated
+   * \param[in] vsize: number of values of a point
+   * \param[in] r: rotation
+   */
+  static void rotateBatch(const char *const m,
+                          const Behaviour &b,
+                          const BatchRotationFctPtr f,
+                          std::span<real> dest,
+                          const std::span<const real> &src,
+                          const mgis::size_type vsize,
+                          const RotationMatrix2D &r) {
+    const auto nipts = checkRotateFunctionInputs(m, dest, src, vsize);
+    checkRotationMatrix2D(m, r, b, nipts);
+    const auto uniform = r.a.size() == 2u;
+    const auto matrices = buildBatchRotationMatrices(
+        m, b, nipts,
+        [&r](const mgis::size_type i) {
+          return buildRotationMatrix(r.a.data() + 2 * i);
+        },
+        uniform);
+    rotateBatch(m, f, dest, src, vsize, matrices);
+  }  // end of rotateBatch
+
+  /*!
+   * \brief rotate values of a batch with a 3D rotation
+   * \param[in] m: calling function
+   * \param[in] b: behaviour
+   * \param[in] f: rotation function
+   * \param[out] dest: rotated values
+   * \param[in] src: values to be rotated
+   * \param[in] vsize: number of values of a point
+   * \param[in] r: rotation
+   */
+  static void rotateBatch(const char *const m,
+                          const Behaviour &b,
+                          const BatchRotationFctPtr f,
+                          std::span<real> dest,
+                          const std::span<const real> &src,
+                          const mgis::size_type vsize,
+                          const RotationMatrix3D &r) {
+    const auto nipts = checkRotateFunctionInputs(m, dest, src, vsize);
+    checkRotationMatrix3D(m, r, b, nipts);
+    const auto o1 = (r.a1.a.size() == 3u) ? 0u : 3u;
+    const auto o2 = (r.a2.a.size() == 3u) ? 0u : 3u;
+    const auto matrices = buildBatchRotationMatrices(
+        m, b, nipts,
+        [&r, o1, o2](const mgis::size_type i) {
+          return buildRotationMatrix(r.a1.a.data() + o1 * i,
+                                     r.a2.a.data() + o2 * i);
+        },
+        (o1 == 0) && (o2 == 0));
+    rotateBatch(m, f, dest, src, vsize, matrices);
+  }  // end of rotateBatch
