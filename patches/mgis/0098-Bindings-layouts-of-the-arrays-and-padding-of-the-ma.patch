+       function mdm_initializer_get_array_layout_wrapper(l,d,a) &
+            bind(c,name = 'mgis_bv_material_data_manager_initializer_get_array_layout') &
+            result(r)
+         use, intrinsic :: iso_c_binding, only: c_ptr, c_int
+         use mgis, only: mgis_status
+         implicit none
+         integer(kind=c_int), intent(out) :: l
+         type(c_ptr), intent(in), value :: d
+         integer(kind=c_int), intent(in), value :: a
+         type(mgis_status) :: r
+       end function mdm_initializer_get_array_layout_wrapper
+    end interface
+    integer(kind=c_int), intent(out) :: l
+    type(MaterialDataManagerInitializer), intent(in) :: d
+    integer(kind=c_int), intent(in) :: a
+    type(mgis_status) :: s
+    s = mdm_initializer_get_array_layout_wrapper(l,d%ptr,a)
+  end function material_data_manager_initializer_get_array_layout
+  !
+  function material_data_manager_initializer_set_padding(d,p) result(s)
+    use, intrinsic :: iso_c_binding, only: c_size_t
+    use mgis, only: mgis_status
+    implicit none
+    interface
+       function mdm_initializer_set_padding_wrapper(d,p) &
+            bind(c,name = 'mgis_bv_material_data_manager_initializer_set_padding') &
+            result(r)
+         use, intrinsic :: iso_c_binding, only: c_ptr, c_size_t
+         use mgis, only: mgis_status
+         implicit none
+         type(c_ptr), intent(in), value :: d
+         integer(kind=c_size_t), intent(in), value :: p
+         type(mgis_status) :: r
