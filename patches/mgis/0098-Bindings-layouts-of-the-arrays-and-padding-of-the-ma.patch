+/*!
+ * \brief get the layout of an array of the material data manager
+ * \param[out] l: layout
+ * \param[in] d: initializer
+ * \param[in] a: array
+ */
+MGIS_C_EXPORT
+mgis_status mgis_bv_material_data_manager_initializer_get_array_layout(
+    mgis_bv_FieldLayout* const,
+    mgis_bv_MaterialDataManagerInitializer* const,
+    const mgis_bv_MaterialArray);
