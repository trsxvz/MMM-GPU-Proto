   /*!
    * \brief copy the arrays of a state (gradients, thermodynamic forces,
    * internal state variables, energies) in the arrays of another state, with
diff --git a/src/MaterialDataView.cxx b/src/MaterialDataView.cxx
index 470af33..dd32bb3 100644
--- a/src/MaterialDataView.cxx
+++ b/src/MaterialDataView.cxx
@@ -329,6 +329,65 @@ namespace mgis::behaviour {
     return v;
   }  // end of make_view
 
+  /*!
+   * \return a view on the values of a variable of a state, extracted from
+   * the view of its group of variables
+   * \param[in] f: calling function
+   * \param[in] d: description of the group of variables
+   * \param[in] s: state
+   * \param[in] values: view of the group of variables
+   * \param[in] variables: variables of the group
+   * \param[in] n: name of the variable
+   */
+  static FieldView<real> getVariableView(const std::string_view f,
+                                         const std::string_view d,
+                                         const MaterialStateView& s,
+                                         const FieldView<real>& values,
+                                         const std::vector<Variable>& variables,
+                                         const std::string_view n) {
+    const auto h = s.b->hypothesis;
+    const auto vs = getVariableSize(getVariable(variables, n), h);
+    if (s.n == 0) {
+      // no point: the view only gives the number of components
+      return FieldView<real>(std::span<real>{}, 0, vs, vs, 1);
+    }
+    const auto nc = getArraySize(variables, h);
+    if ((values.getNumberOfPoints() != s.n) ||
+        (values.getNumberOfComponents() != nc)) {
+      mgis::raise(std::string{f} + ": invalid view of the " + std::string{d} +
+                  " (" + std::to_string(s.n) + " points and " +
+                  std::to_string(nc) + " components expected)");
+    }
+    return getComponents(values, getVariableOffset(variables, n, h), vs);
+  }  // end of getVariableView
+
+  FieldView<real> getGradientView(const MaterialStateView& s,
+                                  const std::string_view n) {
+    return getVariableView("getGradientView", "gradients", s, s.gradients,
+                           s.b->gradients, n);
+  }  // end of getGradientView
+
+  FieldView<real> getThermodynamicForceView(const MaterialStateView& s,
+                                            const std::string_view n) {
+    return getVariableView("getThermodynamicForceView", "thermodynamic forces",
+                           s, s.thermodynamic_forces, s.b->thermodynamic_forces,
+                           n);
+  }  // end of getThermodynamicForceView
+
+  FieldView<real> getInternalStateVariableView(const MaterialStateView& s,
+                                               const std::string_view n) {
+    return getVariableView("getInternalStateVariableView",
+                           "internal state variables", s,
+                           s.internal_state_variables, s.b->isvs, n);
+  }  // end of getInternalStateVariableView
+
+  void extractInternalStateVariable(const FieldView<real>& o,
+                                    const MaterialStateView& s,
+                                    const std::string_view n,
+                                    FieldOperations& ops) {
+    ops.copy(o, getInternalStateVariableView(s, n));
+  }  // end of extractInternalStateVariable
