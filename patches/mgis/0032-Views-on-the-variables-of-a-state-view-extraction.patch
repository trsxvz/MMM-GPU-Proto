+/*!
+ * \brief views on the variables of a state view and extraction of the
+ * internal state variables, compared to the material data manager, in all
+ * the arrangements
+ */
+static void testVariablesOfStateViews(const std::string& library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = size_type{6};
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  auto m = MaterialDataManager(b, n);
+  auto k = 0;
+  for (auto v :
+       std::array<std::span<real>, 3>{m.s1.gradients, m.s1.thermodynamic_forces,
+                                      m.s1.internal_state_variables}) {
+    for (auto& x : v) {
+      x = std::sin(static_cast<real>(++k));
+    }
+  }
+  const auto& s1 = m.s1;
+  const auto compare = [](const FieldView<const real>& v,
+                          const FieldView<const real>& r) {
+    if ((v.getNumberOfPoints() != r.getNumberOfPoints()) ||
+        (v.getNumberOfComponents() != r.getNumberOfComponents())) {
+      return false;
+    }
+    for (size_type i = 0; i != v.getNumberOfPoints(); ++i) {
+      for (size_type j = 0; j != v.getNumberOfComponents(); ++j) {
+        if (!same(v(i, j), r(i, j))) {
+          return false;
+        }
+      }
+    }
+    return true;
+  };
+  auto ops = mgis::HostFieldOperations{};
+  for (const auto a : arrangements) {
+    const auto msg =
+        "variables of a state view, " + library + ", " + getName(a) + ": ";
+    auto d = ViewData(b, n, a);
+    d.copyFrom(m);
+    for (const auto& g : b.gradients) {
+      check(
+          compare(getGradientView(d.v.s1, g.name), getGradientView(s1, g.name)),
+          msg + "invalid view of the gradient " + g.name);
+    }
+    for (const auto& f : b.thermodynamic_forces) {
+      check(compare(getThermodynamicForceView(d.v.s1, f.name),
+                    getThermodynamicForceView(s1, f.name)),
+            msg + "invalid view of the thermodynamic force " + f.name);
+    }
+    for (const auto& iv : b.isvs) {
+      check(compare(getInternalStateVariableView(d.v.s1, iv.name),
+                    getInternalStateVariableView(s1, iv.name)),
+            msg + "invalid view of the internal state variable " + iv.name);
+      const auto vs = getVariableSize(iv, b.hypothesis);
+      auto o = Array(n, vs, a);
+      extractInternalStateVariable(o.view, d.v.s1, iv.name, ops);
+      auto ref = std::vector<real>(n * vs);
+      extractInternalStateVariable(ref, s1, iv.name);
+      check(o.equals(ref) && o.hasUnusedValuesUnchanged(),
+            msg + "invalid extraction of " + iv.name);
+    }
+  }
+  // no point
+  const auto& iv = b.isvs.front();
+  const auto vs = getVariableSize(iv, b.hypothesis);
+  auto d0 = ViewData(b, 0, Arrangement::POINT_BY_POINT);
+  const auto v0 = getInternalStateVariableView(d0.v.s1, iv.name);
+  check((v0.getNumberOfPoints() == 0) && (v0.getNumberOfComponents() == vs),
+        "variables of a state view, no point: invalid view");
+  extractInternalStateVariable(FieldView<real>(std::span<real>{}, 0, vs, vs, 1),
+                               d0.v.s1, iv.name, ops);
+  // errors
+  auto d = ViewData(b, n, Arrangement::POINT_BY_POINT);
+  check(throws([&d] { getInternalStateVariableView(d.v.s1, "Unknown"); },
+               "Unknown"),
+        "variables of a state view: an unknown variable must be refused");
+  d.v.s1.internal_state_variables = FieldView<real>{};
+  check(throws([&d, &iv] { getInternalStateVariableView(d.v.s1, iv.name); },
+               "invalid view of the internal state variables"),
+        "variables of a state view: a missing view must be refused");
+}  // end of testVariablesOfStateViews
+
 int main(const int argc, const char* const* const argv) {
   if (argc != 3) {
     std::cerr << "usage: " << argv[0]
@@ -902,6 +985,7 @@ int main(const int argc, const char* const* const argv) {
