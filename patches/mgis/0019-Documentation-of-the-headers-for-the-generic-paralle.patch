diff --git a/include/MGIS/BatchExecutionPolicy.hxx b/include/MGIS/BatchExecutionPolicy.hxx
index 523a09a..417264f 100644
--- a/include/MGIS/BatchExecutionPolicy.hxx
+++ b/include/MGIS/BatchExecutionPolicy.hxx
@@ -20,19 +20,26 @@ namespace mgis {
    * behaviours, the models and the material properties generated by the
    * `generic-parallel` interfaces of `MFront`. The location of the data is a
    * property of the data, not of the execution.
+   *
+   * The computations performed by `MGIS` are synchronous: the functions
+   * return once the computations are completed.
    */
   struct BatchExecutionPolicy {
     /*!
      * \brief queue on which the computations are submitted. Its meaning
      * depends on the backend of the library (`cudaStream_t` or
      * `hipStream_t`, pointer to a `sycl::queue` or to an instance of a
-     * Kokkos execution space). A null pointer denotes the default queue, if
-     * meaningful for the backend.
+     * Kokkos execution space). A null pointer denotes the default queue of
+     * the backend. The `sycl` backend has no default queue: a queue must be
+     * given.
      */
     void* queue = nullptr;
     /*!
      * \brief if true, the stack size of the threads of the device is never
-     * modified and an error is reported if it is too small
+     * modified and an error is reported if it is too small. Otherwise, the
+     * stack size is increased if required. This affects all the computations
+     * of the process on the device, since the stack size is a property of
+     * the context of the device (`CUDA` and `HIP` runtimes).
      */
     bool preserve_stack_size = false;
   };
