   mgis_size_type first_failure_index;
+  //! \brief number of points where the time step scaling factor is too low
   mgis_size_type number_of_unreliable_results;
+  //! \brief minimum of the time step scaling factors over the batch
   mgis_real rdt;
+  //! \brief error message
   char msg[512];
 } mgis_bv_BatchOutputStatus;
 
