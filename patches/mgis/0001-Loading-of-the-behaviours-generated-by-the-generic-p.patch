diff --git a/cmake/modules/behaviours.cmake b/cmake/modules/behaviours.cmake
index 17cc124..b385308 100644
--- a/cmake/modules/behaviours.cmake
+++ b/cmake/modules/behaviours.cmake
@@ -87,3 +87,55 @@ function(mfront_behaviours_check_library name)
     message(STATUS "No sources selected for library ${name}")
   endif(nb_sources GREATER 0)
 endfunction(mfront_behaviours_check_library)
+
+# Library of behaviours generated by the `generic-parallel` interface of
+# `MFront` with the given backend. The sources are generated in a directory
+# of their own, since the `generic` interface generates sources with the same
+# names, and compiled as the libraries of the `generic` interface.
+#
+# usage: mfront_generic_parallel_behaviours_check_library(name backend
+#                                                         behaviours...)
+function(mfront_generic_parallel_behaviours_check_library name backend)
+  set(_directory "${CMAKE_CURRENT_BINARY_DIR}/generic-parallel-${backend}")
+  set(_configuration "${_directory}/configuration.json")
+  file(MAKE_DIRECTORY "${_directory}")
+  # the options of the backend are its default options. The syntax of a
+  # backend without options is `backend: "name"`.
+  file(WRITE "${_configuration}"
+    "interfaces_options: {\n"
+    "  generic-parallel: {\n"
+    "    backend: \"${backend}\"\n"
+    "  }\n"
+    "}\n")
+  set(_sources)
+  foreach(source ${ARGN})
+    set(_file "${CMAKE_CURRENT_SOURCE_DIR}/${source}.mfront")
+    set(_outputs
+      "${_directory}/src/${source}.cxx"
+      "${_directory}/src/${source}-generic-parallel-${backend}.cxx")
+    add_custom_command(
+      OUTPUT ${_outputs}
+      COMMAND "${MFRONT}"
+      ARGS "--interface=generic-parallel"
+      ARGS "--configuration-file=${_configuration}"
+      ARGS "${_file}"
+      DEPENDS "${_file}"
+      WORKING_DIRECTORY "${_directory}"
+      COMMENT "mfront source ${_file} (generic-parallel interface)")
+    list(APPEND _sources ${_outputs})
+  endforeach(source ${ARGN})
+  message(STATUS "Adding library : ${name} (${_sources})")
+  add_library(${name} SHARED EXCLUDE_FROM_ALL ${_sources})
+  add_dependencies(check ${name})
+  target_include_directories(${name}
+    PRIVATE "${_directory}/include"
+    PRIVATE "${TFEL_INCLUDE_PATH}")
+  target_link_libraries(${name} PUBLIC ${TFEL_MFRONT_LIBRARIES})
+  if(backend STREQUAL "stlpar")
+    # the parallel algorithms of libstdc++ use TBB
+    find_library(MGIS_TBB_LIBRARY tbb)
+    if(MGIS_TBB_LIBRARY)
+      target_link_libraries(${name} PRIVATE "${MGIS_TBB_LIBRARY}")
+    endif(MGIS_TBB_LIBRARY)
+  endif(backend STREQUAL "stlpar")
+endfunction(mfront_generic_parallel_behaviours_check_library)
