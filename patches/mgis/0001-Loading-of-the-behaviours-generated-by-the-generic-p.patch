new file mode 100644
index 0000000..22fd614
--- /dev/null
+++ b/tests/GenericParallelLoadTest.cxx
@@ -0,0 +1,153 @@
+/*!
+ * \file   tests/GenericParallelLoadTest.cxx
+ * \brief  This test checks the loading of behaviours generated by the
+ * `generic-parallel` interface of `MFront`, the refusal of the functions of
+ * a point for those behaviours (and conversely), and the layout of the data
+ * structures copied from `TFEL`.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <cstddef>
+#include <cstdlib>
+#include <iostream>
+#include <string_view>
+#include "MFront/GenericParallelBehaviour/BatchData.h"
+#include "MGIS/LibrariesManager.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/BatchDataView.hxx"
+
+// the data structures copied from TFEL must have the same layout
+#define MGIS_CHECK_SIZE(T)                                     \
+  static_assert(sizeof(mgis_bv_##T) == sizeof(mfront_gpb_##T), \
+                "invalid size of mgis_bv_" #T)
+#define MGIS_CHECK_MEMBER(T1, T2, m)                                       \
+  static_assert(offsetof(mgis_bv_##T1, m) == offsetof(mfront_gpb_##T2, m), \
+                "invalid offset of mgis_bv_" #T1 "::" #m)
+static_assert(MGIS_BV_GENERIC_PARALLEL_API_VERSION == MFRONT_GPB_API_VERSION,
+              "unmatched versions of the data structures");
+static_assert(sizeof(mgis_bv_BatchStatistics) ==
+              sizeof(mfront_gpb_BatchStatistics));
+MGIS_CHECK_MEMBER(BatchStatistics, BatchStatistics, first_failure_index);
+MGIS_CHECK_MEMBER(BatchStatistics, BatchStatistics, rdt);
+static_assert(sizeof(mgis_bv_BatchExecutionOptions) ==
+              sizeof(mfront_gpb_ExecutionOptions));
+MGIS_CHECK_MEMBER(BatchExecutionOptions, ExecutionOptions, statistics);
+MGIS_CHECK_MEMBER(BatchExecutionOptions, ExecutionOptions, preserve_stack_size);
+MGIS_CHECK_SIZE(ConstField);
+MGIS_CHECK_SIZE(Field);
+MGIS_CHECK_MEMBER(ConstField, ConstField, component_stride);
+static_assert(sizeof(mgis_bv_BatchInitialStateView) ==
+              sizeof(mfront_gpb_InitialState));
+MGIS_CHECK_MEMBER(BatchInitialStateView,
+                  InitialState,
+                  external_state_variables);
+MGIS_CHECK_MEMBER(BatchInitialStateView,
+                  InitialState,
+                  external_state_variables_by_variable);
+static_assert(sizeof(mgis_bv_BatchStateView) == sizeof(mfront_gpb_State));
+MGIS_CHECK_MEMBER(BatchStateView, State, dissipated_energy);
+MGIS_CHECK_MEMBER(BatchStateView, State, external_state_variables_by_variable);
+static_assert(sizeof(mgis_bv_BatchDataView) == sizeof(mfront_gpb_BatchData));
+MGIS_CHECK_MEMBER(BatchDataView, BatchData, options);
+MGIS_CHECK_MEMBER(BatchDataView, BatchData, rdt);
+MGIS_CHECK_MEMBER(BatchDataView, BatchData, statuses);
+MGIS_CHECK_MEMBER(BatchDataView, BatchData, s0);
+MGIS_CHECK_MEMBER(BatchDataView, BatchData, s1);
+MGIS_CHECK_MEMBER(BatchDataView, BatchData, execution);
+static_assert(sizeof(mgis_bv_BatchRotationDataView) ==
+              sizeof(mfront_gpb_RotationData));
+MGIS_CHECK_MEMBER(BatchRotationDataView, RotationData, rotation_matrices);
+MGIS_CHECK_MEMBER(BatchRotationDataView, RotationData, execution);
+static_assert(sizeof(mgis_bv_BatchOutputStatus) ==
+              sizeof(mfront_gpb_OutputStatus));
+MGIS_CHECK_MEMBER(BatchOutputStatus, OutputStatus, first_failure_index);
+MGIS_CHECK_MEMBER(BatchOutputStatus, OutputStatus, rdt);
+MGIS_CHECK_MEMBER(BatchOutputStatus, OutputStatus, msg);
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+//! \return true if the given function throws an exception
+template <typename Function>
+static bool throws(const Function& f) {
+  try {
+    f();
+  } catch (...) {
+    return true;
+  }
+  return false;
+}
+
+int main(const int argc, const char* const* const argv) {
+  using namespace mgis::behaviour;
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-library generic-library\n";
+    return EXIT_FAILURE;
+  }
+  const auto gp_library = std::string{argv[1]};
+  const auto library = std::string{argv[2]};
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  auto& lm = mgis::LibrariesManager::get();
+  // integration
+  const auto b = load(gp_library, "Plasticity", h);
+  check(isGenericParallelBehaviour(b), "batch behaviour expected");
+  check(b.interface == "GenericParallel", "invalid interface");
+  check(b.backend == "stlpar", "invalid backend");
+  check(b.batch_b != nullptr, "no batch integration function");
+  check(b.b == nullptr, "no integration function of a point expected");
+  check(!b.isvs.empty(), "invalid description of the behaviour");
+  // initialize functions and post-processings
+  const auto bi = load(gp_library, "InitializeFunctionTest", h);
+  check(bi.initialize_functions.size() == 3u,
+        "invalid number of initialize functions");
+  for (const auto& [n, f] : bi.initialize_functions) {
+    check((f.batch_f != nullptr) && (f.f == nullptr),
+          "invalid initialize function '" + n + "'");
+  }
+  const auto bp = load(gp_library, "PostProcessingTest", h);
+  check(!bp.postprocessings.empty(), "no post-processing");
+  for (const auto& [n, p] : bp.postprocessings) {
+    check((p.batch_f != nullptr) && (p.f == nullptr),
+          "invalid post-processing '" + n + "'");
+  }
+  // rotations
+  const auto bo = load(gp_library, "OrthotropicElasticity", h);
+  check((bo.batch_rotate_gradients_ptr != nullptr) &&
+            (bo.batch_rotate_thermodynamic_forces_ptr != nullptr) &&
+            (bo.batch_rotate_tangent_operator_blocks_ptr != nullptr),
+        "invalid batch rotation functions");
+  check((bo.rotate_gradients_ptr == nullptr) &&
+            (bo.rotate_array_of_gradients_ptr == nullptr),
+        "no rotation function of a point expected");
+  // the functions of a point and of a batch have the same names but not the
+  // same signatures: each kind of library is refused by the other one
+  check(throws([&] {
+          static_cast<void>(lm.getBehaviour(gp_library, "Plasticity", h));
+        }),
+        "the integration function of a point must be refused");
+  check(throws([&] {
+          static_cast<void>(lm.getBatchBehaviour(library, "Plasticity", h));
+        }),
+        "the batch integration function must be refused");
+  // a behaviour of the generic interface is not a batch behaviour
+  const auto g = load(library, "Plasticity", h);
+  check(!isGenericParallelBehaviour(g), "batch behaviour not expected");
+  check(g.backend.empty(), "no backend expected");
+  check((g.b != nullptr) && (g.batch_b == nullptr),
+        "invalid integration functions");
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
