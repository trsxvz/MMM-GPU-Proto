index 0000000..083f98b
--- /dev/null
+++ b/include/MGIS/Behaviour/BatchDataView.hxx
@@ -0,0 +1,253 @@
+/*!
+ * \file   include/MGIS/Behaviour/BatchDataView.hxx
+ * \brief  This file declares the data structures exchanged with the
+ * functions generated by the `generic-parallel` interface of `MFront`, which
+ * integrate behaviours on batches of integration points.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_BEHAVIOUR_BATCHDATAVIEW_HXX
+#define LIB_MGIS_BEHAVIOUR_BATCHDATAVIEW_HXX
+
+#include <string.h>
+#ifdef __cplusplus
+#include "MGIS/Config.hxx"
+#else
+#include "MGIS/Config-c.h"
+#endif /* __cplusplus */
+
+/*!
+ * \brief version of the data structures of the `generic-parallel` interface
+ * supported by MGIS. It is compared to the version exported by the libraries
+ * (`<name>_generic_parallel_api_version` symbol) when a behaviour is loaded.
+ *
+ * The structures declared in this file are copies of the ones declared in
+ * the `MFront/GenericParallelBehaviour/BatchData.h` header of `TFEL`, so that
+ * `MGIS` does not depend on `TFEL` at compile time, as for the `generic`
+ * interface.
+ */
+#define MGIS_BV_GENERIC_PARALLEL_API_VERSION 2
+
+#ifdef __cplusplus
+extern "C" {
+#endif /* __cplusplus */
+
+/*!
+ * \brief statistics of the computations on a batch, accumulated on the
+ * device when the computations are asynchronous. They must be initialized by
+ * `mgis_bv_initializeBatchStatistics`.
+ */
+typedef struct mgis_bv_BatchStatistics {
+  //! \brief number of points where the integration failed
+  unsigned long long number_of_failures;
+  /*!
+   * \brief index of the first point where the integration failed, or the
+   * maximal value of the type if no point failed
+   */
+  unsigned long long first_failure_index;
+  //! \brief number of points where the time step scaling factor is too low
+  unsigned long long number_of_unreliable_results;
+  //! \brief minimum of the time step scaling factors, as an ordered key
+  unsigned long long rdt;
+} mgis_bv_BatchStatistics;
+
+//! \brief options of the execution of the computations on a batch
+typedef struct mgis_bv_BatchExecutionOptions {
+  /*!
+   * \brief queue on which the computations are submitted (`cudaStream_t`,
+   * `hipStream_t`, pointer to a `sycl::queue` or to an instance of a Kokkos
+   * execution space), or null for the default queue
+   */
+  void* queue;
+  //! \brief statistics of asynchronous computations, or null
+  mgis_bv_BatchStatistics* statistics;
+  /*!
+   * \brief if not null, the stack size of the threads of the device is never
+   * modified
+   */
+  int preserve_stack_size;
+} mgis_bv_BatchExecutionOptions;
+
+/*!
+ * \brief values of a group of variables at all the points of a batch: the
+ * `j`-th component at the `i`-th point is stored at
+ * `values[i * point_stride + j * component_stride]`. The values are uniform
+ * if the point stride is null.
+ */
+typedef struct mgis_bv_ConstField {
+  //! \brief pointer to the first value
+  const mgis_real* values;
+  //! \brief stride between two points
+  mgis_size_type point_stride;
+  //! \brief stride between two components
+  mgis_size_type component_stride;
+} mgis_bv_ConstField;
+
+//! \brief mutable version of `mgis_bv_ConstField`
+typedef struct mgis_bv_Field {
+  //! \brief pointer to the first value
+  mgis_real* values;
+  //! \brief stride between two points
+  mgis_size_type point_stride;
+  //! \brief stride between two components
+  mgis_size_type component_stride;
+} mgis_bv_Field;
+
+//! \brief state of the material at the beginning of the time step
+typedef struct mgis_bv_BatchInitialStateView {
+  mgis_bv_ConstField gradients;
+  mgis_bv_ConstField thermodynamic_forces;
+  mgis_bv_ConstField mass_density;
+  mgis_bv_ConstField material_properties;
+  mgis_bv_ConstField internal_state_variables;
+  mgis_bv_ConstField stored_energy;
+  mgis_bv_ConstField dissipated_energy;
+  mgis_bv_ConstField external_state_variables;
+  //! \brief material properties given variable by variable, or null
+  const mgis_bv_ConstField* material_properties_by_variable;
+  //! \brief external state variables given variable by variable, or null
+  const mgis_bv_ConstField* external_state_variables_by_variable;
+} mgis_bv_BatchInitialStateView;
+
+//! \brief state of the material at the end of the time step
+typedef struct mgis_bv_BatchStateView {
+  mgis_bv_ConstField gradients;
+  mgis_bv_Field thermodynamic_forces;
+  mgis_bv_ConstField mass_density;
+  mgis_bv_ConstField material_properties;
+  mgis_bv_Field internal_state_variables;
+  mgis_bv_Field stored_energy;
+  mgis_bv_Field dissipated_energy;
+  mgis_bv_ConstField external_state_variables;
+  //! \brief material properties given variable by variable, or null
+  const mgis_bv_ConstField* material_properties_by_variable;
+  //! \brief external state variables given variable by variable, or null
+  const mgis_bv_ConstField* external_state_variables_by_variable;
+} mgis_bv_BatchStateView;
+
+//! \brief description of a batch of integration points
+typedef struct mgis_bv_BatchDataView {
+  //! \brief number of integration points
+  mgis_size_type number_of_points;
+  //! \brief time increment
+  mgis_real dt;
+  //! \brief computation options (the three first values of `K`)
+  mgis_real options[3];
+  //! \brief initial value of the time step scaling factor
+  mgis_real rdt;
+  //! \brief tangent or prediction operators (output, optional)
+  mgis_bv_Field tangent_operators;
+  //! \brief time step scaling factors at each point (output, optional)
+  mgis_bv_Field rdts;
+  //! \brief speed of sound (output, optional)
+  mgis_bv_Field speed_of_sound;
+  //! \brief status of each integration point (output, optional)
+  int* statuses;
+  //! \brief state at the beginning of the time step
+  mgis_bv_BatchInitialStateView s0;
+  //! \brief state at the end of the time step
+  mgis_bv_BatchStateView s1;
+  //! \brief options of the execution of the computations
+  mgis_bv_BatchExecutionOptions execution;
+} mgis_bv_BatchDataView;
+
+//! \brief data of the rotation of the values of a batch
+typedef struct mgis_bv_BatchRotationDataView {
+  //! \brief number of points
+  mgis_size_type number_of_points;
+  //! \brief rotated values
+  mgis_bv_Field destination;
+  //! \brief values to be rotated, which may be the destination
+  mgis_bv_ConstField source;
+  //! \brief rotation matrices (9 values per point, column-major format)
+  mgis_bv_ConstField rotation_matrices;
+  //! \brief options of the execution of the computations
+  mgis_bv_BatchExecutionOptions execution;
+} mgis_bv_BatchRotationDataView;
+
+/*!
+ * \brief summary of the computations on a batch:
+ *
+ * - `status`: `1` on success, `0` if the time step scaling factor is lower
+ *   than 0.99 at some points, `-1` if the computations failed at some
+ *   points, `-2` for invalid arguments, `-3` for a runtime error of the
+ *   backend;
+ * - `first_failure_index`: index of the first point where the computations
+ *   failed, or the maximal value of the type if no point failed.
+ */
+typedef struct mgis_bv_BatchOutputStatus {
+  int status;
+  mgis_size_type number_of_failures;
+  mgis_size_type first_failure_index;
+  mgis_size_type number_of_unreliable_results;
+  mgis_real rdt;
+  char msg[512];
+} mgis_bv_BatchOutputStatus;
+
+/*!
+ * \brief initialize the statistics of a batch
+ * \param[out] s: statistics
+ * \param[in] rdt: initial value of the time step scaling factor
+ */
+static inline void mgis_bv_initializeBatchStatistics(
+    mgis_bv_BatchStatistics* const s, const double rdt) {
+  const unsigned long long sign = 0x8000000000000000ull;
+  unsigned long long b;
+  memcpy(&b, &rdt, sizeof(b));
+  s->number_of_failures = 0;
+  s->first_failure_index = ~0ull;
+  s->number_of_unreliable_results = 0;
+  s->rdt = (b & sign) ? ~b : (b | sign);
+} /* end of mgis_bv_initializeBatchStatistics */
+
+/*!
+ * \return the minimum of the time step scaling factors
+ * \param[in] s: statistics
+ */
+static inline double mgis_bv_getTimeStepScalingFactor(
+    const mgis_bv_BatchStatistics* const s) {
+  const unsigned long long sign = 0x8000000000000000ull;
+  const unsigned long long b = (s->rdt & sign) ? (s->rdt & ~sign) : ~(s->rdt);
+  double rdt;
+  memcpy(&rdt, &b, sizeof(rdt));
+  return rdt;
+} /* end of mgis_bv_getTimeStepScalingFactor */
+
+#ifdef __cplusplus
+}  // end of extern "C"
+#endif /* __cplusplus */
+
+#ifdef __cplusplus
+
+namespace mgis::behaviour {
+
+  //! \brief a simple alias
+  using BatchStatistics = ::mgis_bv_BatchStatistics;
+  //! \brief a simple alias
+  using BatchExecutionOptions = ::mgis_bv_BatchExecutionOptions;
+  //! \brief a simple alias
+  using ConstField = ::mgis_bv_ConstField;
+  //! \brief a simple alias
+  using Field = ::mgis_bv_Field;
+  //! \brief a simple alias
+  using BatchInitialStateView = ::mgis_bv_BatchInitialStateView;
+  //! \brief a simple alias
+  using BatchStateView = ::mgis_bv_BatchStateView;
+  //! \brief a simple alias
+  using BatchDataView = ::mgis_bv_BatchDataView;
+  //! \brief a simple alias
+  using BatchRotationDataView = ::mgis_bv_BatchRotationDataView;
+  //! \brief a simple alias
+  using BatchOutputStatus = ::mgis_bv_BatchOutputStatus;
+
+}  // end of namespace mgis::behaviour
+
+#endif /* __cplusplus */
+
+#endif /* LIB_MGIS_BEHAVIOUR_BATCHDATAVIEW_HXX */
