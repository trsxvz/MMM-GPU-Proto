@@ -47,8 +48,21 @@ class LayoutTest(unittest.TestCase):
                 v1 = getattr(managers[1].s1, a)
                 self.assertTrue((v0 == v1).all())
             self.assertTrue((managers[0].K == managers[1].K).all())
+            tf = managers[1].s1.thermodynamic_forces
+            self.assertTrue(tf.strides == (8, 8 * nig))
+            self.assertTrue(managers[1].K.strides ==
