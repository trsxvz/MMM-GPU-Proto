             for m in managers:
                 mgis_bv.update(m)
+        # a strided array can't be given as an array of values
+        bt = mgis_bv.load(lib, 'TensorialExternalStateVariableTest', h)
+        d = mgis_bv.BehaviourData(bt)
+        values = numpy.arange(12.)
+        with self.assertRaises(Exception):
+            mgis_bv.setExternalStateVariable(d.s1, 's_esv',
+                                             values[::2])
+        mgis_bv.setExternalStateVariable(d.s1, 's_esv',
+                                         values[0:6])
         pass
 
 
