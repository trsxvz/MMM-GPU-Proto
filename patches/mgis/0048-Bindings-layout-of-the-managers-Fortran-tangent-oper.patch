From 4b3b319082327310c1e290868ab542f170110449 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 01:29:42 +0200
Subject: [PATCH] Bindings: layout of the managers, Fortran tangent operator,
 numpy strides

- C and Fortran: getter of the layout of a material data manager.
- Fortran: material_data_manager_get_tangent_operator refuses the
  component by component layout, as the other accessors, and its first
  extent (size of the thermodynamic forces) is now set (it was never set).
- Python: an array of values given by a strided numpy array (for instance
  `a[::2]`) is refused instead of being read as contiguous.
- tests: invalid layout refused by the C bindings, layout of the managers,
  tangent operator in both layouts in Fortran, strides of the
  thermodynamic forces and of the tangent operator in Python, strided
  arrays refused.
---
 .../MGIS/Behaviour/MaterialDataManager.h      |  9 +++++-
 bindings/c/src/MaterialDataManager.cxx        | 13 +++++++++
 bindings/c/tests/LayoutTest-c.c               |  8 +++++
 bindings/fortran/src/mgis_behaviour.f90       | 29 ++++++++++++++++++-
 bindings/fortran/tests/LayoutTest-f.f90       | 22 ++++++++++++++
 bindings/python/src/NumPySupport.cxx          |  6 ++++
 bindings/python/tests/LayoutTest.py           | 14 +++++++++
 7 files changed, 99 insertions(+), 2 deletions(-)

diff --git a/bindings/c/include/MGIS/Behaviour/MaterialDataManager.h b/bindings/c/include/MGIS/Behaviour/MaterialDataManager.h
index a26549f..b67e777 100644
--- a/bindings/c/include/MGIS/Behaviour/MaterialDataManager.h
+++ b/bindings/c/include/MGIS/Behaviour/MaterialDataManager.h
@@ -187,12 +187,19 @@ MGIS_C_EXPORT mgis_status
 mgis_bv_material_data_manager_get_time_step_scaling_factor(
     mgis_real * const, const mgis_bv_MaterialDataManager* const);
 /*!
- * \brief return the tangent operator
+ * \brief return the tangent operator blocks, stored in the layout of the
+ * material data manager (see `mgis_bv_material_data_manager_get_layout`)
  * \param[out] K: tangent operator
  * \param[in]  d: behaviour data
  */
 MGIS_C_EXPORT mgis_status mgis_bv_material_data_manager_get_tangent_operator(
     mgis_real * *const, mgis_bv_MaterialDataManager* const);
+/*!
+ * \param[out] l: a pointer where the layout of the arrays will be written
+ * \param[in]  d: material data manager
+ */
+MGIS_C_EXPORT mgis_status mgis_bv_material_data_manager_get_layout(
+    mgis_bv_FieldLayout* const, mgis_bv_MaterialDataManager* const);
 /*!
  * \brief update the material data manager
  * \param[in,out] d: data manager
diff --git a/bindings/c/src/MaterialDataManager.cxx b/bindings/c/src/MaterialDataManager.cxx
index b1852c7..bd11061 100644
--- a/bindings/c/src/MaterialDataManager.cxx
+++ b/bindings/c/src/MaterialDataManager.cxx
@@ -326,6 +326,19 @@ mgis_status mgis_bv_material_data_manager_get_tangent_operator(
   return mgis_report_success();
 }  // end of mgis_bv_material_data_manager_get_tangent_operator
 
+mgis_status mgis_bv_material_data_manager_get_layout(
+    mgis_bv_FieldLayout* const l, mgis_bv_MaterialDataManager* const d) {
+  if (d == nullptr) {
+    *l = MGIS_BV_POINT_BY_POINT;
+    return mgis_report_failure(
+        "invalid argument (material data manager is null)");
+  }
+  *l = d->layout == mgis::FieldLayout::POINT_BY_POINT
+           ? MGIS_BV_POINT_BY_POINT
+           : MGIS_BV_COMPONENT_BY_COMPONENT;
+  return mgis_report_success();
+}  // end of mgis_bv_material_data_manager_get_layout
+
 mgis_status mgis_bv_update_material_data_manager(
     mgis_bv_MaterialDataManager* const d) {
   try {
diff --git a/bindings/c/tests/LayoutTest-c.c b/bindings/c/tests/LayoutTest-c.c
index 7b2d842..3c99059 100644
--- a/bindings/c/tests/LayoutTest-c.c
+++ b/bindings/c/tests/LayoutTest-c.c
@@ -103,6 +103,14 @@ int main(const int argc, const char* const* argv) {
       &o, b, "EquivalentViscoplasticStrain"));
   check_status(mgis_bv_behaviour_get_internal_state_variable_offset_by_name(
       &o, b, "EquivalentViscoplasticStrain"));
+  check_status(mgis_bv_material_data_manager_get_layout(&l, m));
+  check(l == MGIS_BV_COMPONENT_BY_COMPONENT,
+        "invalid layout of the material data manager");
+  /* an invalid layout is refused */
+  check(mgis_bv_material_data_manager_initializer_set_layout(
+            mi, (mgis_bv_FieldLayout)7)
+                .exit_status != MGIS_SUCCESS,
+        "an invalid layout must be refused");
   check_status(mgis_bv_material_data_manager_get_state_0(&s0, m));
   check_status(mgis_bv_material_data_manager_get_state_1(&s1, m));
   check_status(mgis_bv_material_state_manager_get_layout(&l, s1));
diff --git a/bindings/fortran/src/mgis_behaviour.f90 b/bindings/fortran/src/mgis_behaviour.f90
index b034788..12340b3 100644
--- a/bindings/fortran/src/mgis_behaviour.f90
+++ b/bindings/fortran/src/mgis_behaviour.f90
@@ -3149,6 +3149,28 @@ contains
     r = material_state_manager_get_layout_wrapper(l, s %ptr)
   end function material_state_manager_get_layout
   !
+  function material_data_manager_get_layout(l, d) &
+       result(r)
+    use, intrinsic :: iso_c_binding, only: c_int
+    use mgis, only: mgis_status
+    implicit none
+    interface
+       function material_data_manager_get_layout_wrapper(l, d) &
+            bind(c,name = 'mgis_bv_material_data_manager_get_layout') &
+            result(r)
+         use, intrinsic :: iso_c_binding, only: c_ptr, c_int
+         use mgis, only: mgis_status
+         integer(kind=c_int), intent(out) :: l
+         type(c_ptr), intent(in),value :: d
+         type(mgis_status) :: r
+       end function material_data_manager_get_layout_wrapper
+    end interface
+    integer(kind=c_int), intent(out) :: l
+    type(MaterialDataManager), intent(in) :: d
+    type(mgis_status) :: r
+    r = material_data_manager_get_layout_wrapper(l, d %ptr)
+  end function material_data_manager_get_layout
+  !
   ! check that the arrays of a material state manager are stored point by
   ! point, as required by the functions returning them as two-dimensional
   ! arrays (one column per point)
@@ -3705,6 +3727,11 @@ contains
     if( r%exit_status .ne. MGIS_SUCCESS) then
        return
     end if
+    r = material_state_manager_check_point_by_point_layout(s0, &
+         "material_data_manager_get_tangent_operator")
+    if( r%exit_status .ne. MGIS_SUCCESS) then
+       return
+    end if
     r = material_data_manager_get_tangent_operator_wrapper(p, m %ptr)
     if( r%exit_status .ne. MGIS_SUCCESS) then
        return
@@ -3713,7 +3740,7 @@ contains
     if( r%exit_status .ne. MGIS_SUCCESS) then
        return
     end if
-    r = material_state_manager_get_thermodynamic_forces_stride(gs, s0)
+    r = material_state_manager_get_thermodynamic_forces_stride(ths, s0)
     if( r%exit_status .ne. MGIS_SUCCESS) then
        return
     end if
diff --git a/bindings/fortran/tests/LayoutTest-f.f90 b/bindings/fortran/tests/LayoutTest-f.f90
index d4dff59..2d2fbd3 100644
--- a/bindings/fortran/tests/LayoutTest-f.f90
+++ b/bindings/fortran/tests/LayoutTest-f.f90
@@ -20,6 +20,7 @@ subroutine test()
   type(MaterialStateManager) s1
   type(mgis_status) st
   real(kind=8), dimension (:,:), pointer :: g => null()
+  real(kind=8), dimension (:,:,:), pointer :: K => null()
   integer(kind=c_int) :: l
   integer :: n = 10
   integer :: ri
@@ -35,6 +36,9 @@ subroutine test()
   call check_status(material_data_manager_get_state_1(s1, m))
   call check_status(material_state_manager_get_layout(l, s1))
   r = check(l == COMPONENT_BY_COMPONENT, 'invalid layout')
+  call check_status(material_data_manager_get_layout(l, m))
+  r = check(l == COMPONENT_BY_COMPONENT, &
+       'invalid layout of the material data manager')
   call check_status(material_state_manager_set_us_external_state_variable( &
        s1, "Temperature", 293.15d0))
   call check_status(update_material_data_manager(m))
@@ -45,6 +49,24 @@ subroutine test()
   st = material_state_manager_get_gradients(g, s1)
   r = check(st%exit_status .ne. MGIS_SUCCESS, &
        'the layout of the gradients has not been checked')
+  call check_status(integrate_material_data_manager( &
+       ri, p, m, INTEGRATION_CONSISTENT_TANGENT_OPERATOR, 180d0))
+  st = material_data_manager_get_tangent_operator(K, m)
+  r = check(st%exit_status .ne. MGIS_SUCCESS, &
+       'the layout of the tangent operator has not been checked')
+  call check_status(free_material_data_manager(m))
+  ! tangent operator of a material data manager stored point by point
+  call check_status(create_material_data_manager(m, b, n))
+  call check_status(material_data_manager_get_state_1(s1, m))
+  call check_status(material_state_manager_set_us_external_state_variable( &
+       s1, "Temperature", 293.15d0))
+  call check_status(update_material_data_manager(m))
+  call check_status(integrate_material_data_manager( &
+       ri, p, m, INTEGRATION_CONSISTENT_TANGENT_OPERATOR, 180d0))
+  call check_status(material_data_manager_get_tangent_operator(K, m))
+  r = check((size(K, 1) == 6) .and. (size(K, 2) == 6) .and. &
+       (size(K, 3) == n), 'invalid shape of the tangent operator')
+  r = check(abs(K(1, 1, 1)) > 0, 'invalid tangent operator')
   ! free ressources
   call check_status(free_material_data_manager(m))
   call check_status(free_material_data_manager_initializer(i))
diff --git a/bindings/python/src/NumPySupport.cxx b/bindings/python/src/NumPySupport.cxx
index 947509a..60b73d6 100644
--- a/bindings/python/src/NumPySupport.cxx
+++ b/bindings/python/src/NumPySupport.cxx
@@ -90,6 +90,12 @@ namespace mgis::python {
     if (i.ndim != 1) {
       mgis::raise("convert_to_span: expected one dimensional array");
     }
+    // the values of a strided array (for instance `a[::2]`) are not
+    // contiguous
+    if ((i.size > 1) &&
+        (i.strides[0] != static_cast<pybind11::ssize_t>(sizeof(double)))) {
+      mgis::raise("convert_to_span: expected a contiguous array");
+    }
     return {static_cast<double*>(i.ptr), static_cast<mgis_size_type>(i.size)};
   }  // end of mgis_convert_to_span
 
