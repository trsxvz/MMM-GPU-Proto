diff --git a/include/MGIS/Behaviour/MemoryLocation.hxx b/include/MGIS/Behaviour/MemoryLocation.hxx
new file mode 100644
index 0000000..27401d5
--- /dev/null
+++ b/include/MGIS/Behaviour/MemoryLocation.hxx
@@ -0,0 +1,39 @@
+/*!
+ * \file   include/MGIS/Behaviour/MemoryLocation.hxx
+ * \brief  This file declares the `MemoryLocation` enumeration.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_BEHAVIOUR_MEMORYLOCATION_HXX
+#define LIB_MGIS_BEHAVIOUR_MEMORYLOCATION_HXX
+
+namespace mgis::behaviour {
+
+  /*!
+   * \brief location of the arrays of a material data manager, declared by
+   * the code which allocates them. It is a property of the data, checked
+   * against the backend of the behaviours generated by the
+   * `generic-parallel` interface of `MFront` and against the functions which
+   * access the arrays on the host.
+   */
+  enum struct MemoryLocation {
+    //! \brief ordinary memory of the host
+    HOST,
+    //! \brief memory of a device, which is not accessible by the host
+    DEVICE,
+    /*!
+     * \brief memory accessible by the host and by the device (managed
+     * memory, shared memory of SYCL, etc.)
+     */
+    SHARED
+  };
+
+}  // end of namespace mgis::behaviour
+
+#endif /* LIB_MGIS_BEHAVIOUR_MEMORYLOCATION_HXX */
diff --git a/src/Integrate.cxx b/src/Integrate.cxx
index ce6fd7d..19dc505 100644
--- a/src/Integrate.cxx
+++ b/src/Integrate.cxx
@@ -445,6 +445,23 @@ namespace mgis::behaviour::internals {
     return Field{values.data() + b * stride, stride, 1};
   }  // end of makeBatchField
 
+  /*!
+   * \brief check that the arrays of a material data manager are accessible
+   * by the device of the backend of its behaviour
+   * \param[in] m: material data manager
+   */
+  static void checkBatchMemoryLocation(const MaterialDataManager& m) {
+    if ((m.memory_location == MemoryLocation::HOST) &&
+        (isDeviceOnlyBackend(m.b))) {
+      mgis::raise(
+          "the arrays of the material data manager are located in the memory "
+          "of the host, which is not accessible by the device of the backend "
+          "'" +
+          m.b.backend +
+          "' (see the location member of MaterialDataManagerInitializer)");
+    }
+  }  // end of checkBatchMemoryLocation
+
   /*!
    * \brief view on the points `[b, e)` of a material data manager, as a
    * batch (`generic-parallel` interface), and fields of the material
@@ -559,6 +576,7 @@ namespace mgis::behaviour::internals {
           "integrate: the behaviour has not been generated by the "
           "generic-parallel interface");
     }
+    checkBatchMemoryLocation(m);
     if (b == e) {
       return BehaviourIntegrationResult{};
     }
@@ -596,6 +614,7 @@ namespace mgis::behaviour::internals {
       const ConstField* const inputs,
       const size_type b,
       const size_type e) {
+    checkBatchMemoryLocation(m);
     if (b == e) {
       return BehaviourIntegrationResult{};
     }
@@ -618,6 +637,7 @@ namespace mgis::behaviour::internals {
       const BehaviourPostProcessing& f,
       const size_type b,
       const size_type e) {
+    checkBatchMemoryLocation(m);
     if (b == e) {
       return BehaviourIntegrationResult{};
     }
diff --git a/src/MaterialDataManager.cxx b/src/MaterialDataManager.cxx
index f5f58fd..a43f806 100644
--- a/src/MaterialDataManager.cxx
+++ b/src/MaterialDataManager.cxx
@@ -57,8 +57,33 @@ namespace mgis::behaviour {
       : s0(behaviour, s, i.s0),
         s1(behaviour, s, i.s1),
         n(s),
+        memory_location(i.location),
         K_stride(getTangentOperatorArraySize(behaviour)),
         b(behaviour) {
+    if (this->memory_location != MemoryLocation::HOST) {
+      // the arrays allocated by the state managers are in the memory of the
+      // host
+      const auto h = behaviour.hypothesis;
+      for (const auto& si : {i.s0, i.s1}) {
+        const auto missing =
+            ((si.gradients.empty()) &&
+             (getArraySize(behaviour.gradients, h) != 0)) ||
+            ((si.thermodynamic_forces.empty()) &&
+             (getArraySize(behaviour.thermodynamic_forces, h) != 0)) ||
+            ((si.internal_state_variables.empty()) &&
+             (getArraySize(behaviour.isvs, h) != 0)) ||
+            ((si.stored_energies.empty()) &&
+             (behaviour.computesStoredEnergy)) ||
+            ((si.dissipated_energies.empty()) &&
+             (behaviour.computesDissipatedEnergy));
+        if (missing) {
+          mgis::raise(
+              "MaterialDataManager::MaterialDataManager: all the arrays of "
+              "the states must be given by the initializer when they are not "
+              "located in the memory of the host");
+        }
+      }
+    }
     if (!i.K.empty()) {
       this->useExternalArrayOfTangentOperatorBlocks(i.K);
     }
@@ -90,7 +115,25 @@ namespace mgis::behaviour {
     this->thread_safe = bv;
   }  // end of setThreadSafe
 
+  /*!
+   * \brief check that an array can be allocated by a material data manager,
+   * i.e. in the memory of the host
+   * \param[in] m: material data manager
+   * \param[in] v: array
+   * \param[in] n: name of the array
+   */
+  static void checkHostAllocation(const MaterialDataManager& m,
+                                  const std::span<real>& v,
+                                  const char* const n) {
+    if ((v.empty()) && (m.memory_location != MemoryLocation::HOST)) {
+      mgis::raise("MaterialDataManager: the array of the " + std::string{n} +
+                  " must be given by the initializer, since the arrays are "
+                  "not located in the memory of the host");
+    }
+  }  // end of checkHostAllocation
+
   void MaterialDataManager::allocateArrayOfTangentOperatorBlocks() {
+    checkHostAllocation(*this, this->K, "tangent operators");
     if (this->thread_safe) {
       allocateArrayWithSynchronization(this->K, this->K_values,
                                        this->n * this->K_stride);
@@ -117,6 +160,7 @@ namespace mgis::behaviour {
   }  // end of useExternalArrayOfTangentOperatorBlocks
 
   void MaterialDataManager::allocateArrayOfSpeedOfSounds() {
+    checkHostAllocation(*this, this->speed_of_sound, "speed of sound");
     if (this->thread_safe) {
       allocateArrayWithSynchronization(this->speed_of_sound,
                                        this->speed_of_sound_values, this->n);
@@ -167,7 +211,24 @@ namespace mgis::behaviour {
 
   MaterialDataManager::~MaterialDataManager() = default;
 
+  /*!
+   * \brief check that the arrays of a material data manager are accessible
+   * by the host
+   * \param[in] f: calling function
+   * \param[in] m: material data manager
+   */
+  static void checkHostAccess(const char* const f,
+                              const MaterialDataManager& m) {
+    if (m.memory_location == MemoryLocation::DEVICE) {
+      mgis::raise(std::string{f} +
+                  ": the arrays of the material data manager are located in "
+                  "the memory of a device, which is not accessible by the "
+                  "host");
+    }
+  }  // end of checkHostAccess
+
   void update(MaterialDataManager& m, const UpdateArguments& args) {
+    checkHostAccess("update", m);
     if (args.zero_tangent_operator_blocks) {
       std::fill(m.K.begin(), m.K.end(), real{0});
     }
@@ -179,6 +240,7 @@ namespace mgis::behaviour {
   }  // end of update
 
   void revert(MaterialDataManager& m) {
+    checkHostAccess("revert", m);
     std::fill(m.K.begin(), m.K.end(), real{0});
     updateValues(m.s1, m.s0);
   }  // end of update
diff --git a/tests/GenericParallelCUDATest.cxx b/tests/GenericParallelCUDATest.cxx
index f1af800..102d43e 100644
