   return b;
 }
 
+/*!
+ * \return true if the given function throws an exception whose message
+ * contains the given text
+ */
+template <typename Function>
+static bool throws(const Function& f, const std::string_view text) {
+  try {
+    f();
+  } catch (std::exception& e) {
+    return std::string_view{e.what()}.find(text) != std::string_view::npos;
+  }
+  return false;
+}
+
 //! \brief array of values in managed memory
 struct ManagedArray {
   explicit ManagedArray(const mgis::size_type s) : size(s) {
@@ -98,6 +112,7 @@ struct ManagedData {
     i.K = this->K.span();
     i.s0 = this->s0.initializer();
     i.s1 = this->s1.initializer();
+    i.location = mgis::behaviour::MemoryLocation::SHARED;
     return i;
   }
   ManagedArray K;
@@ -227,17 +242,48 @@ static void testElasticity(const std::string& library,
   setMaterialProperty(managers.gpu_m.s1, "PoissonRatio", 0.3);
   auto opts = BehaviourIntegrationOptions{};
   check(
-      [&managers, &opts] {
-        try {
-          static_cast<void>(integrate(managers.gpu_m, opts, 1));
-        } catch (...) {
-          return true;
-        }
-        return false;
-      }(),
+      throws([&managers,
+              &opts] { static_cast<void>(integrate(managers.gpu_m, opts, 1)); },
+             "must be given as a span"),
       "a uniform value in the memory of the host must be refused");
 }  // end of testElasticity
 
+//! \brief the location of the data is checked against the backend
+static void testMemoryLocations(const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{10};
+  const auto b = load(gpu_library, "Elasticity", Hypothesis::TRIDIMENSIONAL);
+  const auto opts = BehaviourIntegrationOptions{};
+  // data in the memory of the host
+  auto m = MaterialDataManager(b, n);
+  check(throws([&m, &opts] { static_cast<void>(integrate(m, opts, 1)); },
+               "located in the memory of the host"),
+        "data in the memory of the host must be refused");
+  // missing arrays
+  auto data = ManagedData(b, n);
+  auto i = data.initializer();
+  i.s1.gradients = {};
+  check(throws([&b, &i] { MaterialDataManager(b, n, i); },
+               "must be given by the initializer"),
+        "missing arrays must be refused");
+  // missing tangent operators
+  auto i2 = data.initializer();
+  i2.K = {};
+  auto m2 = MaterialDataManager(b, n, i2);
+  auto opts2 = BehaviourIntegrationOptions{};
+  opts2.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  check(throws([&m2, &opts2] { static_cast<void>(integrate(m2, opts2, 1)); },
+               "tangent operators must be given"),
+        "missing tangent operators must be refused");
+  // update on the host of data located on the device
+  auto i3 = data.initializer();
+  i3.location = MemoryLocation::DEVICE;
+  auto m3 = MaterialDataManager(b, n, i3);
+  check(throws([&m3] { update(m3); }, "not accessible by the host"),
+        "the update on the host of data located on a device must be refused");
+}  // end of testMemoryLocations
+
 int main(const int argc, const char* const* const argv) {
   if (argc != 3) {
     std::cerr << "usage: " << argv[0] << " cuda-library generic-library\n";
@@ -246,6 +292,7 @@ int main(const int argc, const char* const* const argv) {
   try {
     testNorton(argv[2], argv[1]);
     testElasticity(argv[2], argv[1]);
+    testMemoryLocations(argv[1]);
   } catch (std::exception& e) {
     std::cerr << e.what() << '\n';
     return EXIT_FAILURE;
