From 2179e6a116dc6018829921550aa0e975b5c7c06d Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 15 Oct 2026 00:11:45 +0200
Subject: [PATCH] getVariableOffset: do not throw in the overload taking a
 context

The noexcept overload of getVariableOffset taking a context called the
throwing overload of getVariableSize: an invalid type identifier
terminated the program instead of being reported in the context. It now
calls the overload of getVariableSize taking a context.
---
 src/Variable.cxx | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/Variable.cxx b/src/Variable.cxx
index e23f85e..40944bf 100644
--- a/src/Variable.cxx
+++ b/src/Variable.cxx
@@ -381,7 +381,11 @@ namespace mgis::behaviour {
       if (v.name == n) {
         return o;
       }
-      o += getVariableSize(v, h);
+      const auto s = getVariableSize(ctx, v, h);
+      if (!s.has_value()) {
+        return {};
+      }
+      o += *s;
     }
     return ctx.registerErrorMessage("getVariableOffset: no variable named '" +
                                     std::string(n) + "'");
-- 
2.43.0

