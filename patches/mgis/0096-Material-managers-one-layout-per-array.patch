   // forward declaration
   struct Behaviour;
 
+  /*!
+   * \brief layout of the arrays of a material data manager: layouts of the
+   * arrays of its states (see `MaterialStateManagerLayout`) and layout of
+   * the tangent operator blocks.
+   *
+   * A layout is implicitly built from a `FieldLayout`, which is then the
+   * layout of all the arrays.
+   */
+  struct MaterialDataManagerLayout {
+    /*!
+     * \brief constructor
+     * \param[in] l: layout of all the arrays
+     */
+    constexpr MaterialDataManagerLayout(
+        const FieldLayout l = FieldLayout::POINT_BY_POINT) noexcept
+        : gradients(l),
+          thermodynamic_forces(l),
+          internal_state_variables(l),
+          external_state_variables(l),
+          tangent_operator(l) {}
+    //! \brief comparison operator
+    constexpr bool operator==(const MaterialDataManagerLayout&) const noexcept =
+        default;
+    //! \brief layout of the gradients
+    FieldLayout gradients;
+    //! \brief layout of the thermodynamic forces
+    FieldLayout thermodynamic_forces;
+    //! \brief layout of the internal state variables
+    FieldLayout internal_state_variables;
+    /*!
+     * \brief layout of the values given at each point for an external state
+     * variable with several components (see `MaterialStateManagerLayout`)
+     */
+    FieldLayout external_state_variables;
+    //! \brief layout of the tangent operator blocks
+    FieldLayout tangent_operator;
+  };  // end of MaterialDataManagerLayout
+
+  /*!
+   * \return the layout of the arrays of the states of a material data
+   * manager
+   * \param[in] l: layout of the arrays of the material data manager
+   */
+  constexpr MaterialStateManagerLayout getStateLayout(
+      const MaterialDataManagerLayout& l) noexcept {
+    auto r = MaterialStateManagerLayout{};
+    r.gradients = l.gradients;
+    r.thermodynamic_forces = l.thermodynamic_forces;
+    r.internal_state_variables = l.internal_state_variables;
+    r.external_state_variables = l.external_state_variables;
+    return r;
+  }  // end of getStateLayout
+
+  /*!
+   * \return the layout of all the arrays of a material data manager, if
+   * they have the same layout
+   * \param[in] l: layout of the arrays
+   */
+  constexpr std::optional<FieldLayout> getUniformLayout(
+      const MaterialDataManagerLayout& l) noexcept {
+    const auto ol = getUniformLayout(getStateLayout(l));
+    if ((!ol.has_value()) || (*ol != l.tangent_operator)) {
+      return {};
+    }
+    return ol;
+  }  // end of getUniformLayout
