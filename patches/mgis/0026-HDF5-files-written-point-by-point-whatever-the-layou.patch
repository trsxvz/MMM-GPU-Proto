+#ifdef MGIS_HAVE_HDF5
+
+//! \brief files written by a manager and restored by a manager with another
+//! layout
+static void testHDF5(const std::string& library) {
+  using namespace mgis::behaviour;
+  using namespace mgis::utilities::hdf5;
+  const auto b = load(library, "TensorialExternalStateVariableTest",
+                      Hypothesis::TRIDIMENSIONAL);
+  const auto h = b.hypothesis;
+  constexpr auto n = size_type{3};
+  auto ctx = mgis::Context{};
+  auto file = H5::H5File("MaterialDataManagerLayoutTest.h5", H5F_ACC_TRUNC);
+  auto root = file.openGroup("/");
+  for (const auto l :
+       {FieldLayout::POINT_BY_POINT, FieldLayout::COMPONENT_BY_COMPONENT}) {
+    const auto other = l == FieldLayout::POINT_BY_POINT
+                           ? FieldLayout::COMPONENT_BY_COMPONENT
+                           : FieldLayout::POINT_BY_POINT;
+    auto m = makeManager(b, n, l);
+    auto r = makeManager(b, n, other);
+    for (auto* const s : {&m->s1, &r->s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+    }
+    // values of the states and of the external state variables
+    auto esvs = std::vector<std::vector<real>>{};
+    esvs.reserve(2 * b.esvs.size());
+    for (auto* const s : {&m->s1}) {
+      const auto isvs = getInternalStateVariablesView(*s);
+      for (size_type i = 0; i != n; ++i) {
+        for (size_type c = 0; c != isvs.getNumberOfComponents(); ++c) {
+          isvs(i, c) = static_cast<real>(100 * i + c);
+        }
+      }
+      for (const auto& v : b.esvs) {
+        const auto nc = getVariableSize(v, h);
+        auto& values = esvs.emplace_back(n * nc);
+        const auto f = mgis::makeFieldView(std::span<real>(values), l, n, nc);
+        for (size_type i = 0; i != n; ++i) {
+          for (size_type c = 0; c != nc; ++c) {
+            f(i, c) = static_cast<real>(1000 * i + c);
+          }
+        }
+        setExternalStateVariable(*s, v.name, values,
+                                 MaterialStateManager::EXTERNAL_STORAGE);
+      }
+    }
+    for (const auto& v : b.esvs) {
+      auto& values = esvs.emplace_back(n * getVariableSize(v, h));
+      setExternalStateVariable(r->s1, v.name, values,
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    const auto g = std::string{l == FieldLayout::POINT_BY_POINT
+                                   ? "point_by_point"
+                                   : "component_by_component"};
+    auto og = createGroup(ctx, root, g);
+    if (!check(!mgis::isInvalid(og), "HDF5: group not created")) {
+      return;
+    }
+    check(save(ctx, *og, m->s1), "HDF5: save failed");
+    check(restore(ctx, r->s1, *og, {.restore_mass_densities = false}),
+          "HDF5: restore failed " + ctx.getErrorMessage());
+    check(same(getInternalStateVariablesView(m->s1),
+               getInternalStateVariablesView(r->s1)),
+          "HDF5: invalid internal state variables (" + g + ")");
+    for (std::size_t k = 0; k != b.esvs.size(); ++k) {
+      const auto nc = getVariableSize(b.esvs[k], h);
+      check(same(mgis::makeFieldView(std::span<const real>(esvs[k]), l, n, nc),
+                 mgis::makeFieldView(
+                     std::span<const real>(esvs[b.esvs.size() + k]), other, n,
+                     nc)),
+            "HDF5: invalid external state variable '" + b.esvs[k].name + "' (" +
+                g + ")");
+    }
+  }
+}  // end of testHDF5
+
+#endif /* MGIS_HAVE_HDF5 */
 
