From 8d9bc38c43ca01e3e63fd3dd1e063963be1907ff Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 00:07:59 +0200
Subject: [PATCH] HDF5 files written point by point, whatever the layout

save writes and restore reads the values given at each point point by point,
so that a file can be restored in a material state manager with another
layout. Fix of the restore of the external state variables with several
components given at each point: the size of the storage was compared to the
number of points instead of the number of values (span), and a vector was
resized to the number of points before reading all the values (out of
bounds write); a uniform value read in a vector now resizes it to the
values of one point.
---
 src/MaterialStateManager.cxx            | 248 +++++++++++++++++++-----
 tests/MaterialDataManagerLayoutTest.cxx |  87 ++++++++-
 2 files changed, 287 insertions(+), 48 deletions(-)

diff --git a/src/MaterialStateManager.cxx b/src/MaterialStateManager.cxx
index a43af8b..8218d14 100644
--- a/src/MaterialStateManager.cxx
+++ b/src/MaterialStateManager.cxx
@@ -925,41 +925,179 @@ namespace mgis::behaviour {
 
 #ifdef MGIS_HAVE_HDF5
 
+  /*
+   * The files always hold the values point by point, whatever the layout of
+   * the material state manager, so that a file can be restored in a material
+   * state manager with another layout.
+   */
+
+  /*!
+   * \return the values given at each point, stored point by point
+   * \param[in] values: values, in the given layout
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] l: layout
+   */
+  static std::vector<real> getValuesPointByPoint(
+      const std::span<const real> values,
+      const size_type n,
+      const size_type nc,
+      const FieldLayout l) {
+    auto r = std::vector<real>(values.size());
+    const auto v = makeFieldView(values, l, n, nc);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        r[i * nc + j] = v(i, j);
+      }
+    }
+    return r;
+  }  // end of getValuesPointByPoint
+
+  /*!
+   * \brief copy values stored point by point in an array with the given
+   * layout
+   * \param[out] values: values, in the given layout
+   * \param[in] pvalues: values stored point by point
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] l: layout
+   */
+  static void setValuesFromPointByPoint(const std::span<real> values,
+                                        const std::span<const real> pvalues,
+                                        const size_type n,
+                                        const size_type nc,
+                                        const FieldLayout l) {
+    const auto v = makeFieldView(values, l, n, nc);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        v(i, j) = pvalues[i * nc + j];
+      }
+    }
+  }  // end of setValuesFromPointByPoint
+
+  /*!
+   * \brief write values given at each point, point by point
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] l: layout of the values
+   */
+  [[nodiscard]] static bool writePointByPoint(
+      Context& ctx,
+      H5::Group& g,
+      const std::string& name,
+      const std::span<const real> values,
+      const size_type n,
+      const size_type nc,
+      const FieldLayout l,
+      const bool allow_overwrite) noexcept {
+    using namespace mgis::utilities::hdf5;
+    if ((l == FieldLayout::POINT_BY_POINT) || (nc <= 1) ||
+        (values.size() != n * nc)) {
+      return write(ctx, g, name, values, allow_overwrite);
+    }
+    try {
+      return write(ctx, g, name, getValuesPointByPoint(values, n, nc, l),
+                   allow_overwrite);
+    } catch (...) {
+      return ctx.registerErrorMessage("saving '" + name + "' failed");
+    }
+  }  // end of writePointByPoint
+
+  /*!
+   * \brief read values given at each point, stored point by point in the
+   * file, in an array with the given layout
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] l: layout of the values
+   */
+  [[nodiscard]] static bool readPointByPoint(Context& ctx,
+                                             std::span<real> values,
+                                             const H5::Group& g,
+                                             const std::string& name,
+                                             const size_type n,
+                                             const size_type nc,
+                                             const FieldLayout l) noexcept {
+    using namespace mgis::utilities::hdf5;
+    if ((l == FieldLayout::POINT_BY_POINT) || (nc <= 1)) {
+      return read(ctx, values, g, name);
+    }
+    try {
+      auto pvalues = std::vector<real>(values.size());
+      if (!read(ctx, std::span<real>(pvalues), g, name)) {
+        return false;
+      }
+      setValuesFromPointByPoint(values, pvalues, n, nc, l);
+      return true;
+    } catch (...) {
+      return ctx.registerErrorMessage("restoring '" + name + "' failed");
+    }
+  }  // end of readPointByPoint
+
+  /*!
+   * \brief save a field holder
+   * \param[in] s: material state manager
+   * \param[in] nc: number of components of the variable
+   */
   [[nodiscard]] static bool save(
       Context& ctx,
       H5::Group& g,
       const std::string& n,
       const MaterialStateManager::MutableFieldHolder& f,
+      const MaterialStateManager& s,
+      const size_type nc,
       const MaterialStateManagerSavingOptions& opts) noexcept {
     using namespace mgis::utilities::hdf5;
     if (std::holds_alternative<real>(f.value)) {
       return write(ctx, g, n, std::get<real>(f.value), opts.allow_overwrite);
     } else if (std::holds_alternative<std::span<real>>(f.value)) {
-      return write(ctx, g, n, std::get<std::span<real>>(f.value),
-                   opts.allow_overwrite);
+      return writePointByPoint(ctx, g, n, std::get<std::span<real>>(f.value),
+                               s.n, nc, s.layout, opts.allow_overwrite);
     }
-    return write(ctx, g, n, std::get<std::vector<real>>(f.value),
-                 opts.allow_overwrite);
+    return writePointByPoint(ctx, g, n, std::get<std::vector<real>>(f.value),
+                             s.n, nc, s.layout, opts.allow_overwrite);
   }  // end of save
 
+  /*!
+   * \brief save a field holder
+   * \param[in] s: material state manager
+   * \param[in] nc: number of components of the variable
+   */
   [[nodiscard]] static bool save(
       Context& ctx,
       H5::Group& g,
       const std::string& n,
       const MaterialStateManager::FieldHolder& f,
+      const MaterialStateManager& s,
+      const size_type nc,
       const MaterialStateManagerSavingOptions& opts) noexcept {
     using namespace mgis::utilities::hdf5;
     if (std::holds_alternative<std::monostate>(f)) {
       return ctx.registerErrorMessage("uninitialized field holder '" + n + "'");
     }
     if (std::holds_alternative<std::span<const real>>(f)) {
-      return write(ctx, g, n, std::get<std::span<const real>>(f),
-                   opts.allow_overwrite);
+      return writePointByPoint(ctx, g, n, std::get<std::span<const real>>(f),
+                               s.n, nc, s.layout, opts.allow_overwrite);
     }
     return save(ctx, g, n,
-                std::get<MaterialStateManager::MutableFieldHolder>(f), opts);
+                std::get<MaterialStateManager::MutableFieldHolder>(f), s, nc,
+                opts);
   }  // end of save
 
+  /*!
+   * \return the number of components of the variable of the given name, or
+   * one if no variable has this name
+   * \param[in] variables: variables
+   * \param[in] n: name
+   * \param[in] h: modelling hypothesis
+   */
+  static size_type getNumberOfComponents(const std::vector<Variable>& variables,
+                                         const std::string_view n,
+                                         const Hypothesis h) {
+    const auto p = std::find_if(variables.begin(), variables.end(),
+                                [n](const Variable& v) { return v.name == n; });
+    return p == variables.end() ? 1 : getVariableSize(*p, h);
+  }  // end of getNumberOfComponents
+
   bool save(Context& ctx,
             H5::Group& g,
             const MaterialStateManager& s,
@@ -969,18 +1107,21 @@ namespace mgis::behaviour {
       return ctx.registerErrorMessage(getHostAccessErrorMessage("save"));
     }
     if (opts.save_gradients) {
-      if (!write(ctx, g, "gradients", s.gradients, opts.allow_overwrite)) {
