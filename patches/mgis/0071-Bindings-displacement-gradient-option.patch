+++ b/bindings/c/tests/DisplacementGradientTest-c.c
@@ -0,0 +1,76 @@
+/*!
+ * \file   DisplacementGradientTest-c.c
+ * \brief  Finite strain behaviour loaded with the displacement gradient
+ * through the C bindings
+ * \date   14/10/2026
+ * \copyright (C) Copyright Thomas Helfer 2018.
+ * Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include "MGIS/Behaviour/Behaviour.h"
+
+int test_status = EXIT_SUCCESS;
+
+static void check_status(const mgis_status s) {
+  if (s.exit_status != MGIS_SUCCESS) {
+    fprintf(stderr, "invalid function call: %s\n", s.msg);
+    exit(EXIT_FAILURE);
+  }
+}  // end of check_status
+
+static int check(const int b, const char* const e) {
+  if (b == 0) {
+    test_status = EXIT_FAILURE;
+    fprintf(stderr, "%s\n", e);
+  }
+  return b;
+}  // end of check
+
+/*!
+ * \brief load the behaviour with the given gradient, selected by its name
+ * if `g` is not null, and by the enumeration otherwise
+ */
+static void test(const char* const* argv,
+                 const char* const g,
+                 const mgis_bv_FiniteStrainBehaviourGradient eg,
+                 const int expected) {
+  mgis_bv_Behaviour* b;
+  mgis_bv_FiniteStrainBehaviourOptions* o;
+  check_status(mgis_bv_create_finite_strain_behaviour_options(&o));
+  if (g != NULL) {
+    check_status(
+        mgis_bv_finite_strain_behaviour_options_set_gradient_by_string(o, g));
+  } else {
+    check_status(mgis_bv_finite_strain_behaviour_options_set_gradient(o, eg));
+  }
+  check_status(mgis_bv_load_finite_strain_behaviour(&b, o, argv[1], argv[2],
+                                                    "Tridimensional"));
+  int r;
+  check_status(mgis_bv_behaviour_uses_displacement_gradient(&r, b));
+  check(r == expected, "invalid kind of gradient");
+  mgis_size_type gs_size;
+  check_status(mgis_bv_behaviour_get_gradients_size(&gs_size, b));
+  check(gs_size == 9, "invalid gradient size");
+  check_status(mgis_bv_free_finite_strain_behaviour_options(&o));
+  check_status(mgis_bv_free_behaviour(&b));
+}  // end of test
+
+int main(const int argc, const char* const* argv) {
+  if (!check(argc == 3, "expected three arguments")) {
+    return EXIT_FAILURE;
+  }
+  test(argv, NULL, MGIS_BV_DEFORMATION_GRADIENT, 0);
+  test(argv, NULL, MGIS_BV_DISPLACEMENT_GRADIENT, 1);
+  test(argv, "DeformationGradient", MGIS_BV_DEFORMATION_GRADIENT, 0);
+  test(argv, "F", MGIS_BV_DEFORMATION_GRADIENT, 0);
+  test(argv, "DisplacementGradient", MGIS_BV_DEFORMATION_GRADIENT, 1);
+  test(argv, "H", MGIS_BV_DEFORMATION_GRADIENT, 1);
+  return test_status;
+}  // end of main
