     mgis_bv_FiniteStrainBehaviourOptions* const, const char* const);
+/*!
+ * \brief set the gradient given to the behaviour: the deformation gradient
+ * (by default), or the displacement gradient, which keeps the relative
+ * precision of small strains in single precision (see the documentation of
+ * `mgis::behaviour::FiniteStrainBehaviourOptions::gradient`)
+ * \param[in] o: finite strain behaviour options
+ * \param[in] g: gradient
+ */
+MGIS_C_EXPORT mgis_status mgis_bv_finite_strain_behaviour_options_set_gradient(
+    mgis_bv_FiniteStrainBehaviourOptions* const,
+    const mgis_bv_FiniteStrainBehaviourGradient);
+/*!
+ * \brief set the gradient given to the behaviour
+ * \param[in] o: finite strain behaviour options
+ * \param[in] g: gradient
+ * g must be have the following values:
+ * - `DeformationGradient` (or `F`)
+ * - `DisplacementGradient` (or `H`)
+ */
+MGIS_C_EXPORT mgis_status
+mgis_bv_finite_strain_behaviour_options_set_gradient_by_string(
+    mgis_bv_FiniteStrainBehaviourOptions* const, const char* const);
 /*!
  * \brief free the ressources associated with a
  * `mgis_bv_FiniteStrainBehaviourOptions` object
@@ -205,6 +234,15 @@ MGIS_C_EXPORT mgis_status mgis_bv_load_finite_strain_behaviour(
  */
 MGIS_C_EXPORT mgis_status mgis_bv_behaviour_get_tangent_operator_array_size(
     mgis_size_type* const, const mgis_bv_Behaviour* const);
+/*!
+ * \brief state if the gradients of the behaviour are the displacement
+ * gradient rather than the deformation gradient (finite strain behaviour
+ * loaded with the `MGIS_BV_DISPLACEMENT_GRADIENT` option)
+ * \param[out] r: result
+ * \param[in] b: behaviour
+ */
+MGIS_C_EXPORT mgis_status mgis_bv_behaviour_uses_displacement_gradient(
+    int* const, const mgis_bv_Behaviour* const);
 /*
  * The following rotation functions report a failure for a behaviour which
  * provides no rotation function of an integration point: an isotropic
diff --git a/bindings/c/src/Behaviour.cxx b/bindings/c/src/Behaviour.cxx
index 822ea87..9cb0324 100644
--- a/bindings/c/src/Behaviour.cxx
+++ b/bindings/c/src/Behaviour.cxx
@@ -117,6 +117,42 @@ mgis_bv_finite_strain_behaviour_options_set_tangent_operator_by_string(
 }  // end of
    // mgis_bv_finite_strain_behaviour_options_set_tangent_operator_by_string
 
+mgis_status mgis_bv_finite_strain_behaviour_options_set_gradient(
+    mgis_bv_FiniteStrainBehaviourOptions* const o,
+    const mgis_bv_FiniteStrainBehaviourGradient g) {
+  if (o == nullptr) {
+    return mgis_report_failure("invalid argument");
+  }
+  if (g == MGIS_BV_DEFORMATION_GRADIENT) {
+    o->gradient =
+        mgis::behaviour::FiniteStrainBehaviourOptions::DEFORMATION_GRADIENT;
+  } else if (g == MGIS_BV_DISPLACEMENT_GRADIENT) {
+    o->gradient =
+        mgis::behaviour::FiniteStrainBehaviourOptions::DISPLACEMENT_GRADIENT;
+  } else {
+    return mgis_report_failure("invalid gradient");
+  }
+  return mgis_report_success();
+}  // end of mgis_bv_finite_strain_behaviour_options_set_gradient
+
+mgis_status mgis_bv_finite_strain_behaviour_options_set_gradient_by_string(
+    mgis_bv_FiniteStrainBehaviourOptions* const o, const char* const g) {
+  if ((o == nullptr) || (g == nullptr)) {
+    return mgis_report_failure("invalid argument");
+  }
+  if ((strcmp(g, "DeformationGradient") == 0) || (strcmp(g, "F") == 0)) {
+    o->gradient =
+        mgis::behaviour::FiniteStrainBehaviourOptions::DEFORMATION_GRADIENT;
+  } else if ((strcmp(g, "DisplacementGradient") == 0) ||
+             (strcmp(g, "H") == 0)) {
+    o->gradient =
+        mgis::behaviour::FiniteStrainBehaviourOptions::DISPLACEMENT_GRADIENT;
+  } else {
+    return mgis_report_failure("invalid gradient");
+  }
+  return mgis_report_success();
+}  // end of mgis_bv_finite_strain_behaviour_options_set_gradient_by_string
+
 mgis_status mgis_bv_free_finite_strain_behaviour_options(
     mgis_bv_FiniteStrainBehaviourOptions** o) {
   try {
@@ -354,6 +390,16 @@ mgis_status mgis_bv_behaviour_get_tangent_operator_array_size(
   return mgis_report_success();
 }  // end of mgis_bv_behaviour_get_tangent_operator_array_size
 
+mgis_status mgis_bv_behaviour_uses_displacement_gradient(
+    int* const r, const mgis_bv_Behaviour* const b) {
+  *r = static_cast<int>(false);
+  if (b == nullptr) {
+    return mgis_report_failure("invalid argument");
+  }
+  *r = static_cast<int>(mgis::behaviour::usesDisplacementGradient(*b));
+  return mgis_report_success();
+}  // end of mgis_bv_behaviour_uses_displacement_gradient
