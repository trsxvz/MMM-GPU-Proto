+++ b/bindings/c/include/MGIS/Behaviour/Behaviour.h
@@ -94,6 +94,13 @@ typedef enum {
                         * deformation gradient  */
 } mgis_bv_FiniteStrainBehavourTangentOperator;
 
+//! gradients given to finite strain behaviours
+typedef enum {
+  MGIS_BV_DEFORMATION_GRADIENT = 0, /*!< \brief deformation gradient F */
+  MGIS_BV_DISPLACEMENT_GRADIENT = 1 /*!< \brief displacement gradient
+                                     *   H = F - I */
+} mgis_bv_FiniteStrainBehaviourGradient;
+
 /*!
  * \brief allocate a new
  * `mgis_bv_FiniteStrainBehaviourOptions` object
@@ -144,6 +151,28 @@ mgis_bv_finite_strain_behaviour_options_set_tangent_operator(
 MGIS_C_EXPORT mgis_status
