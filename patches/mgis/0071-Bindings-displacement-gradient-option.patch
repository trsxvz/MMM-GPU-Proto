@@ -0,0 +1,37 @@
+# -*- coding: utf-8 -*-
+
+import os
+try:
+    import unittest2 as unittest
+except ImportError:
+    import unittest
+import mgis.behaviour as mgis_bv
+
+
+class DisplacementGradientTest(unittest.TestCase):
+    def test_pass(self):
+
+        gradients = mgis_bv.FiniteStrainBehaviourOptionsGradient
+        # path to the test library
+        lib = os.environ['MGIS_TEST_BEHAVIOURS_LIBRARY']
+        h = mgis_bv.Hypothesis.Tridimensional
+        o = mgis_bv.FiniteStrainBehaviourOptions()
+        self.assertTrue(o.gradient == gradients.DEFORMATION_GRADIENT,
+                        'invalid default gradient')
+        bF = mgis_bv.load(o, lib, 'HenckyElasticity', h)
+        o.gradient = gradients.DISPLACEMENT_GRADIENT
+        bH = mgis_bv.load(o, lib, 'HenckyElasticity', h)
+        self.assertFalse(mgis_bv.usesDisplacementGradient(bF),
+                         'unexpected displacement gradient')
+        self.assertTrue(mgis_bv.usesDisplacementGradient(bH),
+                        'displacement gradient expected')
+        self.assertTrue(bF.gradients[0].name == 'DeformationGradient',
+                        'invalid gradient name')
+        self.assertTrue(bH.gradients[0].name == 'DisplacementGradient',
+                        'invalid gradient name')
+        self.assertTrue(bH.gradients[0].type == mgis_bv.VariableType.TENSOR,
+                        'invalid gradient type')
+
+
+if __name__ == '__main__':
+    unittest.main()
