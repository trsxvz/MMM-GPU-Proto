From bc8a95079d3db7dbb029839241bcda3ecec16dcc Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 01:07:08 +0200
Subject: [PATCH] CUDA tests of the functions on views of arrays of the device

Integration on a material data view whose arrays are located in the
memory of the device only, stored component by component with a padding,
with a workspace and with the synchronous and asynchronous policies;
extraction, update and revert with the operations of CUDA; initialize
function with inputs on the device; post-processing with outputs on the
device. Compared to the computations point by point on the host.
---
 tests/FieldOperationsCUDATest.cu | 264 +++++++++++++++++++++++++++++++
 1 file changed, 264 insertions(+)

diff --git a/tests/FieldOperationsCUDATest.cu b/tests/FieldOperationsCUDATest.cu
index 576c8d3..a7d09c4 100644
--- a/tests/FieldOperationsCUDATest.cu
+++ b/tests/FieldOperationsCUDATest.cu
@@ -19,6 +19,7 @@
  */
 
 #include <cmath>
+#include <memory>
 #include <algorithm>
 #include <span>
 #include <array>
@@ -494,6 +495,268 @@ static void testViewsOnDevice(const std::string& gp_library,
   checkCUDA(cudaStreamDestroy(stream), "cudaStreamDestroy");
 }  // end of testViewsOnDevice
 
+/*!
+ * \brief arrays of the states of a material in the memory of the device
+ * only, stored component by component with a stride `ld` greater than the
+ * number of points, and the material data view describing them
+ */
+struct DeviceViewData {
+  DeviceViewData(const mgis::behaviour::Behaviour& b,
+                 const size_type n,
+                 const size_type ld)
+      : gs(getArraySize(b.gradients, b.hypothesis)),
+        ts(getArraySize(b.thermodynamic_forces, b.hypothesis)),
+        is(getArraySize(b.isvs, b.hypothesis)),
+        Ks(getTangentOperatorArraySize(b)),
+        npoints(n),
+        stride(ld),
+        g0(std::max(gs * ld, size_type{1})),
+        g1(std::max(gs * ld, size_type{1})),
+        t0(std::max(ts * ld, size_type{1})),
+        t1(std::max(ts * ld, size_type{1})),
+        i0(std::max(is * ld, size_type{1})),
+        i1(std::max(is * ld, size_type{1})),
+        K(std::max(Ks * ld, size_type{1})),
+        v(b, n, mgis::MemoryLocation::DEVICE) {
+    this->v.s0.gradients = this->view(this->g0, this->gs);
+    this->v.s1.gradients = this->view(this->g1, this->gs);
+    this->v.s0.thermodynamic_forces = this->view(this->t0, this->ts);
+    this->v.s1.thermodynamic_forces = this->view(this->t1, this->ts);
+    this->v.s0.internal_state_variables = this->view(this->i0, this->is);
+    this->v.s1.internal_state_variables = this->view(this->i1, this->is);
+    this->v.K = this->view(this->K, this->Ks);
+  }
+  //! \return a view on an array
+  FieldView<real> view(const DeviceArray& a, const size_type nc) const {
+    return mgis::makeComponentByComponentFieldView(a.span(), this->npoints, nc,
+                                                   this->stride);
+  }
+  //! \brief copy the states of a material data manager stored point by point
+  void copyFrom(const mgis::behaviour::MaterialDataManager& m) {
+    const auto n = this->npoints;
+    const auto ld = this->stride;
+    const auto copy = [n, ld](DeviceArray& a, const std::span<const real> v,
+                              const size_type nc) {
+      if (nc != 0) {
+        a.copyFrom(storeComponentByComponent({v.begin(), v.end()}, n, nc, ld));
+      }
+    };
+    copy(this->g0, m.s0.gradients, this->gs);
+    copy(this->g1, m.s1.gradients, this->gs);
+    copy(this->t0, m.s0.thermodynamic_forces, this->ts);
+    copy(this->t1, m.s1.thermodynamic_forces, this->ts);
+    copy(this->i0, m.s0.internal_state_variables, this->is);
+    copy(this->i1, m.s1.internal_state_variables, this->is);
+    copy(this->K, std::vector<real>(this->Ks * n, 0), this->Ks);
+  }
+  /*!
+   * \return the maximum of the differences with the values of a manager
+   * stored point by point, divided by the maximum of the absolute values of
+   * the manager: the results differ by rounding errors (contraction of the
+   * floating point operations by the CUDA compiler)
+   */
+  double compare(const DeviceArray& a,
+                 const std::span<const real> ref,
+                 const size_type nc) const {
+    if (nc == 0) {
+      return 0;
+    }
+    const auto v = a.copyToHost();
+    auto scale = real{1};
+    for (const auto x : ref) {
+      scale = std::max(scale, std::abs(x));
+    }
+    auto d = 0.;
+    for (size_type i = 0; i != this->npoints; ++i) {
+      for (size_type c = 0; c != nc; ++c) {
+        d = std::max(d, std::abs(v[c * this->stride + i] - ref[i * nc + c]));
+      }
+    }
+    return d / scale;
+  }
+  const size_type gs, ts, is, Ks, npoints, stride;
+  DeviceArray g0, g1, t0, t1, i0, i1, K;
+  mgis::behaviour::MaterialDataView v;
+};
+
+/*!
+ * \brief functions acting on a material data view whose arrays are located
+ * in the memory of the device only: integration (with a workspace and with
+ * the synchronous and asynchronous policies), end of the time step and
+ * extraction with the operations of CUDA, initialize functions and
+ * post-processings, compared to the computations point by point on the host
+ */
+static void testFunctionsOnDeviceViews(const std::string& gp_library,
+                                       const std::string& library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = size_type{33};
+  constexpr auto ld = n + 3;
+  auto stream = cudaStream_t{};
+  checkCUDA(cudaStreamCreate(&stream), "cudaStreamCreate");
+  auto ops = mgis::field_operations::CUDAFieldOperations{stream};
+  auto p = BatchExecutionPolicy{};
+  p.queue = stream;
+  auto managed = mgis::memory_resources::CUDAManagedMemoryResource{};
+  auto pool = std::pmr::synchronized_pool_resource(&managed);
+  auto pa = AsynchronousBatchExecutionPolicy{};
+  pa.queue = stream;
+  pa.resource = &pool;
+  pa.location = mgis::MemoryLocation::SHARED;
+  auto T = DeviceArray(1);
+  T.copyFrom({293.15});
+  const auto Tv =
+      mgis::makeUniformFieldView(std::span<const real>(T.span()), n);
+  const auto synchronize = [&stream] {
+    checkCUDA(cudaStreamSynchronize(stream), "cudaStreamSynchronize");
+  };
+  // integration of the Norton behaviour
+  {
+    const auto gp_b = load(gp_library, "Norton", Hypothesis::TRIDIMENSIONAL);
+    const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+    auto m = MaterialDataManager(b, n);
+    m.allocateArrayOfTangentOperatorBlocks();
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != 6; ++c) {
+        m.s1.gradients[i * 6 + c] =
+            1e-3 * static_cast<real>(c + 1) * (1 + 0.05 * static_cast<real>(i));
+      }
+    }
+    auto opts = BehaviourIntegrationOptions{};
+    opts.integration_type =
+        IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+    auto views = std::array<std::unique_ptr<DeviceViewData>, 3>{};
+    for (auto& d : views) {
+      d = std::make_unique<DeviceViewData>(gp_b, n, ld);
+      d->v.batch_execution_policy = p;
+      setExternalStateVariable(d->v.s0, "Temperature", Tv);
+      setExternalStateVariable(d->v.s1, "Temperature", Tv);
+      d->copyFrom(m);
+    }
+    const auto r = integrate(m, opts, 180);
+    auto ws = BehaviourIntegrationWorkSpace(gp_b);
+    const auto r0 = integrate(ws, views[0]->v, opts, 180);
+    const auto r1 = integrate(p, views[1]->v, opts, 180);
+    const auto pending = integrate(pa, views[2]->v, opts, 180);
+    synchronize();
+    const auto r2 = pending.getResult();
+    for (const auto s : {r0.exit_status, r1.exit_status, r2.exit_status}) {
+      check(s == r.exit_status, "views on the device: invalid status");
+    }
+    for (const auto& d : views) {
+      const auto dt = d->compare(d->t1, m.s1.thermodynamic_forces, d->ts);
+      const auto di = d->compare(d->i1, m.s1.internal_state_variables, d->is);
+      const auto dK = d->compare(d->K, m.K, d->Ks);
+      check((dt < 1e-12) && (di < 1e-12) && (dK < 1e-12),
+            "views on the device: invalid outputs");
+    }
+    // extraction of the elastic strain with the operations of CUDA
+    const auto es = size_type{6};
+    auto eref = std::vector<real>(n * es);
+    extractInternalStateVariable(eref, m.s1, "ElasticStrain");
+    auto de = DeviceArray(es * ld);
+    extractInternalStateVariable(
+        mgis::makeComponentByComponentFieldView(de.span(), n, es, ld),
+        views[0]->v.s1, "ElasticStrain", ops);
+    synchronize();
+    check(compareComponentByComponent(de.copyToHost(), eref, n, es, ld) < 1e-12,
+          "views on the device: invalid extraction");
+    // end of the time step on the device
+    auto& d = *views[0];
+    update(d.v, ops);
+    synchronize();
+    check((d.compare(d.t0, m.s1.thermodynamic_forces, d.ts) < 1e-12) &&
+              (d.compare(d.i0, m.s1.internal_state_variables, d.is) < 1e-12) &&
+              (d.compare(d.K, std::vector<real>(n * d.Ks, 0), d.Ks) == 0),
+          "views on the device: invalid update");
+    d.copyFrom(m);
+    revert(d.v, ops);
+    synchronize();
+    check((d.compare(d.t1, m.s0.thermodynamic_forces, d.ts) == 0) &&
+              (d.compare(d.g1, m.s0.gradients, d.gs) == 0),
+          "views on the device: invalid revert");
+  }
+  // initialize functions, with inputs on the device
+  {
+    const auto gp_b =
+        load(gp_library, "InitializeFunctionTest", Hypothesis::TRIDIMENSIONAL);
+    const auto b =
+        load(library, "InitializeFunctionTest", Hypothesis::TRIDIMENSIONAL);
+    auto m = MaterialDataManager(b, n);
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+    auto pressures = std::vector<real>(n);
+    auto pressures2 = std::vector<real>(2 * n, 0);
+    for (size_type i = 0; i != n; ++i) {
+      pressures[i] = pressures2[2 * i] = -1e5 * static_cast<real>(i + 1);
+    }
+    auto dp = DeviceArray(2 * n);
+    dp.copyFrom(pressures2);
+    const auto inputs = mgis::makePointByPointFieldView(
+        std::span<const real>(dp.span()), n, 1, 2);
+    auto d = DeviceViewData(gp_b, n, ld);
+    d.v.batch_execution_policy = p;
+    setExternalStateVariable(d.v.s0, "Temperature", Tv);
+    setExternalStateVariable(d.v.s1, "Temperature", Tv);
+    d.copyFrom(m);
+    const auto r =
+        executeInitializeFunction(m, "StressFromInitialPressure", pressures);
+    const auto rv =
+        executeInitializeFunction(pa, d.v, "StressFromInitialPressure", inputs)
+            .getResult();
+    synchronize();
+    check(r.exit_status == rv.exit_status,
+          "initialize function on the device: invalid status");
+    check(d.compare(d.t1, m.s1.thermodynamic_forces, d.ts) < 1e-12,
+          "initialize function on the device: invalid outputs");
+  }
+  // post-processing, outputs on the device
+  {
+    const auto gp_b =
+        load(gp_library, "PostProcessingTest", Hypothesis::TRIDIMENSIONAL);
+    const auto b =
+        load(library, "PostProcessingTest", Hypothesis::TRIDIMENSIONAL);
+    auto m = MaterialDataManager(b, n);
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != 3; ++c) {
+        m.s1.gradients[i * m.s1.gradients_stride + c] =
+            1e-3 * static_cast<real>((i + 1) * (c + 1));
+      }
+    }
+    auto values = DeviceArray(3);
+    values.copyFrom({150e9, 0.3, 293.15});
+    const auto value = [&values](const size_type k) {
+      return mgis::makeUniformFieldView(
+          std::span<const real>(values.span().subspan(k, 1)), n);
+    };
+    auto d = DeviceViewData(gp_b, n, ld);
+    for (auto* const s : {&d.v.s0, &d.v.s1}) {
+      setMaterialProperty(*s, "YoungModulus", value(0));
+      setMaterialProperty(*s, "PoissonRatio", value(1));
+      setExternalStateVariable(*s, "Temperature", value(2));
+    }
+    d.copyFrom(m);
+    auto outputs = allocatePostProcessingVariables(m, "PrincipalStrain");
+    const auto r = executePostProcessing(outputs, m, "PrincipalStrain");
+    auto dout = DeviceArray(3 * ld);
+    const auto rv = executePostProcessing(
+        mgis::makeComponentByComponentFieldView(dout.span(), n, 3, ld), p, d.v,
+        "PrincipalStrain");
+    check(r.exit_status == rv.exit_status,
+          "post-processing on the device: invalid status");
+    check(compareComponentByComponent(dout.copyToHost(), outputs, n, 3, ld) <
+              1e-12,
+          "post-processing on the device: invalid outputs");
+  }
+  checkCUDA(cudaStreamDestroy(stream), "cudaStreamDestroy");
+}  // end of testFunctionsOnDeviceViews
+
 int main(const int argc, const char* const* const argv) {
   if (argc != 5) {
     std::cerr << "usage: " << argv[0]
@@ -507,6 +770,7 @@ int main(const int argc, const char* const* const argv) {
     testIntegrationCycle(argv[1], argv[2]);
     testAsynchronousComputationsWithPool(argv[1]);
     testViewsOnDevice(argv[1], argv[2], argv[3], argv[4]);
+    testFunctionsOnDeviceViews(argv[1], argv[2]);
   } catch (std::exception& e) {
     std::cerr << e.what() << '\n';
     return EXIT_FAILURE;
-- 
