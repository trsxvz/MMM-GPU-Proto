+/*!
+ * \brief statistics of the evaluation of a material property on a set of
+ * points (copy of the `mfront_gpmp_Statistics` structure of `TFEL`). The
+ * device only updates them when an event occurs at a point.
+ */
+typedef struct mgis_mp_BatchStatistics {
+  //! \brief number of points where the evaluation failed
+  unsigned long long number_of_failures;
+  /*!
+   * \brief index of the first point where the evaluation failed, or the
+   * maximal value of the type if no point failed
+   */
+  unsigned long long first_failure_index;
+  //! \brief number of points where a bound is violated with the warning
+  //! policy
+  unsigned long long number_of_unreliable_results;
+  //! \brief identifier of the first check which failed, or the maximal
+  //! value of the type
+  unsigned long long first_violation;
+} mgis_mp_BatchStatistics;
+
+/*!
+ * \brief summary of the evaluation of a material property on a set of
+ * points (copy of the `mfront_gpmp_OutputStatus` structure of `TFEL`). The
+ * `status` and `bounds_status` members have the meaning of the members of
+ * `mgis_mp_OutputStatus`, the status summarizing all the points. The
+ * following statuses are specific to this interface:
+ *
+ * - `-2`: an exception was thrown on the host, for instance by a data
+ *   transfer;
+ * - `-5`: invalid arguments (number of points, number of arguments,
+ *   negative stride, no queue given to the `sycl` backend, asynchronous
+ *   evaluation with an out-of-order `sycl` queue);
+ * - `-6`: runtime error of the backend (allocation, launch of a kernel,
+ *   stack size of the threads of the device), or invalid parameters;
+ * - `-7`: uniform output (null stride) with several points or with non
+ *   uniform arguments.
+ */
+typedef struct mgis_mp_BatchOutputStatus {
+  //! \brief status
+  int status;
+  //! \brief rank of the variable out of its bounds (see
+  //! `mgis_mp_OutputStatus`)
+  int bounds_status;
+  //! \brief number of points where the evaluation failed
+  mgis_size_type number_of_failures;
+  /*!
+   * \brief index of the first point where the evaluation failed, or the
+   * maximal value of the type if no point failed
+   */
+  mgis_size_type first_failure_index;
+  //! \brief number of points where a bound is violated with the warning
+  //! policy
+  mgis_size_type number_of_unreliable_results;
+  //! \brief error message
+  char msg[512];
+} mgis_mp_BatchOutputStatus;
