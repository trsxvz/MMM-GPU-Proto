From 04344f2fa199efc96e84819675dfa538f72b56db Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 00:42:39 +0200
Subject: [PATCH] FieldOperations: copy of a view in itself, tests on the host

- a copy between two views describing the same values does nothing
  (std::copy and the copies of the GPU runtimes forbid overlapping
  ranges).
- tests of HostFieldOperations (all arrangements, fill of a component,
  empty views, refused arguments) and of update, revert and updateValues
  of material data views, compared bit by bit to the material data
  managers, with an empty group of variables.
---
 include/MGIS/FieldOperations.hxx |   4 +-
 src/FieldOperations.cxx          |   6 ++
 tests/MaterialDataViewTest.cxx   | 138 +++++++++++++++++++++++++++++++
 3 files changed, 147 insertions(+), 1 deletion(-)

diff --git a/include/MGIS/FieldOperations.hxx b/include/MGIS/FieldOperations.hxx
index 7a9b5b6..5fca2c4 100644
--- a/include/MGIS/FieldOperations.hxx
+++ b/include/MGIS/FieldOperations.hxx
@@ -49,7 +49,9 @@ namespace mgis {
      * \note both views must have the same numbers of points and of
      * components, and must be located in the memory handled by the
      * operations. The values of the destination must be distinct (see
-     * `FieldView::hasDistinctValues`).
+     * `FieldView::hasDistinctValues`). The source and the destination must
+     * not overlap, unless they describe the same values: nothing is then
+     * copied.
      */
     void copy(const FieldView<real>&, const FieldView<const real>&);
     /*!
diff --git a/src/FieldOperations.cxx b/src/FieldOperations.cxx
index 7cb5c8f..d125eaf 100644
--- a/src/FieldOperations.cxx
+++ b/src/FieldOperations.cxx
@@ -30,6 +30,12 @@ namespace mgis {
     if (!d.hasDistinctValues()) {
       raise("FieldOperations::copy: the values of the destination overlap");
     }
+    if ((d.data() == s.data()) &&
+        (d.getPointStride() == s.getPointStride()) &&
+        (d.getComponentStride() == s.getComponentStride())) {
+      // the views describe the same values
+      return;
+    }
     this->do_copy(d, s);
   }  // end of copy
 
diff --git a/tests/MaterialDataViewTest.cxx b/tests/MaterialDataViewTest.cxx
index 632f15a..9c9a9f5 100644
--- a/tests/MaterialDataViewTest.cxx
+++ b/tests/MaterialDataViewTest.cxx
@@ -30,6 +30,7 @@
 #include <string_view>
 #include "MGIS/Context.hxx"
