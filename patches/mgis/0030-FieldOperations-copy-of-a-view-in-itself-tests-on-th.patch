 #include "MGIS/Behaviour/Behaviour.hxx"
 #include "MGIS/Behaviour/MaterialDataManager.hxx"
 #include "MGIS/Behaviour/MaterialDataView.hxx"
@@ -755,6 +756,141 @@ static void testErrors(const std::string& library,
         "errors: invalid status for an empty set");
 }  // end of testErrors
 
+//! \brief copies and fills of views in the memory of the host
+static void testHostFieldOperations() {
+  constexpr auto n = size_type{5};
+  constexpr auto nc = size_type{3};
+  auto values = std::vector<real>(n * nc);
+  for (size_type k = 0; k != values.size(); ++k) {
+    values[k] = std::sin(static_cast<real>(k + 1));
+  }
+  auto ops = mgis::HostFieldOperations{};
+  for (const auto as : arrangements) {
+    for (const auto ad : arrangements) {
+      const auto msg =
+          "HostFieldOperations, from " + getName(as) + " to " + getName(ad);
+      auto s = Array(n, nc, as);
+      auto d = Array(n, nc, ad);
+      s.copyFrom(values);
+      ops.copy(d.view, s.view);
+      check(d.equals(values) && d.hasUnusedValuesUnchanged(),
+            msg + ": invalid copy");
+      // copy of a view in itself
+      ops.copy(d.view, d.view);
+      check(d.equals(values), msg + ": invalid copy of a view in itself");
+    }
+    auto a = Array(n, nc, as);
+    a.copyFrom(values);
+    ops.fill(mgis::getComponents(a.view, 1, 1), 2.5);
+    auto expected = values;
+    for (size_type i = 0; i != n; ++i) {
+      expected[i * nc + 1] = 2.5;
+    }
+    check(a.equals(expected) && a.hasUnusedValuesUnchanged(),
+          "HostFieldOperations, " + getName(as) + ": invalid fill");
+  }
+  // empty views
+  auto a = Array(n, nc, Arrangement::POINT_BY_POINT);
+  auto e = Array(n, 0, Arrangement::COMPONENT_BY_COMPONENT);
+  ops.copy(e.view, e.view);
+  ops.fill(e.view, 1);
+  ops.copy(FieldView<real>{}, FieldView<const real>{});
+  // invalid arguments
+  check(throws([&] { ops.copy(a.view, mgis::getComponents(a.view, 0, 2)); },
+               "different extents"),
+        "HostFieldOperations: views of different extents must be refused");
+  const auto u = mgis::makeUniformFieldView(std::span(a.values.data(), nc), n);
+  check(throws([&] { ops.copy(u, a.view); }, "overlap"),
+        "HostFieldOperations: an uniform destination must be refused");
+  check(throws([&] { ops.fill(u, 0); }, "overlap"),
+        "HostFieldOperations: the fill of an uniform view must be refused");
+}  // end of testHostFieldOperations
+
+/*!
+ * \brief end of a time step on a view: `update`, `revert` and
+ * `updateValues` with the operations of the host give the values of the
+ * material data manager, bit for bit, in all the arrangements, the unused
+ * values being unchanged. The `Elasticity` behaviour has no internal state
+ * variable (empty group of variables).
+ */
+static void testUpdateAndRevert(const std::string& library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = size_type{7};
+  for (const auto* const name : {"Norton", "Elasticity"}) {
+    const auto b = load(library, name, Hypothesis::TRIDIMENSIONAL);
+    // material data manager with distinct values in all the arrays
+    const auto make_manager = [&b] {
+      auto m = std::make_unique<MaterialDataManager>(b, size_type{n});
+      m->allocateArrayOfTangentOperatorBlocks();
+      auto k = 0;
+      for (auto v : std::array<std::span<real>, 7>{
+               m->s0.gradients, m->s1.gradients, m->s0.thermodynamic_forces,
+               m->s1.thermodynamic_forces, m->s0.internal_state_variables,
+               m->s1.internal_state_variables, m->K}) {
+        for (auto& x : v) {
+          x = std::sin(static_cast<real>(++k));
+        }
+      }
+      return m;
+    };
+    auto ops = mgis::HostFieldOperations{};
+    for (const auto a : arrangements) {
+      for (const auto revert_states : {false, true}) {
+        const auto msg = std::string{name} + ", " + library + ", " +
+                         getName(a) + (revert_states ? ", revert" : ", update");
+        auto m = make_manager();
+        auto d = ViewData(b, n, a);
+        d.copyFrom(*m);
+        if (revert_states) {
+          revert(*m);
+          revert(d.v, ops);
+        } else {
+          update(*m);
+          update(d.v, ops);
+        }
+        check(d.g0.equals(m->s0.gradients) && d.g1.equals(m->s1.gradients) &&
+                  d.t0.equals(m->s0.thermodynamic_forces) &&
+                  d.t1.equals(m->s1.thermodynamic_forces) &&
+                  d.isvs0.equals(m->s0.internal_state_variables) &&
+                  d.isvs1.equals(m->s1.internal_state_variables),
+              msg + ": invalid states");
+        check(d.K.equals(m->K) &&
+                  std::all_of(m->K.begin(), m->K.end(),
+                              [](const real x) { return same(x, 0); }),
+              msg + ": the tangent operator blocks are not set to zero");
+        for (const auto* const x :
+             {&d.g0, &d.g1, &d.t0, &d.t1, &d.isvs0, &d.isvs1, &d.K}) {
+          check(x->hasUnusedValuesUnchanged(),
+                msg + ": unused values modified");
+        }
+        // updateValues: the values of the state at the end of the time step
+        // are copied in the state at the beginning of the time step, the
+        // tangent operator blocks being unchanged
+        const auto m2 = make_manager();
+        d.copyFrom(*m2);
+        updateValues(d.v.s0, d.v.s1, ops);
+        check(d.g0.equals(m2->s1.gradients) &&
+                  d.t0.equals(m2->s1.thermodynamic_forces) &&
+                  d.isvs0.equals(m2->s1.internal_state_variables) &&
+                  d.K.equals(m2->K),
+              msg + ": invalid updateValues");
+      }
+    }
+    // errors
+    auto d = ViewData(b, n, Arrangement::POINT_BY_POINT);
+    d.v.s1.gradients = FieldView<real>{};
+    check(throws([&] { update(d.v, ops); }, "given for one state only"),
+          std::string{name} +
+              ": a group of variables given for one state only must be "
+              "refused");
+    auto d2 = ViewData(b, n + 1, Arrangement::POINT_BY_POINT);
+    check(throws([&] { updateValues(d.v.s0, d2.v.s1, ops); },
+                 "the same number of points"),
+          std::string{name} +
+              ": states with different numbers of points must be refused");
+  }
+}  // end of testUpdateAndRevert
+
 int main(const int argc, const char* const* const argv) {
   if (argc != 3) {
     std::cerr << "usage: " << argv[0]
@@ -763,7 +899,9 @@ int main(const int argc, const char* const* const argv) {
   }
   try {
     testFieldView();
+    testHostFieldOperations();
     for (const auto* const library : {argv[2], argv[1]}) {
+      testUpdateAndRevert(library);
       testNorton(library);
       testElasticity(library);
       testTensorialVariables(library);
