+/*!
+ * \brief failures at some points of a batch, the external state variable
+ * being out of its physical bounds: the index of the first failure, merged
+ * by atomic operations on the device, is the one of the integration point
+ * by point, for a synchronous and an asynchronous integration
+ */
+static void testPartialFailures(const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{1000};
+  const auto b = load(gpu_library, "BoundsCheckTest",
+                      Hypothesis::TRIDIMENSIONAL);
+  auto data = ManagedData(b, n);
+  auto m = MaterialDataManager(b, n, data.initializer());
+  auto young = ManagedArray(1);
+  auto nu = ManagedArray(1);
+  auto temperature = ManagedArray(1);
+  auto ev = ManagedArray(n);
+  young.span()[0] = 150e9;
+  nu.span()[0] = 0.3;
+  temperature.span()[0] = 293.15;
+  std::fill(ev.span().begin(), ev.span().end(), 300.);
+  for (const auto i : {517, 731, 999}) {
+    ev.span()[i] = 600;
+  }
+  for (auto* const st : {&m.s0, &m.s1}) {
+    constexpr auto e = MaterialStateManager::EXTERNAL_STORAGE;
+    setMaterialProperty(*st, "YoungModulus", young.span(), e);
+    setMaterialProperty(*st, "PoissonRatio", nu.span(), e);
+    setExternalStateVariable(*st, "Temperature", temperature.span(), e);
+    setExternalStateVariable(*st, "ExternalStateVariable", ev.span(), e);
+  }
+  for (mgis::size_type i = 0; i != n; ++i) {
+    m.s1.gradients[i * m.s1.gradients_stride] = 1e-3;
+  }
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  const auto r = integrate(m, opts, 1);
+  check((r.exit_status == -1) && (r.n == 517) &&
+            (r.error_message.find("3 integration points") !=
+             std::string::npos),
+        "BoundsCheckTest: invalid index of the first failure");
+  const auto r2 = integrate(m, opts, 1, 600, n);
+  check((r2.exit_status == -1) && (r2.n == 731) &&
+            (r2.error_message.find("2 integration points") !=
+             std::string::npos),
+        "BoundsCheckTest, range: invalid index of the first failure");
+  const auto stream = Stream{};
+  auto resource = mgis::memory_resources::CUDAManagedMemoryResource{};
+  auto p = AsynchronousBatchExecutionPolicy{};
+  p.queue = stream.stream;
+  p.resource = &resource;
+  p.location = MemoryLocation::SHARED;
+  const auto pending = integrate(p, m, opts, 1);
+  if (cudaStreamSynchronize(stream.stream) != cudaSuccess) {
+    throw std::runtime_error("synchronization of the stream failed");
+  }
+  const auto r3 = pending.getResult();
+  check((r3.exit_status == -1) && (r3.n == 517) &&
+            (r3.error_message == r.error_message),
+        "BoundsCheckTest, asynchronous: invalid index of the first failure");
+  // failure at all points
+  const auto bf = load(gpu_library, "NortonFailure",
+                       Hypothesis::TRIDIMENSIONAL);
+  auto fdata = ManagedData(bf, n);
+  auto fm = MaterialDataManager(bf, n, fdata.initializer());
+  for (auto* const st : {&fm.s0, &fm.s1}) {
+    setExternalStateVariable(*st, "Temperature", temperature.span(),
+                             MaterialStateManager::EXTERNAL_STORAGE);
+  }
+  const auto rf = integrate(fm, opts, 1, 10, n);
+  check((rf.exit_status == -1) && (rf.n == 10) &&
+            (rf.error_message.find("990 integration points") !=
+             std::string::npos),
+        "NortonFailure: invalid index of the first failure");
+}  // end of testPartialFailures
