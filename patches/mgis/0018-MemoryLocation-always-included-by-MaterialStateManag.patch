From ec6ea38510fbcdbdfa235cf870ed81f8e8e16dbe Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 8 Oct 2026 15:43:17 +0200
Subject: [PATCH] MemoryLocation always included by MaterialStateManager.hxx,
 generic-parallel tests only with a TFEL providing the interface

MaterialStateManager.hxx only included MGIS/MemoryLocation.hxx when the MGIS/Function library was enabled, although the type is always used. The tests of the generic-parallel interface are only built if TFEL provides the interface (MFront/GenericParallelBehaviour/BatchData.h).
---
 .../MGIS/Behaviour/MaterialStateManager.hxx   |   2 +-
 tests/CMakeLists.txt                          | 179 +++++++++---------
 2 files changed, 92 insertions(+), 89 deletions(-)

diff --git a/include/MGIS/Behaviour/MaterialStateManager.hxx b/include/MGIS/Behaviour/MaterialStateManager.hxx
index a40d205..02f2624 100644
--- a/include/MGIS/Behaviour/MaterialStateManager.hxx
+++ b/include/MGIS/Behaviour/MaterialStateManager.hxx
@@ -31,9 +31,9 @@
 #include "MGIS/Context.hxx"
 #include "MGIS/StorageMode.hxx"
 
+#include "MGIS/MemoryLocation.hxx"
 #ifdef MGIS_FUNCTION_SUPPORT
 #include "MGIS/Function/Function.hxx"
-#include "MGIS/MemoryLocation.hxx"
 #endif /* MGIS_FUNCTION_SUPPORT */
 
 namespace mgis::behaviour {
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 9a82098..d7777f5 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -137,104 +137,107 @@ if(MGIS_HAVE_MFRONT_SUPPORT)
 
   mfront_behaviours_check_library(ModelTest ode_rk54)
 
-  # behaviours generated by the generic-parallel interface, executed on the
-  # host by the C++ parallel algorithms
-  mfront_generic_parallel_behaviours_check_library(
-    GenericParallelBehaviourTest stlpar
-    Elasticity
-    OrthotropicFiniteStrainElasticity
-    Norton
-    NortonFailure
-    Plasticity
-    OrthotropicElasticity
-    InitializeFunctionTest
-    PostProcessingTest
-    BoundsCheckTest
-    TensorialExternalStateVariableTest
-    ComputeSpeedOfSound
-    ode_rk54)
-  add_executable(GenericParallelLoadTest EXCLUDE_FROM_ALL
-    GenericParallelLoadTest.cxx)
-  target_link_libraries(GenericParallelLoadTest PRIVATE MFrontGenericInterface)
-  # the layout of the data structures is checked against the ones of TFEL
-  target_include_directories(GenericParallelLoadTest
-    PRIVATE "${TFEL_INCLUDE_PATH}")
-  add_test(NAME GenericParallelLoadTest
-    COMMAND GenericParallelLoadTest
-    "$<TARGET_FILE:GenericParallelBehaviourTest>"
-    "$<TARGET_FILE:BehaviourTest>")
-  add_dependencies(build-tests GenericParallelLoadTest)
-  set_property(TEST GenericParallelLoadTest
-    PROPERTY DEPENDS GenericParallelBehaviourTest BehaviourTest)
-  set_test_environment(GenericParallelLoadTest)
-  add_executable(GenericParallelIntegrateTest EXCLUDE_FROM_ALL
-    GenericParallelIntegrateTest.cxx)
-  target_link_libraries(GenericParallelIntegrateTest
-    PRIVATE MFrontGenericInterface)
-  add_test(NAME GenericParallelIntegrateTest
-    COMMAND GenericParallelIntegrateTest
-    "$<TARGET_FILE:GenericParallelBehaviourTest>"
-    "$<TARGET_FILE:BehaviourTest>"
-    "$<TARGET_FILE:ModelTest>")
-  add_dependencies(build-tests GenericParallelIntegrateTest)
-  set_property(TEST GenericParallelIntegrateTest
-    PROPERTY DEPENDS GenericParallelBehaviourTest BehaviourTest ModelTest)
-  set_test_environment(GenericParallelIntegrateTest)
-
-  # material properties generated by the generic-parallel interface,
-  # evaluated on the host by the C++ parallel algorithms
-  mfront_generic_parallel_material_properties_check_library(
-    GenericParallelMaterialPropertyTest stlpar
-    Inconel600_YoungModulus
-    MaterialPropertyBoundCheck)
-  add_executable(GenericParallelEvaluateTest EXCLUDE_FROM_ALL
-    GenericParallelEvaluateTest.cxx)
-  target_link_libraries(GenericParallelEvaluateTest
-    PRIVATE MFrontGenericInterface)
-  add_test(NAME GenericParallelEvaluateTest
-    COMMAND GenericParallelEvaluateTest
-    "$<TARGET_FILE:GenericParallelMaterialPropertyTest>"
-    "$<TARGET_FILE:MaterialPropertyTest>")
-  add_dependencies(build-tests GenericParallelEvaluateTest)
-  set_property(TEST GenericParallelEvaluateTest
-    PROPERTY DEPENDS GenericParallelMaterialPropertyTest MaterialPropertyTest)
-  set_test_environment(GenericParallelEvaluateTest)
-
-  # behaviours generated by the generic-parallel interface with the cuda
-  # backend. The test allocates the data in managed memory with the runtime
-  # API of CUDA, from code compiled by the C++ compiler.
-  if(enable-generic-parallel-cuda-tests)
-    enable_language(CUDA)
-    find_package(CUDAToolkit REQUIRED)
+  # tests of the generic-parallel interface, if TFEL provides it
+  if(EXISTS "${TFEL_INCLUDE_PATH}/MFront/GenericParallelBehaviour/BatchData.h")
+    # behaviours generated by the generic-parallel interface, executed on the
+    # host by the C++ parallel algorithms
     mfront_generic_parallel_behaviours_check_library(
-      GenericParallelBehaviourTestCUDA cuda
+      GenericParallelBehaviourTest stlpar
       Elasticity
+      OrthotropicFiniteStrainElasticity
       Norton
+      NortonFailure
+      Plasticity
       OrthotropicElasticity
       InitializeFunctionTest
       PostProcessingTest
+      BoundsCheckTest
+      TensorialExternalStateVariableTest
+      ComputeSpeedOfSound
       ode_rk54)
+    add_executable(GenericParallelLoadTest EXCLUDE_FROM_ALL
+      GenericParallelLoadTest.cxx)
+    target_link_libraries(GenericParallelLoadTest PRIVATE MFrontGenericInterface)
+    # the layout of the data structures is checked against the ones of TFEL
+    target_include_directories(GenericParallelLoadTest
+      PRIVATE "${TFEL_INCLUDE_PATH}")
+    add_test(NAME GenericParallelLoadTest
+      COMMAND GenericParallelLoadTest
+      "$<TARGET_FILE:GenericParallelBehaviourTest>"
+      "$<TARGET_FILE:BehaviourTest>")
+    add_dependencies(build-tests GenericParallelLoadTest)
+    set_property(TEST GenericParallelLoadTest
+      PROPERTY DEPENDS GenericParallelBehaviourTest BehaviourTest)
+    set_test_environment(GenericParallelLoadTest)
+    add_executable(GenericParallelIntegrateTest EXCLUDE_FROM_ALL
+      GenericParallelIntegrateTest.cxx)
+    target_link_libraries(GenericParallelIntegrateTest
+      PRIVATE MFrontGenericInterface)
+    add_test(NAME GenericParallelIntegrateTest
+      COMMAND GenericParallelIntegrateTest
+      "$<TARGET_FILE:GenericParallelBehaviourTest>"
+      "$<TARGET_FILE:BehaviourTest>"
+      "$<TARGET_FILE:ModelTest>")
+    add_dependencies(build-tests GenericParallelIntegrateTest)
+    set_property(TEST GenericParallelIntegrateTest
+      PROPERTY DEPENDS GenericParallelBehaviourTest BehaviourTest ModelTest)
+    set_test_environment(GenericParallelIntegrateTest)
+
+    # material properties generated by the generic-parallel interface,
+    # evaluated on the host by the C++ parallel algorithms
     mfront_generic_parallel_material_properties_check_library(
-      GenericParallelMaterialPropertyTestCUDA cuda
+      GenericParallelMaterialPropertyTest stlpar
       Inconel600_YoungModulus
       MaterialPropertyBoundCheck)
-    add_executable(GenericParallelCUDATest EXCLUDE_FROM_ALL
-      GenericParallelCUDATest.cxx)
-    target_link_libraries(GenericParallelCUDATest
-      PRIVATE MFrontGenericInterface CUDA::cudart)
-    add_test(NAME GenericParallelCUDATest
-      COMMAND GenericParallelCUDATest
-      "$<TARGET_FILE:GenericParallelBehaviourTestCUDA>"
-      "$<TARGET_FILE:BehaviourTest>"
-      "$<TARGET_FILE:GenericParallelMaterialPropertyTestCUDA>"
-      "$<TARGET_FILE:MaterialPropertyTest>"
-      "$<TARGET_FILE:ModelTest>")
-    add_dependencies(build-tests GenericParallelCUDATest)
-    set_property(TEST GenericParallelCUDATest
-      PROPERTY DEPENDS GenericParallelBehaviourTestCUDA BehaviourTest
-      GenericParallelMaterialPropertyTestCUDA MaterialPropertyTest ModelTest)
-    set_test_environment(GenericParallelCUDATest)
-  endif(enable-generic-parallel-cuda-tests)
+    add_executable(GenericParallelEvaluateTest EXCLUDE_FROM_ALL
+      GenericParallelEvaluateTest.cxx)
+    target_link_libraries(GenericParallelEvaluateTest
+      PRIVATE MFrontGenericInterface)
+    add_test(NAME GenericParallelEvaluateTest
+      COMMAND GenericParallelEvaluateTest
+      "$<TARGET_FILE:GenericParallelMaterialPropertyTest>"
+      "$<TARGET_FILE:MaterialPropertyTest>")
+    add_dependencies(build-tests GenericParallelEvaluateTest)
+    set_property(TEST GenericParallelEvaluateTest
+      PROPERTY DEPENDS GenericParallelMaterialPropertyTest MaterialPropertyTest)
+    set_test_environment(GenericParallelEvaluateTest)
+
+    # behaviours generated by the generic-parallel interface with the cuda
+    # backend. The test allocates the data in managed memory with the runtime
+    # API of CUDA, from code compiled by the C++ compiler.
+    if(enable-generic-parallel-cuda-tests)
+      enable_language(CUDA)
+      find_package(CUDAToolkit REQUIRED)
+      mfront_generic_parallel_behaviours_check_library(
+        GenericParallelBehaviourTestCUDA cuda
+        Elasticity
+        Norton
+        OrthotropicElasticity
+        InitializeFunctionTest
+        PostProcessingTest
+        ode_rk54)
+      mfront_generic_parallel_material_properties_check_library(
+        GenericParallelMaterialPropertyTestCUDA cuda
+        Inconel600_YoungModulus
+        MaterialPropertyBoundCheck)
+      add_executable(GenericParallelCUDATest EXCLUDE_FROM_ALL
+        GenericParallelCUDATest.cxx)
+      target_link_libraries(GenericParallelCUDATest
+        PRIVATE MFrontGenericInterface CUDA::cudart)
+      add_test(NAME GenericParallelCUDATest
+        COMMAND GenericParallelCUDATest
+        "$<TARGET_FILE:GenericParallelBehaviourTestCUDA>"
+        "$<TARGET_FILE:BehaviourTest>"
+        "$<TARGET_FILE:GenericParallelMaterialPropertyTestCUDA>"
+        "$<TARGET_FILE:MaterialPropertyTest>"
+        "$<TARGET_FILE:ModelTest>")
+      add_dependencies(build-tests GenericParallelCUDATest)
+      set_property(TEST GenericParallelCUDATest
+        PROPERTY DEPENDS GenericParallelBehaviourTestCUDA BehaviourTest
+        GenericParallelMaterialPropertyTestCUDA MaterialPropertyTest ModelTest)
+      set_test_environment(GenericParallelCUDATest)
+    endif(enable-generic-parallel-cuda-tests)
+  endif(EXISTS "${TFEL_INCLUDE_PATH}/MFront/GenericParallelBehaviour/BatchData.h")
 
   # Tests that depend on behaviour libraries
   add_library_test_with_tfel_version(LoadMaterialPropertyTest LoadMaterialPropertyTest.cxx MaterialPropertyTest)
-- 
2.43.0

