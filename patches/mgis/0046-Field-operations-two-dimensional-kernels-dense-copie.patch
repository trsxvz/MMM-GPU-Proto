 .../FieldOperations/HIPFieldOperations.hxx    | 110 +++++++++++------
 .../FieldOperations/KokkosFieldOperations.hxx |  64 ++++++----
 .../FieldOperations/OpenMPFieldOperations.hxx |  44 ++++---
 .../FieldOperations/SYCLFieldOperations.hxx   |  38 +++---
 5 files changed, 242 insertions(+), 130 deletions(-)

