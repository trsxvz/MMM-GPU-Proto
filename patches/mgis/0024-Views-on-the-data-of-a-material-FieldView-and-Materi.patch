+//! \brief Elasticity behaviour, material property given at each point
+static void testElasticity(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "Elasticity", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{9};
+  auto young = std::vector<real>(n);
+  for (size_type i = 0; i != n; ++i) {
+    young[i] = 150e9 + 1e9 * static_cast<real>(i);
+  }
+  const auto values = std::array<real, 2>{0.3, 293.15};
+  auto setup = [&young, &values](MaterialDataManager& m, MaterialDataView& v) {
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", young,
+                          MaterialStateManager::EXTERNAL_STORAGE);
+      setMaterialProperty(*s, "PoissonRatio", values[0]);
+      setExternalStateVariable(*s, "Temperature", values[1]);
+    }
+    for (auto* const s : {&v.s0, &v.s1}) {
+      setMaterialProperty(
+          *s, "YoungModulus",
+          mgis::makeFieldView(std::span<const real>(young),
+                              FieldLayout::POINT_BY_POINT, v.n, 1));
+      setMaterialProperty(
+          *s, "PoissonRatio",
+          mgis::makeUniformFieldView(
+              std::span<const real>(values).subspan(0, 1), v.n));
+      setExternalStateVariable(
+          *s, "Temperature",
+          mgis::makeUniformFieldView(
+              std::span<const real>(values).subspan(1, 1), v.n));
+    }
+  };
+  auto load = [](MaterialDataManager& m, const int step) {
+    for (size_type i = 0; i != m.n; ++i) {
+      m.s1.gradients[i * m.s1.gradients_stride] =
+          1e-3 * static_cast<real>(step + 1);
+      m.s1.gradients[i * m.s1.gradients_stride + 4] =
+          2e-4 * static_cast<real>(i);
+    }
+  };
+  compareIntegrations("Elasticity, " + library, b, n, setup, load, 2);
+}  // end of testElasticity
