+//! \brief errors reported by the functions on material data views
+static void testErrors(const std::string& library,
+                       const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  const auto gp_b = load(gp_library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  const auto e = load(library, "Elasticity", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{4};
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  const auto temperature = std::array<real, 1>{293.15};
+  const auto T =
+      mgis::makeUniformFieldView(std::span<const real>(temperature), n);
+  auto d = ViewData(b, n, Arrangement::COMPONENT_BY_COMPONENT);
+  d.copyFrom(MaterialDataManager(b, n));
+  auto ws = BehaviourIntegrationWorkSpace(b);
+  // external state variable not given
+  check(throws([&] { static_cast<void>(integrate(ws, d.v, opts, 1)); },
+               "no value given for the external state variable 'Temperature'"),
+        "errors: missing external state variable not detected");
+  setExternalStateVariable(d.v.s0, "Temperature", T);
+  setExternalStateVariable(d.v.s1, "Temperature", T);
+  check(integrate(ws, d.v, opts, 1).exit_status >= 0,
+        "errors: unexpected failure");
+  // invalid variable name, invalid number of points
+  check(throws([&] { setExternalStateVariable(d.v.s1, "Temp", T); },
+               "no external state variable named 'Temp'"),
+        "errors: invalid name not detected");
+  check(throws(
+            [&] {
+              setExternalStateVariable(
+                  d.v.s1, "Temperature",
+                  mgis::makeUniformFieldView(std::span<const real>(temperature),
+                                             n + 1));
+            },
+            "invalid view for the external state variable"),
+        "errors: invalid number of points not detected");
+  // uniform output
+  auto copy = d.v;
+  copy.s1.thermodynamic_forces =
+      FieldView<real>(std::span<real>(d.t1.values).subspan(0, 6), n, 6, 0, 1);
+  check(throws([&] { static_cast<void>(integrate(ws, copy, opts, 1)); },
+               "overlap"),
+        "errors: uniform output not detected");
+  // missing internal state variables
+  copy = d.v;
+  copy.s1.internal_state_variables = FieldView<real>{};
+  check(throws([&] { static_cast<void>(integrate(ws, copy, opts, 1)); },
+               "no value given for the internal state variables"),
+        "errors: missing internal state variables not detected");
+  // inconsistent states
+  copy = d.v;
+  copy.s1.n = n - 1;
+  check(throws([&] { static_cast<void>(integrate(ws, copy, opts, 1)); },
+               "number of points of a state"),
+        "errors: inconsistent number of points not detected");
+  // workspace built for another behaviour
+  auto ews = BehaviourIntegrationWorkSpace(e);
+  check(throws([&] { static_cast<void>(integrate(ews, d.v, opts, 1)); },
+               "workspace has not been built"),
+        "errors: invalid workspace not detected");
+  // tangent operator requested, but not given
+  auto topts = opts;
+  topts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  copy = d.v;
+  copy.K = FieldView<real>{};
+  check(throws([&] { static_cast<void>(integrate(ws, copy, topts, 1)); },
+               "no value given for the tangent operator blocks"),
+        "errors: missing tangent operator blocks not detected");
+  // a behaviour generated by the generic interface with an execution policy
+  check(
+      throws(
+          [&] {
+            static_cast<void>(integrate(BatchExecutionPolicy{}, d.v, opts, 1));
+          },
+          "has not been generated by the generic-parallel interface"),
+      "errors: generic behaviour with an execution policy not detected");
+  // arrays in the memory of a device, computations on the host
+  copy = d.v;
+  copy.memory_location = mgis::MemoryLocation::DEVICE;
+  check(throws([&] { static_cast<void>(integrate(ws, copy, opts, 1)); },
+               "not accessible by the computations"),
+        "errors: inaccessible memory not detected");
+  // invalid range
+  check(throws([&] { static_cast<void>(integrate(ws, d.v, opts, 1, 2, 5)); },
+               "invalid upper bound"),
+        "errors: invalid range not detected");
+  // empty set of points
+  auto d0 = ViewData(gp_b, 0, Arrangement::COMPONENT_BY_COMPONENT);
+  auto gp_ws = BehaviourIntegrationWorkSpace(gp_b);
+  check(integrate(gp_ws, d0.v, opts, 1).exit_status == 1,
+        "errors: invalid status for an empty set");
+}  // end of testErrors
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-library generic-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    testFieldView();
+    for (const auto* const library : {argv[2], argv[1]}) {
+      testNorton(library);
+      testElasticity(library);
+      testTensorialVariables(library);
+      testInitializeFunctions(library);
+      testPostProcessings(library);
+      testMakeView(library);
+    }
+    testErrors(argv[2], argv[1]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
