@@ -0,0 +1,250 @@
+/*!
+ * \file   include/MGIS/Behaviour/MaterialDataView.hxx
+ * \brief  This file declares the `MaterialStateView` and `MaterialDataView`
+ * classes, which describe the data of a material stored in arrays owned by
+ * the calling code, with arbitrary strides.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_BEHAVIOUR_MATERIALDATAVIEW_HXX
+#define LIB_MGIS_BEHAVIOUR_MATERIALDATAVIEW_HXX
+
+#include <vector>
+#include <string_view>
+#include <memory_resource>
+#include "MGIS/Config.hxx"
+#include "MGIS/Context.hxx"
+#include "MGIS/FieldView.hxx"
+#include "MGIS/MemoryLocation.hxx"
+#include "MGIS/BatchExecutionPolicy.hxx"
+
+namespace mgis::behaviour {
+
+  // forward declarations
+  struct Behaviour;
+  struct MaterialDataManager;
+
+  /*!
+   * \brief description of the state of a material (at the beginning or at the
+   * end of a time step) stored in arrays owned by the calling code.
+   *
+   * This class is the counterpart of `MaterialStateManager` for arrays which
+   * are not owned by `MGIS`, with arbitrary strides (see `FieldView`). It
+   * holds no value.
+   *
+   * The material properties and the external state variables are given
+   * variable by variable, in the order of the behaviour (the elements of an
+   * array of variables being distinct variables). Each one can be uniform or
+   * given at each point.
+   *
+   * The vectors of the views of the material properties and of the external
+   * state variables use a memory resource. As for any container using
+   * `std::pmr::polymorphic_allocator`, a copy uses the default memory
+   * resource, a move keeps the memory resource, and two objects using
+   * different memory resources must not be swapped.
+   */
+  struct MGIS_EXPORT MaterialStateView {
+    /*!
+     * \param[in] behaviour: behaviour
+     * \param[in] s: number of points
+     * \param[in] r: memory resource used to allocate the vectors of the views
+     * of the material properties and of the external state variables, or
+     * null for the default memory resource
+     */
+    MaterialStateView(const Behaviour&,
+                      const size_type,
+                      std::pmr::memory_resource* const = nullptr);
+    //! \brief copy constructor
+    MaterialStateView(const MaterialStateView&);
+    //! \brief move constructor
+    MaterialStateView(MaterialStateView&&);
+    //! \brief copy assignement
+    MaterialStateView& operator=(const MaterialStateView&);
+    //! \brief move assignement
+    MaterialStateView& operator=(MaterialStateView&&);
+    //! \brief destructor
+    ~MaterialStateView();
+    //! \brief gradients
+    FieldView<real> gradients;
+    //! \brief thermodynamic forces
+    FieldView<real> thermodynamic_forces;
+    //! \brief internal state variables
+    FieldView<real> internal_state_variables;
+    /*!
+     * \brief stored energies, only used if the behaviour computes the stored
+     * energy
+     */
+    FieldView<real> stored_energies;
+    /*!
+     * \brief dissipated energies, only used if the behaviour computes the
+     * dissipated energy
+     */
+    FieldView<real> dissipated_energies;
+    //! \brief material properties, in the order of the behaviour
+    std::pmr::vector<FieldView<const real>> material_properties;
+    //! \brief mass density, only used to compute the speed of sound
+    FieldView<const real> mass_density;
+    //! \brief external state variables, in the order of the behaviour
+    std::pmr::vector<FieldView<const real>> external_state_variables;
+    //! \brief behaviour, never null
+    const Behaviour* b;
+    //! \brief number of points
+    size_type n;
+  };  // end of MaterialStateView
+
+  /*!
+   * \brief set the view of the given material property
+   * \param[in, out] s: state
+   * \param[in] n: name of the material property
+   * \param[in] v: values, uniform or given at each point
+   */
+  MGIS_EXPORT void setMaterialProperty(MaterialStateView&,
+                                       std::string_view,
+                                       const FieldView<const real>&);
+  /*!
+   * \brief set the view of the given material property
+   * \param[in, out] ctx: execution context
+   * \param[in, out] s: state
+   * \param[in] n: name of the material property
+   * \param[in] v: values, uniform or given at each point
+   */
+  MGIS_EXPORT MGIS_NODISCARD bool setMaterialProperty(
+      Context&,
+      MaterialStateView&,
+      std::string_view,
+      const FieldView<const real>&) noexcept;
+  /*!
+   * \brief set the view of the given external state variable
+   * \param[in, out] s: state
+   * \param[in] n: name of the external state variable
+   * \param[in] v: values, uniform or given at each point
+   */
+  MGIS_EXPORT void setExternalStateVariable(MaterialStateView&,
+                                            std::string_view,
+                                            const FieldView<const real>&);
+  /*!
+   * \brief set the view of the given external state variable
+   * \param[in, out] ctx: execution context
+   * \param[in, out] s: state
+   * \param[in] n: name of the external state variable
+   * \param[in] v: values, uniform or given at each point
+   */
+  MGIS_EXPORT MGIS_NODISCARD bool setExternalStateVariable(
+      Context&,
+      MaterialStateView&,
+      std::string_view,
+      const FieldView<const real>&) noexcept;
+  /*!
+   * \brief set the view of the mass density
+   * \param[in, out] s: state
+   * \param[in] v: values, uniform or given at each point
+   */
+  MGIS_EXPORT void setMassDensity(MaterialStateView&,
+                                  const FieldView<const real>&);
+  /*!
+   * \brief set the view of the mass density
+   * \param[in, out] ctx: execution context
+   * \param[in, out] s: state
+   * \param[in] v: values, uniform or given at each point
+   */
+  MGIS_EXPORT MGIS_NODISCARD bool setMassDensity(
+      Context&, MaterialStateView&, const FieldView<const real>&) noexcept;
+
+  /*!
+   * \brief description of the data of a material stored in arrays owned by
+   * the calling code.
+   *
+   * This class is the counterpart of `MaterialDataManager` for arrays which
+   * are not owned by `MGIS`, with arbitrary strides (see `FieldView`). The
+   * functions processing batches of points accept a material data view (see
+   * `MGIS/Behaviour/Integrate.hxx`). The functions of the material data
+   * managers call them on a view of their arrays (see `make_view`).
+   *
+   * All the arrays must be located in the memory location given by the
+   * `memory_location` member, which is checked against the memory space of
+   * the behaviour. The members are public: the functions using a view check
+   * its consistency (behaviour and number of points of the states, number
+   * of views of the material properties and of the external state
+   * variables, extent of each view).
+   */
+  struct MGIS_EXPORT MaterialDataView {
+    /*!
+     * \param[in] behaviour: behaviour
+     * \param[in] s: number of points
+     * \param[in] l: location of the arrays
+     * \param[in] r: memory resource used to allocate the vectors of the views
+     * of the material properties and of the external state variables, or
+     * null for the default memory resource
+     */
+    MaterialDataView(const Behaviour&,
+                     const size_type,
+                     const MemoryLocation,
+                     std::pmr::memory_resource* const = nullptr);
+    //! \brief copy constructor
+    MaterialDataView(const MaterialDataView&);
+    //! \brief move constructor
+    MaterialDataView(MaterialDataView&&);
+    //! \brief copy assignement
+    MaterialDataView& operator=(const MaterialDataView&);
+    //! \brief move assignement
+    MaterialDataView& operator=(MaterialDataView&&);
+    //! \brief destructor
+    ~MaterialDataView();
+    //! \brief state at the beginning of the time step
+    MaterialStateView s0;
+    //! \brief state at the end of the time step
+    MaterialStateView s1;
+    /*!
+     * \brief tangent operator blocks (output). This view is only used if a
+     * tangent or a prediction operator is requested.
+     */
+    FieldView<real> K;
+    /*!
+     * \brief speed of sound (output). This view is only used if the speed of
+     * sound is requested.
+     */
+    FieldView<real> speed_of_sound;
+    /*!
+     * \brief execution policy used by the functions which do not take one,
+     * for the behaviours generated by the `generic-parallel` interface
+     */
+    BatchExecutionPolicy batch_execution_policy;
+    //! \brief behaviour, never null
+    const Behaviour* b;
+    //! \brief number of points
+    size_type n;
+    //! \brief location of the arrays
+    MemoryLocation memory_location;
+  };  // end of MaterialDataView
+
+  /*!
+   * \return a view on the arrays of a material data manager, with its
+   * execution policy and its memory location.
+   *
+   * The values held by the material data manager on the host (uniform
+   * values, values stored with the `LOCAL_STORAGE` mode) are checked to be
+   * accessible by the computations of the behaviour. The views of the
+   * material properties and of the external state variables which are not
+   * defined in the material data manager are empty: they are reported by the
+   * functions using the view.
+   *
+   * \param[in] m: material data manager
+   * \param[in] r: memory resource used to allocate the vectors of the views
+   * of the material properties and of the external state variables, or null
+   * for the default memory resource
+   * \note the view refers to the arrays of the material data manager: it
+   * must not be used after a change of those arrays (allocation of the
+   * tangent operator blocks, change of a material property, etc.)
+   */
+  MGIS_EXPORT MaterialDataView
+  make_view(MaterialDataManager&, std::pmr::memory_resource* const = nullptr);
+
+}  // end of namespace mgis::behaviour
+
+#endif /* LIB_MGIS_BEHAVIOUR_MATERIALDATAVIEW_HXX */
diff --git a/include/MGIS/FieldView.hxx b/include/MGIS/FieldView.hxx
new file mode 100644
index 0000000..8a0152e
--- /dev/null
+++ b/include/MGIS/FieldView.hxx
@@ -0,0 +1,247 @@
+/*!
+ * \file   include/MGIS/FieldView.hxx
+ * \brief  This file declares the `FieldView` class, a view on the values of
+ * a group of variables at a set of points, with arbitrary strides.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDVIEW_HXX
+#define LIB_MGIS_FIELDVIEW_HXX
+
+#include <span>
+#include <type_traits>
+#include "MGIS/Config.hxx"
+#include "MGIS/Contract.hxx"
+
+namespace mgis {
+
+  /*!
+   * \brief layout of the arrays holding the values of a group of variables
+   * at a set of points
+   */
+  enum struct FieldLayout {
+    /*!
+     * \brief the components of a point are contiguous: the `j`-th component
+     * of the `i`-th point is stored at `values[i * nc + j]`, where `nc` is
+     * the number of components
+     */
+    POINT_BY_POINT,
+    /*!
+     * \brief the values of a component are contiguous: the `j`-th component
+     * of the `i`-th point is stored at `values[j * n + i]`, where `n` is the
+     * number of points. This layout gives coalesced memory accesses on GPUs.
+     * It is the layout of the "strided coalesced" views of `mgis::function`.
+     */
+    COMPONENT_BY_COMPONENT
+  };
+
+  /*!
+   * \brief a view on the values of a group of variables (or of a single
+   * variable) at a set of points.
+   *
+   * The `j`-th component of the `i`-th point is stored at
+   * `data()[i * getPointStride() + j * getComponentStride()]`. This is the
+   * two-dimensional counterpart of `std::span`, with the meaning of a
+   * `std::mdspan` using the `layout_stride` mapping. The view does not own
+   * the values. A null point stride describes uniform values.
+   *
+   * The view is checked at construction: the values must cover all the
+   * points and all the components, and the component stride can't be null
+   * if there are several components. As for the views of `mgis::function`, a
+   * violation of those preconditions, or of the ones of the functions
+   * building views, is a contract violation (see `contract_violation_policy`:
+   * the program is aborted by default). The `checkPreconditions` function
+   * checks them beforehand. A default constructed view is empty: it never
+   * describes uniform values.
+   *
+   * \tparam ValueType: type of the values, `real` or `const real`
+   */
+  template <typename ValueType>
+  struct FieldView {
+    static_assert(std::is_same_v<std::remove_const_t<ValueType>, real>,
+                  "invalid value type");
+    //! \brief type of the values
+    using value_type = ValueType;
+    //! \brief empty view
+    constexpr FieldView() noexcept = default;
+    /*!
+     * \brief check that the preconditions to build the view are met
+     * \param[in] eh: error handler
+     * \param[in] v: values
+     * \param[in] n: number of points
+     * \param[in] nc: number of components
+     * \param[in] ps: stride between two points
+     * \param[in] cs: stride between two components
+     */
+    [[nodiscard]] static constexpr bool checkPreconditions(
+        AbstractErrorHandler&,
+        std::span<ValueType>,
+        const size_type,
+        const size_type,
+        const size_type,
+        const size_type);
+    /*!
+     * \brief constructor
+     * \param[in] v: values
+     * \param[in] n: number of points
+     * \param[in] nc: number of components
+     * \param[in] ps: stride between two points
+     * \param[in] cs: stride between two components
+     */
+    constexpr FieldView(std::span<ValueType>,
+                        const size_type,
+                        const size_type,
+                        const size_type,
+                        const size_type);
+    /*!
+     * \brief constructor
+     * \param[in] pcheck: if true, the preconditions are checked
+     * \param[in] v: values
+     * \param[in] n: number of points
+     * \param[in] nc: number of components
+     * \param[in] ps: stride between two points
+     * \param[in] cs: stride between two components
+     */
+    template <bool doPreconditionsCheck>
+    constexpr FieldView(const PreconditionsCheck<doPreconditionsCheck>&,
+                        std::span<ValueType>,
+                        const size_type,
+                        const size_type,
+                        const size_type,
+                        const size_type);
+    //! \brief conversion of a mutable view to a constant view
+    template <typename OtherValueType>
+      requires(std::is_same_v<const OtherValueType, ValueType>)  //
+    constexpr FieldView(const FieldView<OtherValueType>&) noexcept;
+    //! \brief copy constructor
+    constexpr FieldView(const FieldView&) noexcept = default;
+    //! \brief move constructor
+    constexpr FieldView(FieldView&&) noexcept = default;
+    //! \brief copy assignement
+    constexpr FieldView& operator=(const FieldView&) noexcept = default;
+    //! \brief move assignement
+    constexpr FieldView& operator=(FieldView&&) noexcept = default;
+    //! \return a pointer to the first value
+    [[nodiscard]] constexpr ValueType* data() const noexcept;
+    //! \return the memory region holding the values
+    [[nodiscard]] constexpr std::span<ValueType> getValues() const noexcept;
+    //! \return the number of points
+    [[nodiscard]] constexpr size_type getNumberOfPoints() const noexcept;
+    //! \return the number of components
+    [[nodiscard]] constexpr size_type getNumberOfComponents() const noexcept;
+    //! \return the stride between two points
+    [[nodiscard]] constexpr size_type getPointStride() const noexcept;
+    //! \return the stride between two components
+    [[nodiscard]] constexpr size_type getComponentStride() const noexcept;
+    //! \return true if the view holds no value (no point or no component)
+    [[nodiscard]] constexpr bool empty() const noexcept;
+    //! \return true if the values are uniform (null point stride)
+    [[nodiscard]] constexpr bool isUniform() const noexcept;
+    /*!
+     * \return true if the components of a point are contiguous, i.e. if the
+     * values of a point can be accessed by a pointer to its first component
+     */
+    [[nodiscard]] constexpr bool hasContiguousComponents() const noexcept;
+    /*!
+     * \return true if each value of the view is associated with only one
+     * pair of a point and a component. This is required for outputs. This
+     * function checks a sufficient condition, exactly: the strides of the
+     * dimensions whose extent is greater than one, sorted in increasing
+     * order, are such that the smallest one is not null and the greatest
+     * one is at least the product of the smallest one and of its extent.
+     * Interleaved layouts are thus rejected.
+     */
+    [[nodiscard]] constexpr bool hasDistinctValues() const noexcept;
+    /*!
+     * \return the `j`-th component of the `i`-th point
+     * \param[in] i: index of the point
+     * \param[in] j: index of the component
+     * \note this function can only be called if the values are accessible
+     * by the calling code
+     */
+    [[nodiscard]] constexpr ValueType& operator()(
+        const size_type, const size_type = 0) const noexcept;
+
+   private:
+    //! \brief memory region holding the values
+    std::span<ValueType> values;
+    //! \brief number of points
+    size_type number_of_points = 0;
+    //! \brief number of components
+    size_type number_of_components = 0;
+    //! \brief stride between two points
+    size_type point_stride = 0;
+    //! \brief stride between two components
+    size_type component_stride = 0;
+  };  // end of FieldView
+
+  /*!
+   * \return a view on values stored densely, with the given layout
+   * \param[in] v: values, which must hold `n * nc` values
+   * \param[in] l: layout
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   */
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makeFieldView(std::span<ValueType>,
+                                               const FieldLayout,
+                                               const size_type,
+                                               const size_type);
+  /*!
+   * \return a view on values stored point by point, the components of a
+   * point being contiguous
+   * \param[in] v: values
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] ps: stride between two points, which can't be lower than the
+   * number of components
+   */
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makePointByPointFieldView(std::span<ValueType>,
+                                                           const size_type,
+                                                           const size_type,
+                                                           const size_type);
+  /*!
+   * \return a view on values stored component by component, the values of a
+   * component being contiguous
+   * \param[in] v: values
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] ld: stride between two components (leading dimension), which
+   * can't be lower than the number of points
+   */
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makeComponentByComponentFieldView(
+      std::span<ValueType>, const size_type, const size_type, const size_type);
+  /*!
+   * \return a view on uniform values: the values of each point are the
+   * values given
+   * \param[in] v: values of one point
+   * \param[in] n: number of points
+   */
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makeUniformFieldView(std::span<ValueType>,
+                                                      const size_type);
+  /*!
+   * \return a view on some of the components of a view, for instance a
+   * variable in a group of variables, or a block of a tangent operator
+   * \param[in] v: view
+   * \param[in] o: index of the first component
+   * \param[in] nc: number of components
+   */
+  template <typename ValueType>
+  constexpr FieldView<ValueType> getComponents(const FieldView<ValueType>&,
+                                               const size_type,
+                                               const size_type);
+
+}  // end of namespace mgis
+
+#include "MGIS/FieldView.ixx"
+
+#endif /* LIB_MGIS_FIELDVIEW_HXX */
diff --git a/include/MGIS/FieldView.ixx b/include/MGIS/FieldView.ixx
new file mode 100644
index 0000000..2abe2a6
--- /dev/null
+++ b/include/MGIS/FieldView.ixx
@@ -0,0 +1,263 @@
+/*!
+ * \file   include/MGIS/FieldView.ixx
+ * \brief  This file implements the inline methods of the `FieldView` class
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDVIEW_IXX
+#define LIB_MGIS_FIELDVIEW_IXX
+
+#include <string>
+#include "MGIS/Contract.hxx"
+
+namespace mgis::internals {
+
+  /*!
+   * \brief report a violation of the preconditions of a function building a
+   * view (see `contract_violation_policy`)
+   * \param[in] msg: message
+   */
+  [[noreturn]] inline void reportFieldViewContractViolation(
+      const std::string& msg) {
+    auto h = ContractViolationHandler{};
+    static_cast<void>(h.registerErrorMessage(msg.c_str()));
+  }  // end of reportFieldViewContractViolation
+
+}  // end of namespace mgis::internals
+
+namespace mgis {
+
+  template <typename ValueType>
+  constexpr bool FieldView<ValueType>::checkPreconditions(
+      AbstractErrorHandler& eh,
+      std::span<ValueType> v,
+      const size_type n,
+      const size_type nc,
+      const size_type ps,
+      const size_type cs) {
+    if ((n == 0) || (nc == 0)) {
+      // no value
+      return true;
+    }
+    if ((nc > 1) && (cs == 0)) {
+      return eh.registerErrorMessage(
+          "null component stride with several components");
+    }
+    // the index of the last value, (n - 1) * ps + (nc - 1) * cs, must be
+    // lower than the number of values (computed without overflow)
+    const auto s = v.size();
+    if (s == 0) {
+      return eh.registerErrorMessage("no value given");
+    }
+    auto last = size_type{};
+    if ((n > 1) && (ps != 0)) {
+      if (n - 1 > (s - 1) / ps) {
+        return eh.registerErrorMessage("the values don't cover all the points");
+      }
+      last = (n - 1) * ps;
+    }
+    if (nc > 1) {
+      if ((nc - 1 > (s - 1) / cs) || ((nc - 1) * cs > s - 1 - last)) {
+        return eh.registerErrorMessage(
+            "the values don't cover all the components");
+      }
+    }
+    return true;
+  }  // end of checkPreconditions
+
+  template <typename ValueType>
+  constexpr FieldView<ValueType>::FieldView(std::span<ValueType> v,
+                                            const size_type n,
+                                            const size_type nc,
+                                            const size_type ps,
+                                            const size_type cs)
+      : FieldView(preconditions_check, v, n, nc, ps, cs) {}  // end of FieldView
+
+  template <typename ValueType>
+  template <bool doPreconditionsCheck>
+  constexpr FieldView<ValueType>::FieldView(
+      const PreconditionsCheck<doPreconditionsCheck>&,
+      std::span<ValueType> v,
+      const size_type n,
+      const size_type nc,
+      const size_type ps,
+      const size_type cs)
+      : values(v),
+        number_of_points(n),
+        number_of_components(nc),
+        point_stride(ps),
+        component_stride(cs) {
+    if constexpr (doPreconditionsCheck) {
+      check_preconditions<FieldView>(v, n, nc, ps, cs);
+    }
+  }  // end of FieldView
+
+  template <typename ValueType>
+  template <typename OtherValueType>
+    requires(std::is_same_v<const OtherValueType, ValueType>)  //
+  constexpr FieldView<ValueType>::FieldView(
+      const FieldView<OtherValueType>& f) noexcept
+      : values(f.getValues()),
+        number_of_points(f.getNumberOfPoints()),
+        number_of_components(f.getNumberOfComponents()),
+        point_stride(f.getPointStride()),
+        component_stride(f.getComponentStride()) {}  // end of FieldView
+
+  template <typename ValueType>
+  constexpr ValueType* FieldView<ValueType>::data() const noexcept {
+    return this->values.data();
+  }  // end of data
+
+  template <typename ValueType>
+  constexpr std::span<ValueType> FieldView<ValueType>::getValues()
+      const noexcept {
+    return this->values;
+  }  // end of getValues
+
+  template <typename ValueType>
+  constexpr size_type FieldView<ValueType>::getNumberOfPoints() const noexcept {
+    return this->number_of_points;
+  }  // end of getNumberOfPoints
+
+  template <typename ValueType>
+  constexpr size_type FieldView<ValueType>::getNumberOfComponents()
+      const noexcept {
+    return this->number_of_components;
+  }  // end of getNumberOfComponents
+
+  template <typename ValueType>
+  constexpr size_type FieldView<ValueType>::getPointStride() const noexcept {
+    return this->point_stride;
+  }  // end of getPointStride
+
+  template <typename ValueType>
+  constexpr size_type FieldView<ValueType>::getComponentStride()
+      const noexcept {
+    return this->component_stride;
+  }  // end of getComponentStride
+
+  template <typename ValueType>
+  constexpr bool FieldView<ValueType>::empty() const noexcept {
+    return (this->number_of_points == 0) || (this->number_of_components == 0);
+  }  // end of empty
+
+  template <typename ValueType>
+  constexpr bool FieldView<ValueType>::isUniform() const noexcept {
+    return this->point_stride == 0;
+  }  // end of isUniform
+
+  template <typename ValueType>
+  constexpr bool FieldView<ValueType>::hasContiguousComponents()
+      const noexcept {
+    return (this->number_of_components <= 1) || (this->component_stride == 1);
+  }  // end of hasContiguousComponents
+
+  template <typename ValueType>
+  constexpr bool FieldView<ValueType>::hasDistinctValues() const noexcept {
+    const auto n = this->number_of_points;
+    const auto nc = this->number_of_components;
+    const auto ps = this->point_stride;
+    const auto cs = this->component_stride;
+    if ((n <= 1) && (nc <= 1)) {
+      return true;
+    }
+    if (nc <= 1) {
+      return ps != 0;
+    }
+    if (n <= 1) {
+      return cs != 0;
+    }
+    // smallest stride, its extent, and greatest stride
+    const auto s1 = ps <= cs ? ps : cs;
+    const auto e1 = ps <= cs ? n : nc;
+    const auto s2 = ps <= cs ? cs : ps;
+    // s2 >= s1 * e1, without overflow
+    return (s1 != 0) && (s2 / s1 >= e1);
+  }  // end of hasDistinctValues
+
+  template <typename ValueType>
+  constexpr ValueType& FieldView<ValueType>::operator()(
+      const size_type i, const size_type j) const noexcept {
+    return this->values[i * this->point_stride + j * this->component_stride];
+  }  // end of operator()
+
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makeFieldView(std::span<ValueType> v,
+                                               const FieldLayout l,
+                                               const size_type n,
+                                               const size_type nc) {
+    if (v.size() != n * nc) {
+      internals::reportFieldViewContractViolation(
+          "makeFieldView: invalid number of values (" +
+          std::to_string(v.size()) + " given, " + std::to_string(n * nc) +
+          " expected)");
+    }
+    if (l == FieldLayout::POINT_BY_POINT) {
+      return FieldView<ValueType>(v, n, nc, nc, 1);
+    }
+    return FieldView<ValueType>(v, n, nc, 1, n);
+  }  // end of makeFieldView
+
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makePointByPointFieldView(
+      std::span<ValueType> v,
+      const size_type n,
+      const size_type nc,
+      const size_type ps) {
+    if ((n > 1) && (ps < nc)) {
+      internals::reportFieldViewContractViolation(
+          "makePointByPointFieldView: the stride between two points (" +
+          std::to_string(ps) + ") is lower than the number of components (" +
+          std::to_string(nc) + ")");
+    }
+    return FieldView<ValueType>(v, n, nc, ps, 1);
+  }  // end of makePointByPointFieldView
+
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makeComponentByComponentFieldView(
+      std::span<ValueType> v,
+      const size_type n,
+      const size_type nc,
+      const size_type ld) {
+    if ((nc > 1) && (ld < n)) {
+      internals::reportFieldViewContractViolation(
+          "makeComponentByComponentFieldView: the stride between two "
+          "components (" +
+          std::to_string(ld) + ") is lower than the number of points (" +
+          std::to_string(n) + ")");
+    }
+    return FieldView<ValueType>(v, n, nc, 1, ld);
+  }  // end of makeComponentByComponentFieldView
+
+  template <typename ValueType>
+  constexpr FieldView<ValueType> makeUniformFieldView(std::span<ValueType> v,
+                                                      const size_type n) {
+    return FieldView<ValueType>(v, n, v.size(), 0, 1);
+  }  // end of makeUniformFieldView
+
+  template <typename ValueType>
+  constexpr FieldView<ValueType> getComponents(const FieldView<ValueType>& f,
+                                               const size_type o,
+                                               const size_type nc) {
+    if (o + nc > f.getNumberOfComponents()) {
+      internals::reportFieldViewContractViolation(
+          "getComponents: invalid range of components");
+    }
+    if ((nc == 0) || (f.getNumberOfPoints() == 0)) {
+      return FieldView<ValueType>{};
+    }
+    const auto values = f.getValues().subspan(o * f.getComponentStride());
+    return FieldView<ValueType>(no_precondition_check, values,
+                                f.getNumberOfPoints(), nc, f.getPointStride(),
+                                f.getComponentStride());
+  }  // end of getComponents
+
+}  // end of namespace mgis
+
+#endif /* LIB_MGIS_FIELDVIEW_IXX */
