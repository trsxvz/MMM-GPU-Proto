+        gradients0(getArraySize(b.gradients, b.hypothesis)),
+        gradients1(getArraySize(b.gradients, b.hypothesis)),
+        thermodynamic_forces0(
+            getArraySize(b.thermodynamic_forces, b.hypothesis)),
+        thermodynamic_forces1(
+            getArraySize(b.thermodynamic_forces, b.hypothesis)),
+        internal_state_variables0(getArraySize(b.isvs, b.hypothesis)),
+        internal_state_variables1(getArraySize(b.isvs, b.hypothesis)),
+        tangent_operator(
+            std::max(getTangentOperatorArraySize(b),
+                     static_cast<size_type>(Behaviour::nopts + 1))),
+        initialize_function_inputs(getMaximalInitializeFunctionInputsSize(b)),
+        postprocessing_outputs(getMaximalPostProcessingOutputsSize(b)) {
   }  // end of BehaviourIntegrationWorkSpace
 
   BehaviourIntegrationWorkSpace::BehaviourIntegrationWorkSpace(
diff --git a/src/MaterialDataView.cxx b/src/MaterialDataView.cxx
new file mode 100644
index 0000000..02dee6e
--- /dev/null
+++ b/src/MaterialDataView.cxx
@@ -0,0 +1,332 @@
+/*!
+ * \file   src/MaterialDataView.cxx
+ * \brief  This file implements the `MaterialStateView` and
+ * `MaterialDataView` classes
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <string>
+#include <variant>
+#include <algorithm>
+#include "MGIS/Raise.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/MaterialDataView.hxx"
+
+namespace mgis::behaviour {
+
+  MaterialStateView::MaterialStateView(const Behaviour& behaviour,
+                                       const size_type s,
+                                       std::pmr::memory_resource* const r)
+      : material_properties(
+            behaviour.mps.size(),
+            FieldView<const real>{},
+            r != nullptr ? r : std::pmr::get_default_resource()),
+        external_state_variables(behaviour.esvs.size(),
+                                 FieldView<const real>{},
+                                 material_properties.get_allocator()),
+        b(&behaviour),
+        n(s) {}  // end of MaterialStateView
+
+  MaterialStateView::MaterialStateView(const MaterialStateView&) = default;
+  MaterialStateView::MaterialStateView(MaterialStateView&&) = default;
+  MaterialStateView& MaterialStateView::operator=(const MaterialStateView&) =
+      default;
+  MaterialStateView& MaterialStateView::operator=(MaterialStateView&&) =
+      default;
+  MaterialStateView::~MaterialStateView() = default;
+
+  /*!
+   * \brief set the view of a variable (material property or external state
+   * variable)
+   * \param[in, out] ctx: execution context
+   * \param[out] views: views of the variables
+   * \param[in] s: state
+   * \param[in] variables: variables
+   * \param[in] d: description of the variables
+   * \param[in] n: name of the variable
+   * \param[in] v: values
+   */
+  static bool setVariableView(Context& ctx,
+                              std::pmr::vector<FieldView<const real>>& views,
+                              const MaterialStateView& s,
+                              const std::vector<Variable>& variables,
+                              const std::string_view d,
+                              const std::string_view n,
+                              const FieldView<const real>& v) noexcept {
+    const auto p = std::find_if(
+        variables.begin(), variables.end(),
+        [n](const Variable& variable) { return variable.name == n; });
+    if (p == variables.end()) {
+      return ctx.registerErrorMessage("no " + std::string{d} + " named '" +
+                                      std::string{n} + "'");
+    }
+    const auto i = static_cast<size_type>(p - variables.begin());
+    if (i >= views.size()) {
+      return ctx.registerErrorMessage("invalid number of views of the " +
+                                      std::string{d} + "s");
+    }
+    if (!v.empty()) {
+      const auto nc = getVariableSize(*p, s.b->hypothesis);
+      if ((v.getNumberOfPoints() != s.n) || (v.getNumberOfComponents() != nc)) {
+        return ctx.registerErrorMessage(
+            "invalid view for the " + std::string{d} + " '" + std::string{n} +
+            "' (" + std::to_string(v.getNumberOfPoints()) + " points and " +
+            std::to_string(v.getNumberOfComponents()) + " components given, " +
+            std::to_string(s.n) + " points and " + std::to_string(nc) +
+            " components expected)");
+      }
+    }
+    views[i] = v;
+    return true;
+  }  // end of setVariableView
+
+  bool setMaterialProperty(Context& ctx,
+                           MaterialStateView& s,
+                           std::string_view n,
+                           const FieldView<const real>& v) noexcept {
+    return setVariableView(ctx, s.material_properties, s, s.b->mps,
+                           "material property", n, v);
+  }  // end of setMaterialProperty
+
+  void setMaterialProperty(MaterialStateView& s,
+                           std::string_view n,
+                           const FieldView<const real>& v) {
+    auto ctx = Context{};
+    setMaterialProperty(ctx, s, n, v) | ctx.getThrowingFailureHandler();
+  }  // end of setMaterialProperty
+
+  bool setExternalStateVariable(Context& ctx,
+                                MaterialStateView& s,
+                                std::string_view n,
+                                const FieldView<const real>& v) noexcept {
+    return setVariableView(ctx, s.external_state_variables, s, s.b->esvs,
+                           "external state variable", n, v);
+  }  // end of setExternalStateVariable
+
+  void setExternalStateVariable(MaterialStateView& s,
+                                std::string_view n,
+                                const FieldView<const real>& v) {
+    auto ctx = Context{};
+    setExternalStateVariable(ctx, s, n, v) | ctx.getThrowingFailureHandler();
+  }  // end of setExternalStateVariable
+
+  bool setMassDensity(Context& ctx,
+                      MaterialStateView& s,
+                      const FieldView<const real>& v) noexcept {
+    if ((!v.empty()) &&
+        ((v.getNumberOfPoints() != s.n) || (v.getNumberOfComponents() != 1))) {
+      return ctx.registerErrorMessage("invalid view for the mass density");
+    }
+    s.mass_density = v;
+    return true;
+  }  // end of setMassDensity
+
+  void setMassDensity(MaterialStateView& s, const FieldView<const real>& v) {
+    auto ctx = Context{};
+    setMassDensity(ctx, s, v) | ctx.getThrowingFailureHandler();
+  }  // end of setMassDensity
+
+  MaterialDataView::MaterialDataView(const Behaviour& behaviour,
+                                     const size_type s,
+                                     const MemoryLocation l,
+                                     std::pmr::memory_resource* const r)
+      : s0(behaviour, s, r),
+        s1(behaviour, s, r),
+        b(&behaviour),
+        n(s),
+        memory_location(l) {}  // end of MaterialDataView
+
+  MaterialDataView::MaterialDataView(const MaterialDataView&) = default;
+  MaterialDataView::MaterialDataView(MaterialDataView&&) = default;
+  MaterialDataView& MaterialDataView::operator=(const MaterialDataView&) =
+      default;
+  MaterialDataView& MaterialDataView::operator=(MaterialDataView&&) = default;
+  MaterialDataView::~MaterialDataView() = default;
+
+  /*!
+   * \return true if the values held by a material data manager on the host
+   * are accessible by the computations of its behaviour
+   * \param[in] m: material data manager
+   */
+  static bool areHostValuesAccessible(const MaterialDataManager& m) {
+    return isMemoryLocationAccessible(m.b, MemoryLocation::HOST);
+  }  // end of areHostValuesAccessible
+
+  /*!
+   * \brief report that values held by a material data manager on the host
+   * are not accessible by the computations of its behaviour
+   * \param[in] m: material data manager
+   * \param[in] n: name of the variable
+   */
+  [[noreturn]] static void raiseInaccessibleHostValues(
+      const MaterialDataManager& m, const std::string_view n) {
+    mgis::raise("the values of '" + std::string{n} +
+                "' are held by the material data manager, in the memory "
+                "of the host, which is not accessible by the computations "
+                "of the behaviour (memory space '" +
+                m.b.memory_space +
+                "'): they must be given by a span on memory accessible by "
+                "the device, with the external storage mode");
+  }  // end of raiseInaccessibleHostValues
+
+  /*!
+   * \return the view of a material property or of an external state variable
+   * held by a material data manager
+   * \param[in] m: material data manager
+   * \param[in] v: variable
+   * \param[in] fh: field holder
+   */
+  static FieldView<const real> makeVariableView(
+      const MaterialDataManager& m,
+      const Variable& v,
+      const MaterialStateManager::FieldHolder& fh) {
+    const auto s = getVariableSize(v, m.b.hypothesis);
+    const auto from_values = [&m, &v, s](const std::span<const real> values) {
+      if (values.size() == s) {
+        return makeUniformFieldView(values, m.n);
+      }
+      if (values.size() != m.n * s) {
+        mgis::raise("make_view: invalid number of values for '" + v.name +
+                    "' (" + std::to_string(values.size()) + " given)");
+      }
+      return makeFieldView(values, FieldLayout::POINT_BY_POINT, m.n, s);
+    };
+    if (std::holds_alternative<std::monostate>(fh)) {
+      return FieldView<const real>{};
+    }
+    if (std::holds_alternative<std::span<const real>>(fh)) {
+      return from_values(std::get<std::span<const real>>(fh));
+    }
+    const auto& mfh = std::get<MaterialStateManager::MutableFieldHolder>(fh);
+    if (std::holds_alternative<std::span<real>>(mfh.value)) {
+      return from_values(std::get<std::span<real>>(mfh.value));
+    }
+    // values held by the material state manager
+    if (!areHostValuesAccessible(m)) {
+      raiseInaccessibleHostValues(m, v.name);
+    }
+    if (std::holds_alternative<real>(mfh.value)) {
+      if (s != 1) {
+        mgis::raise("make_view: invalid uniform value for '" + v.name + "'");
+      }
+      return makeUniformFieldView(
+          std::span<const real>(&std::get<real>(mfh.value), 1), m.n);
+    }
+    return from_values(std::get<std::vector<real>>(mfh.value));
+  }  // end of makeVariableView
+
+  /*!
+   * \brief set the views of a group of variables (material properties or
+   * external state variables) held by a material data manager. The views of
+   * the variables which are not defined are empty.
+   * \param[out] views: views
+   * \param[in] m: material data manager
+   * \param[in] variables: variables
+   * \param[in] values: field holders
+   */
+  static void makeVariablesViews(
+      std::pmr::vector<FieldView<const real>>& views,
+      const MaterialDataManager& m,
+      const std::vector<Variable>& variables,
+      const std::map<std::string,
+                     MaterialStateManager::FieldHolder,
+                     std::less<>>& values) {
+    for (size_type i = 0; i != variables.size(); ++i) {
+      const auto p = values.find(variables[i].name);
+      if (p != values.end()) {
+        views[i] = makeVariableView(m, variables[i], p->second);
+      }
+    }
+  }  // end of makeVariablesViews
+
+  /*!
+   * \return the view of the mass density held by a material state manager.
+   * The view is empty if the mass density is not defined, or if it is held
+   * by the material data manager in a memory which is not accessible by the
+   * computations: the mass density is only used to compute the speed of
+   * sound, and the functions using the view report its absence if it is
+   * required.
+   * \param[in] m: material data manager
+   * \param[in] s: material state manager
+   */
+  static FieldView<const real> makeMassDensityView(
+      const MaterialDataManager& m, const MaterialStateManager& s) {
+    if (!s.mass_density.has_value()) {
+      return FieldView<const real>{};
+    }
+    const auto from_values = [&m](const std::span<const real> values) {
+      if (values.size() == 1u) {
+        return makeUniformFieldView(values, m.n);
+      }
+      if (values.size() != m.n) {
+        mgis::raise("make_view: invalid number of values for the mass density");
+      }
+      return makeFieldView(values, FieldLayout::POINT_BY_POINT, m.n, 1);
+    };
+    const auto& v = s.mass_density->value;
+    if (std::holds_alternative<std::span<real>>(v)) {
+      return from_values(std::get<std::span<real>>(v));
+    }
+    // values held by the material state manager
+    if (!areHostValuesAccessible(m)) {
+      return FieldView<const real>{};
+    }
+    if (std::holds_alternative<real>(v)) {
+      return makeUniformFieldView(std::span<const real>(&std::get<real>(v), 1),
+                                  m.n);
+    }
+    return from_values(std::get<std::vector<real>>(v));
+  }  // end of makeMassDensityView
+
+  /*!
+   * \brief set the views of a state held by a material data manager
+   * \param[out] v: view of the state
+   * \param[in] m: material data manager
+   * \param[in] s: material state manager
+   */
+  static void makeStateView(MaterialStateView& v,
+                            const MaterialDataManager& m,
+                            MaterialStateManager& s) {
+    const auto l = FieldLayout::POINT_BY_POINT;
+    v.gradients = makeFieldView(s.gradients, l, m.n, s.gradients_stride);
+    v.thermodynamic_forces = makeFieldView(s.thermodynamic_forces, l, m.n,
+                                           s.thermodynamic_forces_stride);
+    v.internal_state_variables = makeFieldView(
+        s.internal_state_variables, l, m.n, s.internal_state_variables_stride);
+    if (s.stored_energies.size() == m.n) {
+      v.stored_energies = makeFieldView(s.stored_energies, l, m.n, 1);
+    }
+    if (s.dissipated_energies.size() == m.n) {
+      v.dissipated_energies = makeFieldView(s.dissipated_energies, l, m.n, 1);
+    }
+    makeVariablesViews(v.material_properties, m, m.b.mps,
+                       s.material_properties);
+    makeVariablesViews(v.external_state_variables, m, m.b.esvs,
+                       s.external_state_variables);
+    v.mass_density = makeMassDensityView(m, s);
+  }  // end of makeStateView
+
+  MaterialDataView make_view(MaterialDataManager& m,
+                             std::pmr::memory_resource* const r) {
+    const auto l = FieldLayout::POINT_BY_POINT;
+    auto v = MaterialDataView(m.b, m.n, m.memory_location, r);
+    makeStateView(v.s0, m, m.s0);
+    makeStateView(v.s1, m, m.s1);
+    if (!m.K.empty()) {
+      v.K = makeFieldView(m.K, l, m.n, m.K_stride);
+    }
+    if (!m.speed_of_sound.empty()) {
+      v.speed_of_sound = makeFieldView(m.speed_of_sound, l, m.n, 1);
+    }
+    v.batch_execution_policy = m.batch_execution_policy;
+    return v;
+  }  // end of make_view
+
+}  // end of namespace mgis::behaviour
