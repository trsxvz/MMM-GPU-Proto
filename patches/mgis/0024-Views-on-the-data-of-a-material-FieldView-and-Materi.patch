+namespace mgis::behaviour {
+
+  /*
+   * Functions on material data views.
+   *
+   * A material data view describes the data of a material stored in arrays
+   * owned by the calling code, with arbitrary strides (see
+   * `MaterialDataView`). The functions below are the counterparts of the
+   * functions on material data managers, which call them on a view of their
+   * arrays (see `make_view`):
+   *
+   * - the overloads taking an execution policy (synchronous or
+   *   asynchronous) process batches of points with a behaviour generated by
+   *   the `generic-parallel` interface;
+   * - the overloads taking a workspace accept any behaviour: a behaviour
+   *   generated by the `generic-parallel` interface is processed as a batch
+   *   with the execution policy of the view, the other behaviours are
+   *   processed point by point on the host, with the given workspace.
+   *
+   * A workspace must have been built for the behaviour of the view, and must
+   * not be used by several threads at the same time. If the components of a
+   * group of variables are contiguous, the computations point by point use
+   * the values in place. Otherwise, the values of each point are gathered in
+   * the workspace, and the outputs are copied back.
+   *
+   * The views are checked before any computation: behaviour, number of
+   * points and number of components of each view, outputs given at each
+   * point with distinct values, memory location of the arrays.
+   */
+
+  /*!
+   * \brief execute the given initialize function, without inputs, over the
+   * points `[b, e)` of a material data view
+   * \param[in,out] ws: workspace
+   * \param[in] v: material data view
+   * \param[in] n: name of the initialize function
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(BehaviourIntegrationWorkSpace&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const size_type,
+                            const size_type);
+  /*!
+   * \brief execute the given initialize function over the points `[b, e)` of
+   * a material data view
+   * \param[in,out] ws: workspace
+   * \param[in] v: material data view
+   * \param[in] n: name of the initialize function
+   * \param[in] inputs: inputs of the initialize function, uniform or given
+   * at each point
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(BehaviourIntegrationWorkSpace&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const FieldView<const real>&,
+                            const size_type,
+                            const size_type);
+  //! \brief see the previous overloads, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(BehaviourIntegrationWorkSpace&,
+                            const MaterialDataView&,
+                            const std::string_view);
+  //! \brief see the previous overloads, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(BehaviourIntegrationWorkSpace&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const FieldView<const real>&);
+  /*!
+   * \brief execute the given initialize function of a behaviour generated by
+   * the `generic-parallel` interface over the points `[b, e)` of a material
+   * data view, as a batch
+   * \param[in] p: execution policy
+   * \param[in] v: material data view
+   * \param[in] n: name of the initialize function
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(const BatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const size_type,
+                            const size_type);
+  //! \brief see the previous overload, with inputs
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(const BatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const FieldView<const real>&,
+                            const size_type,
+                            const size_type);
+  //! \brief see the previous overloads, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(const BatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view);
+  //! \brief see the previous overloads, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  executeInitializeFunction(const BatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const FieldView<const real>&);
+  //! \brief asynchronous version, over a range of points
+  MGIS_EXPORT PendingBatchComputation
+  executeInitializeFunction(const AsynchronousBatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const size_type,
+                            const size_type);
+  //! \brief asynchronous version, with inputs, over a range of points
+  MGIS_EXPORT PendingBatchComputation
+  executeInitializeFunction(const AsynchronousBatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const FieldView<const real>&,
+                            const size_type,
+                            const size_type);
+  //! \brief asynchronous version, on all the points
+  MGIS_EXPORT PendingBatchComputation
+  executeInitializeFunction(const AsynchronousBatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view);
+  //! \brief asynchronous version, with inputs, on all the points
+  MGIS_EXPORT PendingBatchComputation
+  executeInitializeFunction(const AsynchronousBatchExecutionPolicy&,
+                            const MaterialDataView&,
+                            const std::string_view,
+                            const FieldView<const real>&);
+
+  /*!
+   * \brief integrate the behaviour over the points `[b, e)` of a material
+   * data view: as a batch for a behaviour generated by the
+   * `generic-parallel` interface (with the execution policy of the view),
+   * point by point on the host otherwise.
+   *
+   * \return the result of the behaviour integration.
+   * \param[in,out] ws: workspace
+   * \param[in] v: material data view
+   * \param[in] opts: description of the operation to be performed
+   * \param[in] dt: time step
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   * \note the views of the tangent operator blocks and of the speed of sound
+   * must be given if they are requested by the options.
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate(BehaviourIntegrationWorkSpace&,
+            const MaterialDataView&,
+            const BehaviourIntegrationOptions&,
+            const real,
+            const size_type,
+            const size_type);
+  //! \brief see the previous overload, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate(BehaviourIntegrationWorkSpace&,
+            const MaterialDataView&,
+            const BehaviourIntegrationOptions&,
+            const real);
+  /*!
+   * \brief integrate a behaviour generated by the `generic-parallel`
+   * interface over the points `[b, e)` of a material data view, as a batch
+   * (see the overloads on material data managers)
+   * \param[in] p: execution policy
+   * \param[in] v: material data view
+   * \param[in] opts: description of the operation to be performed
+   * \param[in] dt: time step
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate(const BatchExecutionPolicy&,
+            const MaterialDataView&,
+            const BehaviourIntegrationOptions&,
+            const real,
+            const size_type,
+            const size_type);
+  //! \brief see the previous overload, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate(const BatchExecutionPolicy&,
+            const MaterialDataView&,
+            const BehaviourIntegrationOptions&,
+            const real);
+  //! \brief asynchronous version, over a range of points
+  MGIS_EXPORT PendingBatchComputation
+  integrate(const AsynchronousBatchExecutionPolicy&,
+            const MaterialDataView&,
+            const BehaviourIntegrationOptions&,
+            const real,
+            const size_type,
+            const size_type);
+  //! \brief asynchronous version, on all the points
+  MGIS_EXPORT PendingBatchComputation
+  integrate(const AsynchronousBatchExecutionPolicy&,
+            const MaterialDataView&,
+            const BehaviourIntegrationOptions&,
+            const real);
+  /*!
+   * \brief debugging version of the integration point by point, not
+   * available for a behaviour generated by the `generic-parallel` interface
+   * \param[in,out] ws: workspace
+   * \param[in] v: material data view
+   * \param[in] opts: description of the operation to be performed
+   * \param[in] dt: time step
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   * \param[in] analyser: failure analyser
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate_debug(BehaviourIntegrationWorkSpace&,
+                  const MaterialDataView&,
+                  const BehaviourIntegrationOptions&,
+                  const real,
+                  const size_type,
+                  const size_type,
+                  const debug::BehaviourIntegrationFailureAnalyser&);
+  //! \brief see the previous overload, with the default failure analyser
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate_debug(BehaviourIntegrationWorkSpace&,
+                  const MaterialDataView&,
+                  const BehaviourIntegrationOptions&,
+                  const real,
+                  const size_type,
+                  const size_type);
+  //! \brief see the previous overloads, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate_debug(BehaviourIntegrationWorkSpace&,
+                  const MaterialDataView&,
+                  const BehaviourIntegrationOptions&,
+                  const real,
+                  const debug::BehaviourIntegrationFailureAnalyser&);
+  //! \brief see the previous overloads, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  integrate_debug(BehaviourIntegrationWorkSpace&,
+                  const MaterialDataView&,
+                  const BehaviourIntegrationOptions&,
+                  const real);
+
+  /*!
+   * \brief execute the given post-processing over the points `[b, e)` of a
+   * material data view
+   * \param[out] outputs: post-processing results, given at each point
+   * \param[in,out] ws: workspace
+   * \param[in] v: material data view
+   * \param[in] n: name of the post-processing
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  executePostProcessing(const FieldView<real>&,
+                        BehaviourIntegrationWorkSpace&,
+                        const MaterialDataView&,
+                        const std::string_view,
+                        const size_type,
+                        const size_type);
+  //! \brief see the previous overload, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  executePostProcessing(const FieldView<real>&,
+                        BehaviourIntegrationWorkSpace&,
+                        const MaterialDataView&,
+                        const std::string_view);
+  /*!
+   * \brief execute the given post-processing of a behaviour generated by the
+   * `generic-parallel` interface over the points `[b, e)` of a material data
+   * view, as a batch
+   * \param[out] outputs: post-processing results, given at each point
+   * \param[in] p: execution policy
+   * \param[in] v: material data view
+   * \param[in] n: name of the post-processing
+   * \param[in] b: first index of the range
+   * \param[in] e: last index of the range
+   */
+  MGIS_EXPORT BehaviourIntegrationResult
+  executePostProcessing(const FieldView<real>&,
+                        const BatchExecutionPolicy&,
+                        const MaterialDataView&,
+                        const std::string_view,
+                        const size_type,
+                        const size_type);
+  //! \brief see the previous overload, on all the points
+  MGIS_EXPORT BehaviourIntegrationResult
+  executePostProcessing(const FieldView<real>&,
+                        const BatchExecutionPolicy&,
+                        const MaterialDataView&,
+                        const std::string_view);
+  //! \brief asynchronous version, over a range of points
+  MGIS_EXPORT PendingBatchComputation
+  executePostProcessing(const FieldView<real>&,
+                        const AsynchronousBatchExecutionPolicy&,
+                        const MaterialDataView&,
+                        const std::string_view,
+                        const size_type,
+                        const size_type);
+  //! \brief asynchronous version, on all the points
+  MGIS_EXPORT PendingBatchComputation
+  executePostProcessing(const FieldView<real>&,
+                        const AsynchronousBatchExecutionPolicy&,
+                        const MaterialDataView&,
+                        const std::string_view);
+
+}  // end of namespace mgis::behaviour
+
