+//! \brief material data views of material data managers
+static void testMakeView(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{8};
+  auto m = MaterialDataManager(b, n);
+  setExternalStateVariable(m.s0, "Temperature", 293.15);
+  setExternalStateVariable(m.s1, "Temperature", 293.15);
+  auto m2 = MaterialDataManager(b, n);
+  setExternalStateVariable(m2.s0, "Temperature", 293.15);
+  setExternalStateVariable(m2.s1, "Temperature", 293.15);
+  for (auto* const pm : {&m, &m2}) {
+    for (size_type i = 0; i != n; ++i) {
+      pm->s1.gradients[i * pm->s1.gradients_stride] =
+          1e-3 * static_cast<real>(i + 1);
+    }
+  }
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  m2.allocateArrayOfTangentOperatorBlocks();
+  const auto r = integrate(m, opts, 1);
+  auto ws = BehaviourIntegrationWorkSpace(b);
+  const auto v = make_view(m2);
+  const auto rv = integrate(ws, v, opts, 1);
+  check(r.exit_status == rv.exit_status, "make_view: invalid status");
+  check(std::equal(m.s1.thermodynamic_forces.begin(),
+                   m.s1.thermodynamic_forces.end(),
+                   m2.s1.thermodynamic_forces.begin(), same),
+        "make_view: invalid thermodynamic forces");
+  check(std::equal(m.K.begin(), m.K.end(), m2.K.begin(), same),
+        "make_view: invalid tangent operator blocks");
+  // the views are regular types
+  auto v2 = MaterialDataView(b, 1, mgis::MemoryLocation::HOST);
+  v2 = v;
+  check((v2.n == n) && (v2.s1.gradients.data() == m2.s1.gradients.data()),
+        "make_view: invalid assignement");
+}  // end of testMakeView
