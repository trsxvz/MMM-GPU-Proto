+/*!
+ * \brief external state variables and internal state variables with several
+ * components: the internal state variables are the values of the external
+ * state variables at the end of the time step
+ */
+static void testTensorialVariables(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "TensorialExternalStateVariableTest",
+                      Hypothesis::TRIDIMENSIONAL);
+  const auto h = b.hypothesis;
+  constexpr auto n = size_type{6};
+  // values of the external state variables of the manager, point by point,
+  // and of the view, in all the arrangements
+  auto values = std::vector<std::vector<real>>{};
+  values.reserve(b.esvs.size());
+  for (const auto& esv : b.esvs) {
+    auto& vv = values.emplace_back(n * getVariableSize(esv, h));
+    for (size_type i = 0; i != vv.size(); ++i) {
+      vv[i] = std::sin(static_cast<real>(values.size() + 7 * i));
+    }
+  }
+  const auto properties = std::array<real, 3>{150e9, 0.3, 293.15};
+  for (const auto a : arrangements) {
+    const auto test =
+        "TensorialExternalStateVariableTest (" + getName(a) + "), " + library;
+    auto m = MaterialDataManager(b, n);
+    auto d = ViewData(b, n, a);
+    auto arrays = std::vector<std::unique_ptr<Array>>{};
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", properties[0]);
+      setMaterialProperty(*s, "PoissonRatio", properties[1]);
+    }
+    for (auto* const s : {&d.v.s0, &d.v.s1}) {
+      setMaterialProperty(
+          *s, "YoungModulus",
+          mgis::makeUniformFieldView(
+              std::span<const real>(properties).subspan(0, 1), n));
+      setMaterialProperty(
+          *s, "PoissonRatio",
+          mgis::makeUniformFieldView(
+              std::span<const real>(properties).subspan(1, 1), n));
+    }
+    for (std::size_t k = 0; k != b.esvs.size(); ++k) {
+      const auto& esv = b.esvs[k];
+      if (esv.name == "Temperature") {
+        for (auto* const s : {&m.s0, &m.s1}) {
+          setExternalStateVariable(*s, esv.name, properties[2]);
+        }
+        for (auto* const s : {&d.v.s0, &d.v.s1}) {
+          setExternalStateVariable(
+              *s, esv.name,
+              mgis::makeUniformFieldView(
+                  std::span<const real>(properties).subspan(2, 1), n));
+        }
+        continue;
+      }
+      for (auto* const s : {&m.s0, &m.s1}) {
+        setExternalStateVariable(*s, esv.name, values[k],
+                                 MaterialStateManager::EXTERNAL_STORAGE);
+      }
+      auto& array = *(arrays.emplace_back(
+          std::make_unique<Array>(n, getVariableSize(esv, h), a)));
+      array.copyFrom(values[k]);
+      for (auto* const s : {&d.v.s0, &d.v.s1}) {
+        setExternalStateVariable(*s, esv.name, array.view);
+      }
+    }
+    auto opts = BehaviourIntegrationOptions{};
+    opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+    auto ws = BehaviourIntegrationWorkSpace(b);
+    d.copyFrom(m);
+    const auto r = integrate(m, opts, 1);
+    const auto rv = integrate(ws, d.v, opts, 1);
+    check(r.exit_status == rv.exit_status, test + ": invalid status");
+    check(d.hasSameOutputs(m, false), test + ": invalid outputs");
+  }
+}  // end of testTensorialVariables
+
+/*!
+ * \brief initialize functions, with inputs given at each point and without
+ * inputs, on a range of points
+ */
+static void testInitializeFunctions(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b =
+      load(library, "InitializeFunctionTest", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{12};
+  auto pressures = std::vector<real>(n);
+  for (size_type i = 0; i != n; ++i) {
+    pressures[i] = -1e5 * static_cast<real>(i + 1);
+  }
+  const auto temperature = std::array<real, 1>{293.15};
+  for (const auto a : arrangements) {
+    const auto test = "InitializeFunctionTest (" + getName(a) + "), " + library;
+    auto m = MaterialDataManager(b, n);
+    auto d = ViewData(b, n, a);
+    setExternalStateVariable(m.s0, "Temperature", temperature[0]);
+    setExternalStateVariable(m.s1, "Temperature", temperature[0]);
+    const auto T =
+        mgis::makeUniformFieldView(std::span<const real>(temperature), n);
+    setExternalStateVariable(d.v.s0, "Temperature", T);
+    setExternalStateVariable(d.v.s1, "Temperature", T);
+    auto ws = BehaviourIntegrationWorkSpace(b);
+    auto inputs = Array(n, 1, a);
+    inputs.copyFrom(pressures);
+    d.copyFrom(m);
+    const auto r =
+        executeInitializeFunction(m, "StressFromInitialPressure", pressures);
+    const auto rv =
+        executeInitializeFunction(ws, d.v, "StressFromInitialPressure",
+                                  FieldView<const real>(inputs.view));
+    check(r.exit_status == rv.exit_status, test + ": invalid status");
+    check(d.hasSameOutputs(m, false), test + ": invalid outputs");
+    // the elastic strain is computed from the stress at the beginning of the
+    // time step
+    update(m);
+    d.copyFrom(m);
+    const auto r2 =
+        executeInitializeFunction(m, "ElasticStrainFromInitialStress", 2, 9);
+    const auto rv2 = executeInitializeFunction(
+        ws, d.v, "ElasticStrainFromInitialStress", 2, 9);
+    check(r2.exit_status == rv2.exit_status, test + ": invalid status (range)");
+    check(d.hasSameOutputs(m, false), test + ": invalid outputs (range)");
+    if (isGenericParallelBehaviour(b)) {
+      d.copyFrom(m);
+      const auto pending =
+          executeInitializeFunction(AsynchronousBatchExecutionPolicy{}, d.v,
+                                    "ElasticStrainFromInitialStress", 2, 9);
+      check(pending.getResult().exit_status == r2.exit_status,
+            test + ": invalid status (asynchronous policy)");
+      check(d.hasSameOutputs(m, false),
+            test + ": invalid outputs (asynchronous policy)");
+    }
+  }
+}  // end of testInitializeFunctions
