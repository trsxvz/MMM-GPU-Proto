+//! \brief checks of the FieldView class
+static void testFieldView() {
+  auto values = std::vector<real>(12);
+  for (std::size_t i = 0; i != values.size(); ++i) {
+    values[i] = static_cast<real>(i);
+  }
+  const auto s = std::span<real>(values);
+  // default view
+  const auto e = FieldView<real>{};
+  check(e.empty() && (e.data() == nullptr), "FieldView: invalid empty view");
+  // point by point and component by component
+  const auto a = mgis::makeFieldView(s, FieldLayout::POINT_BY_POINT, 4, 3);
+  check(
+      same(a(2, 1), 7) && a.hasContiguousComponents() && a.hasDistinctValues(),
+      "FieldView: invalid point by point view");
+  const auto b =
+      mgis::makeFieldView(s, FieldLayout::COMPONENT_BY_COMPONENT, 4, 3);
+  check(same(b(2, 1), 6) && (!b.hasContiguousComponents()) &&
+            b.hasDistinctValues(),
+        "FieldView: invalid component by component view");
+  // conversion to a constant view
+  const auto cb = FieldView<const real>(b);
+  check(same(cb(3, 2), 11) && (cb.getPointStride() == 1) &&
+            (cb.getComponentStride() == 4),
+        "FieldView: invalid conversion to a constant view");
+  // components
+  const auto c = mgis::getComponents(b, 1, 2);
+  check(
+      (c.getNumberOfComponents() == 2) && same(c(0, 0), 4) && same(c(3, 1), 11),
+      "FieldView: invalid view of some components");
+  // uniform values
+  const auto u = mgis::makeUniformFieldView(s.subspan(0, 3), 100);
+  check(u.isUniform() && same(u(57, 2), 2) && (!u.hasDistinctValues()),
+        "FieldView: invalid uniform view");
+  // padding
+  const auto p = mgis::makePointByPointFieldView(s, 2, 3, 6);
+  check(same(p(1, 2), 8) && p.hasDistinctValues(),
+        "FieldView: invalid padded view");
+  const auto l = mgis::makeComponentByComponentFieldView(s, 3, 3, 4);
+  check(same(l(2, 2), 10) && l.hasDistinctValues(),
+        "FieldView: invalid view with a leading dimension");
+  // preconditions (a violation is a contract violation)
+  auto ctx = mgis::Context{};
+  check(FieldView<real>::checkPreconditions(ctx, s, 4, 3, 3, 1),
+        "FieldView: valid view rejected");
+  check(!FieldView<real>::checkPreconditions(ctx, s, 5, 3, 3, 1),
+        "FieldView: too many points not detected");
+  check(!FieldView<real>::checkPreconditions(ctx, s, 4, 4, 3, 1),
+        "FieldView: too many components not detected");
+  check(!FieldView<real>::checkPreconditions(ctx, s, 4, 3, 3, 0),
+        "FieldView: null component stride not detected");
+  check(
+      !FieldView<real>::checkPreconditions(ctx, std::span<real>{}, 1, 1, 1, 1),
+      "FieldView: missing values not detected");
+  // empty sets are always valid
+  check(
+      FieldView<real>::checkPreconditions(ctx, std::span<real>{}, 0, 3, 3, 1) &&
+          FieldView<real>(std::span<real>{}, 0, 3, 3, 1).empty(),
+      "FieldView: invalid empty set");
+  // overlapping values: equal strides, interleaved strides
+  check(!FieldView<real>(s, 2, 2, 1, 1).hasDistinctValues(),
+        "FieldView: overlapping values not detected (equal strides)");
+  check(!FieldView<real>(s, 2, 2, 3, 2).hasDistinctValues(),
+        "FieldView: interleaved strides not rejected");
+  check(FieldView<real>(s, 3, 2, 1, 3).hasDistinctValues(),
+        "FieldView: distinct values not detected");
+}  // end of testFieldView
+
+/*!
+ * \brief integrate a behaviour on a material data manager and on views with
+ * all the arrangements tested, and compare the results bit for bit
+ * \param[in] name: name of the test
+ * \param[in] b: behaviour
+ * \param[in] n: number of points
+ * \param[in] setup: function setting the material properties and the
+ * external state variables of the manager and of the view
+ * \param[in] load: function setting the gradients at the end of the time
+ * step of the manager, for the given step
+ * \param[in] nsteps: number of steps
+ * \param[in] range: range of points
+ */
+template <typename Setup, typename Load>
+static void compareIntegrations(const std::string& name,
+                                const mgis::behaviour::Behaviour& b,
+                                const size_type n,
+                                const Setup& setup,
+                                const Load& load,
+                                const int nsteps,
+                                const std::array<size_type, 2>& range = {0,
+                                                                         0}) {
+  using namespace mgis::behaviour;
+  const auto all = (range[0] == 0) && (range[1] == 0);
+  const auto first = all ? 0 : range[0];
+  const auto last = all ? n : range[1];
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  for (const auto a : arrangements) {
+    const auto test = name + " (" + getName(a) + ")";
+    auto m = MaterialDataManager(b, n);
+    m.allocateArrayOfTangentOperatorBlocks();
+    auto d = ViewData(b, n, a);
+    setup(m, d.v);
+    auto ws = BehaviourIntegrationWorkSpace(b);
+    for (int step = 0; step != nsteps; ++step) {
+      load(m, step);
+      d.copyFrom(m);
+      const auto r = integrate(m, opts, 1, first, last);
+      const auto rv = integrate(ws, d.v, opts, 1, first, last);
+      check(r.exit_status == rv.exit_status, test + ": invalid status");
+      check(same(r.time_step_increase_factor, rv.time_step_increase_factor),
+            test + ": invalid time step increase factor");
+      check(d.hasSameOutputs(m, true), test + ": invalid outputs");
+      if (isGenericParallelBehaviour(b)) {
+        // synchronous and asynchronous computations on a batch
+        d.copyFrom(m);
+        const auto rs =
+            integrate(BatchExecutionPolicy{}, d.v, opts, 1, first, last);
+        check(rs.exit_status == r.exit_status,
+              test + ": invalid status (synchronous policy)");
+        check(d.hasSameOutputs(m, true),
+              test + ": invalid outputs (synchronous policy)");
+        d.copyFrom(m);
+        const auto pending = integrate(AsynchronousBatchExecutionPolicy{}, d.v,
+                                       opts, 1, first, last);
+        const auto ra = pending.getResult();
+        check(ra.exit_status == r.exit_status,
+              test + ": invalid status (asynchronous policy)");
+        check(same(ra.time_step_increase_factor, r.time_step_increase_factor),
+              test +
+                  ": invalid time step increase factor (asynchronous "
+                  "policy)");
+        check(d.hasSameOutputs(m, true),
+              test + ": invalid outputs (asynchronous policy)");
+      }
+      update(m);
+    }
+  }
+}  // end of compareIntegrations
+
+//! \brief Norton behaviour, uniform temperature
+static void testNorton(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{17};
+  const auto temperature = std::array<real, 1>{293.15};
+  auto setup = [&temperature](MaterialDataManager& m, MaterialDataView& v) {
+    setExternalStateVariable(m.s0, "Temperature", temperature[0]);
+    setExternalStateVariable(m.s1, "Temperature", temperature[0]);
+    const auto T =
+        mgis::makeUniformFieldView(std::span<const real>(temperature), v.n);
+    setExternalStateVariable(v.s0, "Temperature", T);
+    setExternalStateVariable(v.s1, "Temperature", T);
+  };
+  auto load = [](MaterialDataManager& m, const int step) {
+    for (size_type i = 0; i != m.n; ++i) {
+      for (size_type c = 0; c != m.s1.gradients_stride; ++c) {
+        m.s1.gradients[i * m.s1.gradients_stride + c] +=
+            1e-4 * static_cast<real>((step + 1) * (c + 1)) *
+            (1 + 0.1 * static_cast<real>(i));
+      }
+    }
+  };
+  compareIntegrations("Norton, " + library, b, n, setup, load, 3);
+  compareIntegrations("Norton, range, " + library, b, n, setup, load, 2,
+                      {3, 11});
+}  // end of testNorton
