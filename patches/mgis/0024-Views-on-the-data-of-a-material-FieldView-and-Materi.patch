+//! \brief post-processing, outputs in all the arrangements
+static void testPostProcessings(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b =
+      load(library, "PostProcessingTest", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{10};
+  const auto values = std::array<real, 3>{150e9, 0.3, 293.15};
+  for (const auto a : arrangements) {
+    const auto test = "PostProcessingTest (" + getName(a) + "), " + library;
+    auto m = MaterialDataManager(b, n);
+    auto d = ViewData(b, n, a);
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", values[0]);
+      setMaterialProperty(*s, "PoissonRatio", values[1]);
+      setExternalStateVariable(*s, "Temperature", values[2]);
+    }
+    for (auto* const s : {&d.v.s0, &d.v.s1}) {
+      setMaterialProperty(*s, "YoungModulus",
+                          mgis::makeUniformFieldView(
+                              std::span<const real>(values).subspan(0, 1), n));
+      setMaterialProperty(*s, "PoissonRatio",
+                          mgis::makeUniformFieldView(
+                              std::span<const real>(values).subspan(1, 1), n));
+      setExternalStateVariable(
+          *s, "Temperature",
+          mgis::makeUniformFieldView(
+              std::span<const real>(values).subspan(2, 1), n));
+    }
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != 3; ++c) {
+        m.s1.gradients[i * m.s1.gradients_stride + c] =
+            1e-3 * static_cast<real>((i + 1) * (c + 1));
+      }
+      m.s1.gradients[i * m.s1.gradients_stride + 3] = 1e-4;
+    }
+    d.copyFrom(m);
+    auto ws = BehaviourIntegrationWorkSpace(b);
+    auto outputs = allocatePostProcessingVariables(m, "PrincipalStrain");
+    const auto os = outputs.size() / n;
+    auto voutputs = Array(n, os, a);
+    const auto r = executePostProcessing(outputs, m, "PrincipalStrain", 1, 8);
+    const auto rv =
+        executePostProcessing(voutputs.view, ws, d.v, "PrincipalStrain", 1, 8);
+    check(r.exit_status == rv.exit_status, test + ": invalid status");
+    // the outputs of the points out of the range are not computed
+    auto expected = std::vector<real>(n * os, sentinel);
+    std::copy(outputs.begin() + os, outputs.begin() + 8 * os,
+              expected.begin() + os);
+    check(voutputs.equals(expected), test + ": invalid outputs");
+    check(voutputs.hasUnusedValuesUnchanged(),
+          test + ": unused values modified");
+  }
+}  // end of testPostProcessings
