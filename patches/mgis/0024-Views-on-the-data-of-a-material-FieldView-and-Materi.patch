diff --git a/tests/MaterialDataViewTest.cxx b/tests/MaterialDataViewTest.cxx
new file mode 100644
index 0000000..5a493e3
--- /dev/null
+++ b/tests/MaterialDataViewTest.cxx
@@ -0,0 +1,780 @@
+/*!
+ * \file   tests/MaterialDataViewTest.cxx
+ * \brief  This test checks the views on the values of a group of variables
+ * (`FieldView`) and the functions working on material data views, for
+ * behaviours generated by the `generic` interface (computations point by
+ * point) and by the `generic-parallel` interface (computations on batches).
+ * The results obtained on views with various layouts are compared, bit for
+ * bit, to the results obtained with a material data manager.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <bit>
+#include <array>
+#include <cstdint>
+#include <cmath>
+#include <span>
+#include <string>
+#include <vector>
+#include <memory>
+#include <cstdlib>
+#include <iostream>
+#include <algorithm>
+#include <stdexcept>
+#include <string_view>
+#include "MGIS/Context.hxx"
+#include "MGIS/FieldView.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/MaterialDataView.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+/*!
+ * \return true if the given function throws an exception whose message
+ * contains the given text
+ */
+template <typename Function>
+static bool throws(const Function& f, const std::string_view text) {
+  try {
+    f();
+  } catch (std::exception& e) {
+    return std::string_view{e.what()}.find(text) != std::string_view::npos;
+  }
+  return false;
+}
+
+using mgis::FieldLayout;
+using mgis::FieldView;
+using mgis::real;
+using mgis::size_type;
+
+//! \return true if two values are identical, bit for bit
+static bool same(const real a, const real b) {
+  return std::bit_cast<std::uint64_t>(a) == std::bit_cast<std::uint64_t>(b);
+}  // end of same
+
+//! \brief arrangements of the values of a group of variables tested
+enum struct Arrangement {
+  POINT_BY_POINT,
+  COMPONENT_BY_COMPONENT,
+  //! \brief point by point, with two unused values after each point
+  PADDED_POINT_BY_POINT,
+  //! \brief component by component, with three unused values after each
+  //! component
+  PADDED_COMPONENT_BY_COMPONENT
+};
+
+static const auto arrangements =
+    std::array{Arrangement::POINT_BY_POINT, Arrangement::COMPONENT_BY_COMPONENT,
+               Arrangement::PADDED_POINT_BY_POINT,
+               Arrangement::PADDED_COMPONENT_BY_COMPONENT};
+
+static std::string getName(const Arrangement a) {
+  if (a == Arrangement::POINT_BY_POINT) {
+    return "point by point";
+  } else if (a == Arrangement::COMPONENT_BY_COMPONENT) {
+    return "component by component";
+  } else if (a == Arrangement::PADDED_POINT_BY_POINT) {
+    return "padded point by point";
+  }
+  return "padded component by component";
+}  // end of getName
+
+//! \brief value of the unused values, which must never be modified
+static constexpr auto sentinel = real{-12345.678};
+
+//! \brief values of a group of variables in a given arrangement
+struct Array {
+  Array(const size_type n, const size_type nc, const Arrangement a) {
+    if (a == Arrangement::POINT_BY_POINT) {
+      this->values.resize(n * nc, sentinel);
+      this->view = mgis::makeFieldView(std::span<real>(this->values),
+                                       FieldLayout::POINT_BY_POINT, n, nc);
+    } else if (a == Arrangement::COMPONENT_BY_COMPONENT) {
+      this->values.resize(n * nc, sentinel);
+      this->view =
+          mgis::makeFieldView(std::span<real>(this->values),
+                              FieldLayout::COMPONENT_BY_COMPONENT, n, nc);
+    } else if (a == Arrangement::PADDED_POINT_BY_POINT) {
+      this->values.resize(n * (nc + 2), sentinel);
+      this->view = mgis::makePointByPointFieldView(
+          std::span<real>(this->values), n, nc, nc + 2);
+    } else {
+      this->values.resize(nc * (n + 3), sentinel);
+      this->view = mgis::makeComponentByComponentFieldView(
+          std::span<real>(this->values), n, nc, n + 3);
+    }
+    this->number_of_unused_values = this->values.size() - n * nc;
+  }
+  Array(Array&&) = delete;
+  Array(const Array&) = delete;
+  Array& operator=(Array&&) = delete;
+  Array& operator=(const Array&) = delete;
+  //! \brief copy values stored point by point
+  void copyFrom(const std::span<const real> v) {
+    const auto n = this->view.getNumberOfPoints();
+    const auto nc = this->view.getNumberOfComponents();
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        this->view(i, j) = v[i * nc + j];
+      }
+    }
+  }
+  //! \return true if the values are the given ones, stored point by point
+  bool equals(const std::span<const real> v) const {
+    const auto n = this->view.getNumberOfPoints();
+    const auto nc = this->view.getNumberOfComponents();
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        if (!same(this->view(i, j), v[i * nc + j])) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+  //! \return true if the unused values have not been modified
+  bool hasUnusedValuesUnchanged() const {
+    const auto c =
+        std::count_if(this->values.begin(), this->values.end(),
+                      [](const real v) { return same(v, sentinel); });
+    return static_cast<size_type>(c) >= this->number_of_unused_values;
+  }
+  //! \brief values
+  std::vector<real> values;
+  //! \brief view
+  FieldView<real> view;
+  //! \brief number of unused values
+  size_type number_of_unused_values = 0;
+};
+
+/*!
+ * \brief arrays holding the states of a material in a given arrangement, and
+ * view on those arrays
+ */
+struct ViewData {
+  ViewData(const mgis::behaviour::Behaviour& b,
+           const size_type n,
+           const Arrangement a)
+      : g0(n, getArraySize(b.gradients, b.hypothesis), a),
+        g1(n, getArraySize(b.gradients, b.hypothesis), a),
+        t0(n, getArraySize(b.thermodynamic_forces, b.hypothesis), a),
+        t1(n, getArraySize(b.thermodynamic_forces, b.hypothesis), a),
+        isvs0(n, getArraySize(b.isvs, b.hypothesis), a),
+        isvs1(n, getArraySize(b.isvs, b.hypothesis), a),
+        K(n, getTangentOperatorArraySize(b), a),
+        v(b, n, mgis::MemoryLocation::HOST) {
+    this->v.s0.gradients = this->g0.view;
+    this->v.s1.gradients = this->g1.view;
+    this->v.s0.thermodynamic_forces = this->t0.view;
+    this->v.s1.thermodynamic_forces = this->t1.view;
+    this->v.s0.internal_state_variables = this->isvs0.view;
+    this->v.s1.internal_state_variables = this->isvs1.view;
+    this->v.K = this->K.view;
+  }
+  //! \brief copy the states of a material data manager
+  void copyFrom(const mgis::behaviour::MaterialDataManager& m) {
+    this->g0.copyFrom(m.s0.gradients);
+    this->g1.copyFrom(m.s1.gradients);
+    this->t0.copyFrom(m.s0.thermodynamic_forces);
+    this->t1.copyFrom(m.s1.thermodynamic_forces);
+    this->isvs0.copyFrom(m.s0.internal_state_variables);
+    this->isvs1.copyFrom(m.s1.internal_state_variables);
+    if (!m.K.empty()) {
+      this->K.copyFrom(m.K);
+    }
+  }
+  /*!
+   * \return true if the outputs are the ones of the material data manager,
+   * bit for bit, and if the unused values are unchanged
+   */
+  bool hasSameOutputs(const mgis::behaviour::MaterialDataManager& m,
+                      const bool tangent_operator) const {
+    auto r = this->t1.equals(m.s1.thermodynamic_forces) &&
+             this->isvs1.equals(m.s1.internal_state_variables);
+    if (tangent_operator) {
+      r = r && this->K.equals(m.K);
+    }
+    for (const auto* const a : {&g0, &g1, &t0, &t1, &isvs0, &isvs1, &K}) {
+      r = r && a->hasUnusedValuesUnchanged();
+    }
+    return r;
+  }
+  Array g0, g1, t0, t1, isvs0, isvs1, K;
+  mgis::behaviour::MaterialDataView v;
+};
