+/*!
+ * \brief point where the integration fails, with the values of a point
+ * gathered in the workspace (tangent operator blocks stored component by
+ * component): the tangent operator blocks are not written
+ */
+static void testFailingPoint(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "NortonFailure", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{4};
+  auto d = ViewData(b, n, Arrangement::COMPONENT_BY_COMPONENT);
+  auto m = MaterialDataManager(b, n);
+  setupTemperature(m, d.v);
+  d.copyFrom(m);
+  // the copy of the manager set the tangent operator blocks to zero
+  std::fill(d.K.values.begin(), d.K.values.end(), sentinel);
+  auto ws = BehaviourIntegrationWorkSpace(b);
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  const auto r = integrate(ws, d.v, opts, 1);
+  check(r.exit_status == -1, "NortonFailure: the integration must fail");
+  check(std::all_of(d.K.values.begin(), d.K.values.end(),
+                    [](const real x) { return same(x, sentinel); }),
+        "NortonFailure: the tangent operator blocks of a failing point "
+        "must not be written");
+}  // end of testFailingPoint
