+static void testFailingOperations(const std::string& library) {
+  using namespace mgis::behaviour;
+  struct ThrowingOperations final : mgis::FieldOperations {
+   private:
+    void do_copy(const FieldView<real>&,
+                 const FieldView<const real>&) override {
+      throw std::runtime_error(std::string(200, '-') + " copy failed");
+    }
+    void do_fill(const FieldView<real>&, const real) override {}
+  };
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  auto m = MaterialDataManager(b, 3);
+  auto ops = ThrowingOperations{};
+  check(throws([&] { update(m, ops); }, "copy failed"),
+        "the error of a copy must be reported by update");
+  auto ctx = mgis::Context{};
+  check(!updateValues(ctx, m.s0, m.s1, ops) &&
+            (ctx.getErrorMessage().find("copy failed") != std::string::npos),
+        "the error of a copy must be reported by the context");
+}  // end of testFailingOperations
