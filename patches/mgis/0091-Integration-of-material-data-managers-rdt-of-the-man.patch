From 557bac7e687f3a501722be3dc593610303ad65b0 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Mon, 9 Nov 2026 21:43:39 +0100
Subject: [PATCH] Integration of material data managers: rdt of the manager as
 initial time step scaling factor

Since 7060328 (M-033), the integrations of a material data manager start
each point and the result from MaterialDataManager::rdt, the bound set by
the solver on the time step increase factor proposed by the behaviour.
The integrations of the prototype go through a material data view, which
has no such member, and started from the default value of
BehaviourIntegrationResult (10), point by point and by batch.

The internal functions integrating a material data view take the initial
value of the time step scaling factor, 10 by default as before for the
views; the functions of the material data managers (integrate,
integrate_debug, batches, thread pools) pass m.rdt. Codes which never set
m.rdt get the same results, its default value being 10.
---
 src/Integrate.cxx | 55 ++++++++++++++++++++++++++++++-----------------
 1 file changed, 35 insertions(+), 20 deletions(-)

diff --git a/src/Integrate.cxx b/src/Integrate.cxx
index 6ee9524..99e3dcb 100644
--- a/src/Integrate.cxx
+++ b/src/Integrate.cxx
@@ -633,21 +633,22 @@ namespace mgis::behaviour::internals {
    * \brief integrate a behaviour generated by the `generic-parallel`
    * interface on the points `[b, e)` of a material data view.
    * \param[in] p: execution policy (synchronous or asynchronous)
+   * \param[in] rdt0: initial value of the time step scaling factor, as for
+   * the integration point by point (`rdt` member of a material data manager)
    */
   template <typename ExecutionPolicy>
-  static auto integrateBatch(const ExecutionPolicy& p,
-                             const MaterialDataView& v,
-                             const BehaviourIntegrationOptions& opts,
-                             const real dt,
-                             const size_type b,
-                             const size_type e) {
+  static auto integrateBatch(
+      const ExecutionPolicy& p,
+      const MaterialDataView& v,
+      const BehaviourIntegrationOptions& opts,
+      const real dt,
+      const size_type b,
+      const size_type e,
+      const real rdt0 = BehaviourIntegrationResult{}.time_step_increase_factor) {
     checkBatchComputations("integrate",
                            getBehaviour("integrate", v).batch_b != nullptr, v,
                            b, e);
     checkIntegrationOutputs("integrate", v, opts);
-    // same initial value of the time step scaling factor as the integration
-    // point by point
-    const auto rdt0 = BehaviourIntegrationResult{}.time_step_increase_factor;
     auto submit = [&v, &opts, dt, b, e, rdt0](BatchOutputStatus& o,
                                               const BatchExecutionOptions& x) {
       auto memory = TemporaryMemory{};
@@ -1066,6 +1067,8 @@ namespace mgis::behaviour::internals {
    * of a material data view.
    * \param[in] analyser: failure analyser, null for the standard
    * integration
+   * \param[in] rdt0: initial value of the time step scaling factor of each
+   * point and of the result (`rdt` member of a material data manager)
    */
   template <bool gather>
   static BehaviourIntegrationResult integratePointwise(
@@ -1077,10 +1080,11 @@ namespace mgis::behaviour::internals {
       const real dt,
       const size_type b,
       const size_type e,
-      const debug::BehaviourIntegrationFailureAnalyser* const analyser) {
+      const debug::BehaviourIntegrationFailureAnalyser* const analyser,
+      const real rdt0) {
     auto d = initializeBehaviourDataView(ws);
     auto r = BehaviourIntegrationResult{};
-    const auto rdt0 = r.time_step_increase_factor;
+    r.time_step_increase_factor = rdt0;
     const real Ke = encodeBehaviourIntegrationOptions(opts);
     real bopts[Behaviour::nopts + 1];  // option passed to the behaviour
     for (auto i = b; i != e; ++i) {
@@ -1155,6 +1159,8 @@ namespace mgis::behaviour::internals {
    * checked.
    * \param[in] analyser: failure analyser, null for the standard
    * integration
+   * \param[in] rdt0: initial value of the time step scaling factor (`rdt`
+   * member of a material data manager)
    */
   static BehaviourIntegrationResult integrateCheckedPointwise(
       BehaviourIntegrationWorkSpace& ws,
@@ -1163,7 +1169,8 @@ namespace mgis::behaviour::internals {
       const real dt,
       const size_type b,
       const size_type e,
-      const debug::BehaviourIntegrationFailureAnalyser* const analyser) {
+      const debug::BehaviourIntegrationFailureAnalyser* const analyser,
+      const real rdt0 = BehaviourIntegrationResult{}.time_step_increase_factor) {
     const auto* const f = analyser == nullptr ? "integrate" : "integrate_debug";
     checkWorkspace(f, ws, v);
     checkIntegrationPointsRange(v.n, b, e);
@@ -1174,10 +1181,10 @@ namespace mgis::behaviour::internals {
                       opts.compute_speed_of_sound);
     if (data.gathers) {
       return integratePointwise<true>(ws, v, data, evaluators, opts, dt, b, e,
-                                      analyser);
+                                      analyser, rdt0);
     }
     return integratePointwise<false>(ws, v, data, evaluators, opts, dt, b, e,
-                                     analyser);
+                                     analyser, rdt0);
   }  // end of integrateCheckedPointwise
 
   /*!
@@ -1185,6 +1192,8 @@ namespace mgis::behaviour::internals {
    * of a material data view.
    * \param[in] analyser: failure analyser, null for the standard
    * integration
+   * \param[in] rdt0: initial value of the time step scaling factor (`rdt`
+   * member of a material data manager)
    */
   static BehaviourIntegrationResult integratePointwise(
       BehaviourIntegrationWorkSpace& ws,
@@ -1193,9 +1202,10 @@ namespace mgis::behaviour::internals {
       const real dt,
       const size_type b,
       const size_type e,
-      const debug::BehaviourIntegrationFailureAnalyser* const analyser) {
+      const debug::BehaviourIntegrationFailureAnalyser* const analyser,
+      const real rdt0 = BehaviourIntegrationResult{}.time_step_increase_factor) {
     checkPointwiseIntegration(v, opts, analyser);
-    return integrateCheckedPointwise(ws, v, opts, dt, b, e, analyser);
+    return integrateCheckedPointwise(ws, v, opts, dt, b, e, analyser, rdt0);
   }  // end of integratePointwise
 
   /*!
@@ -2149,8 +2159,9 @@ namespace mgis::behaviour {
     internals::allocate(m, opts);
     auto memory = internals::TemporaryMemory{};
     const auto v = make_view(m, memory.get());
+    // the time step scaling factor starts from the bound set by the solver
     return internals::integratePointwise(m.getBehaviourIntegrationWorkSpace(),
-                                         v, opts, dt, b, e, nullptr);
+                                         v, opts, dt, b, e, nullptr, m.rdt);
   }  // end of integrate
 
   BehaviourIntegrationResult integrate(MaterialDataManager& m,
@@ -2202,7 +2213,8 @@ namespace mgis::behaviour {
     internals::allocate(m, opts);
     auto memory = internals::TemporaryMemory{};
     const auto v = make_view(m, memory.get());
-    return internals::integrateBatch(p, v, opts, dt, b, e);
+    // the time step scaling factor starts from the bound set by the solver
+    return internals::integrateBatch(p, v, opts, dt, b, e, m.rdt);
   }  // end of integrateOnBatch
 
   BehaviourIntegrationResult integrate(const BatchExecutionPolicy& p,
@@ -2247,8 +2259,9 @@ namespace mgis::behaviour {
     internals::allocate(m, opts);
     auto memory = internals::TemporaryMemory{};
     const auto v = make_view(m, memory.get());
+    // the time step scaling factor starts from the bound set by the solver
     return internals::integratePointwise(m.getBehaviourIntegrationWorkSpace(),
-                                         v, opts, dt, b, e, &analyser);
+                                         v, opts, dt, b, e, &analyser, m.rdt);
   }  // end of integrate_debug
 
   BehaviourIntegrationResult integrate_debug(
@@ -2296,9 +2309,11 @@ namespace mgis::behaviour {
     return executeOnThreadPool(
         p, m,
         [&m, &v, &opts, dt, analyser](const size_type b, const size_type e) {
+          // the time step scaling factor starts from the bound set by the
+          // solver
           return internals::integrateCheckedPointwise(
               m.getBehaviourIntegrationWorkSpace(), v, opts, dt, b, e,
-              analyser);
+              analyser, m.rdt);
         });
   }  // end of integratePointwise
 
