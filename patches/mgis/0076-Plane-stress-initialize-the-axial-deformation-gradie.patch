+/*!
+ * \brief initial value of the axial component of the deformation gradient
+ * computed by a behaviour written with the deformation gradient in plane
+ * stress: one, in the behaviour data and in the material data managers,
+ * with F and with H. The behaviours written in the Green-Lagrange and
+ * Hencky strain frameworks have no such variable.
+ */
+static void testAxialDeformationGradientInitialValue(const std::string& l) {
+  using namespace mgis::behaviour;
+  const auto h = Hypothesis::PLANESTRESS;
+  for (const auto g : {FiniteStrainBehaviourOptions::DEFORMATION_GRADIENT,
+                       FiniteStrainBehaviourOptions::DISPLACEMENT_GRADIENT}) {
+    auto o = FiniteStrainBehaviourOptions{};
+    o.gradient = g;
+    const auto test =
+        l + ", plane stress, " +
+        std::string(g == FiniteStrainBehaviourOptions::DEFORMATION_GRADIENT
+                        ? "F"
+                        : "H") +
+        ": ";
+    for (const auto* const b :
+         {"GreenLagrangeElasticity", "HenckyElasticity"}) {
+      check(!getAxialDeformationGradientOffset(load(o, l, b, h)).has_value(),
+            test + b + ": unexpected axial deformation gradient");
+    }
+    const auto b = load(o, l, "SaintVenantKirchhoffElasticity", h);
+    const auto offset = getAxialDeformationGradientOffset(b);
+    if (!check(offset.has_value(),
+               test + "SaintVenantKirchhoffElasticity: no axial "
+                      "deformation gradient")) {
+      continue;
+    }
+    // the Green-Lagrange strain is stored before the axial deformation
+    // gradient
+    check(*offset == 4,
+          test + "invalid offset of the axial deformation gradient");
+    const auto nisvs = getArraySize(b.isvs, h);
+    // checks that the axial deformation gradient is one and that the other
+    // internal state variables are zero, `value(i, c)` being the `c`-th
+    // internal state variable of the `i`-th of `n` points
+    const auto check_initial_values = [&](const auto& value,
+                                          const mgis::size_type n,
+                                          const std::string& where) {
+      auto ok = true;
+      for (mgis::size_type i = 0; i != n; ++i) {
+        for (mgis::size_type c = 0; c != nisvs; ++c) {
+          ok = ok && isEqual(value(i, c), c == *offset ? 1 : 0);
+        }
+      }
+      check(ok, test + "invalid initial values in " + where);
+    };
+    const auto d = BehaviourData{b};
+    for (const auto* const s : {&d.s0, &d.s1}) {
+      check_initial_values(
+          [s](mgis::size_type, const mgis::size_type c) {
+            return s->internal_state_variables[c];
+          },
+          1, "the behaviour data");
+    }
+    // material data managers allocating the internal state variables
+    const auto check_manager = [&](const MaterialDataManager& m,
+                                   const std::string& where) {
+      for (const auto* const s : {&m.s0, &m.s1}) {
+        check_initial_values(getInternalStateVariablesView(*s), m.n, where);
+      }
+    };
+    check_manager(MaterialDataManager{b, 3}, "the material data manager");
+    for (const auto layout : {mgis::FieldLayout::POINT_BY_POINT,
+                              mgis::FieldLayout::COMPONENT_BY_COMPONENT}) {
+      const auto where =
+          std::string{"the material data manager built from an initializer ("} +
+          (layout == mgis::FieldLayout::POINT_BY_POINT
+               ? "point by point)"
+               : "component by component)");
+      auto i = MaterialDataManagerInitializer{};
+      i.layout = layout;
+      check_manager(MaterialDataManager{b, 3, i}, where);
+      // the internal state variables given by the caller are not modified
+      auto isvs0 = std::vector<mgis::real>(3 * nisvs, mgis::real{2});
+      auto isvs1 = isvs0;
+      i.s0.internal_state_variables = isvs0;
+      i.s1.internal_state_variables = isvs1;
+      const auto m = MaterialDataManager{b, 3, i};
+      const auto unchanged = [](const std::vector<mgis::real>& v) {
+        return std::all_of(v.begin(), v.end(),
+                           [](const mgis::real x) { return isEqual(x, 2); });
+      };
+      check(unchanged(isvs0) && unchanged(isvs1),
+            test + "internal state variables given by the caller modified "
+                   "in " + where);
+    }
+  }
+}  // end of testAxialDeformationGradientInitialValue
