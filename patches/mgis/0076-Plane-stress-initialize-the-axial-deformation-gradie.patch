+  std::optional<size_type> getAxialDeformationGradientOffset(
+      const Behaviour &b) noexcept {
+    constexpr auto n = "AxialDeformationGradient";
+    if ((b.btype != Behaviour::STANDARDFINITESTRAINBEHAVIOUR) ||
+        (b.kinematic != Behaviour::FINITESTRAINKINEMATIC_F_CAUCHY) ||
+        ((b.hypothesis != Hypothesis::PLANESTRESS) &&
+         (b.hypothesis != Hypothesis::AXISYMMETRICALGENERALISEDPLANESTRESS)) ||
+        (!contains(b.isvs, n))) {
+      return {};
+    }
+    auto ctx = Context{};
+    return getVariableOffset(ctx, b.isvs, n, b.hypothesis);
+  }  // end of getAxialDeformationGradientOffset
