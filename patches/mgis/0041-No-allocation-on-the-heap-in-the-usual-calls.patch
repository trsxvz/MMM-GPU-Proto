diff --git a/tests/AllocationTest.cxx b/tests/AllocationTest.cxx
new file mode 100644
index 0000000..215779c
--- /dev/null
+++ b/tests/AllocationTest.cxx
@@ -0,0 +1,194 @@
+/*!
+ * \file   tests/AllocationTest.cxx
+ * \brief  This test counts the allocations on the heap performed by the
+ * usual functions of MGIS on a material data manager, on a material data
+ * view, and for the material properties: once the arrays are allocated, the
+ * synchronous functions shall not allocate memory on the heap in the
+ * calling thread.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <new>
+#include <span>
+#include <array>
+#include <cstdlib>
+#include <string>
+#include <vector>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+#include "MGIS/FieldView.hxx"
+#include "MGIS/FieldOperations.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/MaterialDataView.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+#include "MGIS/MaterialProperty/MaterialProperty.hxx"
+
+/*!
+ * \brief number of allocations performed by the global operator new in the
+ * calling thread. The threads of the backends (for instance the threads of
+ * the parallel algorithms of the standard library) are not taken into
+ * account.
+ */
+static thread_local std::size_t number_of_allocations = 0;
+
+void* operator new(const std::size_t s) {
+  ++number_of_allocations;
+  if (auto* const p = std::malloc(s == 0 ? 1 : s)) {
+    return p;
+  }
+  throw std::bad_alloc();
+}
+
+void* operator new[](const std::size_t s) { return ::operator new(s); }
+
+// the replaced operator new allocates with std::malloc
+#if defined(__GNUC__) && !defined(__clang__)
+#pragma GCC diagnostic ignored "-Wmismatched-new-delete"
+#endif
+
+void operator delete(void* const p) noexcept { std::free(p); }
+
+void operator delete[](void* const p) noexcept { std::free(p); }
+
+void operator delete(void* const p, const std::size_t) noexcept {
+  std::free(p);
+}
+
+void operator delete[](void* const p, const std::size_t) noexcept {
+  std::free(p);
+}
+
+static bool success = true;
+
+/*!
+ * \brief check that a function does not allocate memory on the heap. The
+ * function is called once before, so that the memory allocated once (for
+ * instance by the libraries loaded at the first call) is not counted.
+ * \param[in] name: name of the test
+ * \param[in] f: function
+ */
+template <typename Function>
+static void checkNoAllocation(const std::string_view name, const Function& f) {
+  f();
+  const auto n0 = number_of_allocations;
+  f();
+  const auto n = number_of_allocations - n0;
+  if (n != 0) {
+    success = false;
+    std::cerr << name << ": " << n << " allocations\n";
+  }
+}  // end of checkNoAllocation
+
+static void test(const std::string& library) {
+  using namespace mgis::behaviour;
+  using mgis::real;
+  constexpr auto n = mgis::size_type{10};
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  const auto gp = std::string{
+      isGenericParallelBehaviour(b) ? ", generic-parallel" : ", generic"};
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  for (const auto l : {mgis::FieldLayout::POINT_BY_POINT,
+                       mgis::FieldLayout::COMPONENT_BY_COMPONENT}) {
+    auto i = MaterialDataManagerInitializer{};
+    i.layout = l;
+    auto m = MaterialDataManager(b, n, i);
+    m.allocateArrayOfTangentOperatorBlocks();
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+    for (auto& e : m.s1.gradients) {
+      e = 1e-4;
+    }
+    checkNoAllocation("integrate" + gp,
+                      [&] { static_cast<void>(integrate(m, opts, 1)); });
+    checkNoAllocation("integrate, range" + gp,
+                      [&] { static_cast<void>(integrate(m, opts, 1, 2, 7)); });
+    checkNoAllocation("update" + gp, [&] { update(m); });
+    checkNoAllocation("revert" + gp, [&] { revert(m); });
+    auto v = make_view(m);
+    auto ws = BehaviourIntegrationWorkSpace(b);
+    checkNoAllocation("integrate on a view" + gp,
+                      [&] { static_cast<void>(integrate(ws, v, opts, 1)); });
+    auto ops = mgis::HostFieldOperations{};
+    checkNoAllocation("update of a view" + gp, [&] { update(v, ops); });
+    checkNoAllocation("revert of a view" + gp, [&] { revert(v, ops); });
+  }
+}
+
+static void testRotations(const std::string& library) {
+  using namespace mgis::behaviour;
+  using mgis::real;
+  constexpr auto n = mgis::size_type{10};
+  const auto b =
+      load(library, "OrthotropicElasticity", Hypothesis::TRIDIMENSIONAL);
+  const auto gp = std::string{
+      isGenericParallelBehaviour(b) ? ", generic-parallel" : ", generic"};
+  auto values = std::vector<real>(6 * n, 1);
+  auto rotated = std::vector<real>(6 * (n + 2));
+  const auto matrix = std::array<real, 9>{0, 1, 0, -1, 0, 0, 0, 0, 1};
+  checkNoAllocation("rotation of arrays" + gp, [&] {
+    rotateThermodynamicForces(std::span(rotated).first(6 * n), b, values,
+                              std::span<const real>(matrix));
+  });
+  checkNoAllocation("rotation of views" + gp, [&] {
+    rotateThermodynamicForces(
+        mgis::makeComponentByComponentFieldView(std::span(rotated), n, 6,
+                                                n + 2),
+        b,
+        mgis::makePointByPointFieldView(std::span<const real>(values), n, 6, 6),
+        mgis::makeUniformFieldView(std::span<const real>(matrix), n));
+  });
+}
+
+static void testMaterialProperty(const std::string& library) {
+  using namespace mgis::material_property;
+  using mgis::real;
+  const auto mp = load(library, "Inconel600_YoungModulus");
+  const auto gp =
+      std::string{isGenericParallelMaterialProperty(mp) ? ", generic-parallel"
+                                                        : ", generic"};
+  auto E = std::vector<real>(10);
+  const auto T = std::vector<real>(10, 500);
+  const auto inputs = std::array{std::span<const real>(T)};
+  checkNoAllocation("evaluate" + gp,
+                    [&] { static_cast<void>(evaluate(E, mp, inputs)); });
+  const auto views = std::array{mgis::makeFieldView(
+      std::span<const real>(T), mgis::FieldLayout::POINT_BY_POINT, 10, 1)};
+  checkNoAllocation("evaluate on views" + gp, [&] {
+    static_cast<void>(
+        evaluate(mgis::makeFieldView(std::span(E),
+                                     mgis::FieldLayout::POINT_BY_POINT, 10, 1),
+                 mp, views));
+  });
+}
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 5) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-library generic-library "
+                 "generic-parallel-material-properties-library "
+                 "material-properties-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    test(argv[2]);
+    test(argv[1]);
+    testRotations(argv[2]);
+    testRotations(argv[1]);
+    testMaterialProperty(argv[4]);
+    testMaterialProperty(argv[3]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}
