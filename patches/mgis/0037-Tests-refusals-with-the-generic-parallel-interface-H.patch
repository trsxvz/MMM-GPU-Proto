From e739e9accb568eef709a9d7c12e2bde7ba266b44 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 01:07:49 +0200
Subject: [PATCH] Tests: refusals with the generic-parallel interface, HDF5
 states

- refusals on views for a behaviour generated by the generic-parallel
  interface, with the synchronous and asynchronous policies: missing
  external state variable, uniform output, invalid number of components,
  inaccessible memory, invalid range; extraction in a view of invalid
  extents.
- HDF5: gradients and thermodynamic forces restored in another layout.
---
 tests/MaterialDataManagerLayoutTest.cxx | 15 +++++---
 tests/MaterialDataViewTest.cxx          | 46 +++++++++++++++++++++++++
 2 files changed, 57 insertions(+), 4 deletions(-)

diff --git a/tests/MaterialDataManagerLayoutTest.cxx b/tests/MaterialDataManagerLayoutTest.cxx
index ef765b7..43809d0 100644
--- a/tests/MaterialDataManagerLayoutTest.cxx
+++ b/tests/MaterialDataManagerLayoutTest.cxx
@@ -924,10 +924,13 @@ static void testHDF5(const std::string& library) {
     auto esvs = std::vector<std::vector<real>>{};
     esvs.reserve(2 * b.esvs.size());
     for (auto* const s : {&m->s1}) {
-      const auto isvs = getInternalStateVariablesView(*s);
-      for (size_type i = 0; i != n; ++i) {
-        for (size_type c = 0; c != isvs.getNumberOfComponents(); ++c) {
-          isvs(i, c) = static_cast<real>(100 * i + c);
+      for (const auto& v :
+           {getGradientsView(*s), getThermodynamicForcesView(*s),
+            getInternalStateVariablesView(*s)}) {
+        for (size_type i = 0; i != n; ++i) {
+          for (size_type c = 0; c != v.getNumberOfComponents(); ++c) {
+            v(i, c) = static_cast<real>(100 * i + c) + 0.5;
+          }
         }
       }
       for (const auto& v : b.esvs) {
@@ -961,6 +964,10 @@ static void testHDF5(const std::string& library) {
     check(same(getInternalStateVariablesView(m->s1),
                getInternalStateVariablesView(r->s1)),
           "HDF5: invalid internal state variables (" + g + ")");
+    check(same(getGradientsView(m->s1), getGradientsView(r->s1)) &&
+              same(getThermodynamicForcesView(m->s1),
+                   getThermodynamicForcesView(r->s1)),
+          "HDF5: invalid gradients or thermodynamic forces (" + g + ")");
     for (std::size_t k = 0; k != b.esvs.size(); ++k) {
       const auto nc = getVariableSize(b.esvs[k], h);
       check(same(mgis::makeFieldView(std::span<const real>(esvs[k]), l, n, nc),
diff --git a/tests/MaterialDataViewTest.cxx b/tests/MaterialDataViewTest.cxx
index 17051d5..dd939bd 100644
--- a/tests/MaterialDataViewTest.cxx
+++ b/tests/MaterialDataViewTest.cxx
@@ -925,6 +925,52 @@ static void testErrors(const std::string& library,
   auto gp_ws = BehaviourIntegrationWorkSpace(gp_b);
   check(integrate(gp_ws, d0.v, opts, 1).exit_status == 1,
         "errors: invalid status for an empty set");
+  // the same checks for a behaviour generated by the generic-parallel
+  // interface, with the policies
+  auto gd = ViewData(gp_b, n, Arrangement::PADDED_COMPONENT_BY_COMPONENT);
+  gd.copyFrom(MaterialDataManager(gp_b, n));
+  const auto sp = BatchExecutionPolicy{};
+  const auto ap = AsynchronousBatchExecutionPolicy{};
+  check(throws([&] { static_cast<void>(integrate(sp, gd.v, opts, 1)); },
+               "no value given for the external state variable 'Temperature'"),
+        "errors: missing external state variable not detected (policy)");
+  setExternalStateVariable(gd.v.s0, "Temperature", T);
+  setExternalStateVariable(gd.v.s1, "Temperature", T);
+  auto gcopy = gd.v;
+  gcopy.s1.thermodynamic_forces =
+      FieldView<real>(std::span<real>(gd.t1.values).subspan(0, 6), n, 6, 0, 1);
+  check(throws([&] { static_cast<void>(integrate(ap, gcopy, opts, 1)); },
+               "overlap"),
+        "errors: uniform output not detected (asynchronous policy)");
+  gcopy = gd.v;
+  gcopy.s0.internal_state_variables = getComponents(
+      gd.v.s0.internal_state_variables, 0,
+      gd.v.s0.internal_state_variables.getNumberOfComponents() - 1);
+  check(throws([&] { static_cast<void>(integrate(sp, gcopy, opts, 1)); },
+               "invalid number of components"),
+        "errors: invalid number of components not detected (policy)");
+  gcopy = gd.v;
+  gcopy.memory_location = mgis::MemoryLocation::DEVICE;
+  check(throws([&] { static_cast<void>(integrate(gp_ws, gcopy, opts, 1)); },
+               "not accessible by the computations"),
+        "errors: inaccessible memory not detected (generic-parallel)");
+  check(throws([&] { static_cast<void>(integrate(ap, gcopy, opts, 1)); },
+               "not accessible by the computations"),
+        "errors: inaccessible memory not detected (asynchronous policy)");
+  check(throws([&] { static_cast<void>(integrate(sp, gd.v, opts, 1, 3, 5)); },
+               "invalid upper bound"),
+        "errors: invalid range not detected (policy)");
+  // extraction in a view of invalid extents
+  auto ops = mgis::HostFieldOperations{};
+  auto o = std::vector<real>(5 * n);
+  check(throws(
+            [&] {
+              extractInternalStateVariable(
+                  mgis::makePointByPointFieldView(std::span(o), n, 5, 5),
+                  gd.v.s1, "ElasticStrain", ops);
+            },
+            "different extents"),
+        "errors: invalid extraction not detected");
 }  // end of testErrors
 
 //! \brief copies and fills of views in the memory of the host
