+  /*!
+   * \return true if the backend of a behaviour generated by the
+   * `generic-parallel` interface executes the computations on a device which
+   * can't access the memory of the host
+   * \param[in] b: behaviour
+   */
+  static bool isDeviceOnlyBackend(const Behaviour& b) noexcept {
+    return (b.backend == "cuda") || (b.backend == "hip");
+  }  // end of isDeviceOnlyBackend
+
+  /*!
+   * \return the field of a uniform value stored by the material data
+   * manager, in the memory of the host
+   * \param[in] m: material data manager
+   * \param[in] n: name of the variable
+   * \param[in] v: value
+   */
+  static ConstField makeUniformBatchField(const MaterialDataManager& m,
+                                          const std::string_view n,
+                                          const real& v) {
+    if (isDeviceOnlyBackend(m.b)) {
+      mgis::raise("makeUniformBatchField: the uniform value of '" +
+                  std::string{n} +
+                  "' is stored in the memory of the host, which is not "
+                  "accessible by the device of the backend '" +
+                  m.b.backend +
+                  "': this value must be given as a span on memory "
+                  "accessible by the device");
+    }
+    return {&v, 0, 1};
+  }  // end of makeUniformBatchField
+
+  /*!
+   * \return the field of a material property or of an external state
+   * variable on the points of a batch, starting at the point `b`. The values
+   * are either uniform or stored point by point.
+   * \param[in] m: material data manager
+   * \param[in] v: variable
+   * \param[in] fh: field holder
+   * \param[in] b: first point of the batch
+   */
+  static ConstField makeBatchField(const MaterialDataManager& m,
+                                   const Variable& v,
+                                   const MaterialStateManager::FieldHolder& fh,
+                                   const size_type b) {
+    if (v.type == Variable::ARRAY) {
+      mgis::raise("makeBatchField: the arrays of variables ('" + v.name +
+                  "') are not supported by the integration of a batch");
+    }
+    const auto s = getVariableSize(v, m.b.hypothesis);
+    const auto from_values = [&m, &v, s, b](const auto& values) -> ConstField {
+      if (values.size() == s) {
+        return {values.data(), 0, 1};
+      }
+      if (values.size() != m.n * s) {
+        mgis::raise("makeBatchField: invalid number of values for '" + v.name +
+                    "' (" + std::to_string(values.size()) + " given)");
+      }
+      return {values.data() + b * s, s, 1};
+    };
+    if (std::holds_alternative<std::monostate>(fh)) {
+      mgis::raise("makeBatchField: uninitialized field holder '" + v.name +
+                  "'");
+    }
+    if (std::holds_alternative<std::span<const real>>(fh)) {
+      return from_values(std::get<std::span<const real>>(fh));
+    }
+    const auto& mfh = std::get<MaterialStateManager::MutableFieldHolder>(fh);
+    if (std::holds_alternative<real>(mfh.value)) {
+      if (s != 1) {
+        mgis::raise("makeBatchField: invalid uniform value for '" + v.name +
+                    "'");
+      }
+      return makeUniformBatchField(m, v.name, std::get<real>(mfh.value));
+    }
+    if (std::holds_alternative<std::span<real>>(mfh.value)) {
+      return from_values(std::get<std::span<real>>(mfh.value));
+    }
+    return from_values(std::get<std::vector<real>>(mfh.value));
+  }  // end of makeBatchField
+
+  /*!
+   * \return the fields of a group of variables (material properties or
+   * external state variables), variable by variable
+   * \param[in] m: material data manager
+   * \param[in] variables: variables
+   * \param[in] values: field holders
+   * \param[in] b: first point of the batch
+   */
+  static std::vector<ConstField> makeBatchFields(
+      const MaterialDataManager& m,
+      const std::vector<Variable>& variables,
+      const std::map<std::string,
+                     MaterialStateManager::FieldHolder,
+                     std::less<>>& values,
+      const size_type b) {
+    auto fields = std::vector<ConstField>{};
+    fields.reserve(variables.size());
+    for (const auto& v : variables) {
+      const auto p = values.find(v.name);
+      if (p == values.end()) {
+        mgis::raise("makeBatchFields: no variable named '" + v.name +
+                    "' declared");
+      }
+      fields.push_back(makeBatchField(m, v, p->second, b));
+    }
+    return fields;
+  }  // end of makeBatchFields
+
+  //! \return the field of the mass density of a state
+  static ConstField makeMassDensityBatchField(const MaterialDataManager& m,
+                                              const MaterialStateManager& s,
+                                              const size_type b) {
+    if (!s.mass_density.has_value()) {
+      return {nullptr, 0, 0};
+    }
+    const auto& v = s.mass_density->value;
+    if (std::holds_alternative<real>(v)) {
+      return makeUniformBatchField(m, "mass density", std::get<real>(v));
+    }
+    const auto* const values = std::holds_alternative<std::span<real>>(v)
+                                   ? std::get<std::span<real>>(v).data()
+                                   : std::get<std::vector<real>>(v).data();
+    return {values + b, 1, 1};
+  }  // end of makeMassDensityBatchField
+
+  //! \return a field holding the values of an array, point by point
+  template <typename ValueType>
+  static auto makeArrayBatchField(const std::span<ValueType> values,
+                                  const size_type stride,
+                                  const size_type b) {
+    using Field = std::conditional_t<std::is_const_v<ValueType>, ConstField,
+                                     mgis::behaviour::Field>;
+    if (values.empty()) {
+      return Field{nullptr, 0, 0};
+    }
+    return Field{values.data() + b * stride, stride, 1};
+  }  // end of makeBatchField
+
+  /*!
+   * \brief integrate a behaviour generated by the `generic-parallel`
+   * interface on the points `[b, e)` of a material data manager.
+   */
+  static BehaviourIntegrationResult integrateBatch(
+      const BatchExecutionPolicy& p,
+      MaterialDataManager& m,
+      const BehaviourIntegrationOptions& opts,
+      const real dt,
+      const size_type b,
+      const size_type e) {
+    if (m.b.batch_b == nullptr) {
+      mgis::raise(
+          "integrate: the behaviour has not been generated by the "
+          "generic-parallel interface");
+    }
+    auto r = BehaviourIntegrationResult{};
+    if (b == e) {
+      return r;
+    }
+    // fields of the material properties and of the external state
+    // variables, variable by variable
+    const auto mps0 = makeBatchFields(m, m.b.mps, m.s0.material_properties, b);
+    const auto mps1 = makeBatchFields(m, m.b.mps, m.s1.material_properties, b);
+    const auto esvs0 =
+        makeBatchFields(m, m.b.esvs, m.s0.external_state_variables, b);
+    const auto esvs1 =
+        makeBatchFields(m, m.b.esvs, m.s1.external_state_variables, b);
+    auto d = BatchDataView{};
+    d.number_of_points = e - b;
+    d.dt = dt;
+    d.options[0] = encodeBehaviourIntegrationOptions(opts);
+    for (size_type i = 0; (i != m.b.options.size()) && (i != 2); ++i) {
+      d.options[i + 1] = m.b.options[i];
+    }
+    // same initial value of the time step scaling factor as the integration
+    // point by point
+    d.rdt = r.time_step_increase_factor;
+    if ((opts.integration_type !=
+         IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR) &&
+        (m.K_stride != 0)) {
+      d.tangent_operators = makeArrayBatchField(m.K, m.K_stride, b);
+    }
+    if (opts.compute_speed_of_sound) {
+      d.speed_of_sound = makeArrayBatchField(m.speed_of_sound, 1, b);
+    }
+    // state at the beginning of the time step
+    const auto& s0 = m.s0;
+    d.s0.gradients = makeArrayBatchField(std::span<const real>(s0.gradients),
+                                         s0.gradients_stride, b);
+    d.s0.thermodynamic_forces =
+        makeArrayBatchField(std::span<const real>(s0.thermodynamic_forces),
+                            s0.thermodynamic_forces_stride, b);
+    d.s0.mass_density = makeMassDensityBatchField(m, s0, b);
+    d.s0.internal_state_variables =
+        makeArrayBatchField(std::span<const real>(s0.internal_state_variables),
+                            s0.internal_state_variables_stride, b);
+    d.s0.stored_energy =
+        makeArrayBatchField(std::span<const real>(s0.stored_energies), 1, b);
+    d.s0.dissipated_energy = makeArrayBatchField(
+        std::span<const real>(s0.dissipated_energies), 1, b);
+    d.s0.material_properties_by_variable = mps0.data();
+    d.s0.external_state_variables_by_variable = esvs0.data();
+    // state at the end of the time step
+    auto& s1 = m.s1;
+    d.s1.gradients = makeArrayBatchField(std::span<const real>(s1.gradients),
+                                         s1.gradients_stride, b);
+    d.s1.thermodynamic_forces = makeArrayBatchField(
+        s1.thermodynamic_forces, s1.thermodynamic_forces_stride, b);
+    d.s1.mass_density = makeMassDensityBatchField(m, s1, b);
+    d.s1.internal_state_variables = makeArrayBatchField(
+        s1.internal_state_variables, s1.internal_state_variables_stride, b);
+    d.s1.stored_energy = makeArrayBatchField(s1.stored_energies, 1, b);
+    d.s1.dissipated_energy = makeArrayBatchField(s1.dissipated_energies, 1, b);
+    d.s1.material_properties_by_variable = mps1.data();
+    d.s1.external_state_variables_by_variable = esvs1.data();
+    // synchronous execution
+    d.execution.queue = p.queue;
+    d.execution.statistics = nullptr;
+    d.execution.preserve_stack_size = p.preserve_stack_size ? 1 : 0;
+    auto o = BatchOutputStatus{};
+    const auto status = m.b.batch_b(&o, &d);
+    if ((status == -2) || (status == -3)) {
+      // invalid arguments or error of the backend, which must not be taken
+      // for a failure of the integration
+      o.msg[sizeof(o.msg) - 1] = '\0';
+      mgis::raise("integrate: " + std::string{o.msg});
+    }
+    r.exit_status = status;
+    r.time_step_increase_factor = o.rdt;
+    if (status == -1) {
+      r.n = b + o.first_failure_index;
+      o.msg[sizeof(o.msg) - 1] = '\0';
+      r.error_message = std::string{o.msg};
+    }
+    return r;
+  }  // end of integrateBatch
+
   /*!
    * \brief execute the given initialize function over a range of integration
    * points.
@@ -375,6 +616,11 @@ namespace mgis::behaviour::internals {
       const real dt,
       const size_type b,
       const size_type e) {
+    if (m.b.b == nullptr) {
+      mgis::raise(
+          "integrate: no integration function of a point (the behaviour "
+          "has been generated by the generic-parallel interface)");
+    }
     // workspace
     auto& ws = m.getBehaviourIntegrationWorkSpace();
     auto v = internals::initializeBehaviourDataView(ws);
@@ -425,6 +671,12 @@ namespace mgis::behaviour::internals {
       const size_type b,
       const size_type e,
       const debug::BehaviourIntegrationFailureAnalyser& analyser) {
+    if (m.b.b == nullptr) {
+      mgis::raise(
+          "integrate_debug: not available for the behaviours generated by "
+          "the generic-parallel interface (the generic interface of the same "
+          "behaviour may be used to analyse a failure)");
+    }
     // workspace
     auto& ws = m.getBehaviourIntegrationWorkSpace();
     auto v = internals::initializeBehaviourDataView(ws);
@@ -718,10 +970,32 @@ namespace mgis::behaviour {
   BehaviourIntegrationResult integrate(MaterialDataManager& m,
                                        const BehaviourIntegrationOptions& opts,
                                        const real dt) {
+    if (isGenericParallelBehaviour(m.b)) {
+      return integrate(m.batch_execution_policy, m, opts, dt);
+    }
     internals::allocate(m, opts);
     return internals::integrate(m, opts, dt, 0, m.n);
   }  // end of integrate
 
+  BehaviourIntegrationResult integrate(const BatchExecutionPolicy& p,
+                                       MaterialDataManager& m,
+                                       const BehaviourIntegrationOptions& opts,
+                                       const real dt) {
+    internals::allocate(m, opts);
+    return internals::integrateBatch(p, m, opts, dt, 0, m.n);
+  }  // end of integrate
+
+  BehaviourIntegrationResult integrate(const BatchExecutionPolicy& p,
+                                       MaterialDataManager& m,
+                                       const BehaviourIntegrationOptions& opts,
+                                       const real dt,
+                                       const size_type b,
+                                       const size_type e) {
+    internals::allocate(m, opts);
+    internals::checkIntegrationPointsRange(m, b, e);
+    return internals::integrateBatch(p, m, opts, dt, b, e);
+  }  // end of integrate
+
   BehaviourIntegrationResult integrate_debug(
       MaterialDataManager& m,
       const BehaviourIntegrationOptions& opts,
@@ -744,6 +1018,9 @@ namespace mgis::behaviour {
                                        const real dt,
                                        const size_type b,
                                        const size_type e) {
+    if (isGenericParallelBehaviour(m.b)) {
+      return integrate(m.batch_execution_policy, m, opts, dt, b, e);
+    }
     internals::allocate(m, opts);
     internals::checkIntegrationPointsRange(m, b, e);
     return internals::integrate(m, opts, dt, b, e);
@@ -776,6 +1053,14 @@ namespace mgis::behaviour {
       MaterialDataManager& m,
       const BehaviourIntegrationOptions& opts,
       const real dt) {
+    if (isGenericParallelBehaviour(m.b)) {
+      // the parallelism is the one of the backend of the behaviour
+      auto res = MultiThreadedBehaviourIntegrationResult{};
+      const auto r = integrate(m.batch_execution_policy, m, opts, dt);
+      res.exit_status = r.exit_status;
+      res.results.push_back(r);
+      return res;
+    }
     m.setThreadSafe(true);
     internals::allocate(m, opts);
     // get number of threads
diff --git a/src/LibrariesManager.cxx b/src/LibrariesManager.cxx
index 1606ecd..5aa8b07 100644
--- a/src/LibrariesManager.cxx
+++ b/src/LibrariesManager.cxx
@@ -64,7 +64,11 @@ namespace mgis {
 #if (defined _WIN32 || defined _WIN64) && (!defined __CYGWIN__)
     return ::LoadLibrary(TEXT(l.c_str()));
 #else
-    return ::dlopen(l.c_str(), RTLD_NOW);
+    // the libraries are never unloaded: a library may use threads which are
+    // still alive when the libraries are closed at the end of the process,
+    // for instance the threads of TBB, used by the parallel algorithms of
+    // the C++ standard library (generic-parallel interface)
+    return ::dlopen(l.c_str(), RTLD_NOW | RTLD_NODELETE);
 #endif /* (defined _WIN32 || defined _WIN64) && (!defined __CYGWIN__) */
   }    // end of load_library
 
