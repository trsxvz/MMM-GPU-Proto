+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_BEHAVIOUR_BATCHEXECUTIONPOLICY_HXX
+#define LIB_MGIS_BEHAVIOUR_BATCHEXECUTIONPOLICY_HXX
+
+namespace mgis::behaviour {
+
+  /*!
+   * \brief execution of the computations on a batch of integration points,
+   * for the behaviours generated by the `generic-parallel` interface of
+   * `MFront`. The location of the data is a property of the data, not of
+   * the execution.
+   */
+  struct BatchExecutionPolicy {
+    /*!
+     * \brief queue on which the computations are submitted. Its meaning
+     * depends on the backend of the behaviour (`cudaStream_t` or
+     * `hipStream_t`, pointer to a `sycl::queue` or to an instance of a
+     * Kokkos execution space). A null pointer denotes the default queue, if
+     * meaningful for the backend.
+     */
+    void* queue = nullptr;
+    /*!
+     * \brief if true, the stack size of the threads of the device is never
+     * modified and an error is reported if it is too small
+     */
+    bool preserve_stack_size = false;
+  };
+
+}  // end of namespace mgis::behaviour
+
+#endif /* LIB_MGIS_BEHAVIOUR_BATCHEXECUTIONPOLICY_HXX */
