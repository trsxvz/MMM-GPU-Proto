new file mode 100644
index 0000000..d34c460
--- /dev/null
+++ b/include/MGIS/Behaviour/BatchExecutionPolicy.hxx
@@ -0,0 +1,42 @@
+/*!
+ * \file   include/MGIS/Behaviour/BatchExecutionPolicy.hxx
+ * \brief  This file declares the `BatchExecutionPolicy` structure.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
