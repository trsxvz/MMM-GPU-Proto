   # Tests that depend on behaviour libraries
   add_library_test_with_tfel_version(LoadMaterialPropertyTest LoadMaterialPropertyTest.cxx MaterialPropertyTest)
diff --git a/tests/GenericParallelIntegrateTest.cxx b/tests/GenericParallelIntegrateTest.cxx
new file mode 100644
index 0000000..7ca7333
--- /dev/null
+++ b/tests/GenericParallelIntegrateTest.cxx
@@ -0,0 +1,265 @@
+/*!
+ * \file   tests/GenericParallelIntegrateTest.cxx
+ * \brief  This test compares the integration of behaviours generated by the
+ * `generic-parallel` interface of `MFront` on batches of integration points
+ * with the integration point by point of the same behaviours generated by the
+ * `generic` interface, on identical states.
+ * \date   09/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <cmath>
+#include <span>
+#include <string>
+#include <vector>
+#include <cstdlib>
+#include <iostream>
+#include <algorithm>
+#include <string_view>
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+//! \return the maximum of the differences relative to the given scale
+static double compare(const std::span<const mgis::real> a,
+                      const std::span<const mgis::real> b,
+                      const double scale) {
+  auto d = 0.;
+  for (std::size_t i = 0; i != a.size(); ++i) {
+    d = std::max(d, std::abs(a[i] - b[i]) / scale);
+  }
+  return d;
+}  // end of compare
+
+//! \brief data managers of the same behaviour, point by point and as a batch
+struct Managers {
+  Managers(const std::string& library,
+           const std::string& gp_library,
+           const std::string& behaviour,
+           const mgis::size_type n)
+      : b(mgis::behaviour::load(
+            library, behaviour, mgis::behaviour::Hypothesis::TRIDIMENSIONAL)),
+        gp_b(
+            mgis::behaviour::load(gp_library,
+                                  behaviour,
+                                  mgis::behaviour::Hypothesis::TRIDIMENSIONAL)),
+        m(b, n),
+        gp_m(gp_b, n) {}
+  //! \brief apply the given function to both managers
+  template <typename Function>
+  void apply(const Function& f) {
+    f(this->m);
+    f(this->gp_m);
+  }
+  /*!
+   * \brief integrate the behaviour with both managers and compare the
+   * results
+   * \param[in] name: name of the test
+   * \param[in] opts: integration options
+   * \param[in] dt: time increment
+   * \param[in] range: range of integration points, all the points if empty
+   */
+  void integrate(const std::string& name,
+                 const mgis::behaviour::BehaviourIntegrationOptions& opts,
+                 const mgis::real dt,
+                 const std::vector<mgis::size_type>& range = {}) {
+    using namespace mgis::behaviour;
+    auto r = BehaviourIntegrationResult{};
+    auto gp_r = BehaviourIntegrationResult{};
+    if (range.empty()) {
+      r = mgis::behaviour::integrate(this->m, opts, dt);
+      // automatic switch to the integration of a batch
+      gp_r = mgis::behaviour::integrate(this->gp_m, opts, dt);
+    } else {
+      r = mgis::behaviour::integrate(this->m, opts, dt, range[0], range[1]);
+      gp_r =
+          mgis::behaviour::integrate(this->gp_m, opts, dt, range[0], range[1]);
+    }
+    check(r.exit_status == gp_r.exit_status, name + ": invalid status");
+    if (r.exit_status == -1) {
+      // the integration point by point stops at the first failure
+      check(r.n == gp_r.n, name + ": invalid index of the first failure");
+      return;
+    }
+    check(std::abs(r.time_step_increase_factor -
+                   gp_r.time_step_increase_factor) < 1e-12,
+          name + ": invalid time step increase factor");
+    constexpr auto eps = 1e-10;
+    check(compare(this->m.s1.thermodynamic_forces,
+                  this->gp_m.s1.thermodynamic_forces, 1e8) < eps,
+          name + ": invalid thermodynamic forces");
+    check(compare(this->m.s1.internal_state_variables,
+                  this->gp_m.s1.internal_state_variables, 1) < eps,
+          name + ": invalid internal state variables");
+    if (opts.integration_type !=
+        IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR) {
+      check(compare(this->m.K, this->gp_m.K, 1e10) < eps,
+            name + ": invalid tangent operators");
+    }
+  }
+  //! \brief behaviour of the generic interface
+  const mgis::behaviour::Behaviour b;
+  //! \brief behaviour of the generic-parallel interface
+  const mgis::behaviour::Behaviour gp_b;
+  //! \brief data manager associated with the behaviour of a point
+  mgis::behaviour::MaterialDataManager m;
+  //! \brief data manager associated with the batch behaviour
+  mgis::behaviour::MaterialDataManager gp_m;
+};
+
+//! \brief viscoplastic behaviour, uniform temperature, several time steps
+static void testNorton(const std::string& library,
+                       const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{100};
+  auto managers = Managers(library, gp_library, "Norton", n);
+  managers.apply([](MaterialDataManager& m) {
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+  });
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  for (int step = 0; step != 20; ++step) {
+    managers.apply([](MaterialDataManager& m) {
+      // the strain increment depends on the point
+      for (mgis::size_type i = 0; i != m.n; ++i) {
+        m.s1.gradients[i * m.s1.gradients_stride] +=
+            5e-5 * (1 + static_cast<double>(i) / m.n);
+      }
+    });
+    managers.integrate("Norton, step " + std::to_string(step), opts, 180);
+    managers.apply([](MaterialDataManager& m) { update(m); });
+  }
+}  // end of testNorton
+
+/*!
+ * \brief plastic behaviour, temperature given point by point, integration
+ * of a range of points
+ */
+static void testPlasticity(const std::string& library,
+                           const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{64};
+  auto managers = Managers(library, gp_library, "Plasticity", n);
+  auto temperatures = std::vector<mgis::real>(n);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    temperatures[i] = 293.15 + 10 * static_cast<double>(i);
+  }
+  managers.apply([&temperatures](MaterialDataManager& m) {
+    setExternalStateVariable(m.s0, "Temperature", temperatures,
+                             MaterialStateManager::EXTERNAL_STORAGE);
+    setExternalStateVariable(m.s1, "Temperature", temperatures,
+                             MaterialStateManager::EXTERNAL_STORAGE);
+    // elastic and plastic points
+    for (mgis::size_type i = 0; i != m.n; ++i) {
+      const auto e = 4e-3 * static_cast<double>(i) / m.n;
+      m.s1.gradients[i * m.s1.gradients_stride] = e;
+      m.s1.gradients[i * m.s1.gradients_stride + 1] = -0.3 * e;
+      m.s1.gradients[i * m.s1.gradients_stride + 2] = -0.3 * e;
+    }
+  });
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  managers.integrate("Plasticity", opts, 1);
+  managers.integrate("Plasticity, range", opts, 1, {10, 50});
+  opts.integration_type = IntegrationType::PREDICTION_ELASTIC_OPERATOR;
+  managers.integrate("Plasticity, prediction", opts, 1);
+}  // end of testPlasticity
+
+/*!
+ * \brief elastic behaviour: material property given point by point (Young
+ * modulus) and uniform material property (Poisson ratio), integration of a
+ * range of points
+ */
+static void testElasticity(const std::string& library,
+                           const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{32};
+  auto managers = Managers(library, gp_library, "Elasticity", n);
+  auto young = std::vector<mgis::real>(n);
+  for (mgis::size_type i = 0; i != n; ++i) {
+    young[i] = 150e9 + 1e9 * static_cast<double>(i);
+  }
+  managers.apply([&young](MaterialDataManager& m) {
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMaterialProperty(*s, "YoungModulus", young,
+                          MaterialStateManager::EXTERNAL_STORAGE);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    for (mgis::size_type i = 0; i != m.n; ++i) {
+      m.s1.gradients[i * m.s1.gradients_stride] = 1e-3;
+    }
+  });
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  managers.integrate("Elasticity", opts, 1);
+  managers.apply([](MaterialDataManager& m) {
+    for (mgis::size_type i = 0; i != m.n; ++i) {
+      m.s1.gradients[i * m.s1.gradients_stride] = 2e-3;
+    }
+  });
+  managers.integrate("Elasticity, range", opts, 1, {5, 20});
+}  // end of testElasticity
+
+//! \brief failure at all points
+static void testFailure(const std::string& library,
+                        const std::string& gp_library) {
+  using namespace mgis::behaviour;
+  auto managers = Managers(library, gp_library, "NortonFailure", 10);
+  managers.apply([](MaterialDataManager& m) {
+    setExternalStateVariable(m.s0, "Temperature", 293.15);
+    setExternalStateVariable(m.s1, "Temperature", 293.15);
+  });
+  auto opts = BehaviourIntegrationOptions{};
+  managers.integrate("NortonFailure", opts, 1);
+  managers.integrate("NortonFailure, range", opts, 1, {3, 7});
+  // the debugging functions are not available for batches
+  auto& gp_m = managers.gp_m;
+  check(
+      [&gp_m, &opts] {
+        try {
+          static_cast<void>(integrate_debug(gp_m, opts, 1));
+        } catch (...) {
+          return true;
+        }
+        return false;
+      }(),
+      "integrate_debug must be refused for batch behaviours");
+}  // end of testFailure
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-library generic-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    testNorton(argv[2], argv[1]);
+    testPlasticity(argv[2], argv[1]);
+    testElasticity(argv[2], argv[1]);
+    testFailure(argv[2], argv[1]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
