+    COMMAND GenericParallelIntegrateTest
+    "$<TARGET_FILE:GenericParallelBehaviourTest>"
+    "$<TARGET_FILE:BehaviourTest>")
+  add_dependencies(build-tests GenericParallelIntegrateTest)
+  set_property(TEST GenericParallelIntegrateTest
+    PROPERTY DEPENDS GenericParallelBehaviourTest BehaviourTest)
