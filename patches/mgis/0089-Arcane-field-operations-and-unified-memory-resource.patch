diff --git a/include/MGIS/FieldOperations/ArcaneFieldOperations.hxx b/include/MGIS/FieldOperations/ArcaneFieldOperations.hxx
new file mode 100644
index 0000000..dab7446
--- /dev/null
+++ b/include/MGIS/FieldOperations/ArcaneFieldOperations.hxx
@@ -0,0 +1,164 @@
+/*!
+ * \file   include/MGIS/FieldOperations/ArcaneFieldOperations.hxx
+ * \brief  This file declares the `ArcaneFieldOperations` class, which copies
+ * and fills views with a queue of the accelerator API of Arccore.
+ * \date   23/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_ARCANEFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_ARCANEFIELDOPERATIONS_HXX
+
+#include <algorithm>
+#include <arccore/base/MemoryView.h>
+#include <arccore/common/MemoryUtils.h>
+#include <arccore/common/accelerator/RunQueue.h>
+#include <arccore/accelerator/RunCommandLoop.h>
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis::field_operations::internals {
+
+  /*!
+   * \brief launch the commands applying a function at the points `[0, n[`
+   * on a queue. The loops of Arccore have 32 bits indices, and the kernels
+   * of Arccore compute the index of a thread on 32 bits: the ranges are
+   * split in commands of at most `2^30` points, so that the index of a
+   * thread of the grid of a command never overflows.
+   * \param[in] q: queue
+   * \param[in] n: number of points
+   * \param[in] f: function taking the index of a point, copied by the
+   * commands
+   */
+  template <typename Function>
+  void arcaneLaunch(const Arcane::Accelerator::RunQueue& q,
+                    const size_type n,
+                    const Function& f) {
+    using Arcane::Int32;
+    using Arcane::Int64;
+    constexpr auto chunk = Int64{1} << 30;
+    const auto size = static_cast<Int64>(n);
+    for (auto offset = Int64{}; offset < size; offset += chunk) {
+      const auto m = static_cast<Int32>(std::min(chunk, size - offset));
+      auto command = Arcane::Accelerator::makeCommand(q);
+      command << RUNCOMMAND_LOOP1(iter, m) {
+        auto [i] = iter();
+        f(static_cast<size_type>(offset + i));
+      };
+    }
+  }  // end of arcaneLaunch
+
+  /*!
+   * \brief copy the values of a view in another one. Each iteration
+   * processes one point: consecutive iterations process consecutive points
+   * of a component.
+   * \param[in] q: queue
+   * \param[out] dv: first value of the destination
+   * \param[in] dps: stride between two points of the destination
+   * \param[in] dcs: stride between two components of the destination
+   * \param[in] sv: first value of the source
+   * \param[in] sps: stride between two points of the source
+   * \param[in] scs: stride between two components of the source
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   */
+  inline void arcaneCopyFieldView(const Arcane::Accelerator::RunQueue& q,
+                                  real* const dv,
+                                  const size_type dps,
+                                  const size_type dcs,
+                                  const real* const sv,
+                                  const size_type sps,
+                                  const size_type scs,
+                                  const size_type n,
+                                  const size_type nc) {
+    arcaneLaunch(q, n, [=] ARCCORE_HOST_DEVICE(const size_type i) {
+      for (size_type j = 0; j < nc; ++j) {
+        dv[i * dps + j * dcs] = sv[i * sps + j * scs];
+      }
+    });
+  }  // end of arcaneCopyFieldView
+
+  /*!
+   * \brief fill a view (see `arcaneCopyFieldView`)
+   * \param[in] q: queue
+   * \param[out] dv: first value of the view
+   * \param[in] ps: stride between two points
+   * \param[in] cs: stride between two components
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   * \param[in] v: value
+   */
+  inline void arcaneFillFieldView(const Arcane::Accelerator::RunQueue& q,
+                                  real* const dv,
+                                  const size_type ps,
+                                  const size_type cs,
+                                  const size_type n,
+                                  const size_type nc,
+                                  const real v) {
+    arcaneLaunch(q, n, [=] ARCCORE_HOST_DEVICE(const size_type i) {
+      for (size_type j = 0; j < nc; ++j) {
+        dv[i * ps + j * cs] = v;
+      }
+    });
+  }  // end of arcaneFillFieldView
+
+}  // end of namespace mgis::field_operations::internals
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in memory accessible by the
+   * device of a queue of the accelerator API of Arccore, the core component
+   * of the Arcane framework (`CUDA`, `HIP`, `Thread` or `Sequential`
+   * queue).
+   *
+   * The operations are launched on the queue: if the queue is asynchronous,
+   * the calling code must wait for the queue (`barrier`) before reading the
+   * values on the host. A copy between two views with the same dense layout
+   * is a copy of a contiguous memory region by Arccore; the other copies,
+   * and the fills, use a command of Arccore. This is the counterpart of the
+   * `arcane` backend of the `generic-parallel` interface of `MFront`,
+   * compiled with the same compiler and the same options (`clang` as a CUDA
+   * compiler if Arccore is built with CUDA).
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with its installation of Arccore.
+   */
+  struct ArcaneFieldOperations final : FieldOperations {
+    //! \param[in] q: queue (reference semantics: the queue is shared)
+    explicit ArcaneFieldOperations(const Arcane::Accelerator::RunQueue& q)
+        : queue(q) {}
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nc = d.getNumberOfComponents();
+      if (haveSameDenseLayout(d, s)) {
+        const auto size = static_cast<Arcane::Int64>(n * nc);
+        Arcane::MemoryUtils::copy(
+            Arcane::makeMutableMemoryView(d.data(), sizeof(real), size),
+            Arcane::makeConstMemoryView(s.data(), sizeof(real), size),
+            &(this->queue));
+        return;
+      }
+      internals::arcaneCopyFieldView(
+          this->queue, d.data(), d.getPointStride(), d.getComponentStride(),
+          s.data(), s.getPointStride(), s.getComponentStride(), n, nc);
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      internals::arcaneFillFieldView(
+          this->queue, d.data(), d.getPointStride(), d.getComponentStride(),
+          d.getNumberOfPoints(), d.getNumberOfComponents(), v);
+    }  // end of do_fill
+    //! \brief queue on which the operations are launched
+    Arcane::Accelerator::RunQueue queue;
+  };  // end of ArcaneFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_ARCANEFIELDOPERATIONS_HXX */
diff --git a/include/MGIS/MemoryResources/ArcaneUnifiedMemoryResource.hxx b/include/MGIS/MemoryResources/ArcaneUnifiedMemoryResource.hxx
new file mode 100644
index 0000000..75988b0
--- /dev/null
+++ b/include/MGIS/MemoryResources/ArcaneUnifiedMemoryResource.hxx
@@ -0,0 +1,108 @@
+/*!
+ * \file   include/MGIS/MemoryResources/ArcaneUnifiedMemoryResource.hxx
+ * \brief  This file declares the `ArcaneUnifiedMemoryResource` class, which
+ * allocates the unified memory of Arccore.
+ * \date   23/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_MEMORYRESOURCES_ARCANEUNIFIEDMEMORYRESOURCE_HXX
+#define LIB_MGIS_MEMORYRESOURCES_ARCANEUNIFIEDMEMORYRESOURCE_HXX
+
+#include <new>
+#include <cstddef>
+#include <memory_resource>
+#include <arccore/common/MemoryUtils.h>
+#include <arccore/common/IMemoryAllocator.h>
+#include <arccore/common/AllocatedMemoryInfo.h>
+#include <arccore/common/MemoryAllocationArgs.h>
+#include "MGIS/MemoryResources/OverAlignedAllocation.hxx"
+
+namespace mgis::memory_resources {
+
+  /*!
+   * \brief memory resource allocating memory with an allocator of Arccore,
+   * the core component of the Arcane framework. By default, the allocator
+   * of the unified memory, accessible by the host and by the devices
+   * whatever the queue (shared location of the arrays of a material data
+   * manager). If no accelerator runtime is initialized, Arccore returns the
+   * allocator of the host. An alignment stricter than the one guaranteed by
+   * the allocator, requested for instance by the pools of the standard
+   * library, is obtained by over-allocation (see
+   * `internals::allocateOverAligned`). A failed allocation throws
+   * `std::bad_alloc`; a failed deallocation is ignored, as by the other
+   * memory resources.
+   *
+   * The accelerator runtime of Arccore must be initialized before the
+   * construction of the default memory resource.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code, with its own installation of Arccore.
+   */
+  struct ArcaneUnifiedMemoryResource final : std::pmr::memory_resource {
+    /*!
+     * \param[in] a: allocator of Arccore (by default, the allocator of the
+     * unified memory)
+     */
+    explicit ArcaneUnifiedMemoryResource(
+        Arcane::IMemoryAllocator* const a = Arcane::MemoryUtils::getAllocator(
+            Arcane::eMemoryResource::UnifiedMemory))
+        : allocator(a) {}
+
+   private:
+    //! \return the alignment guaranteed by the allocator
+    std::size_t getGuaranteedAlignment() const {
+      return this->allocator->guaranteedAlignment(
+          Arcane::MemoryAllocationArgs{});
+    }
+    void* do_allocate(const std::size_t s, const std::size_t a) override {
+      return internals::allocateOverAligned(
+          s, a, this->getGuaranteedAlignment(), [this](const std::size_t n) {
+            auto m = Arcane::AllocatedMemoryInfo{};
+            try {
+              m = this->allocator->allocate(Arcane::MemoryAllocationArgs{},
+                                            static_cast<Arcane::Int64>(n));
+            } catch (...) {
+              // Arccore reports the errors of the runtime by exceptions
+              throw std::bad_alloc{};
+            }
+            if (m.baseAddress() == nullptr) {
+              throw std::bad_alloc{};
+            }
+            return m.baseAddress();
+          });
+    }
+    void do_deallocate(void* const p,
+                       const std::size_t s,
+                       const std::size_t a) override {
+      // the allocators of Arccore take the size of the allocated block
+      const auto g = this->getGuaranteedAlignment();
+      const auto n = internals::getOverAlignedAllocationSize(s, a, g);
+      internals::deallocateOverAligned(p, a, g, [this, n](void* const b) {
+        // called by destructors: the errors of the runtime are ignored
+        try {
+          this->allocator->deallocate(
+              Arcane::MemoryAllocationArgs{},
+              Arcane::AllocatedMemoryInfo(b, static_cast<Arcane::Int64>(n)));
+        } catch (...) {
+        }
+      });
+    }
+    bool do_is_equal(
+        const std::pmr::memory_resource& r) const noexcept override {
+      const auto* const o =
+          dynamic_cast<const ArcaneUnifiedMemoryResource*>(&r);
+      return (o != nullptr) && (o->allocator == this->allocator);
+    }
+    //! \brief allocator of Arccore
+    Arcane::IMemoryAllocator* allocator;
+  };
+
+}  // end of namespace mgis::memory_resources
+
+#endif /* LIB_MGIS_MEMORYRESOURCES_ARCANEUNIFIEDMEMORYRESOURCE_HXX */
diff --git a/include/MGIS/MemoryResources/OverAlignedAllocation.hxx b/include/MGIS/MemoryResources/OverAlignedAllocation.hxx
index 57a8816..aba3fe7 100644
--- a/include/MGIS/MemoryResources/OverAlignedAllocation.hxx
+++ b/include/MGIS/MemoryResources/OverAlignedAllocation.hxx
@@ -23,6 +23,23 @@
 
 namespace mgis::memory_resources::internals {
 
+  /*!
+   * \return the number of bytes of the block allocated by
+   * `allocateOverAligned`, required by the deallocation functions which
+   * take the size of the block (see `ArcaneUnifiedMemoryResource`)
+   * \param[in] s: size in bytes
+   * \param[in] a: alignment, a power of two
+   * \param[in] g: alignment guaranteed by the allocation function
+   */
+  constexpr std::size_t getOverAlignedAllocationSize(
+      const std::size_t s, const std::size_t a, const std::size_t g) noexcept {
+    if (a <= g) {
+      return s == 0 ? 1 : s;
+    }
+    // room for the address of the allocated block and for the alignment
+    return s + a + sizeof(void*);
+  }  // end of getOverAlignedAllocationSize
+
   /*!
    * \brief allocate memory with the given alignment.
    *
@@ -52,14 +69,14 @@ namespace mgis::memory_resources::internals {
                             const std::size_t g,
                             const AllocationFunction& allocate) {
     if (a <= g) {
-      return allocate(s == 0 ? 1 : s);
+      return allocate(getOverAlignedAllocationSize(s, a, g));
     }
     // room for the address of the allocated block and for the alignment
     const auto extra = a + sizeof(void*);
     if (s > std::numeric_limits<std::size_t>::max() - extra) {
       throw std::bad_alloc();
     }
-    void* const b = allocate(s + extra);
+    void* const b = allocate(getOverAlignedAllocationSize(s, a, g));
     const auto ab = reinterpret_cast<std::uintptr_t>(b);
     const auto ap = (ab + sizeof(void*) + a - 1) & ~(std::uintptr_t{a} - 1);
     auto* const p = reinterpret_cast<std::byte*>(ap);
