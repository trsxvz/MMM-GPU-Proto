+  void allocateArray(std::pmr::vector<real>& values,
+                     const FieldLayout l,
+                     const size_type n,
+                     const size_type nc,
+                     const size_type p) {
+    constexpr auto zero = real{0};
+    if (p == 0) {
+      values.assign(n * nc, zero);
+      return;
+    }
+    values.assign(getFieldArraySize(l, n, nc, p),
+                  std::numeric_limits<real>::quiet_NaN());
+    const auto v = makeFieldView(std::span<real>(values), l, n, nc, p);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        v(i, j) = zero;
+      }
+    }
+  }  // end of allocateArray
+
