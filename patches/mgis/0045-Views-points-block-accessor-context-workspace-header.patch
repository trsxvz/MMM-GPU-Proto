+  template <typename ValueType>
+  constexpr FieldView<ValueType> getPoints(const FieldView<ValueType>& v,
+                                           const size_type b,
+                                           const size_type n) {
+    if ((b > v.getNumberOfPoints()) || (n > v.getNumberOfPoints() - b)) {
+      internals::reportFieldViewContractViolation(
+          "getPoints: invalid range of points");
+    }
+    if ((n == 0) || (v.getNumberOfComponents() == 0)) {
+      // no value: only the extents and the strides are kept
+      return FieldView<ValueType>(no_precondition_check, std::span<ValueType>{},
+                                  n, v.getNumberOfComponents(),
+                                  v.getPointStride(), v.getComponentStride());
+    }
+    const auto values = v.getValues().subspan(b * v.getPointStride());
+    return FieldView<ValueType>(no_precondition_check, values, n,
+                                v.getNumberOfComponents(), v.getPointStride(),
+                                v.getComponentStride());
+  }  // end of getPoints
+
 }  // end of namespace mgis
 
