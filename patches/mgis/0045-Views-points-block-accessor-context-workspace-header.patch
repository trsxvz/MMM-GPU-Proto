+  FieldView<real> getTangentOperatorBlockView(const MaterialDataView& v,
+                                              const std::string_view v1,
+                                              const std::string_view v2) {
+    if (v.b == nullptr) {
+      mgis::raise("getTangentOperatorBlockView: no behaviour");
+    }
+    const auto& b = *(v.b);
+    const auto h = b.hypothesis;
+    auto o = size_type{};
+    for (const auto& [b1, b2] : b.to_blocks) {
+      const auto s = getVariableSize(b1, h) * getVariableSize(b2, h);
+      if ((b1.name == v1) && (b2.name == v2)) {
+        if (v.n == 0) {
+          // no point: the view only gives the number of components
+          return FieldView<real>(std::span<real>{}, 0, s, s, 1);
+        }
+        const auto Ks = getTangentOperatorArraySize(b);
+        if ((v.K.getNumberOfPoints() != v.n) ||
+            (v.K.getNumberOfComponents() != Ks)) {
+          mgis::raise(
+              "getTangentOperatorBlockView: invalid view of the tangent "
+              "operator blocks (" +
+              std::to_string(v.n) + " points and " + std::to_string(Ks) +
+              " components expected)");
+        }
+        return getComponents(v.K, o, s);
+      }
+      o += s;
+    }
+    mgis::raise(
+        "getTangentOperatorBlockView: no tangent operator block associated "
+        "with the derivative of '" +
+        std::string{v1} + "' with respect to '" + std::string{v2} + "'");
+  }  // end of getTangentOperatorBlockView
+
   void update(const MaterialDataView& v, FieldOperations& ops) {
     ops.fill(v.K, real{0});
     updateValues(v.s0, v.s1, ops);
