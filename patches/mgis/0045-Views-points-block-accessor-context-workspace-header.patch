+  /*!
+   * \brief memory used by the computations of a behaviour point by point:
+   * values of a point evaluated or gathered before calling the functions
+   * generated by the `generic` interface.
+   *
+   * A workspace is used by one thread at a time. The functions processing
+   * the points of a material data view without execution policy take a
+   * workspace explicitly, the material data managers hold one workspace per
+   * thread.
+   *
+   * The workspace keeps a pointer to the behaviour for which it has been
+   * built: this behaviour must outlive the workspace, and the functions
+   * using a workspace check that it has been built for their behaviour (the
+   * same object, not a copy).
+   */
+  struct MGIS_EXPORT BehaviourIntegrationWorkSpace {
+    /*!
+     * \brief constructor
+     * \param[in] b: behaviour, which must outlive the workspace
+     */
+    BehaviourIntegrationWorkSpace(const Behaviour&);
+    //! \brief a workspace can't be built for a temporary behaviour
+    BehaviourIntegrationWorkSpace(const Behaviour&&) = delete;
+    //! \brief move constructor
+    BehaviourIntegrationWorkSpace(BehaviourIntegrationWorkSpace&&);
+    //! \brief copye constructor
+    BehaviourIntegrationWorkSpace(const BehaviourIntegrationWorkSpace&);
+    //! \brief move assignement
+    BehaviourIntegrationWorkSpace& operator=(BehaviourIntegrationWorkSpace&&);
+    //! \brief copy assignement
+    BehaviourIntegrationWorkSpace& operator=(
+        const BehaviourIntegrationWorkSpace&);
+    //! \brief destructor
+    ~BehaviourIntegrationWorkSpace();
+    //! \brief a buffer to hold error messages
+    std::vector<char> error_message;
+    //! \brief material properties at the beginning of the time step
+    std::vector<mgis::real> mps0;
+    //! \brief material properties at the end of the time step
+    std::vector<mgis::real> mps1;
+    //! \brief external state variables at the beginning of the time step
+    std::vector<mgis::real> esvs0;
+    //! \brief external state variables at the end of the time step
+    std::vector<mgis::real> esvs1;
+    //! \brief mass density at the beginning of the time step
+    mgis::real rho0;
+    //! \brief mass density at the end of the time step
+    mgis::real rho1;
+    /*!
+     * \brief behaviour for which the workspace has been built. The functions
+     * using a workspace check that it has been built for their behaviour.
+     */
+    const Behaviour* behaviour;
+    /*!
+     * \brief values of a point gathered by the integration point by point
+     * when the components of a group are not contiguous (see `FieldView`):
+     * gradients, thermodynamic forces and internal state variables at the
+     * beginning and at the end of the time step, tangent operator blocks
+     * (and behaviour options), inputs of the initialize functions and
+     * outputs of the post-processings. Those arrays are allocated once, by
+     * the constructor.
+     */
+    std::vector<mgis::real> gradients0;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> gradients1;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> thermodynamic_forces0;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> thermodynamic_forces1;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> internal_state_variables0;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> internal_state_variables1;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> tangent_operator;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> initialize_function_inputs;
+    //! \brief see `gradients0`
+    std::vector<mgis::real> postprocessing_outputs;
+  };  // end of struct BehaviourIntegrationWorkSpace
+
+}  // end of namespace mgis::behaviour
