diff --git a/include/MGIS/Function/TFEL/MapValues.hxx b/include/MGIS/Function/TFEL/MapValues.hxx
new file mode 100644
index 0000000..736100e
--- /dev/null
+++ b/include/MGIS/Function/TFEL/MapValues.hxx
@@ -0,0 +1,63 @@
+/*!
+ * \file   MGIS/Function/TFEL/MapValues.hxx
+ * \brief  This file declares the functions mapping the values returned by a
+ * function or an evaluator to the mathematical objects of `TFEL/Math`.
+ * \date   10/11/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FUNCTION_TFEL_MAPVALUES_HXX
+#define LIB_MGIS_FUNCTION_TFEL_MAPVALUES_HXX
+
+#include <type_traits>
+#include "TFEL/Math/Array/View.hxx"
+#include "TFEL/Math/Array/StridedCoalescedView.hxx"
+#include "MGIS/StridedSpan.hxx"
+#include "MGIS/Function/EvaluatorConcept.hxx"
+
+namespace mgis::function::internals {
+
+  /*!
+   * \return a view of a mathematical object of `TFEL/Math` on the values
+   * returned by a function or an evaluator, without copy: a view with a
+   * stride (`tfel::math::StridedCoalescedView`) for a strided span, a view on
+   * contiguous values (`tfel::math::map`) otherwise
+   *
+   * \tparam MathObjectType: type of the mathematical object, possibly
+   * constant
+   * \param[in] r: values, either a strided span or a mappable type (see
+   * `getDataPointer`)
+   */
+  template <typename MathObjectType, typename ResultType>
+  [[nodiscard]] constexpr auto mapValues(ResultType&& r) {
+    if constexpr (isStridedSpan<std::decay_t<ResultType>>) {
+      return ::tfel::math::StridedCoalescedView<MathObjectType>(
+          r.getPointer(), r.getStride());
+    } else {
+      return ::tfel::math::map<MathObjectType>(getDataPointer(r));
+    }
+  }  // end of mapValues
+
+  /*!
+   * \return a reference to the first value returned by a function or an
+   * evaluator
+   * \param[in] r: values, either a strided span or a mappable type (see
+   * `getDataPointer`)
+   */
+  template <typename ResultType>
+  [[nodiscard]] constexpr auto& getFirstValue(ResultType&& r) {
+    if constexpr (isStridedSpan<std::decay_t<ResultType>>) {
+      return r[0];
+    } else {
+      return *(getDataPointer(r));
+    }
+  }  // end of getFirstValue
+
+}  // end of namespace mgis::function::internals
+
+#endif /* LIB_MGIS_FUNCTION_TFEL_MAPVALUES_HXX */
