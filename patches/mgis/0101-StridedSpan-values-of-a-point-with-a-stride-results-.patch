@@ -0,0 +1,226 @@
+/*!
+ * \file   tests/StridedSpanTest.cxx
+ * \brief  This file tests the `StridedSpan` class and its use as the result
+ * of the functions and evaluators of `mgis::function`.
+ * \date   10/11/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include <cmath>
+#include <vector>
+#include <cstdlib>
+#include <iostream>
+#include "TFEL/Tests/TestCase.hxx"
+#include "TFEL/Tests/TestProxy.hxx"
+#include "TFEL/Tests/TestManager.hxx"
+#include "TFEL/Math/tmatrix.hxx"
+#include "MGIS/StridedSpan.hxx"
+#include "MGIS/Function/BasicLinearSpace.hxx"
+#include "MGIS/Function/Function.hxx"
+#include "MGIS/Function/Algorithms.hxx"
+#include "MGIS/Function/TFEL/Mechanics.hxx"
+#include "Tolerance.hxx"
+
+/*!
+ * \brief a minimal function whose values are stored with arbitrary strides,
+ * returning the values of a point as a strided span, as the functions of the
+ * calling codes storing their values point by point or component by
+ * component (for instance the partial quadrature functions of mfem-mgis)
+ */
+struct StridedFunction {
+  //! \brief values of the `j`-th component of the `i`-th point
+  mgis::StridedSpan<mgis::real> operator()(const mgis::size_type i) const {
+    return {this->values + i * this->point_stride, this->number_of_components,
+            this->component_stride};
+  }
+  //! \brief space
+  mgis::function::BasicLinearSpace space;
+  //! \brief values
+  mgis::real* values;
+  //! \brief number of components
+  mgis::size_type number_of_components;
+  //! \brief stride between two points
+  mgis::size_type point_stride;
+  //! \brief stride between two components
+  mgis::size_type component_stride;
+};
+
+//! \brief read-only counterpart of `StridedFunction`
+struct ImmutableStridedFunction {
+  mgis::StridedSpan<const mgis::real> operator()(
+      const mgis::size_type i) const {
+    return {this->values + i * this->point_stride, this->number_of_components,
+            this->component_stride};
+  }
+  mgis::function::BasicLinearSpace space;
+  const mgis::real* values;
+  mgis::size_type number_of_components;
+  mgis::size_type point_stride;
+  mgis::size_type component_stride;
+};
+
+const mgis::function::BasicLinearSpace& getSpace(const StridedFunction& f) {
+  return f.space;
+}
+const mgis::function::BasicLinearSpace& getSpace(
+    const ImmutableStridedFunction& f) {
+  return f.space;
+}
+constexpr bool check(mgis::AbstractErrorHandler&,
+                     const StridedFunction&) noexcept {
+  return true;
+}
+constexpr bool check(mgis::AbstractErrorHandler&,
+                     const ImmutableStridedFunction&) noexcept {
+  return true;
+}
+mgis::size_type getNumberOfComponents(const StridedFunction& f) noexcept {
+  return f.number_of_components;
+}
+mgis::size_type getNumberOfComponents(
+    const ImmutableStridedFunction& f) noexcept {
+  return f.number_of_components;
+}
+
+namespace mgis::function {
+  template <>
+  struct LightweightViewTraits<StridedFunction> : std::true_type {};
+  static_assert(FunctionConcept<StridedFunction>);
+  static_assert(EvaluatorConcept<ImmutableStridedFunction>);
+  static_assert(isFunctionResultTypeStridedMappable<StridedFunction>);
+  static_assert(!isFunctionResultTypeMappable<StridedFunction>);
+  static_assert(
+      isEvaluatorResultTypeStridedMappable<ImmutableStridedFunction>);
+  static_assert(!isEvaluatorResultTypeMappable<ImmutableStridedFunction>);
+}  // end of namespace mgis::function
+
+struct StridedSpanTest final : public tfel::tests::TestCase {
+  StridedSpanTest() : tfel::tests::TestCase("MGIS", "StridedSpanTest") {}
+  tfel::tests::TestResult execute() override {
+    this->test1();
+    this->test2();
+    this->test3();
+    return this->result;
+  }
+
+ private:
+  //! \brief basic accessors
+  void test1() {
+    using namespace mgis;
+    auto values = std::vector<real>{1, 2, 3, 4, 5, 6};
+    const auto s = StridedSpan<real>(values.data() + 1, 3, 2);
+    TFEL_TESTS_CHECK_EQUAL(s.size(), 3);
+    TFEL_TESTS_ASSERT(!s.empty());
+    TFEL_TESTS_ASSERT(!s.hasContiguousValues());
+    TFEL_TESTS_CHECK_EQUAL(s.getStride(), 2);
+    TFEL_TESTS_ASSERT(s[0] == 2);
+    TFEL_TESTS_ASSERT(s[1] == 4);
+    TFEL_TESTS_ASSERT(s[2] == 6);
+    s[1] = 40;
+    TFEL_TESTS_ASSERT(values[3] == 40);
+    auto sum = real{};
+    for (const auto v : s) {
+      sum += v;
+    }
+    TFEL_TESTS_ASSERT(sum == 48);
+    TFEL_TESTS_CHECK_EQUAL(s.end() - s.begin(), 3);
+    const StridedSpan<const real> cs = s;
+    TFEL_TESTS_ASSERT(cs[2] == 6);
+    const auto c = StridedSpan<real>(std::span<real>(values));
+    TFEL_TESTS_ASSERT(c.hasContiguousValues());
+    TFEL_TESTS_CHECK_EQUAL(c.size(), 6);
+    TFEL_TESTS_ASSERT(StridedSpan<real>().empty());
+  }
+  /*!
+   * \brief the same stresses stored point by point (with a padding) and
+   * component by component: the evaluators give the same results to the bit
+   */
+  void test2() {
+    using namespace mgis;
+    using namespace mgis::function;
+    constexpr size_type n = 3;
+    constexpr size_type nc = 6;
+    const auto space = BasicLinearSpace(n);
+    auto aos = std::vector<real>(n * (nc + 1), std::nan(""));
+    auto soa = std::vector<real>((n + 2) * nc, std::nan(""));
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        const auto v = real(1 + i) * real(j + 2) / 3 - real(j % 2);
+        aos[i * (nc + 1) + j] = v;
+        soa[j * (n + 2) + i] = v;
+      }
+    }
+    const auto faos = ImmutableStridedFunction{space, aos.data(), nc, nc + 1, 1};
+    const auto fsoa = ImmutableStridedFunction{space, soa.data(), nc, 1, n + 2};
+    // scalar results, written in a function stored point by point
+    auto r1 = std::vector<real>(n);
+    auto r2 = std::vector<real>(n);
+    auto seq1 = FunctionView<BasicLinearSpace>(space, r1, 1);
+    auto seq2 = FunctionView<BasicLinearSpace>(space, r2, 1);
+    TFEL_TESTS_ASSERT(faos | as_stensor<3> | vmis | seq1);
+    TFEL_TESTS_ASSERT(fsoa | as_stensor<3> | vmis | seq2);
+    for (size_type i = 0; i != n; ++i) {
+      TFEL_TESTS_ASSERT(!std::isnan(r1[i]));
+      TFEL_TESTS_ASSERT(r1[i] == r2[i]);
+    }
+    // tensorial results, written in functions stored with strides
+    auto d1 = std::vector<real>(n * nc, std::nan(""));
+    auto d2 = std::vector<real>(n * nc, std::nan(""));
+    auto g1 = StridedFunction{space, d1.data(), nc, nc, 1};
+    auto g2 = StridedFunction{space, d2.data(), nc, 1, n};
+    auto v1 = g1 | as_stensor<3>;
+    auto v2 = g2 | as_stensor<3>;
+    const auto R = tfel::math::tmatrix<3, 3, real>{{0, 1, 0},  //
+                                                   {0, 0, 1},
+                                                   {1, 0, 0}};
+    TFEL_TESTS_ASSERT(faos | as_stensor<3> | rotate_backwards(R) | v1);
+    TFEL_TESTS_ASSERT(fsoa | as_stensor<3> | rotate_backwards(R) | v2);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        TFEL_TESTS_ASSERT(!std::isnan(d1[i * nc + j]));
+        TFEL_TESTS_ASSERT(d1[i * nc + j] == d2[j * n + i]);
+      }
+    }
+  }
+  //! \brief raw assignments between functions stored with strides
+  void test3() {
+    using namespace mgis;
+    using namespace mgis::function;
+    constexpr size_type n = 4;
+    constexpr size_type nc = 3;
+    const auto space = BasicLinearSpace(n);
+    auto src = std::vector<real>(n * nc);
+    for (size_type i = 0; i != n * nc; ++i) {
+      src[i] = real(i);
+    }
+    auto dst = std::vector<real>(n * nc, std::nan(""));
+    const auto fsrc = ImmutableStridedFunction{space, src.data(), nc, nc, 1};
+    auto fdst = StridedFunction{space, dst.data(), nc, 1, n};
+    Context ctx;
+    TFEL_TESTS_ASSERT(assign(ctx, fdst, fsrc));
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != nc; ++j) {
+        TFEL_TESTS_ASSERT(dst[j * n + i] == src[i * nc + j]);
+      }
+    }
+  }
+};
+
+TFEL_TESTS_GENERATE_PROXY(StridedSpanTest, "StridedSpanTest");
+
+/* coverity [UNCAUGHT_EXCEPT]*/
+int main() {
+  auto& m = tfel::tests::TestManager::getTestManager();
+  m.addTestOutput(std::cout);
+  m.addXMLTestOutput("StridedSpanTest.xml");
+  return m.execute().success() ? EXIT_SUCCESS : EXIT_FAILURE;
+}
