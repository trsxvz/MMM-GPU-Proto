diff --git a/include/MGIS/StridedSpan.hxx b/include/MGIS/StridedSpan.hxx
new file mode 100644
index 0000000..23bbf5a
--- /dev/null
+++ b/include/MGIS/StridedSpan.hxx
@@ -0,0 +1,198 @@
+/*!
+ * \file   include/MGIS/StridedSpan.hxx
+ * \brief  This file declares the `StridedSpan` class, a view on values
+ * separated by a constant stride, such as the components of a point of a
+ * field stored component by component.
+ * \date   10/11/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_STRIDEDSPAN_HXX
+#define LIB_MGIS_STRIDEDSPAN_HXX
+
+#include <span>
+#include <cstddef>
+#include <iterator>
+#include <type_traits>
+#include "MGIS/Config.hxx"
+
+namespace mgis {
+
+  /*!
+   * \brief a view on `size()` values separated by a constant stride: the
+   * `i`-th value is `getPointer()[i * getStride()]`.
+   *
+   * This is the strided counterpart of `std::span`, with the meaning of a
+   * one-dimensional `std::mdspan` using the `layout_stride` mapping. It
+   * typically describes the components of one point of a field, whatever
+   * the layout of the field (a stride of one for a field stored point by
+   * point, the leading dimension for a field stored component by
+   * component, see `FieldView`).
+   *
+   * Contrary to `std::span`, this class has no `data` method: it can't be
+   * mistaken for contiguous values by a code mapping the values from a
+   * pointer. The values are contiguous only if `hasContiguousValues()` is
+   * true.
+   *
+   * A strided span is trivially copyable and its methods are `constexpr`:
+   * it can be used in device code. It is not assignable: an assignment
+   * would either rebind the view (as for `std::span`) or copy the values (as
+   * for the views of `TFEL/Math`), and the algorithms of `mgis::function`
+   * assigning the values of a point to another must not confuse the two (see
+   * `mgis::function::internals::assign_value`).
+   *
+   * \tparam ValueType: type of the values, `real` or `const real`
+   */
+  template <typename ValueType>
+  struct StridedSpan {
+    static_assert(std::is_same_v<std::remove_const_t<ValueType>, real>,
+                  "invalid value type");
+    //! \brief type of the values
+    using value_type = std::remove_const_t<ValueType>;
+    //! \brief type of the elements
+    using element_type = ValueType;
+    //! \brief type of the indices
+    using size_type = mgis::size_type;
+    //! \brief random access iterator on the values
+    struct iterator {
+      using iterator_category = std::random_access_iterator_tag;
+      using value_type = std::remove_const_t<ValueType>;
+      using difference_type = std::ptrdiff_t;
+      using pointer = ValueType*;
+      using reference = ValueType&;
+      constexpr reference operator*() const noexcept { return *(this->p); }
+      constexpr reference operator[](const difference_type i) const noexcept {
+        return this->p[i * this->s];
+      }
+      constexpr iterator& operator++() noexcept {
+        this->p += this->s;
+        return *this;
+      }
+      constexpr iterator operator++(int) noexcept {
+        auto r = *this;
+        this->p += this->s;
+        return r;
+      }
+      constexpr iterator& operator--() noexcept {
+        this->p -= this->s;
+        return *this;
+      }
+      constexpr iterator operator--(int) noexcept {
+        auto r = *this;
+        this->p -= this->s;
+        return r;
+      }
+      constexpr iterator& operator+=(const difference_type i) noexcept {
+        this->p += i * this->s;
+        return *this;
+      }
+      constexpr iterator& operator-=(const difference_type i) noexcept {
+        this->p -= i * this->s;
+        return *this;
+      }
+      constexpr iterator operator+(const difference_type i) const noexcept {
+        return iterator{this->p + i * this->s, this->s};
+      }
+      friend constexpr iterator operator+(const difference_type i,
+                                          const iterator& it) noexcept {
+        return it + i;
+      }
+      constexpr iterator operator-(const difference_type i) const noexcept {
+        return iterator{this->p - i * this->s, this->s};
+      }
+      constexpr difference_type operator-(const iterator& o) const noexcept {
+        return (this->p - o.p) / this->s;
+      }
+      constexpr bool operator==(const iterator& o) const noexcept {
+        return this->p == o.p;
+      }
+      constexpr auto operator<=>(const iterator& o) const noexcept {
+        return this->p <=> o.p;
+      }
+      //! \brief current value
+      ValueType* p = nullptr;
+      //! \brief stride
+      difference_type s = 1;
+    };
+    //! \brief default constructor, building an empty view
+    constexpr StridedSpan() noexcept = default;
+    /*!
+     * \param[in] p: pointer to the first value
+     * \param[in] n: number of values
+     * \param[in] s: stride between two successive values, which must be
+     * strictly positive
+     */
+    constexpr StridedSpan(ValueType* const p,
+                          const size_type n,
+                          const size_type s) noexcept
+        : ptr(p), number_of_values(n), stride(s) {}
+    //! \brief view on contiguous values (stride of one)
+    constexpr StridedSpan(const std::span<ValueType> v) noexcept
+        : ptr(v.data()),
+          number_of_values(static_cast<size_type>(v.size())),
+          stride(1) {}
+    //! \brief conversion of a view on mutable values to a read-only view
+    template <typename OtherValueType>
+    constexpr StridedSpan(const StridedSpan<OtherValueType>& v) noexcept
+        requires(std::is_same_v<const OtherValueType, ValueType> &&
+                 !std::is_same_v<OtherValueType, ValueType>)
+        : ptr(v.getPointer()),
+          number_of_values(v.size()),
+          stride(v.getStride()) {}
+    constexpr StridedSpan(const StridedSpan&) noexcept = default;
+    constexpr StridedSpan(StridedSpan&&) noexcept = default;
+    StridedSpan& operator=(const StridedSpan&) = delete;
+    StridedSpan& operator=(StridedSpan&&) = delete;
+    //! \return the `i`-th value
+    [[nodiscard]] constexpr ValueType& operator[](
+        const size_type i) const noexcept {
+      return this->ptr[i * this->stride];
+    }
+    //! \return the number of values
+    [[nodiscard]] constexpr size_type size() const noexcept {
+      return this->number_of_values;
+    }
+    //! \return true if the view is empty
+    [[nodiscard]] constexpr bool empty() const noexcept {
+      return this->number_of_values == 0;
+    }
+    //! \return a pointer to the first value
+    [[nodiscard]] constexpr ValueType* getPointer() const noexcept {
+      return this->ptr;
+    }
+    //! \return the stride between two successive values
+    [[nodiscard]] constexpr size_type getStride() const noexcept {
+      return this->stride;
+    }
+    //! \return true if the values are contiguous
+    [[nodiscard]] constexpr bool hasContiguousValues() const noexcept {
+      return (this->stride == 1) || (this->number_of_values <= 1);
+    }
+    //! \return an iterator to the first value
+    [[nodiscard]] constexpr iterator begin() const noexcept {
+      return iterator{this->ptr,
+                      static_cast<std::ptrdiff_t>(this->stride)};
+    }
+    //! \return an iterator past the last value
+    [[nodiscard]] constexpr iterator end() const noexcept {
+      return iterator{this->ptr + this->number_of_values * this->stride,
+                      static_cast<std::ptrdiff_t>(this->stride)};
+    }
+
+   private:
+    //! \brief pointer to the first value
+    ValueType* ptr = nullptr;
+    //! \brief number of values
+    size_type number_of_values = 0;
+    //! \brief stride between two successive values
+    size_type stride = 1;
+  };  // end of StridedSpan
+
+}  // end of namespace mgis
+
+#endif /* LIB_MGIS_STRIDEDSPAN_HXX */
