+  /*!
+   * \return a pointer to the deformation gradient of the `i`-th point of a
+   * view of the gradients: the values of the view, or, if the gradients are
+   * the displacement gradient \f(H\f), \f(F = I + H\f) computed in the
+   * given local array. The conversions do not support the plane stress
+   * hypotheses: the three diagonal components are shifted.
+   * \param[out] local: local array
+   * \param[in] v: view of the gradients
+   * \param[in] i: index of the point
+   * \param[in] displacement_gradient: if true, the gradients are the
+   * displacement gradient
+   */
+  static const real* getDeformationGradient(std::array<real, 9>& local,
+                                            const FieldView<const real>& v,
+                                            const size_type i,
+                                            const bool displacement_gradient) {
+    if (!displacement_gradient) {
+      return getPointValues(local, v, i);
+    }
+    for (size_type j = 0; j != v.getNumberOfComponents(); ++j) {
+      local[j] = v(i, j);
+    }
+    local[0] += real{1};
+    local[1] += real{1};
+    local[2] += real{1};
+    return local.data();
+  }  // end of getDeformationGradient
+
+  /*!
+   * \return a pointer to the deformation gradient of a state: its
+   * gradients, or, if they are the displacement gradient \f(H\f),
