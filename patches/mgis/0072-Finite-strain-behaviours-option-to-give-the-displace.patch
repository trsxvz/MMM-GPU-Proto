+#include <array>
+#include <cmath>
+#include <limits>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+#include <cstdlib>
+#include <iostream>
+#include <algorithm>
+#include "MGIS/LibrariesManager.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/BehaviourData.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+#include "MGIS/Behaviour/FiniteStrainSupport.hxx"
+#include "Tolerance.hxx"
+
+static bool success = true;
+
+static bool check(const bool b, const std::string& msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}  // end of check
+
+static constexpr auto young = 200e9;
+static constexpr auto nu = 0.3;
+
+//! \return the relative gap between two arrays
+static double gap(std::span<const mgis::real> a,
+                  std::span<const mgis::real> b) {
+  auto m = 0.;
+  auto n = 0.;
+  for (std::size_t i = 0; i != a.size(); ++i) {
+    m = std::max(m, std::abs(static_cast<double>(a[i]) - b[i]));
+    n = std::max(n, std::abs(static_cast<double>(b[i])));
+  }
+  return n > 0 ? m / n : m;
+}  // end of gap
+
+/*!
+ * \brief displacement gradient of the `i`-th point: small strains (of the
+ * order of `1e-5` times `scale`), with shear components if `shear` is
+ * true. In plane stress, the axial component is computed by the behaviour
+ * and is zero.
+ */
+static std::array<double, 9> getDisplacementGradient(
+    const mgis::size_type i,
+    const bool shear,
+    const mgis::behaviour::Hypothesis h,
+    const double scale = 1) {
+  const auto x = static_cast<double>(i + 1);
+  auto H = std::array<double, 9>{};
+  H[0] = 1e-5 * x;
+  H[1] = -3e-6 * x;
+  H[2] = h == mgis::behaviour::Hypothesis::PLANESTRESS ? 0 : 2e-6 + 1e-6 * x;
+  if (shear) {
+    H[3] = 4e-6 * x;
+    H[4] = -2e-6;
+    H[5] = 1e-6 * x;
+    H[6] = 3e-6;
+    H[7] = -5e-7 * x;
+    H[8] = 2e-6;
+  }
+  for (auto& v : H) {
+    v *= scale;
+  }
+  return H;
+}  // end of getDisplacementGradient
+
+//! \brief managers of the same behaviour, loaded with F and with H
+struct Managers {
+  Managers(mgis::behaviour::FiniteStrainBehaviourOptions o,
+           const std::string& l,
+           const std::string& b,
+           const mgis::behaviour::Hypothesis h,
+           const mgis::size_type n)
+      : F(load(
+            o,
+            mgis::behaviour::FiniteStrainBehaviourOptions::DEFORMATION_GRADIENT,
+            l,
+            b,
+            h)),
+        H(load(o,
+               mgis::behaviour::FiniteStrainBehaviourOptions::
+                   DISPLACEMENT_GRADIENT,
+               l,
+               b,
+               h)),
+        mF(F, n),
+        mH(H, n) {
+    for (auto* const m : {&mF, &mH}) {
+      for (auto* const s : {&m->s0, &m->s1}) {
+        setMaterialProperty(*s, "YoungModulus", young);
+        setMaterialProperty(*s, "PoissonRatio", nu);
+        setExternalStateVariable(*s, "Temperature", 293.15);
+      }
+    }
+  }
+  /*!
+   * \brief set the gradients at the end of the time step (see
+   * `getDisplacementGradient`)
+   */
+  void setGradients(const bool shear, const double scale = 1) {
+    const auto ts = getTensorSize(this->F.hypothesis);
+    for (mgis::size_type i = 0; i != this->mF.n; ++i) {
+      const auto Hv =
+          getDisplacementGradient(i, shear, this->F.hypothesis, scale);
+      // components of the tensors of TFEL, the five first ones in 2D
+      auto* const gF = this->mF.s1.gradients.data() + i * ts;
+      auto* const gH = this->mH.s1.gradients.data() + i * ts;
+      for (mgis::size_type j = 0; j != ts; ++j) {
+        gH[j] = static_cast<mgis::real>(Hv[j]);
+        gF[j] = static_cast<mgis::real>((j < 3 ? 1 : 0) + Hv[j]);
+      }
+    }
+  }
+  //! \brief integrate with both managers
+  void integrate(const std::string& name) {
+    using namespace mgis::behaviour;
+    auto opts = BehaviourIntegrationOptions{};
+    opts.integration_type =
+        IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+    const auto rF = mgis::behaviour::integrate(this->mF, opts, 1);
+    const auto rH = mgis::behaviour::integrate(this->mH, opts, 1);
+    check(rF.exit_status == 1, name + ": integration with F failed");
+    check(rH.exit_status == 1, name + ": integration with H failed");
+  }
+  //! \brief behaviour loaded with F
+  const mgis::behaviour::Behaviour F;
+  //! \brief behaviour loaded with H
+  const mgis::behaviour::Behaviour H;
+  //! \brief manager of the behaviour loaded with F
+  mgis::behaviour::MaterialDataManager mF;
+  //! \brief manager of the behaviour loaded with H
+  mgis::behaviour::MaterialDataManager mH;
+
+ private:
+  static mgis::behaviour::Behaviour load(
+      mgis::behaviour::FiniteStrainBehaviourOptions o,
+      const mgis::behaviour::FiniteStrainBehaviourOptions::Gradient g,
+      const std::string& l,
+      const std::string& b,
+      const mgis::behaviour::Hypothesis h) {
+    o.gradient = g;
+    return mgis::behaviour::load(o, l, b, h);
+  }
+};  // end of struct Managers
+
+//! \brief description of the behaviour loaded with the displacement gradient
+static void testDescription(const std::string& l, const std::string& b) {
+  using namespace mgis::behaviour;
+  const auto h = Hypothesis::TRIDIMENSIONAL;
+  auto o = FiniteStrainBehaviourOptions{};
+  o.tangent_operator = FiniteStrainBehaviourOptions::DPK1_DF;
+  const auto m = Managers(o, l, b, h, 2);
+  const auto test = l + ", " + b + ": ";
+  check(!usesDisplacementGradient(m.F), test + "F: displacement gradient");
+  check(usesDisplacementGradient(m.H), test + "H: no displacement gradient");
+  check(m.F.gradients[0].name == "DeformationGradient",
+        test + "F: invalid gradient name");
+  check(m.H.gradients[0].name == "DisplacementGradient",
+        test + "H: invalid gradient name");
+  check(m.H.gradients[0].type == Variable::TENSOR,
+        test + "H: invalid gradient type");
+  check(m.H.to_blocks.size() == 1, test + "H: invalid number of blocks");
+  check(m.H.to_blocks[0].second.name == "DisplacementGradient",
+        test + "H: invalid tangent operator block");
+  // the options are small integers, stored exactly
+  check((m.H.options.size() == 2) &&
+            (static_cast<int>(m.H.options[0]) ==
+             static_cast<int>(m.F.options[0]) + 10) &&
+            (static_cast<int>(m.H.options[1]) ==
+             static_cast<int>(m.F.options[1])),
+        test + "H: invalid options");
+  // initial states: identity with F, zero with H
+  for (const auto* const s : {&m.mF.s0, &m.mF.s1, &m.mH.s0, &m.mH.s1}) {
+    const auto identity = s == &m.mF.s0 || s == &m.mF.s1;
+    for (mgis::size_type i = 0; i != m.mF.n; ++i) {
+      for (mgis::size_type j = 0; j != 9; ++j) {
+        // the initial values are exact
+        const auto expected = (identity && (j < 3)) ? 1. : 0.;
+        check(std::abs(static_cast<double>(s->gradients[i * 9 + j]) -
+                       expected) < std::numeric_limits<double>::min(),
+              test + "invalid initial gradients");
+      }
+    }
+  }
+  // a behaviour whose gradient is not the deformation gradient does not
+  // accept the option
+  auto& lm = mgis::LibrariesManager::get();
+  check(lm.acceptsDisplacementGradient(l, b), test + "symbol not found");
+  check(!lm.acceptsDisplacementGradient(l, "Elasticity"),
+        l + ", Elasticity: unexpected symbol");
+}  // end of testDescription
+
+/*!
+ * \brief same results with F and with H in double, for all the stress
+ * measures and tangent operators
+ */
+static void testIntegration(const std::string& l,
+                            const std::string& b,
+                            const mgis::behaviour::Hypothesis h) {
+  using namespace mgis::behaviour;
+  for (const auto sm :
+       {FiniteStrainBehaviourOptions::CAUCHY, FiniteStrainBehaviourOptions::PK2,
+        FiniteStrainBehaviourOptions::PK1}) {
+    for (const auto to : {FiniteStrainBehaviourOptions::DSIG_DF,
+                          FiniteStrainBehaviourOptions::DS_DEGL,
+                          FiniteStrainBehaviourOptions::DPK1_DF,
+                          FiniteStrainBehaviourOptions::DTAU_DDF}) {
+      auto o = FiniteStrainBehaviourOptions{};
+      o.stress_measure = sm;
+      o.tangent_operator = to;
+      auto m = Managers(o, l, b, h, 4);
+      const auto test = l + ", " + b + ", " + toString(h) + ", options " +
+                        std::to_string(static_cast<int>(sm)) + "/" +
+                        std::to_string(static_cast<int>(to)) + ": ";
+      // in double, the gap is the cancellation of the computation from F
+      // (about 1e-16 / 1e-5). In float, the computation from F only knows
+      // the strain within about 6e-8 (see testPrecision): the strains are
+      // multiplied by 1e3 for the comparison to be meaningful
+      m.setGradients(true, mgis::tests::tolerance(1, 1e3));
+      m.integrate(test);
+      const auto e_s =
+          gap(m.mH.s1.thermodynamic_forces, m.mF.s1.thermodynamic_forces);
+      check(e_s < mgis::tests::tolerance(1e-9, 1e-4),
+            test + "stresses differ (" + std::to_string(e_s) + ")");
+      const auto e_K = gap(m.mH.K, m.mF.K);
+      check(e_K < mgis::tests::tolerance(1e-9, 1e-4),
+            test + "tangent operators differ (" + std::to_string(e_K) + ")");
+    }
+  }
+}  // end of testIntegration
+
+/*!
+ * \brief Cauchy stress of an isotropic elastic behaviour for a diagonal
+ * displacement gradient, computed in double
+ * \param[in] b: name of the behaviour
+ * \param[in] H: displacement gradient
+ */
+static std::array<double, 3> getReferenceStress(
+    const std::string& b, const std::array<double, 9>& H) {
+  const auto lambda = nu * young / ((1 + nu) * (1 - 2 * nu));
+  const auto mu = young / (2 * (1 + nu));
+  const auto J = (1 + H[0]) * (1 + H[1]) * (1 + H[2]);
+  auto s = std::array<double, 3>{};
+  if (b == "HenckyElasticity") {
+    // the dual stress of the Hencky strain is the Kirchhoff stress
+    const auto e = std::array<double, 3>{std::log1p(H[0]), std::log1p(H[1]),
+                                         std::log1p(H[2])};
+    const auto tr = e[0] + e[1] + e[2];
+    for (int i = 0; i != 3; ++i) {
+      s[i] = (lambda * tr + 2 * mu * e[i]) / J;
+    }
+  } else {
+    // second Piola-Kirchhoff stress pushed forward
+    const auto E = std::array<double, 3>{
+        H[0] + H[0] * H[0] / 2, H[1] + H[1] * H[1] / 2, H[2] + H[2] * H[2] / 2};
+    const auto tr = E[0] + E[1] + E[2];
+    for (int i = 0; i != 3; ++i) {
+      s[i] = (1 + H[i]) * (1 + H[i]) * (lambda * tr + 2 * mu * E[i]) / J;
+    }
+  }
+  return s;
+}  // end of getReferenceStress
+
+/*!
+ * \brief precision of the Cauchy stress for small strains, compared with
+ * the analytical solution
+ */
+static void testPrecision(const std::string& l, const std::string& b) {
+  using namespace mgis::behaviour;
+  const auto h = Hypothesis::TRIDIMENSIONAL;
+  auto m = Managers(FiniteStrainBehaviourOptions{}, l, b, h, 4);
+  const auto test = l + ", " + b + ", precision: ";
+  m.setGradients(false);
+  m.integrate(test);
+  auto eF = 0.;
+  auto eH = 0.;
+  for (mgis::size_type i = 0; i != m.mF.n; ++i) {
+    const auto s = getReferenceStress(b, getDisplacementGradient(i, false, h));
+    const auto n = std::max({std::abs(s[0]), std::abs(s[1]), std::abs(s[2])});
+    for (int j = 0; j != 3; ++j) {
+      eF = std::max(
+          eF, std::abs(m.mF.s1.thermodynamic_forces[i * 6 + j] - s[j]) / n);
+      eH = std::max(
+          eH, std::abs(m.mH.s1.thermodynamic_forces[i * 6 + j] - s[j]) / n);
+    }
+  }
+  std::cout << test << "gap to the analytical solution: " << eF << " with F, "
+            << eH << " with H\n";
+  check(eF < mgis::tests::tolerance(1e-9, 1e-1),
+        test + "invalid stress with F (" + std::to_string(eF) + ")");
+  // the behaviour written with F does not benefit from H
+  const auto tH = b == "SaintVenantKirchhoffElasticity"
+                      ? mgis::tests::tolerance(1e-9, 1e-1)
+                      : mgis::tests::tolerance(1e-12, 1e-5);
+  check(eH < tH, test + "invalid stress with H (" + std::to_string(eH) + ")");
+}  // end of testPrecision
+
+/*!
+ * \brief conversions of `FiniteStrainSupport`: first Piola-Kirchhoff
+ * stress and its derivative from the Cauchy stress and its derivative
+ */
+static void testConversions(const std::string& l, const std::string& b) {
+  using namespace mgis::behaviour;
+  const auto h = Hypothesis::TRIDIMENSIONAL;
+  auto m = Managers(FiniteStrainBehaviourOptions{}, l, b, h, 4);
+  const auto test = l + ", " + b + ", conversions: ";
+  // see testIntegration
+  m.setGradients(true, mgis::tests::tolerance(1, 1e3));
+  m.integrate(test);
+  auto PF = std::vector<mgis::real>(9 * m.mF.n);
+  auto PH = std::vector<mgis::real>(9 * m.mF.n);
+  auto PFs = std::span<mgis::real>(PF);
+  auto PHs = std::span<mgis::real>(PH);
+  convertFiniteStrainStress(PFs, m.mF, FiniteStrainStress::PK1);
+  convertFiniteStrainStress(PHs, m.mH, FiniteStrainStress::PK1);
+  const auto t = mgis::tests::tolerance(1e-9, 1e-4);
+  check(gap(PH, PF) < t, test + "first Piola-Kirchhoff stresses differ");
+  auto KF = std::vector<mgis::real>(81 * m.mF.n);
+  auto KH = std::vector<mgis::real>(81 * m.mF.n);
+  auto KFs = std::span<mgis::real>(KF);
+  auto KHs = std::span<mgis::real>(KH);
+  convertFiniteStrainTangentOperator(KFs, m.mF,
+                                     FiniteStrainTangentOperator::DPK1_DF);
+  convertFiniteStrainTangentOperator(KHs, m.mH,
+                                     FiniteStrainTangentOperator::DPK1_DF);
+  check(gap(KH, KF) < t,
+        test + "derivatives of the first Piola-Kirchhoff stress differ");
+}  // end of testConversions
+
+/*!
+ * \brief plane stress: the axial component of the gradients is computed
+ * by the behaviour. The Cauchy stress and the axial strain are compared
+ * with an analytical solution for a diagonal displacement gradient
+ */
+static void testPlaneStress(const std::string& l, const std::string& b) {
+  using namespace mgis::behaviour;
+  const auto h = Hypothesis::PLANESTRESS;
+  auto m = Managers(FiniteStrainBehaviourOptions{}, l, b, h, 4);
+  const auto test = l + ", " + b + ", plane stress: ";
+  m.setGradients(false);
+  m.integrate(test);
+  const auto lambda = nu * young / ((1 + nu) * (1 - 2 * nu));
+  const auto mu = young / (2 * (1 + nu));
+  const auto c = -lambda / (lambda + 2 * mu);
+  const auto hencky = b == "HenckyElasticity";
+  const auto nisvs = getArraySize(m.H.isvs, h);
+  const auto o = getVariableOffset(m.H.isvs, "AxialStrain", h);
+  auto e_s = 0.;
+  auto e_zz = 0.;
+  for (mgis::size_type i = 0; i != m.mH.n; ++i) {
+    const auto H = getDisplacementGradient(i, false, h);
+    // strains in the plane, axial strain, axial deformation gradient
+    const auto e0 = hencky ? std::log1p(H[0]) : H[0] + H[0] * H[0] / 2;
+    const auto e1 = hencky ? std::log1p(H[1]) : H[1] + H[1] * H[1] / 2;
+    const auto ezz = c * (e0 + e1);
+    const auto Fzz = hencky ? std::exp(ezz) : std::sqrt(1 + 2 * ezz);
+    const auto J = (1 + H[0]) * (1 + H[1]) * Fzz;
+    const auto tr = e0 + e1 + ezz;
+    // Kirchhoff stress (Hencky) or second Piola-Kirchhoff stress
+    const auto s0 = lambda * tr + 2 * mu * e0;
+    const auto s1 = lambda * tr + 2 * mu * e1;
+    const auto sig =
+        hencky ? std::array<double, 3>{s0 / J, s1 / J, 0}
+               : std::array<double, 3>{(1 + H[0]) * (1 + H[0]) * s0 / J,
+                                       (1 + H[1]) * (1 + H[1]) * s1 / J, 0};
+    const auto n = std::max(std::abs(sig[0]), std::abs(sig[1]));
+    for (int j = 0; j != 3; ++j) {
+      e_s = std::max(
+          e_s, std::abs(m.mH.s1.thermodynamic_forces[i * 4 + j] - sig[j]) / n);
+    }
+    e_zz = std::max(
+        e_zz, std::abs(m.mH.s1.internal_state_variables[i * nisvs + o] - ezz) /
+                  std::abs(ezz));
+  }
+  check(e_s < mgis::tests::tolerance(1e-12, 1e-5),
+        test + "invalid stress with H (" + std::to_string(e_s) + ")");
+  check(e_zz < mgis::tests::tolerance(1e-12, 1e-5),
+        test + "invalid axial strain with H (" + std::to_string(e_zz) + ")");
+  if (hencky) {
+    // the Hencky strain framework overwrites the axial component of the
+    // deformation gradient, which is one in MGIS: same results with F and
+    // with H, shear included (strains multiplied by 1e3 in float, see
+    // testIntegration)
+    m.setGradients(true, mgis::tests::tolerance(1, 1e3));
+    m.integrate(test);
+    const auto e =
+        gap(m.mH.s1.thermodynamic_forces, m.mF.s1.thermodynamic_forces);
+    check(e < mgis::tests::tolerance(1e-9, 1e-4),
+          test + "stresses differ (" + std::to_string(e) + ")");
+    const auto e_K = gap(m.mH.K, m.mF.K);
+    check(e_K < mgis::tests::tolerance(1e-9, 1e-4),
+          test + "tangent operators differ (" + std::to_string(e_K) + ")");
+  }
+}  // end of testPlaneStress
+
+/*!
+ * \brief initialize function and post-processing, which receive the
+ * strain measure computed from the gradients: same results with F and with
+ * H, through the material data managers and, if `pointwise` is true,
+ * through the behaviour data of a point
+ */
+static void testInitializeFunctionAndPostProcessing(
+    const std::string& l,
+    const std::string& b,
+    const mgis::behaviour::Hypothesis h,
+    const bool pointwise) {
+  using namespace mgis::behaviour;
+  auto m = Managers(FiniteStrainBehaviourOptions{}, l, b, h, 4);
+  const auto test = l + ", " + b + ", " + toString(h) +
+                    ", initialize function and post-processing: ";
+  // the initialize function uses the state at the beginning of the time
+  // step (strains multiplied by 1e3 in float, see testIntegration)
+  m.setGradients(true, mgis::tests::tolerance(1, 1e3));
+  update(m.mF);
+  update(m.mH);
+  const auto t = mgis::tests::tolerance(1e-9, 1e-4);
+  const auto rF = executeInitializeFunction(m.mF, "StoreStrainMeasure");
+  const auto rH = executeInitializeFunction(m.mH, "StoreStrainMeasure");
+  check(rF.exit_status == 1, test + "initialize function failed with F");
+  check(rH.exit_status == 1, test + "initialize function failed with H");
+  const auto e_i =
+      gap(m.mH.s1.internal_state_variables, m.mF.s1.internal_state_variables);
+  check(e_i < t,
+        test + "initialize functions differ (" + std::to_string(e_i) + ")");
+  const auto& pp = m.H.postprocessings.at("StrainMeasure");
+  const auto no = getArraySize(pp.outputs, h);
+  auto oF = std::vector<mgis::real>(no * m.mF.n);
+  auto oH = std::vector<mgis::real>(no * m.mF.n);
+  const auto pF = executePostProcessing(std::span<mgis::real>(oF), m.mF,
+                                        "StrainMeasure", 0, m.mF.n);
+  const auto pH = executePostProcessing(std::span<mgis::real>(oH), m.mH,
+                                        "StrainMeasure", 0, m.mH.n);
+  check(pF.exit_status == 1, test + "post-processing failed with F");
+  check(pH.exit_status == 1, test + "post-processing failed with H");
+  const auto e_p = gap(oH, oF);
+  check(e_p < t,
+        test + "post-processings differ (" + std::to_string(e_p) + ")");
+  if (!pointwise) {
+    return;
+  }
+  // functions of a point, given the behaviour data of the first point,
+  // whose `K` array holds no option
+  auto d = BehaviourData{m.H};
+  const auto ng = getArraySize(m.H.gradients, h);
+  const auto nisvs = getArraySize(m.H.isvs, h);
+  std::copy(m.mH.s1.gradients.begin(), m.mH.s1.gradients.begin() + ng,
+            d.s0.gradients.begin());
+  std::copy(m.mH.s1.gradients.begin(), m.mH.s1.gradients.begin() + ng,
+            d.s1.gradients.begin());
+  auto v = make_view(d);
+  check(executeInitializeFunction(v, m.H, "StoreStrainMeasure") == 0,
+        test + "initialize function of a point failed");
+  check(gap(std::span<const mgis::real>(d.s1.internal_state_variables),
+            std::span<const mgis::real>(m.mH.s1.internal_state_variables)
+                .first(nisvs)) < t,
+        test + "invalid initialize function of a point");
+  auto o = std::vector<mgis::real>(no);
+  check(executePostProcessing(std::span<mgis::real>(o), v, m.H,
+                              "StrainMeasure") == 0,
+        test + "post-processing of a point failed");
+  check(gap(o, std::span<const mgis::real>(oH).first(no)) < t,
+        test + "invalid post-processing of a point");
+}  // end of testInitializeFunctionAndPostProcessing
+
+//! \brief a small strain behaviour can't be given the displacement gradient
+static void testRefusal(const std::string& l) {
+  using namespace mgis::behaviour;
+  auto o = FiniteStrainBehaviourOptions{};
+  o.gradient = FiniteStrainBehaviourOptions::DISPLACEMENT_GRADIENT;
+  auto refused = false;
+  try {
+    static_cast<void>(load(o, l, "Elasticity", Hypothesis::TRIDIMENSIONAL));
+  } catch (std::exception&) {
+    refused = true;
+  }
+  check(refused, l + ", Elasticity: small strain behaviour not refused");
+}  // end of testRefusal
+
+int main(const int argc, const char* const* argv) {
+  if (!check((argc == 2) || (argc == 3),
+             "expected the library generated by the generic interface and, "
+             "optionally, the one generated by the generic-parallel "
+             "interface")) {
+    return EXIT_FAILURE;
+  }
+  try {
+    for (int a = 1; a != argc; ++a) {
+      const auto l = std::string{argv[a]};
+      // the functions of a point are only provided by the generic interface
+      const auto pointwise = a == 1;
+      testRefusal(l);
+      for (const auto* const b :
+           {"SaintVenantKirchhoffElasticity", "GreenLagrangeElasticity",
+            "HenckyElasticity"}) {
+        testDescription(l, b);
+        for (const auto h : {mgis::behaviour::Hypothesis::TRIDIMENSIONAL,
+                             mgis::behaviour::Hypothesis::PLANESTRAIN}) {
+          testIntegration(l, b, h);
+        }
+        testPrecision(l, b);
+        testConversions(l, b);
+        if (std::string_view{b} == "SaintVenantKirchhoffElasticity") {
+          continue;
+        }
+        testPlaneStress(l, b);
+        for (const auto h : {mgis::behaviour::Hypothesis::TRIDIMENSIONAL,
+                             mgis::behaviour::Hypothesis::PLANESTRESS}) {
+          testInitializeFunctionAndPostProcessing(l, b, h, pointwise);
+        }
+      }
+    }
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
diff --git a/tests/GreenLagrangeElasticity.mfront b/tests/GreenLagrangeElasticity.mfront
new file mode 100644
index 0000000..107be31
--- /dev/null
+++ b/tests/GreenLagrangeElasticity.mfront
@@ -0,0 +1,67 @@
+@DSL Default;
+@Behaviour GreenLagrangeElasticity;
+@Description{
+  "Isotropic elasticity in the Green-Lagrange strain framework, used to test the "
+  "integration with the displacement gradient (DisplacementGradientTest)"
+}
+
+@StrainMeasure GreenLagrange;
+@ModellingHypotheses {Tridimensional, PlaneStrain, Axisymmetrical, PlaneStress};
+@ProvidesSymmetricTangentOperator;
+
+@MaterialProperty stress young;
+young.setGlossaryName("YoungModulus");
+@MaterialProperty real nu;
+nu.setGlossaryName("PoissonRatio");
+
+@StateVariable<PlaneStress> strain etozz;
+PlaneStress::etozz.setGlossaryName("AxialStrain");
+
+//! strain measure given to the initialize function
+@AuxiliaryStateVariable StrainStensor eini;
+eini.setEntryName("InitialStrainMeasure");
+
+@LocalVariable stress lambda, mu;
+
+@InitLocalVariables {
+  lambda = computeLambda(young, nu);
+  mu = computeMu(young, nu);
+}
+
+@PredictionOperator {
+  static_cast<void>(smt);
+  Dt = lambda * Stensor4::IxI() + 2 * mu * Stensor4::Id();
+}
+
+@Integrator {
+  sig = lambda * trace(eto + deto) * StrainStensor::Id() + 2 * mu * (eto + deto);
+  if (computeTangentOperator_) {
+    Dt = lambda * Stensor4::IxI() + 2 * mu * Stensor4::Id();
+  }
+}
+
+@Integrator<PlaneStress, Replace> {
+  // the axial strain is such that the axial stress is zero
+  auto e = eval(eto + deto);
+  e[2] = -lambda / (lambda + 2 * mu) * (e[0] + e[1]);
+  detozz = e[2] - etozz;
+  sig = lambda * trace(e) * StrainStensor::Id() + 2 * mu * e;
+  if (computeTangentOperator_) {
+    // plane stress elastic operator
+    const auto lambda_ps = 2 * lambda * mu / (lambda + 2 * mu);
+    Dt = lambda_ps * Stensor4::IxI() + 2 * mu * Stensor4::Id();
+    for (unsigned short i = 0; i != 4; ++i) {
+      Dt(i, 2) = Dt(2, i) = stress(0);
+    }
+  }
+}
+
+@InitializeFunction StoreStrainMeasure {
+  eini = eto;
+}
+
+@PostProcessingVariable StrainStensor ep;
+ep.setGlossaryName("StrainMeasure");
+@PostProcessing StrainMeasure {
+  ep = eto;
+}
