+   * for the views)
+   * \param[out] local: local array
+   * \param[in] s: state
+   */
+  static const real* getDeformationGradient(std::array<real, 9>& local,
+                                            const State& s) {
+    if (!usesDisplacementGradient(s.b)) {
+      return s.gradients.data();
+    }
+    std::copy(s.gradients.begin(), s.gradients.end(), local.begin());
+    local[0] += real{1};
+    local[1] += real{1};
+    local[2] += real{1};
+    return local.data();
+  }  // end of getDeformationGradient
