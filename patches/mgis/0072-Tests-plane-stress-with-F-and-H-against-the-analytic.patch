From 738a04a09f74830ac09bf902de682836d98ab6fa Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 14 Oct 2026 23:00:05 +0200
Subject: [PATCH] Tests: plane stress with F and H against the analytical
 solution

The Cauchy stress and the first Piola-Kirchhoff stress of the
Green-Lagrange and Hencky test behaviours in plane stress are compared
with the analytical solution, with the deformation gradient given by
MGIS (axial component of one) and with the displacement gradient, and
with an axial component shifted by the caller, which shall be ignored.
As in the StandardElasticity brick, the axial strain of the test
behaviours is the sum of the one given by the interface and of the
AxialStrain internal state variable.

This detects the former handling of the axial component by TFEL (Cauchy
stress wrong by a factor of two in the Green-Lagrange framework,
Piola-Kirchhoff stresses wrong by the axial strain in the Hencky one,
axial strain given by the caller in the Green-Lagrange framework).
---
 tests/DisplacementGradientTest.cxx   | 128 ++++++++++++++++++---------
 tests/GreenLagrangeElasticity.mfront |   9 +-
 tests/HenckyElasticity.mfront        |   9 +-
 3 files changed, 96 insertions(+), 50 deletions(-)

diff --git a/tests/DisplacementGradientTest.cxx b/tests/DisplacementGradientTest.cxx
index 7a9103c..961e0dd 100644
--- a/tests/DisplacementGradientTest.cxx
+++ b/tests/DisplacementGradientTest.cxx
@@ -142,7 +142,17 @@ struct Managers {
    * `getDisplacementGradient`)
    */
   void setGradients(const bool shear, const double scale = 1) {
+    this->setGradients(shear, scale, 0);
+  }
+  /*!
+   * \brief set the gradients at the end of the time step (see
+   * `getDisplacementGradient`), the axial component of the gradients given
+   * in plane stress being shifted by `axial`
+   */
+  void setGradients(const bool shear, const double scale, const double axial) {
     const auto ts = getTensorSize(this->F.hypothesis);
+    const auto ps =
+        this->F.hypothesis == mgis::behaviour::Hypothesis::PLANESTRESS;
     for (mgis::size_type i = 0; i != this->mF.n; ++i) {
       const auto Hv =
           getDisplacementGradient(i, shear, this->F.hypothesis, scale);
@@ -150,8 +160,9 @@ struct Managers {
       auto* const gF = this->mF.s1.gradients.data() + i * ts;
       auto* const gH = this->mH.s1.gradients.data() + i * ts;
       for (mgis::size_type j = 0; j != ts; ++j) {
-        gH[j] = static_cast<mgis::real>(Hv[j]);
-        gF[j] = static_cast<mgis::real>((j < 3 ? 1 : 0) + Hv[j]);
+        const auto shift = (ps && (j == 2)) ? axial : 0;
+        gH[j] = static_cast<mgis::real>(Hv[j] + shift);
+        gF[j] = static_cast<mgis::real>((j < 3 ? 1 : 0) + Hv[j] + shift);
       }
     }
   }
@@ -373,59 +384,88 @@ static void testConversions(const std::string& l, const std::string& b) {
 
 /*!
  * \brief plane stress: the axial component of the gradients is computed
- * by the behaviour. The Cauchy stress and the axial strain are compared
- * with an analytical solution for a diagonal displacement gradient
+ * by the behaviour, the one given by MGIS (one with the deformation
+ * gradient, zero with the displacement gradient) being ignored, as is a
+ * shifted one. The Cauchy stress or the first Piola-Kirchhoff stress, and
+ * the axial strain, are compared with an analytical solution for a
+ * diagonal gradient, with F and with H (strains multiplied by 1e3 in
+ * float, see testIntegration)
  */
 static void testPlaneStress(const std::string& l, const std::string& b) {
   using namespace mgis::behaviour;
   const auto h = Hypothesis::PLANESTRESS;
-  auto m = Managers(FiniteStrainBehaviourOptions{}, l, b, h, 4);
-  const auto test = l + ", " + b + ", plane stress: ";
-  m.setGradients(false);
-  m.integrate(test);
   const auto lambda = nu * young / ((1 + nu) * (1 - 2 * nu));
   const auto mu = young / (2 * (1 + nu));
   const auto c = -lambda / (lambda + 2 * mu);
   const auto hencky = b == "HenckyElasticity";
-  const auto nisvs = getArraySize(m.H.isvs, h);
-  const auto o = getVariableOffset(m.H.isvs, "AxialStrain", h);
-  auto e_s = 0.;
-  auto e_zz = 0.;
-  for (mgis::size_type i = 0; i != m.mH.n; ++i) {
-    const auto H = getDisplacementGradient(i, false, h);
-    // strains in the plane, axial strain, axial deformation gradient
-    const auto e0 = hencky ? std::log1p(H[0]) : H[0] + H[0] * H[0] / 2;
-    const auto e1 = hencky ? std::log1p(H[1]) : H[1] + H[1] * H[1] / 2;
-    const auto ezz = c * (e0 + e1);
-    const auto Fzz = hencky ? std::exp(ezz) : std::sqrt(1 + 2 * ezz);
-    const auto J = (1 + H[0]) * (1 + H[1]) * Fzz;
-    const auto tr = e0 + e1 + ezz;
-    // Kirchhoff stress (Hencky) or second Piola-Kirchhoff stress
-    const auto s0 = lambda * tr + 2 * mu * e0;
-    const auto s1 = lambda * tr + 2 * mu * e1;
-    const auto sig =
-        hencky ? std::array<double, 3>{s0 / J, s1 / J, 0}
-               : std::array<double, 3>{(1 + H[0]) * (1 + H[0]) * s0 / J,
-                                       (1 + H[1]) * (1 + H[1]) * s1 / J, 0};
-    const auto n = std::max(std::abs(sig[0]), std::abs(sig[1]));
-    for (int j = 0; j != 3; ++j) {
-      e_s = std::max(
-          e_s, std::abs(m.mH.s1.thermodynamic_forces[i * 4 + j] - sig[j]) / n);
+  const auto scale = mgis::tests::tolerance(1, 1e3);
+  for (const auto sm : {FiniteStrainBehaviourOptions::CAUCHY,
+                        FiniteStrainBehaviourOptions::PK1}) {
+    for (const auto axial : {0., 0.05}) {
+      const auto pk1 = sm == FiniteStrainBehaviourOptions::PK1;
+      auto o = FiniteStrainBehaviourOptions{};
+      o.stress_measure = sm;
+      auto m = Managers(o, l, b, h, 4);
+      const auto test = l + ", " + b + ", plane stress, " +
+                        std::string(pk1 ? "PK1" : "Cauchy") +
+                        ", axial component shifted by " +
+                        std::to_string(axial) + ": ";
+      m.setGradients(false, scale, axial);
+      m.integrate(test);
+      const auto nthfs = getArraySize(m.H.thermodynamic_forces, h);
+      const auto nisvs = getArraySize(m.H.isvs, h);
+      const auto oezz = getVariableOffset(m.H.isvs, "AxialStrain", h);
+      for (const auto* const mgr : {&m.mF, &m.mH}) {
+        auto e_s = 0.;
+        auto e_zz = 0.;
+        for (mgis::size_type i = 0; i != mgr->n; ++i) {
+          const auto H = getDisplacementGradient(i, false, h, scale);
+          // strains in the plane, axial strain, axial deformation gradient
+          const auto e0 = hencky ? std::log1p(H[0]) : H[0] + H[0] * H[0] / 2;
+          const auto e1 = hencky ? std::log1p(H[1]) : H[1] + H[1] * H[1] / 2;
+          const auto ezz = c * (e0 + e1);
+          const auto Fzz = hencky ? std::exp(ezz) : std::sqrt(1 + 2 * ezz);
+          const auto J = (1 + H[0]) * (1 + H[1]) * Fzz;
+          const auto tr = e0 + e1 + ezz;
+          // Kirchhoff stress (Hencky) or second Piola-Kirchhoff stress
+          const auto s0 = lambda * tr + 2 * mu * e0;
+          const auto s1 = lambda * tr + 2 * mu * e1;
+          auto sig = hencky ? std::array<double, 3>{s0 / J, s1 / J, 0}
+                            : std::array<double, 3>{
+                                  (1 + H[0]) * (1 + H[0]) * s0 / J,
+                                  (1 + H[1]) * (1 + H[1]) * s1 / J, 0};
+          if (pk1) {
+            // first Piola-Kirchhoff stress J sigma F^-T, diagonal here
+            sig[0] *= J / (1 + H[0]);
+            sig[1] *= J / (1 + H[1]);
+          }
+          const auto n = std::max(std::abs(sig[0]), std::abs(sig[1]));
+          for (int j = 0; j != 3; ++j) {
+            const auto v = static_cast<double>(
+                mgr->s1.thermodynamic_forces[i * nthfs + j]);
+            e_s = std::max(e_s, std::abs(v - sig[j]) / n);
+          }
+          const auto vzz = static_cast<double>(
+              mgr->s1.internal_state_variables[i * nisvs + oezz]);
+          e_zz = std::max(e_zz, std::abs(vzz - ezz) / std::abs(ezz));
+        }
+        // with F, the strains are only known within the rounding of F
+        const auto with_h = mgr == &m.mH;
+        const auto t = with_h ? mgis::tests::tolerance(1e-12, 1e-5)
+                              : mgis::tests::tolerance(1e-9, 1e-4);
+        const auto g = std::string(with_h ? "H" : "F");
+        check(e_s < t, test + "invalid stress with " + g + " (" +
+                           std::to_string(e_s) + ")");
+        check(e_zz < t, test + "invalid axial strain with " + g + " (" +
+                            std::to_string(e_zz) + ")");
+      }
     }
-    e_zz = std::max(
-        e_zz, std::abs(m.mH.s1.internal_state_variables[i * nisvs + o] - ezz) /
-                  std::abs(ezz));
   }
-  check(e_s < mgis::tests::tolerance(1e-12, 1e-5),
-        test + "invalid stress with H (" + std::to_string(e_s) + ")");
-  check(e_zz < mgis::tests::tolerance(1e-12, 1e-5),
-        test + "invalid axial strain with H (" + std::to_string(e_zz) + ")");
   if (hencky) {
-    // the Hencky strain framework overwrites the axial component of the
-    // deformation gradient, which is one in MGIS: same results with F and
-    // with H, shear included (strains multiplied by 1e3 in float, see
-    // testIntegration)
-    m.setGradients(true, mgis::tests::tolerance(1, 1e3));
+    // same results with F and with H, shear included
+    auto m = Managers(FiniteStrainBehaviourOptions{}, l, b, h, 4);
+    const auto test = l + ", " + b + ", plane stress: ";
+    m.setGradients(true, scale);
     m.integrate(test);
     const auto e =
         gap(m.mH.s1.thermodynamic_forces, m.mF.s1.thermodynamic_forces);
