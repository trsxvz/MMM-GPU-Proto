diff --git a/include/MGIS/FieldOperations/OpenACCFieldOperations.hxx b/include/MGIS/FieldOperations/OpenACCFieldOperations.hxx
new file mode 100644
index 0000000..e8f96e4
--- /dev/null
+++ b/include/MGIS/FieldOperations/OpenACCFieldOperations.hxx
@@ -0,0 +1,84 @@
+/*!
+ * \file   include/MGIS/FieldOperations/OpenACCFieldOperations.hxx
+ * \brief  This file declares the `OpenACCFieldOperations` class, which copies
+ * and fills views located in the memory of a device with the compute
+ * constructs of OpenACC.
+ * \date   20/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FIELDOPERATIONS_OPENACCFIELDOPERATIONS_HXX
+#define LIB_MGIS_FIELDOPERATIONS_OPENACCFIELDOPERATIONS_HXX
+
+#include <openacc.h>
+#include "MGIS/FieldOperations.hxx"
+
+namespace mgis::field_operations {
+
+  /*!
+   * \brief copies and fills of views located in the memory of the current
+   * device of OpenACC, with the compute constructs of OpenACC.
+   *
+   * The addresses of the views must be addresses of the device (for
+   * instance, allocated by `acc_malloc`). The operations are synchronous. A
+   * copy between two views with the same dense layout is a copy of a
+   * contiguous memory region (`acc_memcpy_device`); the other copies, and
+   * the fills, use a `parallel loop` construct. This is the counterpart of
+   * the `openacc` backend of the `generic-parallel` interface of `MFront`.
+   *
+   * This header is not compiled by `MGIS`: it is compiled by the calling
+   * code with a compiler supporting OpenACC (for instance `nvc++ -acc=gpu`).
+   */
+  struct OpenACCFieldOperations final : FieldOperations {
+    //! \brief default constructor
+    OpenACCFieldOperations() noexcept = default;
+
+   private:
+    void do_copy(const FieldView<real>& d,
+                 const FieldView<const real>& s) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nc = d.getNumberOfComponents();
+      auto* const dv = d.data();
+      // `acc_memcpy_device` and the `deviceptr` clause take non constant
+      // pointers: the source is only read
+      auto* const sv = const_cast<real*>(s.data());
+      if (haveSameDenseLayout(d, s)) {
+        acc_memcpy_device(dv, sv, n * nc * sizeof(real));
+        return;
+      }
+      const auto dps = d.getPointStride();
+      const auto dcs = d.getComponentStride();
+      const auto sps = s.getPointStride();
+      const auto scs = s.getComponentStride();
+      // one iteration per point: consecutive iterations process consecutive
+      // points of a component, without computing a division per value
+#pragma acc parallel loop deviceptr(dv, sv)
+      for (size_type i = 0; i < n; ++i) {
+        for (size_type j = 0; j < nc; ++j) {
+          dv[i * dps + j * dcs] = sv[i * sps + j * scs];
+        }
+      }
+    }  // end of do_copy
+    void do_fill(const FieldView<real>& d, const real v) override {
+      const auto n = d.getNumberOfPoints();
+      const auto nc = d.getNumberOfComponents();
+      auto* const dv = d.data();
+      const auto ps = d.getPointStride();
+      const auto cs = d.getComponentStride();
+#pragma acc parallel loop deviceptr(dv)
+      for (size_type i = 0; i < n; ++i) {
+        for (size_type j = 0; j < nc; ++j) {
+          dv[i * ps + j * cs] = v;
+        }
+      }
+    }  // end of do_fill
+  };  // end of OpenACCFieldOperations
+
+}  // end of namespace mgis::field_operations
+
+#endif /* LIB_MGIS_FIELDOPERATIONS_OPENACCFIELDOPERATIONS_HXX */
