+#include "MGIS/Function/BasicLinearSpace.hxx"
+#include "MGIS/Function/FieldViewSupport.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/MaterialFunctionManager.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+#include "MGIS/Behaviour/FiniteStrainSupport.hxx"
+
+using mgis::FieldLayout;
+using mgis::FieldView;
+using mgis::real;
+using mgis::size_type;
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+//! \return true if two values are identical, bit for bit
+static bool same(const real a, const real b) {
+  return std::bit_cast<std::uint64_t>(a) == std::bit_cast<std::uint64_t>(b);
+}  // end of same
+
+//! \return true if two views hold the same values, bit for bit
+static bool same(const FieldView<const real>& a,
+                 const FieldView<const real>& b) {
+  if ((a.getNumberOfPoints() != b.getNumberOfPoints()) ||
+      (a.getNumberOfComponents() != b.getNumberOfComponents())) {
+    return false;
+  }
+  for (size_type i = 0; i != a.getNumberOfPoints(); ++i) {
+    for (size_type j = 0; j != a.getNumberOfComponents(); ++j) {
+      if (!same(a(i, j), b(i, j))) {
+        return false;
+      }
+    }
+  }
+  return true;
+}  // end of same
+
+//! \brief copy the values of a view in another one
+static void copy(const FieldView<real>& dst, const FieldView<const real>& src) {
+  for (size_type i = 0; i != src.getNumberOfPoints(); ++i) {
+    for (size_type j = 0; j != src.getNumberOfComponents(); ++j) {
+      dst(i, j) = src(i, j);
+    }
+  }
+}  // end of copy
+
+//! \return a material data manager with the given layout
+static std::unique_ptr<mgis::behaviour::MaterialDataManager> makeManager(
+    const mgis::behaviour::Behaviour& b,
+    const size_type n,
+    const FieldLayout l) {
+  auto i = mgis::behaviour::MaterialDataManagerInitializer{};
+  i.layout = l;
+  return std::make_unique<mgis::behaviour::MaterialDataManager>(b, n, i);
+}  // end of makeManager
+
+//! \brief copy the states of a material data manager in another one
+static void copyStates(mgis::behaviour::MaterialDataManager& dst,
+                       const mgis::behaviour::MaterialDataManager& src) {
+  using namespace mgis::behaviour;
+  for (const auto& [d, s] :
+       {std::pair<MaterialStateManager*, const MaterialStateManager*>{&dst.s0,
+                                                                      &src.s0},
+        std::pair<MaterialStateManager*, const MaterialStateManager*>{
+            &dst.s1, &src.s1}}) {
+    copy(getGradientsView(*d), getGradientsView(*s));
+    copy(getThermodynamicForcesView(*d), getThermodynamicForcesView(*s));
+    copy(getInternalStateVariablesView(*d), getInternalStateVariablesView(*s));
+  }
+}  // end of copyStates
+
+/*!
+ * \return true if the outputs of two material data managers are the same,
+ * bit for bit
+ */
+static bool haveSameOutputs(const mgis::behaviour::MaterialDataManager& a,
+                            const mgis::behaviour::MaterialDataManager& b) {
+  using namespace mgis::behaviour;
+  return same(getThermodynamicForcesView(a.s1),
+              getThermodynamicForcesView(b.s1)) &&
+         same(getInternalStateVariablesView(a.s1),
+              getInternalStateVariablesView(b.s1)) &&
+         same(getTangentOperatorBlocksView(a), getTangentOperatorBlocksView(b));
+}  // end of haveSameOutputs
+
+/*!
+ * \brief integration of the Norton behaviour, extraction of the internal
+ * state variables, views on the variables and on the tangent operator
+ */
+static void testIntegration(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{9};
+  auto ma = makeManager(b, n, FieldLayout::POINT_BY_POINT);
+  auto mc = makeManager(b, n, FieldLayout::COMPONENT_BY_COMPONENT);
+  check(mc->s0.layout == FieldLayout::COMPONENT_BY_COMPONENT,
+        "Norton: invalid layout");
+  for (auto* const m : {ma.get(), mc.get()}) {
+    setExternalStateVariable(m->s0, "Temperature", 293.15);
+    setExternalStateVariable(m->s1, "Temperature", 293.15);
+  }
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  for (int step = 0; step != 3; ++step) {
+    const auto e = getGradientsView(ma->s1);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != 6; ++c) {
+        e(i, c) += 1e-4 * static_cast<real>((step + 1) * (c + 1)) *
+                   (1 + 0.1 * static_cast<real>(i));
+      }
+    }
+    copyStates(*mc, *ma);
+    const auto ra = integrate(*ma, opts, 180);
+    const auto rc = integrate(*mc, opts, 180);
+    check(ra.exit_status == rc.exit_status, "Norton: invalid status");
+    check(haveSameOutputs(*ma, *mc), "Norton: invalid outputs, " + library);
+    update(*ma);
+    update(*mc);
+  }
+  // views on a variable and on the tangent operator block
+  check(same(getInternalStateVariableView(ma->s0, "ElasticStrain"),
+             getInternalStateVariableView(mc->s0, "ElasticStrain")),
+        "Norton: invalid views of the elastic strain");
+  check(same(getTangentOperatorBlockView(*ma, "Stress", "Strain"),
+             getTangentOperatorBlockView(*mc, "Stress", "Strain")),
+        "Norton: invalid views of the tangent operator block");
+  // extraction of internal state variables, in the layout of the manager
+  for (const auto* const v :
+       {"EquivalentViscoplasticStrain", "ElasticStrain"}) {
+    const auto nc = getVariableSize(getVariable(b.isvs, v), b.hypothesis);
+    auto va = std::vector<real>(n * nc);
+    auto vc = std::vector<real>(n * nc);
+    extractInternalStateVariable(va, ma->s0, v);
+    extractInternalStateVariable(vc, mc->s0, v);
+    check(same(mgis::makeFieldView(std::span<const real>(va),
+                                   FieldLayout::POINT_BY_POINT, n, nc),
+               mgis::makeFieldView(std::span<const real>(vc),
+                                   FieldLayout::COMPONENT_BY_COMPONENT, n, nc)),
+          std::string{"Norton: invalid extraction of "} + v);
+    // extraction in a view with another layout
+    auto vp = std::vector<real>(n * (nc + 1));
+    const auto p =
+        mgis::makePointByPointFieldView(std::span<real>(vp), n, nc, nc + 1);
+    extractInternalStateVariable(p, mc->s0, v);
+    check(same(p, getInternalStateVariableView(ma->s0, v)),
+          std::string{"Norton: invalid extraction in a view of "} + v);
+  }
+}  // end of testIntegration
+
+//! \brief deformation gradient set to the identity, finite strain outputs
+static void testFiniteStrain(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b =
+      load(FiniteStrainBehaviourOptions{}, library,
+           "OrthotropicFiniteStrainElasticity", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{5};
+  auto ma = makeManager(b, n, FieldLayout::POINT_BY_POINT);
+  auto mc = makeManager(b, n, FieldLayout::COMPONENT_BY_COMPONENT);
+  check(same(getGradientsView(ma->s0), getGradientsView(mc->s0)) &&
+            same(getGradientsView(ma->s1), getGradientsView(mc->s1)),
+        "finite strain: invalid initial deformation gradients");
+  const auto F = getGradientsView(mc->s1);
+  check(same(F(n - 1, 2), 1) && same(F(n - 1, 3), 0),
+        "finite strain: invalid identity");
+  for (auto* const m : {ma.get(), mc.get()}) {
+    setExternalStateVariable(m->s0, "Temperature", 293.15);
+    setExternalStateVariable(m->s1, "Temperature", 293.15);
+  }
+  const auto Fa = getGradientsView(ma->s1);
+  for (size_type i = 0; i != n; ++i) {
+    Fa(i, 0) = 1 + 1e-3 * static_cast<real>(i + 1);
+    Fa(i, 1) = 1 - 2e-4 * static_cast<real>(i);
+    Fa(i, 3) = 3e-4;
+    Fa(i, 4) = -1e-4;
+  }
+  copyStates(*mc, *ma);
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  static_cast<void>(integrate(*ma, opts, 1));
+  static_cast<void>(integrate(*mc, opts, 1));
+  check(haveSameOutputs(*ma, *mc), "finite strain: invalid outputs");
+  // conversions, in the layout of the manager
+  auto Pa = std::vector<real>(9 * n);
+  auto Pc = std::vector<real>(9 * n);
+  auto sa = std::span<real>(Pa);
+  auto sc = std::span<real>(Pc);
+  convertFiniteStrainStress(sa, *ma, FiniteStrainStress::PK1);
+  convertFiniteStrainStress(sc, *mc, FiniteStrainStress::PK1);
+  check(same(mgis::makeFieldView(std::span<const real>(Pa),
+                                 FieldLayout::POINT_BY_POINT, n, 9),
+             mgis::makeFieldView(std::span<const real>(Pc),
+                                 FieldLayout::COMPONENT_BY_COMPONENT, n, 9)),
+        "finite strain: invalid first Piola-Kirchhoff stress");
+  auto Ka = std::vector<real>(81 * n);
+  auto Kc = std::vector<real>(81 * n);
+  auto ka = std::span<real>(Ka);
+  auto kc = std::span<real>(Kc);
+  convertFiniteStrainTangentOperator(ka, *ma,
+                                     FiniteStrainTangentOperator::DPK1_DF);
+  convertFiniteStrainTangentOperator(kc, *mc,
+                                     FiniteStrainTangentOperator::DPK1_DF);
+  check(same(mgis::makeFieldView(std::span<const real>(Ka),
+                                 FieldLayout::POINT_BY_POINT, n, 81),
+             mgis::makeFieldView(std::span<const real>(Kc),
+                                 FieldLayout::COMPONENT_BY_COMPONENT, n, 81)),
+        "finite strain: invalid derivative of the first Piola-Kirchhoff "
+        "stress");
+}  // end of testFiniteStrain
+
+/*!
+ * \brief inputs of the initialize functions and outputs of the
+ * post-processings, in the layout of the manager
+ */
+static void testInputsAndOutputs(const std::string& library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = size_type{7};
+  {
+    const auto b =
+        load(library, "InitializeFunctionTest", Hypothesis::TRIDIMENSIONAL);
+    auto ma = makeManager(b, n, FieldLayout::POINT_BY_POINT);
+    auto mc = makeManager(b, n, FieldLayout::COMPONENT_BY_COMPONENT);
+    auto pressures = std::vector<real>(n);
+    for (size_type i = 0; i != n; ++i) {
+      pressures[i] = -1e5 * static_cast<real>(i + 1);
+    }
+    for (auto* const m : {ma.get(), mc.get()}) {
+      setExternalStateVariable(m->s0, "Temperature", 293.15);
+      setExternalStateVariable(m->s1, "Temperature", 293.15);
+      static_cast<void>(executeInitializeFunction(
+          *m, "StressFromInitialPressure", pressures));
+    }
+    check(same(getThermodynamicForcesView(ma->s1),
+               getThermodynamicForcesView(mc->s1)),
+          "initialize function: invalid thermodynamic forces");
+  }
+  const auto b =
+      load(library, "PostProcessingTest", Hypothesis::TRIDIMENSIONAL);
+  auto ma = makeManager(b, n, FieldLayout::POINT_BY_POINT);
+  auto mc = makeManager(b, n, FieldLayout::COMPONENT_BY_COMPONENT);
+  for (auto* const m : {ma.get(), mc.get()}) {
+    for (auto* const s : {&m->s0, &m->s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    const auto e = getGradientsView(m->s1);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != 3; ++c) {
+        e(i, c) = 1e-3 * static_cast<real>((i + 1) * (c + 1));
+      }
+      e(i, 3) = 1e-4;
+    }
+  }
+  auto oa = allocatePostProcessingVariables(*ma, "PrincipalStrain");
+  auto oc = allocatePostProcessingVariables(*mc, "PrincipalStrain");
+  static_cast<void>(executePostProcessing(oa, *ma, "PrincipalStrain"));
+  static_cast<void>(executePostProcessing(oc, *mc, "PrincipalStrain"));
+  check(same(mgis::makeFieldView(std::span<const real>(oa),
+                                 FieldLayout::POINT_BY_POINT, n, 3),
+             mgis::makeFieldView(std::span<const real>(oc),
+                                 FieldLayout::COMPONENT_BY_COMPONENT, n, 3)),
+        "post-processing: invalid outputs");
+}  // end of testInputsAndOutputs
+
+//! \brief external state variables with several components given by spans
+static void testExternalStateVariables(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "TensorialExternalStateVariableTest",
+                      Hypothesis::TRIDIMENSIONAL);
+  const auto h = b.hypothesis;
+  constexpr auto n = size_type{5};
+  auto ma = makeManager(b, n, FieldLayout::POINT_BY_POINT);
+  auto mc = makeManager(b, n, FieldLayout::COMPONENT_BY_COMPONENT);
+  // values point by point (manager ma) and component by component (mc)
+  auto values = std::vector<std::vector<real>>{};
+  values.reserve(2 * b.esvs.size());
+  for (const auto& v : b.esvs) {
+    const auto nc = getVariableSize(v, h);
+    auto& va = values.emplace_back(n * nc);
+    auto& vc = values.emplace_back(n * nc);
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type c = 0; c != nc; ++c) {
+        va[i * nc + c] = vc[c * n + i] =
+            std::sin(static_cast<real>(values.size() + 7 * (i * nc + c)));
+      }
+    }
+  }
+  for (auto* const m : {ma.get(), mc.get()}) {
+    for (auto* const s : {&m->s0, &m->s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+    }
+  }
+  for (std::size_t k = 0; k != b.esvs.size(); ++k) {
+    const auto& v = b.esvs[k];
+    for (auto* const s : {&ma->s0, &ma->s1}) {
+      setExternalStateVariable(*s, v.name, values[2 * k],
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    for (auto* const s : {&mc->s0, &mc->s1}) {
+      setExternalStateVariable(*s, v.name, values[2 * k + 1],
+                               MaterialStateManager::EXTERNAL_STORAGE);
+    }
+  }
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  static_cast<void>(integrate(*ma, opts, 1));
+  static_cast<void>(integrate(*mc, opts, 1));
+  check(same(getInternalStateVariablesView(ma->s1),
+             getInternalStateVariablesView(mc->s1)),
+        "external state variables: invalid internal state variables");
+  // states of different layouts can't be updated one from the other
+  auto ctx = mgis::Context{};
+  check(!updateValues(ctx, ma->s0, mc->s1),
+        "external state variables: layouts not checked by updateValues");
+}  // end of testExternalStateVariables
+
+//! \brief material function managers
+static void testMaterialFunctionManager(const std::string& library) {
+  using namespace mgis::behaviour;
+  using mgis::function::BasicLinearSpace;
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{4};
+  auto qspace = std::make_shared<BasicLinearSpace>(n);
+  auto i = MaterialDataManagerInitializer{};
+  i.layout = FieldLayout::COMPONENT_BY_COMPONENT;
+  auto m = MaterialFunctionManager<BasicLinearSpace>{qspace, b, i};
+  const auto e = getGradientsView(m.s1);
+  for (size_type k = 0; k != n; ++k) {
+    for (size_type c = 0; c != 6; ++c) {
+      e(k, c) = static_cast<real>(10 * k + c);
+    }
+  }
+  auto ctx = mgis::Context{};
+  // the values of a scalar variable are contiguous
+  const auto p =
+      getInternalStateVariable(ctx, m, "EquivalentViscoplasticStrain");
+  check(p.has_value(), "material function manager: scalar variable rejected");
+  // the other variables require a strided coalesced view
+  const auto og = getGradient(ctx, m, "Strain");
+  check(!og.has_value(),
+        "material function manager: invalid view of a vector variable");
+  const auto sg = getStridedCoalescedGradient<6>(ctx, m, "Strain");
+  if (check(sg.has_value(), "material function manager: no coalesced view")) {
+    check(same(sg->getValues(2)[3], 23),
+          "material function manager: invalid coalesced view");
+    check(same(mgis::function::makeFieldView(*sg),
+               FieldView<const real>(getGradientView(m.s1, "Strain"))),
+          "material function manager: invalid conversion to a field view");
+  }
+  // a point by point manager has no coalesced views
+  auto ma = MaterialFunctionManager<BasicLinearSpace>{qspace, b};
+  check(!getStridedCoalescedGradient<6>(ctx, ma, "Strain").has_value(),
+        "material function manager: invalid coalesced view of a point by "
+        "point manager");
+  const auto ga = getGradient<6>(ctx, ma, "Strain");
+  if (check(ga.has_value(), "material function manager: no view")) {
+    check(mgis::function::makeFieldView(*ga).getPointStride() == 6,
+          "material function manager: invalid conversion to a field view");
+  }
+}  // end of testMaterialFunctionManager
+
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0]
+              << " generic-parallel-library generic-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    for (const auto* const library : {argv[2], argv[1]}) {
+      testIntegration(library);
+      testFiniteStrain(library);
+      testInputsAndOutputs(library);
+      testExternalStateVariables(library);
+    }
+    testMaterialFunctionManager(argv[2]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
