+/*!
+ * \file   tests/MaterialDataManagerLayoutTest.cxx
+ * \brief  This test compares material data managers whose arrays are stored
+ * point by point and component by component: integration (point by point and
+ * as a batch), initialization of the deformation gradient, views on the
+ * arrays, extraction of the internal state variables, inputs of the
+ * initialize functions and outputs of the post-processings, conversions of
+ * the finite strain outputs, external state variables with several
+ * components and material function managers.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <bit>
+#include <cmath>
+#include <span>
+#include <array>
+#include <string>
+#include <vector>
+#include <memory>
+#include <cstdint>
