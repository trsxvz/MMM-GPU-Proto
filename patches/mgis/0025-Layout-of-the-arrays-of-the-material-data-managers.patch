+/*!
+ * \file   include/MGIS/Function/FieldViewSupport.hxx
+ * \brief  This file declares conversions of the views of `mgis::function` to
+ * the views used by the functions on batches of points (`FieldView`).
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_FUNCTION_FIELDVIEWSUPPORT_HXX
+#define LIB_MGIS_FUNCTION_FIELDVIEWSUPPORT_HXX
+
+#include "MGIS/FieldView.hxx"
+#include "MGIS/Function/Function.hxx"
+#include "MGIS/Function/StridedCoalescedMemoryAccessFunctionViewBase.hxx"
+
+namespace mgis::function {
+
+  /*
+   * The conversions only go from the views of `mgis::function` to
+   * `FieldView`. The views with a coalesced memory access holding one pointer
+   * per component (`CoalescedMemoryAccessFunctionViewBase`) have no
+   * equivalent: a `FieldView` holds one pointer, as the fields of the
+   * functions generated by `MFront` for batches of points.
+   */
+
+  /*!
+   * \return a view on the values of a function stored point by point
+   * \param[in] f: function view
+   */
+  template <LinearFunctionalSpaceConcept Space,
+            FunctionDataLayoutDescription layout,
+            bool is_mutable>
+  FieldView<std::conditional_t<is_mutable, real, const real>> makeFieldView(
+      FunctionView<Space, layout, is_mutable>& f) {
+    using ValueType = std::conditional_t<is_mutable, real, const real>;
+    const auto n = static_cast<size_type>(getSpaceSize(f.getSpace()));
+    return FieldView<ValueType>(f.data(), n, f.getNumberOfComponents(),
+                                f.getDataStride(), 1);
+  }  // end of makeFieldView
+
+  /*!
+   * \return a constant view on the values of a function stored point by
+   * point
+   * \param[in] f: function view
+   */
+  template <LinearFunctionalSpaceConcept Space,
+            FunctionDataLayoutDescription layout,
+            bool is_mutable>
+  FieldView<const real> makeFieldView(
+      const FunctionView<Space, layout, is_mutable>& f) {
+    const auto n = static_cast<size_type>(getSpaceSize(f.getSpace()));
+    return FieldView<const real>(f.data(), n, f.getNumberOfComponents(),
+                                 f.getDataStride(), 1);
+  }  // end of makeFieldView
+
+  /*!
+   * \return a view on the values of a function stored component by
+   * component (strided coalesced memory access)
+   * \param[in] f: function view
+   */
+  template <FunctionalSpaceConcept Space, size_type N, bool is_mutable>
+  FieldView<std::conditional_t<is_mutable, real, const real>> makeFieldView(
+      const StridedCoalescedMemoryAccessFunctionViewBase<Space, N, is_mutable>&
+          f) {
+    using ValueType = std::conditional_t<is_mutable, real, const real>;
+    const auto n = static_cast<size_type>(getSpaceSize(f.getSpace()));
+    return FieldView<ValueType>(f.data(), n, N, 1, n);
+  }  // end of makeFieldView
+
+}  // end of namespace mgis::function
+
+#endif /* LIB_MGIS_FUNCTION_FIELDVIEWSUPPORT_HXX */
