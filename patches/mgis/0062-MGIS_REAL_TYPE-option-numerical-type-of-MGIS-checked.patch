     d.interface = lm.getInterface(l, b);
     if (isGenericParallelBehaviour(d)) {
+      constexpr auto gp_api_version = MGIS_BV_GENERIC_PARALLEL_API_VERSION +
+                                      MGIS_REAL_TYPE_API_VERSION_OFFSET;
       const auto v = lm.getGenericParallelAPIVersion(l, b);
