diff --git a/src/LibrariesManager.cxx b/src/LibrariesManager.cxx
index d7627a8..6ffc90e 100644
--- a/src/LibrariesManager.cxx
+++ b/src/LibrariesManager.cxx
@@ -882,10 +882,45 @@ namespace mgis {
         this->extract<const char *>(l, n + "_generic_parallel_memory_space"));
   }  // end of getGenericParallelMemorySpace
 
+  unsigned short LibrariesManager::getRealSize(const std::string& l,
+                                               const std::string& n) {
+    const auto p = this->getSymbolAddress(l, n + "_real_size");
+    if (p == nullptr) {
+      return static_cast<unsigned short>(sizeof(double));
+    }
+    return *(static_cast<const unsigned short*>(p));
+  }  // end of getRealSize
+
+  void LibrariesManager::checkRealType(const char* const m,
+                                       const std::string& l,
+                                       const std::string& n) {
+    const auto s = this->getRealSize(l, n);
+    if (s == sizeof(real)) {
+      return;
+    }
+    const auto type_name = [](const std::size_t size) -> std::string {
+      if (size == sizeof(double)) {
+        return "double";
+      } else if (size == sizeof(float)) {
+        return "float";
+      }
+      return "unknown type";
+    };
+    mgis::raise(std::string{m} + ": entry point '" + n + "' in library '" + l +
+                "' uses a numerical type of " + std::to_string(s) + " bytes (" +
+                type_name(s) + "), whereas MGIS uses " +
+                std::to_string(sizeof(real)) + " bytes (" +
+                type_name(sizeof(real)) +
+                "): the library must be generated with the numerical type "
+                "of MGIS (real_type option of mfront, MGIS_REAL_TYPE option "
+                "of the configuration of MGIS)");
+  }  // end of checkRealType
+
   void LibrariesManager::checkBatchInterface(const char *const m,
                                              const std::string &l,
                                              const std::string &n,
                                              const bool batch) {
+    this->checkRealType(m, l, n);
     const auto generic_parallel = this->getInterface(l, n) == "GenericParallel";
     if (generic_parallel == batch) {
       return;
