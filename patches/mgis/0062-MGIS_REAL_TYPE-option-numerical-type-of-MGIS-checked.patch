                    std::to_string(v) + ", mgis uses version " +
-                   std::to_string(MGIS_BV_GENERIC_PARALLEL_API_VERSION) + ")");
+                   std::to_string(gp_api_version) + ")");
       d.backend = lm.getGenericParallelBackend(l, b);
       d.memory_space = lm.getGenericParallelMemorySpace(l, b);
       raise_if(!isValidMemorySpace(d.memory_space),
