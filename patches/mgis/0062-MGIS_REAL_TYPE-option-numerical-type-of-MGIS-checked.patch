diff --git a/include/MGIS/RealType.h.in b/include/MGIS/RealType.h.in
new file mode 100644
index 0000000..9fee0b8
--- /dev/null
+++ b/include/MGIS/RealType.h.in
@@ -0,0 +1,24 @@
+/*!
+ * \file   include/MGIS/RealType.h
+ * \brief  This file, generated at the configuration of MGIS, gives its
+ * numerical type, chosen by the `MGIS_REAL_TYPE` option of CMake.
+ * \date   13/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_REALTYPE_H
+#define LIB_MGIS_REALTYPE_H
+
+/*!
+ * \brief numerical type of MGIS (`double` or `float`), which must be the
+ * one of the behaviours, of the material properties and of the models
+ * (`real_type` option of `mfront`)
+ */
+#define MGIS_CONFIGURED_REAL_TYPE @MGIS_REAL_TYPE@
+
+#endif /* LIB_MGIS_REALTYPE_H */
