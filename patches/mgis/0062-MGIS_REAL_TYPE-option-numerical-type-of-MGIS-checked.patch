       msg += "- the behaviour uses API version ";
       msg += std::to_string(lm.getAPIVersion(l, b)) + "\n";
       msg += "- mgis uses API version ";
-      msg += std::to_string(MGIS_BEHAVIOUR_API_VERSION);
