From 9d2b1a4f0b6832b5eea1744acec5b9d6de59ba45 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 19:34:46 +0200
Subject: [PATCH] MGIS_REAL_TYPE option: numerical type of MGIS, checked at
 loading

- the MGIS_REAL_TYPE option of CMake (double by default, or float) is
  written in the generated header MGIS/RealType.h, installed and included
  by MGIS/Config-c.h, and exported by the installed CMake configuration.
  A MGIS_REAL_TYPE macro defined by the calling code, which selected the
  type before, must now agree with it. The python, fortran, fenics and
  julia bindings require double.
- the numerical type of an entry point (symbol <n>_real_size of the
  libraries generated by MFront, double if it is not defined) is checked
  by every accessor of LibrariesManager (through checkBatchInterface) and
  before the versions of the behaviours and of the material properties,
  with a message giving both types; the expected versions are shifted by
  1000 for a type other than double, as in MFront. The models, generated
  in double, are thus refused by a MGIS in float.
- the ordered key of the time step scaling factor is built from its value
  converted to double, as in MFront; the test of the positive zero of the
  fill operations of CUDA and HIP uses an integer of the size of the type.
---
 CMakeLists.txt                                | 18 ++++++++++
 include/CMakeLists.txt                        |  5 +++
 include/MGIS/Behaviour/BatchDataView.hxx      |  8 +++--
 include/MGIS/Config-c.h                       | 33 ++++++++++++++---
 .../FieldOperations/CUDAFieldOperations.hxx   |  8 +++--
 .../FieldOperations/HIPFieldOperations.hxx    |  8 +++--
 include/MGIS/LibrariesManager.hxx             | 21 +++++++++++
 include/MGIS/RealType.h.in                    | 24 +++++++++++++
 src/BehaviourDescription.cxx                  | 15 +++++---
 src/CMakeLists.txt                            |  2 ++
 src/LibrariesManager.cxx                      | 35 +++++++++++++++++++
 src/MFrontGenericInterfaceConfig.cmake.in     |  2 ++
 src/MaterialProperty.cxx                      |  9 +++--
 13 files changed, 170 insertions(+), 18 deletions(-)
 create mode 100644 include/MGIS/RealType.h.in

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cf29b58..630b702 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -135,6 +135,24 @@ if(enable-julia-bindings)
   set(CMAKE_CXX_STANDARD "${_CMAKE_CXX_STANDARD}")
 endif(enable-julia-bindings)
 
+# numerical type of MGIS (mgis::real), which must be the one of the
+# behaviours, of the material properties and of the calling code
+set(MGIS_REAL_TYPE "double" CACHE STRING "numerical type of MGIS (double or float)")
+set_property(CACHE MGIS_REAL_TYPE PROPERTY STRINGS double float)
+if(NOT ((MGIS_REAL_TYPE STREQUAL "double") OR (MGIS_REAL_TYPE STREQUAL "float")))
+  message(FATAL_ERROR "invalid value '${MGIS_REAL_TYPE}' of MGIS_REAL_TYPE "
+                      "(double or float)")
+endif()
+if((NOT MGIS_REAL_TYPE STREQUAL "double") AND
+   (enable-python-bindings OR enable-fortran-bindings OR
+    enable-fenics-bindings OR enable-julia-bindings))
+  message(FATAL_ERROR "the python, fortran, fenics and julia bindings "
+                      "require MGIS_REAL_TYPE=double")
+endif()
+message(STATUS "numerical type   : ${MGIS_REAL_TYPE}")
+# generated headers (MGIS/RealType.h), before the headers of the sources
+include_directories(BEFORE ${PROJECT_BINARY_DIR}/include)
+
 # HDF5 support (optional)
 
 option(enable-hdf5-support "enable HDF5 support" OFF)
diff --git a/include/CMakeLists.txt b/include/CMakeLists.txt
index 6ec2196..1fff45a 100644
--- a/include/CMakeLists.txt
+++ b/include/CMakeLists.txt
@@ -1,4 +1,9 @@
 mgis_header(MGIS Config-c.h)
+# numerical type chosen by the MGIS_REAL_TYPE option
+configure_file(${CMAKE_CURRENT_SOURCE_DIR}/MGIS/RealType.h.in
+               ${PROJECT_BINARY_DIR}/include/MGIS/RealType.h @ONLY)
+install(FILES ${PROJECT_BINARY_DIR}/include/MGIS/RealType.h
+        DESTINATION include/MGIS)
 mgis_header(MGIS Config.hxx)
 mgis_header(MGIS MemoryLocation.hxx)
 mgis_header(MGIS BatchExecutionPolicy.hxx)
diff --git a/include/MGIS/Behaviour/BatchDataView.hxx b/include/MGIS/Behaviour/BatchDataView.hxx
index 18980ce..a204097 100644
--- a/include/MGIS/Behaviour/BatchDataView.hxx
+++ b/include/MGIS/Behaviour/BatchDataView.hxx
@@ -317,12 +317,14 @@ namespace mgis::behaviour {
    * \brief initialize the statistics of a batch
    * \param[out] s: statistics
    * \param[in] rdt: initial value of the time step scaling factor
+   *
+   * \note as in MFront, the ordered key is built from the value converted to
+   * `double`, whatever the numerical type
    */
   inline void initializeBatchStatistics(BatchStatistics& s,
                                         const mgis::real rdt) noexcept {
-    static_assert(sizeof(mgis::real) == sizeof(unsigned long long));
     constexpr auto sign = 0x8000000000000000ull;
-    const auto b = std::bit_cast<unsigned long long>(rdt);
+    const auto b = std::bit_cast<unsigned long long>(static_cast<double>(rdt));
     s.number_of_failures = 0;
     s.first_failure_index = ~0ull;
     s.number_of_unreliable_results = 0;
@@ -337,7 +339,7 @@ namespace mgis::behaviour {
       const BatchStatistics& s) noexcept {
     constexpr auto sign = 0x8000000000000000ull;
     const auto b = (s.rdt & sign) ? (s.rdt & ~sign) : ~(s.rdt);
-    return std::bit_cast<mgis::real>(b);
+    return static_cast<mgis::real>(std::bit_cast<double>(b));
   }  // end of getTimeStepScalingFactor
 
   /*!
diff --git a/include/MGIS/Config-c.h b/include/MGIS/Config-c.h
index c8c2119..41435b3 100644
--- a/include/MGIS/Config-c.h
+++ b/include/MGIS/Config-c.h
@@ -108,12 +108,35 @@
 #define MGIS_NORETURN [[noreturn]]
 #endif
 
+#include "MGIS/RealType.h"
+
+/*!
+ * \brief alias to the numeric type used in the library, chosen at the
+ * configuration of MGIS (`MGIS_REAL_TYPE` option of CMake)
+ */
+typedef MGIS_CONFIGURED_REAL_TYPE mgis_real;
+
+/*!
+ * \brief offset of the versions of the application programming interfaces
+ * of the libraries generated with a numerical type other than `double`,
+ * added to the versions expected by MGIS (see the
+ * `MFRONT_GB_REAL_TYPE_API_VERSION_OFFSET` macro of MFront)
+ */
+#define MGIS_REAL_TYPE_API_VERSION_OFFSET \
+  (sizeof(mgis_real) == sizeof(double) ? 0 : 1000)
+
 #ifdef MGIS_REAL_TYPE
-    /*! \brief alias to the numeric type used in the library */
-    typedef MGIS_REAL_TYPE mgis_real;
-#else  /* MGIS_REAL_TYPE */
-    /*! \brief alias to the numeric type used in the library */
-    typedef double mgis_real;
+/* the MGIS_REAL_TYPE macro, which selected the numeric type before the
+   option of CMake, must agree with the numeric type of the library */
+#ifdef __cplusplus
+static_assert(sizeof(MGIS_REAL_TYPE) == sizeof(mgis_real),
+              "the MGIS_REAL_TYPE macro differs from the numeric type of "
+              "MGIS (MGIS_REAL_TYPE option of CMake)");
+#else  /* __cplusplus */
+typedef char mgis_real_type_check[(sizeof(MGIS_REAL_TYPE) == sizeof(mgis_real))
+                                      ? 1
+                                      : -1];
+#endif /* __cplusplus */
 #endif /* MGIS_REAL_TYPE */
 
 //! alias to the index type type used in the library
