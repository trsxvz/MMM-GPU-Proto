new file mode 100644
index 0000000..17a9ad1
--- /dev/null
+++ b/include/MGIS/MemoryLocation.hxx
@@ -0,0 +1,101 @@
+/*!
+ * \file   include/MGIS/MemoryLocation.hxx
+ * \brief  This file declares the `MemoryLocation` enumeration and the
+ * memory spaces of the libraries generated by the `generic-parallel`
+ * interfaces of `MFront`.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_MEMORYLOCATION_HXX
+#define LIB_MGIS_MEMORYLOCATION_HXX
+
+#include <string_view>
+#include <memory_resource>
+
+namespace mgis {
+
+  /*!
+   * \brief location of arrays (material data manager, values of a material
+   * property), declared by the code which allocates them. It is a property
+   * of the data, checked against the memory space of the libraries
+   * generated by the `generic-parallel` interfaces of `MFront` and against
+   * the functions which access the arrays on the host.
+   */
+  enum struct MemoryLocation {
+    //! \brief ordinary memory of the host
+    HOST,
+    //! \brief memory of a device, which is not accessible by the host
+    DEVICE,
+    /*!
+     * \brief memory accessible by the host and by the device (managed
+     * memory, shared memory of SYCL, etc.)
+     */
+    SHARED
+  };
+
+  /*!
+   * \return true if the computations of a library generated by `MFront`
+   * can access data located in the given memory location
+   * \param[in] s: memory space of the library, exported by the libraries
+   * generated by the `generic-parallel` interfaces: `host` (computations on
+   * the host), `device` (computations on a device which can't access the
+   * ordinary memory of the host) or `any`. The libraries generated by the
+   * other interfaces compute on the host (empty memory space).
+   * \param[in] l: memory location
+   */
+  constexpr bool isMemoryLocationAccessible(const std::string_view s,
+                                            const MemoryLocation l) noexcept {
+    if ((l == MemoryLocation::SHARED) || (s == "any")) {
+      return true;
+    }
+    if (s == "device") {
+      return l == MemoryLocation::DEVICE;
+    }
+    // computations on the host
+    return l == MemoryLocation::HOST;
+  }  // end of isMemoryLocationAccessible
+
+  //! \return a description of the given memory location, for messages
+  constexpr const char* getMemoryLocationDescription(
+      const MemoryLocation l) noexcept {
+    if (l == MemoryLocation::HOST) {
+      return "the memory of the host";
+    }
+    return l == MemoryLocation::DEVICE ? "the memory of a device"
+                                       : "a shared memory";
+  }  // end of getMemoryLocationDescription
+
+  //! \return true if the given memory space is valid
+  constexpr bool isValidMemorySpace(const std::string_view s) noexcept {
+    return (s == "host") || (s == "device") || (s == "any");
+  }  // end of isValidMemorySpace
+
+  //! \return true if the given memory location is accessible by the host
+  constexpr bool isHostAccessible(const MemoryLocation l) noexcept {
+    return l != MemoryLocation::DEVICE;
+  }  // end of isHostAccessible
+
+  /*!
+   * \return true if MGIS can allocate arrays in the given memory location:
+   * memory of the host, or shared memory allocated by a memory resource given
+   * by the calling code. The values of those arrays are initialized by the
+   * host.
+   * \param[in] l: memory location
+   * \param[in] r: memory resource given by the calling code, if any
+   */
+  constexpr bool canAllocateIn(
+      const MemoryLocation l,
+      const std::pmr::memory_resource* const r) noexcept {
+    return (l == MemoryLocation::HOST) ||
+           ((l == MemoryLocation::SHARED) && (r != nullptr));
+  }  // end of canAllocateIn
+
+}  // end of namespace mgis
+
+#endif /* LIB_MGIS_MEMORYLOCATION_HXX */
