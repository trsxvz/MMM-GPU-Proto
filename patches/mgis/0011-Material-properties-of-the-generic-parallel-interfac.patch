+  /*!
+   * \brief check the arguments of the evaluation of a material property
+   * \param[in] n: number of points
+   * \param[in] mp: material property
+   * \param[in] inputs: values of the inputs
+   * \param[in] l: location of the values
+   */
+  static void checkEvaluationArguments(
+      const size_type n,
+      const MaterialProperty &mp,
+      const std::span<const std::span<const real>> inputs,
+      const MemoryLocation l) {
+    if (inputs.size() != mp.inputs.size()) {
+      mgis::raise("evaluate: invalid number of inputs for material property '" +
+                  mp.material_property + "' (" + std::to_string(inputs.size()) +
+                  " given, " + std::to_string(mp.inputs.size()) + " expected)");
+    }
+    for (size_type i = 0; i != inputs.size(); ++i) {
+      if ((inputs[i].size() != 1) && (inputs[i].size() != n)) {
+        mgis::raise("evaluate: invalid number of values for input '" +
+                    mp.inputs[i] + "' of material property '" +
+                    mp.material_property + "' (" +
+                    std::to_string(inputs[i].size()) + " given, 1 or " +
+                    std::to_string(n) + " expected)");
+      }
+    }
+    if (!isMemoryLocationAccessible(mp, l)) {
+      mgis::raise(std::string{"evaluate: the values are located in "} +
+                  getMemoryLocationDescription(l) +
+                  ", which is not accessible by the computations of the "
+                  "material property '" +
+                  mp.material_property + "' (memory space '" + mp.memory_space +
+                  "')");
+    }
+  }  // end of checkEvaluationArguments
+
+  OutputStatus evaluate(std::span<real> values,
+                        const MaterialProperty &mp,
+                        std::span<const std::span<const real>> inputs,
+                        const MemoryLocation l,
+                        const OutOfBoundsPolicy p) {
+    const auto n = static_cast<size_type>(values.size());
+    checkEvaluationArguments(n, mp, inputs, l);
+    auto s = OutputStatus{};
+    if (n == 0) {
+      return s;
+    }
+    if (isGenericParallelMaterialProperty(mp)) {
+      // one call for all the points, the uniform inputs having a null stride
+      auto arguments = std::vector<const real *>(inputs.size());
+      auto strides = std::vector<size_type>(inputs.size());
+      for (size_type i = 0; i != inputs.size(); ++i) {
+        arguments[i] = inputs[i].data();
+        strides[i] = inputs[i].size() == n ? 1 : 0;
+      }
+      mp.batch_fct(&s, values.data(), 1, arguments.data(), strides.data(),
+                   inputs.size(), n, p);
+      s.msg[sizeof(s.msg) - 1] = '\0';
+      return s;
+    }
+    // point by point, on the host
+    auto arguments = std::vector<real>(inputs.size());
+    for (size_type i = 0; i != n; ++i) {
+      for (size_type j = 0; j != inputs.size(); ++j) {
+        arguments[j] = inputs[j][inputs[j].size() == n ? i : 0];
+      }
+      auto si = OutputStatus{};
+      values[i] = mp.fct(&si, arguments.data(), arguments.size(), p);
+      if (si.status < 0) {
+        si.msg[sizeof(si.msg) - 1] = '\0';
+        return si;
+      }
+      if ((si.status != 0) && (s.status == 0)) {
+        // first point with a result computed out of the bounds
+        s = si;
+      }
+    }
+    s.msg[sizeof(s.msg) - 1] = '\0';
+    return s;
+  }  // end of evaluate
 
 }  // end of namespace mgis::material_property
