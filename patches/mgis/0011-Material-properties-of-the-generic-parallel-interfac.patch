diff --git a/cmake/modules/generic-parallel.cmake b/cmake/modules/generic-parallel.cmake
new file mode 100644
index 0000000..ccebbc3
--- /dev/null
+++ b/cmake/modules/generic-parallel.cmake
@@ -0,0 +1,101 @@
+# Libraries generated by the `generic-parallel` interfaces of `MFront`
+# (behaviours, models and material properties) with a given backend. The
+# options of the backend are its default options. The sources are generated
+# in a directory of their own for each kind of library and each backend,
+# since the `generic` interface generates sources with the same names, and
+# they are generated again when `MFront` changes. The sources of the `cuda`
+# backend require the CUDA language.
+
+# usage: _mfront_generic_parallel_check_library(name kind backend sources...)
+# where `kind` is `behaviours` or `material-properties`. A material property
+# is designated by the name of the generated function, which must be the
+# name of its source file.
+function(_mfront_generic_parallel_check_library name kind backend)
+  set(_directory
+    "${CMAKE_CURRENT_BINARY_DIR}/generic-parallel-${kind}-${backend}")
+  set(_configuration "${_directory}/configuration.json")
+  file(MAKE_DIRECTORY "${_directory}")
+  # the syntax of a backend without options is `backend: "name"`
+  file(WRITE "${_configuration}"
+    "interfaces_options: {\n"
+    "  generic-parallel: {\n"
+    "    backend: \"${backend}\"\n"
+    "  }\n"
+    "}\n")
+  if(backend STREQUAL "cuda")
+    set(_extension "cu")
+  else(backend STREQUAL "cuda")
+    set(_extension "cxx")
+  endif(backend STREQUAL "cuda")
+  set(_sources)
+  foreach(source ${ARGN})
+    set(_file "${CMAKE_CURRENT_SOURCE_DIR}/${source}.mfront")
+    set(_outputs
+      "${_directory}/src/${source}-generic-parallel-${backend}.${_extension}")
+    if(kind STREQUAL "behaviours")
+      # code shared with the `generic` interface
+      list(APPEND _outputs "${_directory}/src/${source}.cxx")
+    endif(kind STREQUAL "behaviours")
+    add_custom_command(
+      OUTPUT ${_outputs}
+      COMMAND "${MFRONT}"
+      ARGS "--interface=generic-parallel"
+      ARGS "--configuration-file=${_configuration}"
+      ARGS "${_file}"
+      DEPENDS "${_file}" "${MFRONT}"
+      WORKING_DIRECTORY "${_directory}"
+      COMMENT "mfront source ${_file} (generic-parallel interface)")
+    list(APPEND _sources ${_outputs})
+  endforeach(source ${ARGN})
+  message(STATUS "Adding library : ${name} (${_sources})")
+  add_library(${name} SHARED EXCLUDE_FROM_ALL ${_sources})
+  add_dependencies(check ${name})
+  target_include_directories(${name}
+    PRIVATE "${_directory}/include"
+    PRIVATE "${TFEL_INCLUDE_PATH}")
+  target_compile_definitions(${name} PRIVATE MFRONT_COMPILING)
+  target_link_libraries(${name} PUBLIC ${TFEL_MFRONT_LIBRARIES})
+  if(backend STREQUAL "cuda")
+    set_target_properties(${name} PROPERTIES CUDA_STANDARD 20)
+    if(NOT CMAKE_VERSION VERSION_LESS 3.24)
+      # architecture of the GPUs of the machine
+      set_target_properties(${name} PROPERTIES CUDA_ARCHITECTURES native)
+    endif(NOT CMAKE_VERSION VERSION_LESS 3.24)
+    target_compile_options(${name} PRIVATE
+      $<$<COMPILE_LANGUAGE:CUDA>:--expt-relaxed-constexpr>)
+  endif(backend STREQUAL "cuda")
+  if(backend STREQUAL "stlpar")
+    # the parallel algorithms of libstdc++ use TBB
+    find_library(MGIS_TBB_LIBRARY tbb)
+    if(MGIS_TBB_LIBRARY)
+      target_link_libraries(${name} PRIVATE "${MGIS_TBB_LIBRARY}")
+      if(UNIX AND NOT APPLE)
+        # the library stays loaded until the end of the process: the threads
+        # of TBB may still run when the libraries are unloaded at exit (as
+        # in the configuration files of the stlpar backend of TFEL)
+        target_link_libraries(${name} PRIVATE "-Wl,-z,nodelete")
+      endif(UNIX AND NOT APPLE)
+    endif(MGIS_TBB_LIBRARY)
+  endif(backend STREQUAL "stlpar")
+endfunction(_mfront_generic_parallel_check_library)
+
+# Library of behaviours and models generated by the `generic-parallel`
+# interface.
+#
+# usage: mfront_generic_parallel_behaviours_check_library(name backend
+#                                                         behaviours...)
+function(mfront_generic_parallel_behaviours_check_library name backend)
+  _mfront_generic_parallel_check_library(${name} behaviours ${backend}
+    ${ARGN})
+endfunction(mfront_generic_parallel_behaviours_check_library)
+
+# Library of material properties generated by the `generic-parallel`
+# interface.
+#
+# usage: mfront_generic_parallel_material_properties_check_library(name
+#                                                    backend properties...)
+function(mfront_generic_parallel_material_properties_check_library name
+                                                                 backend)
+  _mfront_generic_parallel_check_library(${name} material-properties
+    ${backend} ${ARGN})
+endfunction(mfront_generic_parallel_material_properties_check_library)
