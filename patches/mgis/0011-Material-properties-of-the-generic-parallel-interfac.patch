+   * `generic-parallel` interface of `MFront`, i.e. evaluates sets of points
+   * \param[in] mp: material property
+   */
+  MGIS_EXPORT bool isGenericParallelMaterialProperty(
+      const MaterialProperty &) noexcept;
+  /*!
+   * \return true if the computations of a material property can access data
+   * located in the given memory location
+   * \param[in] mp: material property
+   * \param[in] l: memory location
+   */
+  MGIS_EXPORT bool isMemoryLocationAccessible(const MaterialProperty &,
+                                              const MemoryLocation) noexcept;
+  /*!
+   * \brief evaluate a material property on a set of points.
+   *
+   * A material property generated by the `generic-parallel` interface is
+   * evaluated on all the points by one call, on the default queue of its
+   * backend. The other material properties are evaluated point by point, on
+   * the host.
