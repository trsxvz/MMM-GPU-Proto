index 0000000..b5b3abf
--- /dev/null
+++ b/include/MGIS/MaterialProperty/BatchMaterialPropertyFctPtr.hxx
@@ -0,0 +1,68 @@
+/*!
+ * \file   include/MGIS/MaterialProperty/BatchMaterialPropertyFctPtr.hxx
+ * \brief  This file declares the type of the functions generated by the
+ * `generic-parallel` interface of `MFront` for material properties.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_MATERIALPROPERTY_BATCHMATERIALPROPERTYFCTPTR_HXX
+#define LIB_MGIS_MATERIALPROPERTY_BATCHMATERIALPROPERTYFCTPTR_HXX
+
+#include "MGIS/MaterialProperty/MaterialPropertyFctPtr.hxx"
+
+/*!
+ * \brief version of the functions generated by the `generic-parallel`
+ * interface for material properties supported by MGIS. It is compared to
+ * the version exported by the libraries
+ * (`<name>_generic_parallel_api_version` symbol) when a material property
+ * is loaded. This type is a copy of the one declared in the
+ * `MFront/GenericParallelMaterialProperty/MaterialProperty.h` header of
+ * `TFEL`, so that `MGIS` does not depend on `TFEL` at compile time.
+ */
+#define MGIS_MP_GENERIC_PARALLEL_API_VERSION 1
+
+#ifdef __cplusplus
+extern "C" {
+#endif /* __cplusplus */
+
+/*!
+ * \brief type of a function evaluating a material property on a set of
+ * points. The value of the `i`-th point is written at
+ * `output[i * output_stride]`, and the `j`-th argument of this point is read
+ * at `arguments[j][i * arguments_strides[j]]` (null stride for an uniform
+ * argument). The array of pointers to the arguments and the array of the
+ * strides are read on the host.
+ */
+typedef void(
+    MGIS_MATERIALPROPERTY_ADDCALL_PTR mgis_mp_BatchMaterialPropertyFctPtr)(
+    mgis_mp_OutputStatus* const,       // output status
+    mgis_real* const,                  // output
+    const mgis_size_type,              // output stride
+    const mgis_real* const* const,     // arguments
+    const mgis_size_type*,             // strides of the arguments
+    const mgis_size_type,              // number of arguments
+    const mgis_size_type,              // number of points
+    const mgis_mp_OutOfBoundsPolicy);  // out of bounds policy
+
+#ifdef __cplusplus
+}  // end of extern "C"
+#endif /* __cplusplus */
+
+#ifdef __cplusplus
+
+namespace mgis::material_property {
+
+  //! \brief a simple alias
+  using BatchMaterialPropertyFctPtr = ::mgis_mp_BatchMaterialPropertyFctPtr;
+
+}  // end of namespace mgis::material_property
+
+#endif /* __cplusplus */
+
+#endif /* LIB_MGIS_MATERIALPROPERTY_BATCHMATERIALPROPERTYFCTPTR_HXX */
