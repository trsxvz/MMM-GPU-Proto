+   * \param[out] values: values of the material property, one per point
+   * \param[in] mp: material property
+   * \param[in] inputs: values of the inputs, one array per input, giving
+   * either one value (uniform input) or one value per point
+   * \param[in] l: location of the values and of the inputs, checked against
+   * the memory space of the material property
+   * \param[in] p: out of bounds policy
+   * \note invalid arguments are reported by exceptions
+   */
+  MGIS_EXPORT OutputStatus
+  evaluate(std::span<real>,
+           const MaterialProperty &,
+           std::span<const std::span<const real>>,
+           const MemoryLocation = MemoryLocation::HOST,
+           const OutOfBoundsPolicy = MGIS_MATERIALPROPERTY_NONE_POLICY);
 
