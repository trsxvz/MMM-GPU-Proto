   /* arrays stored component by component */
@@ -154,6 +165,62 @@ int main(const int argc, const char* const* argv) {
     pi[i + 1] = isvs1[ni];
     pe[i + 1] = isvs1[ne];
   }
+  /* arrays of the states stored point by point with a padding of two
+   * values, tangent operator blocks stored component by component */
+  check_status(mgis_bv_create_material_data_manager_initializer(&mi2));
+  check_status(mgis_bv_material_data_manager_initializer_set_layout(
+      mi2, MGIS_BV_POINT_BY_POINT));
+  check_status(mgis_bv_material_data_manager_initializer_set_array_layout(
+      mi2, MGIS_BV_TANGENT_OPERATOR_ARRAY, MGIS_BV_COMPONENT_BY_COMPONENT));
+  check_status(mgis_bv_material_data_manager_initializer_set_padding(mi2, 2));
