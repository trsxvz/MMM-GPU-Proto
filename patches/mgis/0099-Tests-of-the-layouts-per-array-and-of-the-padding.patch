+/*!
+ * \return true if the unused values of an array stored with the given
+ * layout and padding are all NaN
+ * \param[in] values: values of the array
+ * \param[in] l: layout
+ * \param[in] n: number of points
+ * \param[in] nc: number of components
+ * \param[in] p: padding
+ */
+static bool isPaddingNaN(std::span<const real> values,
+                         const FieldLayout l,
+                         const size_type n,
+                         const size_type nc,
+                         const size_type p) {
+  const auto pbp = l == FieldLayout::POINT_BY_POINT;
+  // minimal leading dimension and number of rows of the array
+  const auto ld = pbp ? nc : n;
+  const auto nr = pbp ? n : nc;
+  if (values.size() != nr * (ld + p)) {
+    return false;
+  }
+  for (size_type i = 0; i != nr; ++i) {
+    for (size_type j = ld; j != ld + p; ++j) {
+      if (!std::isnan(values[i * (ld + p) + j])) {
+        return false;
+      }
+    }
+  }
+  return true;
+}  // end of isPaddingNaN
+
+/*!
+ * \return true if the unused values of the arrays of the states and of the
+ * tangent operator blocks, if allocated, of a material data manager are all
+ * NaN
+ */
+static bool isPaddingNaN(const mgis::behaviour::MaterialDataManager& m) {
+  const auto& l = m.layout;
+  // the tangent operator blocks are allocated by the first integration
+  // requesting them
+  auto r = m.K.empty() || isPaddingNaN(m.K, l.tangent_operator, m.n,
+                                       m.K_stride, l.padding);
+  for (const auto* const s : {&m.s0, &m.s1}) {
+    r = r &&
+        isPaddingNaN(s->gradients, l.gradients, m.n, s->gradients_stride,
+                     l.padding) &&
+        isPaddingNaN(s->thermodynamic_forces, l.thermodynamic_forces, m.n,
+                     s->thermodynamic_forces_stride, l.padding) &&
+        isPaddingNaN(s->internal_state_variables, l.internal_state_variables,
+                     m.n, s->internal_state_variables_stride, l.padding);
+  }
+  return r;
+}  // end of isPaddingNaN
+
+/*!
+ * \brief one layout per array and padding of the arrays: the integration
+ * gives the results of a manager stored point by point to the bit, the
+ * unused values remain NaN, the views account for the padding, and the
+ * values given by arrays in the layout of a manager whose arrays have
+ * different layouts are refused
+ */
+static void testLayoutsPerArrayAndPadding(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{9};
+  constexpr auto pbp = FieldLayout::POINT_BY_POINT;
+  constexpr auto cbc = FieldLayout::COMPONENT_BY_COMPONENT;
+  auto layouts = std::vector<MaterialDataManagerLayout>{};
+  {
+    // tangent operator component by component, states point by point
+    auto l = MaterialDataManagerLayout{pbp};
+    l.tangent_operator = cbc;
+    layouts.push_back(l);
+  }
+  {
+    // the reverse
+    auto l = MaterialDataManagerLayout{cbc};
+    l.tangent_operator = pbp;
+    layouts.push_back(l);
+  }
+  {
+    auto l = MaterialDataManagerLayout{pbp};
+    l.gradients = cbc;
+    l.internal_state_variables = cbc;
+    layouts.push_back(l);
+  }
+  {
+    auto l = MaterialDataManagerLayout{pbp};
+    l.padding = 3;
+    layouts.push_back(l);
+  }
+  {
+    auto l = MaterialDataManagerLayout{cbc};
+    l.padding = 2;
+    layouts.push_back(l);
+  }
+  {
+    auto l = MaterialDataManagerLayout{cbc};
+    l.thermodynamic_forces = pbp;
+    l.padding = 1;
+    layouts.push_back(l);
+  }
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  for (const auto& l : layouts) {
+    auto ma = makeManager(b, n, pbp);
+    auto mt = makeManager(b, n, l);
+    check(mt->layout == l, "layouts per array: layouts not stored");
+    check(getStateLayout(l) == mt->s1.layout,
+          "layouts per array: layouts of the states not stored");
+    check(isPaddingNaN(*mt), "padding: unused values not NaN, " + library);
+    for (auto* const m : {ma.get(), mt.get()}) {
+      setExternalStateVariable(m->s0, "Temperature", 293.15);
+      setExternalStateVariable(m->s1, "Temperature", 293.15);
+    }
+    for (int step = 0; step != 3; ++step) {
+      const auto e = getGradientsView(ma->s1);
+      for (size_type i = 0; i != n; ++i) {
+        for (size_type c = 0; c != 6; ++c) {
+          e(i, c) += 1e-4 * static_cast<real>((step + 1) * (c + 1)) *
+                     (1 + 0.1 * static_cast<real>(i));
+        }
+      }
+      copyStates(*mt, *ma);
+      const auto ra = integrate(*ma, opts, 180);
+      const auto rt = integrate(*mt, opts, 180);
+      check(ra.exit_status == rt.exit_status,
+            "layouts per array: invalid status");
+      check(haveSameOutputs(*ma, *mt),
+            "layouts per array: invalid outputs, " + library);
+      check(isPaddingNaN(*mt),
+            "padding: unused values not NaN after the integration, " +
+                library);
+      update(*ma);
+      update(*mt);
+    }
+    revert(*ma);
+    revert(*mt);
+    check(same(getInternalStateVariablesView(ma->s1),
+               getInternalStateVariablesView(mt->s1)) &&
+              isPaddingNaN(*mt),
+          "layouts per array: invalid revert, " + library);
+  }
+  // views on padded arrays
+  {
+    auto l = MaterialDataManagerLayout{pbp};
+    l.padding = 3;
+    const auto m = makeManager(b, n, l);
+    const auto g = getGradientsView(m->s1);
+    check((g.getPointStride() == 9) && (g.getComponentStride() == 1),
+          "padding: invalid strides of a view point by point");
+    l = MaterialDataManagerLayout{cbc};
+    l.padding = 2;
+    const auto m2 = makeManager(b, n, l);
+    const auto g2 = getGradientsView(m2->s1);
+    check((g2.getPointStride() == 1) && (g2.getComponentStride() == n + 2),
+          "padding: invalid strides of a view component by component");
+    // states of different paddings can't be updated one from the other
+    auto ctx = mgis::Context{};
+    check(!updateValues(ctx, m2->s0, m->s1),
+          "padding: update of a state from a state of another padding");
+  }
+  // arrays given by an initializer must be padded
+  {
+    auto values = std::vector<real>(n * 6);
+    auto i = MaterialDataManagerInitializer{};
+    i.layout.padding = 1;
+    i.s1.gradients = values;
+    check(throws([&b, &i] { MaterialDataManager(b, n, i); },
+                 "padding included"),
+          "padding: unpadded array given by the initializer accepted");
+  }
+  // values given by an array in the layout of the manager require a
+  // uniform layout
+  {
+    const auto bp =
+        load(library, "PostProcessingTest", Hypothesis::TRIDIMENSIONAL);
+    auto l = MaterialDataManagerLayout{pbp};
+    l.tangent_operator = cbc;
+    auto m = makeManager(bp, n, l);
+    for (auto* const s : {&m->s0, &m->s1}) {
+      setMaterialProperty(*s, "YoungModulus", 150e9);
+      setMaterialProperty(*s, "PoissonRatio", 0.3);
+      setExternalStateVariable(*s, "Temperature", 293.15);
+    }
+    auto o = allocatePostProcessingVariables(*m, "PrincipalStrain");
+    check(throws([&o, &m] {
+            static_cast<void>(
+                executePostProcessing(o, *m, "PrincipalStrain"));
+          },
+                 "must be given by a FieldView"),
+          "layouts per array: outputs given by an array accepted");
+  }
+}  // end of testLayoutsPerArrayAndPadding
+
 int main(const int argc, const char* const* const argv) {
   if (argc != 3) {
     std::cerr << "usage: " << argv[0]
@@ -1114,6 +1313,7 @@ int main(const int argc, const char* const* const argv) {
       testUpdateOfMaterialPropertiesAndExternalStateVariables(library);
       testFiniteStrainConversionsOnViews(library);
       testVariablesViews(library);
+      testLayoutsPerArrayAndPadding(library);
     }
     testMaterialFunctionManager(argv[2]);
