+  for (idx = 0; idx != n; ++idx) {
+    g2[idx * (g_stride + pd)] = de;
+  }
+  pi2[0] = isvs0_2[o];
+  pe2[0] = isvs0_2[(n - 1) * (isvs_stride + pd) + o];
+  for (i = 0; i != 20; ++i) {
+    check_status(mgis_bv_integrate_material_data_manager(
+        &r, p, m2, MGIS_BV_INTEGRATION_NO_TANGENT_OPERATOR, dt));
+    check_status(mgis_bv_update_material_data_manager(m2));
+    for (idx = 0; idx != n; ++idx) {
+      g2[idx * (g_stride + pd)] += de;
+    }
+    pi2[i + 1] = isvs1_2[o];
+    pe2[i + 1] = isvs1_2[(n - 1) * (isvs_stride + pd) + o];
+  }
+  for (i = 0; i != 21; ++i) {
+    check((pi2[i] == pi[i]) && (pe2[i] == pe[i]),
+          "LayoutTest: the padded manager gives other results");
+  }
+  check_status(mgis_bv_free_material_data_manager(&m2));
+  check_status(mgis_bv_free_material_data_manager_initializer(&mi2));
   check_status(mgis_bv_free_behaviour(&b));
   check_status(mgis_bv_free_material_data_manager(&m));
   check_status(mgis_bv_free_material_data_manager_initializer(&mi));
@@ -176,5 +243,5 @@ int main(const int argc, const char* const* argv) {
       return EXIT_FAILURE;
     }
