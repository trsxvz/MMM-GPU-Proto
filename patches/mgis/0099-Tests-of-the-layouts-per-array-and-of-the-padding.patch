+  check(l == MGIS_BV_POINT_BY_POINT, "invalid layout of the gradients");
+  check_status(mgis_bv_material_data_manager_get_padding(&pd, m2));
+  check(pd == 2, "invalid padding");
+  check(mgis_bv_material_data_manager_get_layout(&l, m2).exit_status !=
