+  /*!
+   * \brief check the output of a conversion: number of points, number of
+   * components, distinct values
+   * \param[in] f: calling function
+   * \param[in] d: description of the output
+   * \param[in] o: output
+   * \param[in] n: number of points
+   * \param[in] nc: number of components
+   */
+  static void checkConversionOutput(const char* const f,
+                                    const char* const d,
+                                    const FieldView<real>& o,
+                                    const size_type n,
+                                    const size_type nc) {
+    if (o.getNumberOfPoints() != n) {
+      mgis::raise(std::string{f} + ": invalid number of points of the " + d +
+                  " (" + std::to_string(o.getNumberOfPoints()) + " given, " +
+                  std::to_string(n) + " expected)");
+    }
+    if (n == 0) {
+      return;
+    }
+    if (o.getNumberOfComponents() != nc) {
+      mgis::raise(std::string{f} + ": invalid number of components of the " +
+                  d + " (" + std::to_string(o.getNumberOfComponents()) +
+                  " given, " + std::to_string(nc) + " expected)");
+    }
+    if (!o.hasDistinctValues()) {
+      mgis::raise(std::string{f} + ": the values of the " + d +
+                  " overlap (an output can't be uniform, and its strides "
+                  "must give distinct values for each point and component)");
+    }
+  }  // end of checkConversionOutput
+
+  /*!
+   * \return the behaviour of a material data view, after checking that its
+   * state at the end of the time step is consistent and that its arrays are
+   * accessible by the host
+   * \param[in] f: calling function
+   * \param[in] v: material data view
+   */
+  static const Behaviour& checkConversionMaterialDataView(
+      const char* const f, const MaterialDataView& v) {
+    if (v.b == nullptr) {
+      mgis::raise(std::string{f} + ": no behaviour");
+    }
+    if ((v.s1.b != v.b) || (v.s1.n != v.n)) {
+      mgis::raise(std::string{f} +
+                  ": the state at the end of the time step is not associated "
+                  "with the behaviour or the number of points of the "
+                  "material data view");
