+  /*!
+   * \brief check that the mass density, if held by a material data manager
+   * on the host, is accessible by the computations of the behaviour. A view
+   * of the material data manager does not describe such a mass density,
+   * which is then reported as missing: this check gives the reason.
+   * \param[in] m: material data manager
+   */
+  static void checkMassDensityLocation(const MaterialDataManager& m) {
+    if (isMemoryLocationAccessible(m.b, MemoryLocation::HOST)) {
+      return;
+    }
+    for (const auto* const s : {&m.s0, &m.s1}) {
+      if ((s->mass_density.has_value()) &&
+          (!std::holds_alternative<std::span<real>>(s->mass_density->value))) {
+        mgis::raise(
+            "integrate: the mass density is held by the material data "
+            "manager, in the memory of the host, which is not accessible by "
+            "the computations of the behaviour (memory space '" +
+            m.b.memory_space +
+            "'): it must be given by a span on memory accessible by the "
+            "device, with the external storage mode");
+      }
+    }
+  }  // end of checkMassDensityLocation
