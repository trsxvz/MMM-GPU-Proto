 namespace mgis {
 
+  /*!
+   * \return true if two views of the same extents describe the same values:
+   * same first value, and same strides for the dimensions whose extent is
+   * greater than one
+   * \param[in] a: first view
+   * \param[in] b: second view
+   */
+  static bool describeSameValues(const FieldView<real>& a,
+                                 const FieldView<const real>& b) noexcept {
+    if (a.data() != b.data()) {
+      return false;
+    }
+    if ((a.getNumberOfPoints() > 1) &&
+        (a.getPointStride() != b.getPointStride())) {
+      return false;
+    }
+    return (a.getNumberOfComponents() <= 1) ||
+           (a.getComponentStride() == b.getComponentStride());
+  }  // end of describeSameValues
+
   void FieldOperations::copy(const FieldView<real>& d,
                              const FieldView<const real>& s) {
+    if (d.empty() && s.empty()) {
+      // no value to copy, whatever the extents
+      return;
+    }
     if ((d.getNumberOfPoints() != s.getNumberOfPoints()) ||
         (d.getNumberOfComponents() != s.getNumberOfComponents())) {
       raise("FieldOperations::copy: the views have different extents");
     }
-    if (d.empty()) {
-      return;
-    }
     if (!d.hasDistinctValues()) {
       raise("FieldOperations::copy: the values of the destination overlap");
     }
-    if ((d.data() == s.data()) &&
-        (d.getPointStride() == s.getPointStride()) &&
-        (d.getComponentStride() == s.getComponentStride())) {
-      // the views describe the same values
+    if (describeSameValues(d, s)) {
+      // nothing to copy
       return;
     }
     this->do_copy(d, s);
