new file mode 100644
index 0000000..a01b7e8
--- /dev/null
+++ b/tests/BitwiseEquality.hxx
@@ -0,0 +1,39 @@
+/*!
+ * \file   tests/BitwiseEquality.hxx
+ * \brief  This file declares a bit for bit comparison of values, whatever
+ * their type (double or float, following the numerical type of MGIS).
+ * \date   13/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_TESTS_BITWISEEQUALITY_HXX
+#define LIB_MGIS_TESTS_BITWISEEQUALITY_HXX
+
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <type_traits>
+
+namespace mgis::tests {
+
+  /*!
+   * \return true if two values are identical, bit for bit: the positive and
+   * negative zeros are distinguished, and a NaN is equal to itself
+   * \param[in] a: first value
+   * \param[in] b: second value
+   */
+  template <typename T>
+    requires(std::is_trivially_copyable_v<T>)
+  [[nodiscard]] bool areBitwiseEqual(const T& a, const T& b) noexcept {
+    using Bytes = std::array<unsigned char, sizeof(T)>;
+    return std::bit_cast<Bytes>(a) == std::bit_cast<Bytes>(b);
+  }  // end of areBitwiseEqual
+
+}  // end of namespace mgis::tests
+
+#endif /* LIB_MGIS_TESTS_BITWISEEQUALITY_HXX */
