new file mode 100644
index 0000000..8ef9c85
--- /dev/null
+++ b/tests/Tolerance.hxx
@@ -0,0 +1,56 @@
+/*!
+ * \file   tests/Tolerance.hxx
+ * \brief  This file declares a function adapting the tolerances of the
+ * tests, written for the double numerical type, to the numerical type of
+ * MGIS.
+ * \date   13/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_TESTS_TOLERANCE_HXX
+#define LIB_MGIS_TESTS_TOLERANCE_HXX
+
+#include <limits>
+#include "MGIS/Config.hxx"
+
+namespace mgis::tests {
+
+  /*!
+   * \return a tolerance written for the double numerical type, bounded below
+   * by ten times the machine epsilon of the numerical type of MGIS: it is
+   * unchanged in double (for a tolerance greater than 2.3e-15), and about
+   * 1.2e-6 in float
+   * \param[in] t: tolerance for the double numerical type
+   */
+  constexpr mgis::real tolerance(const double t) noexcept {
+    constexpr auto e =
+        10 * static_cast<double>(std::numeric_limits<mgis::real>::epsilon());
+    return static_cast<mgis::real>(t > e ? t : e);
+  }  // end of tolerance
+
+  /*!
+   * \return the tolerance of a test for the numerical type of MGIS: the
+   * first argument for double, the second one otherwise. The tolerance for
+   * float is given explicitly when the error depends on the computation
+   * (accumulated roundings, convergence criteria of the behaviours bounded
+   * by MGIS for this type) and not only on the precision of the result.
+   * \param[in] for_double: tolerance for the double numerical type
+   * \param[in] for_float: tolerance for the float numerical type
+   */
+  constexpr mgis::real tolerance(const double for_double,
+                                 const double for_float) noexcept {
+    if constexpr (sizeof(mgis::real) == sizeof(double)) {
+      return static_cast<mgis::real>(for_double);
+    } else {
+      return static_cast<mgis::real>(for_float);
+    }
+  }  // end of tolerance
+
+}  // end of namespace mgis::tests
+
+#endif /* LIB_MGIS_TESTS_TOLERANCE_HXX */
