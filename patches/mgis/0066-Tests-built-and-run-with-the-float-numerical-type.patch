--- /dev/null
+++ b/tests/RealTypeTest.cxx
@@ -0,0 +1,61 @@
+/*!
+ * \file   tests/RealTypeTest.cxx
+ * \brief  This test checks that a behaviour generated with the numerical
+ * type of MGIS is loaded, and that a behaviour generated with another
+ * numerical type (real_type option of mfront) is refused.
+ * \date   13/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <string>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include "MGIS/LibrariesManager.hxx"
+#include "MGIS/Behaviour/Behaviour.hxx"
+
+int main(const int argc, const char* const* const argv) {
+  using namespace mgis::behaviour;
+  auto success = true;
+  auto check = [&success](const bool b, const std::string& msg) {
+    if (!b) {
+      success = false;
+      std::cerr << msg << '\n';
+    }
+    return b;
+  };
+  if (!check(argc == 3, "usage: RealTypeTest library other-type-library")) {
+    return EXIT_FAILURE;
+  }
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  auto& lm = mgis::LibrariesManager::get();
+  // library generated with the numerical type of MGIS
+  check(lm.getRealSize(argv[1], "Elasticity") == sizeof(mgis::real),
+        "invalid size of the numerical type of the behaviour");
+  try {
+    static_cast<void>(load(argv[1], "Elasticity", h));
+  } catch (std::exception& e) {
+    check(false, std::string{"loading failed: "} + e.what());
+  }
+  // library generated with the other numerical type
+  constexpr auto other_size =
+      sizeof(mgis::real) == sizeof(double) ? sizeof(float) : sizeof(double);
+  check(lm.getRealSize(argv[2], "Elasticity") == other_size,
+        "invalid size of the numerical type of the behaviour generated with "
+        "the other type");
+  auto refused = false;
+  try {
+    static_cast<void>(load(argv[2], "Elasticity", h));
+  } catch (std::exception& e) {
+    refused = true;
+    check(std::string{e.what()}.find("numerical type") != std::string::npos,
+          std::string{"invalid error message: "} + e.what());
+  }
+  check(refused, "a behaviour generated with another type must be refused");
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
