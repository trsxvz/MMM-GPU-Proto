From 35a64b22a687b2f8787db62c47301f5e7452d115 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 21 Oct 2026 04:04:41 +0200
Subject: [PATCH] Behaviours of the generic-parallel interface: fixes of the
 review

- the layout of every member of the data structures copied from TFEL is
  checked, not only the sizes of the structures;
- asynchronous computations on a non empty batch require the report
  function of the behaviour: without it, failures would be taken for
  successes by `PendingBatchComputation::getResult`.
---
 src/Behaviour.cxx                      | 10 +++++++++
 src/Integrate.cxx                      | 18 +++++++++++++++
 tests/GenericParallelIntegrateTest.cxx | 18 +++++++++++++++
 tests/GenericParallelLoadTest.cxx      | 31 ++++++++++++++++++++++++++
 4 files changed, 77 insertions(+)

diff --git a/src/Behaviour.cxx b/src/Behaviour.cxx
index 8f2acdc..4a71274 100644
--- a/src/Behaviour.cxx
+++ b/src/Behaviour.cxx
@@ -850,6 +850,11 @@ namespace mgis::behaviour {
       checkRotationMatricesView(f.name, r, n);
     }
     checkAsynchronousBatchExecutionPolicy(f.name, p, b.memory_space);
+    if ((n != 0) && (b.batch_report == nullptr)) {
+      mgis::raise(std::string{f.name} +
+                  ": no report function of the asynchronous computations "
+                  "(member batch_report of the behaviour)");
+    }
     // the statistics of an empty batch are not analysed
     auto c = PendingBatchComputation(p, (n != 0) ? b.batch_report : nullptr,
                                      f.name, 0, std::nullopt);
@@ -928,6 +933,11 @@ namespace mgis::behaviour {
     if (n == 0) {
       return PendingBatchComputation(p, nullptr, f.name, 0, std::nullopt);
     }
+    if (b.batch_report == nullptr) {
+      mgis::raise(std::string{f.name} +
+                  ": no report function of the asynchronous computations "
+                  "(member batch_report of the behaviour)");
+    }
     const auto [nm, build] = getRotationMatricesBuilder(f.name, b, n, r);
     auto c = PendingBatchComputation(p, b.batch_report, f.name, 0, std::nullopt,
                                      9 * nm);
diff --git a/src/Integrate.cxx b/src/Integrate.cxx
index d6f9a67..77c85c3 100644
--- a/src/Integrate.cxx
+++ b/src/Integrate.cxx
@@ -577,6 +577,23 @@ namespace mgis::behaviour::internals {
     return r;
   }  // end of executeBatch
 
+  /*!
+   * \brief check that the report function of a behaviour, which analyses
+   * the statistics of asynchronous computations, is available
+   * \param[in] f: name of the calling function
+   * \param[in] b: behaviour
+   * \param[in] required: true if computations are submitted
+   */
+  static void checkBatchReportFunction(const std::string_view f,
+                                       const Behaviour& b,
+                                       const bool required) {
+    if ((required) && (b.batch_report == nullptr)) {
+      mgis::raise(std::string{f} +
+                  ": no report function of the asynchronous computations "
+                  "(member batch_report of the behaviour)");
+    }
+  }  // end of checkBatchReportFunction
+
   /*!
    * \brief submit computations on the points `[b, e)` of a material data
    * view, asynchronously (see the previous overload)
@@ -592,6 +609,7 @@ namespace mgis::behaviour::internals {
       const std::optional<real> rdt,
       const SubmitFunction& submit) {
     checkAsynchronousBatchExecutionPolicy(f, p, v.b->memory_space);
+    checkBatchReportFunction(f, *(v.b), b != e);
     // the statistics of an empty batch are not analysed
     auto r = PendingBatchComputation(p, (b != e) ? v.b->batch_report : nullptr,
                                      f, b, rdt);
diff --git a/tests/GenericParallelIntegrateTest.cxx b/tests/GenericParallelIntegrateTest.cxx
index cbf67dd..6e4afe2 100644
--- a/tests/GenericParallelIntegrateTest.cxx
+++ b/tests/GenericParallelIntegrateTest.cxx
@@ -1117,6 +1117,24 @@ static void testAsynchronousComputations(const std::string& library,
               "has not been generated by the generic-parallel interface"),
           "asynchronous integration: a behaviour of the generic interface "
           "must be refused");
+    // a behaviour without report function can't analyse the statistics of
+    // asynchronous computations: the failures would be taken for successes
+    {
+      auto b = managers.gp_b;
+      b.batch_report = nullptr;
+      auto m = MaterialDataManager{b, n};
+      for (auto* const st : {&m.s0, &m.s1}) {
+        setMaterialProperty(*st, "YoungModulus", 150e9);
+        setMaterialProperty(*st, "PoissonRatio", 0.3);
+        setExternalStateVariable(*st, "Temperature", 293.15);
+        setExternalStateVariable(*st, "ExternalStateVariable", 300);
+      }
+      check(throws([&p, &m,
+                    &opts] { static_cast<void>(integrate(p, m, opts, 1)); },
+                   "no report function"),
+            "asynchronous integration without report function must be "
+            "refused");
+    }
     // the memory of the host can't be a shared memory
     auto shared = AsynchronousBatchExecutionPolicy{};
     shared.location = MemoryLocation::SHARED;
