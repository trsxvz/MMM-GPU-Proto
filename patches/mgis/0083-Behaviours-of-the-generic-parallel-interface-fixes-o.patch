 MGIS_CHECK_MEMBER(BatchDataView, BatchData, s0);
 MGIS_CHECK_MEMBER(BatchDataView, BatchData, s1);
@@ -77,6 +105,9 @@ MGIS_CHECK_MEMBER(BatchDataView, BatchData, statuses);
 MGIS_CHECK_MEMBER(BatchDataView, BatchData, execution);
 static_assert(sizeof(mgis_bv_BatchRotationDataView) ==
               sizeof(mfront_gpb_RotationData));
