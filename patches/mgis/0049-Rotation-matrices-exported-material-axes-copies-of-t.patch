 src/RotationMatrix.cxx                    |  24 ++++
 tests/CMakeLists.txt                      |   1 +
 tests/RotationMatrixCopyTest.cxx          | 153 ++++++++++++++++++++++
 4 files changed, 195 insertions(+), 1 deletion(-)
 create mode 100644 tests/RotationMatrixCopyTest.cxx

