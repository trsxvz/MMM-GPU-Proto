diff --git a/tests/GenericParallelGenericFunctionsTest.cxx b/tests/GenericParallelGenericFunctionsTest.cxx
new file mode 100644
index 0000000..d7241c7
--- /dev/null
+++ b/tests/GenericParallelGenericFunctionsTest.cxx
@@ -0,0 +1,142 @@
+/*!
+ * \file   tests/GenericParallelGenericFunctionsTest.cxx
+ * \brief  This test checks the libraries of the `generic-parallel`
+ * interface of `MFront` which also contain the functions of the `generic`
+ * interface (`generic_functions` option): both kinds of functions are
+ * loaded, the integration of a behaviour point by point gives the results
+ * of the integration of a batch, and the evaluation of a material property
+ * at a point gives its value on a batch.
+ * \date   21/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <cmath>
+#include <span>
+#include <string>
+#include <vector>
+#include <cstdlib>
+#include <iostream>
+#include <algorithm>
+#include <string_view>
+#include "MGIS/Behaviour/Behaviour.hxx"
+#include "MGIS/Behaviour/MaterialDataManager.hxx"
+#include "MGIS/Behaviour/Integrate.hxx"
+#include "MGIS/MaterialProperty/MaterialProperty.hxx"
+
+static bool success = true;
+
+static bool check(const bool b, const std::string_view msg) {
+  if (!b) {
+    success = false;
+    std::cerr << msg << '\n';
+  }
+  return b;
+}
+
+//! \return the maximal absolute difference between two arrays
+static mgis::real difference(std::span<const mgis::real> a,
+                             std::span<const mgis::real> b) {
+  auto d = mgis::real{};
+  for (std::size_t i = 0; i != std::min(a.size(), b.size()); ++i) {
+    d = std::max(d, std::abs(a[i] - b[i]));
+  }
+  return a.size() == b.size() ? d : mgis::real{1};
+}
+
+/*!
+ * \brief behaviour: both kinds of functions, integration point by point
+ * compared to the integration of a batch
+ */
+static void testBehaviour(const std::string& library) {
+  using namespace mgis::behaviour;
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  const auto b = load(library, "Plasticity", h);
+  check(b.interface == "Generic", "invalid interface '" + b.interface + "'");
+  check(isGenericParallelBehaviour(b), "functions of batches expected");
+  check(
+      (b.b != nullptr) && (b.batch_b != nullptr) && (b.batch_report != nullptr),
+      "both kinds of integration functions expected");
+  // the same behaviour without its functions of batches of points is
+  // integrated point by point by the material data managers
+  auto pb = b;
+  pb.batch_b = nullptr;
+  pb.batch_report = nullptr;
+  pb.batch_api_version = 0;
+  constexpr auto n = mgis::size_type{32};
+  auto m = MaterialDataManager{b, n};
+  auto pm = MaterialDataManager{pb, n};
+  for (auto* const dm : {&m, &pm}) {
+    setExternalStateVariable(dm->s0, "Temperature", 293.15);
+    setExternalStateVariable(dm->s1, "Temperature", 293.15);
+    for (mgis::size_type i = 0; i != n; ++i) {
+      const auto e = 4e-3 * static_cast<double>(i) / n;
+      dm->s1.gradients[i * dm->s1.gradients_stride] = e;
+      dm->s1.gradients[i * dm->s1.gradients_stride + 1] = -0.3 * e;
+      dm->s1.gradients[i * dm->s1.gradients_stride + 2] = -0.3 * e;
+    }
+  }
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  const auto r = integrate(m, opts, 1);
+  const auto pr = integrate(pm, opts, 1);
+  check((r.exit_status == 1) && (pr.exit_status == 1), "integration failed");
+  check(difference(m.s1.thermodynamic_forces, pm.s1.thermodynamic_forces) <
+            1e-12 * 1e9,
+        "invalid thermodynamic forces");
+  check(difference(m.s1.internal_state_variables,
+                   pm.s1.internal_state_variables) < 1e-12,
+        "invalid internal state variables");
+  check(difference(m.K, pm.K) < 1e-12 * 1e11, "invalid tangent operators");
+  // rotations of an orthotropic behaviour
+  const auto bo = load(library, "OrthotropicElasticity", h);
+  check((bo.rotate_gradients_ptr != nullptr) &&
+            (bo.batch_rotate_gradients_ptr != nullptr) &&
+            (bo.rotate_thermodynamic_forces_ptr != nullptr) &&
+            (bo.batch_rotate_thermodynamic_forces_ptr != nullptr),
+        "both kinds of rotation functions expected");
+}  // end of testBehaviour
+
+/*!
+ * \brief material property: both kinds of functions, evaluation at a point
+ * compared to the evaluation on a batch
+ */
+static void testMaterialProperty(const std::string& library) {
+  using namespace mgis::material_property;
+  const auto mp = load(library, "Inconel600_YoungModulus");
+  check(mp.interface == "Generic", "invalid interface '" + mp.interface + "'");
+  check((mp.fct != nullptr) && (mp.batch_fct != nullptr),
+        "both kinds of functions expected");
+  const auto T = std::vector<mgis::real>{300, 500, 700, 900};
+  auto values = std::vector<mgis::real>(T.size());
+  const auto inputs = std::vector<std::span<const mgis::real>>{T};
+  const auto r = evaluate(values, mp, inputs);
+  check(r.status == 0, "evaluation failed");
+  for (std::size_t i = 0; i != T.size(); ++i) {
+    auto s = mgis_mp_OutputStatus{};
+    const auto v = mp.fct(&s, &T[i], 1, MGIS_MATERIALPROPERTY_NONE_POLICY);
+    check((s.status == 0) && (std::abs(v - values[i]) <= 1e-12 * std::abs(v)),
+          "invalid value at point " + std::to_string(i));
+  }
+}  // end of testMaterialProperty
+
+int main(const int argc, const char* const* const argv) {
+  if (argc != 3) {
+    std::cerr << "usage: " << argv[0]
+              << " behaviours-library material-properties-library\n";
+    return EXIT_FAILURE;
+  }
+  try {
+    testBehaviour(argv[1]);
+    testMaterialProperty(argv[2]);
+  } catch (std::exception& e) {
+    std::cerr << e.what() << '\n';
+    return EXIT_FAILURE;
+  }
+  return success ? EXIT_SUCCESS : EXIT_FAILURE;
+}  // end of main
-- 
