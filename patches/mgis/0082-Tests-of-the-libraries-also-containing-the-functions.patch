diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 2455de6..d0ec875 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -346,6 +346,30 @@ if(MGIS_HAVE_MFRONT_SUPPORT)
       GenericParallelInvalidMaterialProperties)
     set_test_environment(GenericParallelEvaluateTest)
 
+    # libraries also containing the functions of the `generic` interface
