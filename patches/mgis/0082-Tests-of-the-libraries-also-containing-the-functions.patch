From 89e1ac1143f279e76147ef2cdd936be5ef3f1b6d Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 21 Oct 2026 03:53:10 +0200
Subject: [PATCH] Tests of the libraries also containing the functions of the
 generic interface

`mfront_generic_parallel_check_library_with_generic_functions` builds a
library of the `generic-parallel` interface with the `generic_functions`
option. `GenericParallelGenericFunctionsTest` checks that both kinds of
functions are loaded (behaviour, rotations, material property), that the
integration point by point gives the results of the integration of a batch
and that the evaluation of a material property at a point gives its value
on a batch. Documentation of the detection of both kinds of functions.
---
 cmake/modules/generic-parallel.cmake          |  29 ++++
 docs/web/generic-parallel.md                  |  10 ++
 tests/CMakeLists.txt                          |  24 +++
 tests/GenericParallelGenericFunctionsTest.cxx | 142 ++++++++++++++++++
 4 files changed, 205 insertions(+)
 create mode 100644 tests/GenericParallelGenericFunctionsTest.cxx

diff --git a/cmake/modules/generic-parallel.cmake b/cmake/modules/generic-parallel.cmake
index 6329913..bf61b3c 100644
--- a/cmake/modules/generic-parallel.cmake
+++ b/cmake/modules/generic-parallel.cmake
@@ -41,9 +41,16 @@ function(_mfront_generic_parallel_sources output directory kind backend
                                           backend_configuration)
   set(_configuration "${directory}/configuration.json")
   file(MAKE_DIRECTORY "${directory}")
+  # libraries also containing the functions of the `generic` interface
+  # (see `mfront_generic_parallel_check_library_with_generic_functions`)
+  set(_generic_functions "")
+  if(_mgis_generic_functions)
+    set(_generic_functions "    generic_functions: true,\n")
+  endif(_mgis_generic_functions)
   string(CONCAT _content
     "interfaces_options: {\n"
     "  generic-parallel: {\n"
+    "${_generic_functions}"
     "    backend: ${backend_configuration}\n"
     "  }\n"
     "}\n")
@@ -62,6 +69,11 @@ function(_mfront_generic_parallel_sources output directory kind backend
       # code shared with the `generic` interface
       list(APPEND _outputs "${directory}/src/${source}.cxx")
     endif(kind STREQUAL "behaviours")
+    if(_mgis_generic_functions)
+      # functions of the `generic` interface
+      list(APPEND _outputs
+        "${directory}/src/${source}-generic-parallel-${backend}-generic.cxx")
+    endif(_mgis_generic_functions)
     add_custom_command(
       OUTPUT ${_outputs}
       COMMAND "${MFRONT}"
@@ -86,6 +98,9 @@ endfunction(_mfront_generic_parallel_sources)
 function(_mfront_generic_parallel_check_library name kind backend)
   set(_directory
     "${CMAKE_CURRENT_BINARY_DIR}/generic-parallel-${kind}-${backend}")
+  if(_mgis_generic_functions)
+    set(_directory "${_directory}-generic-functions")
+  endif(_mgis_generic_functions)
   # the syntax of a backend without options is `backend: "name"`
   _mfront_generic_parallel_sources(_sources "${_directory}" ${kind} ${backend}
     "\"${backend}\"" ${ARGN})
@@ -136,6 +151,20 @@ function(mfront_generic_parallel_behaviours_check_library name backend)
     ${ARGN})
 endfunction(mfront_generic_parallel_behaviours_check_library)
 
+# Library generated by the `generic-parallel` interface with the
+# `generic_functions` option: it also contains the functions of the
+# `generic` interface.
+#
+# usage: mfront_generic_parallel_check_library_with_generic_functions(name
+#                                                       kind backend sources...)
+# where `kind` is `behaviours` or `material-properties`.
+function(mfront_generic_parallel_check_library_with_generic_functions name
+                                                                      kind
+                                                                      backend)
+  set(_mgis_generic_functions ON)
+  _mfront_generic_parallel_check_library(${name} ${kind} ${backend} ${ARGN})
+endfunction(mfront_generic_parallel_check_library_with_generic_functions)
+
 # Library of material properties generated by the `generic-parallel`
 # interface.
 #
diff --git a/docs/web/generic-parallel.md b/docs/web/generic-parallel.md
index aa50f32..f96ddae 100644
--- a/docs/web/generic-parallel.md
+++ b/docs/web/generic-parallel.md
@@ -71,6 +71,16 @@ post-processings and the rotations of a point, the `C` bindings) report an
 error for a `generic-parallel` library. Conversely, the batch functions
 report an error for a library of the `generic` interface.
 
+The functions of batches of points and the functions of a point are
+detected independently: the former exist if the library exports
+`<name>_generic_parallel_api_version` (`batch_api_version` member of the
+description, read by `isGenericParallelBehaviour`), the latter if the
+library exports `Generic` as interface. A library generated by the
+`generic-parallel` interface with its `generic_functions` option contains
+both: both kinds of functions are loaded, the functions acting on a
+single point use the functions of a point, and the functions acting on a
+material data manager use the functions of batches of points.
+
 # Integration of a batch
 
