+/*!
+ * \brief execution policies of the backend given to MGIS: the description
+ * of the behaviour gives the identifier of the policy expected by the
+ * library, a policy of another backend is refused, as an asynchronous
+ * backend policy with a synchronous execution policy (no statistics), and a
+ * synchronous backend policy with an asynchronous execution policy gives
+ * computations completed when the function returns
+ */
+static void testExecutionPolicies(const std::string& library,
+                                  const std::string& gpu_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{100};
+  const auto stream = Stream{};
+  auto temperature = ManagedArray(1);
+  temperature.span()[0] = 293.15;
+  auto managers = Managers(library, gpu_library, "Norton", n);
+  setExternalStateVariable(managers.m.s0, "Temperature", 293.15);
+  setExternalStateVariable(managers.m.s1, "Temperature", 293.15);
+  for (auto* const s : {&managers.gpu_m.s0, &managers.gpu_m.s1}) {
+    setExternalStateVariable(*s, "Temperature", temperature.span(),
+                             MaterialStateManager::EXTERNAL_STORAGE);
+  }
+  for (auto* const m : {&managers.m, &managers.gpu_m}) {
+    for (mgis::size_type i = 0; i != n; ++i) {
+      m->s1.gradients[i * m->s1.gradients_stride] =
+          2e-4 * (1 + static_cast<double>(i) / n);
+    }
+  }
+  check(managers.gpu_b.execution_policy ==
+            Stream::BackendExecutionPolicy::identifier(),
+        "invalid identifier of the execution policy of the library");
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  // policy of another backend
+#if defined(MGIS_TESTS_PARALLEL_STL_ON_NVIDIA_GPU)
+  const auto other = mfront::generic_parallel::OpenMPBackendExecutionPolicy{};
+#else
+  const auto other =
+      mfront::generic_parallel::ParallelSTLBackendExecutionPolicy{};
+#endif
+  check(throws(
+            [&managers, &opts, &other] {
+              static_cast<void>(
+                  integrate(BatchExecutionPolicy{.backend_policy = &other},
+                            managers.gpu_m, opts, 180));
+            },
+            "the execution policy is not the one of the backend"),
+        "a policy of another backend must be refused");
+  // asynchronous backend policy with a synchronous execution policy
+  check(throws(
+            [&managers, &opts, &stream] {
+              static_cast<void>(integrate(
+                  BatchExecutionPolicy{.backend_policy =
+                                           &(stream.asynchronous_policy)},
+                  managers.gpu_m, opts, 180));
+            },
+            "an asynchronous computation requires statistics"),
+        "an asynchronous backend policy must be refused by a synchronous "
+        "execution policy");
+  // synchronous backend policy with an asynchronous execution policy
+  auto resource = mgis::memory_resources::CUDAManagedMemoryResource{};
+  auto p = AsynchronousBatchExecutionPolicy{};
+  p.backend_policy = &(stream.synchronous_policy);
+  p.resource = &resource;
+  p.location = MemoryLocation::SHARED;
+  const auto r = integrate(managers.m, opts, 180);
+  const auto pending = integrate(p, managers.gpu_m, opts, 180);
+  check(cudaStreamQuery(stream.stream) == cudaSuccess,
+        "a synchronous backend policy must complete the computations before "
+        "the function returns");
+  const auto gpu_r = pending.getResult();
+  checkResults("Norton, synchronous backend policy", r, gpu_r, managers.m,
+               managers.gpu_m);
+}  // end of testExecutionPolicies
+
 int main(const int argc, const char* const* const argv) {
   if (argc != 6) {
     std::cerr << "usage: " << argv[0]
@@ -991,6 +1067,7 @@ int main(const int argc, const char* const* const argv) {
     testMaterialProperties(argv[4], argv[3]);
     testPartialFailures(argv[1]);
     testAsynchronousComputations(argv[2], argv[1], argv[4], argv[3]);
+    testExecutionPolicies(argv[2], argv[1]);
   } catch (std::exception& e) {
     std::cerr << e.what() << '\n';
     return EXIT_FAILURE;
