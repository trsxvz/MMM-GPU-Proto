+
+  /*!
+   * \brief evaluation of a material property on a set of points submitted
+   * asynchronously (see `AsynchronousBatchExecutionPolicy`).
+   *
+   * This object holds the statuses of the evaluation, written by the device
+   * when a bound is violated or when a result is invalid. It must not be
+   * destroyed before the evaluation is completed.
+   */
+  struct [[nodiscard]] MGIS_EXPORT PendingBatchEvaluation {
+    /*!
+     * \brief constructor. The statuses are allocated with the memory
+     * resource of the policy and set to zero on the host.
