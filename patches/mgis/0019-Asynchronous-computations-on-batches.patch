@@ -294,6 +296,63 @@ namespace mgis::behaviour {
   //! \brief a simple alias
   using BatchOutputStatus = ::mgis_bv_BatchOutputStatus;
 
+  /*
+   * The following functions are copies of the functions handling the
+   * statistics declared in the `MFront/GenericParallelBehaviour/BatchData.h`
+   * header of `TFEL`. The minimum of the time step scaling factors is stored
+   * as an ordered key, so that the device can update it with an integer
+   * atomic operation.
+   */
+
+  /*!
+   * \brief initialize the statistics of a batch
+   * \param[out] s: statistics
+   * \param[in] rdt: initial value of the time step scaling factor
+   */
+  inline void initializeBatchStatistics(BatchStatistics& s,
+                                        const mgis::real rdt) noexcept {
+    static_assert(sizeof(mgis::real) == sizeof(unsigned long long));
+    constexpr auto sign = 0x8000000000000000ull;
+    const auto b = std::bit_cast<unsigned long long>(rdt);
+    s.number_of_failures = 0;
+    s.first_failure_index = ~0ull;
+    s.number_of_unreliable_results = 0;
+    s.rdt = (b & sign) ? ~b : (b | sign);
+  }  // end of initializeBatchStatistics
+
+  /*!
+   * \return the minimum of the time step scaling factors
+   * \param[in] s: statistics
+   */
+  inline mgis::real getTimeStepScalingFactor(
+      const BatchStatistics& s) noexcept {
+    constexpr auto sign = 0x8000000000000000ull;
+    const auto b = (s.rdt & sign) ? (s.rdt & ~sign) : ~(s.rdt);
+    return std::bit_cast<mgis::real>(b);
+  }  // end of getTimeStepScalingFactor
+
+  /*!
+   * \return the output status associated with the statistics of a batch,
+   * as returned by synchronous computations
+   * \param[in] s: statistics
+   */
+  inline BatchOutputStatus getBatchOutputStatus(
+      const BatchStatistics& s) noexcept {
+    auto o = BatchOutputStatus{};
+    o.status = (s.number_of_failures != 0)
+                   ? -1
+                   : ((s.number_of_unreliable_results != 0) ? 0 : 1);
+    o.number_of_failures = static_cast<mgis::size_type>(s.number_of_failures);
+    o.first_failure_index =
+        (s.first_failure_index == ~0ull)
+            ? std::numeric_limits<mgis::size_type>::max()
+            : static_cast<mgis::size_type>(s.first_failure_index);
+    o.number_of_unreliable_results =
+        static_cast<mgis::size_type>(s.number_of_unreliable_results);
+    o.rdt = getTimeStepScalingFactor(s);
+    return o;
+  }  // end of getBatchOutputStatus
+
 }  // end of namespace mgis::behaviour
 
 #endif /* __cplusplus */
