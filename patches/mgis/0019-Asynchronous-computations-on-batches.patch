+/*!
+ * \file   src/BatchExecutionPolicy.cxx
+ * \brief  This file implements the functions related to the execution
+ * policies of the computations on batches.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#include <string>
+#include "MGIS/Raise.hxx"
+#include "MGIS/BatchExecutionPolicy.hxx"
+
+namespace mgis {
+
+  void checkAsynchronousBatchExecutionPolicy(
+      std::string_view f,
+      const AsynchronousBatchExecutionPolicy& p,
+      std::string_view s) {
+    // the status is initialized and read by the host
+    if (!canAllocateIn(p.location, p.resource)) {
+      mgis::raise(std::string{f} +
+                  ": the status of asynchronous computations can't be "
+                  "allocated in " +
+                  getMemoryLocationDescription(p.location) +
+                  " (a memory resource allocating shared memory is required "
+                  "if the memory of the host is not accessible by the "
+                  "computations)");
+    }
+    if (!isMemoryLocationAccessible(s, p.location)) {
+      mgis::raise(std::string{f} +
+                  ": the status of asynchronous computations, allocated in " +
+                  getMemoryLocationDescription(p.location) +
+                  ", is not accessible by the computations (memory space '" +
+                  std::string{s} + "')");
+    }
+  }  // end of checkAsynchronousBatchExecutionPolicy
+
+}  // end of namespace mgis
