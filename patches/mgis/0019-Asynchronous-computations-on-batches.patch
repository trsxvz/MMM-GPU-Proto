+/*!
+ * \brief asynchronous computations on a stream, the statistics and the
+ * statuses being allocated in managed memory: the pending computations give
+ * the results once the stream is synchronized
+ */
+static void testAsynchronousComputations(const std::string& library,
+                                         const std::string& gpu_library,
+                                         const std::string& mp_library,
+                                         const std::string& gpu_mp_library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = mgis::size_type{100};
+  constexpr auto h = Hypothesis::TRIDIMENSIONAL;
+  const auto stream = Stream{};
+  auto resource = mgis::memory_resources::CUDAManagedMemoryResource{};
+  auto p = AsynchronousBatchExecutionPolicy{};
+  p.queue = stream.stream;
+  p.resource = &resource;
+  p.location = MemoryLocation::SHARED;
+  auto synchronize = [&stream] {
+    if (cudaStreamSynchronize(stream.stream) != cudaSuccess) {
+      throw std::runtime_error("synchronization of the stream failed");
+    }
+  };
+  auto temperature = ManagedArray(1);
+  temperature.span()[0] = 293.15;
+  // integration
+  {
+    auto managers = Managers(library, gpu_library, "Norton", n);
+    setExternalStateVariable(managers.m.s0, "Temperature", 293.15);
