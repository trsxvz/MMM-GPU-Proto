+/*!
+ * \brief asynchronous evaluations: the pending evaluations give the output
+ * statuses of the synchronous ones, the bounds being checked by the
+ * function analysing the statuses
+ */
+static void testAsynchronousEvaluations(const std::string& library,
+                                        const std::string& gp_library) {
+  using namespace mgis::material_property;
+  const auto e = AsynchronousBatchExecutionPolicy{};
+  const auto mp = load(library, "MaterialPropertyBoundCheck");
+  const auto gp_mp = load(gp_library, "MaterialPropertyBoundCheck");
+  check((gp_mp.batch_report_fct != nullptr) && (gp_mp.number_of_statuses != 0),
+        "MaterialPropertyBoundCheck: the report function and the number of "
+        "statuses must be loaded");
+  // the temperature of the third point is out of its bounds, [200:300]
+  const auto T = std::array<mgis::real, 4>{250, 280, 350, 210};
+  const auto inputs = std::array{std::span<const mgis::real>(T)};
+  auto E = std::vector<mgis::real>(T.size());
+  auto gp_E = std::vector<mgis::real>(T.size());
+  for (const auto& [p, status] :
+       {std::pair{MGIS_MATERIALPROPERTY_NONE_POLICY, 0},
+        std::pair{MGIS_MATERIALPROPERTY_WARNING_POLICY, 1},
+        std::pair{MGIS_MATERIALPROPERTY_STRICT_POLICY, -1}}) {
+    // reference: synchronous evaluation
+    const auto s = evaluate(E, gp_mp, inputs, MemoryLocation::HOST, p);
+    std::fill(gp_E.begin(), gp_E.end(), mgis::real{});
+    const auto pending =
+        evaluate(e, gp_E, gp_mp, inputs, MemoryLocation::HOST, p);
+    const auto gp_s = pending.getResult();
+    check((s.status == status) && (gp_s.status == status) &&
+              (gp_s.bounds_status == s.bounds_status) &&
+              (std::string_view{gp_s.msg} == std::string_view{s.msg}),
+          "MaterialPropertyBoundCheck, asynchronous evaluation: invalid "
+          "status for policy " +
+              std::to_string(static_cast<int>(p)) + " (" +
+              std::to_string(s.status) + ", " + std::to_string(gp_s.status) +
+              ")");
+    if (status >= 0) {
+      check(compare(E, gp_E) < 1e-14,
+            "MaterialPropertyBoundCheck, asynchronous evaluation: invalid "
+            "values");
+    }
+  }
+  // no point
+  const auto T0 = std::array<mgis::real, 1>{250};
+  const auto uniform_inputs = std::array{std::span<const mgis::real>(T0)};
+  check(evaluate(e, std::span<mgis::real>{}, gp_mp, uniform_inputs)
+                .getResult()
+                .status == 0,
+        "asynchronous evaluation without point: invalid status");
+  check(throws([&e, &E, &mp,
+                &inputs] { static_cast<void>(evaluate(e, E, mp, inputs)); },
+               "has not been generated by the generic-parallel interface"),
+        "an asynchronous evaluation must be refused for the material "
+        "property of a point");
+}  // end of testAsynchronousEvaluations
+
