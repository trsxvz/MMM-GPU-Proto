+                           const BatchMaterialPropertyReportFctPtr,
+                           const size_type,
+                           const OutOfBoundsPolicy);
+    //! \brief move constructor
+    PendingBatchEvaluation(PendingBatchEvaluation&&);
+    //! \brief move assignement
+    PendingBatchEvaluation& operator=(PendingBatchEvaluation&&);
+    PendingBatchEvaluation(const PendingBatchEvaluation&) = delete;
+    PendingBatchEvaluation& operator=(const PendingBatchEvaluation&) = delete;
+    //! \brief destructor
+    ~PendingBatchEvaluation();
+    //! \return the statuses given to the generated function
+    int* getStatuses() noexcept;
+    /*!
+     * \return the output status of the evaluation, as returned by the
+     * synchronous evaluation (see `evaluate`).
+     * \note this function must be called once the evaluation is completed,
+     * i.e. once the calling code has synchronized the queue.
+     */
+    OutputStatus getResult() const;
+
+   private:
+    //! \brief statuses of the evaluation
+    std::pmr::vector<int> statuses;
+    //! \brief name of the material property
+    std::string material_property;
+    //! \brief function analysing the statuses
+    BatchMaterialPropertyReportFctPtr report;
+    //! \brief out of bounds policy of the evaluation
+    OutOfBoundsPolicy policy;
+  };  // end of struct PendingBatchEvaluation
+
+}  // end of namespace mgis::material_property
+
+#endif /* LIB_MGIS_MATERIALPROPERTY_PENDINGBATCHEVALUATION_HXX */
