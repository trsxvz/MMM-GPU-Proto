@@ -44,6 +50,79 @@ namespace mgis {
     bool preserve_stack_size = false;
   };
 
+  /*!
+   * \brief asynchronous execution of the computations on a batch of points.
+   *
+   * The functions taking this policy return once the computations are
+   * submitted to the queue. They return an object which gives the result of
+   * the computations once the calling code has synchronized the queue
+   * (`behaviour::PendingBatchComputation` for the behaviours and the
+   * models, `material_property::PendingBatchEvaluation` for the material
+   * properties). The outputs must not be read before.
+   *
+   * The status of the computations is written by the device in memory held
+   * by this object, which must not be destroyed before the computations are
+   * completed. This memory is allocated by the memory resource `resource`,
+   * and is initialized and read by the host: it must be accessible by the
+   * host and by the computations (see `checkAsynchronousBatchExecutionPolicy`).
+   *
+   * Some backends compute synchronously even with this policy: `stlpar`,
+   * `openmp`, and `sycl` when data are transferred. The result is then
+   * available as soon as the function returns. With the `sycl` backend, the
+   * queue must be in-order: an out-of-order queue gives no order between
+   * the computations, and is refused.
+   */
+  struct AsynchronousBatchExecutionPolicy {
+    //! \brief queue on which the computations are submitted
+    //! (see `BatchExecutionPolicy::queue`)
+    void* queue = nullptr;
+    //! \brief see `BatchExecutionPolicy::preserve_stack_size`
+    bool preserve_stack_size = false;
+    /*!
+     * \brief memory resource allocating the status of the computations, or
+     * null for the memory of the host
+     */
+    std::pmr::memory_resource* resource = nullptr;
+    //! \brief location of the memory allocated by the memory resource
+    MemoryLocation location = MemoryLocation::HOST;
+  };
+
+  /*!
+   * \return the synchronous policy using the same queue and the same stack
+   * size policy
+   * \param[in] p: asynchronous policy
+   */
+  constexpr BatchExecutionPolicy getSynchronousBatchExecutionPolicy(
+      const AsynchronousBatchExecutionPolicy& p) noexcept {
+    return {.queue = p.queue, .preserve_stack_size = p.preserve_stack_size};
+  }  // end of getSynchronousBatchExecutionPolicy
+
+  /*!
+   * \return the memory resource allocating the status of asynchronous
+   * computations: the one of the policy, or the default resource of the
+   * standard library (memory of the host)
+   * \param[in] p: asynchronous policy
+   */
+  inline std::pmr::memory_resource* getMemoryResource(
+      const AsynchronousBatchExecutionPolicy& p) noexcept {
+    return p.resource != nullptr ? p.resource : std::pmr::new_delete_resource();
+  }  // end of getMemoryResource
+
+  /*!
+   * \brief check that the status of asynchronous computations can be
+   * allocated with the given policy for a library: the memory must be
+   * allocated in the memory of the host, or in shared memory by a memory
+   * resource (see `canAllocateIn`), and be accessible by the computations of
+   * the library. An exception is thrown otherwise.
+   * \param[in] f: calling function
+   * \param[in] p: asynchronous policy
+   * \param[in] s: memory space of the library
+   */
+  MGIS_EXPORT void checkAsynchronousBatchExecutionPolicy(
+      std::string_view,
+      const AsynchronousBatchExecutionPolicy&,
+      std::string_view);
+
 }  // end of namespace mgis
 
 #endif /* LIB_MGIS_BATCHEXECUTIONPOLICY_HXX */
