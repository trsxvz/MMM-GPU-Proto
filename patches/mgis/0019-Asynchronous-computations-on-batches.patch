+    auto ev = std::vector<mgis::real>(n, 300);
+    ev[5] = ev[9] = 600;
+    managers.apply([&ev](MaterialDataManager& m) {
+      for (auto* const s : {&m.s0, &m.s1}) {
+        setMaterialProperty(*s, "YoungModulus", 150e9);
+        setMaterialProperty(*s, "PoissonRatio", 0.3);
+        setExternalStateVariable(*s, "Temperature", 293.15);
+        setExternalStateVariable(*s, "ExternalStateVariable", ev,
+                                 MaterialStateManager::EXTERNAL_STORAGE);
+      }
+      for (mgis::size_type i = 0; i != m.n; ++i) {
+        m.s1.gradients[i * m.s1.gradients_stride] = 1e-3;
+      }
+    });
+    auto opts = BehaviourIntegrationOptions{};
+    opts.integration_type =
+        IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+    const auto ok = integrate(p, managers.gp_m, opts, 1, 0, 5).getResult();
+    const auto sync_ok = integrate(managers.gp_m, opts, 1, 0, 5);
+    check((ok.exit_status == 1) && (ok.time_step_increase_factor ==
+                                    sync_ok.time_step_increase_factor),
+          "asynchronous integration without failure: invalid result");
+    const auto pending = integrate(p, managers.gp_m, opts, 1);
+    const auto r = pending.getResult();
+    check(
+        (r.exit_status == -1) && (r.n == 5) &&
+            (r.error_message.find("2 integration points") != std::string::npos),
+        "asynchronous integration: invalid index of the first failure");
+    const auto rr = integrate(p, managers.gp_m, opts, 1, 7, 12).getResult();
+    check((rr.exit_status == -1) && (rr.n == 9),
+          "asynchronous integration of a range: invalid index of the first "
+          "failure");
+    const auto empty = integrate(p, managers.gp_m, opts, 1, 3, 3).getResult();
+    check((empty.exit_status == 1) &&
