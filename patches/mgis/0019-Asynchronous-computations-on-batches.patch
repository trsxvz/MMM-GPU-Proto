+/*!
+ * \file   include/MGIS/Behaviour/PendingBatchComputation.hxx
+ * \brief  This file declares the `PendingBatchComputation` class.
+ * \date   08/10/2026
+ * \copyright Use, modification and distribution are subject
+ * to one of the following licences:
+ * - GNU Lesser General Public License (LGPL), Version 3.0. (See accompanying
+ *   file LGPL-3.0.txt)
+ * - CECILL-C,  Version 1.0 (See accompanying files
+ *   CeCILL-C_V1-en.txt and CeCILL-C_V1-fr.txt).
+ */
+
+#ifndef LIB_MGIS_BEHAVIOUR_PENDINGBATCHCOMPUTATION_HXX
+#define LIB_MGIS_BEHAVIOUR_PENDINGBATCHCOMPUTATION_HXX
+
+#include <span>
+#include <string>
+#include <vector>
+#include <optional>
+#include <string_view>
+#include <memory_resource>
+#include "MGIS/Config.hxx"
+#include "MGIS/BatchExecutionPolicy.hxx"
+#include "MGIS/Behaviour/BatchDataView.hxx"
+
+namespace mgis::behaviour {
+
+  // forward declaration
+  struct BehaviourIntegrationResult;
+
+  /*!
+   * \brief computations on a batch of integration points submitted
+   * asynchronously (see `AsynchronousBatchExecutionPolicy`): integration,
+   * initialize function, post-processing or rotation.
+   *
+   * This object holds the statistics of the computations, written by the
+   * device, and the data built by `MGIS` and read by the device (rotation
+   * matrices built from the material axes). It must not be destroyed
+   * before the computations are completed.
+   */
+  struct [[nodiscard]] MGIS_EXPORT PendingBatchComputation {
+    /*!
+     * \brief constructor. The statistics are allocated with the memory
+     * resource of the policy and initialized on the host.
+     * \param[in] p: execution policy
+     * \param[in] f: name of the function submitting the computations
+     * \param[in] b: index of the first point of the batch
+     * \param[in] rdt: initial value of the time step scaling factor, if
+     * the result reports the time step scaling factor (integrations)
+     * \param[in] n: number of values of the workspace
+     */
+    PendingBatchComputation(const AsynchronousBatchExecutionPolicy&,
+                            std::string_view,
+                            const size_type,
+                            const std::optional<real>,
+                            const size_type = 0);
+    //! \brief move constructor
+    PendingBatchComputation(PendingBatchComputation&&);
+    //! \brief move assignement
+    PendingBatchComputation& operator=(PendingBatchComputation&&);
+    PendingBatchComputation(const PendingBatchComputation&) = delete;
+    PendingBatchComputation& operator=(const PendingBatchComputation&) = delete;
+    //! \brief destructor
+    ~PendingBatchComputation();
+    //! \return the statistics given to the generated function
+    BatchStatistics* getStatistics() noexcept;
+    /*!
+     * \return the workspace, allocated with the memory resource of the
+     * policy, which holds data read by the device during the computations
+     */
+    std::span<real> getWorkspace() noexcept;
+    /*!
+     * \return the result of the computations, as returned by the
+     * synchronous functions (see `BehaviourIntegrationResult`).
+     * \note this function must be called once the computations are
+     * completed, i.e. once the calling code has synchronized the queue.
+     */
+    BehaviourIntegrationResult getResult() const;
+
+   private:
+    //! \brief statistics of the computations (one structure)
+    std::pmr::vector<BatchStatistics> statistics;
+    //! \brief workspace
+    std::pmr::vector<real> workspace;
+    //! \brief name of the function which submitted the computations
+    std::string function;
+    //! \brief index of the first point of the batch
+    size_type first_point;
+    //! \brief true if the result reports the time step scaling factor
+    bool reports_time_step_scaling_factor;
+  };  // end of struct PendingBatchComputation
+
+}  // end of namespace mgis::behaviour
+
+#endif /* LIB_MGIS_BEHAVIOUR_PENDINGBATCHCOMPUTATION_HXX */
