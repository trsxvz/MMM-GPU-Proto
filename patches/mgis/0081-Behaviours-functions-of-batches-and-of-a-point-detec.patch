 .../MGIS/Behaviour/BehaviourDescription.hxx   | 18 ++++++++++---
 include/MGIS/LibrariesManager.hxx             | 18 +++++++------
 src/Behaviour.cxx                             | 23 +++++++++++++----
 src/BehaviourDescription.cxx                  |  6 +++--
 src/Integrate.cxx                             |  3 ++-
 src/LibrariesManager.cxx                      | 25 ++++++++++++-------
 7 files changed, 76 insertions(+), 36 deletions(-)

