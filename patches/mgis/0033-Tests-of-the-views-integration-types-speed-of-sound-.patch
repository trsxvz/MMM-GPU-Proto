+//! \brief all the integration types, predictions included
+static void testIntegrationTypes(const std::string& library) {
+  using namespace mgis::behaviour;
+  constexpr auto n = size_type{5};
+  const auto e = load(library, "Elasticity", Hypothesis::TRIDIMENSIONAL);
+  const auto nb = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  for (const auto it :
+       {IntegrationType::PREDICTION_TANGENT_OPERATOR,
+        IntegrationType::PREDICTION_SECANT_OPERATOR,
+        IntegrationType::PREDICTION_ELASTIC_OPERATOR,
+        IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR,
+        IntegrationType::INTEGRATION_ELASTIC_OPERATOR,
+        IntegrationType::INTEGRATION_SECANT_OPERATOR,
+        IntegrationType::INTEGRATION_TANGENT_OPERATOR,
+        IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR}) {
+    const auto t =
+        ", integration type " + std::to_string(static_cast<int>(it)) + ", ";
+    compareIntegrations("Elasticity" + t + library, e, n, setupElasticity,
+                        loadStrain, 2, {0, 0}, it);
+    compareIntegrations("Norton" + t + library, nb, n, setupTemperature,
+                        loadStrain, 2, {1, 4}, it);
+  }
+}  // end of testIntegrationTypes
