index 0000000..92bfe07
--- /dev/null
+++ b/tests/EnergyTest.mfront
@@ -0,0 +1,29 @@
+@DSL Default;
+@Behaviour EnergyTest;
+@Description {
+  Linear elasticity computing the stored and the dissipated energies. The
+  dissipated energy is increased at each time step, so that its value at
+  the beginning of the time step is read.
+}
+
+@ProvidesSymmetricTangentOperator;
+@Integrator{
+  constexpr auto id = Stensor::Id();
+  constexpr auto yg = stress{150e9};
+  constexpr auto nu = real{0.3};
+  constexpr auto l = computeLambda(yg, nu);
+  constexpr auto mu = computeMu(yg, nu);
+  const auto e = eto + deto;
+  sig = l * trace(e) * id + 2 * mu * e;
+  if (computeTangentOperator_) {
+    Dt = l * Stensor4::IxI() + 2 * mu * Stensor4::Id();
+  }
+}
+
+@InternalEnergy {
+  Psi_s = (sig | (eto + deto)) / 2;
+}
+
+@DissipatedEnergy {
+  Psi_d += (sig | deto) / 10;
+}
