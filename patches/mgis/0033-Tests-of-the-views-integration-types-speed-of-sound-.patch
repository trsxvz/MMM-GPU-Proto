+  for (const auto a : arrangements) {
+    auto m = MaterialDataManager(b, n);
+    auto d = ViewData(b, n, a);
+    d.v.K = FieldView<real>{};
+    setupTemperature(m, d.v);
+    loadStrain(m, 0);
+    d.copyFrom(m);
+    const auto r = integrate(m, opts, 1);
+    const auto rv = integrate(ws, d.v, opts, 1);
+    check((r.exit_status == rv.exit_status) && (d.hasSameOutputs(m, false)),
+          "integration without tangent operator blocks, " + library + ", " +
+              getName(a) + ": invalid results");
+  }
+}  // end of testWithoutTangentOperator
