+static void testEmptySets(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "Norton", Hypothesis::TRIDIMENSIONAL);
+  const auto gp = isGenericParallelBehaviour(b);
+  auto opts = BehaviourIntegrationOptions{};
+  opts.integration_type =
+      IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  auto ops = mgis::HostFieldOperations{};
+  auto ws = BehaviourIntegrationWorkSpace(b);
+  const auto msg = "empty sets, " + library + ": ";
+  // no point
+  for (const auto a : arrangements) {
+    auto m = MaterialDataManager(b, 0);
+    auto d = ViewData(b, 0, a);
+    setupTemperature(m, d.v);
+    check(integrate(m, opts, 1).exit_status == 1,
+          msg + "invalid status of a manager without point");
+    check(integrate(ws, d.v, opts, 1).exit_status == 1,
+          msg + "invalid status of a view without point");
+    if (gp) {
+      check(integrate(BatchExecutionPolicy{}, d.v, opts, 1).exit_status == 1,
+            msg + "invalid status of a view without point (synchronous)");
+      check(integrate(AsynchronousBatchExecutionPolicy{}, d.v, opts, 1)
+                    .getResult()
+                    .exit_status == 1,
+            msg + "invalid status of a view without point (asynchronous)");
+    }
+    update(d.v, ops);
+    revert(d.v, ops);
+    updateValues(d.v.s0, d.v.s1, ops);
+  }
+  // empty range
+  constexpr auto n = size_type{5};
+  for (const auto a : arrangements) {
+    auto m = MaterialDataManager(b, n);
+    m.allocateArrayOfTangentOperatorBlocks();
+    auto d = ViewData(b, n, a);
+    setupTemperature(m, d.v);
+    loadStrain(m, 0);
+    d.copyFrom(m);
+    check(integrate(ws, d.v, opts, 1, 3, 3).exit_status == 1,
+          msg + "invalid status of an empty range");
+    if (gp) {
+      check(integrate(BatchExecutionPolicy{}, d.v, opts, 1, 3, 3).exit_status ==
+                1,
+            msg + "invalid status of an empty range (synchronous)");
+      check(integrate(AsynchronousBatchExecutionPolicy{}, d.v, opts, 1, 3, 3)
+                    .getResult()
+                    .exit_status == 1,
+            msg + "invalid status of an empty range (asynchronous)");
+    }
+    check(d.hasSameOutputs(m, true),
+          msg + "values modified by the integration of an empty range");
+  }
+  // initialize functions and post-processings without point
+  const auto bi =
+      load(library, "InitializeFunctionTest", Hypothesis::TRIDIMENSIONAL);
+  auto wsi = BehaviourIntegrationWorkSpace(bi);
+  auto di = ViewData(bi, 0, Arrangement::COMPONENT_BY_COMPONENT);
+  check(executeInitializeFunction(wsi, di.v, "ElasticStrainFromInitialStress")
+                .exit_status == 1,
+        msg + "invalid status of an initialize function without point");
+  const auto bp =
+      load(library, "PostProcessingTest", Hypothesis::TRIDIMENSIONAL);
+  auto wsp = BehaviourIntegrationWorkSpace(bp);
+  auto dp = ViewData(bp, 0, Arrangement::COMPONENT_BY_COMPONENT);
+  check(executePostProcessing(FieldView<real>{}, wsp, dp.v, "PrincipalStrain")
+                .exit_status == 1,
+        msg + "invalid status of a post-processing without point");
+}  // end of testEmptySets
