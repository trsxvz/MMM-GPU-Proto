+//! \brief speed of sound, mass density given at each point
+static void testSpeedOfSound(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b =
+      load(library, "ComputeSpeedOfSound", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{6};
+  auto rho = std::vector<real>(n);
+  for (size_type i = 0; i != n; ++i) {
+    rho[i] = 7800 + 10 * static_cast<real>(i);
+  }
+  const auto setup = [&rho](MaterialDataManager& m, MaterialDataView& v) {
+    setupTemperature(m, v);
+    for (auto* const s : {&m.s0, &m.s1}) {
+      setMassDensity(*s, rho, MaterialStateManager::EXTERNAL_STORAGE);
+    }
+    const auto rv = mgis::makeFieldView(std::span<const real>(rho),
+                                        FieldLayout::POINT_BY_POINT, v.n, 1);
+    setMassDensity(v.s0, rv);
+    setMassDensity(v.s1, rv);
+  };
+  const auto ct = IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR;
+  compareIntegrations("ComputeSpeedOfSound, " + library, b, n, setup,
+                      loadStrain, 1, {0, 0}, ct, true);
+  compareIntegrations("ComputeSpeedOfSound, range, " + library, b, n, setup,
+                      loadStrain, 1, {1, 4}, ct, true);
+}  // end of testSpeedOfSound
