+/*!
+ * \brief model: the groups of the gradients and of the thermodynamic forces
+ * are empty
+ * \param[in] library: library of the model
+ */
+static void testModel(const std::string& library) {
+  using namespace mgis::behaviour;
+  const auto b = load(library, "ode_rk54", Hypothesis::TRIDIMENSIONAL);
+  constexpr auto n = size_type{7};
+  setParameter(b, "A", 2.5);
+  const auto x0 = [&b](MaterialDataManager& m, const int step) {
+    if (step != 0) {
+      return;
+    }
+    const auto o = getVariableOffset(b.isvs, "x", b.hypothesis);
+    for (size_type i = 0; i != m.n; ++i) {
+      m.s0.internal_state_variables[i * m.s0.internal_state_variables_stride +
+                                    o] =
+          1 + static_cast<real>(i) / static_cast<real>(m.n);
+    }
+  };
+  const auto nt = IntegrationType::INTEGRATION_NO_TANGENT_OPERATOR;
+  compareIntegrations("ode_rk54, " + library, b, n, setupTemperature, x0, 3,
+                      {0, 0}, nt);
+  compareIntegrations("ode_rk54, range, " + library, b, n, setupTemperature, x0,
+                      2, {2, 5}, nt);
+}  // end of testModel
