+//! \brief setup of the Elasticity behaviour, uniform values
+static void setupElasticity(mgis::behaviour::MaterialDataManager& m,
+                            mgis::behaviour::MaterialDataView& v) {
+  using namespace mgis::behaviour;
+  static constexpr auto values = std::array<real, 3>{150e9, 0.3, 293.15};
+  for (auto* const s : {&m.s0, &m.s1}) {
+    setMaterialProperty(*s, "YoungModulus", values[0]);
+    setMaterialProperty(*s, "PoissonRatio", values[1]);
+    setExternalStateVariable(*s, "Temperature", values[2]);
+  }
+  const auto value = [&v](const size_type i) {
+    return mgis::makeUniformFieldView(std::span<const real>(&values[i], 1),
+                                      v.n);
+  };
+  for (auto* const s : {&v.s0, &v.s1}) {
+    setMaterialProperty(*s, "YoungModulus", value(0));
+    setMaterialProperty(*s, "PoissonRatio", value(1));
+    setExternalStateVariable(*s, "Temperature", value(2));
+  }
+}  // end of setupElasticity
+
+//! \brief uniform temperature, for the behaviours with no material property
+static void setupTemperature(mgis::behaviour::MaterialDataManager& m,
+                             mgis::behaviour::MaterialDataView& v) {
+  using namespace mgis::behaviour;
+  static constexpr auto temperature = real{293.15};
+  setExternalStateVariable(m.s0, "Temperature", temperature);
+  setExternalStateVariable(m.s1, "Temperature", temperature);
+  const auto T =
+      mgis::makeUniformFieldView(std::span<const real>(&temperature, 1), v.n);
+  setExternalStateVariable(v.s0, "Temperature", T);
+  setExternalStateVariable(v.s1, "Temperature", T);
+}  // end of setupTemperature
+
+//! \brief strain increasing at each step, different at each point
+static void loadStrain(mgis::behaviour::MaterialDataManager& m,
+                       const int step) {
+  for (size_type i = 0; i != m.n; ++i) {
+    for (size_type c = 0; c != m.s1.gradients_stride; ++c) {
+      m.s1.gradients[i * m.s1.gradients_stride + c] +=
+          1e-4 * static_cast<real>((step + 1) * (c + 1)) *
+          (1 + 0.1 * static_cast<real>(i));
+    }
+  }
+}  // end of loadStrain
