From a49d65d49c17d4351e1d83364929502b0a521147 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 21 Oct 2026 04:10:01 +0200
Subject: [PATCH] Behaviours: a library without functions of batches nor
 functions of a point is refused at loading

As for the material properties, a library of a version of the
generic-parallel interface older than version 3 (no
<name>_generic_parallel_api_version symbol) gives a dedicated message.
---
 src/Behaviour.cxx | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/Behaviour.cxx b/src/Behaviour.cxx
index 4a71274..c36231c 100644
--- a/src/Behaviour.cxx
+++ b/src/Behaviour.cxx
@@ -85,6 +85,24 @@ namespace mgis::behaviour {
     // may provide both
     const auto batch = isGenericParallelBehaviour(d);
     const auto pointwise = (d.interface.empty()) || (d.interface == "Generic");
+    if ((!batch) && (!pointwise)) {
+      // a library generated by the versions of the generic-parallel
+      // interface older than version 3 does not export the version of its
+      // functions
+      if (d.interface == "GenericParallel") {
+        mgis::raise(
+            "mgis::behaviour::load: the library has been generated by a "
+            "version of the generic-parallel interface which is not "
+            "supported (no symbol '" +
+            b + "_generic_parallel_api_version', version " +
+            std::to_string(MGIS_BV_GENERIC_PARALLEL_API_VERSION) +
+            " expected)");
+      }
+      mgis::raise(
+          "mgis::behaviour::load: the library provides no function "
+          "integrating the behaviour (interface '" +
+          d.interface + "')");
+    }
     if (batch) {
       d.batch_b = lm.getBatchBehaviour(l, b, h);
       d.batch_report = lm.getBatchBehaviourReportFunction(l, b);
-- 
