+    /*!
+     * \brief set the block size and the near null space of an assembled
+     * matrix (AIJ formats), if the modes are given
+     * \param[in] m: matrix
+     */
+    void attach(Mat m) const;
+    //! \return true if the rigid body modes are given to the matrices
+    [[nodiscard]] bool isDefined() const noexcept;
+
+   private:
+    //! \brief space dimension, null if the modes are not given
+    int dimension = 0;
+    //! \brief coordinates of the nodes, node by node
+    std::vector<PetscScalar> coordinates;
+  };  // end of struct PETScRigidBodyModes
