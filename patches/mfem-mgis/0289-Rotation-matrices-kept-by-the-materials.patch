+/*!
+ * \brief material axes given by partial quadrature functions and modified
+ * in place after a first integration of the behaviour. The integration
+ * point by point reads the axes at each point. The integration by batches
+ * uses the rotation matrices kept by the material
+ * (`Material::getRotationMatrices`): it goes on with the matrices of the
+ * former axes until `Material::invalidateRotationMatrices` is called, then
+ * gives the stresses of the integration point by point. The gradients in
+ * the global frame, rotated back by the transposed matrices, which are
+ * kept too, are then the ones computed with the former axes: they do not
+ * depend on the axes.
+ * \param[in, out] ctx: execution context
+ * \param[in] mesh: mesh of a cube or, in plane strain, of the unit square
+ * \param[in] library: library of the behaviour integrated by batches
+ * \param[in] reference_library: library of the behaviour integrated point
+ * by point (generic interface)
+ * \param[in] plane_strain: if true, the computations are made in plane
+ * strain, the first direction of orthotropy being given by one function;
+ * otherwise in 3D, the first two directions being given by two functions
+ * \param[in] name: name of the test
+ */
+static void testModifiedMaterialAxes(mfem_mgis::Context& ctx,
+                                     const char* const mesh,
+                                     const char* const library,
+                                     const char* const reference_library,
+                                     const bool plane_strain,
+                                     const std::string& name) {
+  using namespace mfem_mgis;
+  auto or_die = ctx.getFatalFailureHandler();
+  const auto dim = plane_strain ? 2 : 3;
+  // results of two integrations at the same unknowns, the material axes
+  // being modified in place between them
+  struct Integrations {
+    // thermodynamic forces in the material frame
+    std::array<std::vector<real>, 2u> stresses;
+    // gradients in the global frame
+    std::array<std::vector<real>, 2u> gradients;
+    // if true, the rotation matrices and the transposed ones given by the
+    // material after the second integration are the ones of the modified
+    // axes
+    bool matrices = true;
+  };
+  auto integrate = [&](const char* const mode, const char* const l,
+                       const bool invalidate) {
+    // the integration point by point requires the point by point layout,
+    // whatever the layout given by the environment
+    auto parameters = Parameters{
+        {"MeshFileName", mesh},
+        {"FiniteElementFamily", "H1"},
+        {"FiniteElementOrder", 1},
+        {"UnknownsSize", dim},
+        {"NumberOfUniformRefinements", plane_strain ? 0 : 1},
+        {"Hypothesis", plane_strain ? "PlaneStrain" : "Tridimensional"},
+        {"BehaviourIntegration", mode},
+        {"Parallel", false}};
+    if (std::string_view{mode} == "PointByPoint") {
+      parameters.insert(throwing, {{"QuadratureDataLayout", "PointByPoint"}});
+    }
+    auto problem =
+        construct<NonLinearEvolutionProblem>(ctx, parameters) | or_die;
+    problem.addBehaviourIntegrator(ctx, "Mechanics", 1, l,
+                                   "OrthotropicElasticity") |
+        or_die;
+    auto& m = problem.getMaterial(ctx, 1, 0) | or_die;
+    for (auto* s : {&m.s0, &m.s1}) {
+      mgis::behaviour::setExternalStateVariable(ctx, *s, "Temperature",
+                                                293.15) |
+          or_die;
+    }
+    // material axes rotated around the z axis by an angle varying from one
+    // point to another, the functions being shared with the material
+    const auto np = static_cast<std::size_t>(m.n);
+    const auto qspace = m.getPartialQuadratureSpace();
+    auto a1 = std::make_shared<PartialQuadratureFunction>(qspace, dim);
+    auto a2 = std::make_shared<PartialQuadratureFunction>(qspace, dim);
+    auto set_axes = [&a1, &a2, np, dim](const real angle) {
+      auto v1 = a1->getValues();
+      auto v2 = a2->getValues();
+      const auto d = static_cast<std::size_t>(dim);
+      for (std::size_t i = 0; i != np; ++i) {
+        const auto theta = angle + real(0.2) * std::sin(real(i));
+        v1[d * i] = std::cos(theta);
+        v1[d * i + 1] = std::sin(theta);
+        v2[d * i] = -std::sin(theta);
+        v2[d * i + 1] = std::cos(theta);
+        if (d == 3) {
+          v1[d * i + 2] = 0;
+          v2[d * i + 2] = 0;
+        }
+      }
+    };
+    set_axes(real(0.3));
+    if (plane_strain) {
+      m.setRotationMatrix(RotationMatrix2D{a1});
+    } else {
+      m.setRotationMatrix(
+          RotationMatrix3D{std::array<MaterialAxis3D, 2u>{a1, a2}});
+    }
+    // unknowns with a non uniform gradient
+    auto& fespace =
+        problem.getFiniteElementDiscretization().getFiniteElementSpace<false>();
+    auto gf = mfem::GridFunction(&fespace);
+    auto c = mfem::VectorFunctionCoefficient(
+        dim, [dim](const mfem::Vector& x, mfem::Vector& v) {
+          v[0] = 1e-3 * (x[0] * x[0] + 0.3 * x[1]);
+          if (dim == 3) {
+            v[1] = 1e-3 * 0.5 * x[0] * x[2];
+            v[2] = -1e-3 * 0.2 * x[1] * x[1];
+          } else {
+            v[1] = 1e-3 * 0.5 * x[0] * x[1];
+          }
+        });
+    gf.ProjectCoefficient(c);
+    auto u = mfem::Vector{};
+    gf.GetTrueDofs(u);
+    auto r = Integrations{};
+    for (std::size_t step = 0; step != 2; ++step) {
+      if (step == 1) {
+        set_axes(real(0.9));
+        if (invalidate) {
+          m.invalidateRotationMatrices();
+        }
+      }
+      check(problem.integrate(
+                u, IntegrationType::INTEGRATION_CONSISTENT_TANGENT_OPERATOR, 1),
+            name + ": integration (" + mode + ")");
+      // the arrays are read through their views, in all the layouts
+      m.synchronizeOnHostForReading();
+      const auto sv =
+          mgis::behaviour::getThermodynamicForcesView(std::as_const(m.s1));
+      const auto nc = static_cast<size_type>(m.s1.thermodynamic_forces_stride);
+      for (size_type i = 0; i != static_cast<size_type>(np); ++i) {
+        for (size_type k = 0; k != nc; ++k) {
+          r.stresses[step].push_back(sv(i, k));
+        }
+      }
+      auto g = mfem::Vector{};
+      m.computeGradientsInGlobalFrame(g);
+      r.gradients[step].assign(g.HostRead(), g.HostRead() + g.Size());
+    }
+    // kept matrices, from the global frame to the material frame and
+    // transposed, compared to the ones computed from the current axes
+    for (const auto transposed : {false, true}) {
+      const auto matrices = m.getRotationMatrices(transposed).second;
+      for (std::size_t i = 0; i != np; ++i) {
+        const auto expected =
+            m.getRotationMatrixAtIntegrationPoint(static_cast<size_type>(i));
+        for (size_type j = 0; j != 3; ++j) {
+          for (size_type k = 0; k != 3; ++k) {
+            const auto v = matrices(static_cast<size_type>(i), 3 * j + k);
+            const auto e = expected[static_cast<std::size_t>(
+                transposed ? 3 * k + j : 3 * j + k)];
+            r.matrices = r.matrices && (v == e);
+          }
+        }
+      }
+    }
+    return r;
+  };
+  // in float, the rotations of the points one by one and of all the points
+  // at once differ by rounding errors
+  constexpr auto eps = mfem_mgis::unit_tests::tolerance(1e-12, 1e-4);
+  const auto reference = integrate("PointByPoint", reference_library, false);
+  const auto kept = integrate("Batch", library, false);
+  const auto invalidated = integrate("Batch", library, true);
+  const auto change =
+      getRelativeDifference(reference.stresses[0], reference.stresses[1]);
+  const auto d0 =
