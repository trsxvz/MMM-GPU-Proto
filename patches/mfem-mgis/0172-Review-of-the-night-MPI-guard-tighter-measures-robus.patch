From 283e0166e9102fc8af0a09d89a72f48e055441ce Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 14 Oct 2026 05:04:15 +0200
Subject: [PATCH] Review of the night: MPI guard, tighter measures, robust
 dependencies

- PostProcessingsKernelsTest: the reduction of the volumes computed by
  MFEM is guarded by MFEM_USE_MPI (the test did not compile without MPI);
  the comparisons print the relative differences with nine digits. In
  float, the measures and integrals of both computations are now equal and
  differ from the volumes by at most 7.1e-8: their tolerance is 1e-6
  (instead of 1e-4), which detects sums made in float.
- TwoLayerCube: a linear solver which was not measured is given the
  largest float threshold. HypreILUTest prints why a solver is refused.
  Comments of BatchIntegrationTest (sequential computations without
  assembly in float: order of magnitude only) and of
  MicromorphicDamage2DTest2 clarified.
- mfem_mgis_get_mfront_dependencies also finds libTFELMFront through a
  symbolic link to mfront and with the suffix of the installation of TFEL,
  and tells when it is not found; the headers of TFEL are documented as
  not being dependencies.
Float: 74/74 for the changed tests; double: 70/70.
---
 cmake/modules/MFEMMGISBehaviours.cmake | 37 ++++++++++++++++++--------
 tests/BatchIntegrationTest.cxx         |  3 ++-
 tests/HypreILUTest.cxx                 |  3 +++
 tests/MicromorphicDamage2DTest2.cxx    |  5 ++--
 tests/PostProcessingsKernelsTest.cxx   | 26 +++++++++++-------
 tests/TwoLayerCube.cxx                 | 10 ++++---
 6 files changed, 57 insertions(+), 27 deletions(-)

diff --git a/cmake/modules/MFEMMGISBehaviours.cmake b/cmake/modules/MFEMMGISBehaviours.cmake
index cf9cd55c4e..5f2a7e64dd 100644
--- a/cmake/modules/MFEMMGISBehaviours.cmake
+++ b/cmake/modules/MFEMMGISBehaviours.cmake
@@ -205,19 +205,34 @@ endfunction()
 #
 # sets <variable> to the files of MFront on which the generated sources
 # depend: the executable <mfront> and the library holding the code
-# generators (libTFELMFront, in the lib or lib64 directory next to the bin
-# directory of mfront), so that the sources are generated again when MFront
-# changes.
+# generators (libTFELMFront, possibly with the suffix of the installation of
+# TFEL, in the lib or lib64 directory next to the bin directory of mfront,
+# mfront being possibly a symbolic link), so that the sources are generated
+# again when MFront changes. The headers of TFEL are not dependencies: an
+# installation of TFEL changing only them does not rebuild the libraries of
+# behaviours.
 function(mfem_mgis_get_mfront_dependencies variable mfront)
   set(_dependencies "${mfront}")
-  get_filename_component(_prefix "${mfront}" DIRECTORY)
-  get_filename_component(_prefix "${_prefix}" DIRECTORY)
-  foreach(_directory lib lib64)
-    set(_name "${CMAKE_SHARED_LIBRARY_PREFIX}TFELMFront")
-    set(_library "${_prefix}/${_directory}/${_name}${CMAKE_SHARED_LIBRARY_SUFFIX}")
-    if(EXISTS "${_library}")
-      list(APPEND _dependencies "${_library}")
-    endif()
+  get_filename_component(_real "${mfront}" REALPATH)
+  set(_libraries)
+  foreach(_executable "${mfront}" "${_real}")
+    get_filename_component(_prefix "${_executable}" DIRECTORY)
+    get_filename_component(_prefix "${_prefix}" DIRECTORY)
+    foreach(_directory lib lib64)
+      file(GLOB _found
+           "${_prefix}/${_directory}/${CMAKE_SHARED_LIBRARY_PREFIX}TFELMFront${CMAKE_SHARED_LIBRARY_SUFFIX}"
+           "${_prefix}/${_directory}/${CMAKE_SHARED_LIBRARY_PREFIX}TFELMFront-*${CMAKE_SHARED_LIBRARY_SUFFIX}")
+      list(APPEND _libraries ${_found})
+    endforeach()
   endforeach()
+  list(REMOVE_DUPLICATES _libraries)
+  if(_libraries)
+    list(APPEND _dependencies ${_libraries})
+  else()
+    message(STATUS "mfem_mgis_get_mfront_dependencies: the library of the "
+                   "code generators of MFront (libTFELMFront) is not found "
+                   "next to ${mfront}: the sources generated by MFront only "
+                   "depend on the executable")
+  endif()
   set(${variable} ${_dependencies} PARENT_SCOPE)
 endfunction()
