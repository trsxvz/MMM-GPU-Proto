                  "expected device: none, debug, cpu or gpu");
   args.AddOption(&expected_host_memory, "-ehm", "--expected-host-memory",
                  "expected memory of the host: host or umpire");
+  args.AddOption(&expected_hypre, "-eh", "--expected-hypre",
