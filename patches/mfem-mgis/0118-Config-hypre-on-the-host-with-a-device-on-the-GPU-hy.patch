      * \brief option requesting the initialization of Kokkos, for the
      * behaviours generated by the kokkos backend of the generic-parallel
@@ -128,6 +139,14 @@ namespace mfem_mgis {
 
   const char* const Finalizer::hypre_device_pool_size_short_option = "-hdps";
 
+  const char* const Finalizer::hypre_on_host_option = "--hypre-on-host";
+
+  const char* const Finalizer::hypre_on_host_short_option = "-hoh";
+
+  const char* const Finalizer::no_hypre_on_host_option = "--no-hypre-on-host";
+
+  const char* const Finalizer::no_hypre_on_host_short_option = "-no-hoh";
+
   const char* const Finalizer::kokkos_option = "--kokkos";
 
   const char* const Finalizer::kokkos_short_option = "-kk";
@@ -178,6 +197,29 @@ namespace mfem_mgis {
 #endif
   }  // end of setHypreDevicePoolSize
 
+  /*!
+   * \brief makes hypre allocate its memory and compute on the host, after
+   * the configuration of the device of MFEM, which makes hypre use the GPU
+   * of the device unless `mfem::Hypre::configure_runtime_policy_from_mfem`
+   * is false. MFEM then gives the data of hypre on the host
+   * (`mfem::HypreUsingGPU` is false), and the other computations of MFEM
+   * and of mfem-mgis stay on the device.
+   */
+  static void setHypreOnHost() {
+#if defined(MFEM_USE_MPI) && defined(HYPRE_USING_GPU)
+#if MFEM_HYPRE_VERSION >= 23100
+    // the functions only store the policy: their results, the global error
+    // flag of hypre, may report a previous error
+    static_cast<void>(HYPRE_SetMemoryLocation(HYPRE_MEMORY_HOST));
+    static_cast<void>(HYPRE_SetExecutionPolicy(HYPRE_EXEC_HOST));
+#else  /* MFEM_HYPRE_VERSION >= 23100 */
+    mgis::raise(
+        "initialize: hypre can't compute on the host when it is built with "
+        "GPU support and older than 2.31.0");
+#endif /* MFEM_HYPRE_VERSION >= 23100 */
+#endif /* defined(MFEM_USE_MPI) && defined(HYPRE_USING_GPU) */
+  }  // end of setHypreOnHost
+
   /*!
    * \return true if a configuration of the device of MFEM uses a GPU
    * (`cuda`, `hip`, `gpu` and their variants `ceed-cuda`, `raja-gpu`, ...)
@@ -289,6 +331,8 @@ namespace mfem_mgis {
     const char* device_configuration = nullptr;
     const char* hypre_device_pool_size = nullptr;
     auto hypre_device_pool_size_from_environment = false;
+    // hypre on the host, requested by the option or by the environment
+    auto hypre_on_host_requested = std::optional<bool>{};
     // initialization of Kokkos, requested by the option or by the
     // environment
     auto kokkos_requested = std::optional<bool>{};
@@ -318,6 +362,16 @@ namespace mfem_mgis {
         hypre_device_pool_size = *a;
         continue;
       }
+      if ((std::strcmp(*a, hypre_on_host_option) == 0) ||
+          (std::strcmp(*a, hypre_on_host_short_option) == 0)) {
+        hypre_on_host_requested = true;
+        continue;
+      }
+      if ((std::strcmp(*a, no_hypre_on_host_option) == 0) ||
+          (std::strcmp(*a, no_hypre_on_host_short_option) == 0)) {
+        hypre_on_host_requested = false;
+        continue;
+      }
       if ((std::strcmp(*a, device_option) == 0) ||
           (std::strcmp(*a, device_short_option) == 0)) {
         if (device_configuration != nullptr) {
@@ -363,10 +417,31 @@ namespace mfem_mgis {
         hypre_device_pool_size_from_environment = true;
       }
     }
+    if (!hypre_on_host_requested.has_value()) {
+      const auto* const e = std::getenv("MFEM_MGIS_HYPRE_ON_HOST");
+      hypre_on_host_requested =
+          (e != nullptr) && (*e != '\0') && (std::string_view{e} != "0");
+    }
+    const auto hypre_on_host = *hypre_on_host_requested;
     if (hypre_device_pool_size != nullptr) {
+      if (hypre_on_host && (!hypre_device_pool_size_from_environment)) {
+        mgis::raise(
+            "initialize: the size of the pool of memory of hypre on the GPU "
+            "can't be given when hypre computes on the host");
+      }
       setHypreDevicePoolSize(hypre_device_pool_size,
                              hypre_device_pool_size_from_environment);
     }
+#ifdef MFEM_USE_MPI
+    // the configuration of the device of MFEM does not make hypre use the
+    // GPU (nor initialize its libraries on the GPU); the policy of hypre is
+    // then set to the host after this configuration, whatever the defaults
+    // of hypre (each of these settings is sufficient with hypre 3.2, whose
+    // default policy is the host)
+    if (hypre_on_host) {
+      mfem::Hypre::configure_runtime_policy_from_mfem = false;
+    }
+#endif /* MFEM_USE_MPI */
     // without the option, the configuration of the device may be given by
     // the environment, for instance to run a whole test suite on a GPU
     if (device_configuration == nullptr) {
@@ -399,6 +474,11 @@ namespace mfem_mgis {
         gpu_identifier = identifier;
       }
     }
+    // hypre on the host, after the configuration of the device (by this
+    // function or by the program)
+    if (hypre_on_host) {
+      setHypreOnHost();
+    }
     // Kokkos, after the device of MFEM, whose GPU it uses; requested by the
     // option or by the environment
     auto kokkos_from_environment = false;
@@ -585,6 +665,17 @@ namespace mfem_mgis {
                      "mfem_mgis::initialize. Default of hypre if not given.");
     // read by `initialize`: only declared here, so that the parser accepts
     // it
+    static bool hypre_on_host = false;
+    parser.AddOption(
+        &hypre_on_host, Finalizer::hypre_on_host_short_option,
+        Finalizer::hypre_on_host_option,
+        Finalizer::no_hypre_on_host_short_option,
+        Finalizer::no_hypre_on_host_option,
+        "hypre computes on the host, even if the MFEM device uses a GPU "
+        "(for small linear systems), set by mfem_mgis::initialize. Given by "
+        "the variable MFEM_MGIS_HYPRE_ON_HOST if not given.");
+    // read by `initialize`: only declared here, so that the parser accepts
+    // it
     static bool kokkos = false;
     parser.AddOption(
         &kokkos, Finalizer::kokkos_short_option, Finalizer::kokkos_option,
