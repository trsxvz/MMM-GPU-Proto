diff --git a/docs/source/user_guide/glossary.rst b/docs/source/user_guide/glossary.rst
index fe21c1001b..396e1aba0e 100644
--- a/docs/source/user_guide/glossary.rst
+++ b/docs/source/user_guide/glossary.rst
@@ -54,12 +54,24 @@ MUMPS Solver
 +----------------------+----------------------------------------------------+
 | ``PositiveDefinite`` | Specify if the matrix is positive definite. [bool] |
 +----------------------+----------------------------------------------------+
+| ``ReuseAnalysis``    | Reuse the analysis (ordering and symbolic          |
+|                      | factorization) of the previous matrix when the new |
+|                      | one has the same pattern on all processes. [bool,  |
+|                      | false by default]                                  |
++----------------------+----------------------------------------------------+
 
+The matrices of the successive iterations of a non linear solver usually
+have the same pattern: with ``ReuseAnalysis``, only the first one is
+analysed. The pattern of each new matrix is compared to the one of the
+previous matrix, and a new analysis is made if it changed on one of the
+processes. The parts of the analysis which depend on the values of the
+matrix (permutations of non symmetric matrices) then stay the ones
+computed for the first matrix.
 
 **Example:**
 
 .. code-block:: cpp
-  
+
   problem.setLinearSolver(ctx, "MUMPSSolver", {{"Symmetric", true}}) | or_die;
 
 UMFPack Solver
diff --git a/src/LinearSolverFactory.cxx b/src/LinearSolverFactory.cxx
index cd149b761d..a9ee439f19 100644
--- a/src/LinearSolverFactory.cxx
+++ b/src/LinearSolverFactory.cxx
@@ -11,6 +11,7 @@
 #include <vector>
 #include <functional>
 #include <optional>
+#include <tuple>
 #include <utility>
 #include <algorithm>
 #include "mfem/linalg/solvers.hpp"
@@ -125,6 +126,102 @@ namespace mfem_mgis::internals {
     }
   };  // end of struct ReusableHypreParaSails
 
+#ifdef MFEM_USE_MUMPS
+
+  /*!
+   * \brief MUMPS solver which reuses the analysis (ordering and symbolic
+   * factorization) of the previous matrix when the new one has the same
+   * pattern on all processes, as the matrices of the successive iterations
+   * of the non linear solvers.
+   *
+   * `mfem::MUMPSSolver::SetReorderingReuse` (MFEM 4.10) does not check the
+   * pattern of the new matrix, which would be factorized with the analysis
+   * of the previous one. The pattern of the local part of the matrix (rows,
+   * column indices of the diagonal and off-diagonal blocks, global indices
+   * of the off-diagonal columns) is kept and compared to the one of each
+   * new matrix. The analysis is collective: a new analysis is made on all
+   * processes if the pattern changed on one of them.
+   */
+  struct ReusableMUMPSSolver final : public mfem::MUMPSSolver {
+    using mfem::MUMPSSolver::MUMPSSolver;
+    //! \brief set the operator
+    void SetOperator(const mfem::Operator& op) override {
+      const auto* const A = dynamic_cast<const mfem::HypreParMatrix*>(&op);
+      if (A == nullptr) {
+        // error reported by MFEM
+        mfem::MUMPSSolver::SetOperator(op);
+        return;
+      }
+      auto p = getPattern(*A);
+      auto same = static_cast<int>(this->pattern.has_value() &&
+                                   (*(this->pattern) == p));
+      MPI_Allreduce(MPI_IN_PLACE, &same, 1, MPI_INT, MPI_LAND, A->GetComm());
+      this->SetReorderingReuse(same != 0);
+      mfem::MUMPSSolver::SetOperator(op);
+      this->pattern = std::move(p);
+    }
+
+   private:
+    //! \brief pattern of the local part of a matrix
+    struct Pattern {
+      //! \brief comparison operator
+      bool operator==(const Pattern&) const = default;
+      //! \brief number of rows of the matrix
+      HYPRE_BigInt global_number_of_rows = 0;
+      //! \brief global index of the first local row
+      HYPRE_BigInt first_row = 0;
+      //! \brief global index of the first column of the diagonal block
+      HYPRE_BigInt first_column = 0;
+      //! \brief offsets of the rows of the diagonal block
+      std::vector<HYPRE_Int> diagonal_rows;
+      //! \brief column indices of the diagonal block
+      std::vector<HYPRE_Int> diagonal_columns;
+      //! \brief offsets of the rows of the off-diagonal block
+      std::vector<HYPRE_Int> off_diagonal_rows;
+      //! \brief column indices of the off-diagonal block
+      std::vector<HYPRE_Int> off_diagonal_columns;
+      //! \brief global indices of the columns of the off-diagonal block
+      std::vector<HYPRE_BigInt> off_diagonal_column_map;
+    };
+    //! \return a copy of the first `n` values of an array of hypre
+    template <typename ValueType>
+    static std::vector<ValueType> copy(const ValueType* const values,
+                                       const HYPRE_Int n) {
+      if ((values == nullptr) || (n <= 0)) {
+        return {};
+      }
+      return std::vector<ValueType>(values, values + n);
+    }
+    //! \return the pattern of the local part of a matrix
+    static Pattern getPattern(const mfem::HypreParMatrix& A) {
+      A.HostRead();
+      const auto* const m = static_cast<hypre_ParCSRMatrix*>(A);
+      const auto* const diagonal = hypre_ParCSRMatrixDiag(m);
+      const auto* const off_diagonal = hypre_ParCSRMatrixOffd(m);
+      const auto n = hypre_CSRMatrixNumRows(diagonal);
+      auto block_pattern = [n](const hypre_CSRMatrix* const b) {
+        const auto* const rows = hypre_CSRMatrixI(b);
+        const auto nnz = (rows == nullptr) ? HYPRE_Int{} : rows[n];
+        return std::pair{copy(rows, n + 1), copy(hypre_CSRMatrixJ(b), nnz)};
+      };
+      auto p = Pattern{};
+      p.global_number_of_rows = hypre_ParCSRMatrixGlobalNumRows(m);
+      p.first_row = hypre_ParCSRMatrixFirstRowIndex(m);
+      p.first_column = hypre_ParCSRMatrixFirstColDiag(m);
+      std::tie(p.diagonal_rows, p.diagonal_columns) = block_pattern(diagonal);
+      std::tie(p.off_diagonal_rows, p.off_diagonal_columns) =
+          block_pattern(off_diagonal);
+      p.off_diagonal_column_map = copy(hypre_ParCSRMatrixColMapOffd(m),
+                                       hypre_CSRMatrixNumCols(off_diagonal));
+      A.HypreRead();
+      return p;
+    }
+    //! \brief pattern of the last matrix
+    std::optional<Pattern> pattern;
+  };  // end of struct ReusableMUMPSSolver
+
+#endif /* MFEM_USE_MUMPS */
+
 }  // end of namespace mfem_mgis::internals
 
 #endif /* MFEM_USE_MPI */
