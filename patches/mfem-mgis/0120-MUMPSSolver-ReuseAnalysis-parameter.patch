       if (!checkParameters(
               ctx, params,
-              std::vector<std::string>{"Symmetric", "PositiveDefinite"})) {
+              std::vector<std::string>{"Symmetric", "PositiveDefinite",
+                                       "ReuseAnalysis"})) {
