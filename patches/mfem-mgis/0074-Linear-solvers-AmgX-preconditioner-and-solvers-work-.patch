+/*!
+ * \file   src/AmgXSolvers.hxx
+ * \brief  This file declares the solvers of the AmgX library of NVIDIA
+ * built by the factory of linear solvers (internal header)
+ * \date   10/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_SRC_AMGXSOLVERS_HXX
+#define LIB_MFEM_MGIS_SRC_AMGXSOLVERS_HXX
+
+#include "mfem/config/config.hpp"
+
+#ifdef MFEM_USE_AMGX
+
+#include <memory>
+#include <optional>
+#include <string>
+#include "mfem/linalg/amgxsolver.hpp"
+#include "MFEMMGIS/Config.hxx"
+#include "MFEMMGIS/MFEMForward.hxx"
+#include "MFEMMGIS/Parameters.hxx"
+#include "MFEMMGIS/LinearSolverHandler.hxx"
+
+namespace mfem_mgis::internals {
+
+  /*!
+   * \brief solver of the AmgX library, through the wrapper of MFEM. AmgX
+   * computes on the GPU, whatever the device used by MFEM: the matrix is
+   * copied on the host and uploaded to AmgX at each call to `SetOperator`
+   * (see `mfem::AmgXSolver`).
+   *
+   * MFEM gives no access to the status of AmgX and aborts when asked to
+   * check it. When the maximum number of iterations of the configuration is
+   * known, the resolution is considered converged if the number of
+   * iterations is lower, as for the solvers of hypre (see `hasConverged`).
+   */
+  struct AmgXSolver final : public mfem::AmgXSolver {
+    /*!
+     * \brief constructor
+     * \param[in] c: configuration of AmgX, the default configuration of
+     * MFEM for a preconditioner (one V-cycle) if empty
+     * \param[in] s: source of the configuration (string or file)
+     * \param[in] v: verbosity of the default configuration
+     * \param[in] n: maximum number of iterations of the configuration, if
+     * known
+     */
+    AmgXSolver(const std::string&,
+               const CONFIG_SRC,
+               const bool,
+               const std::optional<int>);
+    //
+    void Mult(const mfem::Vector&, mfem::Vector&) const override;
+    /*!
+     * \return the number of iterations of the last resolution, if the
+     * maximum number of iterations is known and a resolution was made
+     */
+    [[nodiscard]] std::optional<int> getNumberOfIterations() const noexcept;
+    //! \return if the last resolution has converged (see the class notes)
+    [[nodiscard]] bool hasConverged() const noexcept;
+
+   private:
+    //! \brief maximum number of iterations of the configuration, if known
+    const std::optional<int> maximum_number_of_iterations;
+    //! \brief number of iterations of the last resolution
+    mutable std::optional<int> iterations;
+  };  // end of AmgXSolver
+
+  /*!
+   * \return cycles of the algebraic multigrid of AmgX, as a preconditioner
+   * or an approximate linear solver (`AmgX` in the factory of linear
+   * solvers).
+   *
+   * The options are:
+   * - `Configuration`: configuration of AmgX, as a string;
+   * - `ConfigurationFile`: file containing the configuration of AmgX (the
+   *   configurations distributed with AmgX are in `lib/configs`);
+   * - `VerbosityLevel`: if strictly positive, AmgX prints the statistics of
+   *   the default configuration.
+   * Without configuration, the default one of MFEM is used: one V-cycle of
+   * the classical algebraic multigrid with a L1-Jacobi smoother. An
+   * invalid configuration aborts the program (AmgX checks it).
+   *
+   * \param[in, out] ctx: execution context
+   * \param[in] fespace: finite element space
+   * \param[in] params: options
+   */
+  template <bool parallel>
+  [[nodiscard]] std::unique_ptr<AmgXSolver> makeAmgXPreconditioner(
+      Context&, FiniteElementSpace<parallel>&, const Parameters&) noexcept;
+  /*!
+   * \return the conjugate gradient of AmgX preconditioned by one V-cycle of
+   * its algebraic multigrid in the default configuration of MFEM
+   * (`AmgXPCG` in the factory of linear solvers).
+   *
+   * The options are the ones of the iterative solvers (`VerbosityLevel`,
+   * `RelativeTolerance`, `AbsoluteTolerance`,
+   * `MaximumNumberOfIterations`), with the convergence criterion of MFEM:
+   * the norm of the residual is lower than the absolute tolerance or than
+   * the relative tolerance times the norm of the initial residual.
+   *
+   * \param[in, out] ctx: execution context
+   * \param[in] fespace: finite element space
+   * \param[in] params: options
+   */
+  template <bool parallel>
+  [[nodiscard]] std::unique_ptr<AmgXSolver> makeAmgXConjugateGradientSolver(
+      Context&, FiniteElementSpace<parallel>&, const Parameters&) noexcept;
+
+}  // end of namespace mfem_mgis::internals
+
+#endif /* MFEM_USE_AMGX */
+
+#endif /* LIB_MFEM_MGIS_SRC_AMGXSOLVERS_HXX */
