diff --git a/src/AmgXSolvers.cxx b/src/AmgXSolvers.cxx
new file mode 100644
index 0000000000..14d520dbb1
--- /dev/null
+++ b/src/AmgXSolvers.cxx
@@ -0,0 +1,223 @@
+/*!
+ * \file   src/AmgXSolvers.cxx
+ * \brief  This file implements the solvers of the AmgX library of NVIDIA
+ * built by the factory of linear solvers
+ * \date   10/10/2026
+ */
+
+#include "AmgXSolvers.hxx"
+
+#ifdef MFEM_USE_AMGX
+
+#include <limits>
+#include <locale>
+#include <vector>
+#include <fstream>
+#include <sstream>
+#include <iomanip>
+#include "mfem/fem/fespace.hpp"
+#ifdef MFEM_USE_MPI
+#include "mfem/fem/pfespace.hpp"
+#endif /* MFEM_USE_MPI */
+#include "MFEMMGIS/AbstractNonLinearEvolutionProblem.hxx"
+#include "MFEMMGIS/Utilities/SolverUtilities.hxx"
+
+namespace mfem_mgis::internals {
+
+  AmgXSolver::AmgXSolver(const std::string& c,
+                         const CONFIG_SRC s,
+                         const bool v,
+                         const std::optional<int> n)
+      : maximum_number_of_iterations(n) {
+    // the default configuration also initialises the mode of the solver,
+    // which the default constructor of MFEM leaves undefined, and imposes a
+    // zero initial guess, as the other solvers of the factory
+    this->DefaultParameters(PRECONDITIONER, v);
+    if (!c.empty()) {
+      this->ReadParameters(c, s);
+    }
+    this->SetConvergenceCheck(false);
+  }  // end of AmgXSolver
+
+  void AmgXSolver::Mult(const mfem::Vector& b, mfem::Vector& x) const {
+    mfem::AmgXSolver::Mult(b, x);
+    if (this->maximum_number_of_iterations.has_value()) {
+      // `GetNumIterations` is not declared const by MFEM
+      this->iterations = const_cast<AmgXSolver*>(this)->GetNumIterations();
+    }
+  }  // end of Mult
+
+  std::optional<int> AmgXSolver::getNumberOfIterations() const noexcept {
+    return this->iterations;
+  }  // end of getNumberOfIterations
+
+  bool AmgXSolver::hasConverged() const noexcept {
+    if ((!this->maximum_number_of_iterations.has_value()) ||
+        (!this->iterations.has_value())) {
+      return true;
+    }
+    return *(this->iterations) < *(this->maximum_number_of_iterations);
+  }  // end of hasConverged
+
+  /*!
+   * \return the solver initialised for the given space: in parallel, each
+   * process uses the first device it sees (`InitExclusiveGPU` of MFEM)
+   * \param[in] s: solver
+   * \param[in] fespace: finite element space
+   */
+  template <bool parallel>
+  static std::unique_ptr<AmgXSolver> initialise(
+      std::unique_ptr<AmgXSolver> s, FiniteElementSpace<parallel>& fespace) {
+    if constexpr (parallel) {
+#ifdef MFEM_USE_MPI
+      s->InitExclusiveGPU(fespace.GetComm());
+#endif /* MFEM_USE_MPI */
+    } else {
+      static_cast<void>(fespace);
+      s->InitSerial();
+    }
+    return s;
+  }  // end of initialise
+
+  template <bool parallel>
+  std::unique_ptr<AmgXSolver> makeAmgXPreconditioner(
+      Context& ctx,
+      FiniteElementSpace<parallel>& fespace,
+      const Parameters& params) noexcept {
+    const char* const Configuration = "Configuration";
+    const char* const ConfigurationFile = "ConfigurationFile";
+    const char* const VerbosityLevel = "VerbosityLevel";
+    if (!checkParameters(ctx, params,
+                         std::vector<std::string>{
+                             Configuration, ConfigurationFile, VerbosityLevel})) {
+      return {};
+    }
+    const auto oconfiguration =
+        get_if<std::string>(ctx, params, Configuration, std::string{});
+    const auto ofile =
+        get_if<std::string>(ctx, params, ConfigurationFile, std::string{});
+    const auto overbosity = get_if<int>(ctx, params, VerbosityLevel, 0);
+    if (isInvalid(oconfiguration) || isInvalid(ofile) ||
+        isInvalid(overbosity)) {
+      return {};
+    }
+    const auto has_configuration = contains(params, Configuration);
+    const auto has_file = contains(params, ConfigurationFile);
+    if (has_configuration && has_file) {
+      return ctx.registerErrorMessage(
+          "AmgX: the options 'Configuration' and 'ConfigurationFile' are "
+          "exclusive");
+    }
+    if ((has_configuration || has_file) && contains(params, VerbosityLevel)) {
+      return ctx.registerErrorMessage(
+          "AmgX: the verbosity level only applies to the default "
+          "configuration (a configuration given defines the outputs of "
+          "AmgX)");
+    }
+    if (has_configuration && oconfiguration->empty()) {
+      return ctx.registerErrorMessage("AmgX: empty configuration");
+    }
+    if (has_file && (!std::ifstream{*ofile})) {
+      return ctx.registerErrorMessage(
+          "AmgX: can't open the configuration file '" + *ofile + "'");
+    }
+    auto s = has_file ? std::make_unique<AmgXSolver>(
+                            *ofile, mfem::AmgXSolver::EXTERNAL, false,
+                            std::optional<int>{})
+                      : std::make_unique<AmgXSolver>(
+                            *oconfiguration, mfem::AmgXSolver::INTERNAL,
+                            *overbosity > 0, std::optional<int>{});
+    return initialise<parallel>(std::move(s), fespace);
+  }  // end of makeAmgXPreconditioner
+
+  /*!
+   * \return the configuration of the conjugate gradient of AmgX,
+   * preconditioned by one V-cycle of the default configuration of MFEM
+   * \param[in] rtol: relative tolerance
+   * \param[in] atol: absolute tolerance
+   * \param[in] n: maximum number of iterations
+   * \param[in] verbose: print the statistics of AmgX
+   */
+  static std::string getConjugateGradientConfiguration(const real rtol,
+                                                       const real atol,
+                                                       const int n,
+                                                       const bool verbose) {
+    auto c = std::ostringstream{};
+    c.imbue(std::locale::classic());
+    c << std::setprecision(std::numeric_limits<real>::max_digits10);
+    c << "{\"config_version\": 2, \"solver\": {"
+      << "\"solver\": \"PCG\", \"scope\": \"main\", \"norm\": \"L2\", "
+      << "\"monitor_residual\": 1, \"max_iters\": " << n << ", ";
+    if (atol > 0) {
+      // converged if the norm of the residual is lower than `tolerance` or
+      // than `alt_rel_tolerance` times the norm of the initial residual
+      c << "\"convergence\": \"COMBINED_REL_INI_ABS\", \"tolerance\": "
+        << atol << ", \"alt_rel_tolerance\": " << rtol << ", ";
+    } else {
+      c << "\"convergence\": \"RELATIVE_INI_CORE\", \"tolerance\": " << rtol
+        << ", ";
+    }
+    if (verbose) {
+      c << "\"obtain_timings\": 1, \"print_grid_stats\": 1, "
+        << "\"print_solve_stats\": 1, ";
+    }
+    c << "\"preconditioner\": {\"solver\": \"AMG\", \"scope\": \"amg\", "
+      << "\"smoother\": {\"scope\": \"jacobi\", \"solver\": \"JACOBI_L1\"}, "
+      << "\"presweeps\": 1, \"postsweeps\": 1, \"interpolator\": \"D2\", "
+      << "\"max_row_sum\": 0.9, \"strength_threshold\": 0.25, "
+      << "\"max_iters\": 1, \"max_levels\": 100, \"cycle\": \"V\"}}}";
+    return c.str();
+  }  // end of getConjugateGradientConfiguration
+
+  template <bool parallel>
+  std::unique_ptr<AmgXSolver> makeAmgXConjugateGradientSolver(
+      Context& ctx,
+      FiniteElementSpace<parallel>& fespace,
+      const Parameters& params) noexcept {
+    using Problem = AbstractNonLinearEvolutionProblem;
+    if (!checkParameters(ctx, params, getIterativeSolverParametersList())) {
+      return {};
+    }
+    // default values of the solver configuration of MFEM
+    const auto overbosity =
+        get_if<int>(ctx, params, Problem::SolverVerbosityLevel, 0);
+    const auto ortol =
+        get_if<real>(ctx, params, Problem::SolverRelativeTolerance, 1e-12);
+    const auto oatol =
+        get_if<real>(ctx, params, Problem::SolverAbsoluteTolerance, 0);
+    const auto on =
+        get_if<int>(ctx, params, Problem::SolverMaximumNumberOfIterations, 150);
+    if (isInvalid(overbosity) || isInvalid(ortol) || isInvalid(oatol) ||
+        isInvalid(on)) {
+      return {};
+    }
+    if ((*ortol < 0) || (*oatol < 0) || ((*ortol <= 0) && (*oatol <= 0))) {
+      return ctx.registerErrorMessage(
+          "AmgXPCG: the tolerances must be positive, one of them strictly");
+    }
+    if (*on < 1) {
+      return ctx.registerErrorMessage(
+          "AmgXPCG: the maximum number of iterations must be strictly "
+          "positive");
+    }
+    const auto c =
+        getConjugateGradientConfiguration(*ortol, *oatol, *on, *overbosity > 0);
+    auto s = std::make_unique<AmgXSolver>(c, mfem::AmgXSolver::INTERNAL, false,
+                                          *on);
+    return initialise<parallel>(std::move(s), fespace);
+  }  // end of makeAmgXConjugateGradientSolver
+
+  template std::unique_ptr<AmgXSolver> makeAmgXPreconditioner<false>(
+      Context&, FiniteElementSpace<false>&, const Parameters&) noexcept;
+  template std::unique_ptr<AmgXSolver> makeAmgXConjugateGradientSolver<false>(
+      Context&, FiniteElementSpace<false>&, const Parameters&) noexcept;
+#ifdef MFEM_USE_MPI
+  template std::unique_ptr<AmgXSolver> makeAmgXPreconditioner<true>(
+      Context&, FiniteElementSpace<true>&, const Parameters&) noexcept;
+  template std::unique_ptr<AmgXSolver> makeAmgXConjugateGradientSolver<true>(
+      Context&, FiniteElementSpace<true>&, const Parameters&) noexcept;
+#endif /* MFEM_USE_MPI */
+
+}  // end of namespace mfem_mgis::internals
+
+#endif /* MFEM_USE_AMGX */
