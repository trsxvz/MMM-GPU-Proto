diff --git a/src/Batch/KernelsUtilities.hxx b/src/Batch/KernelsUtilities.hxx
new file mode 100644
index 0000000000..d6c5d76c73
--- /dev/null
+++ b/src/Batch/KernelsUtilities.hxx
@@ -0,0 +1,152 @@
+/*!
+ * \file   src/Batch/KernelsUtilities.hxx
+ * \brief  This file implements functions shared by the kernels of the
+ * batch path (internal header, device code)
+ * \date   09/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_SRC_BATCH_KERNELSUTILITIES_HXX
+#define LIB_MFEM_MGIS_SRC_BATCH_KERNELSUTILITIES_HXX
+
+#include <cstddef>
+#include "mfem/general/forall.hpp"
+#include "MFEMMGIS/Config.hxx"
+#include "MFEMMGIS/Batch/Gradients.hxx"
+
+namespace mfem_mgis::batch::internals {
+
+  //! \brief 1/√2, as in the behaviour integrators generated by mfem-mgis
+  MFEM_HOST_DEVICE constexpr real getInverseOfSquareRootOfTwo() {
+    return real{0.70710678118654752440};
+  }  // end of getInverseOfSquareRootOfTwo
+
+  //! \return the dimension of the space for the given kind of gradients
+  template <GradientsKind K>
+  MFEM_HOST_DEVICE constexpr int getDimension() {
+    return ((K == GradientsKind::SMALL_STRAIN_3D) ||
+            (K == GradientsKind::DEFORMATION_GRADIENT_3D))
+               ? 3
+               : 2;
+  }  // end of getDimension
+
+  /*!
+   * \brief computes the inverse of a jacobian
+   * \tparam N: dimension
+   * \param[out] iJ: inverse, `iJ[i + N * j]` being the component `(i, j)`
+   * \param[in] J: jacobian at the point of the element (`nq` points per
+   * element, layout of `mfem::GeometricFactors`): `J[nq * (i + N * j)]` is
+   * the component `(i, j)`
+   * \param[in] nq: number of points per element
+   * \param[in] detJ: determinant of the jacobian
+   */
+  template <int N>
+  MFEM_HOST_DEVICE inline void invertJacobian(real* const iJ,
+                                              const real* const J,
+                                              const std::size_t nq,
+                                              const real detJ) {
+    auto j = [J, nq](const std::size_t r, const std::size_t c) {
+      return J[nq * (r + N * c)];
+    };
+    if constexpr (N == 2) {
+      iJ[0] = j(1, 1) / detJ;
+      iJ[1] = -j(1, 0) / detJ;
+      iJ[2] = -j(0, 1) / detJ;
+      iJ[3] = j(0, 0) / detJ;
+    } else {
+      static_assert(N == 3);
+      iJ[0] = (j(1, 1) * j(2, 2) - j(1, 2) * j(2, 1)) / detJ;
+      iJ[1] = (j(1, 2) * j(2, 0) - j(1, 0) * j(2, 2)) / detJ;
+      iJ[2] = (j(1, 0) * j(2, 1) - j(1, 1) * j(2, 0)) / detJ;
+      iJ[3] = (j(0, 2) * j(2, 1) - j(0, 1) * j(2, 2)) / detJ;
+      iJ[4] = (j(0, 0) * j(2, 2) - j(0, 2) * j(2, 0)) / detJ;
+      iJ[5] = (j(0, 1) * j(2, 0) - j(0, 0) * j(2, 1)) / detJ;
+      iJ[6] = (j(0, 1) * j(1, 2) - j(0, 2) * j(1, 1)) / detJ;
+      iJ[7] = (j(0, 2) * j(1, 0) - j(0, 0) * j(1, 2)) / detJ;
+      iJ[8] = (j(0, 0) * j(1, 1) - j(0, 1) * j(1, 0)) / detJ;
+    }
+  }  // end of invertJacobian
+
+  /*!
+   * \brief computes the derivatives of a shape function in the physical
+   * frame: `dN/dx_c = sum_r dN/dxi_r (J^-1)_{rc}`
+   * \tparam N: dimension
+   * \param[out] dN: derivatives
+   * \param[in] G: gradients of the shape functions on the reference element
+   * (`nq x N x nd`, layout of `mfem::DofToQuad` in the `FULL` mode)
+   * \param[in] q: integration point
+   * \param[in] nq: number of integration points
+   * \param[in] node: node
+   * \param[in] iJ: inverse of the jacobian (see `invertJacobian`)
+   */
+  template <int N>
+  MFEM_HOST_DEVICE inline void computePhysicalDerivatives(
+      real* const dN,
+      const real* const G,
+      const std::size_t q,
+      const std::size_t nq,
+      const std::size_t node,
+      const real* const iJ) {
+    for (std::size_t c = 0; c != N; ++c) {
+      dN[c] = 0;
+      for (std::size_t r = 0; r != N; ++r) {
+        dN[c] += G[q + nq * (r + N * node)] * iJ[r + N * c];
+      }
+    }
+  }  // end of computePhysicalDerivatives
+
+  /*!
+   * \brief computes the block of a node of the operator `B` giving the
+   * gradients of a behaviour from the unknowns (as the behaviour integrators
+   * generated by mfem-mgis): `B[k][c]` is the derivative of the `k`-th
+   * component of the gradients with respect to the `c`-th component of the
+   * unknowns at the node
+   * \tparam K: kind of the gradients
+   * \param[out] B: block of the operator (9 x 3 values at most)
+   * \param[in] dN: derivatives of the shape function of the node in the
+   * physical frame
+   */
+  template <GradientsKind K>
+  MFEM_HOST_DEVICE inline void computeB(real (&B)[9][3], const real* const dN) {
+    constexpr auto icste = getInverseOfSquareRootOfTwo();
+    for (auto& row : B) {
+      for (auto& v : row) {
+        v = 0;
+      }
+    }
+    if constexpr (K == GradientsKind::SMALL_STRAIN_3D) {
+      B[0][0] = dN[0];
+      B[1][1] = dN[1];
+      B[2][2] = dN[2];
+      B[3][0] = dN[1] * icste;
+      B[3][1] = dN[0] * icste;
+      B[4][0] = dN[2] * icste;
+      B[4][2] = dN[0] * icste;
+      B[5][1] = dN[2] * icste;
+      B[5][2] = dN[1] * icste;
+    } else if constexpr (K == GradientsKind::SMALL_STRAIN_2D) {
+      B[0][0] = dN[0];
+      B[1][1] = dN[1];
+      B[3][0] = dN[1] * icste;
+      B[3][1] = dN[0] * icste;
+    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
+      B[0][0] = dN[0];
+      B[1][1] = dN[1];
+      B[2][2] = dN[2];
+      B[3][0] = dN[1];
+      B[4][1] = dN[0];
+      B[5][0] = dN[2];
+      B[6][2] = dN[0];
+      B[7][1] = dN[2];
+      B[8][2] = dN[1];
+    } else {
+      static_assert(K == GradientsKind::DEFORMATION_GRADIENT_2D);
+      B[0][0] = dN[0];
+      B[1][1] = dN[1];
+      B[3][0] = dN[1];
+      B[4][1] = dN[0];
+    }
+  }  // end of computeB
+
+}  // end of namespace mfem_mgis::batch::internals
+
+#endif /* LIB_MFEM_MGIS_SRC_BATCH_KERNELSUTILITIES_HXX */
diff --git a/src/Batch/StiffnessMatrices.cxx b/src/Batch/StiffnessMatrices.cxx
new file mode 100644
index 0000000000..53b86c785c
--- /dev/null
+++ b/src/Batch/StiffnessMatrices.cxx
@@ -0,0 +1,97 @@
+/*!
+ * \file   src/Batch/StiffnessMatrices.cxx
+ * \brief  This file implements the computation of the stiffness matrices of
+ * the elements of the standard mechanical behaviour integrators by kernels
+ * (host part: checks and arguments of the kernels)
+ * \date   09/10/2026
+ */
+
+#include <string>
+#include <cstdint>
+#include <exception>
+#include "mfem/general/device.hpp"
+#include "mfem/fem/fe/fe_base.hpp"
+#include "mfem/mesh/mesh.hpp"
+#include "MFEMMGIS/PartialQuadratureSpace.hxx"
+#include "MFEMMGIS/Batch/StiffnessMatrices.hxx"
+#ifdef MFEM_MGIS_HAVE_DEVICE_SOURCES
+#include "StiffnessMatricesKernels.hxx"
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+
+namespace mfem_mgis::batch {
+
+  bool addStiffnessMatrices(Context& ctx,
+                            mfem::Vector& m,
+                            const PartialQuadratureSpace& qs,
+                            const mgis::FieldView<const real>& K,
+                            const ElementsGeometry& g,
+                            const GradientsKind k) noexcept {
+#ifndef MFEM_MGIS_HAVE_DEVICE_SOURCES
+    static_cast<void>(m);
+    static_cast<void>(qs);
+    static_cast<void>(K);
+    static_cast<void>(g);
+    static_cast<void>(k);
+    return ctx.registerErrorMessage(
+        "addStiffnessMatrices: the kernels computing the stiffness matrices "
+        "are not compiled (MFEM compiled with HIP)");
+#else  /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+    const auto& elements = qs.getElements();
+    const auto& offsets = qs.getElementOffsets();
+    if (elements.Size() == 0) {
+      return true;
+    }
+    if ((g.rule == nullptr) || (qs.getUniformIntegrationRule() != g.rule)) {
+      return ctx.registerErrorMessage(
+          "addStiffnessMatrices: the elements of the material do not use the "
+          "integration rule of the geometric data");
+    }
+    const auto dim = getSpaceDimension(k);
+    if (g.dim != dim) {
+      return ctx.registerErrorMessage(
+          "addStiffnessMatrices: unexpected dimension of the space (" +
+          std::to_string(g.dim) + " instead of " + std::to_string(dim) + ")");
+    }
+    const auto ndofs = std::int64_t{g.nd} * dim;
+    if (static_cast<std::int64_t>(m.Size()) != ndofs * ndofs * g.ne) {
+      return ctx.registerErrorMessage(
+          "addStiffnessMatrices: unexpected size of the matrices element by "
+          "element");
+    }
+    const auto gsize = getGradientsSize(k);
+    if ((K.getNumberOfPoints() != qs.getNumberOfIntegrationPoints()) ||
+        (K.getNumberOfComponents() != gsize * gsize)) {
+      return ctx.registerErrorMessage(
+          "addStiffnessMatrices: unexpected number of points or of components "
+          "of the tangent operator blocks");
+    }
+    auto a = internals::StiffnessMatricesKernelArguments{};
+    a.number_of_elements = elements.Size();
+    a.nd = g.nd;
+    a.nq = g.nq;
+    a.gradients_size = static_cast<int>(gsize);
+    a.tangent_operator = K.data();
+    a.point_stride = static_cast<long long>(K.getPointStride());
+    a.component_stride = static_cast<long long>(K.getComponentStride());
+    try {
+      const auto use_device = mfem::Device::IsEnabled();
+      a.elements = elements.Read(use_device);
+      a.offsets = offsets.Read(use_device);
+      a.shape_functions_gradients = g.maps->G.Read(use_device);
+      a.jacobians = g.factors->J.Read(use_device);
+      a.determinants = g.factors->detJ.Read(use_device);
+      a.weights = g.weights.Read(use_device);
+      a.matrices = m.ReadWrite(use_device);
+      internals::launchStiffnessMatricesKernel(k, a, use_device);
+    } catch (std::exception& e) {
+      return ctx.registerErrorMessage(std::string{"addStiffnessMatrices: "} +
+                                      e.what());
+    } catch (...) {
+      return ctx.registerErrorMessage(
+          "addStiffnessMatrices: unknown exception");
+    }
+    return true;
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+  }  // end of addStiffnessMatrices
+
+}  // end of namespace mfem_mgis::batch
diff --git a/src/Batch/StiffnessMatricesKernels.cxx b/src/Batch/StiffnessMatricesKernels.cxx
new file mode 100644
index 0000000000..23fe82b000
--- /dev/null
+++ b/src/Batch/StiffnessMatricesKernels.cxx
@@ -0,0 +1,110 @@
+/*!
+ * \file   src/Batch/StiffnessMatricesKernels.cxx
+ * \brief  This file implements the kernels computing the stiffness matrices
+ * of the elements of the standard mechanical behaviour integrators. It
+ * contains kernels of MFEM: it is compiled as CUDA code when MFEM is
+ * compiled with CUDA.
+ * \date   09/10/2026
+ */
+
+#include <cstddef>
+#include "mfem/general/forall.hpp"
+#include "KernelsUtilities.hxx"
+#include "StiffnessMatricesKernels.hxx"
+
+namespace mfem_mgis::batch::internals {
+
+  /*!
+   * \brief launches the kernel adding the stiffness matrices of the
+   * elements of a material: one thread per pair of nodes of an element,
+   * computing the `N x N` block `Σ B_aᵀ K B_b w det J`
+   * \tparam K: kind of the gradients
+   * \tparam N: dimension
+   */
+  template <GradientsKind K, int N>
+  static void launchStiffnessMatricesKernel(
+      const StiffnessMatricesKernelArguments& a, const bool use_device) {
+    const auto n = a.number_of_elements * a.nd * a.nd;
+    mfem::forall_switch(use_device, n, [a] MFEM_HOST_DEVICE(int i) {
+      const auto nd = static_cast<std::size_t>(a.nd);
+      const auto nq = static_cast<std::size_t>(a.nq);
+      const auto gs = static_cast<std::size_t>(a.gradients_size);
+      const auto k = static_cast<std::size_t>(i) / (nd * nd);
+      const auto r = static_cast<std::size_t>(i) - k * nd * nd;
+      const auto na = r % nd;
+      const auto nb = r / nd;
+      const auto e = static_cast<std::size_t>(a.elements[k]);
+      real m[N][N] = {};
+      for (std::size_t q = 0; q != nq; ++q) {
+        const auto detJ = a.determinants[q + nq * e];
+        real iJ[N * N];
+        invertJacobian<N>(iJ, a.jacobians + q + nq * N * N * e, nq, detJ);
+        real dNa[N];
+        real dNb[N];
+        computePhysicalDerivatives<N>(dNa, a.shape_functions_gradients, q, nq,
+                                      na, iJ);
+        computePhysicalDerivatives<N>(dNb, a.shape_functions_gradients, q, nq,
+                                      nb, iJ);
+        real Ba[9][3];
+        real Bb[9][3];
+        computeB<K>(Ba, dNa);
+        computeB<K>(Bb, dNb);
+        const auto o =
+            static_cast<long long>(a.offsets[k]) + static_cast<long long>(q);
+        const auto* const t = a.tangent_operator + o * a.point_stride;
+        const auto cs = a.component_stride;
+        const auto w = a.weights[q] * detJ;
+        // K B_b, then B_aᵀ (K B_b)
+        for (std::size_t d = 0; d != N; ++d) {
+          real KB[9];
+          for (std::size_t r1 = 0; r1 != gs; ++r1) {
+            KB[r1] = 0;
+            for (std::size_t r2 = 0; r2 != gs; ++r2) {
+              KB[r1] +=
+                  t[static_cast<long long>(r1 * gs + r2) * cs] * Bb[r2][d];
+            }
+          }
+          for (std::size_t c = 0; c != N; ++c) {
+            auto v = real{0};
+            for (std::size_t r1 = 0; r1 != gs; ++r1) {
+              v += Ba[r1][c] * KB[r1];
+            }
+            m[c][d] += w * v;
+          }
+        }
+      }
+      // column-major element matrix, degrees of freedom `node + nd * c`
+      const auto ndofs = nd * N;
+      auto* const me = a.matrices + ndofs * ndofs * e;
+      for (std::size_t c = 0; c != N; ++c) {
+        for (std::size_t d = 0; d != N; ++d) {
+          me[(na + nd * c) + ndofs * (nb + nd * d)] += m[c][d];
+        }
+      }
+    });
+  }  // end of launchStiffnessMatricesKernel
+
+  void launchStiffnessMatricesKernel(const GradientsKind k,
+                                     const StiffnessMatricesKernelArguments& a,
+                                     const bool use_device) {
+    switch (k) {
+      case GradientsKind::SMALL_STRAIN_3D:
+        launchStiffnessMatricesKernel<GradientsKind::SMALL_STRAIN_3D, 3>(
+            a, use_device);
+        break;
+      case GradientsKind::SMALL_STRAIN_2D:
+        launchStiffnessMatricesKernel<GradientsKind::SMALL_STRAIN_2D, 2>(
+            a, use_device);
+        break;
+      case GradientsKind::DEFORMATION_GRADIENT_3D:
+        launchStiffnessMatricesKernel<GradientsKind::DEFORMATION_GRADIENT_3D,
+                                      3>(a, use_device);
+        break;
+      case GradientsKind::DEFORMATION_GRADIENT_2D:
+        launchStiffnessMatricesKernel<GradientsKind::DEFORMATION_GRADIENT_2D,
+                                      2>(a, use_device);
+        break;
+    }
+  }  // end of launchStiffnessMatricesKernel
+
+}  // end of namespace mfem_mgis::batch::internals
