+        const mfem::Vector&,
+        const batch::ElementsGeometrySet&) noexcept override;
+    [[nodiscard]] bool addTangentOperatorDiagonalByKernels(
+        Context&,
+        mfem::Vector&,
+        const batch::ElementsGeometrySet&) noexcept override;
 
