@@ -145,12 +171,10 @@ namespace mfem_mgis {
             p,
             NonLinearEvolutionProblemImplementationBase::InnerForcesComputation,
             "MFEM_MGIS_INNER_FORCES_COMPUTATION")),
-        tangent_operator_kernels(
