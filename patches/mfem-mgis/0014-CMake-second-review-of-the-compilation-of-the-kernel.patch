From 53bb94ca129a34429e771fc577b952317f9e6d4d Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 14:19:38 +0200
Subject: [PATCH] CMake: second review of the compilation of the kernels of
 MFEM

- The CUDA toolkit is the one of the nvcc used to compile MFEM
  (`CUDAToolkit_ROOT`), not the first one found.
- CMake 3.18 is checked as soon as MFEM uses CUDA, before the first
  command requiring it.
- Warning when the CUDA compiler is not the one of MFEM (build directory
  configured before a change of MFEM) and when `-isystem` has no
  directory.
- The CUDA language is checked in the directory of the target, not
  globally.
- The CUDA sources are compiled in C++20 at least (required by the
  headers of mfem-mgis) when the target gives no standard; the standard
  of MFEM is no longer read.
- Comment on the CUDA runtime corrected: MFEM embeds its own static copy.
- With MFEM compiled with HIP, DeviceForallTest is not built (the
  configuration failed).
- Documentation of the module in the installation guide.
---
 CMakeLists.txt                                |  2 +-
 cmake/modules/FindMFEM.cmake                  | 26 ++++++++++
 cmake/modules/MFEMMGISDeviceCode.cmake        | 48 +++++++++++--------
 .../installation_guide/installation_guide.rst | 21 ++++++++
 src/MFEMMGISConfig.cmake.in                   |  2 -
 tests/CMakeLists.txt                          | 31 ++++++------
 6 files changed, 94 insertions(+), 36 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 47b0f954ae..8297edbfb4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -47,7 +47,7 @@ mfem_mgis_enable_device_language()
 # description of MFEM written in the configuration file of mfem-mgis, for
 # the projects which find MFEM before mfem-mgis
 foreach(_property USE_CUDA USE_HIP CUDA_COMPILER CUDA_HOST_COMPILER
-                  CUDA_ARCHITECTURES CXX_STANDARD)
+                  CUDA_ARCHITECTURES)
   get_property(MFEM_MGIS_MFEM_${_property} GLOBAL
                PROPERTY MFEM_MGIS_MFEM_${_property})
 endforeach(_property)
diff --git a/cmake/modules/FindMFEM.cmake b/cmake/modules/FindMFEM.cmake
index b101c97b65..e3accce111 100644
--- a/cmake/modules/FindMFEM.cmake
+++ b/cmake/modules/FindMFEM.cmake
@@ -15,6 +15,12 @@
 #   - MFEM_LIBRARIES
 #   - MFEM_INCLUDE_DIRS
 #   - MFEM_LIBRARY_DIRS
+# and the variables of the `config.mk` file of MFEM (`MFEM_USE_CUDA`, ...).
+#
+# When MFEM is compiled with CUDA, the sources containing kernels of MFEM
+# must be compiled as CUDA code: see `MFEMMGISDeviceCode.cmake`, loaded by
+# this file (`mfem_mgis_enable_device_language`,
+# `mfem_mgis_compile_as_device_code`). CMake 3.18 is then required.
 
 # FIXME: Perhaps I should try to assert that we're building against
 # the same hypre library MFEM built on?
@@ -93,6 +99,12 @@ separate_arguments(MFEM_EXTRA_INC_DIRS UNIX_COMMAND "${MFEM_TPLFLAGS}")
 # `add_compile_options` removes duplicated options. The flags written in
 # the syntax of nvcc are given as such to the sources compiled as CUDA code
 # by nvcc (see `MFEMMGISDeviceCode.cmake`) and translated for the others.
+if(MFEM_USE_CUDA STREQUAL "YES")
+  if(CMAKE_VERSION VERSION_LESS 3.18)
+    message(FATAL_ERROR "mfem-mgis: CMake 3.18 or later is required with "
+            "MFEM compiled with CUDA")
+  endif()
+endif()
 set(_isystem OFF)
 set(_nvcc "$<AND:$<COMPILE_LANGUAGE:CUDA>,$<CUDA_COMPILER_ID:NVIDIA>>")
 foreach(FLAG IN LISTS MFEM_EXTRA_INC_DIRS)
@@ -113,6 +125,10 @@ foreach(FLAG IN LISTS MFEM_EXTRA_INC_DIRS)
     endif()
   endif()
 endforeach(FLAG)
+if(_isystem)
+  message(WARNING "mfem-mgis: the last flag of MFEM_TPLFLAGS is "
+          "'-isystem', without directory: ignored")
+endif()
 
 # Description of MFEM used to compile its kernels (see
 # `MFEMMGISDeviceCode.cmake`)
@@ -148,7 +164,17 @@ mfem_mgis_host_flags(MFEM_EXT_LIBS_LIST ${MFEM_EXT_LIBS_LIST})
 # of the toolkit (`-lcusparse`, ...) without their directory, which nvcc
 # knows but not the C++ compiler
 if(MFEM_USE_CUDA STREQUAL "YES")
+  # the toolkit of the nvcc used to compile MFEM
+  if((NOT DEFINED CUDAToolkit_ROOT) AND (MFEM_CXX MATCHES "nvcc$"))
+    get_filename_component(_mfem_cuda_bin "${MFEM_CXX}" DIRECTORY)
+    get_filename_component(CUDAToolkit_ROOT "${_mfem_cuda_bin}" DIRECTORY)
+  endif()
+  # `CUDAToolkit_ROOT` is used (policy CMP0074, not set by the minimum
+  # version of CMake required by mfem-mgis)
+  cmake_policy(PUSH)
+  cmake_policy(SET CMP0074 NEW)
   find_package(CUDAToolkit REQUIRED)
+  cmake_policy(POP)
   list(PREPEND MFEM_EXT_LIBS_LIST "-L${CUDAToolkit_LIBRARY_DIR}")
   set_property(TARGET MFEM::mfem APPEND
     PROPERTY INTERFACE_LINK_LIBRARIES CUDA::cudart)
diff --git a/cmake/modules/MFEMMGISDeviceCode.cmake b/cmake/modules/MFEMMGISDeviceCode.cmake
index e92feed99b..571983259a 100644
--- a/cmake/modules/MFEMMGISDeviceCode.cmake
+++ b/cmake/modules/MFEMMGISDeviceCode.cmake
@@ -9,7 +9,9 @@
 #   (`MFEM_CXX` and `MFEM_HOST_CXX` in `config.mk`), unless
 #   `CMAKE_CUDA_COMPILER` and `CMAKE_CUDA_HOST_COMPILER` are given. This
 #   macro enables a language: it must be called at file scope (not in a
-#   function), before `mfem_mgis_compile_as_device_code`.
+#   function), before `mfem_mgis_compile_as_device_code`. A warning is
+#   printed if the CUDA compiler is not the one of MFEM (for instance a build
+#   directory configured before a change of MFEM).
 # - `mfem_mgis_compile_as_device_code(target sources...)`: compiles the
