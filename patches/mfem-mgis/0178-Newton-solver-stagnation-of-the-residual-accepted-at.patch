+Stagnation of the residual
+--------------------------
+
+The residual is computed with rounding errors: its norm cannot go below a
+floor, which grows with the size of the problem and with the level of the
+stresses, and which is much higher with ``float`` than with ``double``
+(about :math:`10^{-5}` of the initial residual of a time step for a beam of
+:math:`10^5` unknowns in small strain, :math:`3\,10^{-4}` in finite
+strain). A relative tolerance below this floor can't be reached.
+
+The Newton solver therefore accepts as converged a residual whose smallest
+value has not been halved during the last two iterations, when the norm of
+this residual, relative to the initial one, is below the option
+:cxx:`StagnationRelativeTolerance`. Its default value is :math:`10^4` times
+the machine epsilon of the numerical type: about :math:`1.2\,10^{-3}` with
+``float``, :math:`2.2\,10^{-12}` with ``double``. A null value disables
+this criterion. A message is printed when the criterion stops the
+iterations.
+
+.. code-block:: c++
+
+   problem.setSolverParameters(ctx, {{"RelativeTolerance", 1e-8},
+                                     {"StagnationRelativeTolerance", 1e-4}}) |
+       or_die;
+
 .. _mfem_mgis_fixed_point_algorithm:
 
 Fixed point algorithm
diff --git a/include/MFEMMGIS/NonLinearSolvers/NewtonSolver.hxx b/include/MFEMMGIS/NonLinearSolvers/NewtonSolver.hxx
index 3db71a0838..0bcbb9bb3e 100644
--- a/include/MFEMMGIS/NonLinearSolvers/NewtonSolver.hxx
+++ b/include/MFEMMGIS/NonLinearSolvers/NewtonSolver.hxx
@@ -8,6 +8,7 @@
 #ifndef LIB_MFEM_MGIS_NONLINEARSOLVERS_NEWTONSOLVER_HXX
 #define LIB_MFEM_MGIS_NONLINEARSOLVERS_NEWTONSOLVER_HXX
 
+#include <limits>
 #include <vector>
 #include <optional>
 #include <functional>
@@ -26,9 +27,10 @@ namespace mfem_mgis {
    *
    * Options: the ones of the iterative solvers (`RelativeTolerance`,
    * `AbsoluteTolerance`, `MaximumNumberOfIterations`, `VerbosityLevel`),
-   * `DiscardLinearSolverFailure` and `AdaptiveLinearSolverTolerance`
+   * `DiscardLinearSolverFailure`, `AdaptiveLinearSolverTolerance`
    * (relative tolerance of the iterative linear solver adapted to the
-   * decrease of the residual, see `AdaptiveLinearSolverTolerance`).
+   * decrease of the residual, see `AdaptiveLinearSolverTolerance`) and
+   * `StagnationRelativeTolerance` (see `stagnation_relative_tolerance`).
    */
   struct MFEM_MGIS_EXPORT NewtonSolver : public NonLinearSolverBase {
 #ifdef MFEM_USE_MPI
@@ -75,6 +77,20 @@ namespace mfem_mgis {
      * `AdaptiveLinearSolverTolerance`), disabled by default
      */
     AdaptiveLinearSolverTolerance adaptive_linear_solver_tolerance;
+    /*!
+     * \brief relative residual below which a stagnation of the residual is
+     * accepted as convergence (option `StagnationRelativeTolerance`, zero
+     * disables it). The residual is computed with rounding errors: it
+     * cannot go below a floor, which grows with the size of the problem and
+     * with the level of the stresses, and which is larger in finite strain
+     * with float (the deformation gradient, close to the identity, is
+     * rounded). Below this tolerance, a residual whose smallest value has not
+     * been halved during the last two iterations is considered at this
+     * floor. By default, 10^4 times the machine epsilon of the numerical
+     * type: about 1.2e-3 with float, 2.2e-12 with double.
+     */
+    real stagnation_relative_tolerance =
+        10000 * std::numeric_limits<real>::epsilon();
   };  // end of struct NewtonSolver
 
 }  // end of namespace mfem_mgis
diff --git a/src/NewtonSolver.cxx b/src/NewtonSolver.cxx
index af082fe790..4213143a4f 100644
--- a/src/NewtonSolver.cxx
+++ b/src/NewtonSolver.cxx
@@ -6,6 +6,7 @@
  */
 
 #include <array>
+#include <algorithm>
 #include <string>
 #include <vector>
 #include <iomanip>
@@ -135,6 +136,10 @@ namespace mfem_mgis {
     const auto norm_goal =
         std::max(rel_tol * (*(this->reference_residual_norm)), abs_tol);
     auto it = size_type{};
+    // smallest residual and number of iterations since it was last halved,
+    // to detect a stagnation of the residual
+    auto smallest_norm = norm;
+    auto iterations_without_decrease = size_type{};
 
     this->converged = 0;
     while (true) {
@@ -156,6 +161,28 @@ namespace mfem_mgis {
         this->converged = 1;
         break;
       }
+      // the smallest residual has not been halved during the last two
+      // iterations, at a level of the order of the rounding errors: the
+      // floor of the residual is reached
+      if (2 * norm < smallest_norm) {
+        iterations_without_decrease = 0;
+      } else if (it != 0) {
+        ++iterations_without_decrease;
+      }
+      smallest_norm = std::min(smallest_norm, norm);
+      if ((iterations_without_decrease >= 2) &&
+          (norm <= this->stagnation_relative_tolerance *
+                       (*(this->reference_residual_norm)))) {
+        if (shall_print) {
+          log << "Newton iteration " << std::setw(2) << it
+              << " : stagnation of the residual below the relative "
+                 "tolerance "
+              << this->stagnation_relative_tolerance
+              << ", accepted as convergence\n";
+        }
+        this->converged = 1;
+        break;
+      }
       //
       if (it >= this->max_iter) {
         break;
@@ -264,12 +291,25 @@ namespace mfem_mgis {
       }
       t = *ot;
     }
-    const auto others = remove(
-        params, std::vector<std::string>{"AdaptiveLinearSolverTolerance"});
+    const auto ostagnation = get_if<double>(
+        ctx, params, "StagnationRelativeTolerance",
+        static_cast<double>(this->stagnation_relative_tolerance));
+    if (isInvalid(ostagnation)) {
+      return false;
+    }
+    if ((*ostagnation < 0) || (*ostagnation >= 1)) {
+      return ctx.registerErrorMessage(
+          "NewtonSolver: the option StagnationRelativeTolerance must be in "
+          "[0, 1[");
+    }
+    const auto others =
+        remove(params, std::vector<std::string>{"AdaptiveLinearSolverTolerance",
+                                                "StagnationRelativeTolerance"});
     if (!NonLinearSolverBase::setSolverParameters(ctx, others)) {
       return false;
     }
     this->adaptive_linear_solver_tolerance = t;
+    this->stagnation_relative_tolerance = static_cast<real>(*ostagnation);
     return true;
   }  // end of setSolverParameters
 
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 7857eeb93a..eed9372f2f 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -153,6 +153,47 @@ if(MFEM_MGIS_HAVE_TFEL)
                             EquivalentPlasticStrain)
   add_uniaxial_tensile_test(Mazars Damage)
   add_uniaxial_tensile_test(SaintVenantKirchhoffElasticity EquivalentStrain)
+  # convergence of the Newton solver at the floor of the residual, in float
+  # only: with an unreachable relative tolerance, a stagnation of the
+  # residual is accepted as convergence (option StagnationRelativeTolerance
+  # of the Newton solver), and the resolution fails when this option is
+  # disabled. The relative tolerance is bounded below by 100 times the
+  # machine epsilon, and the floor of the residual is reached with the finite
+  # strain behaviour (about 3e-4). In double, the residual of these tests
+  # keeps decreasing slowly (factor 0.5 per iteration at 5e-19 of the
+  # initial residual): the floor is not reached in ten iterations
+  if(MFEM_MGIS_REAL_TYPE STREQUAL "float")
+    foreach(behaviour IsotropicLinearHardeningPlasticity
+                      SaintVenantKirchhoffElasticity)
+      if(behaviour STREQUAL "IsotropicLinearHardeningPlasticity")
+        set(isv EquivalentPlasticStrain)
+      else()
+        set(isv EquivalentStrain)
+      endif()
+      add_test(NAME UniaxialTensileTest-Stagnation-${behaviour}
+               COMMAND ./UniaxialTensileTest
+                       --mesh ${CMAKE_CURRENT_SOURCE_DIR}/cube.mesh
+                       --library $<TARGET_FILE:BehaviourTest>
+                       --behaviour ${behaviour}
+                       --reference-file
+                       ${CMAKE_CURRENT_SOURCE_DIR}/references/${behaviour}.ref
+                       --internal-state-variable ${isv}
+                       --relative-tolerance 1e-30 --no-parallel
+                       --no-post-processing)
+    endforeach()
+    add_test(NAME UniaxialTensileTest-NoStagnation-SaintVenantKirchhoffElasticity
+             COMMAND ./UniaxialTensileTest
+                     --mesh ${CMAKE_CURRENT_SOURCE_DIR}/cube.mesh
+                     --library $<TARGET_FILE:BehaviourTest>
+                     --behaviour SaintVenantKirchhoffElasticity
+                     --internal-state-variable EquivalentStrain
+                     --relative-tolerance 1e-30
+                     --stagnation-relative-tolerance 0 --no-parallel
+                     --no-post-processing)
+    set_tests_properties(
+      UniaxialTensileTest-NoStagnation-SaintVenantKirchhoffElasticity
+      PROPERTIES WILL_FAIL ON)
+  endif()
 
   # ImposedPressureTest executable
   add_test_executable(ImposedPressureTest)
