From 0b17f451b76fbc34d2fab180cd8964cf83a160d6 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 13:58:04 +0200
Subject: [PATCH] CMake: only the -I and -L flags of tfel-config, several
 library directories

`tfel-config --includes` and `--libs` may return other flags: only the
`-I` and `-L` flags give directories. `env.sh` adds each library
directory of TFEL to `LD_LIBRARY_PATH` (the CMake list was added as one
directory).
---
 cmake/env.sh.in          | 7 ++++++-
 cmake/modules/tfel.cmake | 9 +++++----
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/cmake/env.sh.in b/cmake/env.sh.in
index e86b5f16b2..a46ba42835 100644
--- a/cmake/env.sh.in
+++ b/cmake/env.sh.in
@@ -19,7 +19,12 @@ pathadd "@MPICXX_PATH@"
 pathadd "@CMAKE_CP_PATH@"
 export PATH
 
-ldadd "@TFEL_LIBRARY_PATH@"
+# TFEL may have several library directories (CMake list)
+IFS=';' read -ra _tfel_library_paths <<< "@TFEL_LIBRARY_PATH@"
+for _d in "${_tfel_library_paths[@]}"; do
+    ldadd "$_d"
+done
+unset _d _tfel_library_paths
 ldadd "@MFrontGenericInterface_DIR@/../../../lib"
 export LD_LIBRARY_PATH
 
diff --git a/cmake/modules/tfel.cmake b/cmake/modules/tfel.cmake
index 9e2f1c02ba..453baada62 100644
--- a/cmake/modules/tfel.cmake
+++ b/cmake/modules/tfel.cmake
@@ -27,15 +27,16 @@ IF(TFEL_CONFIG AND MFRONT AND MFRONT_QUERY)
 
   # `tfel-config --includes` and `tfel-config --libs` may return several
   # directories (for instance the headers of TDLS): each `-I` or `-L` flag
-  # gives one element of the list
+  # gives one element of the list, the other flags are ignored
   EXECUTE_PROCESS(COMMAND ${TFEL_CONFIG} "--includes"
     OUTPUT_VARIABLE _tfel_includes
     OUTPUT_STRIP_TRAILING_WHITESPACE)
   separate_arguments(_tfel_includes UNIX_COMMAND "${_tfel_includes}")
   set(TFEL_INCLUDE_PATH)
   foreach(_flag IN LISTS _tfel_includes)
-    string(REGEX REPLACE "^-I" "" _flag "${_flag}")
-    list(APPEND TFEL_INCLUDE_PATH "${_flag}")
+    if(_flag MATCHES "^-I(.+)$")
+      list(APPEND TFEL_INCLUDE_PATH "${CMAKE_MATCH_1}")
+    endif()
   endforeach(_flag)
   EXECUTE_PROCESS(COMMAND ${TFEL_CONFIG} "--libs"
     OUTPUT_VARIABLE _tfel_libs
@@ -43,7 +44,7 @@ IF(TFEL_CONFIG AND MFRONT AND MFRONT_QUERY)
   separate_arguments(_tfel_libs UNIX_COMMAND "${_tfel_libs}")
   set(TFEL_LIBRARY_PATH)
   foreach(_flag IN LISTS _tfel_libs)
-    if(_flag MATCHES "^-L(.*)$")
+    if(_flag MATCHES "^-L(.+)$")
       list(APPEND TFEL_LIBRARY_PATH "${CMAKE_MATCH_1}")
     endif()
   endforeach(_flag)
-- 
