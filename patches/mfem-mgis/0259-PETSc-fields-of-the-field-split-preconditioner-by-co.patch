--- a/src/PETScSupport.cxx
+++ b/src/PETScSupport.cxx
@@ -23,6 +23,8 @@
 #include "petscsys.h"
 #include "petscvec.h"
 #include "petscmat.h"
+#include "petscpc.h"
+#include "petscis.h"
 #include "mfem/fem/pfespace.hpp"
