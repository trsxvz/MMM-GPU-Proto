From c2010db8d247fdf35435933a4e57104c62e88315 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 05:03:39 +0200
Subject: [PATCH] BatchIntegrationTest: FBar refusal test, order of the
 materials, tolerance

- the test of the refusal of the tangent operator of the FBar
  formulation computed by kernels from gradients computed element by
  element sets the temperature, and refines the mesh once, so that all
  the processes detect the refusal in parallel;
- the tested material is the material 2 of the mesh with two materials,
  whose elements come after the ones of the material 1: their indices in
  the mesh and in the material differ;
- new option `relative_tolerance`, 1e-11 for the FBar cases with an
  imposed pressure, whose residual stagnates at about 1e-12 times its
  reference value in parallel;
- the numbers of iterations are printed when they differ.
---
 tests/BatchIntegrationTest.cxx | 49 +++++++++++++++++++++++++---------
 1 file changed, 37 insertions(+), 12 deletions(-)

diff --git a/tests/BatchIntegrationTest.cxx b/tests/BatchIntegrationTest.cxx
index 6838717aee..c5e2c0d51a 100644
--- a/tests/BatchIntegrationTest.cxx
+++ b/tests/BatchIntegrationTest.cxx
@@ -157,13 +157,18 @@ struct ComputationOptions {
    */
   bool chebyshev_preconditioner = false;
   /*!
-   * \brief if not null, the mesh has two materials (1 and 2), the second one
+   * \brief if not null, the mesh has two materials (1 and 2), the first one
    * being an isotropic elastic material whose behaviour is taken from this
-   * library (generated by the generic interface, integrated on the host)
+   * library (generated by the generic interface, integrated on the host).
+   * The elements of the material 1 come first in the mesh: the elements of
+   * the tested material (2) have different indices in the mesh and in the
+   * material.
    */
   const char* second_material_library = nullptr;
   //! \brief order of the finite elements
   int order = 1;
+  //! \brief relative tolerance of the Newton algorithm
+  mfem_mgis::real relative_tolerance = 1e-12;
 };
 
 /*!
@@ -297,10 +302,10 @@ static Results compute(mfem_mgis::Context& ctx,
       opts.matrix_free
           ? "MatrixFree"
           : (opts.tangent_operator_kernels ? "Kernels" : "ElementByElement");
-  // in 3D, the material 2 of a mesh with two materials is elastic (see
+  // in 3D, the material 1 of a mesh with two materials is elastic (see
   // `ComputationOptions::second_material_library`)
   const auto materials = (opts.second_material_library != nullptr)
-                             ? Parameters{{"Cube", 1}, {"Cube2", 2}}
+                             ? Parameters{{"Cube", 2}, {"Cube2", 1}}
                              : Parameters{{"Cube", 1}};
   // plane strain: the mesh of the unit square, boundaries x = 0 (2), y = 0
   // (5) and x = 1 (4)
@@ -482,12 +487,13 @@ static Results compute(mfem_mgis::Context& ctx,
                             {}) |
         or_die;
   }
-  const auto setMaximumNumberOfIterations = [&ctx, &problem,
+  const auto setMaximumNumberOfIterations = [&ctx, &problem, &opts,
                                              &or_die](const int n) {
-    problem.setSolverParameters(ctx, {{"VerbosityLevel", 0},
-                                      {"RelativeTolerance", 1e-12},
-                                      {"AbsoluteTolerance", 0.},
-                                      {"MaximumNumberOfIterations", n}}) |
+    problem.setSolverParameters(ctx,
+                                {{"VerbosityLevel", 0},
+                                 {"RelativeTolerance", opts.relative_tolerance},
+                                 {"AbsoluteTolerance", 0.},
+                                 {"MaximumNumberOfIterations", n}}) |
         or_die;
   };
   setMaximumNumberOfIterations(20);
@@ -620,6 +626,17 @@ static void compare(const Results& r1,
     }
     check(close, name + ": numbers of iterations");
   }
+  if (r1.iterations != r2.iterations) {
+    std::cout << name << ": numbers of iterations";
+    for (const auto& [label, r] :
+         {std::pair{", reference:", &r1}, std::pair{", results:", &r2}}) {
+      std::cout << label;
+      for (const auto n : r->iterations) {
+        std::cout << ' ' << n;
+      }
+    }
+    std::cout << '\n';
+  }
 }  // end of compare
 
 /*!
@@ -957,7 +974,7 @@ static void testFBarTangentOperatorRefusal(mfem_mgis::Context& ctx,
               {"FiniteElementFamily", "H1"},
               {"FiniteElementOrder", 1},
               {"UnknownsSize", 3},
-              {"NumberOfUniformRefinements", 0},
+              {"NumberOfUniformRefinements", 1},
               {"Materials", Parameters{{"Cube", 1}}},
               {"Boundaries",
                Parameters{{"Ymin", 1}, {"Zmin", 2}, {"Xmax", 3}, {"Xmin", 5}}},
@@ -971,6 +988,11 @@ static void testFBarTangentOperatorRefusal(mfem_mgis::Context& ctx,
       ctx, "Mechanics", "Cube", library, "SaintVenantKirchhoffElasticity",
       {{"Regularization", Parameters{{"FBar", Parameters{}}}}}) |
       or_die;
+  auto& m = problem.getMaterial(ctx, "Cube", 0) | or_die;
+  for (auto* s : {&m.s0, &m.s1}) {
+    mgis::behaviour::setExternalStateVariable(ctx, *s, "Temperature", 293.15) |
+        or_die;
+  }
   for (const auto& [boundary, component] :
        {std::pair{"Xmin", 0}, std::pair{"Ymin", 1}, std::pair{"Zmin", 2}}) {
     problem.addUniformDirichletBoundaryCondition(
@@ -1323,14 +1345,17 @@ int main(int argc, char** argv) {
                         .tangent_operator_kernels = true},
                        ", FBar, plane strain"});
       // imposed pressure: the boundary integrator requires the stiffness
-      // matrices element by element of the FBar formulation
+      // matrices element by element of the FBar formulation. The residual
+      // stagnates at about 1e-12 times its reference value in parallel, the
+      // numbers of iterations differing by two with a tolerance of 1e-12
       cases.push_back({b,
                        {.fbar = true,
                         .prediction = true,
                         .pressure = true,
                         .gradients_kernels = true,
                         .inner_forces_kernels = true,
-                        .tangent_operator_kernels = true},
+                        .tangent_operator_kernels = true,
+                        .relative_tolerance = 1e-11},
                        ", FBar, pressure and prediction"});
     }
     // a material using the FBar formulation and an elastic one
