diff --git a/src/Batch/IntegrationPointsFunctions.cxx b/src/Batch/IntegrationPointsFunctions.cxx
new file mode 100644
index 0000000000..5646531580
--- /dev/null
+++ b/src/Batch/IntegrationPointsFunctions.cxx
@@ -0,0 +1,272 @@
+/*!
+ * \file   src/Batch/IntegrationPointsFunctions.cxx
+ * \brief  This file implements the computations by kernels on functions
+ * defined at the integration points of a material (host part: checks and
+ * arguments of the kernels)
+ * \date   11/10/2026
+ */
+
+#include <string>
+#include <cstdint>
+#include <exception>
+#include "mfem/general/device.hpp"
+#include "mfem/fem/fe/fe_base.hpp"
+#include "MFEMMGIS/PartialQuadratureSpace.hxx"
+#include "MFEMMGIS/PartialQuadratureFunction.hxx"
+#include "MFEMMGIS/Batch/IntegrationPointsFunctions.hxx"
+#ifdef MFEM_MGIS_HAVE_DEVICE_SOURCES
+#include "IntegrationPointsFunctionsKernels.hxx"
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+
+namespace mfem_mgis::batch {
+
+  bool gatherValues(Context& ctx,
+                    mfem::Vector& v,
+                    const ImmutablePartialQuadratureFunctionView& f) noexcept {
+    try {
+      const auto& qs = f.getPartialQuadratureSpace();
+      const auto& elements = qs.getElements();
+      const auto& offsets = qs.getElementOffsets();
+      const auto n = static_cast<std::int64_t>(elements.Size());
+      const auto* const ir = qs.getUniformIntegrationRule();
+      if ((n != 0) && (ir == nullptr)) {
+        return ctx.registerErrorMessage(
+            "gatherValues: the elements of the partial quadrature space do "
+            "not use the same integration rule");
+      }
+      const auto nq = (n == 0) ? std::int64_t{0} : ir->GetNPoints();
+      const auto nc = static_cast<std::int64_t>(f.getNumberOfComponents());
+      v.SetSize(static_cast<int>(nc * nq * n));
+      v.UseDevice(true);
+      auto* const pv = v.HostWrite();
+      const auto* const po = offsets.HostRead();
+      for (std::int64_t k = 0; k != n; ++k) {
+        for (std::int64_t q = 0; q != nq; ++q) {
+          const auto values =
+              f.getIntegrationPointValues(static_cast<size_type>(po[k] + q));
+          for (std::int64_t c = 0; c != nc; ++c) {
+            pv[c + nc * (q + nq * k)] = values[c];
+          }
+        }
+      }
+    } catch (std::exception& e) {
+      return ctx.registerErrorMessage(std::string{"gatherValues: "} + e.what());
+    } catch (...) {
+      return ctx.registerErrorMessage("gatherValues: unknown exception");
+    }
+    return true;
+  }  // end of gatherValues
+
+#ifdef MFEM_MGIS_HAVE_DEVICE_SOURCES
+
+  /*!
+   * \brief checks the geometric data of a partial quadrature space and the
+   * size of the values of a function, and fills the arguments of the
+   * kernels
+   * \return true on success
+   * \param[in, out] ctx: execution context
+   * \param[out] a: arguments of the kernels
+   * \param[in] qs: partial quadrature space
+   * \param[in] v: values of the function, or null
+   * \param[in] nc: number of components of the function
+   * \param[in] g: geometric data
+   * \param[in] use_device: if true, the data are read on the device
+   * \param[in] name: name of the calling function, for the messages
+   */
+  static bool makeKernelArguments(
+      Context& ctx,
+      internals::IntegrationPointsFunctionsKernelArguments& a,
+      const PartialQuadratureSpace& qs,
+      const mfem::Vector* const v,
+      const size_type nc,
+      const ElementsGeometry& g,
+      const bool use_device,
+      const char* const name) {
+    const auto& elements = qs.getElements();
+    if ((g.rule == nullptr) || (g.maps == nullptr) ||
+        (g.jacobians == nullptr) ||
+        (qs.getUniformIntegrationRule() != g.rule)) {
+      return ctx.registerErrorMessage(
+          std::string{name} +
+          ": the elements of the partial quadrature space do not use the "
+          "integration rule of the geometric data");
+    }
+    if (nc == 0) {
+      return ctx.registerErrorMessage(std::string{name} +
+                                      ": invalid number of components");
+    }
+    const auto size =
+        std::int64_t{g.nq} * static_cast<std::int64_t>(nc) * elements.Size();
+    if ((v != nullptr) && (static_cast<std::int64_t>(v->Size()) != size)) {
+      return ctx.registerErrorMessage(
+          std::string{name} +
+          ": unexpected size of the values of the function");
+    }
+    a.elements = elements.Read(use_device);
+    a.points.shape_functions = g.maps->B.Read(use_device);
+    a.points.determinants = g.jacobians->detJ.Read(use_device);
+    a.points.weights = g.weights.Read(use_device);
+    a.points.nq = g.nq;
+    a.values = (v != nullptr) ? v->Read(use_device) : nullptr;
+    a.nc = static_cast<int>(nc);
+    a.number_of_elements = elements.Size();
+    a.nd = g.nd;
+    return true;
+  }  // end of makeKernelArguments
+
+  //! \return an error message reporting an exception
+  static std::string getExceptionMessage(const char* const name) {
+    try {
+      throw;
+    } catch (std::exception& e) {
+      return std::string{name} + ": " + e.what();
+    } catch (...) {
+    }
+    return std::string{name} + ": unknown exception";
+  }  // end of getExceptionMessage
+
+#else /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+
+  //! \return an error message reporting kernels which are not compiled
+  static std::string getUnavailableKernelsMessage(const char* const name) {
+    return std::string{name} +
+           ": the kernels on the functions at the integration points are not "
+           "compiled (MFEM compiled with HIP)";
+  }  // end of getUnavailableKernelsMessage
+
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+
+  std::optional<real> computeIntegral(Context& ctx,
+                                      const PartialQuadratureSpace& qs,
+                                      const mfem::Vector* const v,
+                                      const ElementsGeometry& g) noexcept {
+#ifndef MFEM_MGIS_HAVE_DEVICE_SOURCES
+    static_cast<void>(qs);
+    static_cast<void>(v);
+    static_cast<void>(g);
+    return ctx.registerErrorMessage(
+        getUnavailableKernelsMessage("computeIntegral"));
+#else  /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+    if (qs.getElements().Size() == 0) {
+      return real{0};
+    }
+    try {
+      const auto use_device = mfem::Device::IsEnabled();
+      auto a = internals::IntegrationPointsFunctionsKernelArguments{};
+      if (!makeKernelArguments(ctx, a, qs, v, 1, g, use_device,
+                               "computeIntegral")) {
+        return {};
+      }
+      auto w = mfem::Array<real>{};
+      return internals::launchIntegralKernel(a, w, use_device);
+    } catch (...) {
+      return ctx.registerErrorMessage(getExceptionMessage("computeIntegral"));
+    }
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+  }  // end of computeIntegral
+
+  bool addL2ProjectionRightHandSide(Context& ctx,
+                                    mfem::Vector& r,
+                                    const PartialQuadratureSpace& qs,
+                                    const mfem::Vector& v,
+                                    const size_type nc,
+                                    const size_type c,
+                                    const ElementsGeometry& g) noexcept {
+#ifndef MFEM_MGIS_HAVE_DEVICE_SOURCES
+    static_cast<void>(r);
+    static_cast<void>(qs);
+    static_cast<void>(v);
+    static_cast<void>(nc);
+    static_cast<void>(c);
+    static_cast<void>(g);
+    return ctx.registerErrorMessage(
+        getUnavailableKernelsMessage("addL2ProjectionRightHandSide"));
+#else  /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+    const auto* const name = "addL2ProjectionRightHandSide";
+    if (qs.getElements().Size() == 0) {
+      return true;
+    }
+    if (c >= nc) {
+      return ctx.registerErrorMessage(std::string{name} +
+                                      ": invalid component");
+    }
+    if (static_cast<std::int64_t>(r.Size()) != std::int64_t{g.nd} * g.ne) {
+      return ctx.registerErrorMessage(
+          std::string{name} +
+          ": unexpected size of the values element by element");
+    }
+    try {
+      const auto use_device = mfem::Device::IsEnabled();
+      auto a = internals::IntegrationPointsFunctionsKernelArguments{};
+      if (!makeKernelArguments(ctx, a, qs, &v, nc, g, use_device, name)) {
+        return false;
+      }
+      internals::launchL2ProjectionRightHandSideKernel(
+          a, static_cast<int>(c), r.ReadWrite(use_device), use_device);
+    } catch (...) {
+      return ctx.registerErrorMessage(getExceptionMessage(name));
+    }
+    return true;
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+  }  // end of addL2ProjectionRightHandSide
+
+  bool computeLocalProjections(Context& ctx,
+                               mfem::Vector& r,
+                               const PartialQuadratureSpace& qs,
+                               const mfem::Vector& v,
+                               const size_type nc,
+                               const ElementsGeometry& g,
+                               const ElementsGeometry& m) noexcept {
+#ifndef MFEM_MGIS_HAVE_DEVICE_SOURCES
+    static_cast<void>(r);
+    static_cast<void>(qs);
+    static_cast<void>(v);
+    static_cast<void>(nc);
+    static_cast<void>(g);
+    static_cast<void>(m);
+    return ctx.registerErrorMessage(
+        getUnavailableKernelsMessage("computeLocalProjections"));
+#else  /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+    const auto* const name = "computeLocalProjections";
+    if (qs.getElements().Size() == 0) {
+      return true;
+    }
+    if ((m.rule == nullptr) || (m.maps == nullptr) ||
+        (m.jacobians == nullptr) || (m.nd != g.nd) || (m.ne != g.ne)) {
+      return ctx.registerErrorMessage(
+          std::string{name} +
+          ": inconsistent geometric data of the mass matrices");
+    }
+    if (g.nd > maximumNumberOfNodesOfLocalProjections) {
+      return ctx.registerErrorMessage(
+          std::string{name} + ": too many degrees of freedom per element (" +
+          std::to_string(g.nd) + ", at most " +
+          std::to_string(maximumNumberOfNodesOfLocalProjections) + ")");
+    }
+    if (static_cast<std::int64_t>(r.Size()) !=
+        std::int64_t{g.nd} * static_cast<std::int64_t>(nc) * g.ne) {
+      return ctx.registerErrorMessage(
+          std::string{name} +
+          ": unexpected size of the values element by element");
+    }
+    try {
+      const auto use_device = mfem::Device::IsEnabled();
+      auto a = internals::IntegrationPointsFunctionsKernelArguments{};
+      if (!makeKernelArguments(ctx, a, qs, &v, nc, g, use_device, name)) {
+        return false;
+      }
+      auto am = internals::IntegrationRuleKernelArguments{};
+      am.shape_functions = m.maps->B.Read(use_device);
+      am.determinants = m.jacobians->detJ.Read(use_device);
+      am.weights = m.weights.Read(use_device);
+      am.nq = m.nq;
+      internals::launchLocalProjectionsKernel(a, am, r.ReadWrite(use_device),
+                                              use_device);
+    } catch (...) {
+      return ctx.registerErrorMessage(getExceptionMessage(name));
+    }
+    return true;
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+  }  // end of computeLocalProjections
+
+}  // end of namespace mfem_mgis::batch
diff --git a/src/Batch/IntegrationPointsFunctionsKernels.cxx b/src/Batch/IntegrationPointsFunctionsKernels.cxx
new file mode 100644
index 0000000000..7b69f77a2f
--- /dev/null
+++ b/src/Batch/IntegrationPointsFunctionsKernels.cxx
@@ -0,0 +1,155 @@
+/*!
+ * \file   src/Batch/IntegrationPointsFunctionsKernels.cxx
+ * \brief  This file implements the kernels computing integrals, right-hand
+ * sides of L2 projections and local projections of functions defined at
+ * the integration points of a material. It contains kernels of MFEM: it is
+ * compiled as CUDA code when MFEM is compiled with CUDA.
+ * \date   11/10/2026
+ */
+
+#include <cmath>
+#include <cstddef>
+#include "mfem/general/forall.hpp"
+#include "mfem/general/reducers.hpp"
+#include "MFEMMGIS/Batch/IntegrationPointsFunctions.hxx"
+#include "IntegrationPointsFunctionsKernels.hxx"
+
+namespace mfem_mgis::batch::internals {
+
+  real launchIntegralKernel(const IntegrationPointsFunctionsKernelArguments& a,
+                            mfem::Array<real>& w,
+                            const bool use_device) {
+    auto r = real{};
+    mfem::reduce(
+        a.number_of_elements, r,
+        [a] MFEM_HOST_DEVICE(const int k, real& s) {
+          const auto e = static_cast<std::size_t>(a.elements[k]);
+          const auto nq = static_cast<std::size_t>(a.points.nq);
+          const auto ke = static_cast<std::size_t>(k);
+          for (std::size_t q = 0; q != nq; ++q) {
+            const auto detJ = a.points.determinants[q + nq * e];
+            if (a.values == nullptr) {
+              s += a.points.weights[q] * detJ;
+            } else {
+              s += a.points.weights[q] * (detJ * a.values[q + nq * ke]);
+            }
+          }
+        },
+        mfem::SumReducer<real>{}, use_device, w);
+    return r;
+  }  // end of launchIntegralKernel
+
+  void launchL2ProjectionRightHandSideKernel(
+      const IntegrationPointsFunctionsKernelArguments& a,
+      const int c,
+      real* const r,
+      const bool use_device) {
+    mfem::forall_switch(
+        use_device, a.number_of_elements, [a, c, r] MFEM_HOST_DEVICE(int k) {
+          const auto e = static_cast<std::size_t>(a.elements[k]);
+          const auto nq = static_cast<std::size_t>(a.points.nq);
+          const auto nd = static_cast<std::size_t>(a.nd);
+          const auto nc = static_cast<std::size_t>(a.nc);
+          const auto ke = static_cast<std::size_t>(k);
+          auto* const re = r + nd * e;
+          for (std::size_t q = 0; q != nq; ++q) {
+            const auto f =
+                a.values[static_cast<std::size_t>(c) + nc * (q + nq * ke)];
+            // same operations as the integrators of the L2 projection
+            const auto w =
+                a.points.weights[q] * (a.points.determinants[q + nq * e] * f);
+            for (std::size_t i = 0; i != nd; ++i) {
+              re[i] += w * a.points.shape_functions[q + nq * i];
+            }
+          }
+        });
+  }  // end of launchL2ProjectionRightHandSideKernel
+
+  void launchLocalProjectionsKernel(
+      const IntegrationPointsFunctionsKernelArguments& a,
+      const IntegrationRuleKernelArguments& m,
+      real* const r,
+      const bool use_device) {
+    mfem::forall_switch(
+        use_device, a.number_of_elements, [a, m, r] MFEM_HOST_DEVICE(int k) {
+          constexpr auto N =
+              static_cast<std::size_t>(maximumNumberOfNodesOfLocalProjections);
+          const auto e = static_cast<std::size_t>(a.elements[k]);
+          const auto nq = static_cast<std::size_t>(a.points.nq);
+          const auto nqm = static_cast<std::size_t>(m.nq);
+          const auto nd = static_cast<std::size_t>(a.nd);
+          const auto nc = static_cast<std::size_t>(a.nc);
+          const auto ke = static_cast<std::size_t>(k);
+          // lower part of the mass matrix of the element, then of its
+          // Cholesky factor (row major, N x N)
+          real L[N * N];
+          for (std::size_t i = 0; i != nd; ++i) {
+            for (std::size_t j = 0; j <= i; ++j) {
+              L[i * N + j] = real{0};
+            }
+          }
+          for (std::size_t q = 0; q != nqm; ++q) {
+            const auto w = m.weights[q] * m.determinants[q + nqm * e];
+            for (std::size_t i = 0; i != nd; ++i) {
+              const auto wNi = w * m.shape_functions[q + nqm * i];
+              for (std::size_t j = 0; j <= i; ++j) {
+                L[i * N + j] += wNi * m.shape_functions[q + nqm * j];
+              }
+            }
+          }
+          // right-hand sides, stored in the values of the element
+          auto* const re = r + nd * nc * e;
+          for (std::size_t c = 0; c != nc; ++c) {
+            for (std::size_t i = 0; i != nd; ++i) {
+              re[i + nd * c] = real{0};
+            }
+          }
+          for (std::size_t q = 0; q != nq; ++q) {
+            const auto w =
+                a.points.weights[q] * a.points.determinants[q + nq * e];
+            const auto* const f = a.values + nc * (q + nq * ke);
+            for (std::size_t i = 0; i != nd; ++i) {
+              const auto wNi = w * a.points.shape_functions[q + nq * i];
+              for (std::size_t c = 0; c != nc; ++c) {
+                re[i + nd * c] += wNi * f[c];
+              }
+            }
+          }
+          // Cholesky factorization of the mass matrix
+          for (std::size_t j = 0; j != nd; ++j) {
+            auto d = L[j * N + j];
+            for (std::size_t p = 0; p != j; ++p) {
+              d -= L[j * N + p] * L[j * N + p];
+            }
+            const auto ljj = sqrt(d);
+            L[j * N + j] = ljj;
+            for (std::size_t i = j + 1; i != nd; ++i) {
+              auto s = L[i * N + j];
+              for (std::size_t p = 0; p != j; ++p) {
+                s -= L[i * N + p] * L[j * N + p];
+              }
+              L[i * N + j] = s / ljj;
+            }
+          }
+          // resolutions, component by component
+          for (std::size_t c = 0; c != nc; ++c) {
+            auto* const x = re + nd * c;
+            for (std::size_t i = 0; i != nd; ++i) {
+              auto s = x[i];
+              for (std::size_t p = 0; p != i; ++p) {
+                s -= L[i * N + p] * x[p];
+              }
+              x[i] = s / L[i * N + i];
+            }
+            for (std::size_t i = nd; i-- != 0;) {
+              auto s = x[i];
+              for (std::size_t p = i + 1; p != nd; ++p) {
+                s -= L[p * N + i] * x[p];
+              }
+              x[i] = s / L[i * N + i];
+            }
+          }
+        });
+  }  // end of launchLocalProjectionsKernel
+
+}  // end of namespace mfem_mgis::batch::internals
