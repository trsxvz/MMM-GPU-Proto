 namespace mfem_mgis::internals {
 
-  AmgXSolver::AmgXSolver(const std::string& c,
-                         const CONFIG_SRC s,
-                         const bool v,
-                         const std::optional<int> n)
-      : maximum_number_of_iterations(n) {
-    // the default configuration also initialises the mode of the solver,
