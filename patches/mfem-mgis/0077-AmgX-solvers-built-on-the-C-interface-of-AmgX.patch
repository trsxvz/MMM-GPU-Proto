diff --git a/cmake/modules/FindAMGX.cmake b/cmake/modules/FindAMGX.cmake
new file mode 100644
index 0000000000..002dc51174
--- /dev/null
+++ b/cmake/modules/FindAMGX.cmake
@@ -0,0 +1,39 @@
+# Find the AmgX library of NVIDIA (https://github.com/NVIDIA/AMGX)
+#
+# The installation directory of AmgX may be given by the variable
+# `AMGX_DIR` or by the environment variable of the same name. This module
+# defines:
+#   - AMGX_FOUND
+#   - AMGX_INCLUDE_DIR, directory of `amgx_c.h`
+#   - AMGX_LIBRARY, shared library of AmgX (`libamgxsh`)
+#   - the imported target `AMGX::amgxsh`, linked with the runtime of CUDA
+#     (`CUDA::cudart`) if this target is defined
+
+# the installation directory given is searched first, before the prefixes
+# of CMake (`CMAKE_PREFIX_PATH`), which may contain another AmgX
+foreach(_amgx_paths "NO_DEFAULT_PATH" "")
+  find_path(AMGX_INCLUDE_DIR amgx_c.h
+    HINTS ${AMGX_DIR} $ENV{AMGX_DIR}
+    PATH_SUFFIXES include
+    DOC "Directory of the headers of AmgX"
+    ${_amgx_paths})
+  find_library(AMGX_LIBRARY amgxsh
+    HINTS ${AMGX_DIR} $ENV{AMGX_DIR}
+    PATH_SUFFIXES lib lib64
+    DOC "Shared library of AmgX"
+    ${_amgx_paths})
+endforeach(_amgx_paths)
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(AMGX
+  REQUIRED_VARS AMGX_LIBRARY AMGX_INCLUDE_DIR)
+if(AMGX_FOUND AND (NOT TARGET AMGX::amgxsh))
+  add_library(AMGX::amgxsh SHARED IMPORTED)
+  set_target_properties(AMGX::amgxsh PROPERTIES
+    IMPORTED_LOCATION "${AMGX_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${AMGX_INCLUDE_DIR}")
+  if(TARGET CUDA::cudart)
+    set_property(TARGET AMGX::amgxsh APPEND PROPERTY
+      INTERFACE_LINK_LIBRARIES CUDA::cudart)
+  endif()
+endif()
+mark_as_advanced(AMGX_INCLUDE_DIR AMGX_LIBRARY)
diff --git a/src/AmgXKernels.cxx b/src/AmgXKernels.cxx
new file mode 100644
index 0000000000..7add29afe5
--- /dev/null
+++ b/src/AmgXKernels.cxx
@@ -0,0 +1,36 @@
+/*!
+ * \file   src/AmgXKernels.cxx
+ * \brief  This file implements the conversions of the vectors exchanged
+ * with the solvers of AmgX in single precision
+ * \date   10/10/2026
+ * \note   compiled as CUDA code when MFEM is compiled with CUDA
+ */
+
+#include "mfem/general/forall.hpp"
+#include "AmgXKernels.hxx"
+
+namespace mfem_mgis::internals {
+
+  void convertToSinglePrecision(mfem::Array<float>& d, const mfem::Vector& s) {
+    const auto n = s.Size();
+    const auto use_device = s.UseDevice() && mfem::Device::IsEnabled();
+    d.SetSize(n);
+    const auto* const ps = s.Read(use_device);
+    auto* const pd = d.Write(use_device);
+    mfem::forall_switch(use_device, n, [=] MFEM_HOST_DEVICE(const int i) {
+      pd[i] = static_cast<float>(ps[i]);
+    });
+  }  // end of convertToSinglePrecision
+
+  void convertToDoublePrecision(mfem::Vector& d, const mfem::Array<float>& s) {
+    const auto n = s.Size();
+    const auto use_device = d.UseDevice() && mfem::Device::IsEnabled();
+    d.SetSize(n);
+    const auto* const ps = s.Read(use_device);
+    auto* const pd = d.Write(use_device);
+    mfem::forall_switch(use_device, n, [=] MFEM_HOST_DEVICE(const int i) {
+      pd[i] = static_cast<double>(ps[i]);
+    });
+  }  // end of convertToDoublePrecision
+
+}  // end of namespace mfem_mgis::internals
diff --git a/src/AmgXKernels.hxx b/src/AmgXKernels.hxx
new file mode 100644
index 0000000000..48efffbf74
--- /dev/null
+++ b/src/AmgXKernels.hxx
@@ -0,0 +1,33 @@
+/*!
+ * \file   src/AmgXKernels.hxx
+ * \brief  This file declares the conversions of the vectors exchanged with
+ * the solvers of AmgX in single precision (internal header)
+ * \date   10/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_SRC_AMGXKERNELS_HXX
+#define LIB_MFEM_MGIS_SRC_AMGXKERNELS_HXX
+
+#include "mfem/general/array.hpp"
+#include "mfem/linalg/vector.hpp"
+
+namespace mfem_mgis::internals {
+
+  /*!
+   * \brief converts a vector in double precision to single precision, on
+   * the device if the vector uses it
+   * \param[out] d: values in single precision, resized
+   * \param[in] s: vector
+   */
+  void convertToSinglePrecision(mfem::Array<float>&, const mfem::Vector&);
+  /*!
+   * \brief converts values in single precision to a vector in double
+   * precision, on the device if the vector uses it
+   * \param[out] d: vector, of the size of the values
+   * \param[in] s: values in single precision
+   */
+  void convertToDoublePrecision(mfem::Vector&, const mfem::Array<float>&);
+
+}  // end of namespace mfem_mgis::internals
+
+#endif /* LIB_MFEM_MGIS_SRC_AMGXKERNELS_HXX */
