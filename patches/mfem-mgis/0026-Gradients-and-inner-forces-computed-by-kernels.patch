+            v.Read(use_device), static_cast<std::size_t>(v.Size()));
+        return batch::addInnerForces(
+            ctx, f, *(this->quadrature_space),
+            mgis::makePointByPointFieldView(s, np, nc, nc), p->second, *k);
+      }
+      const auto& v = this->getArrays().getArray(
