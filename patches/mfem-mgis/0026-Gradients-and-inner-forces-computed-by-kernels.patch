diff --git a/src/Batch/InnerForces.cxx b/src/Batch/InnerForces.cxx
new file mode 100644
index 0000000000..0a082e633b
--- /dev/null
+++ b/src/Batch/InnerForces.cxx
@@ -0,0 +1,140 @@
+/*!
+ * \file   src/Batch/InnerForces.cxx
+ * \brief  This file implements the computation of the inner forces of the
+ * standard mechanical behaviour integrators by kernels (host part: checks
+ * and arguments of the kernels)
+ * \date   09/10/2026
+ */
+
+#include <limits>
+#include <string>
+#include <cstdint>
+#include <exception>
+#include "mfem/general/device.hpp"
+#include "mfem/fem/fespace.hpp"
+#include "mfem/mesh/mesh.hpp"
+#include "MFEMMGIS/PartialQuadratureSpace.hxx"
+#include "MFEMMGIS/Batch/InnerForces.hxx"
+#ifdef MFEM_MGIS_HAVE_DEVICE_SOURCES
+#include "InnerForcesKernels.hxx"
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+
+namespace mfem_mgis::batch {
+
+  bool computeElementsGeometry(Context& ctx,
+                               ElementsGeometry& g,
+                               const mfem::FiniteElementSpace& fes,
+                               const mfem::IntegrationRule& ir) noexcept {
+    try {
+      auto& mesh = *(fes.GetMesh());
+      if (mesh.GetNumGeometries(mesh.Dimension()) > 1) {
+        return ctx.registerErrorMessage(
+            "computeElementsGeometry: meshes mixing several geometries are "
+            "not supported");
+      }
+      if (mesh.SpaceDimension() != mesh.Dimension()) {
+        return ctx.registerErrorMessage(
+            "computeElementsGeometry: the dimension of the space must be the "
+            "dimension of the mesh");
+      }
+      g.rule = &ir;
+      g.dim = mesh.Dimension();
+      g.nq = ir.GetNPoints();
+      g.ne = fes.GetNE();
+      if (g.ne == 0) {
+        return true;
+      }
+      const auto* const fe = fes.GetTypicalFE();
+      g.maps = &(fe->GetDofToQuad(ir, mfem::DofToQuad::FULL));
+      g.nd = fe->GetDof();
+      g.factors = mesh.GetGeometricFactors(
+          ir, mfem::GeometricFactors::JACOBIANS |
+                  mfem::GeometricFactors::DETERMINANTS);
+      g.weights.UseDevice(true);
+      g.weights.SetSize(g.nq);
+      auto* const w = g.weights.HostWrite();
+      for (int q = 0; q != g.nq; ++q) {
+        w[q] = ir.IntPoint(q).weight;
+      }
+    } catch (std::exception& e) {
+      return ctx.registerErrorMessage(std::string{"computeElementsGeometry: "} +
+                                      e.what());
+    } catch (...) {
+      return ctx.registerErrorMessage(
+          "computeElementsGeometry: unknown exception");
+    }
+    return true;
+  }  // end of computeElementsGeometry
+
+  bool addInnerForces(Context& ctx,
+                      mfem::Vector& f,
+                      const PartialQuadratureSpace& qs,
+                      const mgis::FieldView<const real>& s,
+                      const ElementsGeometry& g,
+                      const GradientsKind k) noexcept {
+#ifndef MFEM_MGIS_HAVE_DEVICE_SOURCES
+    static_cast<void>(f);
+    static_cast<void>(qs);
+    static_cast<void>(s);
+    static_cast<void>(g);
+    static_cast<void>(k);
+    return ctx.registerErrorMessage(
+        "addInnerForces: the kernels computing the inner forces are not "
+        "compiled (MFEM compiled with HIP)");
+#else  /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+    const auto& elements = qs.getElements();
+    const auto& offsets = qs.getElementOffsets();
+    if (elements.Size() == 0) {
+      return true;
+    }
+    if ((g.rule == nullptr) || (qs.getUniformIntegrationRule() != g.rule)) {
+      return ctx.registerErrorMessage(
+          "addInnerForces: the elements of the material do not use the "
+          "integration rule of the geometric data");
+    }
+    const auto dim = getSpaceDimension(k);
+    if (g.dim != dim) {
+      return ctx.registerErrorMessage(
+          "addInnerForces: unexpected dimension of the space (" +
+          std::to_string(g.dim) + " instead of " + std::to_string(dim) + ")");
+    }
+    const auto size = std::int64_t{g.nd} * dim * g.ne;
+    if (static_cast<std::int64_t>(f.Size()) != size) {
+      return ctx.registerErrorMessage(
+          "addInnerForces: unexpected size of the values element by element");
+    }
+    if ((s.getNumberOfPoints() != qs.getNumberOfIntegrationPoints()) ||
+        (s.getNumberOfComponents() != getGradientsSize(k))) {
+      return ctx.registerErrorMessage(
+          "addInnerForces: unexpected number of points or of components of "
+          "the thermodynamic forces");
+    }
+    auto a = internals::InnerForcesKernelArguments{};
+    a.number_of_elements = elements.Size();
+    a.nd = g.nd;
+    a.nq = g.nq;
+    a.dim = g.dim;
+    a.thermodynamic_forces = s.data();
+    a.point_stride = static_cast<long long>(s.getPointStride());
+    a.component_stride = static_cast<long long>(s.getComponentStride());
+    try {
+      const auto use_device = mfem::Device::IsEnabled();
+      a.elements = elements.Read(use_device);
+      a.offsets = offsets.Read(use_device);
+      a.shape_functions_gradients = g.maps->G.Read(use_device);
+      a.jacobians = g.factors->J.Read(use_device);
+      a.determinants = g.factors->detJ.Read(use_device);
+      a.weights = g.weights.Read(use_device);
+      a.values = f.ReadWrite(use_device);
+      internals::launchInnerForcesKernel(k, a, use_device);
+    } catch (std::exception& e) {
+      return ctx.registerErrorMessage(std::string{"addInnerForces: "} +
+                                      e.what());
+    } catch (...) {
+      return ctx.registerErrorMessage("addInnerForces: unknown exception");
+    }
+    return true;
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+  }  // end of addInnerForces
+
+}  // end of namespace mfem_mgis::batch
diff --git a/src/Batch/InnerForcesKernels.cxx b/src/Batch/InnerForcesKernels.cxx
new file mode 100644
index 0000000000..0a4d32cd6a
--- /dev/null
+++ b/src/Batch/InnerForcesKernels.cxx
@@ -0,0 +1,155 @@
+/*!
+ * \file   src/Batch/InnerForcesKernels.cxx
+ * \brief  This file implements the kernels computing the inner forces of
+ * the standard mechanical behaviour integrators. It contains kernels of
+ * MFEM: it is compiled as CUDA code when MFEM is compiled with CUDA.
+ * \date   09/10/2026
+ */
+
+#include <cstddef>
+#include "mfem/general/forall.hpp"
+#include "InnerForcesKernels.hxx"
+
+namespace mfem_mgis::batch::internals {
+
+  /*!
+   * \brief computes the inverse of a jacobian
+   * \tparam N: dimension
+   * \param[out] iJ: inverse, `iJ[i + N * j]` being the component `(i, j)`
+   * \param[in] J: jacobian at the point of the element (`nq` points per
+   * element): `J[nq * (i + N * j)]` is the component `(i, j)`
+   * \param[in] nq: number of points per element
+   * \param[in] detJ: determinant of the jacobian
+   */
+  template <int N>
+  MFEM_HOST_DEVICE inline void invertJacobian(real* const iJ,
+                                              const real* const J,
+                                              const int nq,
+                                              const real detJ) {
+    auto j = [J, nq](const int r, const int c) { return J[nq * (r + N * c)]; };
+    if constexpr (N == 2) {
+      iJ[0] = j(1, 1) / detJ;
+      iJ[1] = -j(1, 0) / detJ;
+      iJ[2] = -j(0, 1) / detJ;
+      iJ[3] = j(0, 0) / detJ;
+    } else {
+      static_assert(N == 3);
+      iJ[0] = (j(1, 1) * j(2, 2) - j(1, 2) * j(2, 1)) / detJ;
+      iJ[1] = (j(1, 2) * j(2, 0) - j(1, 0) * j(2, 2)) / detJ;
+      iJ[2] = (j(1, 0) * j(2, 1) - j(1, 1) * j(2, 0)) / detJ;
+      iJ[3] = (j(0, 2) * j(2, 1) - j(0, 1) * j(2, 2)) / detJ;
+      iJ[4] = (j(0, 0) * j(2, 2) - j(0, 2) * j(2, 0)) / detJ;
+      iJ[5] = (j(0, 1) * j(2, 0) - j(0, 0) * j(2, 1)) / detJ;
+      iJ[6] = (j(0, 1) * j(1, 2) - j(0, 2) * j(1, 1)) / detJ;
+      iJ[7] = (j(0, 2) * j(1, 0) - j(0, 0) * j(1, 2)) / detJ;
+      iJ[8] = (j(0, 0) * j(1, 1) - j(0, 1) * j(1, 0)) / detJ;
+    }
+  }  // end of invertJacobian
+
+  /*!
+   * \brief adds the contribution of a point to the inner forces of a node,
+   * `w Bᵀ σ`, `B` being the operator of the gradients (see
+   * `computeGradientsAtPoint` in `GradientsKernels.cxx`)
+   * \tparam K: kind of the gradients
+   * \param[in, out] f: inner forces of the node
+   * \param[in] dN: derivatives of the shape function of the node
+   * \param[in] s: thermodynamic force (accessor)
+   * \param[in] w: weight of the point
+   */
+  template <GradientsKind K, typename Accessor>
+  MFEM_HOST_DEVICE inline void addInnerForces(real* const f,
+                                              const real* const dN,
+                                              const Accessor& s,
+                                              const real w) {
+    // 1/√2, as in the behaviour integrators generated by mfem-mgis
+    constexpr auto icste = real{0.70710678118654752440};
+    if constexpr (K == GradientsKind::SMALL_STRAIN_3D) {
+      f[0] += w * (dN[0] * s(0) + (dN[1] * s(3) + dN[2] * s(4)) * icste);
+      f[1] += w * (dN[1] * s(1) + (dN[0] * s(3) + dN[2] * s(5)) * icste);
+      f[2] += w * (dN[2] * s(2) + (dN[0] * s(4) + dN[1] * s(5)) * icste);
+    } else if constexpr (K == GradientsKind::SMALL_STRAIN_2D) {
+      f[0] += w * (dN[0] * s(0) + dN[1] * s(3) * icste);
+      f[1] += w * (dN[1] * s(1) + dN[0] * s(3) * icste);
+    } else if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
+      f[0] += w * (dN[0] * s(0) + dN[1] * s(3) + dN[2] * s(5));
+      f[1] += w * (dN[0] * s(4) + dN[1] * s(1) + dN[2] * s(7));
+      f[2] += w * (dN[0] * s(6) + dN[1] * s(8) + dN[2] * s(2));
+    } else {
+      static_assert(K == GradientsKind::DEFORMATION_GRADIENT_2D);
+      f[0] += w * (dN[0] * s(0) + dN[1] * s(3));
+      f[1] += w * (dN[0] * s(4) + dN[1] * s(1));
+    }
+  }  // end of addInnerForces
+
+  /*!
+   * \brief launches the kernel adding the inner forces of the elements of a
+   * material: one thread per node of an element
+   * \tparam K: kind of the gradients
+   * \tparam N: dimension
+   */
+  template <GradientsKind K, int N>
+  static void launchInnerForcesKernel(const InnerForcesKernelArguments& a,
+                                      const bool use_device) {
+    const auto n = a.number_of_elements * a.nd;
+    mfem::forall_switch(use_device, n, [a] MFEM_HOST_DEVICE(int i) {
+      const auto k = i / a.nd;
+      const auto node = i - k * a.nd;
+      const auto e = static_cast<std::size_t>(a.elements[k]);
+      const auto nq = static_cast<std::size_t>(a.nq);
+      const auto nd = static_cast<std::size_t>(a.nd);
+      real f[N] = {};
+      for (std::size_t q = 0; q != nq; ++q) {
+        const auto detJ = a.determinants[q + nq * e];
+        real iJ[N * N];
+        invertJacobian<N>(iJ, a.jacobians + q + nq * N * N * e,
+                          static_cast<int>(nq), detJ);
+        // derivatives of the shape function in the physical frame:
+        // dN/dx_j = sum_r dN/dxi_r (J^-1)_{rj}
+        real dN[N];
+        for (int c = 0; c != N; ++c) {
+          dN[c] = 0;
+          for (int r = 0; r != N; ++r) {
+            const auto g = a.shape_functions_gradients
+                               [q + nq * (static_cast<std::size_t>(r) +
+                                          N * static_cast<std::size_t>(node))];
+            dN[c] += g * iJ[r + N * c];
+          }
+        }
+        const auto o =
+            static_cast<long long>(a.offsets[k]) + static_cast<long long>(q);
+        const auto* const s0 = a.thermodynamic_forces + o * a.point_stride;
+        const auto cs = a.component_stride;
+        auto s = [s0, cs](const int c) { return s0[c * cs]; };
+        addInnerForces<K>(f, dN, s, a.weights[q] * detJ);
+      }
+      for (int c = 0; c != N; ++c) {
+        a.values[static_cast<std::size_t>(node) +
+                 nd * (static_cast<std::size_t>(c) + N * e)] += f[c];
+      }
+    });
+  }  // end of launchInnerForcesKernel
+
+  void launchInnerForcesKernel(const GradientsKind k,
+                               const InnerForcesKernelArguments& a,
+                               const bool use_device) {
+    switch (k) {
+      case GradientsKind::SMALL_STRAIN_3D:
+        launchInnerForcesKernel<GradientsKind::SMALL_STRAIN_3D, 3>(a,
+                                                                   use_device);
+        break;
+      case GradientsKind::SMALL_STRAIN_2D:
+        launchInnerForcesKernel<GradientsKind::SMALL_STRAIN_2D, 2>(a,
+                                                                   use_device);
+        break;
+      case GradientsKind::DEFORMATION_GRADIENT_3D:
+        launchInnerForcesKernel<GradientsKind::DEFORMATION_GRADIENT_3D, 3>(
+            a, use_device);
+        break;
+      case GradientsKind::DEFORMATION_GRADIENT_2D:
+        launchInnerForcesKernel<GradientsKind::DEFORMATION_GRADIENT_2D, 2>(
+            a, use_device);
+        break;
+    }
+  }  // end of launchInnerForcesKernel
+
+}  // end of namespace mfem_mgis::batch::internals
diff --git a/src/Batch/InnerForcesKernels.hxx b/src/Batch/InnerForcesKernels.hxx
new file mode 100644
index 0000000000..95cf185d90
--- /dev/null
+++ b/src/Batch/InnerForcesKernels.hxx
@@ -0,0 +1,65 @@
+/*!
+ * \file   src/Batch/InnerForcesKernels.hxx
+ * \brief  This file declares the kernels computing the inner forces of the
+ * standard mechanical behaviour integrators (internal header)
+ * \date   09/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_SRC_BATCH_INNERFORCESKERNELS_HXX
+#define LIB_MFEM_MGIS_SRC_BATCH_INNERFORCESKERNELS_HXX
+
+#include "MFEMMGIS/Config.hxx"
+#include "MFEMMGIS/Batch/Gradients.hxx"
+
+namespace mfem_mgis::batch::internals {
+
+  //! \brief arguments of the kernels computing the inner forces
+  struct InnerForcesKernelArguments {
+    //! \brief elements of the material
+    const int* elements = nullptr;
+    //! \brief offsets of the integration points of the elements
+    const int* offsets = nullptr;
+    /*!
+     * \brief gradients of the shape functions on the reference element
+     * (`nq x dim x nd`)
+     */
+    const real* shape_functions_gradients = nullptr;
+    //! \brief jacobians of the element transformations (`nq x dim x dim x ne`)
+    const real* jacobians = nullptr;
+    //! \brief determinants of the jacobians (`nq x ne`)
+    const real* determinants = nullptr;
+    //! \brief weights of the integration points on the reference element
+    const real* weights = nullptr;
+    //! \brief thermodynamic forces
+    const real* thermodynamic_forces = nullptr;
+    //! \brief stride between two points of the thermodynamic forces
+    long long point_stride = 0;
+    //! \brief stride between two components of the thermodynamic forces
+    long long component_stride = 0;
+    //! \brief values element by element (`nd x vdim x ne`)
+    real* values = nullptr;
+    //! \brief number of elements of the material
+    int number_of_elements = 0;
+    //! \brief number of degrees of freedom per element and per component
+    int nd = 0;
+    //! \brief number of integration points per element
+    int nq = 0;
+    //! \brief dimension of the space (and number of components)
+    int dim = 0;
+  };
+
+  /*!
+   * \brief launches the kernel adding the inner forces of the elements of
+   * a material
+   * \param[in] k: kind of the gradients
+   * \param[in] a: arguments
+   * \param[in] d: if true, the kernel runs on the device (if a device is
+   * enabled), and the pointers of the arguments are located on the device
+   */
+  void launchInnerForcesKernel(const GradientsKind,
+                               const InnerForcesKernelArguments&,
+                               const bool);
+
+}  // end of namespace mfem_mgis::batch::internals
+
+#endif /* LIB_MFEM_MGIS_SRC_BATCH_INNERFORCESKERNELS_HXX */
