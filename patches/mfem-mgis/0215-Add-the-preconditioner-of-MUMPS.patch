           "MUMPSSolver, BLR: resolution");
   }
+  // the exact factorization of MUMPS as a preconditioner of the conjugate
+  // gradient of MFEM, which then converges in one iteration, and its block
+  // low-rank factorization
+  for (const auto tolerance : {0., 1e-2}) {
+    auto cg = generate(
+        s, "CGSolver",
+        Parameters{{"RelativeTolerance", 1e-12},
+                   {"AbsoluteTolerance", 0.},
+                   {"MaximumNumberOfIterations", 200},
+                   {"Preconditioner",
+                    Parameters{{"Name", "MUMPSPreconditioner"},
+                               {"Options",
+                                Parameters{{"BLRTolerance", tolerance},
+                                           {"VerbosityLevel", 0}}}}}});
+    const auto name = std::string{"CGSolver, MUMPSPreconditioner, BLR "} +
+                      std::to_string(tolerance);
+    check((solve(s, *(cg.linear_solver), name) < 1e-10) &&
+              hasConverged(*(cg.linear_solver)) &&
+              ((tolerance > 0) ||
+               (getNumberOfIterationsAtConvergence(*(cg.linear_solver))
+                    .value_or(10) <= 1)),
+          name + ": resolution");
+  }
   check(getGenerationError(s, "MUMPSSolver",
                            Parameters{{"ReorderingStrategy", "RCM"}})
                 .find("invalid reordering strategy") != std::string::npos,
