+                                            {"Inverse Type", "CG"}}},
+                      {"CG", Parameters{{"Type", "Belos"},
+                                        {"Use Preconditioner", "Amesos2"}}}}}},
+      "is not a preconditioner");
+#else  /* MFEM_MGIS_HAVE_TEKO */
+  const auto e =
