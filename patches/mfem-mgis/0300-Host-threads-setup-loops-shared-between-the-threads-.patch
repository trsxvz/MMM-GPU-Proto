+  find_package(OpenMP REQUIRED COMPONENTS CXX)
+  set(MFEM_MGIS_HAVE_OPENMP ON)
+endif(enable-openmp)
+message(STATUS "mfem-mgis OpenMP: ${MFEM_MGIS_HAVE_OPENMP}")
+
