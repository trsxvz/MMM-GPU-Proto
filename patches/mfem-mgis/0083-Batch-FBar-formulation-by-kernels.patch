+/*!
+ * \file   src/Batch/FBarKernels.cxx
+ * \brief  This file implements the kernels of the FBar formulation. It
+ * contains kernels of MFEM: it is compiled as CUDA code when MFEM is
+ * compiled with CUDA.
+ * \date   11/10/2026
+ */
+
+#include <cmath>
+#include <cstddef>
+#include "mfem/general/forall.hpp"
+#include "KernelsUtilities.hxx"
+#include "FBarKernels.hxx"
+
+namespace mfem_mgis::batch::internals {
+
+  /*!
+   * \return the determinant of a deformation gradient, in the order of the
+   * gradients of the behaviours (`F11, F22, F33, F12, F21, F13, F31, F23,
+   * F32` in 3D, `F11, F22, F33, F12, F21` in 2D)
+   * \tparam K: kind of the gradients
+   * \param[in] F: deformation gradient
+   */
+  template <GradientsKind K>
+  MFEM_HOST_DEVICE inline real computeDeterminant(const real* const F) {
+    if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
+      return F[0] * (F[1] * F[2] - F[7] * F[8]) -
+             F[3] * (F[4] * F[2] - F[7] * F[6]) +
+             F[5] * (F[4] * F[8] - F[1] * F[6]);
+    } else {
+      static_assert(K == GradientsKind::DEFORMATION_GRADIENT_2D);
+      return F[2] * (F[0] * F[1] - F[3] * F[4]);
+    }
+  }  // end of computeDeterminant
+
+  /*!
+   * \brief computes the derivative of the determinant of a deformation
+   * gradient with respect to its components (cofactors), in the order of
+   * the gradients
+   * \tparam K: kind of the gradients
+   * \param[out] dJ: derivative
+   * \param[in] F: deformation gradient
+   */
+  template <GradientsKind K>
+  MFEM_HOST_DEVICE inline void computeDeterminantDerivative(
+      real* const dJ, const real* const F) {
+    if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
+      // F11 F22 F33 F12 F21 F13 F31 F23 F32
+      // 0   1   2   3   4   5   6   7   8
+      dJ[0] = F[1] * F[2] - F[7] * F[8];
+      dJ[1] = F[0] * F[2] - F[5] * F[6];
+      dJ[2] = F[0] * F[1] - F[3] * F[4];
+      dJ[3] = F[7] * F[6] - F[4] * F[2];
+      dJ[4] = F[5] * F[8] - F[3] * F[2];
+      dJ[5] = F[4] * F[8] - F[1] * F[6];
+      dJ[6] = F[3] * F[7] - F[5] * F[1];
+      dJ[7] = F[3] * F[6] - F[0] * F[8];
+      dJ[8] = F[5] * F[4] - F[0] * F[7];
+    } else {
+      static_assert(K == GradientsKind::DEFORMATION_GRADIENT_2D);
+      dJ[0] = F[1] * F[2];
+      dJ[1] = F[0] * F[2];
+      dJ[2] = F[0] * F[1] - F[3] * F[4];
+      dJ[3] = -F[4] * F[2];
+      dJ[4] = -F[3] * F[2];
+    }
+  }  // end of computeDeterminantDerivative
+
+  //! \return the inverse of the exponent of the FBar formulation
+  template <GradientsKind K>
+  MFEM_HOST_DEVICE constexpr int getFBarExponentInverse() {
+    return K == GradientsKind::DEFORMATION_GRADIENT_3D ? 3 : 2;
+  }  // end of getFBarExponentInverse
+
+  /*!
+   * \return `(J0 / J)^(1/ie)`
+   * \tparam K: kind of the gradients
+   */
+  template <GradientsKind K>
+  MFEM_HOST_DEVICE inline real computeFBarCoefficient(const real J0,
+                                                      const real J) {
+    if constexpr (getFBarExponentInverse<K>() == 3) {
+      return cbrt(J0 / J);
+    } else {
+      return sqrt(J0 / J);
+    }
+  }  // end of computeFBarCoefficient
+
+  template <GradientsKind K>
+  static void launchFBarCentersKernel(const FBarCentersKernelArguments& a,
+                                      const bool use_device) {
+    mfem::forall_switch(
+        use_device, a.number_of_elements, [a] MFEM_HOST_DEVICE(int k) {
+          constexpr auto N = getDimension<K>();
+          constexpr auto V = getUnknownsSize<K>();
+          constexpr auto gs = getGradientsSize<K>();
+          const auto e = static_cast<std::size_t>(a.elements[k]);
+          // inverse of the jacobian at the center (one point per element)
+          real iJ[N * N];
+          invertJacobian<N>(iJ,
+                            a.jacobians + static_cast<std::size_t>(N * N) * e,
+                            1, a.determinants[e]);
+          // deformation gradient at the center
+          real F0[9];
+          for (int c = 0; c != gs; ++c) {
+            F0[c] = a.macroscopic_gradients[c];
+          }
+          if (a.derivatives != nullptr) {
+            const auto* const dr =
+                a.derivatives + static_cast<std::size_t>(V * N) * e;
+            real du[V * N];
+            for (int i = 0; i != V; ++i) {
+              for (int j = 0; j != N; ++j) {
+                du[i + V * j] = 0;
+                for (int r = 0; r != N; ++r) {
+                  du[i + V * j] += dr[i + V * r] * iJ[r + N * j];
+                }
+              }
+            }
+            auto d = [&du](const int i, const int j) { return du[i + V * j]; };
+            if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_3D) {
+              F0[0] += d(0, 0);
+              F0[1] += d(1, 1);
+              F0[2] += d(2, 2);
+              F0[3] += d(0, 1);
+              F0[4] += d(1, 0);
+              F0[5] += d(0, 2);
+              F0[6] += d(2, 0);
+              F0[7] += d(1, 2);
+              F0[8] += d(2, 1);
+            } else {
+              F0[0] += d(0, 0);
+              F0[1] += d(1, 1);
+              F0[3] += d(0, 1);
+              F0[4] += d(1, 0);
+            }
+          }
+          real dJ0[9];
+          computeDeterminantDerivative<K>(dJ0, F0);
+          auto* const c = a.centers + static_cast<std::size_t>(1 + gs) * k;
+          c[0] = computeDeterminant<K>(F0);
+          for (int i = 0; i != gs; ++i) {
+            c[1 + i] = dJ0[i];
+          }
+          // derivative of J0 with respect to the unknowns of the element
+          const auto nd = static_cast<std::size_t>(a.nd);
+          auto* const b = a.b + nd * V * e;
+          for (std::size_t node = 0; node != nd; ++node) {
+            real dN[N];
+            computePhysicalDerivatives<N>(dN, a.shape_functions_gradients, 0, 1,
+                                          node, iJ);
+            real B[9][3];
+            computeB<K>(B, dN, real{0});
+            for (int comp = 0; comp != V; ++comp) {
+              real v = 0;
+              for (int i = 0; i != gs; ++i) {
+                v += dJ0[i] * B[i][comp];
+              }
+              b[node + nd * comp] = v;
+            }
+          }
+        });
+  }  // end of launchFBarCentersKernel
+
+  template <GradientsKind K>
+  static void launchFBarGradientsKernel(const FBarGradientsKernelArguments& a,
+                                        const bool use_device) {
+    const auto n = a.number_of_elements * a.nq;
+    mfem::forall_switch(use_device, n, [a] MFEM_HOST_DEVICE(int i) {
+      constexpr auto gs = getGradientsSize<K>();
+      const auto k = i / a.nq;
+      const auto q = i - k * a.nq;
+      const auto o = static_cast<std::size_t>(a.offsets[k] + q);
+      const auto np = static_cast<std::size_t>(a.number_of_points);
+      const auto sgs = static_cast<std::size_t>(gs);
+      // deformation gradient at the point
+      real F[9];
+      for (std::size_t c = 0; c != sgs; ++c) {
+        if (a.gradients == nullptr) {
+          F[c] = a.macroscopic_gradients[c];
+        } else {
+          F[c] = a.point_by_point ? a.gradients[o * sgs + c]
+                                  : a.gradients[c * np + o];
+        }
+      }
+      const auto J0 = a.centers[static_cast<std::size_t>(1 + gs) * k];
+      const auto alpha =
+          computeFBarCoefficient<K>(J0, computeDeterminant<K>(F));
+      a.coefficients[o] = alpha;
+      for (std::size_t c = 0; c != sgs; ++c) {
+        a.deformation_gradients[o * sgs + c] = F[c];
+      }
+      if (a.gradients != nullptr) {
+        for (std::size_t c = 0; c != sgs; ++c) {
+          // in plane strain, the third component of F̄ is one
+          const auto v =
+              ((K == GradientsKind::DEFORMATION_GRADIENT_2D) && (c == 2))
+                  ? real{1}
+                  : alpha * F[c];
+          if (a.point_by_point) {
+            a.gradients[o * sgs + c] = v;
+          } else {
+            a.gradients[c * np + o] = v;
+          }
+        }
+      }
+    });
+  }  // end of launchFBarGradientsKernel
+
+  template <GradientsKind K>
+  static void launchFBarTangentOperatorKernel(
+      const FBarTangentOperatorKernelArguments& a, const bool use_device) {
+    const auto n = a.number_of_elements * a.nq;
+    mfem::forall_switch(use_device, n, [a] MFEM_HOST_DEVICE(int i) {
+      constexpr auto gs = getGradientsSize<K>();
+      constexpr auto ie = getFBarExponentInverse<K>();
+      const auto k = i / a.nq;
+      const auto q = i - k * a.nq;
+      const auto o = static_cast<std::size_t>(a.offsets[k] + q);
+      const auto sgs = static_cast<std::size_t>(gs);
+      const auto* const F = a.deformation_gradients + o * sgs;
+      const auto alpha = a.coefficients[o];
+      const auto J = computeDeterminant<K>(F);
+      const auto J0 = a.centers[static_cast<std::size_t>(1 + gs) * k];
+      // dα/dF; in plane strain, the third component is ignored
+      real c[9];
+      computeDeterminantDerivative<K>(c, F);
+      for (int j = 0; j != gs; ++j) {
+        c[j] *= -alpha / (ie * J);
+      }
+      if constexpr (K == GradientsKind::DEFORMATION_GRADIENT_2D) {
+        c[2] = 0;
+      }
+      // v = K F
+      const auto* const Kb =
+          a.tangent_operator + static_cast<long long>(o) * a.point_stride;
+      auto Kv = [Kb, &a](const int r, const int col) {
+        return Kb[static_cast<long long>(r * gs + col) * a.component_stride];
+      };
+      real v[9];
+      for (int r = 0; r != gs; ++r) {
+        v[r] = 0;
+        for (int col = 0; col != gs; ++col) {
+          if ((K == GradientsKind::DEFORMATION_GRADIENT_2D) && (col == 2)) {
+            continue;
+          }
+          v[r] += Kv(r, col) * F[col];
+        }
+      }
+      auto* const Km = a.modified_tangent_operator + o * sgs * sgs;
+      for (int r = 0; r != gs; ++r) {
+        for (int col = 0; col != gs; ++col) {
+          Km[r * gs + col] = alpha * Kv(r, col) + v[r] * c[col];
+        }
+      }
+      auto* const s = a.pseudo_stresses + o * sgs;
+      for (int r = 0; r != gs; ++r) {
+        s[r] = alpha / (ie * J0) * v[r];
+      }
+    });
+  }  // end of launchFBarTangentOperatorKernel
+
+  void launchFBarCentersKernel(const GradientsKind k,
+                               const FBarCentersKernelArguments& a,
+                               const bool use_device) {
+    if (k == GradientsKind::DEFORMATION_GRADIENT_3D) {
+      launchFBarCentersKernel<GradientsKind::DEFORMATION_GRADIENT_3D>(
+          a, use_device);
+    } else {
+      launchFBarCentersKernel<GradientsKind::DEFORMATION_GRADIENT_2D>(
+          a, use_device);
+    }
+  }  // end of launchFBarCentersKernel
+
+  void launchFBarGradientsKernel(const GradientsKind k,
+                                 const FBarGradientsKernelArguments& a,
+                                 const bool use_device) {
+    if (k == GradientsKind::DEFORMATION_GRADIENT_3D) {
+      launchFBarGradientsKernel<GradientsKind::DEFORMATION_GRADIENT_3D>(
+          a, use_device);
+    } else {
+      launchFBarGradientsKernel<GradientsKind::DEFORMATION_GRADIENT_2D>(
+          a, use_device);
+    }
+  }  // end of launchFBarGradientsKernel
+
+  void launchFBarTangentOperatorKernel(
+      const GradientsKind k,
+      const FBarTangentOperatorKernelArguments& a,
+      const bool use_device) {
+    if (k == GradientsKind::DEFORMATION_GRADIENT_3D) {
+      launchFBarTangentOperatorKernel<GradientsKind::DEFORMATION_GRADIENT_3D>(
+          a, use_device);
+    } else {
+      launchFBarTangentOperatorKernel<GradientsKind::DEFORMATION_GRADIENT_2D>(
+          a, use_device);
+    }
+  }  // end of launchFBarTangentOperatorKernel
+
+  void launchFBarRankOneMatricesKernel(const FBarRankOneKernelArguments& a,
+                                       real* const m,
+                                       const bool use_device) {
+    const auto n = a.number_of_elements * a.n * a.n;
+    mfem::forall_switch(use_device, n, [a, m] MFEM_HOST_DEVICE(int t) {
+      const auto nn = a.n * a.n;
+      const auto k = t / nn;
+      const auto r = t - k * nn;
+      // row i (first index of `a`), column j, stored column by column
+      const auto j = r / a.n;
+      const auto i = r - j * a.n;
+      const auto e = static_cast<std::size_t>(a.elements[k]);
+      const auto sn = static_cast<std::size_t>(a.n);
+      m[sn * sn * e + static_cast<std::size_t>(i) +
+        sn * static_cast<std::size_t>(j)] +=
+          a.a[sn * e + static_cast<std::size_t>(i)] *
+          a.b[sn * e + static_cast<std::size_t>(j)];
+    });
+  }  // end of launchFBarRankOneMatricesKernel
+
+  void launchFBarRankOneMatricesKernel(const FBarRankOneKernelArguments& a,
+                                       const SparseMatrixOutput& o,
+                                       const bool use_device) {
+    const auto n = a.number_of_elements * a.n;
+    mfem::forall_switch(use_device, n, [a, o] MFEM_HOST_DEVICE(int t) {
+      const auto k = t / a.n;
+      const auto i = t - k * a.n;
+      const auto e = static_cast<std::size_t>(a.elements[k]);
+      const auto sn = static_cast<std::size_t>(a.n);
+      const auto* const dofs = o.element_dofs + sn * e;
+      const auto row = dofs[i];
+      if ((row < 0) || (row >= o.number_of_rows)) {
+        ::AtomicAdd(o.missing[0], a.n);
+        return;
+      }
+      const auto ai = a.a[sn * e + static_cast<std::size_t>(i)];
+      const auto end = o.I[row + 1];
+      for (int j = 0; j != a.n; ++j) {
+        const auto p = findColumn(o.J, o.I[row], end, dofs[j]);
+        if (p == end) {
+          ::AtomicAdd(o.missing[0], 1);
+        } else {
+          ::AtomicAdd(o.values[p],
+                      ai * a.b[sn * e + static_cast<std::size_t>(j)]);
+        }
+      }
+    });
+  }  // end of launchFBarRankOneMatricesKernel
+
+  void launchFBarRankOneDiagonalsKernel(const FBarRankOneKernelArguments& a,
+                                        real* const d,
+                                        const bool use_device) {
+    const auto n = a.number_of_elements * a.n;
+    mfem::forall_switch(use_device, n, [a, d] MFEM_HOST_DEVICE(int t) {
+      const auto k = t / a.n;
+      const auto i = t - k * a.n;
+      const auto p = static_cast<std::size_t>(a.n) *
+                         static_cast<std::size_t>(a.elements[k]) +
+                     static_cast<std::size_t>(i);
+      d[p] += a.a[p] * a.b[p];
+    });
+  }  // end of launchFBarRankOneDiagonalsKernel
+
+  void launchFBarRankOneActionKernel(const FBarRankOneKernelArguments& a,
+                                     const real* const x,
+                                     real* const y,
+                                     const bool use_device) {
+    mfem::forall_switch(
+        use_device, a.number_of_elements, [a, x, y] MFEM_HOST_DEVICE(int k) {
+          const auto sn = static_cast<std::size_t>(a.n);
+          const auto e = static_cast<std::size_t>(a.elements[k]);
+          real bx = 0;
+          for (std::size_t j = 0; j != sn; ++j) {
+            bx += a.b[sn * e + j] * x[sn * e + j];
+          }
+          for (std::size_t i = 0; i != sn; ++i) {
+            y[sn * e + i] += a.a[sn * e + i] * bx;
+          }
+        });
+  }  // end of launchFBarRankOneActionKernel
+
+}  // end of namespace mfem_mgis::batch::internals
diff --git a/src/Batch/FBarKernels.hxx b/src/Batch/FBarKernels.hxx
new file mode 100644
index 0000000000..2fa2247438
--- /dev/null
+++ b/src/Batch/FBarKernels.hxx
@@ -0,0 +1,213 @@
+/*!
+ * \file   src/Batch/FBarKernels.hxx
+ * \brief  This file declares the kernels of the FBar formulation (internal
+ * header, see `MFEMMGIS/Batch/FBar.hxx`)
+ * \date   11/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_SRC_BATCH_FBARKERNELS_HXX
+#define LIB_MFEM_MGIS_SRC_BATCH_FBARKERNELS_HXX
+
+#include "MFEMMGIS/Config.hxx"
+#include "MFEMMGIS/Batch/Gradients.hxx"
+#include "StiffnessMatricesKernels.hxx"
+
+namespace mfem_mgis::batch::internals {
+
+  /*!
+   * \brief arguments of the kernel computing the data of the FBar
+   * formulation at the center of the elements of a material
+   */
+  struct FBarCentersKernelArguments {
+    //! \brief elements of the material
+    const int* elements = nullptr;
+    /*!
+     * \brief derivatives of the unknowns at the center of all the elements
+     * of the mesh (see `UnknownsDerivatives`), null for null unknowns
+     */
+    const real* derivatives = nullptr;
+    //! \brief jacobians at the center of all the elements of the mesh
+    const real* jacobians = nullptr;
+    //! \brief determinants of the jacobians at the center of the elements
+    const real* determinants = nullptr;
+    /*!
+     * \brief gradients of the shape functions at the center of the
+     * reference element (`dim x nd`)
+     */
+    const real* shape_functions_gradients = nullptr;
+    /*!
+     * \brief determinant `J0` and its derivative at the center of the
+     * elements of the material (`1 + gradients size` values per element)
+     */
+    real* centers = nullptr;
+    /*!
+     * \brief vectors `b` of all the elements of the mesh (layout of the
+     * element restriction of MFEM)
+     */
+    real* b = nullptr;
+    //! \brief number of elements of the material
+    int number_of_elements = 0;
+    //! \brief number of degrees of freedom per element and per component
+    int nd = 0;
+    //! \brief macroscopic gradients
+    real macroscopic_gradients[9] = {};
+  };
+
+  /*!
+   * \brief arguments of the kernel computing the coefficients `α` and the
+   * gradients `F̄` at the integration points of a material
+   */
+  struct FBarGradientsKernelArguments {
+    //! \brief elements of the material
+    const int* elements = nullptr;
+    //! \brief offsets of the integration points of the elements
+    const int* offsets = nullptr;
+    //! \brief data at the center of the elements of the material
+    const real* centers = nullptr;
+    /*!
+     * \brief gradients of the material (deformation gradients computed by
+     * the kernel of the gradients, replaced by `F̄`), null for null unknowns
+     */
+    real* gradients = nullptr;
+    //! \brief deformation gradients `F`, point by point
+    real* deformation_gradients = nullptr;
+    //! \brief coefficients `α`
+    real* coefficients = nullptr;
+    //! \brief number of elements of the material
+    int number_of_elements = 0;
+    //! \brief number of integration points per element
+    int nq = 0;
+    //! \brief number of integration points of the material
+    int number_of_points = 0;
+    //! \brief layout of the gradients: true if stored point by point
+    bool point_by_point = true;
+    //! \brief macroscopic gradients (for null unknowns)
+    real macroscopic_gradients[9] = {};
+  };
+
+  /*!
+   * \brief arguments of the kernel computing the tangent operator `K'` and
+   * the pseudo-stresses `α / (ie J0) K F` at the integration points of a
+   * material
+   */
+  struct FBarTangentOperatorKernelArguments {
+    //! \brief elements of the material
+    const int* elements = nullptr;
+    //! \brief offsets of the integration points of the elements
+    const int* offsets = nullptr;
+    //! \brief data at the center of the elements of the material
+    const real* centers = nullptr;
+    //! \brief deformation gradients `F`, point by point
+    const real* deformation_gradients = nullptr;
+    //! \brief coefficients `α`
+    const real* coefficients = nullptr;
+    //! \brief tangent operator blocks of the behaviour
+    const real* tangent_operator = nullptr;
+    //! \brief stride between two points of the tangent operator blocks
+    long long point_stride = 0;
+    //! \brief stride between two components of the tangent operator blocks
+    long long component_stride = 0;
+    //! \brief tangent operator `K'`, point by point
+    real* modified_tangent_operator = nullptr;
+    //! \brief pseudo-stresses, point by point
+    real* pseudo_stresses = nullptr;
+    //! \brief number of elements of the material
+    int number_of_elements = 0;
+    //! \brief number of integration points per element
+    int nq = 0;
+  };
+
+  /*!
+   * \brief arguments of the kernels adding the matrices of rank one `a ⊗ b`
+   * of the elements of a material
+   */
+  struct FBarRankOneKernelArguments {
+    //! \brief elements of the material
+    const int* elements = nullptr;
+    //! \brief vectors `a` (layout of the element restriction)
+    const real* a = nullptr;
+    //! \brief vectors `b` (layout of the element restriction)
+    const real* b = nullptr;
+    //! \brief number of elements of the material
+    int number_of_elements = 0;
+    //! \brief number of degrees of freedom of an element
+    int n = 0;
+  };
+
+  /*!
+   * \brief launches the kernel computing the data of the FBar formulation
+   * at the center of the elements of a material: one thread per element
+   * \param[in] k: kind of the gradients
+   * \param[in] a: arguments
+   * \param[in] d: if true, the kernel runs on the device
+   */
+  void launchFBarCentersKernel(const GradientsKind,
+                               const FBarCentersKernelArguments&,
+                               const bool);
+  /*!
+   * \brief launches the kernel computing the coefficients `α` and the
+   * gradients `F̄`: one thread per integration point
+   * \param[in] k: kind of the gradients
+   * \param[in] a: arguments
+   * \param[in] d: if true, the kernel runs on the device
+   */
+  void launchFBarGradientsKernel(const GradientsKind,
+                                 const FBarGradientsKernelArguments&,
+                                 const bool);
+  /*!
+   * \brief launches the kernel computing the tangent operator `K'` and the
+   * pseudo-stresses: one thread per integration point
+   * \param[in] k: kind of the gradients
+   * \param[in] a: arguments
+   * \param[in] d: if true, the kernel runs on the device
+   */
+  void launchFBarTangentOperatorKernel(
+      const GradientsKind,
+      const FBarTangentOperatorKernelArguments&,
+      const bool);
+  /*!
+   * \brief adds the matrices `a ⊗ b` to matrices stored element by element,
+   * column by column (see `addStiffnessMatrices`): one thread per entry
+   * \param[in] a: arguments
+   * \param[in, out] m: matrices of all the elements of the mesh
+   * \param[in] d: if true, the kernel runs on the device
+   */
+  void launchFBarRankOneMatricesKernel(const FBarRankOneKernelArguments&,
+                                       real* const,
+                                       const bool);
+  /*!
+   * \brief adds the matrices `a ⊗ b` to an assembled sparse matrix: one
+   * thread per row of an element
+   * \param[in] a: arguments
+   * \param[in] o: assembled matrix
+   * \param[in] d: if true, the kernel runs on the device
+   */
+  void launchFBarRankOneMatricesKernel(const FBarRankOneKernelArguments&,
+                                       const SparseMatrixOutput&,
+                                       const bool);
+  /*!
+   * \brief adds the diagonals of the matrices `a ⊗ b`: one thread per
+   * degree of freedom of an element
+   * \param[in] a: arguments
+   * \param[in, out] diagonals: values element by element
+   * \param[in] d: if true, the kernel runs on the device
+   */
+  void launchFBarRankOneDiagonalsKernel(const FBarRankOneKernelArguments&,
+                                        real* const,
+                                        const bool);
+  /*!
+   * \brief adds the action of the matrices `a ⊗ b`, `a (b · x)`: one thread
+   * per element
+   * \param[in] a: arguments
+   * \param[in] x: values element by element
+   * \param[in, out] y: action element by element
+   * \param[in] d: if true, the kernel runs on the device
+   */
+  void launchFBarRankOneActionKernel(const FBarRankOneKernelArguments&,
+                                     const real* const,
+                                     real* const,
+                                     const bool);
+
+}  // end of namespace mfem_mgis::batch::internals
+
+#endif /* LIB_MFEM_MGIS_SRC_BATCH_FBARKERNELS_HXX */
diff --git a/src/Batch/KernelsUtilities.hxx b/src/Batch/KernelsUtilities.hxx
index 723340f721..a28816329d 100644
--- a/src/Batch/KernelsUtilities.hxx
+++ b/src/Batch/KernelsUtilities.hxx
@@ -306,6 +306,49 @@ namespace mfem_mgis::batch::internals {
     }
   }  // end of getShapeFunctionValue
 
+  /*!
+   * \return the position of a column in a row of a sparse matrix, or `end`
+   * if the column is not in the row. The first column is tested first, then
+   * the other columns are searched by bisection, which is exact for sorted
+   * rows and for rows whose first column is the diagonal one, the others
+   * being sorted (see `makeAssembledStiffnessMatrix`). Otherwise, the row is
+   * searched linearly.
+   * \param[in] J: columns of the matrix
+   * \param[in] begin: position of the first column of the row
+   * \param[in] end: position after the last column of the row
+   * \param[in] c: column
+   */
+  MFEM_HOST_DEVICE inline int findColumn(const int* const J,
+                                         const int begin,
+                                         const int end,
+                                         const int c) {
+    if (begin == end) {
+      return end;
+    }
+    if (J[begin] == c) {
+      return begin;
+    }
+    auto lo = begin + 1;
+    auto hi = end;
+    while (lo != hi) {
+      const auto mid = lo + (hi - lo) / 2;
+      if (J[mid] < c) {
+        lo = mid + 1;
+      } else {
+        hi = mid;
+      }
+    }
+    if ((lo != end) && (J[lo] == c)) {
+      return lo;
+    }
+    for (auto p = begin + 1; p != end; ++p) {
+      if (J[p] == c) {
+        return p;
+      }
+    }
+    return end;
+  }  // end of findColumn
+
 }  // end of namespace mfem_mgis::batch::internals
 
 #endif /* LIB_MFEM_MGIS_SRC_BATCH_KERNELSUTILITIES_HXX */
