 src/TrilinosLinearSolvers.cxx             | 70 ++++++++++++++++-------
 src/TrilinosTpetraBackend.hxx             | 50 ++++++++--------
 tests/TrilinosSolversTest.cxx             | 11 ++++
 4 files changed, 124 insertions(+), 70 deletions(-)

