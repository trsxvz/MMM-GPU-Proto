+    if (is<Parameters>(*op)) {
+      const auto oparams = get<Parameters>(ctx, *op);
+      if (isInvalid(oparams)) {
+        return {};
+      }
+      if (!contains(*oparams, "Name")) {
+        return extractFactoryArgument(ctx, *oparams);
