+      const auto oopts =
+          get_if<Parameters>(ctx, *oparams, "Options", Parameters{});
+      if (isInvalid(oname) || isInvalid(oopts)) {
+        return {};
+      }
+      return std::pair<std::string, Parameters>{*oname, *oopts};
+    }
