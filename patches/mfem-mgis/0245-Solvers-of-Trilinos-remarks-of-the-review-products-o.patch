From 87dcb8b123cf751a9deba4d8c8a2cab63f0a9a56 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 16 Oct 2026 05:27:28 +0200
Subject: [PATCH] Solvers of Trilinos: remarks of the review, products of
 sparse matrices

- FROSch: an empty list of the rows of the Dirichlet boundary conditions
  is given (FROSch built its own list otherwise, with the tolerance which
  made it hang), its tolerance is refused; FROSch is refused, on all the
  processes, when a process owns no unknown (it crashed); its setup is
  silent by default;
- MueLu: the products of sparse matrices of Kokkos Kernels on CUDA
  (SPGEMM_KK; those of cuSPARSE ran out of memory on a GPU of 16 GB at
  421,443 unknowns of linear elasticity); the coordinates are given only
  when the nodes of MueLu are the nodes of the mesh;
- the names of the parameters of Ifpack2 and MueLu are checked when the
  solver is created (a misspelt parameter is refused);
- the matrices must be square, with the same distribution of rows and
  columns (checked by all the processes);
- the hybrid GMRES of Belos does not receive Num Blocks and Maximum
  Restarts; the multivectors must have a constant stride;
- CMake: Trilinos must be built with the Kokkos found by mfem-mgis;
- tests: three processes with an empty process in the middle, Ifpack2 and
  FROSch with an empty process, rigid body modes of MueLu for both
  orderings, FROSch compared to the Jacobi relaxation, misspelt
  parameters refused, lock of the GPU (Trilinos built with CUDA computes
  on the GPU);
- documentation: smoother of MueLu on a GPU (Jacobi relaxation instead of
  the symmetric Gauss-Seidel: resolution 50 times faster on the beam of
  421,443 unknowns).
---
 CMakeLists.txt                            |  18 +++
 docs/source/user_guide/linear_solvers.rst |  44 ++++++--
 src/TrilinosBackend.cxx                   | 131 +++++++++++++++++++---
 src/TrilinosLinearSolvers.cxx             |  21 +++-
 tests/CMakeLists.txt                      |  11 +-
 tests/TrilinosSolversTest.cxx             |  70 ++++++++++--
 6 files changed, 262 insertions(+), 33 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4f39270bc8..539f55253c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -119,6 +119,24 @@ if(enable-trilinos)
   endif()
   find_package(Trilinos CONFIG REQUIRED
                COMPONENTS Tpetra Belos Ifpack2 MueLu Amesos2 ShyLU_DDFROSch)
+  # Trilinos must be built with the Kokkos found above: its packages only
+  # load their own Kokkos when no target of Kokkos is defined, which would
+  # silently compile the sources including Trilinos with another Kokkos
+  set(_trilinos_kokkos_config
+      "${Trilinos_DIR}/../TeuchosKokkosCompat/TeuchosKokkosCompatConfig.cmake")
+  if(EXISTS "${_trilinos_kokkos_config}")
+    file(STRINGS "${_trilinos_kokkos_config}" _trilinos_kokkos
+         REGEX "set\\(Kokkos_CONFIG ")
+    if(_trilinos_kokkos MATCHES "\"(.*)/KokkosConfig.cmake\"")
+      get_filename_component(_trilinos_kokkos_dir "${CMAKE_MATCH_1}" REALPATH)
+      get_filename_component(_kokkos_dir "${Kokkos_DIR}" REALPATH)
+      if(NOT _trilinos_kokkos_dir STREQUAL _kokkos_dir)
+        message(FATAL_ERROR "mfem-mgis: Trilinos is built with the Kokkos "
+                "of ${_trilinos_kokkos_dir}, mfem-mgis found the Kokkos of "
+                "${_kokkos_dir} (option Kokkos_DIR)")
+      endif()
+    endif()
+  endif()
   set(MFEM_MGIS_HAVE_TRILINOS ON)
 endif(enable-trilinos)
 
