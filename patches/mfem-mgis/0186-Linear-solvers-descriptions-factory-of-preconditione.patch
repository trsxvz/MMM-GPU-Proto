+                                   Problem::SolverMaximumNumberOfIterations,
+                                   Preconditioner,
+                                   Krylov_Dimension};
+      auto s = std::make_unique<mfem::HypreFGMRES>(fespace.GetComm());
+      s->iterative_mode = false;
+      if (!checkParameters(ctx, params, allowed_parameters)) {
