diff --git a/include/MFEMMGIS/PreconditionerFactory.hxx b/include/MFEMMGIS/PreconditionerFactory.hxx
new file mode 100644
index 0000000000..da4dfd3882
--- /dev/null
+++ b/include/MFEMMGIS/PreconditionerFactory.hxx
@@ -0,0 +1,100 @@
+/*!
+ * \file   include/MFEMMGIS/PreconditionerFactory.hxx
+ * \brief  This file declares the `PreconditionerFactory` class
+ * \date   15/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_PRECONDITIONERFACTORY_HXX
+#define LIB_MFEM_MGIS_PRECONDITIONERFACTORY_HXX
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+#include <functional>
+#include <string_view>
+#include "MFEMMGIS/Config.hxx"
+#include "MFEMMGIS/MFEMForward.hxx"
+#include "MFEMMGIS/LinearSolverDescription.hxx"
+
+namespace mfem_mgis {
+
+  // forward declaration
+  struct Parameters;
+
+  /*!
+   * \brief factory of the preconditioners of the linear solvers, selected by
+   * the `Preconditioner` parameter of a linear solver (a name, `Name`, and
+   * options, `Options`). Each preconditioner is registered with its
+   * description (see `LinearSolverDescription`).
+   * \tparam parallel: boolean stating if parallel preconditioners are
+   * considered
+   */
+  template <bool parallel>
+  struct MFEM_MGIS_EXPORT PreconditionerFactory {
+    /*!
+     * \brief generator of a preconditioner: the options are the ones given
+     * by the `Options` parameter of the preconditioner (empty if not given)
+     */
+    using Generator = std::function<std::unique_ptr<LinearSolverPreconditioner>(
+        Context&, FiniteElementSpace<parallel>&, const Parameters&)>;
+    //! \return the unique instance of the class
+    static PreconditionerFactory& getFactory();
+    /*!
+     * \brief register a new preconditioner
+     * \param[in, out] ctx: execution context
+     * \param[in] n: name of the preconditioner
+     * \param[in] d: description of the preconditioner
+     * \param[in] g: generator of the preconditioner
+     * \return true on success
+     */
+    [[nodiscard]] bool add(Context& ctx,
+                           std::string_view n,
+                           LinearSolverDescription d,
+                           Generator g) noexcept;
+    /*!
+     * \return the requested preconditioner, or a null pointer on error
+     * \param[in, out] ctx: execution context
+     * \param[in] n: name of the preconditioner
+     * \param[in] fespace: finite element space
+     * \param[in] opts: options of the preconditioner
+     */
+    [[nodiscard]] std::unique_ptr<LinearSolverPreconditioner> generate(
+        Context& ctx,
+        std::string_view n,
+        FiniteElementSpace<parallel>& fespace,
+        const Parameters& opts) const;
+    /*!
+     * \return the description of a preconditioner, or a null pointer if no
+     * preconditioner has this name
+     * \param[in] n: name of the preconditioner
+     */
+    [[nodiscard]] const LinearSolverDescription* getDescription(
+        std::string_view n) const noexcept;
+    //! \return the names of the registered preconditioners
+    [[nodiscard]] std::vector<std::string> getNames() const;
+
+   private:
+    //! \brief a registered preconditioner
+    struct Entry {
+      //! \brief description
+      LinearSolverDescription description;
+      //! \brief generator
+      Generator generator;
+    };
+    //! \brief default constructor, which registers the preconditioners
+    PreconditionerFactory();
+    //! \brief destructor
+    ~PreconditionerFactory();
+    //! \brief registered preconditioners
+    std::map<std::string, Entry, std::less<>> entries;
+  };  // end of struct PreconditionerFactory
+
+#ifdef MFEM_USE_MPI
+  extern template struct PreconditionerFactory<true>;
+#endif /* MFEM_USE_MPI */
+  extern template struct PreconditionerFactory<false>;
+
+}  // end of namespace mfem_mgis
+
+#endif /* LIB_MFEM_MGIS_PRECONDITIONERFACTORY_HXX */
diff --git a/src/AmgXSolvers.cxx b/src/AmgXSolvers.cxx
index da3d592012..0ae2a87d7a 100644
--- a/src/AmgXSolvers.cxx
+++ b/src/AmgXSolvers.cxx
@@ -6,6 +6,7 @@
  */
 
 #include "AmgXSolvers.hxx"
+#include "LinearSolverModules.hxx"
 
 #ifdef MFEM_MGIS_HAVE_AMGX
 
@@ -896,6 +897,83 @@ namespace mfem_mgis::internals {
       Context&, FiniteElementSpace<true>&, const Parameters&) noexcept;
 #endif /* MFEM_USE_MPI */
 
+  //! \return the options of the AmgX preconditioner
+  [[nodiscard]] static std::vector<std::string> getAmgXPreconditionerOptions() {
+    return {"Configuration", "ConfigurationFile", "VerbosityLevel",
+            AmgXParameters, Precision};
+  }  // end of getAmgXPreconditionerOptions
+
+  template <bool parallel>
+  void declareAmgXLinearSolvers(LinearSolverFactory<parallel>& f) {
+    // cycles of the algebraic multigrid of AmgX (approximate solver, as
+    // `HypreBoomerAMG`) and conjugate gradient of AmgX
+    declare(f, "AmgX",
+            LinearSolverDescription{
+                .library = "AmgX",
+                .kind = LinearSolverKind::APPROXIMATE,
+                .placement = LinearSolverPlacement::DEVICE,
+                .preconditioners = AcceptedPreconditioners::NONE,
+                .options = getAmgXPreconditionerOptions(),
+                .description = "cycles of an algebraic multigrid of AmgX "
+                               "(NVIDIA GPU)"},
+            [](Context& c, FiniteElementSpace<parallel>& fespace,
+               const Parameters& params) noexcept -> LinearSolverHandler {
+              auto s = makeAmgXPreconditioner<parallel>(c, fespace, params);
+              if (s == nullptr) {
+                return {};
+              }
+              return LinearSolverHandler{
+                  std::move(s), std::unique_ptr<LinearSolverPreconditioner>{}};
+            });
+    auto pcg_options = getIterativeSolverParametersList();
+    pcg_options.push_back(AmgXParameters);
+    pcg_options.push_back(Precision);
+    declare(f, "AmgXPCG",
+            LinearSolverDescription{
+                .library = "AmgX",
+                .kind = LinearSolverKind::ITERATIVE,
+                .placement = LinearSolverPlacement::DEVICE,
+                .preconditioners = AcceptedPreconditioners::NONE,
+                .options = std::move(pcg_options),
+                .description = "conjugate gradient of AmgX preconditioned by "
+                               "its algebraic multigrid (NVIDIA GPU)"},
+            [](Context& c, FiniteElementSpace<parallel>& fespace,
+               const Parameters& params) noexcept -> LinearSolverHandler {
+              auto s =
+                  makeAmgXConjugateGradientSolver<parallel>(c, fespace, params);
+              if (s == nullptr) {
+                return {};
+              }
+              return LinearSolverHandler{
+                  std::move(s), std::unique_ptr<LinearSolverPreconditioner>{}};
+            });
+  }  // end of declareAmgXLinearSolvers
+
+  template <bool parallel>
+  void declareAmgXPreconditioners(PreconditionerFactory<parallel>& f) {
+    declare(f, "AmgX",
+            LinearSolverDescription{
+                .library = "AmgX",
+                .kind = LinearSolverKind::PRECONDITIONER,
+                .placement = LinearSolverPlacement::DEVICE,
+                .preconditioners = AcceptedPreconditioners::NONE,
+                .options = getAmgXPreconditionerOptions(),
+                .description = "algebraic multigrid of AmgX (NVIDIA GPU)"},
+            [](Context& c, FiniteElementSpace<parallel>& fespace,
+               const Parameters& opts) noexcept
+                -> std::unique_ptr<LinearSolverPreconditioner> {
+              return makeAmgXPreconditioner<parallel>(c, fespace, opts);
+            });
+  }  // end of declareAmgXPreconditioners
+
+  template void declareAmgXLinearSolvers<false>(LinearSolverFactory<false>&);
+  template void declareAmgXPreconditioners<false>(
+      PreconditionerFactory<false>&);
+#ifdef MFEM_USE_MPI
+  template void declareAmgXLinearSolvers<true>(LinearSolverFactory<true>&);
+  template void declareAmgXPreconditioners<true>(PreconditionerFactory<true>&);
+#endif /* MFEM_USE_MPI */
+
 }  // end of namespace mfem_mgis::internals
 
 #endif /* MFEM_MGIS_HAVE_AMGX */
