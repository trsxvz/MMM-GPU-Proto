From 477461c913293195d8b12acb79a99e646fa78578 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Thu, 15 Oct 2026 13:01:14 +0200
Subject: [PATCH] Generic test of the linear solvers on the elasticity:
 stricter checks, single precision

On the linear elasticity, the direct solvers are checked as on the
Laplace equation, the approximate solvers must give a finite non null
solution, and the pipelined conjugate gradient of Ginkgo is only allowed
not to converge on a GPU (it converges on the host). The test is
registered again in single precision, with a bound of 5e-2 on the
residuals of the converged resolutions (they reach 1e-2 with MINRES or
with the incomplete factorizations), and the entries which do not
converge in single precision only are listed: the BiCGSTAB solver of
MFEM (divergence in parallel), and the BiCGSTAB, FGMRES and LGMRES
solvers of hypre (stagnation above the tolerance). The test documents
the weaker checks of the linear elasticity.
---
 tests/CMakeLists.txt                | 41 ++++++---------
 tests/LinearSolverFactoriesTest.cxx | 78 ++++++++++++++++++++++-------
 2 files changed, 75 insertions(+), 44 deletions(-)

diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 4db16b4882..0d974ca66f 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -1637,43 +1637,32 @@ endif(MFEM_USE_MPI)
 # preconditioner registered in the factories (generic test, see the test)
 add_test_executable(LinearSolverFactoriesTest)
 add_test(NAME LinearSolverFactoriesTest COMMAND LinearSolverFactoriesTest)
-set_tests_properties(LinearSolverFactoriesTest PROPERTIES
+# the same on a beam in linear elasticity (in single precision, with looser
+# bounds and the entries which do not converge listed by the test)
+add_test(NAME LinearSolverFactoriesTest-elasticity
+         COMMAND LinearSolverFactoriesTest --elasticity)
+set_tests_properties(LinearSolverFactoriesTest
+                     LinearSolverFactoriesTest-elasticity PROPERTIES
   FAIL_REGULAR_EXPRESSION "check failed")
-# the same on a beam in linear elasticity, in double precision only: in
-# single precision, several Krylov solvers stagnate on the beam above the
-# tolerances of the test, or report a convergence measured on a residual
-# which is not the one of the system
-if(MFEM_MGIS_REAL_TYPE STREQUAL "double")
-  add_test(NAME LinearSolverFactoriesTest-elasticity
-           COMMAND LinearSolverFactoriesTest --elasticity)
-  set_tests_properties(LinearSolverFactoriesTest-elasticity PROPERTIES
-    FAIL_REGULAR_EXPRESSION "check failed")
-endif()
 if(MFEM_USE_MPI)
   add_test(NAME LinearSolverFactoriesTestP
            COMMAND mpirun -n 2 ./LinearSolverFactoriesTest --parallel)
-  set_tests_properties(LinearSolverFactoriesTestP PROPERTIES
+  add_test(NAME LinearSolverFactoriesTestP-elasticity
+           COMMAND mpirun -n 2 ./LinearSolverFactoriesTest --parallel
+                   --elasticity)
+  set_tests_properties(LinearSolverFactoriesTestP
+                       LinearSolverFactoriesTestP-elasticity PROPERTIES
     FAIL_REGULAR_EXPRESSION "check failed")
-  if(MFEM_MGIS_REAL_TYPE STREQUAL "double")
-    add_test(NAME LinearSolverFactoriesTestP-elasticity
-             COMMAND mpirun -n 2 ./LinearSolverFactoriesTest --parallel
-                     --elasticity)
-    set_tests_properties(LinearSolverFactoriesTestP-elasticity PROPERTIES
-      FAIL_REGULAR_EXPRESSION "check failed")
-  endif()
 endif(MFEM_USE_MPI)
 # on a CUDA GPU, the entries which only compute on the GPU (AmgX, cuDSS) are
 # also checked
 if((MFEM_USE_CUDA STREQUAL "YES") AND enable-gpu-tests)
   add_test(NAME LinearSolverFactoriesTest-cuda
            COMMAND LinearSolverFactoriesTest --device cuda)
-  set(linear_solver_factories_gpu_tests LinearSolverFactoriesTest-cuda)
-  if(MFEM_MGIS_REAL_TYPE STREQUAL "double")
-    add_test(NAME LinearSolverFactoriesTest-cuda-elasticity
-             COMMAND LinearSolverFactoriesTest --device cuda --elasticity)
-    list(APPEND linear_solver_factories_gpu_tests
-         LinearSolverFactoriesTest-cuda-elasticity)
-  endif()
+  add_test(NAME LinearSolverFactoriesTest-cuda-elasticity
+           COMMAND LinearSolverFactoriesTest --device cuda --elasticity)
+  set(linear_solver_factories_gpu_tests LinearSolverFactoriesTest-cuda
+      LinearSolverFactoriesTest-cuda-elasticity)
   if(MFEM_USE_MPI)
     add_test(NAME LinearSolverFactoriesTestP-cuda
              COMMAND mpirun -n 2 ./LinearSolverFactoriesTest --parallel
diff --git a/tests/LinearSolverFactoriesTest.cxx b/tests/LinearSolverFactoriesTest.cxx
index a0bc4cdc2a..eb083d513d 100644
--- a/tests/LinearSolverFactoriesTest.cxx
+++ b/tests/LinearSolverFactoriesTest.cxx
@@ -7,9 +7,13 @@
  * with a diagonal set to one. The outcome is checked according to the kind
  * of solver (see `LinearSolverDescription`): convergence up to the
  * tolerance for the iterative and direct solvers, decrease of the residual
- * for the approximate solvers (on the linear elasticity, see
- * `checkResolution`: a converged resolution has a small residual, and the
- * entries which do not converge on this problem are listed). The test also
+ * for the approximate solvers. On the linear elasticity, the checks of the
+ * iterative and approximate solvers are weaker (see `checkResolution`): a
+ * converged resolution has a residual below `elasticity_tolerance`, the
+ * entries which do not converge on this problem are listed (in each
+ * precision), and the approximate solvers only give a finite non zero
+ * solution; the direct solvers are checked as on the Laplace equation. The
+ * test also
  * checks the descriptions, the preconditioners refused by the linear solvers,
  * and, in sequential, the message of the solvers only available in parallel.
  *
@@ -63,10 +67,12 @@ static constexpr double tolerance =
  * elasticity: the GMRES solver of MFEM, preconditioned on the left, stops on
  * the preconditioned residual, which is much smaller than the residual for
  * the preconditioners of this problem (by a few hundred for the incomplete
- * factorizations)
+ * factorizations). In single precision, the residuals of the converged
+ * resolutions reach 1e-2 (`MINRESSolver`, `GMRESSolver` preconditioned by
+ * `HypreEuclid`)
  */
 static constexpr double elasticity_tolerance =
-    std::is_same_v<mfem_mgis::real, float> ? 1e-3 : 1e-6;
+    std::is_same_v<mfem_mgis::real, float> ? 5e-2 : 1e-6;
 /*!
  * \brief maximum number of iterations of the iterative solvers: 5000 for
  * the Laplace equation, 2000 for the linear elasticity (the slowest entry
@@ -319,39 +325,65 @@ static void checkPlacement(const std::string& n,
   }
 }  // end of checkPlacement
 
+/*!
+ * \return true for the entries which, in single precision only, do not
+ * converge on the linear elasticity with the options of this test: the
+ * BiCGSTAB solver of MFEM (divergence in parallel), and the BiCGSTAB,
+ * FGMRES and LGMRES solvers of hypre (stagnation above the tolerance)
+ * \param[in] n: name of the entry
+ */
+static bool mayNotConvergeOnElasticityInSinglePrecision(const std::string& n) {
+  static const auto names = std::set<std::string>{
+      "BiCGSTABSolver", "HypreBiCGSTAB", "HypreFGMRES", "HypreLGMRES"};
+  return names.contains(n);
+}  // end of mayNotConvergeOnElasticityInSinglePrecision
+
 /*!
  * \return true for the entries which do not converge on the linear
  * elasticity with the options of this test: only their report of the
  * convergence is checked. These are the conjugate gradient squared with a
  * Jacobi preconditioner (divergence for Ginkgo, breakdown for MAGMA), the
  * stationary iterations with a damped Jacobi preconditioner (`SLISolver`,
- * `GinkgoIR`: too slow), the pipelined conjugate gradient of Ginkgo
- * (stagnation above the tolerance on the GPU), the TFQMR of MAGMA
- * (breakdown) and the multigrid of Ginkgo (aggregation without the rigid
- * body modes).
+ * `GinkgoIR`: too slow), the pipelined conjugate gradient of Ginkgo on a
+ * GPU (stagnation above the tolerance; it converges on the host), the
+ * TFQMR of MAGMA (breakdown) and the multigrid of Ginkgo (aggregation
+ * without the rigid body modes), and, in single precision, the entries of
+ * `mayNotConvergeOnElasticityInSinglePrecision`.
  * \param[in] n: name of the entry
  */
 static bool mayNotConvergeOnElasticity(const std::string& n) {
-  static const auto names = std::set<std::string>{
-      "GinkgoCGS",    "MAGMACGS",   "SLISolver",      "GinkgoIR",
-      "GinkgoPipeCG", "MAGMATFQMR", "GinkgoMultigrid"};
-  return names.contains(n);
+  static const auto names =
+      std::set<std::string>{"GinkgoCGS", "MAGMACGS",   "SLISolver",
+                            "GinkgoIR",  "MAGMATFQMR", "GinkgoMultigrid"};
+  if (names.contains(n)) {
+    return true;
+  }
+  if ((n == "GinkgoPipeCG") &&
+      (mfem::Device::Allows(mfem::Backend::CUDA_MASK |
+                            mfem::Backend::HIP_MASK))) {
+    return true;
+  }
+  return std::is_same_v<mfem_mgis::real, float> &&
+         mayNotConvergeOnElasticityInSinglePrecision(n);
 }  // end of mayNotConvergeOnElasticity
 
 /*!
  * \brief checks the outcome of a resolution
  * \param[in] n: name of the resolution
  * \param[in] entry: name of the entry tested
+ * \param[in] kind: kind of the entry tested (the direct solvers are
+ * checked as on the Laplace equation)
  * \param[in] converged: convergence reported
  * \param[in] r: relative residual
  * \param[in] elasticity: if true, the system is the linear elasticity
  */
 static void checkResolution(const std::string& n,
                             const std::string& entry,
+                            const mfem_mgis::LinearSolverKind kind,
                             const bool converged,
                             const double r,
                             const bool elasticity) {
-  if (!elasticity) {
+  if ((!elasticity) || (kind == mfem_mgis::LinearSolverKind::DIRECT)) {
     check(converged && (r < 100 * tolerance), n + ": resolution");
     return;
   }
@@ -415,11 +447,20 @@ static void run(System<is_parallel>& s, const bool elasticity) {
     print(n + ": " + describe(converged, iterations, r));
     if (d->kind == LinearSolverKind::APPROXIMATE) {
       // one cycle of a scalar algebraic multigrid (default options) does not
-      // reduce the residual of the linear elasticity
-      check(elasticity ? std::isfinite(r) : r < 1,
+      // reduce the residual of the linear elasticity: the solution is only
+      // checked to be finite and not null
+      const auto xnorm = [&s, &x] {
+        if constexpr (is_parallel) {
+          return mfem::ParNormlp(x, 2, s.fespace.GetComm());
+        } else {
+          static_cast<void>(s);
+          return x.Norml2();
+        }
+      }();
+      check(elasticity ? std::isfinite(r) && (xnorm > 0) : r < 1,
             n + ": the residual does not decrease");
     } else {
-      checkResolution(n, n, converged, r, elasticity);
+      checkResolution(n, n, d->kind, converged, r, elasticity);
     }
   }
   // preconditioners, given to the GMRES solver of MFEM
@@ -469,7 +510,8 @@ static void run(System<is_parallel>& s, const bool elasticity) {
                    getNumberOfIterationsAtConvergence(*(ls.linear_solver)), r));
     check(ls.preconditioner != nullptr,
           "GMRESSolver, " + n + ": the preconditioner is not built");
-    checkResolution("GMRESSolver, " + n, n, converged, r, elasticity);
+    checkResolution("GMRESSolver, " + n, n, LinearSolverKind::ITERATIVE,
+                    converged, r, elasticity);
   }
   // preconditioners refused by the descriptions: a preconditioner given to
   // a linear solver which accepts none, and a preconditioner of another
