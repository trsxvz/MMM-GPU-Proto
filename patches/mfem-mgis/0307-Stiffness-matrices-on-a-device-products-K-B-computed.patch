+/*!
+ * \brief requests the full unrolling of the following loop in device code.
+ * The loops over the constant tables of the non-zero entries of the
+ * operator `B` (see `getBOperatorEntries`) and over the components of the
+ * unknowns must be unrolled for these tables to be folded at compile time:
+ * otherwise, the entries are read from the constant memory at each
+ * iteration, which made the kernel of the stiffness matrices 1.4 times
+ * slower with `nvcc` 13.0. `MFEM_UNROLL` is only defined for CUDA.
+ */
+#if defined(__CUDA_ARCH__) || defined(__HIP_DEVICE_COMPILE__)
+#define MFEM_MGIS_UNROLL _Pragma("unroll")
+#else
+#define MFEM_MGIS_UNROLL
+#endif
+
