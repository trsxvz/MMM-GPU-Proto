From 167f49d047cb27e128d539cadd085190172af2d6 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 17:24:00 +0200
Subject: [PATCH] NonLinearSolverFactory.ixx installed

The installed header NonLinearSolvers/NonLinearSolverFactory.hxx includes NonLinearSolverFactory.ixx, which was not installed: a program including it from the installation did not compile. The installed header now compiles alone.
---
 include/CMakeLists.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/include/CMakeLists.txt b/include/CMakeLists.txt
index 21e9006359..ca5fa050df 100644
--- a/include/CMakeLists.txt
+++ b/include/CMakeLists.txt
@@ -128,6 +128,7 @@ mfem_mgis_header(MFEMMGIS Simulation.hxx)
 mfem_mgis_header(MFEMMGIS/NonLinearSolvers AbstractNonLinearSolver.hxx)
 mfem_mgis_header(MFEMMGIS/NonLinearSolvers NonLinearSolverBase.hxx)
 mfem_mgis_header(MFEMMGIS/NonLinearSolvers NonLinearSolverFactory.hxx)
+mfem_mgis_header(MFEMMGIS/NonLinearSolvers NonLinearSolverFactory.ixx)
 mfem_mgis_header(MFEMMGIS/NonLinearSolvers NewtonSolver.hxx)
 mfem_mgis_header(MFEMMGIS/NonLinearSolvers AccelerationAlgorithm.hxx)
 mfem_mgis_header(MFEMMGIS/NonLinearSolvers AdaptiveLinearSolverTolerance.hxx)
-- 
