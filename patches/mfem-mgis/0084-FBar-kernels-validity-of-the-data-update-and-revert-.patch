+/*!
+ * \brief the tangent operator of the FBar formulation can't be computed by
+ * kernels from gradients computed element by element
+ * \param[in, out] ctx: execution context
+ * \param[in] mesh: mesh
+ * \param[in] library: behaviour library
+ */
+static void testFBarTangentOperatorRefusal(mfem_mgis::Context& ctx,
+                                           const char* const mesh,
+                                           const char* const library) {
+  using namespace mfem_mgis;
+  auto or_die = ctx.getFatalFailureHandler();
+  auto problem =
+      construct<NonLinearEvolutionProblem>(
+          ctx,
+          Parameters{
+              {"MeshFileName", mesh},
+              {"FiniteElementFamily", "H1"},
+              {"FiniteElementOrder", 1},
+              {"UnknownsSize", 3},
+              {"NumberOfUniformRefinements", 0},
+              {"Materials", Parameters{{"Cube", 1}}},
+              {"Boundaries",
+               Parameters{{"Ymin", 1}, {"Zmin", 2}, {"Xmax", 3}, {"Xmin", 5}}},
+              {"Hypothesis", "Tridimensional"},
+              {"BehaviourIntegration", "Batch"},
+              {"GradientsComputation", "ElementByElement"},
+              {"TangentOperatorComputation", "Kernels"},
+              {"Parallel", parallel}}) |
+      or_die;
+  problem.addBehaviourIntegrator(
+      ctx, "Mechanics", "Cube", library, "SaintVenantKirchhoffElasticity",
+      {{"Regularization", Parameters{{"FBar", Parameters{}}}}}) |
+      or_die;
+  for (const auto& [boundary, component] :
+       {std::pair{"Xmin", 0}, std::pair{"Ymin", 1}, std::pair{"Zmin", 2}}) {
+    problem.addUniformDirichletBoundaryCondition(
+        ctx, {{"Boundary", boundary}, {"Component", component}}) |
+        or_die;
+  }
+  problem.addUniformDirichletBoundaryCondition(
+      ctx,
+      {{"Boundary", "Xmax"},
+       {"Component", 0},
+       {"LoadingEvolution", [](const real t) noexcept { return 1e-2 * t; }}}) |
+      or_die;
+  problem.setLinearSolver(ctx, parallel ? "MUMPSSolver" : "UMFPackSolver", {}) |
+      or_die;
+  problem.setSolverParameters(ctx, {{"VerbosityLevel", 0},
+                                    {"RelativeTolerance", 1e-12},
+                                    {"AbsoluteTolerance", 0.},
+                                    {"MaximumNumberOfIterations", 10}}) |
+      or_die;
+  auto c = Context{};
+  const auto r = problem.solve(c, 0, 1);
+  const auto msg = std::string{c.getErrorMessage()};
+  check((!r.status) &&
+            (msg.find("gradients computed by kernels") != std::string::npos),
+        "FBar: tangent operator computed by kernels from gradients computed "
+        "element by element accepted (" +
+            msg + ")");
+}  // end of testFBarTangentOperatorRefusal
+
