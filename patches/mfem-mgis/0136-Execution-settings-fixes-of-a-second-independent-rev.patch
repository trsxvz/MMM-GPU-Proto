+                                 "IsotropicLinearHardeningPlasticity") |
+      or_die;
+  auto& m = problem.getMaterial(ctx, "Square", 0) | or_die;
+  for (auto* st : {&m.s0, &m.s1}) {
+    mgis::behaviour::setExternalStateVariable(ctx, *st, "Temperature", 293.15) |
+        or_die;
