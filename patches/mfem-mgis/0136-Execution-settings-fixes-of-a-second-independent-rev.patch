+#   (in share/tfel*/mfront/configuration-files next to the bin directory of
+#   mfront) and NO_GPU is not given, the libraries for the GPU, generated by
+#   the generic-parallel interface: <dir>/gpu/lib<name>.so. Otherwise, a
+#   message tells why they are not built.
 #
 # <name> is each name given after LIBRARIES (Behaviour by default): the
 # material of the sources (@Material keyword), or Behaviour for the sources
 # without material. MFront generates, for the generic interface,
 # libBehaviour.so for the sources without material and lib<name>-generic.so
 # for the material <name>, and, for the generic-parallel interface,
-# libGenericParallel<name>-<backend>.so. The directory given after INCLUDE_DIRECTORY is
-# searched for the files included by the sources (@MaterialLaw,
-# @Includes), and the files given after DEPENDS (for instance these
+# libGenericParallel<name>-<backend>.so. The directory given after
+# INCLUDE_DIRECTORY (relative to the current source directory) is searched
+# for the files included by the sources (@MaterialLaw, @Includes), and the
+# files given after DEPENDS (for instance these
 # included files) are dependencies of the libraries. The custom target
 # <target> builds the libraries (built by default, unless EXCLUDE_FROM_ALL
 # is given). The variable <target>_BEHAVIOURS_DIRECTORY is set to <dir> in
@@ -37,7 +41,7 @@
 # library computing where the execution settings place the behaviours (see
 # the option --execution).
 function(mfem_mgis_add_behaviours_library target)
-  cmake_parse_arguments(_b "EXCLUDE_FROM_ALL" "INCLUDE_DIRECTORY"
+  cmake_parse_arguments(_b "EXCLUDE_FROM_ALL;NO_GPU" "INCLUDE_DIRECTORY"
                         "SOURCES;LIBRARIES;DEPENDS" ${ARGN})
   if(NOT _b_SOURCES)
     message(FATAL_ERROR "mfem_mgis_add_behaviours_library: no source given")
@@ -54,7 +58,9 @@ function(mfem_mgis_add_behaviours_library target)
   endif()
   set(_include)
   if(_b_INCLUDE_DIRECTORY)
-    set(_include "--include=${_b_INCLUDE_DIRECTORY}")
+    get_filename_component(_include_directory "${_b_INCLUDE_DIRECTORY}"
+                           ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
+    set(_include "--include=${_include_directory}")
   endif()
   set(_sources)
   foreach(_source ${_b_SOURCES})
@@ -75,9 +81,20 @@ function(mfem_mgis_add_behaviours_library target)
     set(_gpu_backend hip)
     set(_gpu_configuration config-hip-hipcc.json)
   endif()
+  if(_b_NO_GPU)
+    set(_gpu_backend)
+  endif()
   if(_gpu_backend)
-    get_filename_component(_mfront_bin "${MFRONT}" DIRECTORY)
-    if(NOT EXISTS "${_mfront_bin}/../share/tfel/mfront/configuration-files/${_gpu_configuration}")
+    # configuration file of TFEL, next to the bin directory of mfront (TFEL
+    # may be installed with a suffix, share/tfel-<suffix>)
+    get_filename_component(_mfront_real "${MFRONT}" REALPATH)
+    get_filename_component(_mfront_bin "${_mfront_real}" DIRECTORY)
+    file(GLOB _gpu_configuration_files
+         "${_mfront_bin}/../share/tfel*/mfront/configuration-files/${_gpu_configuration}")
+    if(NOT _gpu_configuration_files)
+      message(STATUS "mfem_mgis_add_behaviours_library(${target}): no "
+              "library for the GPU, the configuration file "
+              "${_gpu_configuration} of TFEL is not found")
       set(_gpu_backend)
     endif()
   endif()
