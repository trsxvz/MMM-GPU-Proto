 #compiler options
 include(cmake/modules/compiler.cmake)
@@ -240,9 +240,33 @@ if((NOT MFEM_MGIS_REAL_TYPE STREQUAL "double") AND enable-amgx)
   message(FATAL_ERROR "mfem-mgis: the solvers of AmgX require double "
           "(option enable-amgx)")
 endif()
-if((NOT MFEM_MGIS_REAL_TYPE STREQUAL "double") AND enable-trilinos)
-  message(FATAL_ERROR "mfem-mgis: the solvers of Trilinos require double "
-          "(option enable-trilinos)")
+# the solvers of Trilinos use the numerical type of mfem-mgis: Tpetra (and
+# the packages using it) must be instantiated for it
+if(MFEM_MGIS_HAVE_TRILINOS)
+  string(TOUPPER "${MFEM_MGIS_REAL_TYPE}" _real_type)
+  # configuration header of Tpetra, in the include directory of the
+  # installation of Trilinos (Trilinos_INCLUDE_DIRS is deprecated)
+  set(_tpetra_config_header "")
+  foreach(_directory ${Trilinos_INCLUDE_DIRS} "${Trilinos_INSTALL_DIR}/include"
+                     "${Trilinos_DIR}/../../../include")
+    if(EXISTS "${_directory}/TpetraCore_config.h")
+      set(_tpetra_config_header "${_directory}/TpetraCore_config.h")
+      break()
+    endif()
+  endforeach()
+  if(NOT _tpetra_config_header)
+    message(FATAL_ERROR "mfem-mgis: the configuration header of Tpetra "
+            "(TpetraCore_config.h) is not found in the installation of "
+            "Trilinos (${Trilinos_DIR})")
+  endif()
+  file(STRINGS "${_tpetra_config_header}" _tpetra_instantiation
+       REGEX "^#define HAVE_TPETRA_INST_${_real_type}$")
+  if(NOT _tpetra_instantiation)
+    message(FATAL_ERROR "mfem-mgis: Tpetra is not instantiated for the "
+            "numerical type '${MFEM_MGIS_REAL_TYPE}' of MFEM (option "
+            "enable-trilinos; variant +float of the Spack package of "
+            "Trilinos for float)")
+  endif()
 endif()
 message(STATUS "mfem-mgis numerical type: ${MFEM_MGIS_REAL_TYPE}")
