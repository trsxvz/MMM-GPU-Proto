From be956be17c5da0974dcac0a1969100319db550f2 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sat, 10 Oct 2026 10:59:08 +0200
Subject: [PATCH] L2 projection: copy the components of the solution on the
 host

The components of an L2 projection (and of an implicit gradient
regularisation) with several components were copied by the operator `[]`
of the vectors, which reads the memory of the host without making it
valid: on a GPU, where the solution is recovered on the device, the
result was zero. The copy now reads the solution and writes the result
through `HostRead` and `HostReadWrite`.

L2ProjectionTest only exported its results: the projection of linear
functions with one and three components, which is exact, is now
compared to their interpolants (it failed on the GPU before this fix).
---
 src/L2Projection.cxx       |   8 ++-
 tests/L2ProjectionTest.cxx | 110 ++++++++++++++++++++++++++++++++++++-
 2 files changed, 114 insertions(+), 4 deletions(-)

diff --git a/src/L2Projection.cxx b/src/L2Projection.cxx
index e47a1ad875..162670c93b 100644
--- a/src/L2Projection.cxx
+++ b/src/L2Projection.cxx
@@ -678,10 +678,12 @@ namespace mfem_mgis {
         return ctx.registerErrorMessage("linear solver failed");
       }
       a.RecoverFEMSolution(X, b, *x);
-      // copy solution to r.result, if needed
+      // copy solution to r.result, if needed. The copy is done on the host,
+      // where the solution, which may have been computed on the device, is
+      // made valid, as the components already copied
       if (rfespace.GetVDim() != 1) {
-        auto& dest = *(r.result);
-        const auto& src = *(x);
+        auto* const dest = r.result->HostReadWrite();
+        const auto* const src = x->HostRead();
         const auto bynodes =
             (rfespace.GetOrdering() == mfem::Ordering::byNODES);
         if (bynodes) {
diff --git a/tests/L2ProjectionTest.cxx b/tests/L2ProjectionTest.cxx
index 58d8e9c26b..15084a38f7 100644
--- a/tests/L2ProjectionTest.cxx
+++ b/tests/L2ProjectionTest.cxx
@@ -5,9 +5,14 @@
  * \date   20/01/2026
  */
 
+#include <array>
+#include <cmath>
 #include <memory>
+#include <string>
+#include <sstream>
 #include <cstdlib>
 #include <iostream>
+#include <algorithm>
 #include "mfem/general/optparser.hpp"
 #include "mfem/fem/datacollection.hpp"
 #include "MFEMMGIS/PartialQuadratureSpace.hxx"
@@ -197,6 +202,99 @@ bool test3(mfem_mgis::Context& ctx, const TestParameters& params) {
   return true;
 }  // end of test3
 
+/*!
+ * \brief projection of linear functions with one and three components: the
+ * L2 projection of a function of the finite element space is this function,
+ * whose values at the nodes are the ones of its interpolant. The values are
+ * compared on the host, whatever the device.
+ */
+template <bool parallel>
+bool test4(mfem_mgis::Context& ctx, const TestParameters& params) {
+  using namespace mfem_mgis;
+  auto fed = FiniteElementDiscretization{
+      ctx,
+      {{"MeshFileName", params.mesh_file},
+       {"FiniteElementFamily", "H1"},
+       {"FiniteElementOrder", params.order},
+       {"UnknownsSize", 1},
+       {"NumberOfUniformRefinements", parallel ? 1 : 0},
+       {"Parallel", parallel}}};
+  auto space = PartialQuadratureSpace(
+      fed, MaterialIdentifier{.id = 5},
+      [](const mfem::FiniteElement& e,
+         const mfem::ElementTransformation& tr) noexcept
+          -> const mfem::IntegrationRule& {
+        const auto order = 2 * tr.OrderGrad(&e);
+        return mfem::IntRules.Get(e.GetGeomType(), order);
+      });
+  // coefficients a, b and c of the components a + b x + c y
+  const auto coefficients = std::array<std::array<real, 3>, 3>{
+      {{1, 2, -1}, {-0.5, 0, 3}, {2, -1, 0.5}}};
+  for (const auto n : {1, 3}) {
+    auto fct = std::make_shared<PartialQuadratureFunction>(space, n);
+    auto values = fct->getValues();
+    for (int c = 0; c != n; ++c) {
+      const auto [a, b, d] = coefficients[c];
+      const auto f = PartialQuadratureFunction::evaluate(
+          space, [a, b, d](const real x, const real y) noexcept {
+            return a + b * x + d * y;
+          });
+      const auto f_values = f->getValues();
+      for (size_type idx = 0; idx != space.getNumberOfIntegrationPoints();
+           ++idx) {
+        values[n * idx + c] = f_values[idx];
+      }
+    }
+    auto s = mfem_mgis::unit_tests::getLinearSolver<parallel>(
+        ctx, fed.getFiniteElementSpace<parallel>(), params);
+    if (isInvalid(s)) {
+      return false;
+    }
+    const auto oresult = computeL2Projection<parallel>(ctx, s, {*fct});
+    if (isInvalid(oresult)) {
+      return false;
+    }
+    auto& result = *(oresult->result);
+    auto reference = [&result] {
+      if constexpr (parallel) {
+        return GridFunction<true>(result.ParFESpace());
+      } else {
+        return GridFunction<false>(result.FESpace());
+      }
+    }();
+    auto coefficient = mfem::VectorFunctionCoefficient(
+        n, [&coefficients, n](const mfem::Vector& x, mfem::Vector& v) {
+          for (int c = 0; c != n; ++c) {
+            const auto [a, b, d] = coefficients[c];
+            v[c] = a + b * x[0] + d * x[1];
+          }
+        });
+    reference.ProjectCoefficient(coefficient);
+    const auto* const presult = result.HostRead();
+    const auto* const preference = reference.HostRead();
+    // largest difference and largest value
+    auto e = std::array<real, 2>{};
+    for (int i = 0; i != result.Size(); ++i) {
+      e[0] = std::max(e[0], std::abs(presult[i] - preference[i]));
+      e[1] = std::max(e[1], std::abs(preference[i]));
+    }
+#ifdef MFEM_USE_MPI
+    if constexpr (parallel) {
+      MPI_Allreduce(MPI_IN_PLACE, e.data(), 2, MPI_DOUBLE, MPI_MAX,
+                    MPI_COMM_WORLD);
+    }
+#endif /* MFEM_USE_MPI */
+    if (!(e[0] <= 1e-8 * e[1])) {
+      auto msg = std::ostringstream{};
+      msg << "test4: invalid projection of a linear function with " << n
+          << " component(s) (largest difference " << e[0] << ", largest value "
+          << e[1] << ")";
+      return ctx.registerErrorMessage(msg.str());
+    }
+  }
+  return true;
+}  // end of test4
+
 int main(int argc, char** argv) {
   using namespace mfem_mgis;
   auto ctx = Context{};
@@ -234,7 +332,17 @@ int main(int argc, char** argv) {
     }
     return test3<false>(ctx, params);
   }();
-  if (!(success && success2 && success3)) {
+  const auto success4 = [&ctx, &params] {
+    if (params.parallel) {
+#ifdef MFEM_USE_MPI
+      return test4<true>(ctx, params);
+#else  /* MFEM_USE_MPI */
+      reportUnsupportedParallelComputations();
+#endif /* MFEM_USE_MPI */
+    }
+    return test4<false>(ctx, params);
+  }();
+  if (!(success && success2 && success3 && success4)) {
     std::cerr << ctx.getErrorMessage() << std::endl;
     return EXIT_FAILURE;
   }
