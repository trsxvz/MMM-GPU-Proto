From e56dad90aeac3b142bed31a3f30111617188c343 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 21:52:19 +0200
Subject: [PATCH] BatchIntegrationTest: computations on two processes

With the --parallel option, the computations are made in parallel with
MUMPS, and only their comparisons are made, to the rounding errors:
MUMPS (dynamic scheduling between the processes) and the operations of
hypre on a GPU are not reproducible to the last bit. New tests
BatchIntegrationTestP and BatchIntegrationTestP-cuda (one thread per
process), which cover the computations by kernels in parallel, in
particular the local matrix of the tangent operator shared with hypre:
the test fails if its rows are sorted and searched by bisection only,
which the sequential tests do not detect.
---
 tests/BatchIntegrationTest.cxx | 44 ++++++++++++++++++++++++----------
 tests/CMakeLists.txt           | 17 +++++++++++++
 2 files changed, 49 insertions(+), 12 deletions(-)

diff --git a/tests/BatchIntegrationTest.cxx b/tests/BatchIntegrationTest.cxx
index adeb94b68e..dde370761a 100644
--- a/tests/BatchIntegrationTest.cxx
+++ b/tests/BatchIntegrationTest.cxx
@@ -8,7 +8,9 @@
  * a behaviour with material properties given at the end of the time step
  * only, with a spatial variation, with the behaviours generated by the
  * generic and generic-parallel interfaces; refusal of an invalid value and
- * of a behaviour integrator which does not support it
+ * of a behaviour integrator which does not support it. With the `--parallel`
+ * option, the computations are made in parallel (MUMPS), only their
+ * comparisons are made, to the rounding errors.
  * \date   09/10/2026
  */
 
@@ -30,6 +32,8 @@
 
 //! \brief number of failed checks
 static int failures = 0;
+//! \brief if true, the computations are parallel
+static bool parallel = false;
 
 static void check(const bool b, const std::string& msg) {
   if (!b) {
@@ -152,7 +156,7 @@ static Results compute(mfem_mgis::Context& ctx,
                            {"GradientsComputation", gradients},
                            {"InnerForcesComputation", inner_forces},
                            {"TangentOperatorComputation", tangent_operator},
-                           {"Parallel", false}}
+                           {"Parallel", parallel}}
               : Parameters{{"MeshFileName", mesh},
                            {"FiniteElementFamily", "H1"},
                            {"FiniteElementOrder", 1},
@@ -168,7 +172,7 @@ static Results compute(mfem_mgis::Context& ctx,
                            {"GradientsComputation", gradients},
                            {"InnerForcesComputation", inner_forces},
                            {"TangentOperatorComputation", tangent_operator},
-                           {"Parallel", false}}) |
+                           {"Parallel", parallel}}) |
       or_die;
   if (opts.fbar) {
     problem.addBehaviourIntegrator(
@@ -238,7 +242,8 @@ static Results compute(mfem_mgis::Context& ctx,
                return t < 0.5 ? 2e-2 * t : 1e-2 - 3e-2 * (t - 0.5);
              }}}) |
       or_die;
-  problem.setLinearSolver(ctx, "UMFPackSolver", {}) | or_die;
+  problem.setLinearSolver(ctx, parallel ? "MUMPSSolver" : "UMFPackSolver", {}) |
+      or_die;
   problem.setSolverParameters(ctx, {{"VerbosityLevel", 0},
                                     {"RelativeTolerance", 1e-12},
                                     {"AbsoluteTolerance", 0.},
@@ -591,6 +596,8 @@ int main(int argc, char** argv) {
                  "two-dimensional mesh of the unit square (material 1, "
                  "boundaries x = 0 (2), y = 0 (5) and x = 1 (4))");
   args.AddOption(&library, "-l", "--library", "behaviour library");
+  args.AddOption(&parallel, "-p", "--parallel", "-no-p", "--no-parallel",
+                 "parallel computations (only their comparisons are made)");
   args.AddOption(&openmp_library, "-lo", "--openmp-library",
                  "library generated by the generic-parallel interface "
                  "(openmp backend), not tested if empty");
@@ -603,21 +610,26 @@ int main(int argc, char** argv) {
     return EXIT_FAILURE;
   }
   auto ctx = Context{};
+  // tolerance of the comparisons between the integrations point by point
+  // and by batches: same results to the last bit, except in parallel, where
+  // MUMPS (dynamic scheduling between the processes) and the operations of
+  // hypre on a GPU are not reproducible to the last bit
+  const auto last_bit = parallel ? 1e-10 : 0.;
   // integration point by point and by batches of the behaviours generated
-  // by the generic interface: same results, to the last bit
+  // by the generic interface
   for (const auto* const b :
        {"IsotropicLinearHardeningPlasticity", "SaintVenantKirchhoffElasticity",
         "OrthotropicElasticity", "OrthotropicSaintVenantKirchhoffElasticity",
         "IsotropicLinearElasticity"}) {
     compare(compute(ctx, mesh, library, b, "PointByPoint"),
-            compute(ctx, mesh, library, b, "Batch"), b, 0);
+            compute(ctx, mesh, library, b, "Batch"), b, last_bit);
   }
   for (const auto* const b :
        {"OrthotropicElasticity", "OrthotropicSaintVenantKirchhoffElasticity"}) {
     const auto opts = ComputationOptions{.varying_material_axes = true};
     compare(compute(ctx, mesh, library, b, "PointByPoint", opts),
             compute(ctx, mesh, library, b, "Batch", opts),
-            std::string{b} + " (varying material axes)", 0);
+            std::string{b} + " (varying material axes)", last_bit);
   }
   // FBar formulation
   for (const auto* const b : {"SaintVenantKirchhoffElasticity",
@@ -625,7 +637,7 @@ int main(int argc, char** argv) {
     const auto opts = ComputationOptions{.fbar = true};
     compare(compute(ctx, mesh, library, b, "PointByPoint", opts),
             compute(ctx, mesh, library, b, "Batch", opts),
-            std::string{b} + " (FBar)", 0);
+            std::string{b} + " (FBar)", last_bit);
   }
   // orthotropic behaviours: plane strain hypothesis (rotation matrix in 2D)
   // and prediction at the beginning of each time step
@@ -634,12 +646,14 @@ int main(int argc, char** argv) {
     const auto opts = ComputationOptions{.plane_strain = true};
     compare(compute(ctx, square_mesh, library, b, "PointByPoint", opts),
             compute(ctx, square_mesh, library, b, "Batch", opts),
-            std::string{b} + " (plane strain)", 0);
+            std::string{b} + " (plane strain)", last_bit);
     const auto opts2 = ComputationOptions{.prediction = true};
     compare(compute(ctx, mesh, library, b, "PointByPoint", opts2),
             compute(ctx, mesh, library, b, "Batch", opts2),
-            std::string{b} + " (prediction)", 0);
-    testElementByElementSequence(ctx, mesh, library, b);
+            std::string{b} + " (prediction)", last_bit);
+    if (!parallel) {
+      testElementByElementSequence(ctx, mesh, library, b);
+    }
   }
   // gradients and inner forces computed by kernels: same results as the
   // integration point by point, to the rounding errors
@@ -722,7 +736,13 @@ int main(int argc, char** argv) {
               compute(ctx, m, l, b, "Batch", opts),
               b + " (generic-parallel, " + backend + name + ")", 1e-10);
     }
-    testPointByPointRefusal(ctx, mesh, l);
+    if (!parallel) {
+      testPointByPointRefusal(ctx, mesh, l);
+    }
+  }
+  if (parallel) {
+    std::cout << (failures == 0 ? "success" : "failure") << '\n';
+    return failures == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
   }
   // invalid value
   {
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 00aa15e9c2..6f44ddc958 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -834,6 +834,23 @@ if(MFEM_MGIS_HAVE_TFEL)
              COMMAND BatchIntegrationTest --device cuda
                      ${batch_integration_test_arguments})
   endif()
+  # computations on two processes (the comparisons only), with MUMPS, one
+  # thread per process
+  if(MFEM_USE_MPI AND MFEM_USE_MUMPS)
+    add_test(NAME BatchIntegrationTestP
+             COMMAND mpirun -n 2 ./BatchIntegrationTest --parallel
+                     ${batch_integration_test_arguments}
+                     ${batch_integration_test_libraries})
+    set_tests_properties(BatchIntegrationTestP
+                         PROPERTIES ENVIRONMENT OMP_NUM_THREADS=1)
+    if((MFEM_USE_CUDA STREQUAL "YES") AND enable-gpu-tests)
+      add_test(NAME BatchIntegrationTestP-cuda
+               COMMAND mpirun -n 2 ./BatchIntegrationTest --parallel
+                       --device cuda ${batch_integration_test_arguments})
+      set_tests_properties(BatchIntegrationTestP-cuda
+                           PROPERTIES ENVIRONMENT OMP_NUM_THREADS=1)
+    endif()
+  endif()
 
   # MaterialArraysTest executable: arrays of the materials in the memory of
   # MFEM, on the host, on the debug device of MFEM and on the GPU
-- 
2.43.0

