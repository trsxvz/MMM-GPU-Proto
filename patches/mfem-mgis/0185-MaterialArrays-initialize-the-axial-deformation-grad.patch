+/*!
+ * \brief the axial component of the deformation gradient computed by a
+ * finite strain behaviour in plane stress, stored in the
+ * `AxialDeformationGradient` internal state variable, is initialized to
+ * one, as the deformation gradient is initialized to the identity, and the
+ * other internal state variables to zero, in both layouts (the
+ * Green-Lagrange strain is stored before the axial deformation gradient)
+ * \param[in, out] ctx: execution context
+ * \param[in] mesh: two-dimensional mesh
+ * \param[in] library: behaviour library
+ */
+static void testAxialDeformationGradient(mfem_mgis::Context& ctx,
+                                         const char* const mesh,
+                                         const char* const library) {
+  using namespace mfem_mgis;
+  auto or_die = ctx.getFatalFailureHandler();
+  auto fed = make_shared<FiniteElementDiscretization>(
+                 ctx, Parameters{{"MeshFileName", mesh},
+                                 {"FiniteElementFamily", "H1"},
+                                 {"FiniteElementOrder", 1},
+                                 {"UnknownsSize", 2},
+                                 {"NumberOfUniformRefinements", 0},
+                                 {"Parallel", false}}) |
+             or_die;
+  auto qspace = make_shared<const PartialQuadratureSpace>(
+                    ctx, *fed, MaterialIdentifier{.id = 5},
+                    [](const mfem::FiniteElement& e,
+                       const mfem::ElementTransformation&) noexcept
+                        -> const mfem::IntegrationRule& {
+                      return mfem::IntRules.Get(e.GetGeomType(), 2);
+                    }) |
+                or_die;
+  const auto n = qspace->getNumberOfIntegrationPoints();
+  for (const auto l : {mgis::FieldLayout::POINT_BY_POINT,
+                       mgis::FieldLayout::COMPONENT_BY_COMPONENT}) {
+    const auto name =
+        std::string{"PlaneStressSaintVenantKirchhoffElasticity"} +
+        (l == mgis::FieldLayout::POINT_BY_POINT ? " (point by point)"
+                                                : " (component by component)");
+    auto b = mfem_mgis::load(ctx, library,
+                             "PlaneStressSaintVenantKirchhoffElasticity",
+                             Hypothesis::PLANESTRESS);
+    if (isInvalid(b)) {
+      std::cerr << ctx.getErrorMessage() << '\n';
+      ++failures;
+      return;
+    }
+    auto m = Material(qspace, std::move(b), l);
+    const auto o = mgis::behaviour::getAxialDeformationGradientOffset(m.b);
+    if (!o.has_value()) {
+      check(false, name + ": no axial deformation gradient");
+      continue;
+    }
+    check(*o == 4, name + ": invalid offset of the axial deformation gradient");
+    const auto nisvs = getArraySize(m.b.isvs, m.b.hypothesis);
+    for (auto* s : {&m.s0, &m.s1}) {
+      const auto isvs = mgis::behaviour::getInternalStateVariablesView(*s);
+      auto initialized = n != 0;
+      for (size_type i = 0; i != n; ++i) {
+        for (size_type c = 0; c != nisvs; ++c) {
+          initialized = initialized && (isvs(i, c) == (c == *o ? 1 : 0));
+        }
+      }
+      check(initialized,
+            name + ": internal state variables not initialized (one for "
+                   "the axial deformation gradient, zero otherwise)");
+    }
+  }
+}  // end of testAxialDeformationGradient
