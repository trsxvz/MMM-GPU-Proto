--- /dev/null
+++ b/cmake/modules/MFEMMGISBehaviours.cmake
@@ -0,0 +1,141 @@
+# Behaviour libraries generated by MFront for the CPU and for the GPU.
+#
+# usage:
+#
+#   mfem_mgis_add_behaviours_library(<target>
+#     SOURCES <files.mfront>...
+#     [LIBRARIES <names>...]
+#     [INCLUDE_DIRECTORY <directory>]
+#     [DEPENDS <files>...]
+#     [EXCLUDE_FROM_ALL])
+#
+# builds, with MFront (the variable MFRONT, or the program mfront found in
+# the path), in the directory <dir> = <current binary directory>/<target>:
+#
+# - the libraries for the CPU, generated by the generic interface:
+#   <dir>/cpu/lib<name>.so;
+# - if MFEM is built with CUDA (resp. HIP) and the configuration file
+#   config-cuda-nvcc.json (resp. config-hip-hipcc.json) is provided by TFEL,
+#   the libraries for the GPU, generated by the generic-parallel interface:
+#   <dir>/gpu/lib<name>.so.
+#
+# <name> is each name given after LIBRARIES (Behaviour by default): the
+# material of the sources (@Material keyword), or Behaviour for the sources
+# without material. MFront generates, for the generic interface,
+# libBehaviour.so for the sources without material and lib<name>-generic.so
+# for the material <name>, and, for the generic-parallel interface,
+# libGenericParallel<name>-<backend>.so. The directory given after INCLUDE_DIRECTORY is
+# searched for the files included by the sources (@MaterialLaw,
+# @Includes), and the files given after DEPENDS (for instance these
+# included files) are dependencies of the libraries. The custom target
+# <target> builds the libraries (built by default, unless EXCLUDE_FROM_ALL
+# is given). The variable <target>_BEHAVIOURS_DIRECTORY is set to <dir> in
+# the scope of the caller, and <target>_HAVE_GPU_BEHAVIOURS to true if the
+# libraries for the GPU are built.
+#
+# At run time, mfem_mgis::getBehavioursLibrary(<dir>, <name>) returns the
+# library computing where the execution settings place the behaviours (see
+# the option --execution).
+function(mfem_mgis_add_behaviours_library target)
+  cmake_parse_arguments(_b "EXCLUDE_FROM_ALL" "INCLUDE_DIRECTORY"
+                        "SOURCES;LIBRARIES;DEPENDS" ${ARGN})
+  if(NOT _b_SOURCES)
+    message(FATAL_ERROR "mfem_mgis_add_behaviours_library: no source given")
+  endif()
+  if(NOT MFRONT)
+    find_program(MFRONT mfront)
+    if(NOT MFRONT)
+      message(FATAL_ERROR "mfem_mgis_add_behaviours_library: mfront not found")
+    endif()
+  endif()
+  set(_names ${_b_LIBRARIES})
+  if(NOT _names)
+    set(_names Behaviour)
+  endif()
+  set(_include)
+  if(_b_INCLUDE_DIRECTORY)
+    set(_include "--include=${_b_INCLUDE_DIRECTORY}")
+  endif()
+  set(_sources)
+  foreach(_source ${_b_SOURCES})
+    get_filename_component(_absolute "${_source}" ABSOLUTE)
+    list(APPEND _sources "${_absolute}")
+  endforeach()
+  set(_directory "${CMAKE_CURRENT_BINARY_DIR}/${target}")
+  set(_suffix "${CMAKE_SHARED_LIBRARY_SUFFIX}")
+  # backend of the generic-parallel interface for the GPU of MFEM
+  get_property(_cuda GLOBAL PROPERTY MFEM_MGIS_MFEM_USE_CUDA)
+  get_property(_hip GLOBAL PROPERTY MFEM_MGIS_MFEM_USE_HIP)
+  set(_gpu_backend)
+  set(_gpu_configuration)
+  if(_cuda STREQUAL "YES")
+    set(_gpu_backend cuda)
+    set(_gpu_configuration config-cuda-nvcc.json)
+  elseif(_hip STREQUAL "YES")
+    set(_gpu_backend hip)
+    set(_gpu_configuration config-hip-hipcc.json)
+  endif()
+  if(_gpu_backend)
+    get_filename_component(_mfront_bin "${MFRONT}" DIRECTORY)
+    if(NOT EXISTS "${_mfront_bin}/../share/tfel/mfront/configuration-files/${_gpu_configuration}")
+      set(_gpu_backend)
+    endif()
+  endif()
+  # libraries for the CPU: generic interface
+  set(_outputs)
+  set(_links)
+  foreach(_name ${_names})
+    if(_name STREQUAL "Behaviour")
+      set(_library "libBehaviour${_suffix}")
+    else()
+      set(_library "lib${_name}-generic${_suffix}")
+    endif()
+    list(APPEND _outputs "${_directory}/cpu-build/src/${_library}")
+    list(APPEND _links
+         COMMAND ${CMAKE_COMMAND} -E create_symlink
+                 "../cpu-build/src/${_library}"
+                 "${_directory}/cpu/lib${_name}${_suffix}")
+  endforeach()
+  file(MAKE_DIRECTORY "${_directory}/cpu-build" "${_directory}/cpu")
+  add_custom_command(
+    OUTPUT ${_outputs}
+    COMMAND "${MFRONT}" --obuild --interface=generic ${_include} ${_sources}
+    ${_links}
+    WORKING_DIRECTORY "${_directory}/cpu-build"
+    DEPENDS ${_sources} ${_b_DEPENDS}
+    COMMENT "MFront: behaviours of ${target} (CPU)")
+  set(_all ${_outputs})
+  # libraries for the GPU: generic-parallel interface
+  if(_gpu_backend)
+    set(_outputs)
+    set(_links)
+    foreach(_name ${_names})
+      set(_library "libGenericParallel${_name}-${_gpu_backend}${_suffix}")
+      list(APPEND _outputs "${_directory}/gpu-build/src/${_library}")
+      list(APPEND _links
+           COMMAND ${CMAKE_COMMAND} -E create_symlink
+                   "../gpu-build/src/${_library}"
+                   "${_directory}/gpu/lib${_name}${_suffix}")
+    endforeach()
+    file(MAKE_DIRECTORY "${_directory}/gpu-build" "${_directory}/gpu")
+    add_custom_command(
+      OUTPUT ${_outputs}
+      COMMAND "${MFRONT}" --obuild --interface=generic-parallel
+              "--configuration-file=${_gpu_configuration}" ${_include}
+              ${_sources}
+      ${_links}
+      WORKING_DIRECTORY "${_directory}/gpu-build"
+      DEPENDS ${_sources} ${_b_DEPENDS}
+      COMMENT "MFront: behaviours of ${target} (GPU, ${_gpu_backend})")
+    list(APPEND _all ${_outputs})
+    set(${target}_HAVE_GPU_BEHAVIOURS TRUE PARENT_SCOPE)
+  else()
+    set(${target}_HAVE_GPU_BEHAVIOURS FALSE PARENT_SCOPE)
+  endif()
+  if(_b_EXCLUDE_FROM_ALL)
+    add_custom_target(${target} DEPENDS ${_all})
+  else()
+    add_custom_target(${target} ALL DEPENDS ${_all})
+  endif()
+  set(${target}_BEHAVIOURS_DIRECTORY "${_directory}" PARENT_SCOPE)
+endfunction()
