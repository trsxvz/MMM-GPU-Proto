 src/AmgXKernels.hxx      |  8 ++++++
 src/AmgXSolvers.cxx      | 42 +++++++++++++++++--------------
 src/AmgXSolvers.hxx      | 25 ++++++++++++-------
 tests/AmgXSolverTest.cxx | 53 +++++++++++++++++++++++++++++++++++++---
 5 files changed, 112 insertions(+), 31 deletions(-)

