diff --git a/src/Config.cxx b/src/Config.cxx
index e5b01539c6..b5c828ce45 100644
--- a/src/Config.cxx
+++ b/src/Config.cxx
@@ -172,6 +172,48 @@ namespace mfem_mgis {
 #endif
   }  // end of setHypreDevicePoolSize
 
+  /*!
+   * \return true if a configuration of the device of MFEM uses a GPU
+   * (`cuda`, `hip`, `gpu` and their variants `ceed-cuda`, `raja-gpu`, ...)
+   * \param[in] configuration: configuration of the device
+   */
+  static bool usesGPU(const char* const configuration) {
+    const auto c = std::string_view{configuration};
+    return (c.find("cuda") != std::string_view::npos) ||
+           (c.find("hip") != std::string_view::npos) ||
+           (c.find("gpu") != std::string_view::npos);
+  }  // end of usesGPU
+
+  /*!
+   * \brief sets the memory types of MFEM before the configuration of its
+   * device, unless they are given by the environment (variable
+   * `MFEM_MEMORY`, or `MFEM_DEVICE`, with which MFEM ignores this call): the
+   * standard memory of the host, and the default memory of the device
+   * (Umpire if MFEM is compiled with it). MFEM compiled with Umpire
+   * otherwise allocates the memory of the host with Umpire too, which
+   * records each allocation, including the temporaries of the loops over the
+   * elements made on the host: post-processings, assemblies on the host and
+   * exports were about five times slower.
+   * \param[in] configuration: configuration of the device
+   */
+  static void setMemoryTypes(const char* const configuration) {
+    if (std::getenv("MFEM_MEMORY") != nullptr) {
+      return;
+    }
+    if (!usesGPU(configuration)) {
+      mfem::Device::SetMemoryTypes(mfem::MemoryType::HOST,
+                                   mfem::MemoryType::HOST);
+      return;
+    }
+#ifdef MFEM_USE_UMPIRE
+    mfem::Device::SetMemoryTypes(mfem::MemoryType::HOST,
+                                 mfem::MemoryType::DEVICE_UMPIRE);
+#else  /* MFEM_USE_UMPIRE */
+    mfem::Device::SetMemoryTypes(mfem::MemoryType::HOST,
+                                 mfem::MemoryType::DEVICE);
+#endif /* MFEM_USE_UMPIRE */
+  }  // end of setMemoryTypes
+
   /*!
    * \return the identifier of the GPU used by this process: the processes
    * of a node use the GPUs of the node in turn (several processes may share
@@ -181,12 +223,8 @@ namespace mfem_mgis {
   static int getDeviceIdentifier(const char* const configuration) {
 #if defined(MFEM_USE_CUDA) || defined(MFEM_USE_HIP)
     // MFEM aborts if the number of GPUs is queried on a machine without GPU:
-    // it is only queried for a configuration using a GPU (`cuda`, `hip`,
-    // `gpu` and their variants `ceed-cuda`, `raja-gpu`, ...)
-    const auto c = std::string_view{configuration};
-    if ((c.find("cuda") == std::string_view::npos) &&
-        (c.find("hip") == std::string_view::npos) &&
-        (c.find("gpu") == std::string_view::npos)) {
+    // it is only queried for a configuration using a GPU
+    if (!usesGPU(configuration)) {
       return 0;
     }
     const auto n = mfem::Device::GetDeviceCount();
@@ -344,6 +382,7 @@ namespace mfem_mgis {
             "option '--device' can't be used");
       }
       const auto identifier = getDeviceIdentifier(device_configuration);
+      setMemoryTypes(device_configuration);
       this->device =
           std::make_unique<mfem::Device>(device_configuration, identifier);
       // the kernels are launched asynchronously on a GPU: the profiling
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 2f7b99beb8..dd9678019d 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -1284,6 +1284,23 @@ add_test(NAME DeviceOptionTest-debug
          COMMAND DeviceOptionTest --device debug --expected debug)
 add_test(NAME DeviceOptionTest-debug-short
          COMMAND DeviceOptionTest -dev debug --expected debug)
+# a device on the host or on a GPU, with the standard memory of the host
+# (MFEM compiled with Umpire allocates it with Umpire by default), unless
+# the variable MFEM_MEMORY of MFEM gives it
+add_test(NAME DeviceOptionTest-cpu
+         COMMAND DeviceOptionTest --device cpu --expected cpu)
+if(MFEM_USE_UMPIRE STREQUAL "YES")
+  add_test(NAME DeviceOptionTest-cpu-umpire
+           COMMAND DeviceOptionTest --device cpu --expected cpu
+                   --expected-host-memory umpire)
+  set_tests_properties(DeviceOptionTest-cpu-umpire PROPERTIES
+                       ENVIRONMENT MFEM_MEMORY=umpire)
+endif()
+if((MFEM_USE_CUDA STREQUAL "YES") AND enable-gpu-tests)
+  add_test(NAME DeviceOptionTest-cuda
+           COMMAND DeviceOptionTest --device cuda --expected gpu)
+  set_tests_properties(DeviceOptionTest-cuda PROPERTIES RESOURCE_LOCK gpu)
+endif()
 # KokkosOptionTest executable: the option --kokkos and the variable
 # MFEM_MGIS_KOKKOS initialize Kokkos if mfem-mgis is built with Kokkos;
 # otherwise, the option is refused and the variable is ignored with a
diff --git a/tests/DeviceOptionTest.cxx b/tests/DeviceOptionTest.cxx
index f8caf11a9d..e5ab655d93 100644
--- a/tests/DeviceOptionTest.cxx
+++ b/tests/DeviceOptionTest.cxx
@@ -9,18 +9,59 @@
 #include <cstring>
 #include <iostream>
 #include "mfem/general/device.hpp"
+#include "mfem/general/mem_manager.hpp"
 #include "mfem/general/optparser.hpp"
 #include "MFEMMGIS/Config.hxx"
 
+/*!
+ * \return true if the memory types of MFEM are the expected ones
+ * \param[in] expected_host_memory: expected memory of the host, `host`
+ * (standard memory) or `umpire`
+ * \param[in] gpu: if true, the device uses a GPU
+ */
+static bool checkMemoryTypes(const char* const expected_host_memory,
+                             const bool gpu) {
+  const auto host = mfem::Device::GetHostMemoryType();
+  const auto device = mfem::Device::GetDeviceMemoryType();
+  std::cout << "memory of the host: " << mfem::MemoryTypeName[int(host)]
+            << ", memory of the device: " << mfem::MemoryTypeName[int(device)]
+            << '\n';
+  if (std::strcmp(expected_host_memory, "umpire") == 0) {
+    return host == mfem::MemoryType::HOST_UMPIRE;
+  }
+  if (std::strcmp(expected_host_memory, "host") != 0) {
+    std::cerr << "invalid expected memory of the host '" << expected_host_memory
+              << "'\n";
+    return false;
+  }
+  if (host != mfem::MemoryType::HOST) {
+    return false;
+  }
+  if (!gpu) {
+    return true;
+  }
+  // default memory of the device of MFEM
+#ifdef MFEM_USE_UMPIRE
+  return device == mfem::MemoryType::DEVICE_UMPIRE;
+#else  /* MFEM_USE_UMPIRE */
+  return device == mfem::MemoryType::DEVICE;
+#endif /* MFEM_USE_UMPIRE */
+}  // end of checkMemoryTypes
+
 int main(int argc, char** argv) {
   mfem_mgis::initialize(argc, argv);
   // `none` if no device is expected, `debug` if the debug device of MFEM is
-  // expected
+  // expected, `cpu` for a device on the host, `gpu` for a device on a GPU
   const char* expected = "none";
+  // expected memory of the host for the `cpu` and `gpu` devices: `host` or
+  // `umpire`
+  const char* expected_host_memory = "host";
   auto args = mfem::OptionsParser(argc, argv);
   mfem_mgis::declareDefaultOptions(args);
   args.AddOption(&expected, "-e", "--expected",
-                 "expected device: none or debug");
+                 "expected device: none, debug, cpu or gpu");
+  args.AddOption(&expected_host_memory, "-ehm", "--expected-host-memory",
+                 "expected memory of the host: host or umpire");
   args.Parse();
   if (!args.Good()) {
     args.PrintUsage(std::cerr);
@@ -28,15 +69,22 @@ int main(int argc, char** argv) {
   }
   const auto configured = mfem::Device::IsConfigured();
   const auto debug = mfem::Device::Allows(mfem::Backend::DEBUG_DEVICE);
+  const auto gpu =
+      mfem::Device::Allows(mfem::Backend::CUDA_MASK | mfem::Backend::HIP_MASK);
   auto success = false;
   if (std::strcmp(expected, "none") == 0) {
     success = !configured;
   } else if (std::strcmp(expected, "debug") == 0) {
     success = configured && debug;
+  } else if (std::strcmp(expected, "cpu") == 0) {
+    success = configured && !debug && !gpu &&
+              checkMemoryTypes(expected_host_memory, false);
+  } else if (std::strcmp(expected, "gpu") == 0) {
+    success = configured && gpu && checkMemoryTypes(expected_host_memory, true);
   } else {
     std::cerr << "invalid expected device '" << expected << "'\n";
   }
   std::cout << "device configured: " << configured
-            << ", debug device: " << debug << '\n';
+            << ", debug device: " << debug << ", GPU: " << gpu << '\n';
   return success ? EXIT_SUCCESS : EXIT_FAILURE;
 }  // end of main
