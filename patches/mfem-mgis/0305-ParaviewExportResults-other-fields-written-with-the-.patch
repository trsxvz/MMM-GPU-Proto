+              ": the displacement and the other field are not written in "
+              "the same file, on one mesh");
+  }
+  if (!parallel) {
+    checkFieldOnAnotherMesh(ctx, problem, prefix + "-other-mesh");
   }
   std::cout << (failures == 0 ? "success" : "failure") << '\n';
