+                         "HIPFLAGS=${_hip_flags}" HIP_PLATFORM=amd)
   endif()
   if(_b_NO_GPU)
     set(_gpu_backend)
@@ -137,7 +152,8 @@ function(mfem_mgis_add_behaviours_library target)
     file(MAKE_DIRECTORY "${_directory}/gpu-build" "${_directory}/gpu")
     add_custom_command(
       OUTPUT ${_outputs}
-      COMMAND "${MFRONT}" --obuild --interface=generic-parallel
+      COMMAND ${_gpu_environment} "${MFRONT}" --obuild
