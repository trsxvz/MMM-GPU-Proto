 CMakeLists.txt                                |  12 +-
 cmake/modules/FindMFEM.cmake                  |  34 +-
 cmake/modules/MFEMMGISBehaviours.cmake        |  20 +-
 cmake/modules/MFEMMGISDeviceCode.cmake        | 193 +++++--
 .../installation_guide/installation_guide.rst |  24 +-
 docs/source/user_guide/batch_computations.rst |  17 +-
 src/CMakeLists.txt                            |  17 +-
 src/MFEMMGISConfig.cmake.in                   |  19 +
 tests/CMakeLists.txt                          | 540 +++++++++---------
 tests/MFEMFieldOperationsTest.cxx             |   8 +-
 10 files changed, 527 insertions(+), 357 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6b74f20e3f..b070f5fe9d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -43,18 +43,22 @@ if(MFEM_DIR)
   set(MFEM_MGIS_MFEM_DIR "${MFEM_DIR}")
 endif(MFEM_DIR)
 find_package(MFEM REQUIRED)
-# MFEM compiled with CUDA: the sources containing kernels of MFEM are
-# compiled as CUDA code (see `MFEMMGISDeviceCode.cmake`)
+# MFEM compiled with CUDA or HIP: the sources containing kernels of MFEM
+# are compiled as CUDA or HIP code (see `MFEMMGISDeviceCode.cmake`)
 mfem_mgis_enable_device_language()
-# CUDA toolkit used to build mfem-mgis, written in its configuration file
+# CUDA toolkit or ROCm used to build mfem-mgis, written in its configuration
+# file
 if(MFEM_USE_CUDA STREQUAL "YES")
   get_filename_component(MFEM_MGIS_CUDA_TOOLKIT_ROOT "${CUDAToolkit_BIN_DIR}"
                          DIRECTORY)
 endif()
+if(MFEM_USE_HIP STREQUAL "YES")
+  set(MFEM_MGIS_HIP_DIR "${hip_DIR}")
+endif()
 # description of MFEM written in the configuration file of mfem-mgis, for
 # the projects which find MFEM before mfem-mgis
 foreach(_property USE_CUDA USE_HIP CUDA_COMPILER CUDA_HOST_COMPILER
-                  CUDA_ARCHITECTURES)
+                  CUDA_ARCHITECTURES HIP_COMPILER HIP_ARCHITECTURES)
   get_property(MFEM_MGIS_MFEM_${_property} GLOBAL
                PROPERTY MFEM_MGIS_MFEM_${_property})
 endforeach(_property)
diff --git a/cmake/modules/FindMFEM.cmake b/cmake/modules/FindMFEM.cmake
index d9112a5612..d2e933e69e 100644
--- a/cmake/modules/FindMFEM.cmake
+++ b/cmake/modules/FindMFEM.cmake
@@ -17,10 +17,11 @@
 #   - MFEM_LIBRARY_DIRS
 # and the variables of the `config.mk` file of MFEM (`MFEM_USE_CUDA`, ...).
 #
-# When MFEM is compiled with CUDA, the sources containing kernels of MFEM
-# must be compiled as CUDA code: see `MFEMMGISDeviceCode.cmake`, loaded by
-# this file (`mfem_mgis_enable_device_language`,
-# `mfem_mgis_compile_as_device_code`). CMake 3.18 is then required.
+# When MFEM is compiled with CUDA or HIP, the sources containing kernels of
+# MFEM must be compiled as CUDA or HIP code: see `MFEMMGISDeviceCode.cmake`,
+# loaded by this file (`mfem_mgis_enable_device_language`,
+# `mfem_mgis_compile_as_device_code`). CMake 3.18 (CUDA) or 3.21 (HIP) is
+# then required.
 
 # FIXME: Perhaps I should try to assert that we're building against
 # the same hypre library MFEM built on?
@@ -182,6 +183,31 @@ if(MFEM_USE_CUDA STREQUAL "YES")
   set_property(TARGET MFEM::mfem APPEND
     PROPERTY INTERFACE_LINK_LIBRARIES CUDA::cudart)
 endif()
+# MFEM compiled with HIP: its headers include the headers of HIP
+# (`hip/hip_runtime.h`, ...), found by the C++ compiler through the target
+# `hip::host` of ROCm, which also gives the HIP runtime used by MFEM (linked
+# by hipcc, so not named in its external libraries)
+if(MFEM_USE_HIP STREQUAL "YES")
+  # the ROCm of the hipcc used to compile MFEM
+  if((NOT DEFINED hip_ROOT) AND (MFEM_CXX MATCHES "hipcc$"))
+    get_filename_component(_mfem_hip_bin "${MFEM_CXX}" DIRECTORY)
+    get_filename_component(hip_ROOT "${_mfem_hip_bin}" DIRECTORY)
+  endif()
+  # MFEM compiled with HIP uses the libraries of ROCm (rocsparse, ...): the
+  # platform is AMD, whatever the environment variable HIP_PLATFORM (which
+  # may select the NVIDIA platform for other codes)
+  if(NOT DEFINED HIP_PLATFORM)
+    set(HIP_PLATFORM amd)
+  endif()
+  # `hip_ROOT` is used (policy CMP0074, not set by the minimum version of
+  # CMake required by mfem-mgis)
+  cmake_policy(PUSH)
+  cmake_policy(SET CMP0074 NEW)
+  find_package(hip CONFIG REQUIRED)
+  cmake_policy(POP)
+  set_property(TARGET MFEM::mfem APPEND
+    PROPERTY INTERFACE_LINK_LIBRARIES hip::host)
+endif()
 set_property(TARGET MFEM::mfem APPEND
     PROPERTY INTERFACE_LINK_LIBRARIES ${MFEM_EXT_LIBS_LIST})
 
