@@ -74,12 +77,24 @@ function(mfem_mgis_add_behaviours_library target)
   get_property(_hip GLOBAL PROPERTY MFEM_MGIS_MFEM_USE_HIP)
   set(_gpu_backend)
   set(_gpu_configuration)
+  set(_gpu_environment)
   if(_cuda STREQUAL "YES")
     set(_gpu_backend cuda)
     set(_gpu_configuration config-cuda-nvcc.json)
   elseif(_hip STREQUAL "YES")
     set(_gpu_backend hip)
     set(_gpu_configuration config-hip-hipcc.json)
