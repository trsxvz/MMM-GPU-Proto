+        list(APPEND _hip_archs ${_a})
+      endif()
+    endforeach(_flag)
+    list(REMOVE_DUPLICATES _hip_archs)
+    if(NOT _hip_archs)
+      message(WARNING "mfem-mgis: the GPU architectures of MFEM are not "
+              "found in its compilation flags (${cxxflags}): the sources "
