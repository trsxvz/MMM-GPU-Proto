   std::optional<PartialQuadratureFunction> getGradient(
       Context &ctx,
       Material &m,
       const std::string_view n,
       const Material::StateSelection s) noexcept {
+    if (!checkPointByPointLayout(ctx, m)) {
+      return {};
+    }
