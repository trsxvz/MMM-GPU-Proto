+        [this, &ctx, &blocks, &data](const mgis::FieldView<const real>& Kb) {
+          return batch::addFBarStiffnessMatricesNodalBlocks(
+              ctx, blocks, this->fbar_data, this->quadrature_space, Kb,
+              *(data.geometry), data.kind);
