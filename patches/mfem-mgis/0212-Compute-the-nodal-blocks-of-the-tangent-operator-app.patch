+      addTangentOperatorNodalBlocksByKernels(
+          Context& ctx,
+          mfem::Vector& blocks,
+          const batch::ElementsGeometrySet& g) noexcept {
+    auto data = KernelsData{};
+    if (!this->prepareFBarTangentOperatorForKernels(
+            ctx, data, "addTangentOperatorNodalBlocksByKernels", g)) {
+      return false;
