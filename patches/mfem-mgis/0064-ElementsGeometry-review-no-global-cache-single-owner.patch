+       {std::pair{0., 0.}, std::pair{1., 0.}, std::pair{1., 1.},
+        std::pair{0., 1.}, std::pair{2., 0.5}}) {
+    mixed.AddVertex(x, y);
+  }
+  mixed.AddQuad(0, 1, 2, 3);
+  mixed.AddTriangle(1, 4, 2);
+  mixed.FinalizeMesh();
+  refused(mixed, "mesh mixing triangles and quadrangles");
