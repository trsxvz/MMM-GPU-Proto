+  /*!
+   * \brief computes, or adds, the mass matrices of all the elements of a
+   * scalar finite element space, `N_i N_j w det J` summed over the points of
+   * the integration rule of the geometric data, in the layout of the
+   * element matrices of MFEM (`nd x nd x ne`, native ordering of the
+   * degrees of freedom), on the device if a device is enabled
+   * \return true on success
+   * \param[in, out] ctx: execution context
+   * \param[in, out] m: mass matrices
+   * \param[in] g: geometric data of the finite element space
+   * \param[in] add: if true, the mass matrices are added to `m`
+   */
+  MFEM_MGIS_EXPORT [[nodiscard]] bool computeMassMatrices(
+      Context&, mfem::Vector&, const ElementsGeometry&, const bool) noexcept;
+
 }  // end of namespace mfem_mgis::batch
 
 #endif /* LIB_MFEM_MGIS_BATCH_INTEGRATIONPOINTSFUNCTIONS_HXX */
diff --git a/src/Batch/IntegrationPointsFunctions.cxx b/src/Batch/IntegrationPointsFunctions.cxx
index 5646531580..f794011551 100644
--- a/src/Batch/IntegrationPointsFunctions.cxx
+++ b/src/Batch/IntegrationPointsFunctions.cxx
@@ -269,4 +269,45 @@ namespace mfem_mgis::batch {
 #endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
   }  // end of computeLocalProjections
 
+  bool computeMassMatrices(Context& ctx,
+                           mfem::Vector& m,
+                           const ElementsGeometry& g,
+                           const bool add) noexcept {
+#ifndef MFEM_MGIS_HAVE_DEVICE_SOURCES
+    static_cast<void>(m);
+    static_cast<void>(g);
+    static_cast<void>(add);
+    return ctx.registerErrorMessage(
+        getUnavailableKernelsMessage("computeMassMatrices"));
+#else  /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+    const auto* const name = "computeMassMatrices";
+    if ((g.rule == nullptr) || (g.maps == nullptr) ||
+        (g.jacobians == nullptr)) {
+      return ctx.registerErrorMessage(std::string{name} +
+                                      ": invalid geometric data");
+    }
+    if (static_cast<std::int64_t>(m.Size()) !=
+        std::int64_t{g.nd} * g.nd * g.ne) {
+      return ctx.registerErrorMessage(std::string{name} +
+                                      ": unexpected size of the mass matrices");
+    }
+    if (g.ne == 0) {
+      return true;
+    }
+    try {
+      const auto use_device = mfem::Device::IsEnabled();
+      auto a = internals::IntegrationRuleKernelArguments{};
+      a.shape_functions = g.maps->B.Read(use_device);
+      a.determinants = g.jacobians->detJ.Read(use_device);
+      a.weights = g.weights.Read(use_device);
+      a.nq = g.nq;
+      auto* const r = add ? m.ReadWrite(use_device) : m.Write(use_device);
+      internals::launchMassMatricesKernel(a, g.nd, g.ne, r, add, use_device);
+    } catch (...) {
+      return ctx.registerErrorMessage(getExceptionMessage(name));
+    }
+    return true;
+#endif /* MFEM_MGIS_HAVE_DEVICE_SOURCES */
+  }  // end of computeMassMatrices
+
 }  // end of namespace mfem_mgis::batch
diff --git a/src/Batch/IntegrationPointsFunctionsKernels.cxx b/src/Batch/IntegrationPointsFunctionsKernels.cxx
index 7b69f77a2f..ce198ef97e 100644
--- a/src/Batch/IntegrationPointsFunctionsKernels.cxx
+++ b/src/Batch/IntegrationPointsFunctionsKernels.cxx
@@ -152,4 +152,34 @@ namespace mfem_mgis::batch::internals {
         });
   }  // end of launchLocalProjectionsKernel
 
+  void launchMassMatricesKernel(const IntegrationRuleKernelArguments& m,
+                                const int nd,
+                                const int ne,
+                                real* const r,
+                                const bool add,
+                                const bool use_device) {
+    mfem::forall_switch(
+        use_device, ne, [m, nd, r, add] MFEM_HOST_DEVICE(int k) {
+          const auto e = static_cast<std::size_t>(k);
+          const auto nq = static_cast<std::size_t>(m.nq);
+          const auto n = static_cast<std::size_t>(nd);
+          auto* const re = r + n * n * e;
+          if (!add) {
+            for (std::size_t i = 0; i != n * n; ++i) {
+              re[i] = real{0};
+            }
+          }
+          // same operations as the mass integrator of MFEM
+          for (std::size_t q = 0; q != nq; ++q) {
+            const auto w = m.weights[q] * m.determinants[q + nq * e];
+            for (std::size_t j = 0; j != n; ++j) {
+              const auto wNj = w * m.shape_functions[q + nq * j];
+              for (std::size_t i = 0; i != n; ++i) {
+                re[i + n * j] += wNj * m.shape_functions[q + nq * i];
+              }
+            }
+          }
+        });
+  }  // end of launchMassMatricesKernel
+
 }  // end of namespace mfem_mgis::batch::internals
