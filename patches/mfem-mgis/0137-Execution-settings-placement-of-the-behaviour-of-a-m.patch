-  bool checkBehaviourExecutionLocation(Context& ctx,
-                                       const Behaviour& b) noexcept {
-    if (!isExecutionModeSpecified()) {
+  std::optional<std::pair<std::optional<ExecutionLocation>, Parameters>>
+  extractBehaviourExecutionLocation(Context& ctx,
+                                    const Parameters& p) noexcept {
+    const auto* const n = behaviour_execution_location_parameter;
+    if (!contains(p, n)) {
+      return std::pair{std::optional<ExecutionLocation>{}, p};
+    }
+    const auto ol = get<std::string>(ctx, p, n);
+    if (isInvalid(ol)) {
+      return {};
+    }
+    if ((*ol != "cpu") && (*ol != "gpu")) {
+      return ctx.registerErrorMessage("invalid value '" + *ol +
+                                      "' for parameter '" + std::string{n} +
+                                      "' (expected 'cpu' or 'gpu')");
+    }
+    const auto l =
+        *ol == "gpu" ? ExecutionLocation::GPU : ExecutionLocation::CPU;
+    return std::pair{std::optional<ExecutionLocation>{l},
+                     remove(p, std::vector<std::string>{n})};
+  }  // end of extractBehaviourExecutionLocation
+
+  bool checkBehaviourExecutionLocation(
+      Context& ctx,
+      const Behaviour& b,
+      const std::optional<ExecutionLocation> l) noexcept {
+    if ((!isExecutionModeSpecified()) && (!l.has_value())) {
       return true;
     }
-    const auto requested = getExecutionSettings().behaviours;
+    const auto requested =
+        l.has_value() ? *l : getExecutionSettings().behaviours;
     // the behaviours integrated on a device which is not a GPU (debug device
     // of MFEM) are integrated on the CPU; a library generated by the
     // generic-parallel interface for a device can't compute on the host
