-- The post-processings read the materials on the host: the arrays of the
-  materials are synchronized on the host before their execution, keeping
-  their copies on the device valid. After a computation on the device, a
-  direct access to the states (:code:`s0`, :code:`s1`) or to the tangent
-  operator blocks (:code:`K`) of a material must be preceded by a call to
+- The arrays of the materials are copied to the host only when they are
+  read or written there: each post-processing makes valid on the host the
+  arrays it reads, keeping their copies on the device valid, and the
+  arrays it does not read stay on the device (for instance, the mean
+  values computed by kernels, see
+  :code:`MFEM_MGIS_POST_PROCESSINGS_COMPUTATION`, read the thermodynamic
+  forces on the device). After a computation on the device, a direct
+  access to the states (:code:`s0`, :code:`s1`) or to the tangent operator
+  blocks (:code:`K`) of a material, for instance in a post-processing given
+  as a function or between two time steps, must be preceded by a call to
   its method :code:`synchronizeOnHost`, or :code:`synchronizeOnHostForReading`
   for a read-only access. The accessors of :code:`mfem-mgis`, such as
   :code:`getInternalStateVariable`, make this call.
diff --git a/include/MFEMMGIS/AbstractNonLinearEvolutionProblem.hxx b/include/MFEMMGIS/AbstractNonLinearEvolutionProblem.hxx
index 7c6a271651..ad883249dc 100644
--- a/include/MFEMMGIS/AbstractNonLinearEvolutionProblem.hxx
+++ b/include/MFEMMGIS/AbstractNonLinearEvolutionProblem.hxx
@@ -566,6 +566,14 @@ namespace mfem_mgis {
      * \param[in, out] ctx: execution context
      * \param[in] p: post-processing
      * \return true on success
+     * \note as the post-processings of `mfem-mgis`, the function makes valid
+     * on the host the arrays of the materials it reads there: the accessors
+     * (`getThermodynamicForce`, `getInternalStateVariable`...) do it, and a
+     * direct access to the states (`s0`, `s1`) or to the tangent operator
+     * blocks (`K`) of a material is preceded by a call to
+     * `Material::synchronizeOnHostForReading` (see `MaterialArrays`). The
+     * arrays of the materials are not synchronized on the host before the
+     * post-processings.
      */
     [[nodiscard]] virtual bool addPostProcessing(
         Context &ctx,
@@ -594,6 +602,9 @@ namespace mfem_mgis {
      * \param[in] t: time at the beginning of the time step
      * \param[in] dt: time increment
      * \return true on success
+     * \note each post-processing makes valid on the host the arrays of the
+     * materials it reads there: the arrays which are not read on the host
+     * are not copied (see `addPostProcessing`)
      */
     [[nodiscard]] virtual bool executePostProcessings(
         Context &ctx, const real t, const real dt) noexcept = 0;
