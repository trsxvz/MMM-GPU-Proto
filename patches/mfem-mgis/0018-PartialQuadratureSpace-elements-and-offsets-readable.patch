From dd0510f2f21a6a839b285c9b4c2fccb451eb84e6 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 15:19:08 +0200
Subject: [PATCH] PartialQuadratureSpace: elements and offsets readable on the
 device

Besides the hash tables, the partial quadrature space holds two arrays
of the memory of MFEM (`mfem::Array<int>`): the numbers of its elements,
in increasing order (the order of their integration points), and the
offsets of their integration points (the points of the `i`-th element
are `[o[i], o[i + 1])`, the last offset being the number of points).
Unlike the hash tables, they are readable by the kernels of MFEM on the
device.

MaterialArraysTest: the arrays agree with the hash tables on a mesh with
two materials, and the offsets are read on the device.
---
 include/MFEMMGIS/PartialQuadratureSpace.hxx | 19 ++++++
 src/PartialQuadratureSpace.cxx              | 37 +++++++++--
 tests/CMakeLists.txt                        |  6 ++
 tests/MaterialArraysTest.cxx                | 73 +++++++++++++++++++++
 4 files changed, 131 insertions(+), 4 deletions(-)

diff --git a/include/MFEMMGIS/PartialQuadratureSpace.hxx b/include/MFEMMGIS/PartialQuadratureSpace.hxx
index dccd058649..2d06ece865 100644
--- a/include/MFEMMGIS/PartialQuadratureSpace.hxx
+++ b/include/MFEMMGIS/PartialQuadratureSpace.hxx
@@ -14,6 +14,7 @@
 #include <variant>
 #include <functional>
 #include <unordered_map>
+#include "mfem/general/array.hpp"
 
 #ifdef MGIS_FUNCTION_SUPPORT
 #include "MGIS/Function/SpaceConcept.hxx"
@@ -175,6 +176,20 @@ namespace mfem_mgis {
      * \return the offset
      */
     [[nodiscard]] size_type getOffset(const size_type i) const;
+    /*!
+     * \return the numbers of the elements of the space (local numbering of
+     * the finite element space), in increasing order, which is the order of
+     * their integration points. Readable on the device (`Read`), unlike the
+     * hash tables of `getOffsets`.
+     */
+    [[nodiscard]] const mfem::Array<int> &getElements() const noexcept;
+    /*!
+     * \return the offsets of the integration points of the elements: the
+     * points of the `i`-th element of `getElements` are the points
+     * `[o[i], o[i + 1])`, where `o` are the offsets. The last offset is the
+     * number of integration points. Readable on the device (`Read`).
+     */
+    [[nodiscard]] const mfem::Array<int> &getElementOffsets() const noexcept;
     //! \return the material or boundary identifier
     [[nodiscard]] size_type getId() const noexcept;
     //! \brief destructor
@@ -234,6 +249,10 @@ namespace mfem_mgis {
     std::unordered_map<size_type,  // element number (global numbering)
                        size_type>  // number of quadrature points
         number_of_quadrature_points;
+    //! \brief elements of the space, in the order of their points
+    mfem::Array<int> elements;
+    //! \brief offsets of the points of the elements (size: elements + 1)
+    mfem::Array<int> element_offsets;
     //! \brief material or boundary identifier
     size_type id;
     //! \brief number of integration points
diff --git a/src/PartialQuadratureSpace.cxx b/src/PartialQuadratureSpace.cxx
index 5fc1cec367..3f2a94e8b6 100644
--- a/src/PartialQuadratureSpace.cxx
+++ b/src/PartialQuadratureSpace.cxx
@@ -6,6 +6,8 @@
  */
 
 #include <cmath>
+#include <limits>
+#include <vector>
 #include <iterator>
 #include <algorithm>
 #include "mfem/fem/fespace.hpp"
@@ -23,12 +25,16 @@ namespace mfem_mgis {
   static size_type buildPartialQuadratureSpaceOffsets(
       std::unordered_map<size_type, size_type>& offsets,
       std::unordered_map<size_type, size_type>& number_of_quadrature_points,
+      mfem::Array<int>& elements,
+      mfem::Array<int>& element_offsets,
       const FiniteElementSpace<parallel>& fespace,
       const size_type m,
       const std::function<const mfem::IntegrationRule&(
           const mfem::FiniteElement&, const mfem::ElementTransformation&)>&
           integration_rule_selector) {
     auto ng = size_type{};
+    auto e = std::vector<int>{};
+    auto o = std::vector<int>{};
     for (size_type i = 0; i != fespace.GetNE(); ++i) {
       if (fespace.GetAttribute(i) != m) {
         continue;
@@ -36,11 +42,24 @@ namespace mfem_mgis {
       const auto& fe = *(fespace.GetFE(i));
       const auto& tr = *(fespace.GetElementTransformation(i));
       offsets[i] = ng;
+      e.push_back(static_cast<int>(i));
+      o.push_back(static_cast<int>(ng));
       const auto& ir = integration_rule_selector(fe, tr);
       const auto lng = ir.GetNPoints();
       ng += lng;
       number_of_quadrature_points[i] = lng;
     }
+    if (ng > static_cast<size_type>(std::numeric_limits<int>::max())) {
+      raise("PartialQuadratureSpace: too many integration points for MFEM");
+    }
+    o.push_back(static_cast<int>(ng));
+    // arrays in the memory of MFEM, filled on the host
+    auto copy = [](mfem::Array<int>& a, const std::vector<int>& v) {
+      a.SetSize(static_cast<int>(v.size()));
+      std::copy(v.begin(), v.end(), a.HostWrite());
+    };
+    copy(elements, e);
+    copy(element_offsets, o);
     return ng;
   }  // end of buildPartialQuadratureSpaceOffsets
 
@@ -208,8 +227,8 @@ namespace mfem_mgis {
         raise("invalid location identifier (" + std::to_string(this->id) + ")");
       }
       this->ng = buildPartialQuadratureSpaceOffsets<true>(
-          this->offsets, this->number_of_quadrature_points,
-          *(this->parallel_fespace), this->id, this->integration_rule_selector);
+          this->offsets, this->number_of_quadrature_points, this->elements,
+          this->element_offsets, *(this->parallel_fespace), this->id, this->integration_rule_selector);
       return;
     }
 #endif /* MFEM_USE_MPI */
@@ -223,8 +242,8 @@ namespace mfem_mgis {
       raise("invalid location identifier (" + std::to_string(this->id) + ")");
     }
     this->ng = buildPartialQuadratureSpaceOffsets<false>(
-        this->offsets, this->number_of_quadrature_points,
-        *(this->sequential_fespace), this->id, this->integration_rule_selector);
+        this->offsets, this->number_of_quadrature_points, this->elements,
+        this->element_offsets, *(this->sequential_fespace), this->id, this->integration_rule_selector);
   }  // end of initialize
 
   const mfem::IntegrationRule& PartialQuadratureSpace::getIntegrationRule(
@@ -371,6 +390,16 @@ namespace mfem_mgis {
     return p->second;
   }  // end of getNumberOfQuadraturePoints
 
+  const mfem::Array<int>& PartialQuadratureSpace::getElements()
+      const noexcept {
+    return this->elements;
+  }  // end of getElements
+
+  const mfem::Array<int>& PartialQuadratureSpace::getElementOffsets()
+      const noexcept {
+    return this->element_offsets;
+  }  // end of getElementOffsets
+
   PartialQuadratureSpace::~PartialQuadratureSpace() = default;
 
   template <bool parallel>
