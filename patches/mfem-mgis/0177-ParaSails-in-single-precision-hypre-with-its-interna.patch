From 3ba3b6e729021aa6fa19d2ba3df4f37d573e705d Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 14 Oct 2026 15:31:43 +0200
Subject: [PATCH] ParaSails in single precision: hypre with its internal LAPACK

With an external LAPACK, hypre 3.2.0 in single precision calls the LAPACK
routines of the double type on float arrays: src/blas/_hypre_blas.h maps
the hypre_d* names to the single precision BLAS routines when HYPRE_SINGLE
is defined, but src/lapack/_hypre_lapack.h has no such case (dpotrf,
dgetrf, dgels, dsygv...). This breaks ParaSails (no convergence), the
Gaussian elimination of types 99 and 199 of BoomerAMG, the Schwarz
smoothers, FSAI, MGR, the AIR restrictions, GSMG and LOBPCG. The default
BoomerAMG of MFEM does not use LAPACK.

hypre built with its internal BLAS and LAPACK, typed with HYPRE_Real, is
correct in single precision: the configuration warns when MFEM uses a
hypre in single precision with an external LAPACK (HYPRE_config.h checked
again at each configuration), and the ParaSails tests now run in float
(8 iterations, against no convergence in 1000 iterations with the external
LAPACK). The installation guide asks for hypre ~lapack in single
precision.
---
 CMakeLists.txt                                | 24 +++++++++++++++++++
 .../installation_guide/installation_guide.rst |  8 ++++++-
 tests/CMakeLists.txt                          | 15 ++++++------
 3 files changed, 38 insertions(+), 9 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 61d9b6242a..b262cec09e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -218,6 +218,30 @@ add_subdirectory(docs)
 include(cmake/modules/hypre.cmake)  
 set(MFEM_HYPRE_VERSION ${HYPRE_VERSION})
 add_compile_definitions(MFEM_HYPRE_VERSION=${MFEM_HYPRE_VERSION})
+# in single precision, hypre must be built with its internal LAPACK: with an
+# external LAPACK, hypre 3.2.0 calls the LAPACK routines of the double type
+# on float arrays (ParaSails, Gaussian elimination 99 and 199 of BoomerAMG,
+# Schwarz, FSAI, MGR, AIR, LOBPCG). Checked again at each configuration
+if(MFEM_USE_MPI AND (MFEM_MGIS_REAL_TYPE STREQUAL "float"))
+  set(CMAKE_REQUIRED_INCLUDES ${HYPRE_INCLUDE_DIRS})
+  set(CMAKE_REQUIRED_QUIET ON)
+  unset(MFEM_MGIS_HYPRE_LAPACK_MATCHES_REAL_TYPE CACHE)
+  check_cxx_source_compiles([[
+#include "HYPRE_config.h"
+#if defined(HYPRE_SINGLE) && !defined(HYPRE_USING_HYPRE_LAPACK)
+#error "hypre in single precision with an external LAPACK"
+#endif
+int main() { return 0; }]] MFEM_MGIS_HYPRE_LAPACK_MATCHES_REAL_TYPE)
+  unset(CMAKE_REQUIRED_INCLUDES)
+  unset(CMAKE_REQUIRED_QUIET)
+  if(NOT MFEM_MGIS_HYPRE_LAPACK_MATCHES_REAL_TYPE)
+    message(WARNING "mfem-mgis: hypre is built in single precision with an "
+            "external LAPACK, whose routines of the double type it calls on "
+            "float arrays: ParaSails and some other solvers of hypre give "
+            "wrong results. Build hypre with its internal LAPACK (spack: "
+            "hypre ~lapack)")
+  endif()
+endif()
 
 # testing
 set(CTEST_CONFIGURATION_TYPE "${JOB_BUILD_CONFIGURATION}")
diff --git a/docs/source/installation_guide/installation_guide.rst b/docs/source/installation_guide/installation_guide.rst
index d82e0e4588..ad1cffc3d9 100644
--- a/docs/source/installation_guide/installation_guide.rst
+++ b/docs/source/installation_guide/installation_guide.rst
@@ -272,7 +272,13 @@ Numerical type
 ``mfem_mgis::real``: ``double``, or ``float`` when ``MFEM`` is compiled
 in single precision (``MFEM_USE_SINGLE``, variant ``precision=single`` of
 the Spack package, which requires ``hypre`` in single precision and
-``MUMPS`` with ``+float``). Then:
+``MUMPS`` with ``+float``). ``hypre`` must then use its internal ``LAPACK``
+(variant ``~lapack`` of the Spack package): with an external ``LAPACK``,
+``hypre`` 3.2.0 in single precision calls the ``LAPACK`` routines of the
+``double`` type on ``float`` arrays, which breaks ``ParaSails``, the
+Gaussian elimination of types 99 and 199 of ``BoomerAMG`` and other
+solvers of ``hypre``. The configuration of ``mfem-mgis`` warns about such
+a ``hypre``. Then:
 
 - ``MGIS`` must be configured with the same type
   (``-DMGIS_REAL_TYPE=float``), which the configuration checks;
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 1e117606ea..c70d8ff11a 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -1393,15 +1393,14 @@ if(MFEM_MGIS_HAVE_TFEL)
     endif()
     # HypreParaSailsTest executable: ParaSails preconditioner given a new
     # operator after the destruction of the previous one, refused when hypre
-    # computes on a GPU. Not run in float: ParaSails gives NaN values from
-    # the first iteration with hypre in single precision (whose library
-    # imports the LAPACK routines dpotrf and dpotrs of the double type)
+    # computes on a GPU. In float, hypre must be built with its internal
+    # LAPACK: with an external LAPACK, hypre 3.2.0 in single precision calls
+    # the LAPACK routines of the double type (dpotrf, dpotrs) on float arrays
+    # and ParaSails does not converge
     add_test_executable(HypreParaSailsTest)
-    if(MFEM_MGIS_REAL_TYPE STREQUAL "double")
-      add_test(NAME HypreParaSailsTest COMMAND HypreParaSailsTest)
-      add_test(NAME HypreParaSailsTestP
-               COMMAND mpirun -n 2 ./HypreParaSailsTest)
-    endif()
+    add_test(NAME HypreParaSailsTest COMMAND HypreParaSailsTest)
+    add_test(NAME HypreParaSailsTestP
+             COMMAND mpirun -n 2 ./HypreParaSailsTest)
   endif(MFEM_USE_MPI)
 
 endif(MFEM_MGIS_HAVE_TFEL)
-- 
