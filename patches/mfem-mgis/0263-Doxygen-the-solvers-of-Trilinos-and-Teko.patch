From 1435043a95cca3967ea098857abfcc8db5e20189 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 16 Oct 2026 18:32:02 +0200
Subject: [PATCH] Doxygen: the solvers of Trilinos and Teko

The macros MFEM_MGIS_HAVE_TRILINOS and MFEM_MGIS_HAVE_TEKO are predefined,
so that the declarations they guard are documented, and the overrides of
the preconditioner given to Belos are documented (no warning of Doxygen
1.9.8).
---
 Doxyfile.in                   |  2 ++
 src/TrilinosTpetraBackend.hxx | 10 ++++++++++
 2 files changed, 12 insertions(+)

diff --git a/Doxyfile.in b/Doxyfile.in
index 71785050f3..36db073f85 100644
--- a/Doxyfile.in
+++ b/Doxyfile.in
@@ -1944,6 +1944,8 @@ PREDEFINED             = MFEM_USE_MPI \
                          MFEM_MGIS_HAVE_MKL_CPARDISO \
                          MFEMMGIS_HAVE_GSLIBGRIDFUNCTIONINTERPOLATOR \
                          MFEM_MGIS_HAVE_AMGX \
+                         MFEM_MGIS_HAVE_TRILINOS \
+                         MFEM_MGIS_HAVE_TEKO \
                          MFEM_MGIS_HAVE_MAGMA_SPARSE \
                          MGIS_FUNCTION_SUPPORT \
                          MGIS_HAVE_TFEL
diff --git a/src/TrilinosTpetraBackend.hxx b/src/TrilinosTpetraBackend.hxx
index 6f89788ec2..c3334f2a9a 100644
--- a/src/TrilinosTpetraBackend.hxx
+++ b/src/TrilinosTpetraBackend.hxx
@@ -1262,12 +1262,22 @@ namespace mfem_mgis::trilinos {
                              const TpetraOperatorBase* const p,
                              ExternalPreconditioner e)
           : matrix(m), trilinos(p), external(std::move(e)) {}
+      //! \return the map of the domain, the rows of the matrix
       Teuchos::RCP<const Map> getDomainMap() const override {
         return this->matrix.row_map;
       }
+      //! \return the map of the range, the rows of the matrix
       Teuchos::RCP<const Map> getRangeMap() const override {
         return this->matrix.row_map;
       }
+      /*!
+       * \brief apply the preconditioner M: Y = alpha M X + beta Y
+       * \param[in] X: vectors to which the preconditioner is applied
+       * \param[in, out] Y: result
+       * \param[in] mode: only `Teuchos::NO_TRANS` is supported
+       * \param[in] alpha: factor of M X
+       * \param[in] beta: factor of Y
+       */
       void apply(
           const MV& X,
           MV& Y,
-- 
