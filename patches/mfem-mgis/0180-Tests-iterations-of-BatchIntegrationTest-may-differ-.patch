From c4e399194531e1f4466b3d59dcc40432673756da Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Wed, 14 Oct 2026 17:40:38 +0200
Subject: [PATCH] Tests: iterations of BatchIntegrationTest may differ by two
 in float

In single precision, the relative tolerance of the Newton solver is
bounded by 100 times the machine epsilon, close to the residual after the
first iteration. On the GPU, whose assembly is not reproducible bit for
bit, a time step of BatchIntegrationTestP-cuda converged once in 1
iteration instead of 3 (one run out of ten, the unknowns and the
thermodynamic forces staying within the tolerance). The numbers of
iterations of two computations may now differ by two in single precision,
one in double as before.
---
 tests/BatchIntegrationTest.cxx | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/tests/BatchIntegrationTest.cxx b/tests/BatchIntegrationTest.cxx
index 838924fb2c..5c5afaa48f 100644
--- a/tests/BatchIntegrationTest.cxx
+++ b/tests/BatchIntegrationTest.cxx
@@ -43,6 +43,7 @@
 #include <string>
 #include <string_view>
 #include <tuple>
+#include <type_traits>
 #include <stdexcept>
 #include <utility>
 #include <vector>
@@ -1257,7 +1258,7 @@ static mfem_mgis::real getComparisonTolerance(const ComputationOptions& opts) {
  * \param[in] name: name of the comparison
  * \param[in] eps: tolerance on the relative differences. If null, the
  * numbers of iterations must be the same; otherwise, they may differ by one
- * at each time step.
+ * at each time step, two in single precision.
  */
 static void compare(const Results& r1,
                     const Results& r2,
@@ -1284,10 +1285,17 @@ static void compare(const Results& r1,
   } else {
     // rounding errors may move the convergence by one iteration, the
     // relative tolerance of the Newton algorithm being close to the
-    // precision of the computations
+    // precision of the computations. In single precision, the relative
+    // tolerance is bounded by 100 times the machine epsilon, close to the
+    // residual after the first iteration: on the GPU, whose assembly is not
+    // reproducible bit for bit, a time step converged once in 1 iteration
+    // instead of 3 (BatchIntegrationTestP-cuda, one run out of ten)
+    constexpr auto maximum_difference =
+        std::is_same_v<mfem_mgis::real, double> ? 1 : 2;
     auto close = r1.iterations.size() == r2.iterations.size();
     for (std::size_t i = 0; close && (i != r1.iterations.size()); ++i) {
-      close = std::abs(r1.iterations[i] - r2.iterations[i]) <= 1;
+      close =
+          std::abs(r1.iterations[i] - r2.iterations[i]) <= maximum_difference;
     }
     check(close, name + ": numbers of iterations");
   }
