From e4c1916ba1fec2cdf3e61cdb2a9f1f7991b33a83 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 21:13:45 +0200
Subject: [PATCH] Tests in float: MPI types, post-processings, grid functions,
 L2 projections

- four reductions of the tests used MPI_DOUBLE on real values
  (PostProcessingsKernelsTest, MicromorphicKernelsTest, L2ProjectionTest,
  AmgXSolverTest): in float, 8 bytes were written in a 4 bytes variable
  ("stack smashing detected" in parallel). They use mpi_type<real>.
- PostProcessingsKernelsTest: relative tolerances of 1e-5 (measures,
  integrals, values at the nodes), 1e-3 (L2 projections) and 1e-4
  (regularizations) in float; differences measured: 1e-6 at the nodes,
  4.4e-5 for the L2 projections.
- GridFunctionTest, GridFunctionOnSubMeshTest: tolerances of 5e-5, 5e-6 and
  2e-5 in float, ten times the errors measured.
- L2ProjectionTest: relative tolerance of 5e-3 in float, the conjugate
  gradient stopping at a relative residual of 1.2e-5 (difference measured:
  6.2e-4).
Double unchanged.
---
 tests/AmgXSolverTest.cxx             |  4 ++-
 tests/GridFunctionOnSubMeshTest.cxx  | 12 ++++++---
 tests/GridFunctionTest.cxx           |  4 ++-
 tests/L2ProjectionTest.cxx           | 11 ++++++---
 tests/MicromorphicKernelsTest.cxx    |  9 ++++---
 tests/PostProcessingsKernelsTest.cxx | 37 ++++++++++++++++++----------
 6 files changed, 52 insertions(+), 25 deletions(-)

diff --git a/tests/AmgXSolverTest.cxx b/tests/AmgXSolverTest.cxx
index 55bcdd20cc..c6f7ed31e8 100644
--- a/tests/AmgXSolverTest.cxx
+++ b/tests/AmgXSolverTest.cxx
@@ -27,6 +27,7 @@
 #include "MFEMMGIS/Parameters.hxx"
 #include "MFEMMGIS/LinearSolverFactory.hxx"
 #include "MFEMMGIS/Utilities/SolverUtilities.hxx"
+#include "MFEMMGIS/MPI.hxx"
 
 //! \brief number of failed checks
 static int failures = 0;
@@ -98,7 +99,8 @@ static double getRelativeNorm(
     const mfem::Vector& r) {
   auto m = r.Normlinf();
   if constexpr (is_parallel) {
-    MPI_Allreduce(MPI_IN_PLACE, &m, 1, MPI_DOUBLE, MPI_MAX, fespace.GetComm());
+    MPI_Allreduce(MPI_IN_PLACE, &m, 1, mfem_mgis::mpi_type<mfem::real_t>,
+                  MPI_MAX, fespace.GetComm());
   }
   const auto f = (m > 0) ? std::ldexp(1., -std::ilogb(m)) : 1.;
   auto sv = mfem::Vector(v.Size());
