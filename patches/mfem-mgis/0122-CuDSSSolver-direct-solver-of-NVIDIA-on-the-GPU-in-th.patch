diff --git a/src/CuDSSSolvers.cxx b/src/CuDSSSolvers.cxx
new file mode 100644
index 0000000000..e808094f21
--- /dev/null
+++ b/src/CuDSSSolvers.cxx
@@ -0,0 +1,91 @@
+/*!
+ * \file   src/CuDSSSolvers.cxx
+ * \brief  This file implements the solvers of the cuDSS library of NVIDIA
+ * \date   12/10/2026
+ */
+
+#include "CuDSSSolvers.hxx"
+
+#if defined(MFEM_USE_MPI) && defined(MFEM_USE_CUDSS)
+
+#include <utility>
+#include "mfem/general/error.hpp"
+
+namespace mfem_mgis::internals {
+
+  CuDSSDirectSolver::CuDSSDirectSolver(const MPI_Comm c,
+                                       const CuDSSSolverSettings& s,
+                                       const bool r)
+      : communicator(c), settings(s), reuse_analysis(r) {}
+
+  void CuDSSDirectSolver::makeSolver() {
+    // the previous solver and its device memory are released first
+    this->solver.reset();
+    this->solver = std::make_unique<mfem::CuDSSSolver>(this->communicator);
+    // the view type depends on the matrix type
+    this->solver->SetMatrixSymType(this->settings.matrix_type);
+    this->solver->SetMatrixViewType(this->settings.view);
+    this->solver->SetReorderingReuse(this->reuse_analysis);
+  }  // end of makeSolver
+
+  void CuDSSDirectSolver::SetOperator(const mfem::Operator& op) {
+    const auto* const A = dynamic_cast<const mfem::HypreParMatrix*>(&op);
+    const auto same_size = (this->solver != nullptr) &&
+                           (this->height == op.Height()) &&
+                           (this->width == op.Width());
+    if (!this->reuse_analysis) {
+      // a new analysis for each matrix, made by MFEM
+      if (!same_size) {
+        this->makeSolver();
+      }
+      this->height = op.Height();
+      this->width = op.Width();
+      this->solver->SetOperator(op);
+      ++(this->number_of_analyses);
+      return;
+    }
+    const auto same =
+        same_size && (A != nullptr) &&
+        hasPatternOnAllProcesses(*A, this->pattern, this->communicator);
+    // the pattern is forgotten until the factorization succeeds: if it
+    // fails by an exception, the next matrix is analysed again by a new
+    // solver
+    auto previous = std::exchange(this->pattern, std::nullopt);
+    if (!same) {
+      this->makeSolver();
+    }
+    this->height = op.Height();
+    this->width = op.Width();
+    this->solver->SetOperator(op);
+    if (same) {
+      this->pattern = std::move(previous);
+      return;
+    }
+    ++(this->number_of_analyses);
+    if (A != nullptr) {
+      this->pattern = getPattern(*A);
+    }
+  }  // end of SetOperator
+
+  void CuDSSDirectSolver::Mult(const mfem::Vector& x, mfem::Vector& y) const {
+    MFEM_VERIFY(this->solver != nullptr, "no operator given");
+    this->solver->Mult(x, y);
+  }  // end of Mult
+
+  void CuDSSDirectSolver::ArrayMult(const mfem::Array<const mfem::Vector*>& X,
+                                    mfem::Array<mfem::Vector*>& Y) const {
+    MFEM_VERIFY(this->solver != nullptr, "no operator given");
+    this->solver->ArrayMult(X, Y);
+  }  // end of ArrayMult
+
+  bool CuDSSDirectSolver::reusesAnalysis() const noexcept {
+    return this->reuse_analysis;
+  }  // end of reusesAnalysis
+
+  size_type CuDSSDirectSolver::getNumberOfAnalyses() const noexcept {
+    return this->number_of_analyses;
+  }  // end of getNumberOfAnalyses
+
+}  // end of namespace mfem_mgis::internals
+
+#endif /* defined(MFEM_USE_MPI) && defined(MFEM_USE_CUDSS) */
diff --git a/src/CuDSSSolvers.hxx b/src/CuDSSSolvers.hxx
new file mode 100644
index 0000000000..80483bfac0
--- /dev/null
+++ b/src/CuDSSSolvers.hxx
@@ -0,0 +1,89 @@
+/*!
+ * \file   src/CuDSSSolvers.hxx
+ * \brief  This file declares the solvers of the cuDSS library of NVIDIA
+ * (direct solver on the GPU) built by the factory of linear solvers
+ * (internal header)
+ * \date   12/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_SRC_CUDSSSOLVERS_HXX
+#define LIB_MFEM_MGIS_SRC_CUDSSSOLVERS_HXX
+
+#include "mfem/config/config.hpp"
+
+#if defined(MFEM_USE_MPI) && defined(MFEM_USE_CUDSS)
+
+#include <memory>
+#include <optional>
+#include <mpi.h>
+#include "mfem/linalg/cudss.hpp"
+#include "MFEMMGIS/Config.hxx"
+#include "HypreMatrixPattern.hxx"
+
+namespace mfem_mgis::internals {
+
+  //! \brief settings of a cuDSS solver
+  struct CuDSSSolverSettings {
+    //! \brief type of the matrices
+    mfem::CuDSSSolver::MatType matrix_type =
+        mfem::CuDSSSolver::MatType::NONSYMMETRIC;
+    //! \brief part of the matrices read by cuDSS
+    mfem::CuDSSSolver::MatViewType view = mfem::CuDSSSolver::MatViewType::FULL;
+  };
+
+  /*!
+   * \brief cuDSS solver of the factory of linear solvers.
+   *
+   * `mfem::CuDSSSolver` (MFEM 4.10) stops the program when given a matrix
+   * whose size differs from the one of the previous matrix, and the reuse
+   * of its analysis (ordering and symbolic factorization) is chosen before
+   * its first matrix, after which only the number of coefficients of the
+   * next matrices is checked (MFEM stops the program if it changes). A new
+   * `mfem::CuDSSSolver` is thus created when the size of the matrix
+   * changes and, if the analysis is reused, when its pattern changed on one
+   * process. With the reuse, the analysis of the previous matrix is reused
+   * when the new one has the same pattern on all processes, as the
+   * matrices of the successive iterations of the non linear solvers.
+   */
+  struct CuDSSDirectSolver final : public mfem::Solver {
+    /*!
+     * \brief constructor
+     * \param[in] c: communicator
+     * \param[in] s: settings
+     * \param[in] r: reuse the analysis for the matrices of the same pattern
+     */
+    CuDSSDirectSolver(MPI_Comm, const CuDSSSolverSettings&, const bool);
+    //! \brief set the operator
+    void SetOperator(const mfem::Operator&) override;
+    //! \brief solve
+    void Mult(const mfem::Vector&, mfem::Vector&) const override;
+    //! \brief solve for several right-hand sides
+    void ArrayMult(const mfem::Array<const mfem::Vector*>&,
+                   mfem::Array<mfem::Vector*>&) const override;
+    //! \return true if the analysis is reused
+    [[nodiscard]] bool reusesAnalysis() const noexcept;
+    //! \return the number of analyses made
+    [[nodiscard]] size_type getNumberOfAnalyses() const noexcept;
+
+   private:
+    //! \brief create a new solver of MFEM, the previous one being released
+    void makeSolver();
+    //! \brief communicator
+    const MPI_Comm communicator;
+    //! \brief settings
+    const CuDSSSolverSettings settings;
+    //! \brief reuse of the analysis
+    const bool reuse_analysis;
+    //! \brief solver of MFEM
+    std::unique_ptr<mfem::CuDSSSolver> solver;
+    //! \brief pattern of the last analysed matrix, if the analysis is reused
+    std::optional<HypreMatrixPattern> pattern;
+    //! \brief number of analyses made
+    size_type number_of_analyses = 0;
+  };  // end of struct CuDSSDirectSolver
+
+}  // end of namespace mfem_mgis::internals
+
+#endif /* defined(MFEM_USE_MPI) && defined(MFEM_USE_CUDSS) */
+
+#endif /* LIB_MFEM_MGIS_SRC_CUDSSSOLVERS_HXX */
diff --git a/src/HypreMatrixPattern.cxx b/src/HypreMatrixPattern.cxx
new file mode 100644
index 0000000000..70ea5d1411
--- /dev/null
+++ b/src/HypreMatrixPattern.cxx
@@ -0,0 +1,133 @@
+/*!
+ * \file   src/HypreMatrixPattern.cxx
+ * \brief  This file implements the pattern of a parallel matrix of hypre
+ * \date   12/10/2026
+ */
+
+#include "HypreMatrixPattern.hxx"
+
+#ifdef MFEM_USE_MPI
+
+#include <span>
+#include <cstddef>
+#include <algorithm>
+
+namespace mfem_mgis::internals {
+
+  namespace {
+
+    /*!
+     * \brief view of the pattern of the local part of a matrix, whose
+     * arrays must be readable on the host
+     */
+    struct HypreMatrixPatternView {
+      //! \brief number of rows of the matrix
+      HYPRE_BigInt global_number_of_rows = 0;
+      //! \brief global index of the first local row
+      HYPRE_BigInt first_row = 0;
+      //! \brief global index of the first column of the diagonal block
+      HYPRE_BigInt first_column = 0;
+      //! \brief offsets of the rows of the diagonal block
+      std::span<const HYPRE_Int> diagonal_rows;
+      //! \brief column indices of the diagonal block
+      std::span<const HYPRE_Int> diagonal_columns;
+      //! \brief offsets of the rows of the off-diagonal block
+      std::span<const HYPRE_Int> off_diagonal_rows;
+      //! \brief column indices of the off-diagonal block
+      std::span<const HYPRE_Int> off_diagonal_columns;
+      //! \brief global indices of the columns of the off-diagonal block
+      std::span<const HYPRE_BigInt> off_diagonal_column_map;
+    };
+
+    /*!
+     * \return a view of the first values of an array of hypre, empty if the
+     * array is null
+     * \param[in] values: values
+     * \param[in] n: number of values
+     */
+    template <typename ValueType>
+    std::span<const ValueType> makeView(const ValueType* const values,
+                                        const HYPRE_Int n) {
+      if ((values == nullptr) || (n <= 0)) {
+        return {};
+      }
+      return {values, static_cast<std::size_t>(n)};
+    }  // end of makeView
+
+    /*!
+     * \return a view of the pattern of the local part of a matrix, whose
+     * arrays must be readable on the host
+     * \param[in] A: matrix
+     */
+    HypreMatrixPatternView view(const mfem::HypreParMatrix& A) {
+      const auto* const m = static_cast<hypre_ParCSRMatrix*>(A);
+      const auto* const diagonal = hypre_ParCSRMatrixDiag(m);
+      const auto* const off_diagonal = hypre_ParCSRMatrixOffd(m);
+      const auto n = hypre_CSRMatrixNumRows(diagonal);
+      auto number_of_entries = [n](const std::span<const HYPRE_Int> rows) {
+        return rows.empty() ? HYPRE_Int{} : rows[static_cast<std::size_t>(n)];
+      };
+      auto v = HypreMatrixPatternView{};
+      v.global_number_of_rows = hypre_ParCSRMatrixGlobalNumRows(m);
+      v.first_row = hypre_ParCSRMatrixFirstRowIndex(m);
+      v.first_column = hypre_ParCSRMatrixFirstColDiag(m);
+      v.diagonal_rows = makeView(hypre_CSRMatrixI(diagonal), n + 1);
+      v.off_diagonal_rows = makeView(hypre_CSRMatrixI(off_diagonal), n + 1);
+      v.diagonal_columns = makeView(hypre_CSRMatrixJ(diagonal),
+                                    number_of_entries(v.diagonal_rows));
+      v.off_diagonal_columns = makeView(hypre_CSRMatrixJ(off_diagonal),
+                                        number_of_entries(v.off_diagonal_rows));
+      v.off_diagonal_column_map =
+          makeView(hypre_ParCSRMatrixColMapOffd(m),
+                   hypre_CSRMatrixNumCols(off_diagonal));
+      return v;
+    }  // end of view
+
+  }  // end of namespace
+
+  HypreMatrixPattern getPattern(const mfem::HypreParMatrix& A) {
+    auto copy = []<typename ValueType>(const std::span<const ValueType> s) {
+      return std::vector<ValueType>(s.begin(), s.end());
+    };
+    A.HostRead();
+    const auto v = view(A);
+    auto p = HypreMatrixPattern{
+        .global_number_of_rows = v.global_number_of_rows,
+        .first_row = v.first_row,
+        .first_column = v.first_column,
+        .diagonal_rows = copy(v.diagonal_rows),
+        .diagonal_columns = copy(v.diagonal_columns),
+        .off_diagonal_rows = copy(v.off_diagonal_rows),
+        .off_diagonal_columns = copy(v.off_diagonal_columns),
+        .off_diagonal_column_map = copy(v.off_diagonal_column_map)};
+    A.HypreRead();
+    return p;
+  }  // end of getPattern
+
+  bool hasPattern(const mfem::HypreParMatrix& A, const HypreMatrixPattern& p) {
+    A.HostRead();
+    const auto v = view(A);
+    const auto r =
+        (p.global_number_of_rows == v.global_number_of_rows) &&
+        (p.first_row == v.first_row) && (p.first_column == v.first_column) &&
+        std::ranges::equal(p.diagonal_rows, v.diagonal_rows) &&
+        std::ranges::equal(p.diagonal_columns, v.diagonal_columns) &&
+        std::ranges::equal(p.off_diagonal_rows, v.off_diagonal_rows) &&
+        std::ranges::equal(p.off_diagonal_columns, v.off_diagonal_columns) &&
+        std::ranges::equal(p.off_diagonal_column_map,
+                           v.off_diagonal_column_map);
+    A.HypreRead();
+    return r;
+  }  // end of hasPattern
+
+  bool hasPatternOnAllProcesses(const mfem::HypreParMatrix& A,
+                                const std::optional<HypreMatrixPattern>& p,
+                                const MPI_Comm c) {
+    auto same = static_cast<int>(p.has_value() && hasPattern(A, *p));
+    MPI_Allreduce(MPI_IN_PLACE, &same, 1, MPI_INT, MPI_LAND, c);
+    return same != 0;
+  }  // end of hasPatternOnAllProcesses
+
+}  // end of namespace mfem_mgis::internals
+
+#endif /* MFEM_USE_MPI */
diff --git a/src/HypreMatrixPattern.hxx b/src/HypreMatrixPattern.hxx
new file mode 100644
index 0000000000..3ff3b03253
--- /dev/null
+++ b/src/HypreMatrixPattern.hxx
@@ -0,0 +1,83 @@
+/*!
+ * \file   src/HypreMatrixPattern.hxx
+ * \brief  This file declares the pattern of a parallel matrix of hypre,
+ * compared by the direct solvers which reuse their analysis (internal
+ * header)
+ * \date   12/10/2026
+ */
+
+#ifndef LIB_MFEM_MGIS_SRC_HYPREMATRIXPATTERN_HXX
+#define LIB_MFEM_MGIS_SRC_HYPREMATRIXPATTERN_HXX
+
+#include "mfem/config/config.hpp"
+
+#ifdef MFEM_USE_MPI
+
+#include <vector>
+#include <optional>
+#include <mpi.h>
+#include "mfem/linalg/hypre.hpp"
+#include "MFEMMGIS/Config.hxx"
+
+namespace mfem_mgis::internals {
+
+  /*!
+   * \brief pattern of the local part of a parallel matrix of hypre: global
+   * number of rows, first local row and column, rows and column indices of
+   * the diagonal and off-diagonal blocks, global indices of the
+   * off-diagonal columns. Two matrices with the same pattern on all
+   * processes give the same coordinates of their coefficients to a direct
+   * solver.
+   */
+  struct HypreMatrixPattern {
+    //! \brief comparison operator
+    bool operator==(const HypreMatrixPattern&) const = default;
+    //! \brief number of rows of the matrix
+    HYPRE_BigInt global_number_of_rows = 0;
+    //! \brief global index of the first local row
+    HYPRE_BigInt first_row = 0;
+    //! \brief global index of the first column of the diagonal block
+    HYPRE_BigInt first_column = 0;
+    //! \brief offsets of the rows of the diagonal block
+    std::vector<HYPRE_Int> diagonal_rows;
+    //! \brief column indices of the diagonal block
+    std::vector<HYPRE_Int> diagonal_columns;
+    //! \brief offsets of the rows of the off-diagonal block
+    std::vector<HYPRE_Int> off_diagonal_rows;
+    //! \brief column indices of the off-diagonal block
+    std::vector<HYPRE_Int> off_diagonal_columns;
+    //! \brief global indices of the columns of the off-diagonal block
+    std::vector<HYPRE_BigInt> off_diagonal_column_map;
+  };
+
+  /*!
+   * \return the pattern of the local part of a matrix
+   * \param[in] A: matrix
+   */
+  [[nodiscard]] HypreMatrixPattern getPattern(const mfem::HypreParMatrix&);
+  /*!
+   * \return true if the local part of a matrix has the given pattern. The
+   * matrix is read in place, without allocation.
+   * \param[in] A: matrix
+   * \param[in] p: pattern
+   */
+  [[nodiscard]] bool hasPattern(const mfem::HypreParMatrix&,
+                                const HypreMatrixPattern&);
+  /*!
+   * \return true if the local part of a matrix has the given pattern on all
+   * the processes of a communicator, false if the pattern is empty on one of
+   * them. Collective: nothing is allocated before the reduction.
+   * \param[in] A: matrix
+   * \param[in] p: pattern of the local part, if any
+   * \param[in] c: communicator
+   */
+  [[nodiscard]] bool hasPatternOnAllProcesses(
+      const mfem::HypreParMatrix&,
+      const std::optional<HypreMatrixPattern>&,
+      MPI_Comm);
+
+}  // end of namespace mfem_mgis::internals
+
