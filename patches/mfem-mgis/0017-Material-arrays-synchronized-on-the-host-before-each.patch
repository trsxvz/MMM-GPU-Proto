diff --git a/tests/MaterialArraysTest.cxx b/tests/MaterialArraysTest.cxx
index 2f0430112e..a954ee2efc 100644
--- a/tests/MaterialArraysTest.cxx
+++ b/tests/MaterialArraysTest.cxx
@@ -18,6 +18,7 @@
 #include "MFEMMGIS/FiniteElementDiscretization.hxx"
 #include "MFEMMGIS/PartialQuadratureSpace.hxx"
 #include "MFEMMGIS/Material.hxx"
