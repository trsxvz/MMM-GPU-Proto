-        const auto eoffset = qspace.getOffset(tr.ElementNo);
+        const auto npoints = qspace.getNumberOfIntegrationPoints();
+        if (static_cast<mfem_mgis::size_type>(w.size()) != npoints) {
+          return ctx.registerErrorMessage(
