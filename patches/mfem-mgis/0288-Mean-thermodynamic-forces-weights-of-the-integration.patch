+        const auto ow = p.getIntegrationPointsWeights(ctx, mi, b);
+        if (isInvalid(ow)) {
+          return {};
+        }
+        const auto& w = *ow;
         const auto& s1 = om->s1;
         const auto& qspace = om->getPartialQuadratureSpace();
         const auto thsize =
