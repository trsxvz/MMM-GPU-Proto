From 5bc114c0aac0ee152cebd1e32ccaaedf575f755e Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Fri, 9 Oct 2026 13:58:04 +0200
Subject: [PATCH] Config: short option names, device before PETSc, one GPU per
 process

- `initialize` recognizes the short names declared by
  `declareDefaultOptions`: `-dev` for `--device`, `-up` and `-no-up` for
  `--use-petsc` and `--donot-use-petsc`, `petscrc_file` for
  `--petsc-configuration-file`. Before, `-dev cuda` was accepted by the
  parser and created no device.
- The device is created before the initialization of PETSc, which uses
  the GPU of the device (as in the PETSc examples of MFEM).
- The processes of a node use the GPUs of the node in turn (rank in the
  node modulo the number of GPUs). The number of GPUs is only queried
  for a configuration using a GPU: MFEM aborts otherwise when it has no
  GPU support or on a machine without GPU.
- The help of `--device` states that no device is created by default.
- Documentation of the option and of its constraints (the application
  must neither create its own device nor declare `--device`).
- Test of the short name.
---
 docs/source/user_guide/tutorial.rst | 10 +++-
 include/MFEMMGIS/Config.hxx         |  8 +++
 src/Config.cxx                      | 75 ++++++++++++++++++++++++-----
 tests/CMakeLists.txt                |  2 +
 4 files changed, 83 insertions(+), 12 deletions(-)

diff --git a/docs/source/user_guide/tutorial.rst b/docs/source/user_guide/tutorial.rst
index b2e36f28a0..40035d2793 100644
--- a/docs/source/user_guide/tutorial.rst
+++ b/docs/source/user_guide/tutorial.rst
@@ -253,8 +253,16 @@ If left unchanged, those default values select:
 -  the standard formulation, without FBar.
 -  no comparison to reference values.
 
+The ``mfem_mgis::declareDefaultOptions`` function adds the option
+``--device`` (or ``-dev``), which selects the configuration of the
+``MFEM`` device (for instance ``cuda``). The device is created by
+``mfem_mgis::initialize``; no device is created if the option is not
+given. An application using this option must not create its own
+``mfem::Device`` nor declare its own ``--device`` option.
+
 If ``MFEM`` was built with support of ``PETSc`` library, the following
-options are added by the ``mfem_mgis::declareDefaultOptions`` function:
+options are also added by the ``mfem_mgis::declareDefaultOptions``
+function:
 
 -  ``--use-petsc`` which specifies that linear and non linear solvers of
    the ``PETSc`` toolkit must be used.
diff --git a/include/MFEMMGIS/Config.hxx b/include/MFEMMGIS/Config.hxx
index 90fbdad6f2..0ec6e25cd0 100644
--- a/include/MFEMMGIS/Config.hxx
+++ b/include/MFEMMGIS/Config.hxx
@@ -127,6 +127,14 @@ namespace mfem_mgis {
    *
    * In parallel, this function calls the `MPI_Init` function.
    * It is safe to call this function multiple times.
+   *
+   * If the option `--device <configuration>` (or `-dev`) is given, the MFEM
+   * device is created with this configuration (for instance `cuda`), after
+   * the initialization of hypre and before the one of PETSc. The processes
+   * of a node use the GPUs of the node in turn. An application which uses
+   * this option must neither create its own `mfem::Device` (MFEM refuses a
+   * second configuration of the device) nor declare its own `--device`,
+   * `-dev` options.
    */
   MFEM_MGIS_EXPORT void initialize(int& argc, MainFunctionArguments& argv);
   /*!
diff --git a/src/Config.cxx b/src/Config.cxx
index 9db26a9f41..6705a413d5 100644
--- a/src/Config.cxx
+++ b/src/Config.cxx
@@ -40,6 +40,8 @@ namespace mfem_mgis {
     static const char* const petsc_configuration_file_option;
     //! \brief option used to select the configuration of the MFEM device
     static const char* const device_option;
+    //! \brief short name of the option `device_option`
+    static const char* const device_short_option;
     //! \return the unique instance of this class
     static Finalizer& get();
     /*!
@@ -87,6 +89,45 @@ namespace mfem_mgis {
 
   const char* const Finalizer::device_option = "--device";
 
+  const char* const Finalizer::device_short_option = "-dev";
+
+  /*!
+   * \return the identifier of the GPU used by this process: the processes
+   * of a node use the GPUs of the node in turn (several processes may share
+   * a GPU)
+   * \param[in] configuration: configuration of the device
+   */
+  static int getDeviceIdentifier(const char* const configuration) {
+#if defined(MFEM_USE_CUDA) || defined(MFEM_USE_HIP)
+    // MFEM aborts if the number of GPUs is queried on a machine without GPU:
+    // it is only queried for a configuration using a GPU
+    const auto c = std::string_view{configuration};
+    if ((c.find("cuda") == std::string_view::npos) &&
+        (c.find("hip") == std::string_view::npos)) {
+      return 0;
+    }
+    const auto n = mfem::Device::GetDeviceCount();
+    if (n <= 0) {
+      return 0;
+    }
+#ifdef MFEM_USE_MPI
+    auto local = MPI_Comm{};
+    MPI_Comm_split_type(MPI_COMM_WORLD, MPI_COMM_TYPE_SHARED, 0, MPI_INFO_NULL,
+                        &local);
+    auto r = int{};
+    MPI_Comm_rank(local, &r);
+    MPI_Comm_free(&local);
+    return r % n;
+#else  /* MFEM_USE_MPI */
+    return 0;
+#endif /* MFEM_USE_MPI */
+#else  /* defined(MFEM_USE_CUDA) || defined(MFEM_USE_HIP) */
+    // without GPU support, MFEM aborts if the number of GPUs is queried
+    static_cast<void>(configuration);
+    return 0;
+#endif /* defined(MFEM_USE_CUDA) || defined(MFEM_USE_HIP) */
+  }  // end of getDeviceIdentifier
+
   Finalizer::Finalizer() = default;
 
 #ifdef MFEM_USE_PETSC
@@ -106,7 +147,8 @@ namespace mfem_mgis {
 #endif /* MFEM_USE_PETSC */
     const char* device_configuration = nullptr;
     for (const auto* a = argv; a != argv + argc; ++a) {
-      if (std::strcmp(*a, device_option) == 0) {
+      if ((std::strcmp(*a, device_option) == 0) ||
+          (std::strcmp(*a, device_short_option) == 0)) {
         if (device_configuration != nullptr) {
           mgis::raise("initialize: MFEM device already specified");
         }
@@ -118,10 +160,17 @@ namespace mfem_mgis {
         continue;
       }
 #ifdef MFEM_USE_PETSC
-      if (std::strcmp(*a, "--use-petsc") == 0) {
+      // long and short names, as declared by `declareDefaultOptions`
+      if ((std::strcmp(*a, "--use-petsc") == 0) ||
+          (std::strcmp(*a, "-up") == 0)) {
         this->use_petsc = true;
       }
-      if (std::strcmp(*a, petsc_configuration_file_option) == 0) {
+      if ((std::strcmp(*a, "--donot-use-petsc") == 0) ||
+          (std::strcmp(*a, "-no-up") == 0)) {
+        this->use_petsc = false;
+      }
+      if ((std::strcmp(*a, petsc_configuration_file_option) == 0) ||
+          (std::strcmp(*a, "petscrc_file") == 0)) {
         if (petscrc_file != nullptr) {
           mgis::raise("initialize: PETSc configuration file already specified");
         }
@@ -134,6 +183,13 @@ namespace mfem_mgis {
       }
 #endif /* MFEM_USE_PETSC */
     }
+    // the device is configured after the initialization of hypre and
+    // before the one of PETSc, which uses the GPU of the device, as in the
+    // parallel examples of MFEM
+    if (device_configuration != nullptr) {
+      this->device = std::make_unique<mfem::Device>(
+          device_configuration, getDeviceIdentifier(device_configuration));
+    }
 #ifdef MFEM_USE_PETSC
     if (this->use_petsc) {
       if (petscrc_file == nullptr) {
@@ -142,11 +198,6 @@ namespace mfem_mgis {
       mfem::MFEMInitializePetsc(nullptr, nullptr, petscrc_file, nullptr);
     }
 #endif /* MFEM_USE_PETSC */
-    // the device is configured after the initialization of hypre, as in
-    // the parallel examples of MFEM
-    if (device_configuration != nullptr) {
-      this->device = std::make_unique<mfem::Device>(device_configuration);
-    }
   }    // end of initialize
 
   Finalizer& Finalizer::get() {
@@ -248,11 +299,13 @@ namespace mfem_mgis {
   void declareDefaultOptions(mfem::OptionsParser& parser) {
     // the device is created by `initialize`: the option is only declared
     // here, so that the parser accepts it
-    static const char* device_configuration = "cpu";
-    parser.AddOption(&device_configuration, "-dev", Finalizer::device_option,
+    static const char* device_configuration = "";
+    parser.AddOption(&device_configuration, Finalizer::device_short_option,
+                     Finalizer::device_option,
                      "Configuration of the MFEM device (for instance cpu, "
                      "cuda, hip, omp or debug), created by "
-                     "mfem_mgis::initialize.");
+                     "mfem_mgis::initialize. No device is created by "
+                     "default.");
 #ifdef MFEM_USE_PETSC
     static bool use_petsc = false;
     static const char* petscrc_file = "";
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 79f8454285..e285d578fd 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -784,6 +784,8 @@ if(MFEM_MGIS_HAVE_TFEL)
            COMMAND DeviceOptionTest --expected none)
   add_test(NAME DeviceOptionTest-debug
            COMMAND DeviceOptionTest --device debug --expected debug)
+  add_test(NAME DeviceOptionTest-debug-short
+           COMMAND DeviceOptionTest -dev debug --expected debug)
 
   # HypreBoomerAMGTest executable
   if(MFEM_USE_MPI)
-- 
