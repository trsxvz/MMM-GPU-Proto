+static bool checkValuesInGlobalFrame(const mfem_mgis::Material& m,
+                                     const bool gradients,
+                                     const mfem_mgis::TimeStepStage s) {
+  using namespace mfem_mgis;
+  const auto global = gradients ? m.getGradientsInGlobalFrame(s)
