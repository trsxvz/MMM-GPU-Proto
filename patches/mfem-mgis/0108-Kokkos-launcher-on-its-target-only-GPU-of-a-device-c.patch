From 47cf3e8d0a902cb6957e4f05a143dfad1966f392 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Sun, 11 Oct 2026 18:38:27 +0200
Subject: [PATCH] Kokkos: launcher on its target only, GPU of a device
 configured before

- The launcher of Kokkos only applies to the target MFEMMGISKokkos
  (component separable_compilation, kokkos_compilation), compiled
  without the launcher of CMAKE_CXX_COMPILER_LAUNCHER (such as ccache),
  which the launcher of Kokkos does not expect: the other sources of
  mfem-mgis are no longer compiled through the launcher of Kokkos.
- The shared libraries of Kokkos are required: the behaviours generated
  by the kokkos backend must share the instance of Kokkos initialized by
  mfem-mgis.
- Kokkos uses the GPU of the device of MFEM configured by the program
  before mfem_mgis::initialize too (it used the one chosen by Kokkos).
- initializeKokkos reports a finalized Kokkos, which can't be
  initialized again, instead of letting Kokkos abort.
- MFEMMGISKokkos has a version and a soname version.
- MaterialArraysTest-kokkos requires Kokkos built for CUDA.
- Documentation: GPU used by Kokkos, run path of the installed programs
  using mfem-mgis, finalize recommended with Kokkos.
---
 CMakeLists.txt                                | 14 +++++-
 .../installation_guide/installation_guide.rst | 44 ++++++++++---------
 include/MFEMMGIS/Config.hxx                   |  8 +++-
 src/CMakeLists.txt                            | 13 ++++--
 src/Config.cxx                                |  6 +++
 src/KokkosRuntime.cxx                         |  5 +++
 src/KokkosRuntime.hxx                         |  2 +
 tests/CMakeLists.txt                          |  6 ++-
 8 files changed, 67 insertions(+), 31 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6d972ce74e..23d39c430b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -83,10 +83,20 @@ if(enable-amgx)
   get_filename_component(MFEM_MGIS_AMGX_DIR "${AMGX_INCLUDE_DIR}" DIRECTORY)
 endif(enable-amgx)
 
-# Kokkos, initialized on demand by mfem_mgis::initialize
+# Kokkos, initialized on demand by mfem_mgis::initialize. The launcher of
+# Kokkos only applies to the target compiled by the compiler of Kokkos
+# (component separable_compilation, see src/CMakeLists.txt)
 set(MFEM_MGIS_HAVE_KOKKOS OFF)
 if(enable-kokkos)
-  find_package(Kokkos CONFIG REQUIRED)
+  find_package(Kokkos CONFIG REQUIRED COMPONENTS separable_compilation)
+  # the behaviours generated by the kokkos backend must share the instance
+  # of Kokkos initialized by mfem-mgis
+  get_target_property(_kokkos_core_type Kokkos::kokkoscore TYPE)
+  if(NOT _kokkos_core_type STREQUAL "SHARED_LIBRARY")
+    message(FATAL_ERROR "mfem-mgis: the option enable-kokkos requires "
+            "the shared libraries of Kokkos, used by the behaviours "
+            "generated by the kokkos backend")
+  endif()
   set(MFEM_MGIS_HAVE_KOKKOS ON)
 endif(enable-kokkos)
 
diff --git a/docs/source/installation_guide/installation_guide.rst b/docs/source/installation_guide/installation_guide.rst
index b89fb6553e..7204a0f461 100644
--- a/docs/source/installation_guide/installation_guide.rst
+++ b/docs/source/installation_guide/installation_guide.rst
@@ -145,28 +145,30 @@ The behaviours generated by the ``kokkos`` backend of the
 ``generic-parallel`` interface of ``MFront`` require an initialized
 ``Kokkos``, which they do not initialize. With the option
 ``-Denable-kokkos=ON`` (``Kokkos`` being found by ``find_package``, for
-instance through ``CMAKE_PREFIX_PATH``),
-``mfem_mgis::initialize`` initializes ``Kokkos`` on demand, after the
-device of ``MFEM`` and on its GPU, with the option ``--kokkos`` or the
-environment variable ``MFEM_MGIS_KOKKOS`` (any non empty value other than
-``0``), and ``mfem_mgis::finalize`` finalizes it before ``MPI``. Without
-this option, ``--kokkos`` is an error and ``MFEM_MGIS_KOKKOS`` is ignored
-with a warning.
-
-- The behaviours must use the same shared library of ``Kokkos`` as
-  ``mfem-mgis`` (the ``Kokkos`` used by ``MFront`` with the configuration
-  file ``config-kokkos.json``); otherwise, they still report that
-  ``Kokkos`` is not initialized. With a ``Kokkos`` built for a GPU, the
-  device of ``MFEM`` is a GPU (for instance ``--device cuda``); the
-  configuration file ``config-kokkos-host.json`` generates behaviours for
-  the host.
+instance through ``CMAKE_PREFIX_PATH``), ``mfem_mgis::initialize``
+initializes ``Kokkos`` on demand, after the device of ``MFEM``, with the
+option ``--kokkos`` or the environment variable ``MFEM_MGIS_KOKKOS`` (any
+non empty value other than ``0``), and ``mfem_mgis::finalize`` finalizes it
+before ``MPI``. Without this option, ``--kokkos`` is an error and
+``MFEM_MGIS_KOKKOS`` is ignored with a warning.
+
+- ``Kokkos`` uses the GPU of the device of ``MFEM`` configured by
+  ``--device``, by ``MFEM_MGIS_DEVICE`` or by the program before
+  ``mfem_mgis::initialize``; otherwise, ``Kokkos`` chooses its GPU.
+- ``Kokkos`` must be built as shared libraries, which the behaviours use
+  too (the ``Kokkos`` used by ``MFront`` with the configuration file
+  ``config-kokkos.json``): otherwise, they still report that ``Kokkos`` is
+  not initialized. With a ``Kokkos`` built for a GPU, the device of
+  ``MFEM`` is a GPU (for instance ``--device cuda``); the configuration
+  file ``config-kokkos-host.json`` generates behaviours for the host.
 - The only source of ``mfem-mgis`` including ``Kokkos`` is compiled by the
-  compiler of ``Kokkos``, through the launcher which ``Kokkos`` sets up
-  (incompatible with another launcher, such as ``ccache`` given by
-  ``CMAKE_CXX_COMPILER_LAUNCHER``), in the shared library
-  ``MFEMMGISKokkos``, installed next to ``MFEMMGIS`` and privately linked
-  to ``Kokkos``: the projects using ``mfem-mgis`` neither find ``Kokkos``
-  nor inherit its flags.
+  compiler of ``Kokkos``, through the launcher of ``Kokkos`` set on this
+  target only (without ``CMAKE_CXX_COMPILER_LAUNCHER``, such as
+  ``ccache``), in the shared library ``MFEMMGISKokkos``, installed next to
+  ``MFEMMGIS`` and privately linked to ``Kokkos``: the projects using
+  ``mfem-mgis`` neither find ``Kokkos`` nor inherit its flags. Their
+  installed programs need a run path to the directory of this library (for
+  instance ``CMAKE_INSTALL_RPATH_USE_LINK_PATH``).
 - ``find_package(Kokkos)`` sets ``CMAKE_CXX_EXTENSIONS`` to ``OFF``:
   ``mfem-mgis`` is then compiled without the extensions of the compilers
   (``-std=c++20`` instead of ``-std=gnu++20``).
diff --git a/include/MFEMMGIS/Config.hxx b/include/MFEMMGIS/Config.hxx
index 7a2ec9ceb0..a1fde04972 100644
--- a/include/MFEMMGIS/Config.hxx
+++ b/include/MFEMMGIS/Config.hxx
@@ -159,7 +159,9 @@ namespace mfem_mgis {
    * it), or else the environment variable `MFEM_MGIS_KOKKOS` (any non empty
    * value other than `0`), initializes Kokkos after the device of MFEM, on
    * its GPU, for the behaviours generated by the kokkos backend of the
-   * generic-parallel interface. It requires mfem-mgis built with Kokkos
+   * generic-parallel interface. The GPU is the one of the device configured
+   * by `--device`, by `MFEM_MGIS_DEVICE` or by the program before the call;
+   * otherwise, Kokkos chooses it. It requires mfem-mgis built with Kokkos
    * (CMake option `enable-kokkos`): otherwise, the option is an error and
    * the environment variable is ignored with a warning.
    */
@@ -167,7 +169,9 @@ namespace mfem_mgis {
   /*!
    * \brief function that must be called to end `mfem-mgis`. It finalizes
    * Kokkos if `initialize` initialized it, then MPI.
-   * This call is optional if the code exits normally.
+   * This call is optional if the code exits normally, but recommended if
+   * `initialize` initialized Kokkos, which is otherwise finalized during the
+   * destruction of the static objects.
    */
   MFEM_MGIS_EXPORT void finalize();
   //! \return the MPI rank for the default communicator
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 9090069ccf..cc4acd3165 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -207,17 +207,22 @@ if(MFEM_MGIS_HAVE_AMGX)
   endforeach(_property)
 endif()
 # Kokkos: the only source including Kokkos is compiled by the compiler of
-# Kokkos (the launcher of Kokkos redirects the compilation and the link of
-# the targets linked to Kokkos::kokkos) in a shared library privately linked
-# to Kokkos, so that neither the other sources nor the projects linked to
-# mfem-mgis inherit the flags of Kokkos
+# Kokkos in a shared library privately linked to Kokkos, so that neither the
+# other sources nor the projects linked to mfem-mgis inherit the flags of
+# Kokkos
 if(MFEM_MGIS_HAVE_KOKKOS)
   add_library(MFEMMGISKokkos SHARED KokkosRuntime.cxx)
   target_link_libraries(MFEMMGISKokkos PRIVATE Kokkos::kokkos)
+  # compilation and link redirected to the compiler of Kokkos by its
+  # launcher, which does not expect another launcher (such as ccache)
+  kokkos_compilation(TARGET MFEMMGISKokkos)
   # the installed Kokkos may not support the extensions of the compilers;
   # the symbols are exported despite the flag -fvisibility=hidden of the
   # compilation; the installed library finds the one of Kokkos
   set_target_properties(MFEMMGISKokkos PROPERTIES
+    CXX_COMPILER_LAUNCHER ""
+    VERSION ${PROJECT_VERSION}
+    SOVERSION ${PROJECT_VERSION_MAJOR}
     CXX_EXTENSIONS OFF
     CXX_VISIBILITY_PRESET default
     WINDOWS_EXPORT_ALL_SYMBOLS ON
diff --git a/src/Config.cxx b/src/Config.cxx
index 4f61bce37e..e5b01539c6 100644
--- a/src/Config.cxx
+++ b/src/Config.cxx
@@ -366,6 +366,12 @@ namespace mfem_mgis {
     if (*kokkos_requested) {
 #ifdef MFEM_MGIS_HAVE_KOKKOS
       static_cast<void>(kokkos_from_environment);
+      if ((gpu_identifier < 0) && mfem::Device::IsConfigured() &&
+          mfem::Device::Allows(mfem::Backend::CUDA_MASK |
+                               mfem::Backend::HIP_MASK)) {
+        // device configured by the program before the initialization
+        gpu_identifier = mfem::Device::GetId();
+      }
       this->kokkos = internals::initializeKokkos(gpu_identifier);
 #else  /* MFEM_MGIS_HAVE_KOKKOS */
       static_cast<void>(gpu_identifier);
diff --git a/src/KokkosRuntime.cxx b/src/KokkosRuntime.cxx
index 867c3ab4af..4ac6c40260 100644
--- a/src/KokkosRuntime.cxx
+++ b/src/KokkosRuntime.cxx
@@ -7,12 +7,17 @@
  * the compiler of Kokkos (target `MFEMMGISKokkos`)
  */
 
+#include <stdexcept>
 #include <Kokkos_Core.hpp>
 #include "KokkosRuntime.hxx"
 
 namespace mfem_mgis::internals {
 
   bool initializeKokkos(const int gpu) {
+    if (Kokkos::is_finalized()) {
+      throw std::runtime_error{
+          "initialize: Kokkos is finalized and can't be initialized again"};
+    }
     if (Kokkos::is_initialized()) {
       return false;
     }
diff --git a/src/KokkosRuntime.hxx b/src/KokkosRuntime.hxx
index ad049e9cfe..9d9d5b468e 100644
--- a/src/KokkosRuntime.hxx
+++ b/src/KokkosRuntime.hxx
@@ -19,6 +19,8 @@ namespace mfem_mgis::internals {
    * \return true if Kokkos is initialized by this call
    * \param[in] gpu: identifier of the GPU used by Kokkos (the one of the
    * device of MFEM), chosen by Kokkos if negative
+   * \throw std::runtime_error if Kokkos is finalized, as it can't be
+   * initialized again
    */
   [[nodiscard]] bool initializeKokkos(const int);
   //! \brief finalizes Kokkos if it is initialized and not finalized
