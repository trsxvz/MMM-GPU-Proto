@@ -753,6 +760,63 @@ static void checkMatrixFreeOperator(
   // in float, the relative difference of the actions reaches 2.8e-7
   check(diff_action <= mfem_mgis::unit_tests::tolerance(1e-12, 3e-6),
         name + ": action of the tangent operator applied without assembly");
+  // nodal blocks, against the ones of the assembled operator (diagonal
+  // block of the process in parallel)
+  const auto* const nbp = dynamic_cast<const NodalBlocksProvider*>(&op);
+  if (nbp == nullptr) {
+    check(false, name + ": no nodal blocks of the tangent operator");
+    return;
+  }
+  auto blocks = mfem::Vector{};
+  nbp->AssembleNodalBlocks(blocks);
+  const auto& fes = problem.getFiniteElementDiscretization()
+                        .getFiniteElementSpace<parallel_computation>();
+  const auto vdim = fes.GetVDim();
+  const auto n = op.Height();
+  const auto nb = n / vdim;
+  const auto by_nodes = fes.GetOrdering() == mfem::Ordering::byNODES;
+  auto local = mfem::SparseMatrix{};
+  const mfem::SparseMatrix* sa = dynamic_cast<const mfem::SparseMatrix*>(&a);
+#ifdef MFEM_USE_MPI
+  if (const auto* const ha = dynamic_cast<const mfem::HypreParMatrix*>(&a);
+      ha != nullptr) {
+    ha->GetDiag(local);
+    sa = &local;
+  }
+#endif /* MFEM_USE_MPI */
+  if (sa == nullptr) {
+    check(false, name + ": unexpected type of the assembled operator");
+    return;
+  }
+  auto expected = std::vector<real>(static_cast<std::size_t>(vdim * n), 0);
+  {
+    const auto* const I = sa->HostReadI();
+    const auto* const J = sa->HostReadJ();
+    const auto* const A = sa->HostReadData();
+    const auto node = [nb, vdim, by_nodes](const int i) {
+      return by_nodes ? i % nb : i / vdim;
+    };
+    const auto component = [nb, vdim, by_nodes](const int i) {
+      return by_nodes ? i / nb : i % vdim;
+    };
+    for (int i = 0; i != n; ++i) {
+      for (int k = I[i]; k != I[i + 1]; ++k) {
+        if (node(J[k]) == node(i)) {
+          expected[static_cast<std::size_t>(component(J[k]) * n + i)] += A[k];
+        }
+      }
+    }
+  }
+  const auto* const pb = blocks.HostRead();
+  const auto diff_blocks = getRelativeDifference(
+      expected, std::vector<real>(pb, pb + blocks.Size()));
+  std::cout << name << ": relative difference of the nodal blocks "
+            << diff_blocks << '\n';
+  check((blocks.Size() == vdim * n) &&
+            (diff_blocks <= mfem_mgis::unit_tests::tolerance(1e-12, 3e-6)),
+        name +
+            ": nodal blocks of the tangent operator applied without "
+            "assembly");
 }  // end of checkMatrixFreeOperator
 
