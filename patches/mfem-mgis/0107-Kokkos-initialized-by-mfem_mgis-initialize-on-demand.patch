diff --git a/src/KokkosRuntime.cxx b/src/KokkosRuntime.cxx
new file mode 100644
index 0000000000..867c3ab4af
--- /dev/null
+++ b/src/KokkosRuntime.cxx
@@ -0,0 +1,37 @@
+/*!
+ * \file   src/KokkosRuntime.cxx
+ * \brief  This file implements the initialization and the finalization of
+ * Kokkos (see `KokkosRuntime.hxx`)
+ * \date   11/10/2026
+ * \note   the only source of mfem-mgis including Kokkos: it is compiled by
+ * the compiler of Kokkos (target `MFEMMGISKokkos`)
+ */
+
+#include <Kokkos_Core.hpp>
+#include "KokkosRuntime.hxx"
+
+namespace mfem_mgis::internals {
+
+  bool initializeKokkos(const int gpu) {
+    if (Kokkos::is_initialized()) {
+      return false;
+    }
+    auto settings = Kokkos::InitializationSettings{};
+    if (gpu >= 0) {
+      settings.set_device_id(gpu);
+    }
+    Kokkos::initialize(settings);
+    return true;
+  }  // end of initializeKokkos
+
+  void finalizeKokkos() {
+    if (Kokkos::is_initialized() && !Kokkos::is_finalized()) {
+      Kokkos::finalize();
+    }
+  }  // end of finalizeKokkos
+
+  bool isKokkosInitialized() noexcept {
+    return Kokkos::is_initialized() && !Kokkos::is_finalized();
+  }  // end of isKokkosInitialized
+
+}  // end of namespace mfem_mgis::internals
diff --git a/src/KokkosRuntime.hxx b/src/KokkosRuntime.hxx
new file mode 100644
index 0000000000..ad049e9cfe
--- /dev/null
+++ b/src/KokkosRuntime.hxx
@@ -0,0 +1,31 @@
+/*!
+ * \file   src/KokkosRuntime.hxx
+ * \brief  This file declares the initialization and the finalization of
+ * Kokkos by `mfem_mgis::initialize` and `mfem_mgis::finalize`, for the
+ * behaviours generated by the kokkos backend of the generic-parallel
+ * interface of MFront, which require an initialized Kokkos
+ * \date   11/10/2026
+ * \note   only available if mfem-mgis is built with Kokkos (option
+ * `enable-kokkos`)
+ */
+
+#ifndef LIB_MFEM_MGIS_KOKKOSRUNTIME_HXX
+#define LIB_MFEM_MGIS_KOKKOSRUNTIME_HXX
+
+namespace mfem_mgis::internals {
+
+  /*!
+   * \brief initializes Kokkos if it is not initialized
+   * \return true if Kokkos is initialized by this call
+   * \param[in] gpu: identifier of the GPU used by Kokkos (the one of the
+   * device of MFEM), chosen by Kokkos if negative
+   */
+  [[nodiscard]] bool initializeKokkos(const int);
+  //! \brief finalizes Kokkos if it is initialized and not finalized
+  void finalizeKokkos();
+  //! \return true if Kokkos is initialized and not finalized
+  [[nodiscard]] bool isKokkosInitialized() noexcept;
+
+}  // end of namespace mfem_mgis::internals
+
+#endif /* LIB_MFEM_MGIS_KOKKOSRUNTIME_HXX */
