diff --git a/tests/ProfilingMarkersTest.cmake b/tests/ProfilingMarkersTest.cmake
new file mode 100644
index 0000000000..abeb614e03
--- /dev/null
+++ b/tests/ProfilingMarkersTest.cmake
@@ -0,0 +1,42 @@
+# Runs ProfilingMarkersTest on a GPU under rocprofv3, the profiler of ROCm,
+# and checks that the ranges of roctx declared by the test (three steps,
+# each one with three sections) are in the trace of the markers.
+#
+# usage: cmake -DROCPROFV3=<rocprofv3> -DTEST=<executable>
+#          -DDIRECTORY=<directory of the trace> -P ProfilingMarkersTest.cmake
+file(REMOVE_RECURSE "${DIRECTORY}")
+execute_process(
+  COMMAND "${ROCPROFV3}" --marker-trace --output-format csv
+          -d "${DIRECTORY}" -o trace --
+          "${TEST}" --device hip --expected yes
+  RESULT_VARIABLE _status)
+if(NOT _status EQUAL 0)
+  message(FATAL_ERROR "ProfilingMarkersTest failed under rocprofv3 "
+          "(${_status})")
+endif()
+set(_trace "${DIRECTORY}/trace_marker_api_trace.csv")
+if(NOT EXISTS "${_trace}")
+  message(FATAL_ERROR "no trace of the markers (${_trace})")
+endif()
+file(STRINGS "${_trace}" _lines)
+foreach(_range "ProfilingMarkersTest: step 0=1"
+               "ProfilingMarkersTest: step 1=1"
+               "ProfilingMarkersTest: step 2=1"
+               "ProfilingMarkersTest::Step=3"
+               "ProfilingMarkersTest::Fill=3"
+               "ProfilingMarkersTest::Norm=3")
+  string(REGEX REPLACE "=[0-9]+$" "" _name "${_range}")
+  string(REGEX REPLACE "^.*=" "" _expected "${_range}")
+  set(_count 0)
+  foreach(_line IN LISTS _lines)
+    string(FIND "${_line}" "\"${_name}\"" _position)
+    if(NOT _position EQUAL -1)
+      math(EXPR _count "${_count} + 1")
+    endif()
+  endforeach()
+  if(NOT _count EQUAL _expected)
+    message(FATAL_ERROR "range '${_name}': ${_count} in the trace of the "
+            "markers, ${_expected} expected")
+  endif()
+  message(STATUS "range '${_name}': ${_count} in the trace of the markers")
+endforeach()
diff --git a/tests/ProfilingMarkersTest.cxx b/tests/ProfilingMarkersTest.cxx
new file mode 100644
index 0000000000..a333841678
--- /dev/null
+++ b/tests/ProfilingMarkersTest.cxx
@@ -0,0 +1,90 @@
+/*!
+ * \file   ProfilingMarkersTest.cxx
+ * \brief  Test of the profiling sections declared as ranges of roctx, the
+ * annotation library of ROCm: the markers are set by `mfem_mgis::initialize`
+ * if mfem-mgis is built with the option `enable-roctx` and if the device
+ * selected by the `--device` option uses a GPU, and only then. With or
+ * without markers, the profiling tree is the same.
+ * \date   14/11/2026
+ */
+
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include "mfem/general/device.hpp"
+#include "mfem/general/optparser.hpp"
+#include "mfem/linalg/vector.hpp"
+#include "MGIS/Context.hxx"
+#include "MGIS/Profiling.hxx"
+#include "MFEMMGIS/Config.hxx"
+
+int main(int argc, char** argv) {
+  mfem_mgis::initialize(argc, argv);
+  // `yes` if the profiling sections are expected to be declared to roctx,
+  // `no` otherwise
+  const char* expected = "no";
+  auto args = mfem::OptionsParser(argc, argv);
+  mfem_mgis::declareDefaultOptions(args);
+  args.AddOption(&expected, "-e", "--expected",
+                 "yes if the profiling sections are expected to be declared "
+                 "to roctx, no otherwise");
+  args.Parse();
+  if (!args.Good()) {
+    args.PrintUsage(std::cerr);
+    return EXIT_FAILURE;
+  }
+  const auto markers = mgis::getProfilingMarkers();
+  if ((markers.begin == nullptr) != (markers.end == nullptr)) {
+    std::cerr << "only one of the two markers is set\n";
+    return EXIT_FAILURE;
+  }
+  if ((markers.begin != nullptr) != (std::strcmp(expected, "yes") == 0)) {
+    std::cerr << "the profiling sections are "
+              << (markers.begin != nullptr ? "" : "not ")
+              << "declared to roctx\n";
+    return EXIT_FAILURE;
+  }
+  // sections and ranges around computations of the device, with or without
+  // markers and without profiler
+  constexpr auto n = 1000;
+  auto norm = mfem::real_t{};
+  auto ctx = mgis::Context{};
+  ctx.enableProfiling(true);
+  for (int i = 0; i != 3; ++i) {
+    const auto range = mgis::ProfilingRange{
+        ctx, [i] { return "ProfilingMarkersTest: step " + std::to_string(i); }};
+    CatchTimeSection(ctx, "ProfilingMarkersTest::Step");
+    auto v = mfem::Vector(n);
+    v.UseDevice(true);
+    {
+      CatchTimeSection(ctx, "ProfilingMarkersTest::Fill");
+      v = mfem::real_t{2};
+    }
+    {
+      CatchTimeSection(ctx, "ProfilingMarkersTest::Norm");
+      norm = v.Norml2();
+    }
+  }
+  if (std::abs(norm * norm - mfem::real_t{4 * n}) > mfem::real_t{n} / 1000) {
+    std::cerr << "invalid norm " << norm << '\n';
+    return EXIT_FAILURE;
+  }
+  // the ranges are not added to the profiling tree
+  const auto& root = ctx.getProfilingResultTree();
+  if ((root.children.size() != 1) ||
+      (root.children[0]->name != "ProfilingMarkersTest::Step") ||
+      (root.children[0]->calls != 3) ||
+      (root.children[0]->children.size() != 2) ||
+      (root.children[0]->children[0]->name != "ProfilingMarkersTest::Fill") ||
+      (root.children[0]->children[0]->calls != 3) ||
+      (root.children[0]->children[1]->name != "ProfilingMarkersTest::Norm") ||
+      (root.children[0]->children[1]->calls != 3)) {
+    std::cerr << "unexpected profiling tree\n";
+    return EXIT_FAILURE;
+  }
+  std::cout << "profiling sections " << (markers.begin != nullptr ? "" : "not ")
+            << "declared to roctx\n";
+  return EXIT_SUCCESS;
+}  // end of main
