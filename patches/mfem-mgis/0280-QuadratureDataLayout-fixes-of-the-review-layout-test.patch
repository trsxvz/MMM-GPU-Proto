+  {
+    const auto* const v = "MFEM_MGIS_QUADRATURE_DATA_LAYOUT";
+    const auto* const e = std::getenv(v);
+    const auto previous =
+        e != nullptr ? std::optional<std::string>{e} : std::nullopt;
+    ::setenv(v, "SoA", 1);
+    auto c = Context{};
+    check(isInvalid(construct<NonLinearEvolutionProblem>(
