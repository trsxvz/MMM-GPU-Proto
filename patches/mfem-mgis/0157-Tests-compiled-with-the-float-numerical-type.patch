From c8b178d71af211b94aa6af8d500c951f0e3968a3 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 20:54:09 +0200
Subject: [PATCH] Tests compiled with the float numerical type

The behaviours of the tests are generated with the numerical type of
mfem-mgis (MFEM_MGIS_MFRONT_REAL_TYPE_OPTION); typed accumulators and
explicit conversions where double and real were mixed in std::max and
std::min; options of TwoLayerCube in real (OptionsParser of a MFEM in
single precision); typed literal in Mazars.mfront; UnitTestParameters reads
the floating-point values as double. The tests are not adapted to the
precision of float yet.
---
 cmake/modules/mfront-behaviours.cmake       | 2 +-
 tests/AdaptiveLinearSolverToleranceTest.cxx | 5 +++--
 tests/BatchIntegrationTest.cxx              | 4 ++--
 tests/CMakeLists.txt                        | 1 +
 tests/ElementsGeometryTest.cxx              | 3 ++-
 tests/FixedPointSolverTest.cxx              | 7 ++++---
 tests/HeatTransferKernelsTest.cxx           | 6 +++---
 tests/Mazars.mfront                         | 2 +-
 tests/MicromorphicKernelsTest.cxx           | 6 +++---
 tests/TwoLayerCube.cxx                      | 6 +++---
 tests/UnitTestParameters.cxx                | 4 +++-
 11 files changed, 26 insertions(+), 20 deletions(-)

diff --git a/cmake/modules/mfront-behaviours.cmake b/cmake/modules/mfront-behaviours.cmake
index 9818685030..10ce4b5e03 100644
--- a/cmake/modules/mfront-behaviours.cmake
+++ b/cmake/modules/mfront-behaviours.cmake
@@ -6,7 +6,7 @@ function(add_mfront_behaviour_sources lib  file)
     OUTPUT  "${mfront_output1}"
     OUTPUT  "${mfront_output2}"
     COMMAND "${MFRONT}"
-    ARGS    "--interface=generic"
+    ARGS    "--interface=generic" ${MFEM_MGIS_MFRONT_REAL_TYPE_OPTION}
     ARGS     "${mfront_file}"
     DEPENDS "${mfront_file}"
     COMMENT "mfront source ${mfront_file}")
