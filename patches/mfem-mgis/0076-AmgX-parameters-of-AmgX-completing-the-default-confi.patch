-                                                       const real atol,
-                                                       const int n,
-                                                       const bool verbose) {
-    auto c = std::ostringstream{};
-    c.imbue(std::locale::classic());
-    c << std::setprecision(std::numeric_limits<real>::max_digits10);
-    c << "{\"config_version\": 2, \"solver\": {"
-      << "\"solver\": \"PCG\", \"scope\": \"main\", \"norm\": \"L2\", "
-      << "\"monitor_residual\": 1, \"max_iters\": " << n << ", ";
-    if (atol > 0) {
-      // converged if the norm of the residual is lower than `tolerance` or
-      // than `alt_rel_tolerance` times the norm of the initial residual
-      c << "\"convergence\": \"COMBINED_REL_INI_ABS\", \"tolerance\": " << atol
-        << ", \"alt_rel_tolerance\": " << rtol << ", ";
-    } else {
-      c << "\"convergence\": \"RELATIVE_INI_CORE\", \"tolerance\": " << rtol
-        << ", ";
+    if (has_file) {
+      return initialise<parallel>(
+          std::make_unique<AmgXSolver>(*ofile, mfem::AmgXSolver::EXTERNAL,
+                                       false, std::optional<int>{}),
+          fespace);
     }
-    if (verbose) {
-      c << "\"obtain_timings\": 1, \"print_grid_stats\": 1, "
-        << "\"print_solve_stats\": 1, ";
+    if (has_configuration) {
+      return initialise<parallel>(
+          std::make_unique<AmgXSolver>(*oconfiguration,
+                                       mfem::AmgXSolver::INTERNAL, false,
+                                       std::optional<int>{}),
+          fespace);
+    }
+    // default configuration, completed by the parameters given
+    auto c = makeConfigurationStream();
+    c << "config_version=2, solver(amg)=AMG, ";
+    writeDefaultMultigridParameters(c, *overbosity > 0);
+    if (*overbosity > 0) {
+      c << ", amg:print_solve_stats=1";
     }
-    c << "\"preconditioner\": {\"solver\": \"AMG\", \"scope\": \"amg\", "
-      << "\"smoother\": {\"scope\": \"jacobi\", \"solver\": \"JACOBI_L1\"}, "
-      << "\"presweeps\": 1, \"postsweeps\": 1, \"interpolator\": \"D2\", "
-      << "\"max_row_sum\": 0.9, \"strength_threshold\": 0.25, "
-      << "\"max_iters\": 1, \"max_levels\": 100, \"cycle\": \"V\"}}}";
-    return c.str();
-  }  // end of getConjugateGradientConfiguration
+    if (!writeAmgXParameters(ctx, c, params)) {
+      return {};
+    }
+    return initialise<parallel>(
+        std::make_unique<AmgXSolver>(c.str(), mfem::AmgXSolver::INTERNAL, false,
+                                     std::optional<int>{}),
+        fespace);
+  }  // end of makeAmgXPreconditioner
 
   template <bool parallel>
   std::unique_ptr<AmgXSolver> makeAmgXConjugateGradientSolver(
@@ -182,7 +255,9 @@ namespace mfem_mgis::internals {
       FiniteElementSpace<parallel>& fespace,
       const Parameters& params) noexcept {
     using Problem = AbstractNonLinearEvolutionProblem;
-    if (!checkParameters(ctx, params, getIterativeSolverParametersList())) {
+    auto allowed_parameters = getIterativeSolverParametersList();
+    allowed_parameters.push_back(AmgXParameters);
+    if (!checkParameters(ctx, params, allowed_parameters)) {
       return {};
     }
     // default values of the solver configuration of MFEM
@@ -207,10 +282,32 @@ namespace mfem_mgis::internals {
           "AmgXPCG: the maximum number of iterations must be strictly "
           "positive");
     }
-    const auto c =
-        getConjugateGradientConfiguration(*ortol, *oatol, *on, *overbosity > 0);
-    auto s =
-        std::make_unique<AmgXSolver>(c, mfem::AmgXSolver::INTERNAL, false, *on);
+    // conjugate gradient preconditioned by the default multigrid, completed
+    // by the parameters given
+    auto c = makeConfigurationStream();
+    c << "config_version=2, solver(main)=PCG, main:max_iters=" << *on
+      << ", main:monitor_residual=1, main:norm=L2, ";
+    if (*oatol > 0) {
+      // converged if the norm of the residual is lower than `tolerance` or
+      // than `alt_rel_tolerance` times the norm of the initial residual
+      c << "main:convergence=COMBINED_REL_INI_ABS, main:tolerance=" << *oatol
+        << ", main:alt_rel_tolerance=" << *ortol << ", ";
+    } else {
+      c << "main:convergence=RELATIVE_INI_CORE, main:tolerance=" << *ortol
+        << ", ";
+    }
+    if (*overbosity > 0) {
+      c << "main:obtain_timings=1, main:print_solve_stats=1, ";
+    }
+    c << "main:preconditioner(amg)=AMG, ";
+    writeDefaultMultigridParameters(c, *overbosity > 0);
+    // the parameters of the conjugate gradient (scope `main`) are given by
+    // the options of the solver, used to check the convergence
+    if (!writeAmgXParameters(ctx, c, params, "main")) {
+      return {};
+    }
+    auto s = std::make_unique<AmgXSolver>(c.str(), mfem::AmgXSolver::INTERNAL,
+                                          false, *on);
     return initialise<parallel>(std::move(s), fespace);
   }  // end of makeAmgXConjugateGradientSolver
 
diff --git a/src/AmgXSolvers.hxx b/src/AmgXSolvers.hxx
index 9c1eec954f..a87c8e8963 100644
--- a/src/AmgXSolvers.hxx
+++ b/src/AmgXSolvers.hxx
@@ -75,10 +75,17 @@ namespace mfem_mgis::internals {
    * - `ConfigurationFile`: file containing the configuration of AmgX (the
    *   configurations distributed with AmgX are in `lib/configs`);
    * - `VerbosityLevel`: if strictly positive, AmgX prints the statistics of
-   *   the default configuration.
-   * Without configuration, the default one of MFEM is used: one V-cycle of
-   * the classical algebraic multigrid with a L1-Jacobi smoother. An
-   * invalid configuration aborts the program (AmgX checks it).
+   *   the default configuration;
+   * - `AmgXParameters`: parameters of AmgX, with their names in AmgX
+   *   (`strength_threshold`, `interpolator`, ...), which complete or
+   *   override the default configuration. A parameter without scope is
+   *   given to the multigrid (scope `amg`), a parameter `scope:name` as is
+   *   (the smoother has the scope `smoother`).
+   * The default configuration is the one of MFEM: one V-cycle of the
+   * classical algebraic multigrid with a L1-Jacobi smoother (one sweep
+   * before and after the coarse correction), the D2 interpolation and a
+   * strength threshold of 0.25. An invalid configuration aborts the program
+   * (AmgX checks it).
    *
    * \param[in, out] ctx: execution context
    * \param[in] fespace: finite element space
@@ -96,7 +103,10 @@ namespace mfem_mgis::internals {
    * `RelativeTolerance`, `AbsoluteTolerance`,
    * `MaximumNumberOfIterations`), with the convergence criterion of MFEM:
    * the norm of the residual is lower than the absolute tolerance or than
-   * the relative tolerance times the norm of the initial residual.
+   * the relative tolerance times the norm of the initial residual. The
+   * option `AmgXParameters` gives parameters of the multigrid, as for the
+   * `AmgX` solver; the parameters of the conjugate gradient (scope `main`)
+   * are refused.
    *
    * \param[in, out] ctx: execution context
    * \param[in] fespace: finite element space
