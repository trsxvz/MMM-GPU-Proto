@@ -178,8 +179,10 @@ int main(int argc, char** argv) {
   const auto r1 = solve(ctx, mesh, p, "byNODES");
   const auto r2 = solve(ctx, mesh, p, "byVDIM");
   // absolute tolerance on the stresses and on the resultant force (the area
-  // of the loaded face is 1)
-  constexpr auto eps = 1e-8 * pressure;
+  // of the loaded face is 1). In float, the two solutions, each converged
+  // to the relative tolerances bounded to 1.2e-5, differ by up to 1e3 on
+  // stresses of about 1e8 (6.7e-6 of the pressure)
+  constexpr auto eps = mfem_mgis::unit_tests::tolerance(1e-8, 1e-4) * pressure;
   auto success =
       r1.thermodynamic_forces.size() == r2.thermodynamic_forces.size();
   if (success) {
diff --git a/tests/ImplicitGradientRegularizationTest.cxx b/tests/ImplicitGradientRegularizationTest.cxx
index efdefdbc15..6f22fef26f 100644
--- a/tests/ImplicitGradientRegularizationTest.cxx
+++ b/tests/ImplicitGradientRegularizationTest.cxx
@@ -15,6 +15,7 @@
 #include "MFEMMGIS/L2Projection.hxx"
 #include "MFEMMGIS/LinearSolverFactory.hxx"
 #include "UnitTestingUtilities.hxx"
+#include "Tolerance.hxx"
 
 struct TestParameters {
   const char* mesh_file = nullptr;
@@ -87,7 +88,9 @@ bool test(mfem_mgis::Context& ctx, const TestParameters& params) {
         u[0] = std::cos(4 * pi * x[0]);
       }};
   const auto e = r.ComputeL2Error(solution);
-  return e < 4e-6;
+  // errors measured: 3.2e-6 in double, 1.1e-4 in float, where the linear
+  // solver stops at a relative residual of 1.2e-5
+  return e < mfem_mgis::unit_tests::tolerance(4e-6, 1e-3);
 }  // end of test
 
 int main(int argc, char** argv) {
