From 8c56c8ab0198fb3f4054db149149151df5aa6c16 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 21:17:45 +0200
Subject: [PATCH] Tests in float: time steps, selection of integrators,
 orderings, heat

- MaximumNumberOfTimeStepsTest: times compared with a tolerance bounded to
  10 epsilons (the times are stored as real).
- BehaviourIntegratorsSelectionTest: relative tolerance of Newton of 1e-3
  in float for this finite strain behaviour (residual stagnating at 3e-4),
  sum of the resultants compared at 10 epsilons.
- FiniteElementSpaceOrderingTest: tolerance of 1e-4 times the pressure in
  float, the two solutions differing by up to 6.7e-6 of it.
- ImplicitGradientRegularizationTest: L2 error threshold of 1e-3 in float
  (1.1e-4 measured, 3.2e-6 in double).
- StationaryNonLinearHeatTransferTest: absolute tolerance of Newton of 3e-3
  in float, the residual stagnating at 3e-4 with temperatures up to 900 K.
Double unchanged.
---
 tests/BehaviourIntegratorsSelectionTest.cxx   | 16 +++++++++++-----
 tests/FiniteElementSpaceOrderingTest.cxx      |  7 +++++--
 tests/ImplicitGradientRegularizationTest.cxx  |  5 ++++-
 tests/MaximumNumberOfTimeStepsTest.cxx        |  7 +++++--
 tests/StationaryNonLinearHeatTransferTest.cxx | 12 ++++++++----
 5 files changed, 33 insertions(+), 14 deletions(-)

diff --git a/tests/BehaviourIntegratorsSelectionTest.cxx b/tests/BehaviourIntegratorsSelectionTest.cxx
index 67ae4afb3f..241f9dd03d 100644
--- a/tests/BehaviourIntegratorsSelectionTest.cxx
+++ b/tests/BehaviourIntegratorsSelectionTest.cxx
@@ -15,6 +15,7 @@
 #include "MFEMMGIS/UniformDirichletBoundaryCondition.hxx"
 #include "MFEMMGIS/NonLinearEvolutionProblem.hxx"
 #include "UnitTestingUtilities.hxx"
+#include "Tolerance.hxx"
 
 int main(int argc, char** argv) {
   using namespace mfem_mgis;
@@ -63,10 +64,14 @@ int main(int argc, char** argv) {
                or_die) |
       or_die;
   unit_tests::setLinearSolver(may_abort, ctx, problem, params);
-  problem.setSolverParameters(ctx, {{"VerbosityLevel", 0},
-                                    {"RelativeTolerance", 1e-12},
-                                    {"AbsoluteTolerance", 0.},
-                                    {"MaximumNumberOfIterations", 10}}) |
+  // in float, the residual of this finite strain behaviour stagnates at about
+  // 3e-4 of the initial one: the deformation gradient F = I + H only gives H
+  // with a relative precision of about 1e-4
+  problem.setSolverParameters(
+      ctx, {{"VerbosityLevel", 0},
+            {"RelativeTolerance", unit_tests::tolerance(1e-12, 1e-3)},
+            {"AbsoluteTolerance", 0.},
+            {"MaximumNumberOfIterations", 10}}) |
       or_die;
   // post-processings using all the behaviour integrators
   for (const auto* const n : {"ComputeResultantForceOnBoundary",
@@ -110,7 +115,8 @@ int main(int argc, char** argv) {
   success = !resultant({.index = 2}).has_value() && success;
   success = F0.has_value() && F1.has_value() && Fa.has_value() && success;
   if (success) {
-    const auto eps = 1e-12 * std::abs(*Fa);
+    // the resultant of all the integrators is a sum of the others
+    const auto eps = unit_tests::tolerance(1e-12) * std::abs(*Fa);
     success = (std::abs(*F0 - *F1) <= eps) &&
               (std::abs(*Fa - (*F0 + *F1)) <= eps) && success;
   }
