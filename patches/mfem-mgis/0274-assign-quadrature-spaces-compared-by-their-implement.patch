From c3b781a2b2240982aea3146b4abf727cbee01383 Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 20 Oct 2026 18:49:09 +0200
Subject: [PATCH] assign: quadrature spaces compared by their implementation,
 not by address

Since the partial quadrature spaces are handled by value, a partial
quadrature function holds its own copy of its space: comparing the
addresses of the spaces refused a function and an evaluator defined on
copies of the same space (rotateThermodynamicsForcesToGlobalFrame
failed, for instance). The spaces are compared by their operator !=,
which compares their implementations, as elsewhere: in assign and in
checkMatchingQuadratureSpaces.
---
 include/MFEMMGIS/Algorithms.ixx              | 4 ++--
 include/MFEMMGIS/QPEvaluator/QPEvaluator.ixx | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/include/MFEMMGIS/Algorithms.ixx b/include/MFEMMGIS/Algorithms.ixx
index edbc2587b1..ab6139b676 100644
--- a/include/MFEMMGIS/Algorithms.ixx
+++ b/include/MFEMMGIS/Algorithms.ixx
@@ -15,7 +15,7 @@ namespace mfem_mgis {
   bool assign(Context& ctx,
               PartialQuadratureFunction& f,
               QPEvaluatorType e) requires(N > 0) {
-    if (&f.getPartialQuadratureSpace() != &getSpace(e)) {
+    if (f.getPartialQuadratureSpace() != getSpace(e)) {
       return ctx.registerErrorMessage(
           "assign: unmatched quadrature spaces for the left hand side "
           "and the right hand side");
@@ -47,7 +47,7 @@ namespace mfem_mgis {
 
   template <QPEvaluatorConcept QPEvaluatorType>
   bool assign(Context& ctx, PartialQuadratureFunction& f, QPEvaluatorType e) {
-    raise_if(&f.getPartialQuadratureSpace() != &e.getPartialQuadratureSpace(),
+    raise_if(f.getPartialQuadratureSpace() != e.getPartialQuadratureSpace(),
              "assign: unmatched quadrature spaces for the left hand side "
              "and the right hand side");
     raise_if(f.getNumberOfComponents() != e.getNumberOfComponents(),
diff --git a/include/MFEMMGIS/QPEvaluator/QPEvaluator.ixx b/include/MFEMMGIS/QPEvaluator/QPEvaluator.ixx
index 5e9094a893..ac6454cbbc 100644
--- a/include/MFEMMGIS/QPEvaluator/QPEvaluator.ixx
+++ b/include/MFEMMGIS/QPEvaluator/QPEvaluator.ixx
@@ -266,7 +266,7 @@ namespace mfem_mgis {
                                      const EvaluatorType2& e2) noexcept {
     const auto& qspace1 = getSpace(e1);
     const auto& qspace2 = getSpace(e2);
-    if (&qspace1 != &qspace2) {
+    if (qspace1 != qspace2) {
       return ctx.registerErrorMessage("unmatched quadrature spaces");
     }
     return true;
-- 
