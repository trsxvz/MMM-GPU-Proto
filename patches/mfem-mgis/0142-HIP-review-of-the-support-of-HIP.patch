From e572a32fde85515f9afa89901b16b5552639190f Mon Sep 17 00:00:00 2001
From: t <tristan75015@gmail.com>
Date: Tue, 13 Oct 2026 16:37:15 +0200
Subject: [PATCH] HIP: review of the support of HIP

- The header MFEMMGIS/Batch/MFEMFieldOperations.hxx is installed with HIP
  too (its source is compiled since the previous commits).
- The programs and libraries linked to mfem-mgis are linked by the C++
  compiler, as with CUDA: the linker preference of HIP, greater than the one
  of C++, no longer propagates through the static library
  (CMAKE_HIP_LINKER_PREFERENCE_PROPAGATES), the HIP runtime being given by
  hip::host.
- HIP_PLATFORM is set to amd only for the search of ROCm (FindMFEM.cmake),
  and also in the installed configuration, which found the NVIDIA variant
  of hip::host when the environment selected the NVIDIA platform.
- The behaviours for the GPU are compiled by the hipcc of the ROCm found for
  MFEM when the compiler of MFEM is not hipcc (MFEM built by CMake), for the
  architectures of CMAKE_HIP_ARCHITECTURES if the ones of MFEM are unknown.
- An empty HIPCXX no longer prevents the use of the clang of MFEM, the
  variable HIPARCHS (not read by CMake) is no longer tested, and the
  comments describe how the architectures are chosen.
- Documentation: the tests on the GPU registered with CUDA only select the
  cuda device of MFEM or use behaviours generated by the cuda backend (the
  previous commit only mentioned the behaviours); the option
  enable-gpu-tests applies to HIP too.

Checked again from scratch (hypre, MFEM 4.10 compiled with HIP for gfx90a,
mfem-mgis, examples): 213/213 tests of mfem-mgis without GPU, 15/15
examples.
---
 CMakeLists.txt                                    |  2 +-
 cmake/modules/FindMFEM.cmake                      | 13 ++++++++-----
 cmake/modules/MFEMMGISBehaviours.cmake            | 10 ++++++++++
 cmake/modules/MFEMMGISDeviceCode.cmake            | 15 +++++++++++----
 .../installation_guide/installation_guide.rst     |  3 ++-
 docs/source/user_guide/batch_computations.rst     |  3 ++-
 include/CMakeLists.txt                            |  8 ++------
 src/MFEMMGISConfig.cmake.in                       | 10 +++++++++-
 8 files changed, 45 insertions(+), 19 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b070f5fe9d..b831b149ac 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -24,7 +24,7 @@ enable_testing()
 # portable-build
 option(enable-portable-build "Produce binary that can be shared between various machine (same architecture, same gcc version, different processors" OFF)
 option(BENCHMARKS "Compile benchmarks" OFF)
-option(enable-gpu-tests "Add the tests which require a GPU (when MFEM is compiled with CUDA)" ON)
+option(enable-gpu-tests "Add the tests which require a GPU (when MFEM is compiled with CUDA or HIP)" ON)
 option(enable-amgx "Solvers of the AmgX library of NVIDIA (requires MFEM compiled with CUDA, AmgX given by AMGX_DIR)" OFF)
 option(enable-kokkos "Initialization of Kokkos by mfem_mgis::initialize on demand (option --kokkos or variable MFEM_MGIS_KOKKOS), for the behaviours generated by the kokkos backend of the generic-parallel interface of MFront" OFF)
 
diff --git a/cmake/modules/FindMFEM.cmake b/cmake/modules/FindMFEM.cmake
index d2e933e69e..9dbd7cab1c 100644
--- a/cmake/modules/FindMFEM.cmake
+++ b/cmake/modules/FindMFEM.cmake
@@ -195,15 +195,18 @@ if(MFEM_USE_HIP STREQUAL "YES")
   endif()
   # MFEM compiled with HIP uses the libraries of ROCm (rocsparse, ...): the
   # platform is AMD, whatever the environment variable HIP_PLATFORM (which
-  # may select the NVIDIA platform for other codes)
-  if(NOT DEFINED HIP_PLATFORM)
-    set(HIP_PLATFORM amd)
-  endif()
+  # may select the NVIDIA platform for other codes), for this search only.
   # `hip_ROOT` is used (policy CMP0074, not set by the minimum version of
   # CMake required by mfem-mgis)
   cmake_policy(PUSH)
   cmake_policy(SET CMP0074 NEW)
-  find_package(hip CONFIG REQUIRED)
+  if(NOT DEFINED HIP_PLATFORM)
+    set(HIP_PLATFORM amd)
+    find_package(hip CONFIG REQUIRED)
+    unset(HIP_PLATFORM)
+  else()
+    find_package(hip CONFIG REQUIRED)
+  endif()
   cmake_policy(POP)
   set_property(TARGET MFEM::mfem APPEND
     PROPERTY INTERFACE_LINK_LIBRARIES hip::host)
diff --git a/cmake/modules/MFEMMGISBehaviours.cmake b/cmake/modules/MFEMMGISBehaviours.cmake
index e2b8958827..c74ead7333 100644
--- a/cmake/modules/MFEMMGISBehaviours.cmake
+++ b/cmake/modules/MFEMMGISBehaviours.cmake
@@ -88,7 +88,17 @@ function(mfem_mgis_add_behaviours_library target)
     # configuration file of TFEL (which may target the NVIDIA platform, or
     # the default architecture of hipcc) are replaced by the ones of MFEM
     get_property(_hipcc GLOBAL PROPERTY MFEM_MGIS_MFEM_HIP_COMPILER)
+    get_filename_component(_hipcc_name "${_hipcc}" NAME)
+    if((NOT _hipcc_name MATCHES "^hipcc") AND hip_HIPCC_EXECUTABLE)
+      # MFEM built by CMake: its compiler is the C++ compiler, hipcc is the
+      # one of the ROCm found for MFEM (see `FindMFEM.cmake`)
+      set(_hipcc "${hip_HIPCC_EXECUTABLE}")
+    endif()
     get_property(_hip_archs GLOBAL PROPERTY MFEM_MGIS_MFEM_HIP_ARCHITECTURES)
+    if((NOT _hip_archs) AND CMAKE_HIP_ARCHITECTURES)
+      set(_hip_archs ${CMAKE_HIP_ARCHITECTURES})
+    endif()
+    # C++20, the standard of TFEL and of mfem-mgis
     set(_hip_flags "-fPIC -O2 -std=c++20")
     foreach(_arch IN LISTS _hip_archs)
       string(APPEND _hip_flags " --offload-arch=${_arch}")
diff --git a/cmake/modules/MFEMMGISDeviceCode.cmake b/cmake/modules/MFEMMGISDeviceCode.cmake
index bd958ad861..d79d19d5dd 100644
--- a/cmake/modules/MFEMMGISDeviceCode.cmake
+++ b/cmake/modules/MFEMMGISDeviceCode.cmake
@@ -12,8 +12,10 @@
 #   which compiled MFEM (CMake does not accept hipcc as HIP compiler),
 #   unless `CMAKE_HIP_COMPILER` is given, the platform is AMD (the one of
 #   the libraries of ROCm used by MFEM) unless `CMAKE_HIP_PLATFORM` is given,
-#   and the GPU architectures default to the ones of MFEM (CMake requires
-#   them when no AMD GPU is found). This
+#   and `CMAKE_HIP_ARCHITECTURES`, unless given, is set to the GPU
+#   architectures of MFEM (CMake would otherwise detect the GPU of the
+#   machine, or use the default architecture of clang), the sources being
+#   compiled for the architectures of MFEM anyway (as with CUDA). This
 #   macro enables a language: it must be called at file scope (not in a
 #   function), before `mfem_mgis_compile_as_device_code`. A warning is
 #   printed if the compiler is not the one of MFEM (for instance a build
@@ -170,7 +172,7 @@ macro(mfem_mgis_enable_device_language)
     endif()
     get_property(_mfem_mgis_hipcc GLOBAL PROPERTY MFEM_MGIS_MFEM_HIP_COMPILER)
     mfem_mgis_hip_compiler(_mfem_mgis_hip_clang "${_mfem_mgis_hipcc}")
-    if(NOT CMAKE_HIP_COMPILER AND NOT DEFINED ENV{HIPCXX}
+    if(NOT CMAKE_HIP_COMPILER AND ("$ENV{HIPCXX}" STREQUAL "")
        AND _mfem_mgis_hip_clang)
       set(CMAKE_HIP_COMPILER "${_mfem_mgis_hip_clang}")
     endif()
@@ -178,7 +180,7 @@ macro(mfem_mgis_enable_device_language)
     if(NOT DEFINED CMAKE_HIP_PLATFORM)
       set(CMAKE_HIP_PLATFORM amd)
     endif()
-    if(NOT DEFINED CMAKE_HIP_ARCHITECTURES AND NOT DEFINED ENV{HIPARCHS})
+    if(NOT DEFINED CMAKE_HIP_ARCHITECTURES)
       get_property(_mfem_mgis_hip_archs GLOBAL
                    PROPERTY MFEM_MGIS_MFEM_HIP_ARCHITECTURES)
       if(_mfem_mgis_hip_archs)
@@ -186,6 +188,11 @@ macro(mfem_mgis_enable_device_language)
       endif()
     endif()
     enable_language(HIP)
+    # the programs and libraries linked to mfem-mgis (a static library
+    # containing HIP code) are linked by the C++ compiler, as with CUDA, and
+    # not by the HIP compiler (whose linker preference is greater than the
+    # one of C++); the HIP runtime is given by the target `hip::host`
+    set(CMAKE_HIP_LINKER_PREFERENCE_PROPAGATES 0)
     if(_mfem_mgis_hip_clang)
       get_filename_component(_mfem_mgis_c1 "${CMAKE_HIP_COMPILER}" REALPATH)
       get_filename_component(_mfem_mgis_c2 "${_mfem_mgis_hip_clang}" REALPATH)
