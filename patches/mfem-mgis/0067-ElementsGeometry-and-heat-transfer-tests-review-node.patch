+static mfem::IntegrationRule reverse(const mfem::IntegrationRule& ir) {
+  const auto n = ir.GetNPoints();
+  auto r = mfem::IntegrationRule(n);
+  for (int i = 0; i != n; ++i) {
+    r.IntPoint(i) = ir.IntPoint(n - 1 - i);
