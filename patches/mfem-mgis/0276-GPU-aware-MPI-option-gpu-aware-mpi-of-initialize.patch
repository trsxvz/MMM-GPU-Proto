+        &gpu_aware_mpi, Finalizer::gpu_aware_mpi_short_option,
+        Finalizer::gpu_aware_mpi_option,
+        Finalizer::no_gpu_aware_mpi_short_option,
+        Finalizer::no_gpu_aware_mpi_option,
