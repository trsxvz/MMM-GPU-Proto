-                   const MV& s,
-                   const std::size_t j,
-                   const TpetraMatrix& m) {
-    checkConstantStride(s);
-    const auto v = s.getLocalViewHost(Tpetra::Access::ReadOnly);
-    for (std::size_t i = 0; i != v.extent(0); ++i) {
