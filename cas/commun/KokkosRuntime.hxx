/*!
 * \file   KokkosRuntime.hxx
 * \brief  Initialization of Kokkos for the behaviours generated by the kokkos
 * backend of the generic-parallel interface of MFront, which require an
 * initialized Kokkos and do not initialize it themselves.
 */

#ifndef LIB_PROTO_KOKKOSRUNTIME_HXX
#define LIB_PROTO_KOKKOSRUNTIME_HXX

namespace proto {

  /*!
   * \brief initializes Kokkos at its construction if it is not initialized,
   * and finalizes it at its destruction if it initialized it. It must be
   * destroyed before the finalization of MPI.
   */
  struct KokkosRuntime {
    KokkosRuntime();
    KokkosRuntime(const KokkosRuntime&) = delete;
    KokkosRuntime(KokkosRuntime&&) = delete;
    KokkosRuntime& operator=(const KokkosRuntime&) = delete;
    KokkosRuntime& operator=(KokkosRuntime&&) = delete;
    ~KokkosRuntime();

   private:
    //! \brief if true, Kokkos was initialized by this object
    bool owner = false;
  };

}  // end of namespace proto

#endif /* LIB_PROTO_KOKKOSRUNTIME_HXX */
